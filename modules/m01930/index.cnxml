<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Using the Vertex and Axis of Symmetry of Quadratics</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01930</md:content-id>
    <md:title>Using the Vertex and Axis of Symmetry of Quadratics</md:title>
    <md:uuid>5201447f-8e34-47de-b0a0-55c039441731</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">      <title>Activity</title>
      <para id="para-00001">While answering the questions below, plot each point on a coordinate
        plane with grid paper by hand. Do not use technology.</para>
      <para id="para-00002">For questions 1 – 4, use the function <m:math display="inline">
          <m:mrow>
            <m:mi>f</m:mi>
            <m:mo stretchy="false">(</m:mo>
            <m:mi>x</m:mi>
            <m:mo stretchy="false">)</m:mo>
            <m:mo>=</m:mo>
            <m:mo stretchy="false">(</m:mo>
            <m:mi>x</m:mi>
            <m:mo>–</m:mo>
            <m:mn>2</m:mn>
            <m:mo stretchy="false">)</m:mo>
            <m:mo stretchy="false">(</m:mo>
            <m:mi>x</m:mi>
            <m:mo>+</m:mo>
            <m:mn>4</m:mn>
            <m:mo stretchy="false">)</m:mo>
            <m:mo>.</m:mo>
          </m:mrow>
        </m:math></para>
      <!--Q#1-->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00003"> Find the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-coordinates of the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts of <m:math display="inline">
              <m:mrow>
                <m:mi>f</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00005">Compare your answer: </para>
          <para id="para-00006"><m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
                <m:mo>=</m:mo>
                <m:mo>–</m:mo>
                <m:mn>4</m:mn>
              </m:mrow>
            </m:math> and <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
                <m:mo>=</m:mo>
                <m:mn>2</m:mn>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#2-->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00007"> Find the coordinate of the vertex.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00009">Compare your answer: </para>
          <para id="para-00004"><m:math>
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>–</m:mo>
                <m:mn>1</m:mn>
                <m:mo>,</m:mo>
                <m:mo>–</m:mo>
                <m:mn>5</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#3-->

      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00011"> On your graph, sketch a quadratic through the key features on your
            graph and draw a vertical line through the vertex using a different color.</para>
          <para id="para-00012"/>
        </problem>
        <solution id="sol-00003">
          <para id="para-00013">Compare your answer: </para>
          <para id="para-00014">

            <media alt="A graph of a parabola opening upward with x-intercepts at (negative 4, 0) and (2, 0) and a vertex at (negative 1, negative 9), all points marked with labels.">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_08_13_09_01.jpg"/>
            </media>

          </para>
        </solution>
      </exercise>

      <!--Interaction
      End -->
      <!--Q#4-->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00015"> What is the equation of the vertical line that goes through the
            vertex?</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00017">Compare your answer: </para>
          <para id="para-00008"><m:math>
              <m:mrow>
                <m:mi>x</m:mi>
                <m:mo>=</m:mo>
                <m:mo>–</m:mo>
                <m:mn>1</m:mn>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#5-->
      <exercise id="exer-00005">
        <problem id="prob-00005">
          <para id="para-00019"> What does the vertical line that goes through the vertex do to the
            parabola?</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00021">Compare your answer: </para>
          <para id="para-00022">Your answer may vary, but here is a sample. The vertical line <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
                <m:mo>=</m:mo>
                <m:mo>–</m:mo>
                <m:mn>1</m:mn>
              </m:mrow>
            </m:math> cuts the parabola in half
            and creates two symmetrical parts.</para>
          <para id="para-00023">This imaginary vertical line that goes through the vertex and cuts
            the parabola in half is called the <term class="glossary-tooltip" id="term-00001">axis
            of symmetry</term>.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#6-->

      <exercise id="exer-00006">
        <problem id="prob-00006">
          <para id="para-00024"> On your graph, label your <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts, vertex, and
            axis of symmetry. Identify your vertex as a maximum or minimum.</para>
          <para id="para-00025"/>
        </problem>
        <solution id="sol-00006">
          <para id="para-00026">Compare your answer: </para>
          <para id="para-00027">

            <media alt="Graph of a parabola opening upwards, labeled with its x-intercepts, axis of symmetry (vertical green dashed line at x equals negative 1), and vertex (minimum point) at the bottom center.">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_08_13_09_02.jpg"/>
            </media>

          </para>
        </solution>
      </exercise>

      <!--Interaction
      End -->
      <!--Q#7-->
      <exercise id="exer-00007">
        <problem id="prob-00007">
          <para id="para-00028"> Given a vertex of <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>2</m:mn>
                <m:mo>,</m:mo>
                <m:mo>–</m:mo>
                <m:mn>4</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math> and a
            point <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>1</m:mn>
                <m:mo>,</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>, what is
            another point on the quadratic?</para>
          <para id="para-00029">(Hint: It is helpful to draw a picture and use the axis of
            symmetry).</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00031">Compare your answer: </para>
          <para id="para-00032">Your answer may vary, but here is a sample.</para>
          <para id="para-00033">

            <media alt="A Cartesian plane with three labeled points: (negative 5, 3), (negative 2, 4), and (1, 3). A green dashed vertical line passes through x equals negative 2.">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_08_13_09_03.jpg"/>
            </media>

          </para>
          <para id="para-00034">Since <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>–</m:mo>
                <m:mn>2</m:mn>
                <m:mo>,</m:mo>
                <m:mn>4</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math> is the
            vertex, then <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
                <m:mo>=</m:mo>
                <m:mo>–</m:mo>
                <m:mn>2</m:mn>
              </m:mrow>
            </m:math> is the axis of symmetry.
            If <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>1</m:mn>
                <m:mo>,</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math> is 3
            units away from the axis of symmetry, there is another point 3 units to the left of the
            axis of symmetry. This is the point <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>–</m:mo>
                <m:mn>5</m:mn>
                <m:mo>,</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
    </section>

    <note class="self-check" id="note-00001">
      <exercise id="exer-00010">
        <problem id="prob-00010">
          <para id="para-00018"><link class="os-embed" url="#exercise/Alg1_7_11_4_SC"/></para>
        </problem>
      </exercise>
    </note>

    <section id="sect-00003">
      <title>Additional Resources</title>
      <section id="sect-00002">
        <title>Axis of Symmetry of a Quadratic </title>
        <para id="para-00036">In the graph of a quadratic function, the axis of symmetry is an
          imaginary line that cuts the parabola in half to create two symmetrical sides. It goes
          through the vertex of the parabola so the equation of the axis of symmetry is the same as
          the <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
            </m:mrow>
          </m:math>-coordinate of the vertex.</para>
        <para id="para-00037">
          <media alt="Two graphs: Figure 1 shows an upward parabola for f of x equal to x squared plus 4 times x plus 3. There is a dashed blue line bisecting the parabola through the vertex. Figure 2 shows a downward parabola for f of x equal to negative x squared plus 4 times x plus 3. There is a dashed blue line bisecting the parabola through the vertex.">
            <image width="550" mime-type="image/jpeg" src="../../media/Algebra-1_08_13_11_01.jpg"/>
          </media>
        
        <emphasis id="docs-internal-guid-1a59f64e-7fff-f686-b37e-3c95d10108a1"/>
        </para>
        <para id="para-00038">Notice that in Figure 1, the vertex is at <m:math display="inline">
            <m:mrow>
              <m:mo stretchy="false">(</m:mo>
              <m:mo>–</m:mo>
              <m:mn>2</m:mn>
              <m:mo>,</m:mo>
              <m:mo>–</m:mo>
              <m:mn>2</m:mn>
              <m:mo stretchy="false">)</m:mo>
            </m:mrow>
          </m:math> and the axis
          of symmetry is at <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
              <m:mo>=</m:mo>
              <m:mo>–</m:mo>
              <m:mn>2</m:mn>
            </m:mrow>
          </m:math>.</para>
        <para id="para-00039">In Figure 2, the vertex is at <m:math display="inline">
            <m:mrow>
              <m:mo stretchy="false">(</m:mo>
              <m:mn>2</m:mn>
              <m:mo>,</m:mo>
              <m:mn>7</m:mn>
              <m:mo stretchy="false">)</m:mo>
            </m:mrow>
          </m:math> and the axis
          of symmetry is at <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
              <m:mo>=</m:mo>
              <m:mn>2</m:mn>
            </m:mrow>
          </m:math>.</para>
        <para id="para-00040">
          <emphasis>Example</emphasis>
        </para>
        <para id="para-00041">Find the vertex and axis of symmetry for <m:math display="inline">
            <m:mrow>
              <m:mi>f</m:mi>
              <m:mo stretchy="false">(</m:mo>
              <m:mi>x</m:mi>
              <m:mo stretchy="false">)</m:mo>
              <m:mo>=</m:mo>
              <m:mo stretchy="false">(</m:mo>
              <m:mi>x</m:mi>
              <m:mo>+</m:mo>
              <m:mn>2</m:mn>
              <m:mo stretchy="false">)</m:mo>
              <m:mo stretchy="false">(</m:mo>
              <m:mi>x</m:mi>
              <m:mo>–</m:mo>
              <m:mn>6</m:mn>
              <m:mo stretchy="false">)</m:mo>
            </m:mrow>
          </m:math>.</para>
        <para id="para-00042"><emphasis>Step 1</emphasis> -  Find the <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
            </m:mrow>
          </m:math>-intercepts.</para><para id="para-00020">Set each factor
          equal to 0.</para><para id="para-00030"><m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
              <m:mo>+</m:mo>
              <m:mn>2</m:mn>
              <m:mo>=</m:mo>
              <m:mn>0</m:mn>
            </m:mrow>
          </m:math></para><para id="para-00035">
  <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
              <m:mo>=</m:mo>
              <m:mo>–</m:mo>
              <m:mn>2</m:mn>
            </m:mrow>
          </m:math></para><para id="para-00049">
  <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
              <m:mo>–</m:mo>
              <m:mn>6</m:mn>
              <m:mo>=</m:mo>
              <m:mn>0</m:mn>
            </m:mrow>
          </m:math></para><para id="para-00055">
  <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
              <m:mo>=</m:mo>
              <m:mn>6</m:mn>
            </m:mrow>
          </m:math></para>
        <para id="para-00043"><emphasis>Step 2</emphasis> - Find the <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
            </m:mrow>
          </m:math>-coordinate of the vertex.</para><para id="para-00057">The
          vertex is halfway between the two <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
            </m:mrow>
          </m:math>-intercepts.</para><para id="para-00058"><m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
              <m:mo>=</m:mo>
              <m:mn>6</m:mn>
              <m:mo>+</m:mo>
              <m:mo stretchy="false">(</m:mo>
              <m:mo>–</m:mo>
              <m:mn>2</m:mn>
              <m:msup>
                <m:mo stretchy="false">)</m:mo>
                <m:mn>2</m:mn>
              </m:msup>
              <m:mo>=</m:mo>
              <m:mn>2</m:mn>
            </m:mrow>
          </m:math></para><para id="para-00059">
  <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
              <m:mo>=</m:mo>
              <m:mfrac>
                <m:mrow>
                  <m:mn>6</m:mn>
                  <m:mo>+</m:mo>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mo>–</m:mo>
                  <m:mn>2</m:mn>
                  <m:mo stretchy="false">)</m:mo>
                </m:mrow>
                <m:mrow>
                  <m:mn>2</m:mn>
                </m:mrow>
              </m:mfrac>
              <m:mo>=</m:mo>
              <m:mn>2</m:mn>
            </m:mrow>
          </m:math></para>
        <para id="para-00044"><emphasis>Step 3</emphasis> - Find the <m:math display="inline">
            <m:mrow>
              <m:mi>y</m:mi>
            </m:mrow>
          </m:math>-coordinate of the vertex.</para><para id="para-00060">
          Substitute the <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
            </m:mrow>
          </m:math>-coordinate into <m:math display="inline">
            <m:mrow>
              <m:mi>f</m:mi>
              <m:mo stretchy="false">(</m:mo>
              <m:mi>x</m:mi>
              <m:mo stretchy="false">)</m:mo>
            </m:mrow>
          </m:math>.</para><para id="para-00061"><m:math display="inline">
            <m:mrow>
              <m:mi>f</m:mi>
              <m:mo stretchy="false">(</m:mo>
              <m:mn>2</m:mn>
              <m:mo stretchy="false">)</m:mo>
              <m:mo>=</m:mo>
              <m:mo stretchy="false">(</m:mo>
              <m:mn>2</m:mn>
              <m:mo>+</m:mo>
              <m:mn>2</m:mn>
              <m:mo stretchy="false">)</m:mo>
              <m:mo stretchy="false">(</m:mo>
              <m:mn>2</m:mn>
              <m:mo>–</m:mo>
              <m:mn>6</m:mn>
              <m:mo stretchy="false">)</m:mo>
              <m:mo>=</m:mo>
              <m:mo stretchy="false">(</m:mo>
              <m:mn>4</m:mn>
              <m:mo stretchy="false">)</m:mo>
              <m:mo stretchy="false">(</m:mo>
              <m:mo>–</m:mo>
              <m:mn>4</m:mn>
              <m:mo stretchy="false">)</m:mo>
              <m:mo>=</m:mo>
              <m:mo>–</m:mo>
              <m:mn>6</m:mn>
            </m:mrow>
          </m:math></para><para id="para-00062">The vertex is at <m:math display="inline">
            <m:mrow>
              <m:mo stretchy="false">(</m:mo>
              <m:mn>2</m:mn>
              <m:mo>,</m:mo>
              <m:mo>–</m:mo>
              <m:mn>16</m:mn>
              <m:mo stretchy="false">)</m:mo>
            </m:mrow>
          </m:math>.</para>
        <para id="para-00045"><emphasis>Step 4</emphasis> - Find the axis of symmetry.</para><para id="para-00063">The axis of
          symmetry is the equation where <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
            </m:mrow>
          </m:math> equals the <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
            </m:mrow>
          </m:math>-coordinate of the function.</para><para id="para-00064"><m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
              <m:mo>=</m:mo>
              <m:mn>2</m:mn>
            </m:mrow>
          </m:math></para>
        <section class="numbered-exercises" id="sect-00004"><note class="try" id="note-00002">
          <title>Axis of Symmetry of a Quadratic</title>
      <para id="para-00046">For questions
          1 - 2, use the equation of the quadratic, <m:math display="inline">
              <m:mrow>
                <m:mi>f</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>–</m:mo>
                <m:mn>4</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>–</m:mo>
                <m:mn>10</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
          <!--Q#1-->
      <exercise id="exer-00008">
            <problem id="prob-00008">
              <para id="para-00047">What is the vertex of the quadratic?</para>

            </problem>
            <solution id="sol-00008">
              <para id="para-00048">Compare your answer: </para>
              <para id="para-00010"><m:math>
                  <m:mrow>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mn>7</m:mn>
                    <m:mo>,</m:mo>
                    <m:mo>–</m:mo>
                    <m:mn>9</m:mn>
                    <m:mo stretchy="false">)</m:mo>
                  </m:mrow>
                </m:math></para>
              <para id="para-00050"><emphasis>Step 1</emphasis> - Find the <m:math display="inline">
                  <m:mrow>
                    <m:mi>x</m:mi>
                  </m:mrow>
                </m:math>-intercepts.
          Set each factor equal to 0. <m:math display="inline">
                  <m:mrow>
                    <m:mi>x</m:mi>
                    <m:mo>–</m:mo>
                    <m:mn>4</m:mn>
                    <m:mo>=</m:mo>
                    <m:mn>0</m:mn>
                  </m:mrow>
                </m:math>
      <m:math display="inline">
                  <m:mrow>
                    <m:mi>x</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>4</m:mn>
                  </m:mrow>
                </m:math>
      <m:math display="inline">
                  <m:mrow>
                    <m:mi>x</m:mi>
                    <m:mo>–</m:mo>
                    <m:mn>10</m:mn>
                    <m:mo>=</m:mo>
                    <m:mn>0</m:mn>
                  </m:mrow>
                </m:math>
      <m:math display="inline">
                  <m:mrow>
                    <m:mi>x</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>10</m:mn>
                  </m:mrow>
                </m:math></para>
              <para id="para-00051"><emphasis>Step 2</emphasis> - Find the <m:math display="inline">
                  <m:mrow>
                    <m:mi>x</m:mi>
                  </m:mrow>
                </m:math>-coordinate of
          the vertex. The vertex is halfway between the two <m:math display="inline">
                  <m:mrow>
                    <m:mi>x</m:mi>
                  </m:mrow>
                </m:math>-intercepts. <m:math display="inline">
                  <m:mrow>
                    <m:mi>x</m:mi>
                    <m:mo>=</m:mo>
                    <m:mfrac>
                      <m:mrow>
                        <m:mn>4</m:mn>
                        <m:mo>+</m:mo>
                        <m:mn>10</m:mn>
                      </m:mrow>
                      <m:mrow>
                        <m:mn>2</m:mn>
                      </m:mrow>
                    </m:mfrac>
                    <m:mo>=</m:mo>
                    <m:mn>7</m:mn>
                  </m:mrow>
                </m:math></para>
              <para id="para-00052"><emphasis>Step 3</emphasis> - Find the <m:math display="inline">
                  <m:mrow>
                    <m:mi>y</m:mi>
                  </m:mrow>
                </m:math>-coordinate of
          the vertex. Substitute the <m:math display="inline">
                  <m:mrow>
                    <m:mi>x</m:mi>
                  </m:mrow>
                </m:math>-coordinate
          into <m:math display="inline">
                  <m:mrow>
                    <m:mi>f</m:mi>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mi>x</m:mi>
                    <m:mo stretchy="false">)</m:mo>
                  </m:mrow>
                </m:math>
          .
      <m:math display="inline">
                  <m:mrow>
                    <m:mi>f</m:mi>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mn>7</m:mn>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mo>=</m:mo>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mn>7</m:mn>
                    <m:mo>–</m:mo>
                    <m:mn>4</m:mn>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mn>7</m:mn>
                    <m:mo>–</m:mo>
                    <m:mn>10</m:mn>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mo>=</m:mo>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mn>3</m:mn>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mo>–</m:mo>
                    <m:mn>3</m:mn>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mo>=</m:mo>
                    <m:mo>–</m:mo>
                    <m:mn>9</m:mn>
                  </m:mrow>
                </m:math> The vertex is
          at <m:math display="inline">
                  <m:mrow>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mn>7</m:mn>
                    <m:mo>,</m:mo>
                    <m:mo>–</m:mo>
                    <m:mn>9</m:mn>
                    <m:mo stretchy="false">)</m:mo>
                  </m:mrow>
                </m:math>
          .</para>
            </solution>
          </exercise>
          <!--Interaction
          End -->
          <!--Q#2-->
      <exercise id="exer-00009">
            <problem id="prob-00009">
              <para id="para-00053">What is the axis of symmetry of the quadratic?</para>

            </problem>
            <solution id="sol-00009">
              <para id="para-00054">Compare your answer: </para>
              <para id="para-00016"><m:math>
                  <m:mrow>
                    <m:mi>x</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>7</m:mn>
                  </m:mrow>
                </m:math></para>
              <para id="para-00056">The axis of symmetry is the equation where <m:math display="inline">
                  <m:mrow>
                    <m:mi>x</m:mi>
                  </m:mrow>
                </m:math> equals the <m:math display="inline">
                  <m:mrow>
                    <m:mi>x</m:mi>
                  </m:mrow>
                </m:math>-coordinate of
          the vertex.</para>
            </solution>
          </exercise></note>
        <!--Interaction
        End -->
      </section>
    </section>
  
</section></content></document>