<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.8.3: Using Function Language and Notation</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01389</md:content-id>
    <md:title>5.8.3: Using Function Language and Notation</md:title>
