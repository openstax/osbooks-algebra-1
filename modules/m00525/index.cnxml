  <content>
    <section>
      <title>Activity</title>
      <para>Use this equation for questions 1 - 2: </para>
      <para>
        <quote>\( -\frac{4(x+3)}5 = 4x-12 \)</quote>
      </para>

        <exercise id="cf5d7555-46e1-4916-bcc4-aa2f409bafa8" class="multiple-choice">
          <problem>
            <para>Solve this equation. What is the value of \(x\)?</para>
          </problem>
          <solution>
            <para>Correct! 2</para>
            <para>Nice try! The correct answer is 2.</para>
          </solution>
        </exercise>

      <!-- END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#2-->
      <exercise>
        <problem>
          <para>Check your solution.</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <!--BEGIN
          ALIGN TO EQUALS -->
          <para>\(\begin{align*} -\frac{4(x+3)}5 &amp;= 4x-12 \\ -\frac{4(2+3)}5 &amp;= 4(2)-12 \\
            -\frac{4(5)}5 &amp;= 8-12 \\ -\frac{20}{5} &amp;= -4 \\ -4 &amp;= -4 \checkmark \\
            \end{align*}\)</para>
          <!--END
          ALIGN TO EQUALS -->
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <para>Use this inequality for questions 3 and 6: </para>
      <para>
        <quote>\( -\frac{4(x+3)}5 \leq 4x-12 \)</quote>
      </para>
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#3-->
      <exercise>
        <problem>
          <para>Choose a couple of values less than 2 for \( x \). Are they solutions to the
            inequality?</para>
        </problem>
        <solution>
          <para>Compare your answer: Values less than 2 are not solutions.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#4-->
      <exercise>
        <problem>
          <para>Choose a couple of values greater than 2 for \( x \). Are they solutions to the
            inequality?</para>

        </problem>
        <solution>
          <para>Compare your answer: Values greater than 2 are solutions.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#5-->
      <exercise>
        <problem>
          <para>Choose 2 for \( x \). Is it a solution to the inequality?</para>

        </problem>
        <solution>
          <para>Compare your answer: Yes, 2 is a solution.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->
      <!--Q#6-->

      <exercise>
        <problem>
          <para>Graph the solution to the inequality on the number line. 
            <figure class="unnumbered">
              <media alt="Alt text: A number line is shown from –10 to 10.&#10;        ">
