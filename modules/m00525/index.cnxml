<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Comparing Equality and Inequality</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00525</md:content-id>
    <md:title>Comparing Equality and Inequality</md:title>
    <md:uuid>91787161-140e-4d0e-812e-42439401dc16</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">
      <title>Activity</title>
      <para id="para-00001">Use this equation for questions 1 - 2:</para>
      <quote id="quote-00001"><m:math>
          <m:mrow>
            <m:mo>−</m:mo>
            <m:mfrac>
              <m:mrow>
                <m:mn>4</m:mn>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
              <m:mn>5</m:mn>
            </m:mfrac>
            <m:mo>=</m:mo>
            <m:mn>4</m:mn>
            <m:mi>x</m:mi>
            <m:mo>−</m:mo>
            <m:mn>12</m:mn>
          </m:mrow>
        </m:math></quote>


      <exercise id="cf5d7555-46e1-4916-bcc4-aa2f409bafa8" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00003">Solve this equation. What is the value of <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>?</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00004">2</para>
        </solution>
      </exercise>

      <!-- END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#2-->
      <exercise id="exer-00001">
        <problem id="prob-00002">
          <para id="para-00006">Check your solution.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00007">Compare your answer: </para>
          <!--BEGIN
          ALIGN TO EQUALS -->
          <para id="para-00008"><m:math>
              <m:mrow>
                <m:mtable displaystyle="true" rowspacing="3pt" columnspacing="0em 2em">
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mfrac>
                        <m:mrow>
                          <m:mn>4</m:mn>
                          <m:mo stretchy="false">(</m:mo>
                          <m:mi>x</m:mi>
                          <m:mo>+</m:mo>
                          <m:mn>3</m:mn>
                          <m:mo stretchy="false">)</m:mo>
                        </m:mrow>
                        <m:mn>5</m:mn>
                      </m:mfrac>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mi />
                      <m:mo>=</m:mo>
                      <m:mn>4</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>−</m:mo>
                      <m:mn>12</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mfrac>
                        <m:mrow>
                          <m:mn>4</m:mn>
                          <m:mo stretchy="false">(</m:mo>
                          <m:mn>2</m:mn>
                          <m:mo>+</m:mo>
                          <m:mn>3</m:mn>
                          <m:mo stretchy="false">)</m:mo>
                        </m:mrow>
                        <m:mn>5</m:mn>
                      </m:mfrac>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mi />
                      <m:mo>=</m:mo>
                      <m:mn>4</m:mn>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mn>2</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>12</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mfrac>
                        <m:mrow>
                          <m:mn>4</m:mn>
                          <m:mo stretchy="false">(</m:mo>
                          <m:mn>5</m:mn>
                          <m:mo stretchy="false">)</m:mo>
                        </m:mrow>
                        <m:mn>5</m:mn>
                      </m:mfrac>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mi />
                      <m:mo>=</m:mo>
                      <m:mn>8</m:mn>
                      <m:mo>−</m:mo>
                      <m:mn>12</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mfrac>
                        <m:mrow>
                          <m:mn>20</m:mn>
                        </m:mrow>
                        <m:mrow>
                          <m:mn>5</m:mn>
                        </m:mrow>
                      </m:mfrac>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mi />
                      <m:mo>=</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>4</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mn>4</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mi />
                      <m:mo>=</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>4</m:mn>
                      <m:mi>✓</m:mi>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
              </m:mrow>
            </m:math></para><!--END
          ALIGN TO EQUALS -->
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <para id="para-00009">Use this inequality for questions 3 and 6:</para>
      <quote id="quote-00002"><m:math>
          <m:mrow>
            <m:mo>−</m:mo>
            <m:mfrac>
              <m:mrow>
                <m:mn>4</m:mn>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
              <m:mn>5</m:mn>
            </m:mfrac>
            <m:mo>≤</m:mo>
            <m:mn>4</m:mn>
            <m:mi>x</m:mi>
            <m:mo>−</m:mo>
            <m:mn>12</m:mn>
          </m:mrow>
        </m:math></quote>

      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#3-->
      <exercise id="exer-00002">
        <problem id="prob-00003">
          <para id="para-00011">Choose a couple of values less than 2 for <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>. Are they solutions to
            the inequality?</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00012">Compare your answer: Values less than 2 are not solutions.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#4-->
      <exercise id="exer-00003">
        <problem id="prob-00004">
          <para id="para-00013">Choose a couple of values greater than 2 for <m:math
              display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>. Are they solutions to
            the inequality?</para>

        </problem>
        <solution id="sol-00004">
          <para id="para-00014">Compare your answer: Values greater than 2 are solutions.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#5-->
      <exercise id="exer-00004">
        <problem id="prob-00005">
          <para id="para-00015">Choose 2 for <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>. Is it a solution to the
            inequality?</para>

        </problem>
        <solution id="sol-00005">
          <para id="para-00016">Compare your answer: Yes, 2 is a solution.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->
      <!--Q#6-->

      <exercise id="exer-00005">
        <problem id="prob-00006">
          <para id="para-00017">Graph the solution to the inequality on the number line. <media
              alt="A blank number line that extends from negative 10 to positive 10 with a scale of one.">
              <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_11_10_01.svg" />
            </media>
          </para>
          <para id="para-00018" />
        </problem>
        <solution id="sol-00006">
          <para id="para-00019">Compare your answer: </para>

          <media
            alt="A number line is shown from negative 10 to 10. The point 2 has a closed circle. The numbers to the right of 2 are shaded.">
            <image mime-type="image/jpeg" src="../../media/Algebra-1_02_11_10_02.jpg" />
          </media>

        </solution>
      </exercise>
    </section>
    <!--Interaction
      End -->
    <!-- END CLICK TO REVEAL NO TEXTBOX -->
    <!-- BEGIN ARE YOU READY FOR MORE-->
