  <content>
    <section id="sect-00001">
      <title>Activity</title>
      <para id="para-00001">Use this equation for questions 1 - 2:</para>
      <para id="para-00002">
        <quote id="quote-00001">\( -\frac{4(x+3)}5 = 4x-12 \)</quote>
     </para>

        <exercise id="cf5d7555-46e1-4916-bcc4-aa2f409bafa8" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00003">Solve this equation. What is the value of \(x\)?</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00004">Correct! 2</para>
            <para id="para-00005">Nice try! The correct answer is 2.</para>
          </solution>
        </exercise>

      <!-- END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#2-->
      <exercise id="exer-00001">
        <problem id="prob-00002">
          <para id="para-00006">Check your solution.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00007">Compare your answer:</para>
          <!--BEGIN
          ALIGN TO EQUALS -->
          <para id="para-00008">\(\begin{align*} -\frac{4(x+3)}5 &amp;= 4x-12 \\ -\frac{4(2+3)}5 &amp;= 4(2)-12 \\
            -\frac{4(5)}5 &amp;= 8-12 \\ -\frac{20}{5} &amp;= -4 \\ -4 &amp;= -4 \checkmark \\
            \end{align*}\)</para>
          <!--END
          ALIGN TO EQUALS -->
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <para id="para-00009">Use this inequality for questions 3 and 6:</para>
      <para id="para-00010">
        <quote id="quote-00002">\( -\frac{4(x+3)}5 \leq 4x-12 \)</quote>
     </para>
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#3-->
      <exercise id="exer-00002">
        <problem id="prob-00003">
          <para id="para-00011">Choose a couple of values less than 2 for \( x \). Are they solutions to the
            inequality?</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00012">Compare your answer: Values less than 2 are not solutions.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#4-->
      <exercise id="exer-00003">
        <problem id="prob-00004">
          <para id="para-00013">Choose a couple of values greater than 2 for \( x \). Are they solutions to the
            inequality?</para>

        </problem>
        <solution id="sol-00004">
          <para id="para-00014">Compare your answer: Values greater than 2 are solutions.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#5-->
      <exercise id="exer-00004">
        <problem id="prob-00005">
          <para id="para-00015">Choose 2 for \( x \). Is it a solution to the inequality?</para>

        </problem>
        <solution id="sol-00005">
          <para id="para-00016">Compare your answer: Yes, 2 is a solution.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->
      <!--Q#6-->

      <exercise id="exer-00005">
        <problem id="prob-00006">
          <para id="para-00017">Graph the solution to the inequality on the number line. 
            
              <media alt="Alt text: A number line is shown from –10 to 10.
        ">
