  </metadata>
  <content>
  <section><title>Activity </title>
<para>Use this equation for questions 1 - 2:</para><blockquote> \( -\frac{4(x+3)}5 = 4x-12 \)</blockquote>

<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="e06f6b4c-c134-4e16-be11-119ad87c189a" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q#1-->
  <exercise data-content-id="cf5d7555-46e1-4916-bcc4-aa2f409bafa8" data-problem-comparator="integer" data-problem-type="input" data-solution="2">
    <problem>
      <para>Solve this equation. What is the value of \(x\)?</para>
      <para>Enter your answer here.</para>
    </problem>
    <solution>
      <para>Correct! 2</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>
<!-- END ACTIVITY INPUT 1 TRY -->
<!-- BEGIN TEXT ENTRY WITH REVEAL -->
<!--Q#2-->
<exercise>
  <problem>
    <para>Check your solution.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <!--BEGIN ALIGN TO EQUALS -->
    <para> \(\begin{align*}
      -\frac{4(x+3)}5 &amp;= 4x-12 \\
      -\frac{4(2+3)}5 &amp;= 4(2)-12 \\
      -\frac{4(5)}5 &amp;= 8-12 \\
      -\frac{20}{5} &amp;= -4 \\
      -4 &amp;= -4 \checkmark \\
      \end{align*}\) </para>
    <!--END ALIGN TO EQUALS -->
  </solution></exercise>
<!--Interaction End -->
<!-- END TEXT ENTRY WITH REVEAL -->
<para>Use this inequality for questions 3 and 6:</para><blockquote>\( -\frac{4(x+3)}5 \leq 4x-12 \)</blockquote>

<!-- BEGIN TEXT ENTRY WITH REVEAL -->
<!--Q#3-->
<exercise>
  <problem>
    <para>Choose a couple of values less than 2 for \( x \). Are they solutions to the inequality?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer: Values less than 2 are not solutions.</para>
  </solution></exercise>
<!--Interaction End -->
<!-- END TEXT ENTRY WITH REVEAL -->
<!-- BEGIN TEXT ENTRY WITH REVEAL -->
<!--Q#4-->
<exercise>
  <problem>
    <para>Choose a couple of values greater than 2 for \( x \). Are they solutions to the inequality?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer: Values greater than 2 are solutions.</para>
  </solution></exercise>
<!--Interaction End -->
<!-- END TEXT ENTRY WITH REVEAL -->
<!-- BEGIN TEXT ENTRY WITH REVEAL -->
<!--Q#5-->
<exercise>
  <problem>
    <para>Choose 2 for \( x \). Is it a solution to the inequality?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer: Yes, 2 is a solution.</para>
  </solution></exercise>
<!--Interaction End -->
<!-- END TEXT ENTRY WITH REVEAL -->
<!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->
<!--Q#6-->
<example><exercise>
  <problem>
    
    <para>Graph the solution to the inequality on the number line.<figure><media alt="Alt text: A number line is shown from –10 to 10.&#10;        "><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/8f140b959777227ee21aa603d13ec9bd376932f0"/></media></figure></para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <figure><media alt="A number line is shown from –10 to 10. The point 2 has a closed circle. The number to the right of 2 is shaded.&#10;  "><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/56ad43c627c2d858620bda139ee80f36f5f8271b"/></media></figure></solution></exercise>
</example><!--Interaction End -->
<!-- END CLICK TO REVEAL NO TEXTBOX -->
