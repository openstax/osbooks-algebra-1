<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.9.5: Comparing Equality and Inequality</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00525</md:content-id>
    <md:title>2.9.5: Comparing Equality and Inequality</md:title>
    <md:uuid>91787161-140e-4d0e-812e-42439401dc16</md:uuid>
  </metadata>
  <content>
    <section>
      <title>Activity 
</title>
      <para>Use this equation for questions 1 - 2:
</para>
      <para>
        <quote>\( -\frac{4(x+3)}5 = 4x-12 \)</quote>
      </para>
      <section class="check-understanding">
        <exercise id="cf5d7555-46e1-4916-bcc4-aa2f409bafa8" class="multiple-choice">
          <problem>
            <para>Enter your answer here.</para>
            <para>Solve this equation. What is the value of \(x\)?</para>
          </problem>
          <solution>
            <para>Correct! 2</para>
            <para>Nice try! The correct answer is 2.</para>
          </solution>
        </exercise>
      </section>
      <!-- END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#2-->
      <exercise>
        <problem>
          <para>Check your solution.</para>
        </problem>
        <solution>
          <para>Enter your answer here:</para>
          <para>Compare your answer:</para>
          <!--BEGIN ALIGN TO EQUALS -->
          <para> \(\begin{align*}
      -\frac{4(x+3)}5 &amp;= 4x-12 \\
      -\frac{4(2+3)}5 &amp;= 4(2)-12 \\
      -\frac{4(5)}5 &amp;= 8-12 \\
      -\frac{20}{5} &amp;= -4 \\
      -4 &amp;= -4 \checkmark \\
      \end{align*}\) </para>
          <!--END ALIGN TO EQUALS -->
        </solution>
      </exercise>
      <!--Interaction End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <para>Use this inequality for questions 3 and 6:
</para>
      <para>
        <quote>\( -\frac{4(x+3)}5 \leq 4x-12 \)</quote>
      </para>
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#3-->
      <exercise>
        <problem>
          <para>Choose a couple of values less than 2 for \( x \). Are they solutions to the inequality?</para>
        </problem>
        <solution>
          <para>Enter your answer here:</para>
          <para>Compare your answer: Values less than 2 are not solutions.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#4-->
      <exercise>
        <problem>
          <para>Choose a couple of values greater than 2 for \( x \). Are they solutions to the inequality?</para>
        </problem>
        <solution>
          <para>Enter your answer here:</para>
          <para>Compare your answer: Values greater than 2 are solutions.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#5-->
      <exercise>
        <problem>
          <para>Choose 2 for \( x \). Is it a solution to the inequality?</para>
        </problem>
        <solution>
          <para>Enter your answer here:</para>
          <para>Compare your answer: Yes, 2 is a solution.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->
      <!--Q#6-->
      <example>
        <exercise>
          <problem>
            <para>Graph the solution to the inequality on the number line.
        <figure><media alt="Alt text: A number line is shown from –10 to 10.&#10;        "><image mime-type="image/svg+xml" src="../../media/Algebra-1_02_11_10_01.svg"/></media></figure></para>
            <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
          </problem>
          <solution>
            <para>Compare your answer:</para>
            <figure>
              <media alt="A number line is shown from –10 to 10. The point 2 has a closed circle. The number to the right of 2 is shaded.&#10;  ">
                <image mime-type="image/jpeg" src="../../media/Algebra-1_02_11_10_02.jpg"/>
              </media>
            </figure>
          </solution>
        </exercise>
      </example>
      <!--Interaction End -->
      <!-- END CLICK TO REVEAL NO TEXTBOX -->
      <!-- BEGIN ARE YOU READY FOR MORE-->
      <!-- "Start "Are you Ready for More? click to reveal.  If you have more than one on a page, you will need to change the Data-fire/data-wait-for-events for each set.-->
      <example>
        <exercise>
          <problem>
            <!-- INSERT ANY VALID HTML HERE -->
            <!-- INSERT ANY VALID HTML HERE -->
          </problem>
        </exercise>
      </example>
      <!--Start interaction.  If multiple interactions appear under "are you ready for more?, they should all have matching "data-wait-for-event", which should also match the "data-fire-event" for the button. Note in this sample, they are all RFM1-->
      <exercise data-wait-for-event="RFM1">
        <problem>
          <title>Extending Your Thinking</title>
          <para>Here is a different type of inequality: \(x^2\leq4\).</para>
          <para>Which of the following values solve the inequality: 1, 3 or -3?</para>
        </problem>
        <solution>
          <para>Enter your answer here:</para>
          <para>Compare your answer:</para>
          <para>From the given values, only 1 is a solution of the inequality.</para>
        </solution>
      </exercise>
      <!--End interaction-->
      <exercise data-wait-for-event="RFM1">
        <problem>
          <para>Describe all solutions to this inequality. (If you like, you can graph the solutions on a number line.)</para>
        </problem>
        <solution>
          <para>Enter your answer here:</para>
          <para>Compare your answer:</para>
          <para>\( -2 ≤ x ≤ 2 \)</para>
        </solution>
      </exercise>
      <!--End interaction-->
      <exercise data-wait-for-event="RFM1">
        <problem>
          <para>Describe all solutions to the inequality \(x^2\geq9\). Test several numbers to make sure your answer is correct.</para>
        </problem>
        <solution>
          <para>Enter your answer here:</para>
          <para>Compare your answer:</para>
          <para>\( x ≤-3 \) or \( x ≥ 3 \)</para>
        </solution>
      </exercise>
      <!--End interaction-->
      <!-- END ARE YOU READY FOR MORE-->
    </section>
  </content>
