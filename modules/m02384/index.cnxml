<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.4.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02384</md:content-id>
    <md:title>9.4.6: Practice</md:title>
    <md:uuid>e699b91b-22b7-4a7d-86be-133cdb15732f</md:uuid>
  </metadata>
  <content>
  <section><para><emphasis><emphasis>Students will complete the following questions to practice the skills they have learned in this lesson.</emphasis></emphasis></para>
<list class="os-raise-noindent" type="enumerated">
  <item><emphasis>Select three </emphasis>expressions that are perfect squares.</item>
</list>
<list class="os-raise-noindent">
  <item>\(9x^2+24x+16\)</item>
  <item>\(2x^2+20x+100\)</item>
  <item>\((7-3x)^2\)</item>
  <item>\((5x+4)(5x-4)\)</item>
  <item>\((1-2x)(-2x+1)\)</item>
  <item>\(4x^2+6x+94\)</item>
</list>
<para><emphasis>Answer:</emphasis> \(9x^2+24x+16\), \((7-3x)^2\), \((1-2x)(-2x+1)\)</para>
<list class="os-raise-noindent" start="2" type="enumerated">
  <item>Find the missing number that makes the expression a perfect square.</item>
</list>
<list class="os-raise-noindent" type="enumerated">
  <item>\(49x^2-\_\_\_\_\_\_x+16\)</item>
</list>
<para><emphasis>Answer:</emphasis> 56
  \(49x^2-56x+16\)</para>
<list class="os-raise-noindent" start="2" type="enumerated">
  <item>\(36x^2+\_\_\_\_\_\_x+4\)</item>
</list>
<para><emphasis>Answer:</emphasis> 24
  \(36x^2+24x+4\)</para>
<list class="os-raise-noindent" start="3" type="enumerated">
  <item>\(4x^2-\_\_\_\_\_\_x+25\)</item>
</list>
<para><emphasis>Answer:</emphasis> 20
  \(4x^2-20x+25\)</para>
<list class="os-raise-noindent" start="4" type="enumerated">
  <item>\(9x^2+\_\_\_\_\_\_x+9\)</item>
</list>
<para><emphasis>Answer:</emphasis> 18
  \(9x^2+18x+9\)</para>
<list class="os-raise-noindent" start="5" type="enumerated">
  <item>\(121x^2+\_\_\_\_\_\_x+9\)</item>
</list>
<para><emphasis>Answer:</emphasis> 66
  \(121x^2+66x+9\)</para>
<list class="os-raise-noindent" start="3" type="enumerated">
  <item>Choose the completely factored form of the expression.</item>
</list>
<list class="os-raise-noindent" type="enumerated">
  <item>\(49x^2-56x+16\)</item>
</list>
<list class="os-raise-noindent">
  <item>\((7x+4)^2\)</item>
  <item>\((49x-16)^2\)</item>
  <item>\((7x-4)^2\)</item>
  <item>\((28x-11)^2\)</item>
</list>
<para><emphasis>Answer:</emphasis> \((7x-4)^2\)</para>
<list class="os-raise-noindent" start="2" type="enumerated">
  <item>\(36x^2+24x+4\)</item>
</list>
<list class="os-raise-noindent">
  <item>\((6x-2)^2\)</item>
  <item>\((36x+4)^2\)</item>
  <item>\((6x+2)^2\)</item>
  <item>\(4(3x+1)^2\)</item>
</list>
<para><emphasis>Answer:</emphasis> \(4(3x+1)^2\)</para>
<list class="os-raise-noindent" start="3" type="enumerated">
  <item>\(4x^2-20x+25\)</item>
</list>
<list class="os-raise-noindent">
  <item>(\(10x+7)^2\)</item>
  <item>\((2x-5)^2\)</item>
  <item>\((4x-25)^2\)</item>
  <item>\((2x+5)^2\)</item>
</list>
<para><emphasis>Answer:</emphasis> \((2x-5)^2\)</para>
<list class="os-raise-noindent" start="4" type="enumerated">
  <item>\(121x^2+66x+9\)</item>
</list>
<list class="os-raise-noindent">
  <item>\((11x+3)^2\)</item>
  <item>\((121x-9)^2\)</item>
  <item>\((3x-3)^2\)</item>
  <item>\((11x-3)^2\)</item>
</list>
<para><emphasis>Answer:</emphasis> \((11x+3)^2\)</para>
<list class="os-raise-noindent" start="4" type="enumerated">
  <item>Find the missing number that makes the expression a perfect square.</item>
</list>
<list class="os-raise-noindent" type="enumerated">
  <item>\(9x^2+42x+\_\_\_\_\_\)</item>
</list>
<para><emphasis>Answer:</emphasis> 49
  \(9x^2+42x+49\)</para>
<list class="os-raise-noindent" start="2" type="enumerated">
  <item>\(49x^2-28x+\_\_\_\_\_\)</item>
</list>
<para><emphasis>Answer:</emphasis> 4
  \(49x^2-28x+4\)</para>
<list class="os-raise-noindent" start="3" type="enumerated">
  <item>\(25x^2+110x+\_\_\_\_\_\)</item>
</list>
<para><emphasis>Answer:</emphasis> 121
  \(25x^2+110x+121\)</para>
<list class="os-raise-noindent" start="4" type="enumerated">
  <item>\(64x^2-144x+\_\_\_\_\_\)</item>
</list>
<para><emphasis>Answer:</emphasis> 81
  \(64x^2-144x+81\)</para>
<list class="os-raise-noindent" start="5" type="enumerated">
  <item>\(4x^2+24x+\_\_\_\_\_\)</item>
</list>
<para><emphasis>Answer:</emphasis> 36
  \(4x^2+24x+36\)</para>
<list class="os-raise-noindent" start="5" type="enumerated">
  <item>Based on your responses in question 4 above, choose the factored form of the expression.</item>
</list>
<list class="os-raise-noindent" type="enumerated">
  <item>\(9x^2+42x+\_\_\_\_\_\)</item>
</list>
<list class="os-raise-noindent">
  <item>\((3x+7)^2\)</item>
  <item>\((9x-21)^2\)</item>
  <item>\((3x-7)^2\)</item>
  <item>\((9x+3)^2\)</item>
</list>
<para><emphasis>Answer:</emphasis> \((3x+7)^2\)</para>
<list class="os-raise-noindent" start="2" type="enumerated">
  <item>\(49x^2-28x+\_\_\_\_\_\)</item>
</list>
<list class="os-raise-noindent">
  <item>\((4x+7)^2\)</item>
  <item>\((7x+2)^2\)</item>
  <item>\((7x-2)^2\)</item>
  <item>\((7x+7)^2\)</item>
</list>
<para><emphasis>Answer:</emphasis> \((7x-2)^2\)</para>
<list class="os-raise-noindent" start="3" type="enumerated">
  <item>\(25x^2+110x+\_\_\_\_\_\)</item>
</list>
<list class="os-raise-noindent">
  <item>\((5x-11)^2\)</item>
  <item>\((11x+5)^2\)</item>
  <item>\((11x-5)^2\)</item>
  <item>\((5x+11)^2\)</item>
</list>
<para><emphasis>Answer:</emphasis> \((5x+11)^2\)</para>
<list class="os-raise-noindent" start="4" type="enumerated">
  <item>\(64x^2-144x+\_\_\_\_\_\)</item>
</list>
<list class="os-raise-noindent">
  <item>\((72x-17)^2\)</item>
  <item>\((8x-9)^2\)</item>
  <item>\((64x-9)^2\)</item>
  <item>\((8x+9)^2\)</item>
</list>
<para><emphasis>Answer:</emphasis> \((8x-9)^2\)</para>
<list class="os-raise-noindent" start="5" type="enumerated">
  <item>\(4x^2+24x+\_\_\_\_\_\)</item>
</list>
<list class="os-raise-noindent">
  <item>\((2x-6)^2\)</item>
  <item>\((4x-26)^2\)</item>
  <item>\((2x+6)^2\)</item>
  <item>\((x+6)^2\)</item>
</list>
<para><emphasis>Answer:</emphasis> \((2x+6)^2\)</para>
<list class="os-raise-noindent" start="6" type="enumerated">
  <item>For each expression, find the value of \(c\) to make a perfect square in standard form \((ax^2+bx+c)\).</item>
</list>
<list class="os-raise-noindent" type="enumerated">
  <item>\(4x^2+4x+c\)</item>
</list>
<para><emphasis>Answer:</emphasis> 1
  \(4x^2+4x+1\)</para>
<list class="os-raise-noindent" start="2" type="enumerated">
  <item>\(25x^2-30x+c\)</item>
</list>
<para><emphasis>Answer:</emphasis> 9
  \(25x^2-30x+9\) </para>
<list class="os-raise-noindent" start="7" type="enumerated">
  <item>Use the value of \(c\) needed to make the expression a perfect square (from the previous question). Then, solve each equation.
  </item>
</list>
<list class="os-raise-noindent" type="enumerated">
  <item>\(4x^2+4x+c =0\)</item>
</list>
<list class="os-raise-noindent">
  <item>\(\frac12\)</item>
  <item>\(-\frac12\)</item>
  <item>\(\frac32\)</item>
  <item>\(-\frac32\)</item>
  <item>2</item>
  <item>\(\frac16\)</item>
</list>
<para><emphasis>Answer:</emphasis> \(-\frac12\)</para>
<list class="os-raise-noindent" start="2" type="enumerated">
  <item>\(25x^2-30x+c=0\)</item>
</list>
<list class="os-raise-noindent">
  <item>\(x=\frac12\)</item>
  <item>\(x=-\frac45\)</item>
  <item>\(x=\frac25\)</item>
  <item>\(x = 4\)</item>
  <item>\(x = 5\)</item>
  <item>\(x=\frac35\)</item>
</list>
<para><emphasis>Answer:</emphasis> \(x=\frac35\)</para></section>
</content>
