<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Properties of Exponents with Rationals</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01263</md:content-id>
    <md:title>Properties of Exponents with Rationals</md:title>
    <md:uuid>4c241771-88e4-4f91-9e19-a8f7e79adea9</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
<para id="para-00001">The activities you learned in a prior lesson taught you the properties of exponents. These same properties work with rational exponents.</para>
<para id="para-00002">Simplify each expression, and then check your answers.</para>
<exercise id="exer-00001">
  <problem id="prob-00001">
    
    <para id="para-00003"><m:math><m:mrow><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo stretchy="false">)</m:mo></m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:msup></m:mrow></m:math></para><para id="para-00004"/>
  
  </problem><solution id="sol-00001">
  <para id="para-00005">Compare your answer: </para>
  
  <para id="para-00006"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:msup></m:mrow></m:math></para></solution></exercise>
<exercise id="exer-00002">
  <problem id="prob-00002">
    
    <para id="para-00007"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:msup><m:mspace width="0.278em"/><m:mi>·</m:mi><m:mspace width="0.278em"/><m:msup><m:mi>x</m:mi><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:msup></m:mrow></m:math></para><para id="para-00008"/>
  
  </problem><solution id="sol-00002">
  <para id="para-00009">Compare your answer: </para>
  
  <para id="para-00010"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mfrac><m:mn>4</m:mn><m:mn>3</m:mn></m:mfrac></m:msup></m:mrow></m:math></para></solution></exercise>
<exercise id="exer-00003">
  <problem id="prob-00003">
    
    <para id="para-00011"><m:math><m:mrow><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:msup><m:mi>x</m:mi><m:mrow><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:msup><m:mo stretchy="false">)</m:mo></m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac></m:msup></m:mrow></m:math></para><para id="para-00012"/>
  
  </problem><solution id="sol-00003">
  <para id="para-00013">Compare your answer: </para>
  
  <para id="para-00014"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>6</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:msup><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mfrac><m:mn>1</m:mn><m:mrow><m:msup><m:mi>x</m:mi><m:mrow><m:mfrac><m:mn>6</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para></solution></exercise>
<exercise id="exer-00004">
  <problem id="prob-00004">
    
    <para id="para-00015"><m:math><m:mrow><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:msup><m:mi>x</m:mi><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:msup><m:mo stretchy="false">)</m:mo></m:mrow><m:mrow><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msup></m:mrow></m:math></para><para id="para-00016"/>
  
  </problem><solution id="sol-00004">
  <para id="para-00017">Compare your answer: </para>
  
  <para id="para-00018"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:msup><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mfrac><m:mn>1</m:mn><m:mrow><m:msup><m:mi>x</m:mi><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para></solution></exercise>
</section>
</content>
</document>