<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.2.4: Properties of Exponents with Rationals</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01263</md:content-id>
    <md:title>5.2.4: Properties of Exponents with Rationals</md:title>
    <md:uuid>4c241771-88e4-4f91-9e19-a8f7e79adea9</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Cool Down Activity</title>
<para id="para-00001">The activities you learned in a prior lesson taught you the properties of exponents. These same properties work with rational exponents.</para>
<para id="para-00002">Simplify each expression, and then check your answers. Double click on mathematical expressions/equations to enlarge.</para>
<exercise id="exer-00001">
  <problem id="prob-00001">
    
    <para id="para-00003">\({(x^2)}^\frac13\)</para>
    <para id="para-00004">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00001">
  <para id="para-00005">Compare your answer:</para>
  
  <para id="para-00006">\(x^\frac23\)</para>

</solution></exercise>
<exercise id="exer-00002">
  <problem id="prob-00002">
    
    <para id="para-00007">\(x^\frac23\;\cdot\;x^\frac23\)</para>
    <para id="para-00008">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00002">
  <para id="para-00009">Compare your answer:</para>
  
  <para id="para-00010">\(x^\frac43\)</para>

</solution></exercise>
<exercise id="exer-00003">
  <problem id="prob-00003">
    
    <para id="para-00011">\({(x^{-3})}^\frac25\)</para>
    <para id="para-00012">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00003">
  <para id="para-00013">Compare your answer:</para>
  
  <para id="para-00014">\(x^{-\frac65}\;=\;\frac1{x^{\frac65}}\)</para>

</solution></exercise>
<exercise id="exer-00004">
  <problem id="prob-00004">
    
    <para id="para-00015">\({(x^\frac13)}^{-1}\)</para>
    <para id="para-00016">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00004">
  <para id="para-00017">Compare your answer:</para>
  
  <para id="para-00018">\(x^{-\frac13}\;=\;\frac1{x^{\frac13}}\)</para>

</solution></exercise>
</section>
</content>
