      <section class="check-understanding">
        <exercise id="cc45646c-927c-45a7-87dc-f6a96a7f8579" class="multiple-choice">
          <problem>
            
            <para>When the price is \($5\) per download, what is the revenue in thousands of dollars?</para>
          </problem>
          <solution>
            <para>Correct! The revenue is \($65,000\) when the price is \($5\) per download.</para>
            <para>Try again.</para>
          </solution>
        </exercise>
        <exercise id="e7aaccfc-0240-497a-a0c9-ec861b2dda1c" class="multiple-choice">
          <problem>
            
            <para>When the price is \($10\) per download, what is the revenue in thousands of dollars?</para>
          </problem>
          <solution>
            <para>Correct! The revenue is \($80,000\) when the price is \($10\) per download.</para>
            <para>Try again.</para>
          </solution>
        </exercise>
        <exercise id="_4e88c474-49f1-4712-b1dc-46b99de880c6" class="multiple-choice">
          <problem>
            
            <para>When the price is \($12\) per download, what is the revenue in thousands of dollars?</para>
          </problem>
          <solution>
            <para>Correct! The revenue is \($72,000\) when the price is \($12\) per download.</para>
            <para>Try again.</para>
          </solution>
        </exercise>
        <exercise id="bd176bc0-c793-43b2-b1b6-fd641dfb4775" class="multiple-choice">
          <problem>
            
            <para>When the price is \($15\) per download, what is the revenue in thousands of dollars?</para>
          </problem>
          <solution>
            <para>Correct! The revenue is \($45,000\) when the price is \($15\) per download.</para>
            <para>Try again.</para>
          </solution>
        </exercise>
        <exercise id="_042887c7-c333-4cf5-bc62-0e91427afd6d" class="multiple-choice">
          <problem>
            
            <para>When the price is \($18\) per download, what is the revenue in thousands of dollars?</para>
          </problem>
          <solution>
            <para>Correct! The revenue is \(0\) when the price is \($18\) per download.</para>
            <para>Try again.</para>
          </solution>
        </exercise>
