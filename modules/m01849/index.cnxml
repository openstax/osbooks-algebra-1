      <section class="check-understanding">
        <title>Activity</title>
        <exercise id="_31235259-bc95-4698-b236-52c61d0a8525" class="multiple-choice">
          <problem>
            
            <para>When the price is \($5\) per download, what is the number of downloads in thousands?</para>
          </problem>
          <solution>
            <para>Correct! There are \(13\) thousand downloads when the price is \($5\) per download.</para>
            <para>Try again.</para>
          </solution>
        </exercise>
        <exercise id="a4f04d9b-9922-4779-b613-60f9e71080a9" class="multiple-choice">
          <problem>
            
            <para>When the price is \($10\) per download, what is the number of downloads in thousands?</para>
          </problem>
          <solution>
            <para>Correct! There are \(8,000\) downloads when the price is \($10\) per download.</para>
            <para>Try again.</para>
          </solution>
        </exercise>
        <exercise id="_0586c43d-779a-4e6b-bb60-9f543ef4b31d" class="multiple-choice">
          <problem>
            
            <para>When the price is \($12\) per download, what is the number of downloads in thousands?</para>
          </problem>
          <solution>
            <para>Correct! There are \(6,000\) downloads when the price is \($12\) per download.</para>
            <para>Try again.</para>
          </solution>
        </exercise>
        <exercise id="_3b858498-3a64-4358-8dc6-7268d8abf190" class="multiple-choice">
          <problem>
            
            <para>When the price is \($15\) per download, what is the number of downloads in thousands?</para>
          </problem>
          <solution>
            <para>Correct! There are \(3,000\) downloads when the price is \($15\) per download.</para>
            <para>Try again.</para>
          </solution>
        </exercise>
        <exercise id="_7aceacfd-a174-43be-8421-91a3be927b97" class="multiple-choice">
          <problem>
            
            <para>When the price is \($18\) per download, what is the number of downloads in thousands?</para>
          </problem>
          <solution>
            <para>Correct! There are \(0\) downloads when the price is \($18\) per download.</para>
            <para>Try again.</para>
          </solution>
        </exercise>
