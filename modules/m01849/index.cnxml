  <!--Q1a-->
  <exercise data-content-id="cc45646c-927c-45a7-87dc-f6a96a7f8579" data-problem-comparator="integer" data-problem-type="input" data-solution="65">
    <problem>
      <para> When the price is \($5\) per download, what is the revenue in thousands of dollars? </para>
        <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! The revenue is \($65,000\) when the price is \($5\) per download.</para>
