<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Describe Mathematically Changes in Growth</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01285</md:content-id>
    <md:title>Describe Mathematically Changes in Growth</md:title>
    <md:uuid>c777ea4f-47f6-4c7d-b4cc-5ed8be4fa1fc</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
<para id="para-00001">The tables show the cat population on two islands over several years. Describe mathematically, as precisely as you
  can, how the cat population on each island is changing.</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001" class="unnumbered">
  <problem id="prob-00001">
    <table class="unnumbered os-raise-horizontaltable" id="table-00001">
      <tgroup cols="6"><tbody><row>
          <entry><emphasis>year</emphasis></entry><entry>
            0
          </entry>
          <entry>
            1
          </entry>
          <entry>
            2
          </entry>
          <entry>
            3
          </entry>
          <entry>
            4
          </entry>
        </row>
        <row>
          <entry><emphasis>number of cats on Meow Island</emphasis></entry><entry>
            2
          </entry>
          <entry>
            6
          </entry>
          <entry>
            18
          </entry>
          <entry>
            54
          </entry>
          <entry>
            162
          </entry>
        </row>
      </tbody></tgroup></table>
    
    
    
    <table class="unnumbered os-raise-horizontaltable" id="table-00002">
      <tgroup cols="6"><tbody><row>
          <entry><emphasis>year</emphasis></entry><entry>
            0
          </entry>
          <entry>
            1
          </entry>
          <entry>
            2
          </entry>
          <entry>
            3
          </entry>
          <entry>
            4
          </entry>
        </row>
        <row>
          <entry><emphasis>number of cats on Purr Island</emphasis></entry><entry>
            2
          </entry>
          <entry>
            6
          </entry>
          <entry>
            10
          </entry>
          <entry>
            14
          </entry>
          <entry>
            18
          </entry>
        </row>
      </tbody></tgroup></table>
    
    
  
  </problem><solution id="sol-00001">
    
    
  
  <para id="para-00002">Your answers may vary, but here is an example:</para>
    
    <para id="para-00003">The cat population on Meow Island is:</para>
    
    <list id="list-00001">
      <item>tripling each year</item>
      <item>growing by a common ratio each year</item>
    </list>
    
    <para id="para-00004">The cat population on Purr Island is:</para>
    
    <list id="list-00002">
      <item>adding 4 cats each year</item>
      <item>characterized by a common difference each year</item>
    </list>
  
  </solution></exercise>
<!--Interaction End -->
</section>
</content>
