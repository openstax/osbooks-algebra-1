  </metadata>
  <content>
  <section><title> Cool Down Activity</title>
<para>The tables show the cat population on two islands over several years. Describe mathematically, as precisely as you
  can, how the cat population on each island is changing.</para>

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <table class="os-raise-horizontaltable">
      <tgroup cols="6"><tbody><row>
          <entry><emphasis>year</emphasis></entry><entry>
            0
          </entry>
          <entry>
            1
          </entry>
          <entry>
            2
          </entry>
          <entry>
            3
          </entry>
          <entry>
            4
          </entry>
        </row>
        <row>
          <entry><emphasis>number of cats on Meow Island</emphasis></entry><entry>
            2
          </entry>
          <entry>
            6
          </entry>
          <entry>
            18
          </entry>
          <entry>
            54
          </entry>
          <entry>
            162
          </entry>
        </row>
      </tbody></tgroup></table>
    
    
    
    <table class="os-raise-horizontaltable">
      <tgroup cols="6"><tbody><row>
          <entry><emphasis>year</emphasis></entry><entry>
            0
          </entry>
          <entry>
            1
          </entry>
          <entry>
            2
          </entry>
          <entry>
            3
          </entry>
          <entry>
            4
          </entry>
        </row>
        <row>
          <entry><emphasis>number of cats on Purr Island</emphasis></entry><entry>
            2
          </entry>
          <entry>
            6
          </entry>
          <entry>
            10
          </entry>
          <entry>
            14
          </entry>
          <entry>
            18
          </entry>
        </row>
      </tbody></tgroup></table>
    
    
  
  </problem><solution>
    
    
  
  <para>Your answers may vary, but here is an example:</para>
    
    <para>The cat population on Meow Island is:</para>
    
    <list>
      <item>tripling each year</item>
      <item>growing by a common ratio each year</item>
    </list>
    
    <para>The cat population on Purr Island is:</para>
    
    <list>
      <item>adding 4 cats each year</item>
      <item>characterized by a common difference each year</item>
    </list>
  
  </solution></exercise>
<!--Interaction End -->
</section>
</content>
