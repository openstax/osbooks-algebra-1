<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.3.5: Describe Mathematically Changes in Growth</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01285</md:content-id>
    <md:title>5.3.5: Describe Mathematically Changes in Growth</md:title>
