<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.10.6 Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01034</md:content-id>
    <md:title>4.10.6 Practice</md:title>
    <md:uuid>25116715-383f-4477-867f-3a35f6088c31</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <para id="para-00002">Use the following scenario and graph to answer question 1.</para>
      <para id="para-00003">
        <quote id="quote-00001">Functions <m:math display="inline"><m:mrow><m:mi>R</m:mi></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>D</m:mi></m:mrow></m:math> give the height, in feet, of a toy rocket and a drone, <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> seconds after they are released.</quote>
    </para>

        <exercise id="dda9a192-afb9-4d84-af71-cf27430be6a1" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00004">Here are the graphs of <m:math display="inline"><m:mrow><m:mi>R</m:mi></m:mrow></m:math> (for the rocket) and <m:math display="inline"><m:mrow><m:mi>D</m:mi></m:mrow></m:math> (for the drone).</para>
            <para id="para-00005">
                      <media alt="Two functions graphed on a cooridnate plane.">
                  <image mime-type="image/svg+xml" src="../../media/Algebra-1_04_13_13_01.svg"/>
                </media>
              
          </para>
            <para id="para-00006">Decide whether the following statements are true or false.</para>
            <para id="para-00007"><m:math><m:mrow><m:mi>R</m:mi><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>&gt;</m:mo><m:mi>D</m:mi><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00008">Correct! True</para>
            <para id="para-00009">Try again. Revisit activity 4.10.4.</para>
            <para id="para-00010">The correct answer is true.</para>
          </solution>
        </exercise>
        <exercise id="_8d4965ce-4ed6-47c7-84a5-8f386fd24131" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00011"><m:math><m:mrow><m:mi>R</m:mi><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>D</m:mi><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00012">Correct! False</para>
            <para id="para-00013">Try again. Revisit activity 4.10.4.</para>
            <para id="para-00014">The correct answer is false.</para>
          </solution>
        </exercise>
        <exercise id="_6dfc5704-a1ba-4f7b-a75e-ca6124401256" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00015"><m:math><m:mrow><m:mi>R</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4.5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>D</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4.5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00016">Correct! True</para>
            <para id="para-00017">Try again. Revisit activity 4.10.4.</para>
            <para id="para-00018">The correct answer is true.</para>
          </solution>
        </exercise>
        <exercise id="_806539da-ea72-4105-8022-54c376c3d87a" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00019"><m:math><m:mrow><m:mi>R</m:mi><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>D</m:mi><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>25</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00020">Correct! True</para>
            <para id="para-00021">Try again. Revisit activity 4.10.4.</para>
            <para id="para-00022">The correct answer is true.</para>
          </solution>
        </exercise>
        <exercise id="_1d35db9a-6af8-44ae-bec5-d9bb9b0cfad3" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00023"><m:math><m:mrow><m:mi>D</m:mi><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo><m:mo>&gt;</m:mo><m:mi>R</m:mi><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00024">Correct! False</para>
            <para id="para-00025">Try again. Revisit activity 4.10.4.</para>
            <para id="para-00026">The correct answer is false.</para>
          </solution>
        </exercise>
        <exercise id="_0ddaab9d-60de-4e61-a407-65e98a20f548" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00027"><m:math display="inline"><m:mrow><m:mi>A</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math> is the average high temperature in Aspen, Colorado, <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> months after the start of the year. <m:math display="inline"><m:mrow><m:mi>M</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math> is the average high temperature in Minneapolis, Minnesota, <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> months after the start of the year. Temperature is measured in degrees Fahrenheit.</para>
            <para id="para-00028">
                      <media alt="">
                  <image mime-type="image/jpeg" src="../../media/Algebra-1_04_13_13_02.jpg"/>
                </media>
              
          </para>
            <para id="para-00029">Which function had the higher average rate of change between the beginning of January and middle of March?</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00030">Correct! Minneapolis</para>
            <para id="para-00031">Try again. Revisit activities 4.10.2.</para>
            <para id="para-00032">The correct answer is Minneapolis.</para>
          </solution>
        </exercise>
        <exercise id="_9a273719-f18c-482a-b3ba-fe24ef89a14f" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00033">Here are two graphs representing functions <m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>g</m:mi></m:mrow></m:math>. 
          (<media alt="Insert Alt Text"><image mime-type="image/svg+xml" src="../../media/Algebra-1_04_13_13_03.svg"/></media>)<emphasis>Select the three</emphasis> statements that are true about functions <m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>g</m:mi></m:mrow></m:math>.</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00034">Correct! There are values of <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> where <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>&lt;</m:mo><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>, and <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>&gt;</m:mo><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
            <para id="para-00035">Try again. Revisit activity 4.10.2.</para>
            <para id="para-00036">The correct answers are: There are values of <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> where <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>&lt;</m:mo><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>, and <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>&gt;</m:mo><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.
      
    </para>
          </solution>
        </exercise>
        <exercise id="_4e794bf6-e260-4a61-a58a-17ac911bdea1" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00037">For questions 4 – 6, use the three graphs below:</para>
            <para id="para-00038">
              <quote id="quote-00002">The three graphs represent the progress of three runners in a 400-meter race.
         The solid line represents Runner A. The dotted line represents Runner B. The dashed line represents Runner C.</quote>
          </para>
            <para id="para-00039">
                      <media alt="Insert Alt Text">
                  <image mime-type="image/svg+xml" src="../../media/Algebra-1_04_13_13_04.svg"/>
                </media>
              
          </para>
            <para id="para-00040">Which runner ran at a constant rate throughout the race?</para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00041">Correct! Runner C</para>
            <para id="para-00042">Try again. Revisit activities 4.10.2.</para>
            <para id="para-00043">The correct answer is Runner C.</para>
          </solution>
        </exercise>
        <exercise id="_04ab420e-4add-46e5-882c-2d284935828d" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00044">Which runner stopped running for a while?</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00045">Correct! Runner A</para>
            <para id="para-00046">Try again. Revisit activities 4.10.2.</para>
            <para id="para-00047">The correct answer is Runner A.</para>
          </solution>
        </exercise>
        <exercise id="f6688a12-f180-460e-adbe-77007465867b" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00048">Which runner won the race?</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00049">Correct! Runner C</para>
            <para id="para-00050">Try again. Revisit activities 4.10.2.</para>
            <para id="para-00051">The correct answer is Runner C.</para>
          </solution>
        </exercise>
        <exercise id="_6051a616-ba9f-4e8b-9a5f-e1609189532b" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00052">Use the graphs below for questions 7 – 8.</para>
            <para id="para-00053">Show A                                             Show B                                   Show C</para>
            <para id="para-00054">
                      <media alt="Insert Alt Text">
                  <image mime-type="image/jpeg" src="../../media/Algebra-1_04_13_13_05.jpg"/>
                </media>
              
          </para>
            <para id="para-00055">Which show had the largest audience for episode 4?</para>
          </problem>
          <solution id="sol-00011">
            <para id="para-00056">Correct! Show B</para>
            <para id="para-00057">Try again. Revisit activity 4.10.3.</para>
            <para id="para-00058">The correct answer is Show B.</para>
          </solution>
        </exercise>
        <exercise id="_59eb0e33-4424-4a1b-8eae-2ef7a75ce41c" class="multiple-choice">
          <problem id="prob-00012">
            <para id="para-00059">Which show had the largest audience for their first episode?</para>
          </problem>
          <solution id="sol-00012">
            <para id="para-00060">Correct! Show B</para>
            <para id="para-00061">Try again. Revisit activity 4.10.3.</para>
            <para id="para-00062">The correct answer is Show B.</para>
          </solution>
        </exercise>

    </section>
  </content>
