                </m:msup>
                <m:mo>−</m:mo>
                <m:mn>4</m:mn>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>−</m:mo>
                <m:mn>5</m:mn>
                <m:mo>&amp;checkmark;</m:mo>
