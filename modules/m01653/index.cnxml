                    <m:mi>y</m:mi>
                    <m:mo>−</m:mo>
                    <m:mn>4</m:mn>
                    <m:mi>y</m:mi>
                    <m:mo>+</m:mo>
                    <m:mn>14</m:mn>
                  </m:mrow>
                  <m:mo>)</m:mo>
                </m:mrow>
              </m:mtd>
            </m:mtr>
            <m:mtr>
