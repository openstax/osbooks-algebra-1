                    <m:msup>
                      <m:mi>y</m:mi>
                      <m:mn>2</m:mn>
                    </m:msup>
                    <m:mo>−</m:mo>
                    <m:mn>11</m:mn>
                    <m:mi>y</m:mi>
                    <m:mo>+</m:mo>
                    <m:mn>14</m:mn>
                  </m:mrow>
                  <m:mo>)</m:mo>
                </m:mrow>
              </m:mtd>
            </m:mtr>
            <m:mtr>
              <m:mtd columnalign="center">
                <m:mn>10</m:mn>
                <m:msup>
                  <m:mi>y</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>−</m:mo>
                <m:mn>55</m:mn>
                <m:mi>y</m:mi>
                <m:mo>+</m:mo>
                <m:mn>70</m:mn>
                <m:mo>&amp;checkmark;</m:mo>
              </m:mtd>
            </m:mtr>
          </m:mtable>
        </m:mrow>
      </m:mrow>
