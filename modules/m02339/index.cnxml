<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.1.4: Explain Why an Expression Is a Perfect Square</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02339</md:content-id>
    <md:title>9.1.4: Explain Why an Expression Is a Perfect Square</md:title>
    <md:uuid>26cd04d5-61b7-4b7f-a8f4-23347ff66bfb</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00001">Explain why it makes sense to call the expression <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>20</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>100</m:mn></m:mrow></m:math> a <term class="glossary-tooltip" id="term-00001">perfect square</term>.</para>
          <para id="para-00002">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Compare your answer:</para>
          <para id="para-00004">It is equivalent to <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>, so it is a factor squared.</para>
        </solution>
      </exercise>
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00005">Solve <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>20</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>100</m:mn><m:mo>=</m:mo><m:mn>81</m:mn></m:mrow></m:math>.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00006">Enter the solutions to this equation.</para>
          <para id="para-00007">Compare your answer:</para>
          <para id="para-00008"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>19</m:mn></m:mrow></m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
    </section>
  </content>
</document>
