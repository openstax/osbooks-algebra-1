<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.1.4: Explain Why an Expression Is a Perfect Square</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02339</md:content-id>
    <md:title>9.1.4: Explain Why an Expression Is a Perfect Square</md:title>
    <md:uuid>26cd04d5-61b7-4b7f-a8f4-23347ff66bfb</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Cool Down Activity</title>
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00001">Explain why it makes sense to call the expression \(x^2+20x+100\) a <term class="glossary-tooltip" id="term-00001">perfect square</term>.</para>
          <para id="para-00002">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Compare your answer:</para>
          <para id="para-00004">It is equivalent to \((x+10)^2\), so it is a factor squared.</para>
        </solution>
      </exercise>
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00005">Solve \(x^2+20x+100=81\).</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00006">Enter the solutions to this equation.</para>
          <para id="para-00007">Compare your answer:</para>
          <para id="para-00008">\(x = -1\) and \(x = -19\)</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
    </section>
  </content>
