<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>What Are the Patterns?</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01132</md:content-id>
    <md:title>What Are the Patterns?</md:title>
    <md:uuid>60963ba9-7da8-4fca-8823-dd5840082225</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>
    <para id="para-00005">Examine the patterns of numbers given below.</para>
<list id="list-00001">
  <item>
    40, 120, 360, 1,080, 3,240
 </item>
  <item>
    2, 8, 32, 128, 512
 </item>
  <item>
    1,000, 500, 250, 125, 62.5
 </item>
  <item>
    256, 192, 144, 108, 81
 </item>
</list>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00001">What do you notice?</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00002">Compare your answers:</para>
    
    <list id="list-00002">
      <item>
        The first two sequences are increasing, and the second two are decreasing.
     </item>
      <item>
        The next number in the list comes from always multiplying the previous number by the same value.
     </item>
      <item>
        If we choose a number in the list and divide it by the previous number, we always get the same value.
     </item>
    </list>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00003">What do you wonder?</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00004">Compare your answers:</para>
    
    <list id="list-00003">
      <item>
        Why do all the sequences start with even numbers?
     </item>
      <item>
        Will the last sequence eventually have decimal numbers like the one before it since it is also decreasing?
     </item>
      <item>
        Are these sequences related in some way?
     </item>
      <item>
        Is the next term of the second sequence 1,024?
     </item>
    </list>
  
  </solution></exercise>
<!--Interaction End -->
</section>
</content></document>