<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xmlns:null="http://katalysteducation.org/cmlnle/1.0">
  <title>2.13.1: Graphing Inequalities with Technology</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00604</md:content-id>
    <md:title>2.13.1: Graphing Inequalities with Technology</md:title>
    <md:uuid>b6a08301-c9ef-496f-8b7b-db11a461ba92</md:uuid>
