<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xmlns:null="http://katalysteducation.org/cmlnle/1.0">
  <title>2.13.1: Graphing Inequalities with Technology</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00604</md:content-id>
    <md:title>2.13.1: Graphing Inequalities with Technology</md:title>
    <md:uuid>b6a08301-c9ef-496f-8b7b-db11a461ba92</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Warm Up Activity</title>
      <note id="note-00001">
      <para id="para-00001">Access the <link url="https://k12.openstax.org/contents/raise/resources/b62c9150250bf52d6cc37569213ab516e0090dca">Desmos
        guide PDF</link> for tips on solving problems with the Desmos graphing calculator.</para>
      </note>

      <para id="para-00002">Graph each inequality. Adjust the graphing window as needed to show meaningful
        information.</para>

      <exercise id="exer-00001">
        <problem id="prob-00001">
          <!--QUESTION
          IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
          <para id="para-00003">Use the graphing tool or technology outside the course. Graph the inequality \( y &gt;
            x \) using the Desmos tool below.</para>
        <media alt="">
        <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
        </media>
          <para id="para-00004">Write down your answer, then select the <emphasis>solution</emphasis> button to
            compare your work.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00005">Example:</para>
          <para id="para-00006"><m:math><m:mrow><m:mi>y</m:mi><m:mo>&gt;</m:mo><m:mi>x</m:mi></m:mrow></m:math></para>

          
            <media alt="Graph of inequality. ">
              <image mime-type="image/png" src="../../media/Algebra-1_02_15_02_01.png"/>
            </media>
          

        </solution>
      </exercise>

      <!--Q2-->
  
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <!--QUESTION
          IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
          <para id="para-00007">Use the graphing tool or technology outside the course. Graph the inequality \( y \geq
            x \) using the Desmos tool below.</para>
        <media alt="">
        <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
        </media>
          <para id="para-00008">Write down your answer, then select the <emphasis>solution</emphasis> button to
            compare your work.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00009">Example:</para>
          <para id="para-00010"><m:math><m:mrow><m:mi>y</m:mi><m:mo>≥</m:mo><m:mi>x</m:mi></m:mrow></m:math></para>

          
            <media alt="Graph of inequality. ">
              <image mime-type="image/png" src="../../media/Algebra-1_02_15_02_02.png"/>
            </media>
          

        </solution>
      </exercise>

      <!--Q3-->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <!--QUESTION
          IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
          <para id="para-00011">Use the graphing tool or technology outside the course. Graph the inequality <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>&lt;</m:mo><m:mtext>-</m:mtext><m:mn>8</m:mn></m:mrow></m:math> using the Desmos tool below.</para>
        <media alt="">
        <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
        </media>
          <para id="para-00012">Write down your answer, then select the <emphasis>solution</emphasis> button to
            compare your work.</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00013">Example:</para>
          <para id="para-00014"><m:math><m:mrow><m:mi>y</m:mi><m:mo>&lt;</m:mo><m:mtext>-</m:mtext><m:mn>8</m:mn></m:mrow></m:math></para>

          
            <media alt="Graph of inequality. ">
              <image mime-type="image/png" src="../../media/Algebra-1_02_15_02_03.png"/>
            </media>
          
        </solution>
      </exercise>

      <!--Q4-->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <!--QUESTION
          IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
          <para id="para-00015">Use the graphing tool or technology outside the course. Graph the inequality <m:math display="inline"><m:mrow><m:mtext>-</m:mtext><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi></m:mrow></m:math> using the Desmos tool below.</para>
        <media alt="">
        <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
        </media>
          <para id="para-00016">Write down your answer, then select the <emphasis>solution</emphasis> button to
            compare your work.</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00017">Example:</para>
          <para id="para-00018"><m:math><m:mrow><m:mtext>-</m:mtext><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi></m:mrow></m:math></para>

          
            <media alt="Graph of inequality. ">
              <image mime-type="image/png" src="../../media/Algebra-1_02_15_02_04.png"/>
            </media>
          

        </solution>
      </exercise>

      <!--Q5-->
      <exercise id="exer-00005">
        <problem id="prob-00005">
          <!--QUESTION
          IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
          <para id="para-00019">Use the graphing tool or technology outside the course. Graph the inequality \( y &lt;
            10x - 200 \) using the Desmos tool below.</para>
            <media alt="">
              <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
              </media>
          <para id="para-00020">Write down your answer, then select the <emphasis>solution</emphasis> button to
            compare your work.</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00021">Example:</para>
          <para id="para-00022"><m:math><m:mrow><m:mi>y</m:mi><m:mo>&lt;</m:mo><m:mn>10</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>200</m:mn></m:mrow></m:math></para>

          
            <media alt="Graph of inequality. ">
              <image mime-type="image/png" src="../../media/Algebra-1_02_15_02_05.png"/>
            </media>
          

        </solution>
      </exercise>

      <!--Q6-->
      <exercise id="exer-00006">
        <problem id="prob-00006">
          <!--QUESTION
          IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
          <para id="para-00023">Use the graphing tool or technology outside the course. Graph the inequality \( 2x +
            3y &gt; 60 \) using the Desmos tool below.</para>
            <media alt="">
              <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
              </media>
          <para id="para-00024">Write down your answer, then select the <emphasis>solution</emphasis> button to
            compare your work.</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00025">Example:</para>
          <para id="para-00026"> <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>&gt;</m:mo><m:mn>60</m:mn></m:mrow></m:math></para>

          
            <media alt="Graph of inequality. ">
              <image mime-type="image/png" src="../../media/Algebra-1_02_15_02_06.png"/>
            </media>
          

        </solution>
      </exercise>

    </section>
  </content>
