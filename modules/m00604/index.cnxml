        </problem>
        <solution id="sol-00005">
          <para id="para-00021">Example:</para>
          <para id="para-00022">\( y &lt; 10x - 200 \)</para>

          
            <media alt="Graph of inequality. ">
              <image mime-type="image/png" src="../../media/Algebra-1_02_15_02_05.png"/>
            </media>
          

        </solution>
      </exercise>

      <!--Q6-->
      <exercise id="exer-00006">
        <problem id="prob-00006">
          <!--QUESTION
          IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
          <para id="para-00023">Use the graphing tool or technology outside the course. Graph the inequality \( 2x +
            3y > 60 \) using the Desmos tool below.</para>
            <media alt="">
              <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
              </media>
          <para id="para-00024">Write down your answer, then select the <emphasis>solution</emphasis> button to
            compare your work.</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00025">Example:</para>
          <para id="para-00026"> \( 2x + 3y > 60 \)</para>

          
            <media alt="Graph of inequality. ">
              <image mime-type="image/png" src="../../media/Algebra-1_02_15_02_06.png"/>
            </media>
          

