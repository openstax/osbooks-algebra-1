      <!--Interaction End -->
      <!--Q#9-->
      <exercise>
        <problem>
          <para>Using desmos, adjust the slope and/or the \(y\)-intercept to find an inequality that could be a possibility.</para>
          
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>Answers may vary.</para>
          <para>These are possible representation of where the line could on the graph</para>
          <div class="os-raise-d-flex os-raise-justify-content-between">
            <para><emphasis>Less than</emphasis>
        
        \(y&lt;2x\)
        <figure><media alt="Insert Alt Text"><image mime-type="image/png" src="../../media/Algebra-1_02_15_09_06.png"/></media></figure></para>
            <para><emphasis>Less than or equal to</emphasis>
        
        \(y^2x-1\)
        <figure><media alt="Insert Alt Text"><image mime-type="image/png" src="../../media/Algebra-1_02_15_09_07.png"/></media></figure></para>
            <para><emphasis>Greater than</emphasis>
        
        \(y&gt;x-7\)
        <figure><media alt="Insert Alt Text"><image mime-type="image/png" src="../../media/Algebra-1_02_15_09_08.png"/></media></figure></para>
            <para><emphasis>Greater than or equal to</emphasis>
        \(y&gt;x-6\)
        <figure><media alt="ea43ef5b5a2f10d594e518d4673515e5c32687a6 (234×306)"><image mime-type="image/png" src="../../media/Algebra-1_02_15_09_09.png"/></media></figure><emphasis></emphasis></para>
            <para>
             <emphasis>Not a solution</emphasis>
              <figure>
                <media alt="Insert Alt Text">
                  <image mime-type="image/png" src="../../media/Algebra-1_02_15_09_10.png"/>
                </media>
              </figure>
           </para>
          
          <newline/>
        </solution>
