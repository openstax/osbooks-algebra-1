  <section><title>Activity</title>

<example><exercise>
  <problem>
    
    <para>Each row in the table contains a pair of equivalent expressions.</para>
    
    <para>Complete the table with the missing expressions. If you get stuck, consider drawing a diagram.</para>
    
    <table class="os-raise-midsizetable">
      <tgroup cols="2"><tbody><row>
          <entry><emphasis>
            Factored form
          </emphasis></entry><entry><emphasis>
            Standard form
          </emphasis></entry></row>
      <row>
          <entry>
            \(x(x + 7)\)
          </entry>
          <entry> </entry>
        </row>
        <row>
          <entry> </entry>
          <entry>
            \(x^2+ 9x\)
          </entry>
        </row>
        <row>
          <entry> </entry>
          <entry>
            \(x^2−8x\)
          </entry>
        </row>
        <row>
          <entry>
            \((x + 6)(x + 2)\)
          </entry>
          <entry> </entry>
        </row>
        <row>
          <entry> </entry>
          <entry>
            \(x^2+13x +12\)
          </entry>
        </row>
        <row>
          <entry>
            \((x − 6)(x − 2)\)
          </entry>
          <entry> </entry>
        </row>
        <row>
          <entry> </entry>
          <entry>
            \(x^2−7x +12\)
          </entry>
        </row>
        <row>
          <entry> </entry>
          <entry>
            \(x^2+6x + 9\)
          </entry>
        </row>
        <row>
          <entry> </entry>
          <entry>
            \(x^2+ 10x + 9\)
          </entry>
        </row>
        <row>
          <entry> </entry>
          <entry>
            \(x^2−10x +9\)
          </entry>
        </row>
        <row>
          <entry> </entry>
          <entry>
            \(x^2−6x +9\)
          </entry>
        </row>
        <row>
          <entry> </entry>
          <entry>
            \(x^2+(m + n)x +mn\)
          </entry>
        </row>
      </tbody></tgroup></table>
    
    
  
  <para>Write down your answers, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution>
  <para>Compare your answers:</para>
  
  <table class="os-raise-midsizetable">
    <tgroup cols="2"><tbody><row>
        <entry><emphasis>
          Factored form
        </emphasis></entry><entry><emphasis>
          Standard form
        </emphasis></entry></row>
    <row>
        <entry>
          \(x(x + 7)\)
        </entry>
        <entry>
          \(x^2+7x\)
        </entry>
      </row>
      <row>
        <entry>
          \(x(x + 9)\)
        </entry>
        <entry>
          \(x^2+9x\)
        </entry>
      </row>
      <row>
        <entry>
          \(x(x − 8)\)
        </entry>
        <entry>
          \(x^2−8x\)
        </entry>
      </row>
      <row>
        <entry>
          \((x + 6)(x + 2)\)
        </entry>
        <entry>
          \(x^2+8x+12\)
        </entry>
      </row>
      <row>
        <entry>
          \((x + 12)(x + 1)\)
        </entry>
        <entry>
          \(x^2+13x +12\)
        </entry>
      </row>
      <row>
        <entry>
          \((x − 6)(x − 2)\)
        </entry>
        <entry>
          \(x^2−8x +12\)
        </entry>
      </row>
      <row>
        <entry>
          \((x − 4)(x − 3)\)
        </entry>
        <entry>
          \(x^2−7x +12\)
        </entry>
      </row>
      <row>
        <entry>
          \((x + 3)(x + 3)\)
        </entry>
        <entry>
          \(x^2+6x +9\)
        </entry>
      </row>
      <row>
        <entry>
          \((x + 9)(x + 1)\)
        </entry>
        <entry>
          \(x^2+10x +9\)
        </entry>
      </row>
      <row>
        <entry>
          \((x − 9)(x − 1)\)
        </entry>
        <entry>
          \(x^2−10x +9\)
        </entry>
      </row>
      <row>
        <entry>
          \((x − 3)(x − 3)\)
        </entry>
        <entry>
          \(x^2− 6x +9\)
        </entry>
      </row>
      <row>
        <entry>
          \((x + m)(x + n)\)
        </entry>
        <entry>
          \(x^2+(m + n)x + mn\)
        </entry>
      </row>
    </tbody></tgroup></table>

</solution></exercise>
</example>
