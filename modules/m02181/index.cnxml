  <content>
    <section class="numbered-exercises" id="sect-00001">
      <title>Activity</title>
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00001">Each row in the table contains a pair of equivalent expressions.</para>
          <para id="para-00002">Complete the table with the missing expressions. If you get stuck,
            consider drawing a diagram.</para>
          <table class="unnumbered os-raise-midsizetable" id="table-00001">
            <tgroup cols="2">
            
  <tbody>
                <row>
                  <entry><emphasis> Factored form </emphasis>
                  </entry>
                  <entry><emphasis> Standard form </emphasis>
                  </entry>
                </row>
                <row>
                  <entry>
                    <m:math display="inline">
                      <m:mrow>
                        <m:mi>x</m:mi>
                        <m:mo stretchy="false">(</m:mo>
                        <m:mi>x</m:mi>
                        <m:mo>+</m:mo>
                        <m:mn>7</m:mn>
                        <m:mo stretchy="false">)</m:mo>
                      </m:mrow>
                    </m:math>
                  </entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry> </entry>
                  <entry>
                    <m:math display="inline">
                      <m:mrow>
                        <m:msup>
                          <m:mi>x</m:mi>
                          <m:mn>2</m:mn>
                        </m:msup>
                        <m:mo>+</m:mo>
                        <m:mn>9</m:mn>
                        <m:mi>x</m:mi>
                      </m:mrow>
                    </m:math>
                  </entry>
                </row>
                <row>
                  <entry> </entry>
                  <entry>
                    <m:math display="inline">
                      <m:mrow>
                        <m:msup>
                          <m:mi>x</m:mi>
                          <m:mn>2</m:mn>
                        </m:msup>
                        <m:mi>−</m:mi>
                        <m:mn>8</m:mn>
                        <m:mi>x</m:mi>
                      </m:mrow>
                    </m:math>
                  </entry>
                </row>
                <row>
                  <entry>
                    <m:math display="inline">
                      <m:mrow>
                        <m:mo stretchy="false">(</m:mo>
                        <m:mi>x</m:mi>
                        <m:mo>+</m:mo>
                        <m:mn>6</m:mn>
                        <m:mo stretchy="false">)</m:mo>
                        <m:mo stretchy="false">(</m:mo>
                        <m:mi>x</m:mi>
                        <m:mo>+</m:mo>
                        <m:mn>2</m:mn>
                        <m:mo stretchy="false">)</m:mo>
                      </m:mrow>
                    </m:math>
                  </entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry> </entry>
                  <entry>
                    <m:math display="inline">
                      <m:mrow>
                        <m:msup>
                          <m:mi>x</m:mi>
                          <m:mn>2</m:mn>
                        </m:msup>
                        <m:mo>+</m:mo>
                        <m:mn>13</m:mn>
                        <m:mi>x</m:mi>
                        <m:mo>+</m:mo>
                        <m:mn>12</m:mn>
                      </m:mrow>
                    </m:math>
                  </entry>
                </row>
                <row>
                  <entry>
                    <m:math display="inline">
                      <m:mrow>
                        <m:mo stretchy="false">(</m:mo>
                        <m:mi>x</m:mi>
                        <m:mi>−</m:mi>
                        <m:mn>6</m:mn>
                        <m:mo stretchy="false">)</m:mo>
                        <m:mo stretchy="false">(</m:mo>
                        <m:mi>x</m:mi>
                        <m:mi>−</m:mi>
                        <m:mn>2</m:mn>
                        <m:mo stretchy="false">)</m:mo>
                      </m:mrow>
                    </m:math>
                  </entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry> </entry>
                  <entry>
                    <m:math display="inline">
                      <m:mrow>
                        <m:msup>
                          <m:mi>x</m:mi>
                          <m:mn>2</m:mn>
                        </m:msup>
                        <m:mi>−</m:mi>
                        <m:mn>7</m:mn>
                        <m:mi>x</m:mi>
                        <m:mo>+</m:mo>
                        <m:mn>12</m:mn>
                      </m:mrow>
                    </m:math>
                  </entry>
                </row>
                <row>
                  <entry> </entry>
                  <entry>
                    <m:math display="inline">
                      <m:mrow>
                        <m:msup>
                          <m:mi>x</m:mi>
                          <m:mn>2</m:mn>
                        </m:msup>
                        <m:mo>+</m:mo>
                        <m:mn>6</m:mn>
                        <m:mi>x</m:mi>
                        <m:mo>+</m:mo>
                        <m:mn>9</m:mn>
                      </m:mrow>
                    </m:math>
                  </entry>
                </row>
                <row>
                  <entry> </entry>
                  <entry>
                    <m:math display="inline">
                      <m:mrow>
                        <m:msup>
                          <m:mi>x</m:mi>
                          <m:mn>2</m:mn>
                        </m:msup>
                        <m:mo>+</m:mo>
                        <m:mn>10</m:mn>
                        <m:mi>x</m:mi>
                        <m:mo>+</m:mo>
                        <m:mn>9</m:mn>
                      </m:mrow>
                    </m:math>
                  </entry>
                </row>
                <row>
                  <entry> </entry>
                  <entry>
                    <m:math display="inline">
                      <m:mrow>
                        <m:msup>
                          <m:mi>x</m:mi>
                          <m:mn>2</m:mn>
                        </m:msup>
                        <m:mi>−</m:mi>
                        <m:mn>10</m:mn>
                        <m:mi>x</m:mi>
                        <m:mo>+</m:mo>
                        <m:mn>9</m:mn>
                      </m:mrow>
                    </m:math>
                  </entry>
                </row>
                <row>
                  <entry> </entry>
                  <entry>
                    <m:math display="inline">
                      <m:mrow>
                        <m:msup>
                          <m:mi>x</m:mi>
                          <m:mn>2</m:mn>
                        </m:msup>
                        <m:mi>−</m:mi>
                        <m:mn>6</m:mn>
                        <m:mi>x</m:mi>
                        <m:mo>+</m:mo>
                        <m:mn>9</m:mn>
                      </m:mrow>
                    </m:math>
                  </entry>
                </row>
                <row>
                  <entry> </entry>
                  <entry>
                    <m:math display="inline">
                      <m:mrow>
                        <m:msup>
                          <m:mi>x</m:mi>
                          <m:mn>2</m:mn>
                        </m:msup>
                        <m:mo>+</m:mo>
                        <m:mo stretchy="false">(</m:mo>
                        <m:mi>m</m:mi>
                        <m:mo>+</m:mo>
                        <m:mi>n</m:mi>
                        <m:mo stretchy="false">)</m:mo>
                        <m:mi>x</m:mi>
                        <m:mo>+</m:mo>
                        <m:mi>m</m:mi>
                        <m:mi>n</m:mi>
                      </m:mrow>
                    </m:math>
                  </entry>
                </row>
              </tbody>
            </tgroup>
          </table>
          <para id="para-00003">Write down your answers, then select the <emphasis>solution</emphasis>
            button to compare your work.</para>
        </problem>
