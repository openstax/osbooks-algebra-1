        </list>
      </entry>
      <entry> </entry>
    </row>
    <row>
      <entry>
        <para>\(18\)</para>
      </entry>
      <entry>
        <list class="os-raise-noindent" start="5" type="enumerated">
          <item> _____ </item>
        </list>
