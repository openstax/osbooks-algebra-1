<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.2.4: Multiplying Special Products</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01598</md:content-id>
    <md:title>6.2.4: Multiplying Special Products</md:title>
    <md:uuid>5bf1c2af-677d-428c-98b1-cb74a23307ed</md:uuid>
  </metadata>
  <content>
  <section><title>Activity </title>
<para>Multiply each expression. Identify each as a binomial square or a conjugate pair (difference of squares). Use the "^" symbol to enter an exponent.</para>
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> \((3x - 7)^2\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(9x^2 - 42x + 49\); binomial square</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> \((6z + 4)(6z - 4)\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(36z^2 - 16\); conjugate pair</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> \((4a + 2b)(4a + 2b)\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(16a^2 + 16ab + 4b^2\); binomial square</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(
        (3w - 9p)(3w + 9p)\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(9w^2 - 81p^2\); conjugate pair</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> \((2y - 8n)(2y + 8n)\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(4y^2 - 64n^2\); conjugate pair</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\((5k + 2)(5k + 2)\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(25k^2 + 20k + 4\); binomial square</para>
  </solution></exercise>
<!--Interaction End --></section>
</content>
