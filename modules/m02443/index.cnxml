<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.7.1: Evaluating Variable Expressions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02443</md:content-id>
    <md:title>9.7.1: Evaluating Variable Expressions</md:title>
    <md:uuid>41c4b1bc-59bb-4b49-9c13-827b2a3ac0bf</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Warm Up Activity</title>
      <para id="para-00001">Evaluate each expression for \(a=9\), \(b=-5\), and \(c=-2\).</para>
      <exercise id="_2ce28f30-9311-45ec-8259-4a441abd6f6b" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00002">Enter the value of \(-b\).</para>
          <para id="para-00003">\(-b\)</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00004">Correct! \(-(-5)=5\)</para>
          <para id="para-00005">The correct answer is 5: \(-(-5)=5\).</para>
        </solution>
      </exercise>
      <exercise id="_713726b7-cb7a-440b-a5cc-d66fcd5df6d2" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00006">Enter the value of \(b^2\).</para>
          <para id="para-00007">\(b^2\)</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00008">Correct! \((-5)^2=25\)</para>
          <para id="para-00009">The correct answer is 25: \((-5)^2=25\).</para>
        </solution>
      </exercise>
      <exercise id="_3959ab64-2000-442d-9e18-4ab69756c335" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00010">Enter the value of \(b^2−4ac\).</para>
          <para id="para-00011">\(b^2−4ac\)</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00012">Correct! \((-5)^2−4(9)(-2)=25-(36)(-2)=25-(-72)=25+72=97\)</para>
          <para id="para-00013">The correct answer is 97: \((-5)^2−4(9)(-2)=25-(36)(-2)=25-(-72)=25+72=97\).</para>
        </solution>
      </exercise>
      <exercise id="_7335966d-dc58-4542-a715-339e24f82cd1" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00014"><emphasis>Select two</emphasis> answers for \(-b \pm \sqrt{a}\).</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00015">Correct! \(-(-5)+\sqrt{9}=5+3=8\) and \(-(-5)-\sqrt{9}=5-3=2\)</para>
          <para id="para-00016">The correct answers are 2 and 8: \(-(-5)+\sqrt{9}=5+3=8\) and \(-(-5)-\sqrt{9}=5-3=2\)</para>
        </solution>
      </exercise>
    </section>
  </content>
</document>