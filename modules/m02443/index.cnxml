<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Evaluating Variable Expressions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02443</md:content-id>
    <md:title>Evaluating Variable Expressions</md:title>
    <md:uuid>41c4b1bc-59bb-4b49-9c13-827b2a3ac0bf</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>
      <para id="para-00001">Evaluate each expression for <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mo>–</m:mo><m:mn>5</m:mn></m:mrow></m:math>, and <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mo>–</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
      <exercise id="_2ce28f30-9311-45ec-8259-4a441abd6f6b" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00002">What is the value of <m:math display="inline"><m:mrow><m:mo>–</m:mo><m:mi>b</m:mi></m:mrow></m:math>?</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00004"><m:math display="inline"><m:mrow><m:mo>–</m:mo><m:mo stretchy="false">(</m:mo><m:mo>–</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
        </solution>
      </exercise>
      <exercise id="_713726b7-cb7a-440b-a5cc-d66fcd5df6d2" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00006">What is the value of <m:math display="inline"><m:mrow><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>?</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00008"><m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>–</m:mo><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>25</m:mn></m:mrow></m:math></para>
        </solution>
      </exercise>
      <exercise id="_3959ab64-2000-442d-9e18-4ab69756c335" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00010">What is the value of <m:math display="inline"><m:mrow><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>–</m:mo><m:mn>4</m:mn><m:mi>a</m:mi><m:mi>c</m:mi></m:mrow></m:math>?</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00012"><m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>–</m:mo><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>–</m:mo><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>–</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>25</m:mn><m:mo>–</m:mo><m:mo stretchy="false">(</m:mo><m:mn>36</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>–</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>25</m:mn><m:mo>–</m:mo><m:mo stretchy="false">(</m:mo><m:mo>–</m:mo><m:mn>72</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>25</m:mn><m:mo>+</m:mo><m:mn>72</m:mn><m:mo>=</m:mo><m:mn>97</m:mn></m:mrow></m:math></para>
        </solution>
      </exercise>
      <exercise id="_7335966d-dc58-4542-a715-339e24f82cd1" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00014"><emphasis>Select two</emphasis> answers for <m:math display="inline"><m:mrow><m:mo>–</m:mo><m:mi>b</m:mi><m:mi>±</m:mi><m:msqrt><m:mrow><m:mi>a</m:mi></m:mrow></m:msqrt></m:mrow></m:math>.</para>
          <list number-style="lower-alpha" list-type="enumerated" id="list-00001">
            <item>–14</item>
            <item>8</item>
            <item>2</item>
            <item>4</item>
          </list>
        </problem>
        <solution id="sol-00004">
          <para id="para-00015"><m:math display="inline"><m:mrow><m:mo>–</m:mo><m:mo stretchy="false">(</m:mo><m:mo>–</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:msqrt><m:mrow><m:mn>9</m:mn></m:mrow></m:msqrt><m:mo>=</m:mo><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo>–</m:mo><m:mo stretchy="false">(</m:mo><m:mo>–</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>–</m:mo><m:msqrt><m:mrow><m:mn>9</m:mn></m:mrow></m:msqrt><m:mo>=</m:mo><m:mn>5</m:mn><m:mo>–</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
          <para id="para-00016">The correct answers are 2 and 8: <m:math display="inline"><m:mrow><m:mo>–</m:mo><m:mo stretchy="false">(</m:mo><m:mo>–</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:msqrt><m:mrow><m:mn>9</m:mn></m:mrow></m:msqrt><m:mo>=</m:mo><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo>–</m:mo><m:mo stretchy="false">(</m:mo><m:mo>–</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>–</m:mo><m:msqrt><m:mrow><m:mn>9</m:mn></m:mrow></m:msqrt><m:mo>=</m:mo><m:mn>5</m:mn><m:mo>–</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
        </solution>
      </exercise>
    </section>
  </content>
</document>