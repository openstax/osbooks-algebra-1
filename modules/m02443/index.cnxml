<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.7.1: Evaluating Variable Expressions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02443</md:content-id>
    <md:title>9.7.1: Evaluating Variable Expressions</md:title>
    <md:uuid>63079e95-5bab-49d2-9931-a77d93c11327</md:uuid>
  </metadata>
  <content>
  <section><title>Warm Up Activity</title>
<para>Evaluate each expression for \(a=9\), \(b=-5\), and \(c=-2\).</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="809882b5-47f0-495f-acfe-b8bc6fe450c1" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1a-->
  <exercise data-content-id="2ce28f30-9311-45ec-8259-4a441abd6f6b" data-problem-comparator="integer" data-problem-type="input" data-solution="5">
    <problem>
      <para>\(-b\)</para>
      <para>Enter the value of \(-b\). </para>
    </problem>
    <solution>
      <para>Correct! \(-(-5)=5\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q2a-->
  <exercise data-content-id="713726b7-cb7a-440b-a5cc-d66fcd5df6d2" data-problem-comparator="integer" data-problem-type="input" data-solution="25">
    <problem>
      <para>\(b^2\)</para>
      <para>Enter the value of \(b^2\). </para>
    </problem>
    <solution>
      <para>Correct! \((-5)^2=25\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q3a-->
  <exercise data-content-id="3959ab64-2000-442d-9e18-4ab69756c335" data-problem-comparator="integer" data-problem-type="input" data-solution="97">
    <problem>
      <para>\(b^2−4ac\)</para>
      <para>Enter the value of \(b^2−4ac\). </para>
    </problem>
    <solution>
      <para>Correct! \((-5)^2−4(9)(-2)=25-(36)(-2)=25-(-72)=25+72=97\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
