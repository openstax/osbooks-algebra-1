  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>

<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="83888bd0-78f7-4f17-80e1-5061800d7eb2" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0"> ----------------------------------------

  <!--Q#-->
  <exercise data-content-id="7335966d-dc58-4542-a715-339e24f82cd1" data-problem-type="multiselect" data-solution="[&quot;2&quot;, &quot;8&quot;]" data-solution-options="[&quot;-14&quot;, &quot;8&quot;, &quot;2&quot;,&quot;4&quot;]">
    <problem>
      <para><emphasis>Select two</emphasis> answers for \(-b \pm \sqrt{a}\).</para>
      </problem>
    <solution>
      <para>Correct! \(-(-5)+\sqrt{9}=5+3=8\) and \(-(-5)-\sqrt{9}=5-3=2\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->

