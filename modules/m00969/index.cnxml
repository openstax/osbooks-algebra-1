<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.7.4: Writing Equations From Two Points</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00969</md:content-id>
    <md:title>4.7.4: Writing Equations From Two Points</md:title>
    <md:uuid>19fb09c3-f34b-4926-8f19-803ec6d704c3</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Cool Down Activity</title>
<para id="para-00001">With a partner, use what you have learned to write an equation in each form from two points.</para>

<!--Q#1-->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002">Find the slope of the line that goes through \((2,3)\) and \((6,-4)\).</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00003">Compare your answer: \(-\frac74\)</para>
    
    <para id="para-00004">\(m=\frac{y_2-y_1}{x_2-x_1}=\frac{-4-3}{6-2}=-\frac74\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Q#2-->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00005">Write the equation of the line in point-slope form that goes through \((2,3) \)and \((6,-4)\).</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00006">Compare your answer:</para>
    
    <para id="para-00007"><emphasis>Answer:</emphasis> \(y-3=-\frac{7}{4}(x-2)\) or \(y+4=-\frac{7}{4}(x-6)\)</para>
    
    <para id="para-00008">Using the point \((2,3)\):</para>
    
    <para id="para-00009">\(y-y_1=m(x-x_1)\)</para>
    
    <para id="para-00010">\(y-3=-\frac{7}{4}(x-2)\)</para>
    
    <para id="para-00011">Using the point \((6, -4)\):</para>
    
    <para id="para-00012">\(y-y_1=m(x-x_1)\)</para>
    
    <para id="para-00013">\(y-(-4)=-\frac{7}{4}(x-6)\)</para>
    
    <para id="para-00014">\(y+4=-\frac{7}{4}(x-6)\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Q#3-->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00015">Write the equation of the line in slope-intercept form that goes through \((2,3)\) and \((6,-4)\). (Hint: use the equation from number 2)</para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00016">Compare your answer:</para>
    
    <para id="para-00017"><emphasis>Answer:</emphasis> \(y=-\frac{7}{4}x+\frac{13}{2}\)</para>
    
    <para id="para-00018">\(y-3=-\frac{7}{4}(x-2)\)</para>
    
    <para id="para-00019">\(y-3=-\frac{7}{4}x+\frac{14}{4}\)</para>
    
    <para id="para-00020">\(y-3=-\frac{7}{4}x+\frac72\)</para>
    
    <para id="para-00021">\(y-3+3=-\frac{7}{4}x+\frac{7}{2}+3\)</para>
    
    <para id="para-00022">\(y=-\frac{7}{4}x+\frac{7}{2}+\frac{6}{2}\)</para>
    
    <para id="para-00023">\(y=-\frac{7}{4}x+\frac{13}{2}\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Q#4-->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00024">Write the equation of the line in standard form that goes through \((2,3)\) and \((6,-4)\).</para>
    <para id="para-00025">(Hint: use the equation from number 3.)</para>
  
  </problem><solution id="sol-00004">
    
    
  
  <para id="para-00026">Compare your answer:</para>
    
    <para id="para-00027"><emphasis>Answer:</emphasis> \(7x+4y=26\)</para>
    
    <para id="para-00028">\(4(y=-\frac{7}{4}x+\frac{13}{2})\)</para>
    
    <para id="para-00029">\(4y=-7x+26\)</para>
    
    <para id="para-00030">\(4y+7x=-7x+7x+26\)</para>
    
    <para id="para-00031">\(7x+4y=26\)</para>
  
  </solution></exercise>
<!--Interaction End -->
</section>
</content></document>