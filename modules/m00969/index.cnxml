<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.7.4: Writing Equations From Two Points</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00969</md:content-id>
    <md:title>4.7.4: Writing Equations From Two Points</md:title>
    <md:uuid>19fb09c3-f34b-4926-8f19-803ec6d704c3</md:uuid>
  </metadata>
  <content>
  <section><title>Cool Down Activity</title>
<para>With a partner, use what you have learned to write an equation in each form from two points.</para>

<!--Q#1-->
<exercise>
  <problem>
    <para>Find the slope of the line that goes through \((2,3)\) and \((6,-4)\).</para>
    </problem><solution>
    
    
  
  <para>Compare your answer: \(-\frac74\)</para>
    
    <para>\(m=\frac{y_2-y_1}{x_2-x_1}=\frac{-4-3}{6-2}=-\frac74\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Q#2-->
<exercise>
  <problem>
    <para>Write the equation of the line in point-slope form that goes through \((2,3) \)and \((6,-4)\).</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para><emphasis>Answer:</emphasis> \(y-3=-\frac{7}{4}(x-2)\) or \(y+4=-\frac{7}{4}(x-6)\)</para>
    
    <para>Using the point \((2,3)\):</para>
    
    <para>\(y-y_1=m(x-x_1)\)</para>
    
    <para>\(y-3=-\frac{7}{4}(x-2)\)</para>
    
    <para>Using the point \((6, -4)\):</para>
    
    <para>\(y-y_1=m(x-x_1)\)</para>
    
    <para>\(y-(-4)=-\frac{7}{4}(x-6)\)</para>
    
    <para>\(y+4=-\frac{7}{4}(x-6)\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Q#3-->
<exercise>
  <problem>
    <para>Write the equation of the line in slope-intercept form that goes through \((2,3)\) and \((6,-4)\). (Hint: use the equation from number 2)</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para><emphasis>Answer:</emphasis> \(y=-\frac{7}{4}x+\frac{13}{2}\)</para>
    
    <para>\(y-3=-\frac{7}{4}(x-2)\)</para>
    
    <para>\(y-3=-\frac{7}{4}x+\frac{14}{4}\)</para>
    
    <para>\(y-3=-\frac{7}{4}x+\frac72\)</para>
    
    <para>\(y-3+3=-\frac{7}{4}x+\frac{7}{2}+3\)</para>
    
    <para>\(y=-\frac{7}{4}x+\frac{7}{2}+\frac{6}{2}\)</para>
    
    <para>\(y=-\frac{7}{4}x+\frac{13}{2}\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Q#4-->
<exercise>
  <problem>
    <para>Write the equation of the line in standard form that goes through \((2,3)\) and \((6,-4)\).</para>
    <para>(Hint: use the equation from number 3.)</para>
  
  </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para><emphasis>Answer:</emphasis> \(7x+4y=26\)</para>
    
    <para>\(4(y=-\frac{7}{4}x+\frac{13}{2})\)</para>
    
    <para>\(4y=-7x+26\)</para>
    
    <para>\(4y+7x=-7x+7x+26\)</para>
    
    <para>\(7x+4y=26\)</para>
  
  </solution></exercise>
<!--Interaction End -->
</section>
