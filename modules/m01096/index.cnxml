<exercise data-wait-for-event="RFM1">
  <problem>
    <title>Extending Your Thinking</title>
    <para>In function \(H\), the input was time in seconds, and the output was height in feet.</para>
    <para>Think about some other quantities that could be inputs or outputs in this situation.</para>
    <para>Describe a function whose domain includes only integers. Be sure to specify the units.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>The maximum height, in feet, that the ball reaches after \(n\) bounces as a function of the number of bounces.</para>
  </solution></exercise>
<!--End interaction-->


<example><exercise data-wait-for-event="RFM1">
  <problem>
    
    <para>Sketch a graph of this function. Write down your answer then select the <emphasis>solution</emphasis> button to compare your answer.
        <para><figure><media alt="A blank graph. Origin O. "><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/ed432430b354cf4f05a5255e52c7f2a328aea6ed"/></media></figure></para>
      </para>
    <para>Select the <emphasis>solution</emphasis> button to compare your sketch and answer. </para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para><emphasis id="docs-internal-guid-663b6ac4-7fff-f1cb-6e91-14df360308a7"><figure><media alt=""><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/b6929b2cf7e7b7d1f80627718510365219ddeeb9"/></media></figure></emphasis></para>
</solution></exercise>
</example><!--End interaction-->


<exercise data-wait-for-event="RFM1">
  <problem>
    <para>Describe a function whose range includes only integers. Be sure to specify the units.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>The number of times the ball has hit the ground as a function of time, in seconds, since the ball was dropped.</para>
  </solution></exercise>
<!--End interaction-->


<example><exercise data-wait-for-event="RFM1">
  <problem>
    
    <para>Sketch a graph of this function. Write down your answer then select the <emphasis>solution</emphasis> button to compare your answer. 
        <figure><media alt="A blank graph. Origin O. "><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/ed432430b354cf4f05a5255e52c7f2a328aea6ed"/></media></figure></para>
    <para>Select the <emphasis>solution</emphasis> button to compare your sketch and answer. </para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para><figure><media alt="A blank graph. Origin O. "><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/91ee07c679b74c2278bca719a0d9bb853f0f0f77"/></media></figure></para>
