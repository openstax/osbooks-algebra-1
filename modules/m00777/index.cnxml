  <content>
  <section><para dir="ltr">Determine the correlation coefficient of the data in the table below to 3 decimal places  and interpret the value.</para>
<table class="os-raise-horizontaltable">
  <thead/>
  <tbody>
    <row>
      <entry scope="row" class="emphasis">\(x\)</entry>
      <entry>8</entry>
      <entry>15</entry>
      <entry>26</entry>
      <entry>31</entry>
      <entry>56</entry>
    </row>
    <row>
      <entry scope="row" class="emphasis">\(y\)</entry>
      <entry>23</entry>
      <entry>41</entry>
      <entry>53</entry>
      <entry>72</entry>
      <entry>103</entry>
    </row>
  </tbody>
</table></section>
</content>
</document>
