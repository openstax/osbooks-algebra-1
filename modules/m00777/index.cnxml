  <content>
  <note class="self-check" id="sect-00001"><para id="para-00001">Determine the correlation coefficient of the data in the table below to 3 decimal places  and interpret the value.</para>
<table class="os-raise-horizontaltable" id="table-00001">
  <tgroup cols="6"><tbody><row>
      <entry><emphasis>\(x\)</emphasis></entry><entry>8</entry>
      <entry>15</entry>
      <entry>26</entry>
      <entry>31</entry>
      <entry>56</entry>
    </row>
    <row>
      <entry><emphasis>\(y\)</emphasis></entry><entry>23</entry>
      <entry>41</entry>
      <entry>53</entry>
      <entry>72</entry>
      <entry>103</entry>
    </row>
  </tbody></tgroup></table></section>
</content>
</document>