</div>
</div>
<!--Q#6-->
<exercise>
  <problem>
    <para> What is the equation for this graph? </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(v = s(2)^{\frac{t}{4}}\)</para>
    <para>\(v =\) value of the stock after \(t\) years.</para>
    <para>\(s =\) initial price of the stock.</para>
    <para>\(t =\) time in years.</para>
    <para>\(\frac{t}{4} =\) the number of doubling event for every four years.</para>
  </solution></exercise>
<!--Interaction End -->
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="111bfa42-0413-4ba3-9702-d55ad0e1fff0" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0"> <!--Q#7-->
  <exercise data-content-id="9a2c8284-2058-460c-a669-4671a60164b7" data-problem-type="multiplechoice" data-solution="A laptop loses \(\frac25\) of its value every year after purchase." data-solution-options="[&quot;The value of a stock doubles approximately every 4 years.&quot;, &quot;A car loses \\(\\frac14\\) of its value every year after purchase.&quot;, &quot;The value of a stock triples roughly every 8 years.&quot;, &quot;A laptop loses \\(\\frac25\\) of its value every year after purchase.&quot;]">
    <problem>
      <para> Choose the description of exponential change shown in the graph. </para>
      <image alt="" class="img-fluid atto_image_button_text-bottom" height="283" role="presentation" src="https://k12.openstax.org/contents/raise/resources/259cfb15f61a19f0d0fbd8e2e2eab02033e07167" width="300"/></problem>
    <solution>
      <para>Correct! A laptop loses \(\frac25\) of its value every year after purchase.</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
