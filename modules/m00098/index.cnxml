  <content>
  <section><title>Cool Down Activity</title>
<para>Clare volunteers at a local library during the summer. Her work includes putting labels on 750 books.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="faa9a4a4-d5ea-4be4-ad16-7c8bc1bd8d4f" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1a-->
  <exercise data-content-id="d423a733-5c35-4496-b8ac-13fb08612146" data-problem-comparator="integer" data-problem-type="input" data-solution="75">
    <problem>
      <para>How many minutes will she need to finish labeling all books if she takes no breaks and labels <emphasis>10 books a minute?
          </emphasis></para>
      <para>Enter your answer here.</para>
    </problem>
    <solution>
      <para>Correct! 75</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1b-->
  <exercise data-content-id="f3720a12-3b19-4d81-8868-acba7b1560ea" data-problem-comparator="integer" data-problem-type="input" data-solution="50">
    <problem>
      <para>How many minutes will she need to finish labeling all books if she takes no breaks and labels <emphasis>15 books a minute?</emphasis> </para>
      <para>Enter your answer here.</para>
    </problem>
    <solution>
      <para>Correct! 50</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>

<!--Q2 -->
<exercise>
  <problem>
    <para>Suppose Clare labels the books at a constant speed of \(s\) books per minute. Write an equation that represents
        the relationship between her labeling speed and the number of minutes it would take her to finish labeling.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\( s * m=750 \) or \( m= \frac{750}{s} \), where \(m\) is the number of minutes and \(s\) is
      the speed in books per minute.</para>
  </solution></exercise>
<!--Interaction End --></section>
