<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.3.4: Writing an Equation to Represent a Relationship</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00098</md:content-id>
    <md:title>1.3.4: Writing an Equation to Represent a Relationship</md:title>
    <md:uuid>347a5d69-bb2f-48bf-9d0a-765ac1abab09</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001"><title>Cool Down Activity</title>
      <para id="para-00001">Clare volunteers at a local library during the summer. Her work includes putting labels on 750 books.</para>
      <exercise id="d423a733-5c35-4496-b8ac-13fb08612146" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00002">How many minutes will she need to finish labeling all books if she takes no breaks and labels <emphasis>10 books a minute?</emphasis>
         </para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Correct! 75</para>
          <para id="para-00004">The correct answer is 75.</para>
        </solution>
      </exercise>
      <!--Q2 -->
      <exercise id="f3720a12-3b19-4d81-8868-acba7b1560ea" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00005">How many minutes will she need to finish labeling all books if she takes no breaks and labels <emphasis>15 books a minute?</emphasis>
         </para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00006">Correct! 50</para>
          <para id="para-00007">Nice try! The correct answer is 50.</para>
        </solution>
      </exercise>
      <!--Q3 -->
      <exercise id="exer-00001">
        <problem id="prob-00003">
          <para id="para-00008">Suppose Clare labels the books at a constant speed of <m:math display="inline"><m:mrow><m:mi>s</m:mi></m:mrow></m:math> books per minute. Write an equation that represents the relationship between her labeling speed and the number of minutes it would take her to finish labeling.</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00009">Compare your answer: </para>
          <para id="para-00010"><m:math display="inline"><m:mrow><m:mi>s</m:mi><m:mo>*</m:mo><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>750</m:mn></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>750</m:mn></m:mrow><m:mrow><m:mi>s</m:mi></m:mrow></m:mfrac></m:mrow></m:math>, where <m:math display="inline"><m:mrow><m:mi>m</m:mi></m:mrow></m:math> is the number of minutes and <m:math display="inline"><m:mrow><m:mi>s</m:mi></m:mrow></m:math> is the speed in books per minute.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
    </section>
  </content>
</document>
