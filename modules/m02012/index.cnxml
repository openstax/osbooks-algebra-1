  <!--Q4-->
  <exercise data-content-id="888b0421-a3b8-4c69-954a-7b61207524da" data-problem-comparator="integer" data-problem-type="input" data-solution="4">
    <problem>
      <para>Without graphing, find the coordinates of the vertex of \(y=(x−4)^2+8\) and determine if it opens up or down.</para>
      <para> What is the \(x\)-coordinate of the vertex?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! The \(x\)-coordinate of the vertex of this equation is 4.</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Qb-->
  <exercise data-content-id="bbb6f97f-b144-4be0-89e9-52604b454621" data-problem-comparator="integer" data-problem-type="input" data-solution="8">
