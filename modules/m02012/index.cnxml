                        <m:mi>x</m:mi>
                        <m:mo>&#8722;</m:mo>
                        <m:mn>4</m:mn>
                        <m:msup>
                          <m:mo stretchy="false">)</m:mo>
                          <m:mn>2</m:mn>
                        </m:msup>
                        <m:mo>+</m:mo>
                        <m:mn>8</m:mn>
                      </m:mrow>
                    </m:math>
                  </entry>
                  <entry>
                    <m:math display="inline">
                      <m:mrow>
                        <m:mo stretchy="false">(</m:mo>
                        <m:mn>4</m:mn>
                        <m:mo>,</m:mo>
                        <m:mn>8</m:mn>
