                        <m:mo stretchy="false">(</m:mo>
                        <m:mi>x</m:mi>
                        <m:mo>+</m:mo>
                        <m:mn>10</m:mn>
                        <m:msup>
                          <m:mo stretchy="false">)</m:mo>
                          <m:mn>2</m:mn>
                        </m:msup>
                      </m:mrow>
                    </m:math>
                  </entry>
                  <entry>
                    <m:math display="inline">
                      <m:mrow>
                        <m:mo stretchy="false">(</m:mo>
                        <m:mo>&#8722;</m:mo>
                        <m:mn>10</m:mn>
                        <m:mo>,</m:mo>
                        <m:mn>0</m:mn>
