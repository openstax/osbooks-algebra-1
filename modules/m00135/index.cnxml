  <content>
  <section><title>Activity</title>

<div class="os-raise-familysupport">
  <para>Access the <link url="https://k12.openstax.org/contents/raise/resources/b62c9150250bf52d6cc37569213ab516e0090dca">Desmos guide PDF</link> for tips on solving problems with the Desmos graphing calculator.</para>
</div>

<para>Use the following scenario for questions 1 - 5:
  A student has a savings account with $475 in it. She deposits $125 of her paycheck into the account every week. Her
  goal is to save $7000 for college.
</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="81c33abc-0d93-4718-9a65-e8f3476c4188" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1-->
  <exercise data-content-id="ada32325-2724-477f-90a1-aa013e3a2f66" data-problem-comparator="integer" data-problem-type="input" data-solution="850">
    <problem>
      <para>How much will be in the account after 3 weeks?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! 850</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q2-->
  <exercise data-content-id="2497e810-58d6-409f-ad78-5207d7fd06e0" data-problem-comparator="integer" data-problem-type="input" data-solution="7">
    <problem>
      <para>How many weeks will it take until she has $1350?
        </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! 7</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>

<!--Q3-->
<exercise>
  <problem>
    <para>Write an equation that represents the relationship between the dollar amount in her account and the number of
        weeks of saving.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(a=475+125w\), where \(a\) is the dollar amount in the account and \(w\) is the number of
      weeks of savings.</para>
  </solution></exercise>
<!--Interaction End -->


<!--Q4-->
<div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>

<example><exercise>
  <problem>
    
    <para>Graph your equation using graphing technology. Mark the points on the graph that represent the amount after 3
        weeks and the week she has $1350. Write down the coordinates.
        Use the graphing tool or technology outside the course. Graph the equation that represents this scenario using
        the Desmos tool above.
      </para>
    <para>When you have finished graphing, select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your Answer:</para>
  <figure><media alt="Graph of a linear function. amount in account (dollars), number of weeks."><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/fb79cc0520f9d5754497ccaff23da6041fa25ab4"/></media></figure></solution></exercise>
</example><!--Interaction End -->

<!--Do not edit below line.-->
<solution>
  <!-- INSERT ANY VALID HTML HERE -->
</solution>
<!--Q#5-->
<exercise>
  <problem>
    <para>What is the \(x\)-intercept? </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>The correct answer is \((475, 0)\).</para>
  </solution></exercise>
<!--Interaction End -->


<!--Q6-->
<exercise>
  <problem>
    <para>What other information does the \(x\)-intercept identify in the function?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer: The \(x\)-intercept can identify the zero of the function since it represents where the function equals zero \((y = 0)\).</para>
  </solution></exercise>
<!--Interaction End -->


<!--Q#7-->
<exercise>
  <problem>
    <para>What is the the \(y\)-intercept?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>The correct answer is \((0, -3.8)\).</para>
  </solution></exercise>
<!--Interaction End -->


<!--Q#-->
<exercise>
  <problem>
    <para>What is the slope?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>The correct answer is \(-\frac{1}{125}\).</para>
  </solution></exercise>
<!--Interaction End -->


