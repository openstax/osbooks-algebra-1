<?xml version='1.0' encoding='UTF-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.6.2: Self Check</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02179</md:content-id>
    <md:title>8.6.2: Self Check</md:title>
    <md:uuid>28c54bd2-bcab-4eaa-af96-3931863da299</md:uuid>
  </metadata>
  <content>
  <section><para>An expression in standard form is shown. The diagram below is equivalent to which expression in factored form?</para>
<para>\(x^2−13x + 42\)</para>
<table class="os-raise-doubleheadertable">
  <tgroup cols="3"><tbody><row>
      <entry><emphasis/></entry><entry><emphasis>
        <para>\(x\)</para>
      
      </emphasis></entry><entry><emphasis>
        <para>-6</para>
      
      </emphasis></entry></row> 
    <row>
      <entry><emphasis>
        <para>\(x\)</para>
      
      </emphasis></entry><entry>
        <para>\(x^2\)</para>
      </entry>
      <entry>
        <para>\(-6x\)</para>
      </entry>
    </row>
    <row>
      <entry><emphasis>
        <para>-7</para>
      
      </emphasis></entry><entry>
        <para>\(-7x\)</para>
      </entry>
      <entry>
        <para>42</para>
      </entry>
    </row>
  </tbody></tgroup></table>
</section>
</content>
</document>