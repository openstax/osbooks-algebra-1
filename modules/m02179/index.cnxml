<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.6.2: Self Check</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02179</md:content-id>
    <md:title>8.6.2: Self Check</md:title>
    <md:uuid>2712f668-c344-41fa-bb4b-c8c4588a0a9d</md:uuid>
  </metadata>
  <content>
  <section><para>An expression in standard form is shown. The diagram below is equivalent to which expression in factored form?</para>
<para>\(x^2−13x + 42\)</para>
<table class="os-raise-doubleheadertable">
  <thead>
   
    <row>
      <entry><emphasis/></entry><entry><emphasis>
        <para>\(x\)</para>
      </emphasis></entry><entry><emphasis>
        <para>-6</para>
      </emphasis></entry></row> 
    </thead>
  <tbody>
    <row>
      <entry><emphasis>
        <para>\(x\)</para>
      </emphasis></entry><entry>
        <para>\(x^2\)</para>
      </entry>
      <entry>
        <para>\(-6x\)</para>
      </entry>
    </row>
    <row>
      <entry><emphasis>
        <para>-7</para>
      </emphasis></entry><entry>
        <para>\(-7x\)</para>
      </entry>
      <entry>
        <para>42</para>
      </entry>
    </row>
  </tbody>
</table>
</section>
</content>
</document>
