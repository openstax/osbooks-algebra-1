  <!--q3a-->
  <exercise data-content-id="6deb21ca-f0b2-4d89-b678-40f01361e93a" data-problem-comparator="float" data-problem-type="input" data-solution="1061.21">
    <problem>
      <para>A person owes $1,000 on a credit card that charges an interest rate of 2% per month.</para>
      <para>Complete this table showing the credit card balance each month if they do not make any payments. Enter each answer to the hundredths place.</para>
      <table class="os-raise-midsizetable">
        <thead>
          <row>
            <entry scope="col" class="emphasis">Month</entry>
            <entry scope="col" class="emphasis">Total Bill In Dollars</entry>
          </row>
        </thead>
        <tbody>
          <row>
            <entry>
              1
            </entry>
            <entry>
              1,000
            </entry>
          </row>
          <row>
            <entry>
              2
            </entry>
            <entry>
              1,020
            </entry>
          </row>
          <row>
            <entry>
              3
            </entry>
            <entry>
              1,040.40
            </entry>
          </row>
          <row>
            <entry>
              4
            </entry>
            <entry>a.
            </entry>
          </row>
          <row>
            <entry>
              5
            </entry>
            <entry>b.
            </entry>
          </row>
          <row>
            <entry>
              6
            </entry>
            <entry>c.
            </entry>
          </row>
          <row>
            <entry>
              7
            </entry>
            <entry>d.
            </entry>
          </row>
          <row>
            <entry>
              8
            </entry>
            <entry>e.
            </entry>
          </row>
        </tbody>
      </table>
      
      <para> Month 4
            (round to the hundredths place). <emphasis>Do Not Enter Commas.</emphasis></para>
        </problem>
    <solution>
      <para>Correct! 1061.21</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.15.3 – 4.15.4. </para>
    </div>
    </exercise>
