<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.1.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00853</md:content-id>
    <md:title>4.1.6: Practice</md:title>
    <md:uuid>2574d15f-1472-4020-aeaa-ca9f5e4d72ca</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <para id="para-00002">For questions 1 - 4, use the following scenario.
</para>
      <para id="para-00003">
        <quote id="quote-00001">The relationship between the amount of time a car is parked, in hours, and the cost of parking, in dollars, can be described with a function.</quote>
    </para>
      <section id="sect-00002">
        <exercise id="e3163c09-c634-4311-89e2-ed8c7dcc3542" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00004">Identify the independent variable in this function.</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00005">Correct! The independent variable is the amount of time the car is parked.</para>
            <para id="para-00006">Try again. Revisit activities 4.1.1 – 4.1.5.</para>
            <para id="para-00007">The correct answer is the independent variable is the amount of time the car is parked.</para>
          </solution>
        </exercise>
        <exercise id="be076c59-d230-4f6e-a5a8-03de829c3408" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00008">Identify the dependent variable in this function.</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00009">Correct! The dependent variable is the cost of parking.</para>
            <para id="para-00010">Try again. Revisit activities 4.1.1 – 4.1.5.</para>
            <para id="para-00011">The correct answer is the dependent variable is the amount of time the car is parked.</para>
          </solution>
        </exercise>
        <exercise id="bfc1ddc2-5d64-452b-8cdb-f5d438a665d5" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00012">Correctly describe the function with a sentence of the form “___ is a function of ___ .”
      </para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00013">Correct! The cost of parking is a function of the amount of time a car is parked.</para>
            <para id="para-00014">Try again. Revisit activities 4.1.1-4.1.5.</para>
            <para id="para-00015">The cost of parking is a function of the amount of time a car is parked.</para>
          </solution>
        </exercise>
 
      <!-- New pset with 3 attemps -->

        <exercise id="_90dae51d-bab9-48b6-8f3f-2591b15904e4" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00016">Suppose it costs $3 per hour to park, with a maximum cost of $12. Here is a graph of the situation.</para>
                  <media alt="">
                <image mime-type="image/jpeg" src="../../media/Algebra-1_04_04_13_01.jpg"/>
              </media>
            
            <para id="para-00017">What does the point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> mean in this situation?</para>
            <para id="para-00018">Multiple Choice:</para>
            <para id="para-00019">2 hours of parking costs $6 per hour</para>
            <para id="para-00020">6 hours of parking costs $2 per hour</para>
            <para id="para-00021">2 hours of parking costs a total of $6</para>
            <para id="para-00022">6 hours of parking costs a total of $2</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00023">Correct! 2 hours of parking costs a total of $6.</para>
            <para id="para-00024">Try again. Revisit activities 4.1.1 – 4.1.5.</para>
            <para id="para-00025">The correct answer is 2 hours of parking costs a total of $6.</para>
          </solution>
        </exercise>
        <exercise id="ac4763ea-4ee2-457d-9d97-810c889f21cf" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00026">The distance a person walks, <m:math display="inline"><m:mrow><m:mi>d</m:mi></m:mrow></m:math>, in kilometers, is a function of time, <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math>, in minutes, since the walk began.
          Select the <emphasis>two statements</emphasis> about the input variable of this function that are true.
      </para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00027">Correct! Time since the person started walking is the input; <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> represents the input.</para>
            <para id="para-00028">Try again. Revisit activities 4.1.3 – 4.1.4.</para>
            <para id="para-00029">The correct answers are: Time since the person started walking is the input; <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> represents the input.</para>
          </solution>
        </exercise>
        <exercise id="a9b84d60-438d-4247-acdd-690abbfaa3a6" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00030">Determine if the following relation is a function.
          
          {<m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>27</m:mn><m:mo>,</m:mo><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mo>,</m:mo><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>27</m:mn><m:mo>,</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>}
      </para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00031">Correct! No, For the following reasons:</para>
            <para id="para-00032">Try again. Revisit activity 4.1.3.</para>
            <para id="para-00033">The correct answer is: No. Since the input value 1 goes to both –1 and 1, this relation is not a function.</para>
          </solution>
        </exercise>
        <exercise id="_57e4d49e-9060-4dfc-a5b8-34c9a88877ab" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00034">Is the following relation a function? Explain your answer.
          (<media alt="This figure shows two table that each have one column. The table on the left has the header “Name” and lists the names “Neal”, “Krystal”, “Kelvin”, “George”, “Christa”, and “Mike”. The table on the right has the header “Phone number” and lists the numbers “123-567-4389 work”, “231-378-5941 cell”, “753-469-9731 cell”, “567-534-2970 work”, “684-369-7231 cell”, “798-367-8541 cell”, and “639-847-6971 cell”. There are arrows that start at a name and points toward a number in the phone number table. The first arrow goes from Neal to 753-469-9731 cell. The second arrow goes from Krystal to a 684-369-7231 cell. The third arrow goes from Kelvin to 231-378-5941 cell. The fourth arrow goes from George to 123-567-4389 work. The fifth arrow goes from George to 639-847-6971 cell. The sixth arrow goes from Christa to 567-534-2970 work. The seventh arrow goes from Mike to 567-534-2970 work. The eighth arrow goes from Mike to 798-367-8541 cell."><image mime-type="image/jpeg" src="../../media/Algebra-1_04_04_13_02.jpg"/></media>)</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00035">Correct! No, this relation is not a function. Since both George and Mike are mapped to two different phone numbers, every input does not have exactly one output value.</para>
            <para id="para-00036">Try again. Revisit activities 4.1.3.</para>
            <para id="para-00037">The correct answer is: No, this relation is not a function. Since both George and Mike are mapped to two different phone numbers, every input does not have exactly one output value.</para>
          </solution>
        </exercise>
        <exercise id="_76cceca0-7dcb-4087-9dd4-4feff6f13cb3" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00038">Determine if the following relation is a function.
          
          {<m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo>,</m:mo><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>5</m:mn><m:mo>,</m:mo><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>}
      </para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00039">Correct! This relation is a function. Every input has exactly one output value</para>
            <para id="para-00040">Try again. Revisit activity 4.1.3.</para>
            <para id="para-00041">The correct answer is: This relation is a function. Every input has exactly one output value.</para>
          </solution>
        </exercise>
 
    </section>
  </content></document>
