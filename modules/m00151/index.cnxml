<exercise data-wait-for-event="RFM1">
  <problem>
    <title>Extending Your Thinking</title>
    <para>Here is a puzzle:</para>
    <para>\(m+m=N \)</para>
      <para>\(N+N=p \)</para>
      <para>\(m+p=Q\)</para>
      <para>\(p+Q=? \)</para>
    <para>Write two expressions that are equivalent to \(p + Q\).</para>
  </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer: Your answer may vary, but here is a sample.</para>
    <list>
      <item>\(2p+m \)</item>
      <item>\(9m \)</item>
    </list>
  </solution></exercise>
