    <section id="sect-00005">
      <title>Additional Resources</title>

      <section id="sect-00006">
        <title>Finding Equivalent Equations</title>
        <para id="para-00028">Equivalent equations are equations that have the same solutions. They are often found by using inverse operations or by multiplying each term in the equation by the same value.</para>
        
        <section id="sect-00007">
          <title>Example</title>
        <para id="para-00029">Write three equivalent equations to <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math> using one of three strategies.</para>
        <list id="list-00008">
          <item>
            Using an inverse operation
         </item>
          <item>
            Using division
         </item>
          <item>
            Using multiplication
         </item>
        </list>
        <para id="para-00030"><emphasis>Using an inverse operation:</emphasis><newline/>
          An equivalent equation can be determined by adding 2 to both sides.</para>
        <para id="para-00031"><m:math><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math><newline/>
          <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>8</m:mn><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math><newline/>
          <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math><newline/>
          <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> are equivalent.</para>
        
          <para id="para-00032"><emphasis>Using division:</emphasis><newline/>
          An equivalent equation can be determined by dividing by 2 (or multiplying by <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math>).</para>
        <para id="para-00033"><m:math><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math><newline/>
          <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math><newline/>
          <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
        <para id="para-00034"><m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> are equivalent.</para>
        <para id="para-00035"><emphasis>Using multiplication:</emphasis><newline/>
          An equivalent equation can be determined by multiplying the same number to both sides.</para>
        
        <!--Q#-->
        <exercise id="exer-00006">
          <problem id="prob-00007">
            <para id="para-00036">What is the equivalent equation if you multiply each term in the equation <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math> by 3?</para>
            
          </problem><solution id="sol-00007">        
          <para id="para-00037">Compare your answer: <m:math display="inline"><m:mrow><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>24</m:mn></m:mrow></m:math>, because:</para>
            
            <para id="para-00038"><m:math><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math><newline/>
              <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math><newline/>
              <m:math display="inline"><m:mrow><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>24</m:mn></m:mrow></m:math></para>
          
          </solution>
        </exercise>
        <!--Interaction End -->
    </section>
     
    <note class="try" id="note-00002">
        <title>Try It: Finding Equivalent Equations</title>
        <!--Q1-->
        <exercise id="exer-00007">
          <problem id="prob-00008">
            <para id="para-00039">
                Determine the equivalent equation if you subtract 5 from each side of the equation, <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo>=</m:mo><m:mn>15</m:mn></m:mrow></m:math>. 
            </para>
                            
            </problem>
            <solution id="sol-00008">
          <para id="para-00040">Compare your answer:</para>
            
            <para id="para-00004"><m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math></para></solution></exercise>
        <!--Interaction End -->
        
        <!--Q2-->
        <exercise id="exer-00008">
          <problem id="prob-00009">
            <para id="para-00042">
                Explain how <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> is related to <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">)</m:mo></m:mrow></m:math>. 
            </para>
              
            </problem>
            <solution id="sol-00009">
       <para id="para-00043">Compare your answer:</para>
            
            <para id="para-00044">Divide both sides by 3.
              <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac></m:mrow></m:math> so <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
          
          </solution></exercise>
        <!--Interaction End -->
        
        <!--Q3-->
        <exercise id="exer-00009">
          <problem id="prob-00010">
            <para id="para-00045">
                Multiply every term by the same number to determine an equivalent equation to <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo>=</m:mo><m:mn>15</m:mn></m:mrow></m:math>. (Answers vary response.)
            </para>
                            
            </problem>
            <solution id="sol-00010">
          <para id="para-00046">Compare your answer:</para>
            
            <para id="para-00047">Your answer may vary, but here are some samples.</para>
            
            <list id="list-00009">
              <item><m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo>=</m:mo><m:mn>15</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> becomes <m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn><m:mo>=</m:mo><m:mn>30</m:mn></m:mrow></m:math>
             </item>
              <item>
                <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo>=</m:mo><m:mn>15</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> becomes <m:math display="inline"><m:mrow><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>20</m:mn><m:mo>−</m:mo><m:mn>60</m:mn></m:mrow></m:math>
             </item>
              <item>
                <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo>=</m:mo><m:mn>15</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> becomes <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>10</m:mn><m:mo>=</m:mo><m:mn>30</m:mn></m:mrow></m:math>
             </item>
            </list>
          
          </solution>
        </exercise>
        <!--Interaction End -->
        
        <exercise id="_3c4649a8-001a-4e79-b906-9a87215d328a" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00048">
                  Is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo>=</m:mo><m:mn>15</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> equivalent to <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>15</m:mn><m:mo>=</m:mo><m:mn>60</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>? 
              </para>
              </problem>
              <solution id="sol-00011"><para id="para-00049">Correct! No.</para><para id="para-00050">Nice try! The correct answer is No.</para>
              </solution>
            </exercise><!--Q5-->
        
            <exercise id="exer-00010">
          <problem id="prob-00012">
            <para id="para-00051">
                Explain your reasoning for your answer to number 4 and whether the equations <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo>=</m:mo><m:mn>15</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>15</m:mn><m:mo>=</m:mo><m:mn>60</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> are equivalent.
            </para>
                            
            </problem><solution id="sol-00012">
          <para id="para-00052">Compare your answer: Your answer may vary, but here is a sample:</para>
            
            <para id="para-00053">No. Each term in the first equation was multiplied by a different number to get equation two.</para>
          
          </solution></exercise>
        </note>
        <!--Interaction End --></section>
    </section>

  </content>
