<exercise class="RFM1" id="exer-00007">
  <problem id="prob-00007">
    <title>Extending Your Thinking</title>
    
    <para id="para-00023">Here is a puzzle:</para>
    
    <para id="para-00024">\(m+m=N \)</para>
      <para id="para-00025">\(N+N=p \)</para>
      <para id="para-00026">\(m+p=Q\)</para>
      <para id="para-00027">\(p+Q=? \)</para>
    <para id="para-00028">Write two expressions that are equivalent to \(p + Q\).</para>
  
  </problem><solution id="sol-00006">
    
    <para id="para-00029">Enter your answer here:</para>
  
  <para id="para-00030">Compare your answer: Your answer may vary, but here is a sample.</para>
    
    <list id="list-00006">
      <item>\(2p+m \)</item>
      <item>\(9m \)</item>
    </list>
  
  </solution></exercise>
<!--End interaction-->
</section>
