<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
      <title>2.8.5: Practice</title>
      <metadata xmlns:md="http://cnx.rice.edu/mdml">
            <md:content-id>m00504</md:content-id>
            <md:title>2.8.5: Practice</md:title>
            <md:uuid>81a9049e-b9de-4580-8dee-4d5fcb2f087c</md:uuid>
      </metadata>
      <content>
            <section class="practice" id="sect-00001">
                  <para id="para-00001">Complete the following questions to practice the skills you have learned in
                        this lesson.</para>
                  <para id="para-00002">For questions 1 – 2, use the following passage:</para>
                  <para id="para-00003"><quote id="quote-00001">A runner is training for a marathon. She runs more than 4 days each
                        week. Each day, she runs between 12 and 15 miles. The marathon is 3 months
                        away at the most.</quote></para>

                        <exercise id="_0ca15f01-7b3c-49e2-a528-491f804852e2" class="multiple-choice">
                              <problem id="prob-00001">
                                    <para id="para-00004">What does the inequality <m:math display="inline"><m:mrow><m:mi>d</m:mi><m:mo>&gt;</m:mo><m:mn>4</m:mn></m:mrow></m:math> represent?</para>
                                    <para id="para-00005">Multiple Choice:</para>
                                    <para id="para-00006">the number of miles in a marathon</para>
                                    <para id="para-00007">the number of miles the runner runs each day</para>
                                    <para id="para-00008">the number of months away the marathon is</para>
                                    <para id="para-00009">the number of days the runner runs each week</para>
                              </problem>
                              <solution id="sol-00001">
                                    <para id="para-00010">Correct! the number of days the runner runs each week</para>
                                    <para id="para-00011">Try again. Revisit activity 2.8.3.</para>
                                    <para id="para-00012">The correct answer is the number of days the runner runs
                                          each week.</para>
                              </solution>
                        </exercise>
                        <exercise id="_5de3c9b4-ffc9-49f9-86b6-f512ceaeb3bb" class="multiple-choice">
                              <problem id="prob-00002">
                                    <para id="para-00013">What does the inequality <m:math display="inline"><m:mrow><m:mn>12</m:mn><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mi>m</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>15</m:mn></m:mrow></m:math>
                                          represent?</para>
                                    <para id="para-00014">Multiple Choice:</para>
                                    <para id="para-00015">the number of miles in a marathon</para>
                                    <para id="para-00016">the number of miles the runner runs each day</para>
                                    <para id="para-00017">the number of months away the marathon is</para>
                                    <para id="para-00018">the number of days the runner runs each week</para>
                              </problem>
                              <solution id="sol-00002">
                                    <para id="para-00019">Correct! the number of miles the runner runs each day</para>
                                    <para id="para-00020">Try again. Revisit activity 2.8.3.</para>
                                    <para id="para-00021">The correct answer is the number of miles the runner runs
                                          each day.</para>
                              </solution>
                        </exercise>

                  <para id="para-00022">For 3 - 8, write an inequality to represent the constraint given.</para>


                        <exercise id="_04452122-a496-4774-88f1-f37f209b48b8" class="multiple-choice">
                              <problem id="prob-00003">
                                    <para id="para-00023">There are less than 4 patients, <m:math display="inline"><m:mrow><m:mi>p</m:mi></m:mrow></m:math>, in the waiting
                                          room.</para>
                                    <para id="para-00024">Multiple Choice:</para>
                                    <para id="para-00025"><m:math><m:mrow><m:mi>p</m:mi><m:mo>&lt;</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
                                    <para id="para-00026"><m:math><m:mrow><m:mi>p</m:mi><m:mo>&gt;</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
                                    <para id="para-00027"><m:math><m:mrow><m:mi>p</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mspace width="0.278em"/></m:mrow></m:math></para>
                                    <para id="para-00028"><m:math><m:mrow><m:mi>p</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mspace width="0.278em"/></m:mrow></m:math></para>
                              </problem>
                              <solution id="sol-00003">
                                    <para id="para-00029">Correct! <m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mspace width="0.278em"/><m:mo>&lt;</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mspace width="0.278em"/></m:mrow></m:math></para>
                                    <para id="para-00030">Try again. Revisit activity 2.8.3.</para>
                                    <para id="para-00031">The correct answer is <m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mspace width="0.278em"/><m:mo>&lt;</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mspace width="0.278em"/></m:mrow></m:math>.</para>
                              </solution>
                        </exercise>
                        <exercise id="a25872c8-fc00-4da6-af27-9ea7337fd151" class="multiple-choice">
                              <problem id="prob-00004">
                                    <para id="para-00032">There are no more than 6 cats, <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math>, in the yard.</para>
                                    <para id="para-00033">Multiple Choice:</para>
                                    <para id="para-00034"><m:math><m:mrow><m:mi>c</m:mi><m:mo>&gt;</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
                                    <para id="para-00035"><m:math><m:mrow><m:mi>c</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>6</m:mn></m:mrow></m:math></para>
                                    <para id="para-00036"><m:math><m:mrow><m:mi>c</m:mi><m:mo>&lt;</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
                                    <para id="para-00037"><m:math><m:mrow><m:mi>c</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>6</m:mn><m:mspace width="0.278em"/></m:mrow></m:math></para>
                              </problem>
                              <solution id="sol-00004">
                                    <para id="para-00038">Correct! <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mi>≤</m:mi><m:mn>6</m:mn></m:mrow></m:math></para>
                                    <para id="para-00039">Try again. Revisit activity 2.8.3.</para>
                                    <para id="para-00040">The correct answer is <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mi>≤</m:mi><m:mn>6</m:mn></m:mrow></m:math>.</para>
                              </solution>
                        </exercise>

                        <!-- Q#5 -->
                        <exercise id="_3f993c8d-6884-4bbb-8604-aa21aba0598c" class="multiple-choice">
                              <problem id="prob-00005">
                                    <para id="para-00041">There are no less than 7 markers, <m:math display="inline"><m:mrow><m:mi>m</m:mi></m:mrow></m:math>, in the drawer.</para>
                                    <para id="para-00042">Multiple Choice:</para>
                                    <para id="para-00043"><m:math><m:mrow><m:mi>m</m:mi><m:mo>&gt;</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
                                    <para id="para-00044"><m:math><m:mrow><m:mi>m</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>7</m:mn></m:mrow></m:math></para>
                                    <para id="para-00045"><m:math><m:mrow><m:mi>m</m:mi><m:mo>&lt;</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
                                    <para id="para-00046"><m:math><m:mrow><m:mi>m</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>7</m:mn><m:mspace width="0.278em"/></m:mrow></m:math></para>
                              </problem>
                              <solution id="sol-00005">
                                    <para id="para-00047">Correct! <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>7</m:mn><m:mspace width="0.278em"/></m:mrow></m:math></para>
                                    <para id="para-00048">Try again. Revisit activity 2.8.3.</para>
                                    <para id="para-00049">The correct answer is <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>7</m:mn><m:mspace width="0.278em"/></m:mrow></m:math>.</para>
                              </solution>
                        </exercise>

                        <exercise id="_21948567-9795-45ab-ba5c-d269cd4e7474" class="multiple-choice">
                              <problem id="prob-00006">
                                    <para id="para-00050">The basket has between 12 and 19 eggs, <m:math display="inline"><m:mrow><m:mi>e</m:mi></m:mrow></m:math>.</para>
                                    <para id="para-00051">Multiple Choice:</para>
                                    <para id="para-00052"><m:math display="inline"><m:mrow><m:mn>12</m:mn><m:mo>&gt;</m:mo><m:mi>e</m:mi></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mspace width="0.278em"/><m:mi>e</m:mi><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mo>&gt;</m:mo><m:mspace width="0.278em"/><m:mn>19</m:mn><m:mspace width="0.278em"/></m:mrow></m:math></para>
                                    <para id="para-00053"><m:math display="inline"><m:mrow><m:mn>12</m:mn><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mi>e</m:mi><m:mspace width="0.278em"/></m:mrow></m:math>and<m:math display="inline"><m:mrow><m:mspace width="0.278em"/><m:mi>e</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>19</m:mn><m:mspace width="0.278em"/></m:mrow></m:math></para>
                                    <para id="para-00054"><m:math><m:mrow><m:mi>e</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>19</m:mn><m:mspace width="0.278em"/></m:mrow></m:math></para>
                                    <para id="para-00055"><m:math><m:mrow><m:mn>12</m:mn><m:mspace width="0.278em"/><m:mi>≤</m:mi><m:mspace width="0.278em"/><m:mi>e</m:mi><m:mspace width="0.278em"/><m:mi>≤</m:mi><m:mspace width="0.278em"/><m:mn>19</m:mn><m:mspace width="0.278em"/></m:mrow></m:math></para>
                              </problem>
                              <solution id="sol-00006">
                                    <para id="para-00056">Correct! <m:math display="inline"><m:mrow><m:mn>12</m:mn><m:mi>≤</m:mi><m:mi>e</m:mi><m:mi>≤</m:mi><m:mn>19</m:mn></m:mrow></m:math></para>
                                    <para id="para-00057">Try again. Revisit activity 2.8.3.</para>
                                    <para id="para-00058">The correct answer is <m:math display="inline"><m:mrow><m:mn>12</m:mn><m:mi>≤</m:mi><m:mi>e</m:mi><m:mi>≤</m:mi><m:mn>19</m:mn></m:mrow></m:math>.</para>
                              </solution>
                        </exercise>

                        <exercise id="_57a2b48e-e646-40cd-a130-2bda02cb8b94" class="multiple-choice">
                              <problem id="prob-00007">
                                    <para id="para-00059">The total sales of tickets to a show is more than $68. An
                                          adult ticket, <emphasis effect="italics">a</emphasis>,
                                          costs $8 and a children’s ticket, <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math>, is $3.</para>
                                    <para id="para-00060">Multiple Choice:</para>
                                    <para id="para-00061"><m:math><m:mrow><m:mn>8</m:mn><m:mi>a</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>3</m:mn><m:mi>c</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>68</m:mn><m:mspace width="0.278em"/></m:mrow></m:math></para>
                                    <para id="para-00062"><m:math><m:mrow><m:mn>8</m:mn><m:mi>a</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>3</m:mn><m:mi>c</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>68</m:mn><m:mspace width="0.278em"/></m:mrow></m:math></para>
                                    <para id="para-00063"><m:math><m:mrow><m:mn>8</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>c</m:mi><m:mo>&lt;</m:mo><m:mn>68</m:mn></m:mrow></m:math></para>
                                    <para id="para-00064"><m:math><m:mrow><m:mn>8</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>c</m:mi><m:mo>&gt;</m:mo><m:mn>68</m:mn></m:mrow></m:math></para>
                              </problem>
                              <solution id="sol-00007">
                                    <para id="para-00065">Correct! <m:math display="inline"><m:mrow><m:mn>8</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>c</m:mi><m:mo>&gt;</m:mo><m:mn>68</m:mn></m:mrow></m:math></para>
                                    <para id="para-00066">Try again. Revisit activity 2.8.3.</para>
                                    <para id="para-00067">The correct answer is <m:math display="inline"><m:mrow><m:mn>8</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>c</m:mi><m:mo>&gt;</m:mo><m:mn>68</m:mn></m:mrow></m:math>.</para>
                              </solution>
                        </exercise>
                          
                        <!-- Q#8 -->
                        <exercise id="_40ce7a53-87d6-4d8c-9da5-f411619fb487" class="multiple-choice">
                              <problem id="prob-00008">
                                    <para id="para-00068">There needs to be at least 1 pound of clay, <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math>, for
                                          every 4 students, <m:math display="inline"><m:mrow><m:mi>s</m:mi></m:mrow></m:math>.</para>
                                    <para id="para-00069">Multiple Choice:</para>
                                    <para id="para-00070"><m:math><m:mrow><m:mi>c</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mfrac><m:mi>s</m:mi><m:mn>4</m:mn></m:mfrac><m:mspace width="0.278em"/></m:mrow></m:math></para>
                                    <para id="para-00071"><m:math><m:mrow><m:mi>c</m:mi><m:mspace width="0.278em"/><m:mo>&gt;</m:mo><m:mspace width="0.278em"/><m:mfrac><m:mi>s</m:mi><m:mn>4</m:mn></m:mfrac><m:mspace width="0.278em"/></m:mrow></m:math></para>
                                    <para id="para-00072"><m:math><m:mrow><m:mi>c</m:mi><m:mspace width="0.278em"/><m:mo>&lt;</m:mo><m:mspace width="0.278em"/><m:mfrac><m:mi>s</m:mi><m:mn>4</m:mn></m:mfrac><m:mspace width="0.278em"/></m:mrow></m:math></para>
                                    <para id="para-00073"><m:math><m:mrow><m:mi>c</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mfrac><m:mi>s</m:mi><m:mn>4</m:mn></m:mfrac><m:mspace width="0.278em"/></m:mrow></m:math></para>
                              </problem>
                              <solution id="sol-00008">
                                    <para id="para-00074">Correct! <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mfrac><m:mi>s</m:mi><m:mn>4</m:mn></m:mfrac><m:mspace width="0.278em"/></m:mrow></m:math></para>
                                    <para id="para-00075">Try again. Revisit activity 2.8.3.</para>
                                    <para id="para-00076">The correct answer is <m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mfrac><m:mi>s</m:mi><m:mn>4</m:mn></m:mfrac><m:mspace width="0.278em"/></m:mrow></m:math>.</para>
                              </solution>
                        </exercise>

                  <para id="para-00077">For 9 - 11, use the following passage:</para>
                  <para id="para-00078"><quote id="quote-00002">A doctor sees between 7 and 12 patients each day. On Mondays and
                        Tuesdays, the appointment times are 15 minutes. On Wednesdays and Thursdays,
                        they are 30 minutes long. On Fridays, they are one hour long. The doctor
                        works for no more than 8 hours a day. Here are some inequalities that
                        represent this situation. </quote></para>
                  <para id="para-00079"><m:math display="inline"><m:mrow><m:mn>0.25</m:mn><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>1</m:mn></m:mrow></m:math>            <m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>12</m:mn></m:mrow></m:math>         
                         <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>8</m:mn></m:mrow></m:math></para>

                        <exercise id="_80586fbc-b2d8-421d-acc7-0fadf313b894" class="multiple-choice">
                              <problem id="prob-00009">
                                    <para id="para-00080">What does the variable <emphasis effect="italics">x</emphasis>
                                          represent?</para>
                                    <para id="para-00081">Multiple Choice:</para>
                                    <para id="para-00082">the number of patients the doctor sees each day.</para>
                                    <para id="para-00083">the part of an hour that each appointment lasts.</para>
                                    <para id="para-00084">the total time the doctor spends working with patients
                                          each day.</para>
                                    <para id="para-00085">the number of patients the doctor sees in a week.</para>
                              </problem>
                              <solution id="sol-00009">
                                    <para id="para-00086">Correct! the number of patients the doctor sees each day</para>
                                    <para id="para-00087">Try again. Revisit activity 2.8.2.</para>
                                    <para id="para-00088">The correct answer is the number of patients the doctor
                                          sees each day.</para>
                              </solution>
                        </exercise>
                        <exercise id="c8c68be2-5987-4311-bc26-ec6a58774d65" class="multiple-choice">
                              <problem id="prob-00010">
                                    <para id="para-00089">What does the variable <emphasis effect="italics">y</emphasis>
                                          represent?</para>
                                    <para id="para-00090">Multiple Choice:</para>
                                    <para id="para-00091">the number of patients the doctor sees each day.</para>
                                    <para id="para-00092">the part of an hour that each appointment lasts.</para>
                                    <para id="para-00093">the total time the doctor spends working with patients
                                          each day.</para>
                                    <para id="para-00094">the number of patients the doctor sees in a week.</para>
                              </problem>
                              <solution id="sol-00010">
                                    <para id="para-00095">Correct! the part of an hour that each appointment lasts</para>
                                    <para id="para-00096">Try again. Revisit activity 2.8.2.</para>
                                    <para id="para-00097">The correct answer is the part of an hour that each
                                          appointment lasts.</para>
                              </solution>
                        </exercise>

                          <!-- Q#11 -->
                        <exercise id="_52e5dd2c-2137-4963-ad5b-91a7f20a4320" class="multiple-choice">
                              <problem id="prob-00011">
                                    <para id="para-00098">What does the expression <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mi>y</m:mi></m:mrow></m:math> in the last inequality
                                          mean in this situation?</para>
                                    <para id="para-00099">Multiple Choice:</para>
                                    <para id="para-00100">the number of patients the doctor sees each day.</para>
                                    <para id="para-00101">the part of an hour that each appointment lasts.</para>
                                    <para id="para-00102">the total time the doctor spends working with patients
                                          each day.</para>
                                    <para id="para-00103">the number of patients the doctor sees in a week.</para>
                              </problem>
                              <solution id="sol-00011">
                                    <para id="para-00104">Correct! the total time the doctor spends working with
                                          patients each day</para>
                                    <para id="para-00105">Try again. Revisit activity 2.8.2.</para>
                                    <para id="para-00106">The correct answer is the total time the doctor spends
                                          working with patients each day.</para>
                              </solution>
                        </exercise>

                  <para id="para-00107">For 12 - 14, use the following passage:</para>
                  <para id="para-00108"><quote id="quote-00003">Arnav wants to build a dog house. He makes a list of the materials
                        needed:</quote>
                        <list id="list-00001">
                              <item>At least 60 square feet of plywood for the surfaces</item>
                              <item>At least 36 feet of wood planks for the frame of the dog house</item>
                              <item>Between 1 and 2 quarts of paint</item>
                        </list>
                        <quote id="quote-00004">Arnav's budget is $65. Plywood costs $0.70 per square
                        foot, planks of wood cost $0.10 per foot, and paint costs $8 per quart.</quote>
                 </para>

                        <exercise id="bc2297ed-28d8-428f-b938-3a65cf880bf6" class="multiple-choice">
                              <problem id="prob-00012">
                                    <para id="para-00109">Which inequality represents the square feet of plywood
                                          needed?</para>
                                    <para id="para-00110">Multiple Choice:</para>
                                    <para id="para-00111"><m:math><m:mrow><m:mi>p</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>60</m:mn></m:mrow></m:math></para>
                                    <para id="para-00112"><m:math><m:mrow><m:mi>p</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>36</m:mn></m:mrow></m:math></para>
                                    <para id="para-00113"><m:math><m:mrow><m:mn>1</m:mn><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mi>p</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>2</m:mn></m:mrow></m:math></para>
                              </problem>
                              <solution id="sol-00012">
                                    <para id="para-00114">Correct! <m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>60</m:mn></m:mrow></m:math></para>
                                    <para id="para-00115">Try again. Revisit activity 2.8.3.</para>
                                    <para id="para-00116">The correct answer is <m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>60</m:mn></m:mrow></m:math>.</para>
                              </solution>
                        </exercise>
                        <exercise id="ab779033-04ec-4745-95d6-404d192cfdf3" class="multiple-choice">
                              <problem id="prob-00013">
                                    <para id="para-00117">Which inequality represents the number of wood planks
                                          needed?</para>
                                    <para id="para-00118">Multiple Choice:</para>
                                    <para id="para-00119"><m:math><m:mrow><m:mi>w</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>60</m:mn></m:mrow></m:math></para>
                                    <para id="para-00120"><m:math><m:mrow><m:mn>1</m:mn><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mi>w</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>2</m:mn></m:mrow></m:math></para>
                                    <para id="para-00121"><m:math><m:mrow><m:mi>w</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>36</m:mn></m:mrow></m:math></para>
                              </problem>
                              <solution id="sol-00013">
                                    <para id="para-00122">Correct! <m:math display="inline"><m:mrow><m:mi>w</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>36</m:mn></m:mrow></m:math></para>
                                    <para id="para-00123">Try again. Revisit activity 2.8.3.</para>
                                    <para id="para-00124">The correct answer is <m:math display="inline"><m:mrow><m:mi>w</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>36</m:mn></m:mrow></m:math>.</para>
                              </solution>
                        </exercise>
                        <exercise id="b2f185f1-5900-4c03-b982-b2d373c39ad9" class="multiple-choice">
                              <problem id="prob-00014">
                                    <para id="para-00125">Which inequality represents the number of quarts of paint
                                          needed?</para>
                                    <para id="para-00126">Multiple Choice:</para>
                                    <para id="para-00127"><m:math><m:mrow><m:mi>q</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>60</m:mn></m:mrow></m:math></para>
                                    <para id="para-00128"><m:math><m:mrow><m:mn>1</m:mn><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mi>q</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>2</m:mn></m:mrow></m:math></para>
                                    <para id="para-00129"><m:math><m:mrow><m:mi>q</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>36</m:mn></m:mrow></m:math></para>
                              </problem>
                              <solution id="sol-00014">
                                    <para id="para-00130">Correct! <m:math display="inline"><m:mrow><m:mn>1</m:mn><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mi>q</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>2</m:mn></m:mrow></m:math></para>
                                    <para id="para-00131">Try again. Revisit activity 2.8.3.</para>
                                    <para id="para-00132">The correct answer is <m:math display="inline"><m:mrow><m:mn>1</m:mn><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mi>q</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>2</m:mn></m:mrow></m:math>.</para>
                              </solution>
                        </exercise>

