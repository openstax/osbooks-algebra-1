</div>

<para>For questions 5 – 10, solve each system of equations.</para>

<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="23dac245-a5f8-49dc-8ff7-4a31fdb67182" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--Q5-->
  <exercise data-content-id="1cc9948d-650a-4ef9-b839-056b65aa9185" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((–11,2)\)" data-solution-options="[&quot;\\((2.5,–1)\\)&quot;, &quot;\\((–11,2)\\)&quot;, &quot;\\((7,–1)\\)&quot;, &quot;\\((–20,4)\\)&quot;]">
    <problem>
      <para>
          \( \left\{ \begin{array}{c l} 6x + 27y = -12\\ -6x - 26y = 14 \end{array}\right. \)</para>
      </problem>
    <solution>
      <para>Correct! \((–11,2)\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.5.3. 
      </para>
    </div>
    </exercise>
  <!--Q6-->
  <exercise data-content-id="f1557db3-d0fd-4804-8d97-10f35a57818c" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((–4,5)\)" data-solution-options="[&quot;\\((–10,2)\\)&quot;, &quot;\\((–14,0)\\)&quot;, &quot;\\((–4,5)\\)&quot;, &quot;\\((0,7)\\)&quot;]">
    <problem>
      <para> \( \left\{ \begin{array}{c l} 3x + 4y = 8\\ -3x + 6y = 42 \end{array}\right. \)</para>
      </problem>
    <solution>
      <para>Correct! \((–4,5)\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.5.3.
      </para>
    </div>
    </exercise>
  <!--Q7-->
  <exercise data-content-id="0260f2e2-acd6-40a4-8011-641f21a8c089" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((1,–7)\)" data-solution-options="[&quot;\\((7,–2)\\)&quot;, &quot;\\((–13,3)\\)&quot;, &quot;\\((19,3)\\)&quot;, &quot;\\((1,–7)\\)&quot;]">
    <problem>
      <para> \( \left\{ \begin{array}{c l} 5x - 9y = 68\\ -5x + 6y = -47 \end{array}\right. \)</para>
      </problem>
    <solution>
      <para>Correct! \((1,–7)\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.5.3. 

      </para>
    </div>
    </exercise>
  <!--Q8-->
  <exercise data-content-id="e8c33500-4fbe-4892-ad4f-8b0b413005da" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((4,–9)\)" data-solution-options="[&quot;\\((19,0)\\)&quot;, &quot;\\((4,–9)\\)&quot;, &quot;\\((14,–3)\\)&quot;, &quot;\\((–1,–17)\\)&quot;]">
    <problem>
      <para> \( \left\{ \begin{array}{c l} -3x + 5y = -57\\ 8x - 5y = 77 \end{array}\right. \)</para>
      </problem>
    <solution>
      <para>Correct! \((4,–9)\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.5.3.


      </para>
    </div>
    </exercise>
  <!--Q9-->
  <exercise data-content-id="442c3edf-15b7-48af-be5b-79dcd0adfc73" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((–6,2)\)" data-solution-options="[&quot;\\((0,14)\\)&quot;, &quot;\\((4,6)\\)&quot;, &quot;\\((–8,–5)\\)&quot;, &quot;\\((–6,2)\\)&quot;]">
    <problem>
      <para> \( \left\{ \begin{array}{c l} 4x - 2y = -28\\ -7x + 2y = 46 \end{array}\right. \)</para>
      </problem>
    <solution>
      <para>Correct! \((–6,2)\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.5.3. 


      </para>
    </div>
    </exercise>
  <!--Q10-->
  <exercise data-content-id="175faaf6-d8d0-419f-abeb-9149f7a87d17" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((5,11)\)" data-solution-options="[&quot;\\((5,11)\\)&quot;, &quot;\\((2,9)\\)&quot;, &quot;\\((8,12)\\)&quot;, &quot;\\((–8,13)\\)&quot;]">
    <problem>
      <para> \( \left\{ \begin{array}{c l}  -2x + 3y = 23\\ 2x - 6y = -56 \end{array}\right. \)</para>
      </problem>
    <solution>
      <para>Correct! \((5,11)\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.5.3.



      </para>
    </div>
    </exercise>
