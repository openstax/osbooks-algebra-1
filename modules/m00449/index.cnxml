<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.5.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00449</md:content-id>
    <md:title>2.5.5: Practice</md:title>
    <md:uuid>505aca80-7eec-4c0f-94be-344b7076a15f</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <para id="para-00002">For questions 1 – 4, add the equations in the system to find a new equation.</para>

        <exercise id="c03daac5-e19e-4214-9ed3-81dd1107a242" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00003"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="center"><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>39</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
            <para id="para-00004">Multiple Choice:</para>
            <para id="para-00005"><m:math><m:mrow><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>38</m:mn></m:mrow></m:math></para>
            <para id="para-00006"><m:math><m:mrow><m:mi>–</m:mi><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>40</m:mn></m:mrow></m:math></para>
            <para id="para-00007"><m:math><m:mrow><m:mi>–</m:mi><m:mn>8</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>40</m:mn></m:mrow></m:math></para>
            <para id="para-00008"><m:math><m:mrow><m:mi>–</m:mi><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>40</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00009">Correct! <m:math display="inline"><m:mrow><m:mi>–</m:mi><m:mn>8</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>40</m:mn></m:mrow></m:math></para>
            <para id="para-00010">Try again. Revisit activity 2.5.2.</para>
            <para id="para-00011">The correct answer is <m:math display="inline"><m:mrow><m:mi>–</m:mi><m:mn>8</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>40</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>

        <exercise id="cc7025cc-a782-4eac-9737-77a337e29ca4" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00012"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="center"><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
            <para id="para-00013">Multiple Choice:</para>
            <para id="para-00014"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>7</m:mn></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mi>–</m:mi><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
            <para id="para-00015"><m:math display="inline"><m:mrow><m:mi>–</m:mi><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>7</m:mn></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
            <para id="para-00016"><m:math display="inline"><m:mrow><m:mi>–</m:mi><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>7</m:mn></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
            <para id="para-00017"><m:math display="inline"><m:mrow><m:mi>–</m:mi><m:mn>11</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>7</m:mn></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mn>11</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00018">Correct! <m:math display="inline"><m:mrow><m:mi>–</m:mi><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>7</m:mn></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
            <para id="para-00019">Try again. Revisit activity 2.5.2.</para>
            <para id="para-00020">The correct answer is <m:math display="inline"><m:mrow><m:mi>–</m:mi><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>7</m:mn></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>

        <exercise id="_564b8d2d-aef4-438a-b352-0ef8d4fb0497" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00021"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="center"><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>10</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>62</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
            <para id="para-00022">Multiple Choice:</para>
            <para id="para-00023"><m:math><m:mrow><m:mi>–</m:mi><m:mn>13</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>65</m:mn></m:mrow></m:math></para>
            <para id="para-00024"><m:math><m:mrow><m:mi>–</m:mi><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>65</m:mn></m:mrow></m:math></para>
            <para id="para-00025"><m:math><m:mrow><m:mi>–</m:mi><m:mn>8</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>65</m:mn></m:mrow></m:math></para>
            <para id="para-00026"><m:math><m:mrow><m:mi>–</m:mi><m:mn>13</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>65</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00027">Correct! <m:math display="inline"><m:mrow><m:mi>–</m:mi><m:mn>13</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>65</m:mn></m:mrow></m:math></para>
            <para id="para-00028">Try again. Revisit activity 2.5.2.</para>
            <para id="para-00029">The correct answer is <m:math display="inline"><m:mrow><m:mi>–</m:mi><m:mn>13</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>65</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>

        <exercise id="_0d47e68e-20c1-4143-aef1-de09980d6678" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00030"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="center"><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>16</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>10</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
            <para id="para-00031">Multiple Choice:</para>
            <para id="para-00032"><m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para>
            <para id="para-00033"><m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para>
            <para id="para-00034"><m:math display="inline"><m:mrow><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para>
            <para id="para-00035"><m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>12</m:mn></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00036">Correct! <m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para>
            <para id="para-00037">Try again. Revisit activity 2.5.2.</para>
            <para id="para-00038">The correct answer is <m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
  
        
      <para id="para-00039">For questions 5 – 10, solve each system of equations.</para>

        <exercise id="_1cc9948d-650a-4ef9-b839-056b65aa9185" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00040"> <m:math display="inline"><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="center"><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>27</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>12</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>26</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>14</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
            <para id="para-00041">Multiple Choice:</para>
            <para id="para-00042"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2.5</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00043"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>11</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00044"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00045"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>20</m:mn><m:mo>,</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00046">Correct! <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>11</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00047">Try again. Revisit activity 2.5.3.</para>
            <para id="para-00048">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>11</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>

        <exercise id="f1557db3-d0fd-4804-8d97-10f35a57818c" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00049"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="center"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>42</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
            <para id="para-00050">Multiple Choice:</para>
            <para id="para-00051"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>10</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00052"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>14</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00053"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00054"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00055">Correct! <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00056">Try again. Revisit activity 2.5.3.</para>
            <para id="para-00057">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>

        <exercise id="_0260f2e2-acd6-40a4-8011-641f21a8c089" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00058"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="center"><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>9</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>68</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>47</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
            <para id="para-00059">Multiple Choice:</para>
            <para id="para-00060"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00061"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>13</m:mn><m:mo>,</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00062"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>19</m:mn><m:mo>,</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00063"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00064">Correct! <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00065">Try again. Revisit activity 2.5.3.</para>
            <para id="para-00066">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>

        <exercise id="e8c33500-4fbe-4892-ad4f-8b0b413005da" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00067"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="center"><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>57</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>77</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
            <para id="para-00068">Multiple Choice:</para>
            <para id="para-00069"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>19</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00070"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00071"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>14</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00072"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>1</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>17</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00073">Correct! <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00074">Try again. Revisit activity 2.5.3.</para>
            <para id="para-00075">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>

        <exercise id="_442c3edf-15b7-48af-be5b-79dcd0adfc73" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00076"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="center"><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>28</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mo>−</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>46</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
            <para id="para-00077">Multiple Choice:</para>
            <para id="para-00078"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>14</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00079"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00080"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>8</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00081"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00082">Correct! <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00083">Try again. Revisit activity 2.5.3.</para>
            <para id="para-00084">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        
        <exercise id="_175faaf6-d8d0-419f-abeb-9149f7a87d17" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00085"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="center"><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>23</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>56</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
            <para id="para-00086">Multiple Choice:</para>
            <para id="para-00087"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
