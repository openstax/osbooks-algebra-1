<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.5.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00449</md:content-id>
    <md:title>2.5.5: Practice</md:title>
    <md:uuid>505aca80-7eec-4c0f-94be-344b7076a15f</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <para id="para-00002">For questions 1 – 4, add the equations in the system to find a new equation.</para>

        <exercise id="c03daac5-e19e-4214-9ed3-81dd1107a242" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00003">\( \left\{ \begin{array}{c l} 6x - 5y = -1\\ -6x - 3y = -39 \end{array}\right. \)</para>
            <para id="para-00004">Multiple Choice:</para>
            <para id="para-00005">\(2y = –38\)</para>
            <para id="para-00006">\(–2y = –40\)</para>
            <para id="para-00007">\(–8y = –40\)</para>
            <para id="para-00008">\(–8x = –40\)</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00009">Correct! \(–8y = –40\)</para>
            <para id="para-00010">Try again. Revisit activity 2.5.2.</para>
            <para id="para-00011">The correct answer is \(–8y = –40\).</para>
          </solution>
        </exercise>

        <exercise id="cc7025cc-a782-4eac-9737-77a337e29ca4" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00012">\( \left\{ \begin{array}{c l} 5x - 3y = -1\\ -6x + 3y = -6 \end{array}\right. \)</para>
            <para id="para-00013">Multiple Choice:</para>
            <para id="para-00014">\(x = –7\) or \(–x = 7\)</para>
            <para id="para-00015">\(–x = –7\) or \(x = 7\)</para>
            <para id="para-00016">\(–6x = –7\) or \(6x = 7\)</para>
            <para id="para-00017">\(–11x = –7\) or \(11x = 7\)</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00018">Correct! \(–x = –7\) or \(x = 7\)</para>
            <para id="para-00019">Try again. Revisit activity 2.5.2.</para>
            <para id="para-00020">The correct answer is \(–x = –7\) or \(x = 7\).</para>
          </solution>
        </exercise>

        <exercise id="_564b8d2d-aef4-438a-b352-0ef8d4fb0497" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00021">\( \left\{ \begin{array}{c l} 4x - 3y = 3\\ -4x - 10y = 62 \end{array}\right. \)</para>
            <para id="para-00022">Multiple Choice:</para>
            <para id="para-00023">\(–13y = 65\)</para>
            <para id="para-00024">\(–8x = 65\)</para>
            <para id="para-00025">\(–8y = 65\)</para>
            <para id="para-00026">\(–13x = 65\)</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00027">Correct! \(–13y = 65\)</para>
            <para id="para-00028">Try again. Revisit activity 2.5.2.</para>
            <para id="para-00029">The correct answer is \(–13y = 65\).</para>
          </solution>
        </exercise>

        <exercise id="_0d47e68e-20c1-4143-aef1-de09980d6678" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00030">\( \left\{ \begin{array}{c l} 6x + 16y = -6\\ -6x - 10y = 6 \end{array}\right. \)</para>
            <para id="para-00031">Multiple Choice:</para>
            <para id="para-00032">\(6y = 0\) or \(y = 0\)</para>
            <para id="para-00033">\(6x = 0\) or \(x = 0\)</para>
            <para id="para-00034">\(12x = 0\) or \(x = 0\)</para>
            <para id="para-00035">\(6y = 12\) or \(y = 6\)</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00036">Correct! \(6y = 0\) or \(y = 0\)</para>
            <para id="para-00037">Try again. Revisit activity 2.5.2.</para>
            <para id="para-00038">The correct answer is \(6y = 0\) or \(y = 0\).</para>
          </solution>
        </exercise>
  
        
      <para id="para-00039">For questions 5 – 10, solve each system of equations.</para>

        <exercise id="_1cc9948d-650a-4ef9-b839-056b65aa9185" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00040"> \( \left\{ \begin{array}{c l} 6x + 27y = -12\\ -6x - 26y = 14 \end{array}\right.
              \)</para>
            <para id="para-00041">Multiple Choice:</para>
            <para id="para-00042">\((2.5,–1)\)</para>
            <para id="para-00043">\((–11,2)\)</para>
            <para id="para-00044">\((7,–1)\)</para>
            <para id="para-00045">\((–20,4)\)</para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00046">Correct! \((–11,2)\)</para>
            <para id="para-00047">Try again. Revisit activity 2.5.3.</para>
            <para id="para-00048">The correct answer is \((–11,2)\).</para>
          </solution>
        </exercise>

        <exercise id="f1557db3-d0fd-4804-8d97-10f35a57818c" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00049">\( \left\{ \begin{array}{c l} 3x + 4y = 8\\ -3x + 6y = 42 \end{array}\right. \)</para>
            <para id="para-00050">Multiple Choice:</para>
            <para id="para-00051">\((–10,2)\)</para>
            <para id="para-00052">\((–14,0)\)</para>
            <para id="para-00053">\((–4,5)\)</para>
            <para id="para-00054">\((0,7)\)</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00055">Correct! \((–4,5)\)</para>
            <para id="para-00056">Try again. Revisit activity 2.5.3.</para>
            <para id="para-00057">The correct answer is \((–4,5)\).</para>
          </solution>
        </exercise>

        <exercise id="_0260f2e2-acd6-40a4-8011-641f21a8c089" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00058">\( \left\{ \begin{array}{c l} 5x - 9y = 68\\ -5x + 6y = -47 \end{array}\right. \)</para>
            <para id="para-00059">Multiple Choice:</para>
            <para id="para-00060">\((7,–2)\)</para>
            <para id="para-00061">\((–13,3)\)</para>
            <para id="para-00062">\((19,3)\)</para>
            <para id="para-00063">\((1,–7)\)</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00064">Correct! \((1,–7)\)</para>
            <para id="para-00065">Try again. Revisit activity 2.5.3.</para>
            <para id="para-00066">The correct answer is \((1,–7)\).</para>
          </solution>
        </exercise>

        <exercise id="e8c33500-4fbe-4892-ad4f-8b0b413005da" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00067">\( \left\{ \begin{array}{c l} -3x + 5y = -57\\ 8x - 5y = 77 \end{array}\right. \)</para>
            <para id="para-00068">Multiple Choice:</para>
            <para id="para-00069">\((19,0)\)</para>
            <para id="para-00070">\((4,–9)\)</para>
            <para id="para-00071">\((14,–3)\)</para>
            <para id="para-00072">\((–1,–17)\)</para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00073">Correct! \((4,–9)\)</para>
            <para id="para-00074">Try again. Revisit activity 2.5.3.</para>
            <para id="para-00075">The correct answer is \((4,–9)\).</para>
          </solution>
        </exercise>

        <exercise id="_442c3edf-15b7-48af-be5b-79dcd0adfc73" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00076">\( \left\{ \begin{array}{c l} 4x - 2y = -28\\ -7x + 2y = 46 \end{array}\right. \)</para>
            <para id="para-00077">Multiple Choice:</para>
            <para id="para-00078">\((0,14)\)</para>
            <para id="para-00079">\((4,6)\)</para>
            <para id="para-00080">\((–8,–5)\)</para>
            <para id="para-00081">\((–6,2)\)</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00082">Correct! \((–6,2)\)</para>
            <para id="para-00083">Try again. Revisit activity 2.5.3.</para>
            <para id="para-00084">The correct answer is \((–6,2)\).</para>
          </solution>
        </exercise>
        
        <exercise id="_175faaf6-d8d0-419f-abeb-9149f7a87d17" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00085">\( \left\{ \begin{array}{c l}  -2x + 3y = 23\\ 2x - 6y = -56 \end{array}\right. \)</para>
            <para id="para-00086">Multiple Choice:</para>
            <para id="para-00087">\((5,11)\)</para>
            <para id="para-00088">\((2,9)\)</para>
            <para id="para-00089">\((8,12)\)</para>
            <para id="para-00090">\((–8,13)\)</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00091">Correct! \((5,11)\)</para>
            <para id="para-00092">Try again. Revisit activity 2.5.3.</para>
            <para id="para-00093">The correct answer is \((5,11)\).</para>
          </solution>
        </exercise>
      </section>
    
  </content>
