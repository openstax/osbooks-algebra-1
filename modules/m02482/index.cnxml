  <content>
  <section><title>Activity </title>
<div class="os-raise-familysupport">
  <para>Access the <link url="https://k12.openstax.org/contents/raise/resources/b62c9150250bf52d6cc37569213ab516e0090dca">Desmos guide PDF</link> for tips on solving problems with the Desmos graphing calculator.</para>
</div>
<para>For questions 1 - 2, write an equation in vertex form of the quadratic function that has a vertex at (5, 8) and also goes through the point \((-3, 6)\).</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="7c4b2fdf-99bf-45be-bb4a-e1fc0017cb48" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0"><!--Q#1-->
  <exercise data-content-id="58610f1c-5083-4788-b112-383c4e6b3229" data-problem-comparator="text" data-problem-type="input" data-solution="-1/32">
    <problem>
      <para> Find the value of \(a\) for vertex form. </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct!</para>
      <para> \(y=a(x-h)^2+k\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>
<!--Q#2-->
<!--Q#2-->
<example><exercise>
  <problem>
    
    <para> Write the equation in vertex form. </para>
    <para>Enter your answer here and select the <emphasis>Solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\(y=\frac{-1}{32}(x-5)^2+8\)</para>
</solution></exercise>
</example><para>For questions 3 and 4, write an equation in vertex form of the quadratic function that has a vertex at \((-4, 3)\) and also goes through the point \((2, 5)\).</para>
<!--Interaction End -->
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="97eef87e-235a-4e29-8ff0-039ad9c43c13" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0"><!--Q#1-->
  <exercise data-content-id="3fb8876e-eb1f-4f46-99ef-2345f1eefa1b" data-problem-comparator="text" data-problem-type="input" data-solution="1/18">
    <problem>
      <para> Find the value of \(a\) for vertex form. </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct!</para>
      <para> \(y=a(x-h)^2+k\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>
<!--Q#4-->
<!--Q#4-->
<example><exercise>
  <problem>
    
    <para> Write the equation in vertex form. </para>
    <para>Enter your answer here and select the <emphasis>Solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\(y=\frac{1}{18}(x+4)^2+3\)</para>
</solution></exercise>
</example><!--Interaction End -->
<para>For questions 5 - 6, write an equation in vertex form of the quadratic function that has a vertex at \((6, -2)\) and also goes through the point \((3, 1)\).</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="acc6b98f-0cd2-4418-8a4f-fdfdb625e5c3" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0"><!--Q#5-->
  <exercise data-content-id="672d6cf9-11c0-41b0-8896-377ea42f89d5" data-problem-comparator="text" data-problem-type="input" data-solution="1/3">
    <problem>
      <para> Find the value of \(a\) for vertex form. </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct!</para>
      <para> \(y=a(x-h)^2+k\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>
<!--Q#6-->
<example><exercise>
  <problem>
    
    <para> Write the equation in vertex form. </para>
    <para>Enter your answer here and select the <emphasis>Solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\(y=\frac{1}{3}(x-6)^2-2\)</para>
</solution></exercise>
</example><!--Interaction End -->
