<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.9.3: Vertex Form Given a Vertex and Point</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02482</md:content-id>
    <md:title>9.9.3: Vertex Form Given a Vertex and Point</md:title>
