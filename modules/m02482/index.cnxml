<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Vertex Form Given a Vertex and Point</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02482</md:content-id>
    <md:title>Vertex Form Given a Vertex and Point</md:title>
    <md:uuid>2ba85e56-02e9-452a-87ce-2a15c32f7fce</md:uuid>
  </metadata>
  <content>
    <note id="note-00001">
      <para id="para-00001">Access the <link url="https://k12.openstax.org/contents/raise/resources/2c2987f83130584132cad08b60ad0d3ba45a32b9">Desmos guide PDF</link> for tips on solving problems with the Desmos graphing calculator.</para>
    </note>
    <section class="numbered-exercises" id="sect-00001">      <title>Activity</title>
      <para id="para-00002">For questions 1 - 2, write an equation in vertex form of the quadratic function that has a vertex at (5, 8) and also goes through the point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
      <exercise id="_58610f1c-5083-4788-b112-383c4e6b3229" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00003">Find the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math> for vertex form.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00004"><m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mi>h</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>k</m:mi></m:mrow></m:math></para><para id="para-00009"><m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>−</m:mo><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math></para><para id="para-00012"><m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>−</m:mo><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math></para><para id="para-00017"><m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>8</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math></para><para id="para-00020"><m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>8</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math></para><para id="para-00025"><m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>64</m:mn><m:mi>a</m:mi></m:mrow></m:math></para><para id="para-00030"><m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>64</m:mn><m:mi>a</m:mi></m:mrow></m:math></para><para id="para-00038"><m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>64</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>32</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00044"><m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>64</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>32</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
        </solution>
      </exercise>
      <!--Q#2-->
      <!--Q#2-->
      <exercise id="exer-00001">
        <problem id="prob-00002">
          <para id="para-00006">Write the equation in vertex form.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00008">Compare your answer: </para>
          <para id="para-00045"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>32</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <para id="para-00010">For questions 3 and 4, write an equation in vertex form of the quadratic function that has a vertex at <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> and also goes through the point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
      <!--Interaction End -->
      <exercise id="_3fb8876e-eb1f-4f46-99ef-2345f1eefa1b" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00011">Find the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math> for vertex form.</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00046"><m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mi>h</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>k</m:mi></m:mrow></m:math></para><para id="para-00047"><m:math display="inline"><m:mrow><m:mn>5</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para><para id="para-00048"><m:math display="inline"><m:mrow><m:mn>5</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para><para id="para-00049"><m:math display="inline"><m:mrow><m:mn>5</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para><para id="para-00050"><m:math display="inline"><m:mrow><m:mn>5</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para><para id="para-00051"><m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>36</m:mn><m:mi>a</m:mi></m:mrow></m:math></para><para id="para-00052"><m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>36</m:mn><m:mi>a</m:mi></m:mrow></m:math></para><para id="para-00053"><m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>36</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>18</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00054"><m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>36</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>18</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
        </solution>
      </exercise>
      <!--Q#4-->
      <!--Q#4-->
      <exercise id="exer-00002">
        <problem id="prob-00004">
          <para id="para-00014">Write the equation in vertex form.</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00016">Compare your answer: </para>
          <para id="para-00055"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>18</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <para id="para-00018">For questions 5 - 6, write an equation in vertex form of the quadratic function that has a vertex at <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> and also goes through the point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
      <exercise id="_672d6cf9-11c0-41b0-8896-377ea42f89d5" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00019">Find the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math> for vertex form.</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00056"><m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mi>h</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>k</m:mi></m:mrow></m:math></para><para id="para-00057"><m:math display="inline"><m:mrow><m:mn>1</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>−</m:mo><m:mn>6</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00058"><m:math display="inline"><m:mrow><m:mn>1</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>−</m:mo><m:mn>6</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00059"><m:math display="inline"><m:mrow><m:mn>1</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para><para id="para-00060"><m:math display="inline"><m:mrow><m:mn>1</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para><para id="para-00061"><m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>9</m:mn><m:mi>a</m:mi></m:mrow></m:math></para><para id="para-00062"><m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>9</m:mn><m:mi>a</m:mi></m:mrow></m:math></para><para id="para-00063"><m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>9</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00064"><m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>9</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
        </solution>
      </exercise>
      <!--Q#6-->
      <exercise id="exer-00003">
        <problem id="prob-00006">
          <para id="para-00022">Write the equation in vertex form.</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00024">Compare your answer: </para>
          <para id="para-00065"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para></solution>
      </exercise>
    </section>
    <section id="sect-00002">
      <title>Video: Writing an Quadratic Equation from a Vertex and a Point</title>
      <para id="para-00026">Watch the following video to learn more about writing a quadratic equation from a vertex and a point.</para>
      <media alt="Placeholder for Alt Text">
        <iframe width="660" height="371.4" src="https://www.youtube-nocookie.com/embed/1IUEVwIjywc?si=lbcWBG5YBlTAOW1k;&amp;rel=0"/>
      </media>
    </section>
    <note class="self-check" id="note-00002">
      <exercise id="exer-00005">
        <problem id="prob-00008">
        <para id="para-00027"><link class="os-embed" url="#exercise/Alg1_9_9_3_SC"/></para>
        </problem>
        </exercise>
       
    </note>
    <section id="sect-00003">
      <title>Additional Resources</title>
      <section id="sect-00004">
        <title>Creating Vertex Form from a Vertex and a Point</title>
        <para id="para-00028">Write the quadratic in vertex form that has a vertex at <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> and goes through the point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        <para id="para-00029">First start with the vertex form of a quadratic function.</para>
        <para id="para-00066"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mi>h</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>k</m:mi></m:mrow></m:math></para><para id="para-00031"><emphasis>Step 1</emphasis> - Substitute the vertex in at <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mo>,</m:mo><m:mi>k</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>. </para><para id="para-00068"><m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
        <para id="para-00032"><emphasis>Step 2</emphasis> - Substitute the other point at <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>,</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>. </para><para id="para-00069"><m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
        <para id="para-00033"><emphasis>Step 3</emphasis> - Solve for <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>. </para><para id="para-00070"><m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math> </para><para id="para-00071"><m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math> </para><para id="para-00072"><m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math> </para><para id="para-00073"><m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math> </para><para id="para-00074"><m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> </para><para id="para-00075"><m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math> </para><para id="para-00076"><m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
        <para id="para-00034"><emphasis>Step 4</emphasis> - Substitute the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math> value and the vertex <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mo>,</m:mo><m:mi>k</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math> into the vertex form. </para><para id="para-00077"><m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
        <note class="try" id="note-00003">
          <title>Try It: Creating Vertex Form from a Vertex and a Point</title>
          <!--Q#-->
      <exercise id="exer-00004">
            <problem id="prob-00007">
              <para id="para-00035">Write the quadratic in vertex form that has a vertex at <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> and goes through the point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
              <para id="para-00036"></para>
            </problem>
            <solution id="sol-00007">
              <para id="para-00037">Compare your answer: </para>
              <para id="para-00067"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para><para id="para-00039">First, start with the vertex form of a quadratic function: </para><para id="para-00078"><m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mi>h</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>k</m:mi></m:mrow></m:math></para>
              <para id="para-00040"><emphasis>Step 1</emphasis> - Substitute the vertex at <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mo>,</m:mo><m:mi>k</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>: </para><para id="para-00079"><m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
              <para id="para-00041"><emphasis>Step 2</emphasis> - Substitute the other point at <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>,</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>: </para><para id="para-00080"><m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
              <para id="para-00042"><emphasis>Step 3</emphasis> - Solve for <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>: </para><para id="para-00081"><m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math> </para><para id="para-00082"><m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math> </para><para id="para-00083"><m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
              <para id="para-00043"><emphasis>Step 4</emphasis> - Substitute the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math> and the vertex <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mo>,</m:mo><m:mi>k</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math> into the vertex form: </para><para id="para-00084"><m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
            </solution>
          </exercise>
        </note>
        <!-- Interaction End -->
      </section>
    </section>
  </content>
</document>