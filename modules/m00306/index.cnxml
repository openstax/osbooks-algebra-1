  </div></div>
<!--Q#9-->
<exercise>
  <problem>
    <para> Substitute the slope into slope-intercept form. </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(y= \frac{3}{2}x +b\)</para>
  </solution></exercise>
<!--Interaction End -->
<!--Q#10-->
<exercise>
  <problem>
    <para> Substitute the one point in for \((x, y)\) in the equation. </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(5= \frac{3}{2}(2) +b\)</para>
  </solution></exercise>
<!--Interaction End -->
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="e1e3f130-0e65-422b-9a1d-680f862071e3" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0"><!--Q#11-->
