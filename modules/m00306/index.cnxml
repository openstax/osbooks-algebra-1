  </div></div>
<!--Q#2-->
<exercise>
  <problem>
    <para> Find the equation in point slope-form of the line that goes through the two points. </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(y-y_1=m(x-x_1)\)</para>
  </solution></exercise>
<!--Interaction End -->
<!--Q#3-->
<exercise>
  <problem>
    <para> Write the equation from question 2 into slope-intercept form. </para>
    <para>(Hint: Solve for \(y\).)</para>
  </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para/>
  </solution></exercise>
<!--Interaction End -->
<para><emphasis>Writing Equations in Slope-Intercept Form Given a Point and Slope</emphasis></para>
<para>For 4 - 7 use the point \((3, -2)\) and the slope -4.</para>
<!--Q#4-->
<exercise>
  <problem>
    <para> Substitute the slope into slope-intercept form. </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(y= -4x +b\)</para>
  </solution></exercise>
<!--Interaction End -->
<!--Q#5-->
<exercise>
  <problem>
    <para> Substitute the given point in for \((x, y)\) in the equation. </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(-2= -4(3) +b\)</para>
  </solution></exercise>
<!--Interaction End -->
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="031d2cca-f9f9-4782-a655-fbda81a06bdb" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0"><!--Q#6-->
  <exercise data-content-id="ee65d7ce-dddd-4fce-ba53-ad14f6eff791" data-problem-comparator="integer" data-problem-type="input" data-solution="10">
    <problem>
      <para> Solve for \(b\) in slope-intercept form. </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! 10</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
    <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div></div>
<!--Q#7-->
<exercise>
  <problem>
    <para> Write the equation in slope-intercept form. </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(y= -4x +10\)</para>
  </solution></exercise>
<!--Interaction End -->
<para>With a partner, work to go directly from two points to an equation in slope-intercept form, without using point-slope form.</para>
<para>For 8 - 12, use the two points \((5, 2)\) and \((3, -1)\)</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="4fe3d466-dc34-4c1f-b555-ad68b7b60c68" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0"><!--Q#8-->
  <exercise data-content-id="86409435-3d6d-4faa-ae2e-7ecb87fbf9a3" data-problem-comparator="text" data-problem-type="input" data-solution="3/2">
    <problem>
      <para> Find the slope between the two points. </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(\frac32\)</para>
    </solution>
        </exercise>
  <!--END QUESTION.--> <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
    <div class="os-raise-ib-pset-encourage-response">
