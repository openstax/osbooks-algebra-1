  <content>
  <section><title>Activity</title>
<para><emphasis>Writing Equations Given Two Points</emphasis></para>
<para>For 1 - 3, use the point \((3,4)\) and \((-2, 5)\).</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="0070b555-6d0c-4134-951a-8e78b9914d55" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0"><!--Q#1-->
  <exercise data-content-id="69c0e917-231f-4bb7-b26e-c3d1c4e8d7a2" data-problem-comparator="text" data-problem-type="input" data-solution="-1/5">
    <problem>
      <para> Find the slope of the line that goes through the two points. </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(-\frac15\)</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
