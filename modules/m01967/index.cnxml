    <section id="sect-00001">
      <title>Warm Up Activity</title>
      <para id="para-00038">1. Complete each row with an equivalent expression in standard form or factored form.</para>
      <table class="unnumbered os-raise-midsizetable" id="table-00001">
        <tgroup cols="2">
          <tbody>
            <row>
              <entry><emphasis>Standard Form</emphasis></entry>
              <entry><emphasis>Factored Form</emphasis></entry>
            </row>
            <row>
              <entry>
                <para id="para-00001"><m:math>
                    <m:mrow>
                      <m:msup>
                        <m:mi>x</m:mi>
                        <m:mn>2</m:mn>
                      </m:msup>
                    </m:mrow>
                  </m:math></para></entry>
              <entry>
                <para id="para-00002">a. _____</para>
              </entry>
            </row>
            <row>
              <entry>
                <para id="para-00003">d. _____</para>
              </entry>
              <entry>
                <para id="para-00004"><m:math>
                    <m:mrow>
                      <m:mi>x</m:mi>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>9</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                    </m:mrow>
                  </m:math></para></entry>
            </row>
            <row>
              <entry>
                <para id="para-00005"><m:math>
                    <m:mrow>
                      <m:msup>
                        <m:mi>x</m:mi>
                        <m:mn>2</m:mn>
                      </m:msup>
                      <m:mo>−</m:mo>
                      <m:mn>18</m:mn>
                      <m:mi>x</m:mi>
                    </m:mrow>
                  </m:math></para></entry>
              <entry>
                <para id="para-00006">b. _____</para>
              </entry>
            </row>
            <row>
              <entry>
                <para id="para-00007">e. _____</para>
              </entry>
              <entry>
                <para id="para-00008"><m:math>
                    <m:mrow>
                      <m:mi>x</m:mi>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mn>6</m:mn>
                      <m:mo>−</m:mo>
                      <m:mi>x</m:mi>
                      <m:mo stretchy="false">)</m:mo>
                    </m:mrow>
                  </m:math></para></entry>
            </row>
            <row>
              <entry>
                <para id="para-00009"><m:math>
                    <m:mrow>
                      <m:mo>−</m:mo>
                      <m:msup>
                        <m:mi>x</m:mi>
                        <m:mn>2</m:mn>
                      </m:msup>
                      <m:mo>+</m:mo>
                      <m:mn>10</m:mn>
                      <m:mi>x</m:mi>
                    </m:mrow>
                  </m:math></para></entry>
              <entry>
                <para id="para-00010">c. _____</para>
              </entry>
            </row>
            <row>
              <entry>
                <para id="para-00011">f. _____</para>
              </entry>
              <entry>
                <para id="para-00012"><m:math>
                    <m:mrow>
                      <m:mo>−</m:mo>
                      <m:mi>x</m:mi>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>2.75</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                    </m:mrow>
                  </m:math></para></entry>
            </row>
          </tbody>
        </tgroup>
      </table>

      <exercise id="exer-00001">
        <problem id="prob-00001">

          <para id="para-00013">a. What is the factored form of <m:math display="inline">
