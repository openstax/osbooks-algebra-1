<exercise id="exer-00001">
  <problem id="prob-00001">
    
    <para id="para-00013"> What is the factored form of <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>?</para>
      <para id="para-00014">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00001">
  <para id="para-00015">Compare your answer: </para>
  
  <para id="para-00016"><m:math><m:mrow><m:mi>x</m:mi><m:mi>·</m:mi><m:mi>x</m:mi></m:mrow></m:math></para></solution></exercise>

