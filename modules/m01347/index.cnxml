    <md:uuid>8e23a76d-d587-4919-a720-c41f8824e426</md:uuid>
  </metadata>
  <content>
  <note class="self-check"><para>A census of hemlock trees is taken in a national park. The rangers have found that only \(\frac45\) of the population
  has survived each year. The data are shown in the table. Find the number of hemlocks that were in the park 2 years
  before the census was taken.</para>

<table class="os-raise-midsizetable">
  <tgroup cols="2"><tbody><row>
      <entry><emphasis>\(y\), years since census</emphasis></entry><entry><emphasis>\(h\), number of hemlocks</emphasis></entry></row>
  <row>          
    <entry>
      –2
    </entry>
    <entry> </entry>
  </row>
  <row>
    <entry>
      0
    </entry>
    <entry>
      64,000
    </entry>
  </row>
  <row>
    <entry>
     1
    </entry>
    <entry>
     51,200
    </entry>
  </row>
  <row>
    <entry>
  3
    </entry>
    <entry>
      32,768
    </entry>
  </row>
</tbody></tgroup></table>
</note>
</content>
</document>