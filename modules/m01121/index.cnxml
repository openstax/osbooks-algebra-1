  <content>
  <section><title>Cool Down Activity</title>
<para>A sequence starts 3, 6, . . .</para>

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Give a rule the sequence could follow, and list the next 3 terms.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>Each term adds 3 from the previous term. The next three terms are 9, 12, 15.</para>
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Give a different rule the sequence could follow, and list the next 3 terms.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>Each term doubles the previous term. The next three terms are 12, 24, 48.</para>
  </solution></exercise>
<!--Interaction End -->

