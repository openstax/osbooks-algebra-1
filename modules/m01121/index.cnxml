  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
<para id="para-00001">A sequence starts 3, 6, . . .</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002">Give a rule the sequence could follow, and list the next 3 terms.</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00003">Compare your answer: </para>
    
    <para id="para-00004">Each term adds 3 from the previous term. The next three terms are 9, 12, 15.</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00005">Give a different rule the sequence could follow, and list the next 3 terms.</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00006">Compare your answer: </para>
    
    <para id="para-00007">Each term doubles the previous term. The next three terms are 12, 24, 48.</para>
  
  </solution></exercise>
<!--Interaction End -->
<section id="sect-00002">
