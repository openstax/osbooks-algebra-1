<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.5.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00139</md:content-id>
    <md:title>1.5.6: Practice</md:title>
    <md:uuid>9f3c822a-5e76-4772-9739-75a91705b430</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <para id="para-00002">Use the graph for questions 1 - 2.</para>
      
        <media alt="graph of (0, 4) and (4, 0).">
          <image mime-type="image/png" src="../../media/Algebra-1_01_07_13_01.png"/>
        </media>
      
      <exercise id="_3421aa35-b50d-4c5c-a3b1-441817c24a26" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00003">Which of the following ordered pairs are on the line? Select <emphasis>three</emphasis> answers.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00004">Correct! \((0, 4)\), \((2, 2)\), \((-2, 6)\)</para>
          <para id="para-00005">Try again. Revisit activity 1.5.3.</para>
          <para id="para-00006">The correct answers are \((0, 4)\), \((2, 2)\), \((-2, 6)\)</para>
        </solution>
      </exercise>
      <exercise id="_415975ee-822f-40eb-99ca-a1679c41d927" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00007">Which of the following ordered pairs are solutions to the equation? Select <emphasis> three</emphasis> solutions.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00008">Correct! \((0, 4)\), \((2, 2)\), \((-2, 6)\)</para>
          <para id="para-00009">Try again. Revisit activity 1.5.3.</para>
          <para id="para-00010">The correct answers are \((0, 4)\), \((2, 2)\), \((-2, 6)\)</para>
        </solution>
      </exercise>
      <para id="para-00011">For questions 3 and 4, use the graph of \(y = 3x -1\) as shown.</para>
      
        <media alt="">
          <image mime-type="image/png" src="../../media/Algebra-1_01_07_13_02.png"/>
        </media>
      
      <exercise id="_979c0e0d-259c-42cb-a28b-039132e7ceab" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00012">Which of the following ordered pairs are on the line? Select <emphasis>three</emphasis> answers</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00013">Correct! \((0, -1)\), \((1, 2)\), \((2, 5)\)</para>
          <para id="para-00014">Try again. Revisit activity 1.5.3.</para>
          <para id="para-00015">The correct answers are \((0, -1)\), \((1, 2)\), \((2, 5)\)</para>
        </solution>
      </exercise>
      <exercise id="_9be3c94b-b5fd-4db2-adf0-8aa79239490f" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00016">Which of the following ordered pairs are solutions to the equation? Select <emphasis> three</emphasis> solutions.</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00017">Correct! \((0, -1)\), \((1, 2)\), \((2, 5)\)</para>
          <para id="para-00018">Try again. Revisit activity 1.5.3.</para>
          <para id="para-00019">The correct answers are \((0, -1)\), \((1, 2)\), \((2, 5)\)</para>
        </solution>
      </exercise>
      <exercise id="b0789d3d-017e-4fdf-9a8c-8a3f136c5cab" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00020">Which of the following ordered pairs are solutions to the equation? Select <emphasis> three</emphasis> solutions.</para>
          
            <media alt="">
              <image mime-type="image/png" src="../../media/Algebra-1_01_07_13_03.png"/>
            </media>
          
        </problem>
        <solution id="sol-00005">
          <para id="para-00021">Correct! \((-4, -3)\), \((-1, 1.5)\), \((0, 3)\)</para>
          <para id="para-00022">Try again. Revisit activity 1.5.3.</para>
          <para id="para-00023">The correct answers are \((-4, -3)\), \((-1, 1.5)\), \((0, 3)\)</para>
        </solution>
      </exercise>
      <exercise id="d5a98fb8-d5a5-4373-9325-cf4e7dd62f4d" class="multiple-choice">
        <problem id="prob-00006">
          <para id="para-00024">Here is a graph of the equation \( x+3y=6 \).</para>
          <para id="para-00025">Select three coordinate pairs that represent a solution to the equation.</para>
          
            <media alt="">
              <image mime-type="image/png" src="../../media/Algebra-1_01_07_13_04.png"/>
            </media>
          
        </problem>
        <solution id="sol-00006">
          <para id="para-00026">Correct! \((0, 2)\), \((3, 1)\), \((6, 0)\)</para>
          <para id="para-00027">Try again. Revisit activity 1.5.3.</para>
          <para id="para-00028">The correct answers are \((0, 2)\), \((3, 1)\), \((6, 0)\)</para>
        </solution>
      </exercise>
    </section>
  </content>
