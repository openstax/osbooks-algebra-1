<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Determine a Solution to Inequalities</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00663</md:content-id>
    <md:title>Determine a Solution to Inequalities</md:title>
    <md:uuid>18b472e0-edfa-4e6b-8774-f01b981d9e3d</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <para id="para-00001">Is the ordered pair \((5.43, 0)\) a solution to all, some, or none of these
        inequalities? Be prepared to explain your reasoning.</para>
      <list id="list-00001">
        <item>\(x > 0\)</item>
        <item>\(y > 0\)</item>
        <item>\(x\;\geq\;0\)</item>
        <item>\(y\;\geq\;0\)</item>
      </list>
    </section>
  </content>
</document>