        </exercise>
      
      <!--Interaction End -->
      <!--Q#7-->
      
        <exercise id="exer-00007">
          <problem id="prob-00007">
            <para id="para-00028">On the graph of \(p\), where can you see each number that appears in the equation?</para>
            <para id="para-00029">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00030">Compare your answer:</para>
            <para id="para-00031">100 is the vertical intercept (or the value of \(p\) when \(t\) is 0). The 3 is the tripling of the \(p\) value every time \(t\) increases by 1</para>
          </solution>
        </exercise>
      
