      <!--Q#5-->
      
        <exercise id="exer-00005">
          <problem id="prob-00005">
            <para id="para-00021">On the graph of \(n\), where can you see each number that appears in the equation?</para>
            <para id="para-00022">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00023">Compare your answer:</para>
            <para id="para-00024">500 is the vertical intercept (or the value of \(n\) when \(t\) is 0). The 2 is the doubling of the \(n\) value every time \(t\) increases by 1.</para>
          </solution>
        </exercise>
      
      <!--Interaction End -->
