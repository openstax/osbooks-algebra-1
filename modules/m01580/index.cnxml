  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<para>For questions 1 - 5, simplify each expression completely. </para>
<!--Do not edit this div tag.  It must surround the interaction block-->
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="d5589ce7-08a3-4b87-a711-588c3201754c" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--q1-->
  <exercise data-content-id="31411e4f-7669-41d2-bfa2-4c227dc837f1" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(6ab^2\)" data-solution-options="[&quot;\\(6ab^2\\)&quot;, &quot; \\(22ab^2\\)&quot;, &quot;\\(14ab^2\\)&quot;, &quot; \\(8ab^2\\)&quot;]">
    <problem>
      <para>\(14ab^2-8ab^2\) </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.1.2.</para>
    </div>
    </exercise>
  <!--Q2-->
  <exercise data-content-id="1d91d1cd-1f5a-4d42-97b1-f8dca7a4f3ff" data-problem-comparator="math" data-problem-type="input" data-solution="(8k^2+5k+31)">
    <problem>
      <para>\((8k^2-3k+14)+(8k+17)\) </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.1.2.</para>
    </div>
    </exercise>
  <!--q3-->
  <exercise data-content-id="0f5a6c3b-f396-4007-bb7e-c4198ff89170" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(3b^2-11b-5\)" data-solution-options="[&quot;\\(11b^2+7b-19\\)&quot;, &quot;\\(3b^2+7b-19\\)&quot;, &quot;\\(3b^2-11b-5\\)&quot;, &quot; \\(11b^2-11b-5\\)&quot;]">
    <problem>
      <para>\((7b^2-2b-12)-(4b^2+9b-7)\) </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.1.2.
      </para>
    </div>
    </exercise>
  <!--q4-->
  <exercise data-content-id="c6a07638-4de2-48b5-9d83-141c9a9539fc" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(4mn^3-2m^2n-8mn\)" data-solution-options="[&quot;\\(10mn^3-2m^2n-16mn\\)&quot;, &quot;\\(4mn^3-2m^2n-8mn\\)&quot;, &quot;\\(4mn^3-2m^2n-16mn\\)&quot;, &quot;\\(4mn^3-10m^2n\\)&quot;]">
    <problem>
      <para>\( (7mn^3-2m^2n-12mn)-(3mn^3-4mn)\) </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.1.2.</para>
    </div>
    </exercise>
  <!--q5-->
  <exercise data-content-id="c8996f10-bb87-4d70-9349-cf59164cdd90" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(r^3-2s^3\)" data-solution-options="[&quot;\\(r^3+2s^3\\)&quot;, &quot;\\(r^3-rs^2-2s^3\\)&quot;, &quot;\\(r^3-2s^3\\)&quot;, &quot;\\(r^3+rs^2-2s^3\\)&quot;]">
    <problem>
      <para>\( (r^3-r^2s)-2(rs^2+s^3)+(r^2s+2rs^2)\) </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.1.2.
      </para>
    </div>
    </exercise>
  <!--q6-->
  <exercise data-content-id="e60fdd8f-2742-4743-8f88-f7a439b07006" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="200" data-solution-options="[&quot;-2&quot;, &quot;200&quot;, &quot;192&quot;, &quot;48&quot;]">
    <problem>
      <para>Use the following polynomial functions to answer questions 6 – 10.</para>
      <para>\(p(x) = 12x^2+3x-4\)</para>
        <para>\(d(x) = 3x^2-11x-6\)</para>
      <para>\( p(4)\) </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.1.3.</para>
    </div>
    </exercise>
  <!--q7-->
  <exercise data-content-id="8fcf5235-6283-48d4-9fc9-ad17a1884704" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="54" data-solution-options="[&quot;95&quot;, &quot;113&quot;, &quot;54&quot;, &quot;-12&quot;]">
    <problem>
      <para>\(d(-3)\) </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.1.3.
      </para>
    </div>
    </exercise>
  <!--q8-->
  <exercise data-content-id="e91603e4-fd35-4283-b26e-1992129584f9" data-problem-comparator="math" data-problem-type="input" data-solution="15x^2-8x-10">
    <problem>
      <para>\(p(x) + d(x)\) </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.1.4.
      </para>
    </div>
    </exercise>
  <!--q9-->
  <exercise data-content-id="3f34a974-1aba-4f60-adcf-6b92b4e3dd79" data-problem-comparator="math" data-problem-type="input" data-solution="9x^2+14x+2">
    <problem>
      <para>\(p(x) - d(x)\) </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.1.4.
      </para>
    </div>
    </exercise>
  <!--q10-->
  <exercise data-content-id="47d347ab-9731-419f-8748-37d9ece502a9" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="143" data-solution-options="[&quot;143&quot;, &quot;311&quot;, &quot;168&quot;, &quot;479&quot;]">
    <problem>
      <para>\( p(5) - d(-6)\) </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.1.4.
      </para>
    </div>
    </exercise>
