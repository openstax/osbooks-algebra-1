<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.1.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01580</md:content-id>
    <md:title>6.1.6: Practice</md:title>
    <md:uuid>39a15d22-c944-4bf1-9086-737db5a436c2</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
<para id="para-00002">For questions 1 - 5, simplify each expression completely.</para>
<!--Do not edit this div tag.  It must surround the interaction block-->
<section id="sect-00002"><exercise id="_31411e4f-7669-41d2-bfa2-4c227dc837f1" class="multiple-choice"><problem id="prob-00001"><para id="para-00003">\(14ab^2-8ab^2\)</para>
      <para id="para-00004">Multiple Choice:</para><para id="para-00005">\(6ab^2\)</para><para id="para-00006">\(22ab^2\)</para><para id="para-00007">\(14ab^2\)</para><para id="para-00008">\(8ab^2\)</para></problem><solution id="sol-00001"><para id="para-00009">Try again. Revisit activity 6.1.2.</para><para id="para-00010">The correct answer is \(6ab^2\).

    </para></solution></exercise>
      
      <exercise id="_1d91d1cd-1f5a-4d42-97b1-f8dca7a4f3ff" class="multiple-choice"><problem id="prob-00002"><para id="para-00011">\((8k^2-3k+14)+(8k+17)\)</para>
      </problem><solution id="sol-00002"><para id="para-00012">Try again. Revisit activity 6.1.2.</para><para id="para-00013">The correct answer is \((8k^2+5k+31)\) .
    </para></solution></exercise>
      
      <exercise id="_0f5a6c3b-f396-4007-bb7e-c4198ff89170" class="multiple-choice"><problem id="prob-00003"><para id="para-00014">\((7b^2-2b-12)-(4b^2+9b-7)\)</para>
      <para id="para-00015">Multiple Choice:</para><para id="para-00016">\(11b^2+7b-19\)</para><para id="para-00017">\(3b^2+7b-19\)</para><para id="para-00018">\(3b^2-11b-5\)</para><para id="para-00019">\(11b^2-11b-5\)</para></problem><solution id="sol-00003"><para id="para-00020">Try again. Revisit activity 6.1.2.
    </para><para id="para-00021">The correct answer is \(3b^2-11b-5\).
    </para></solution></exercise>
      
      <exercise id="c6a07638-4de2-48b5-9d83-141c9a9539fc" class="multiple-choice"><problem id="prob-00004"><para id="para-00022">\( (7mn^3-2m^2n-12mn)-(3mn^3-4mn)\)</para>
      <para id="para-00023">Multiple Choice:</para><para id="para-00024">\(10mn^3-2m^2n-16mn\)</para><para id="para-00025">\(4mn^3-2m^2n-8mn\)</para><para id="para-00026">\(4mn^3-2m^2n-16mn\)</para><para id="para-00027">\(4mn^3-10m^2n\)</para></problem><solution id="sol-00004"><para id="para-00028">Try again. Revisit activity 6.1.2.</para><para id="para-00029">The correct answer is \(4mn^3-2m^2n-8mn\).
    </para></solution></exercise>
      
      <exercise id="c8996f10-bb87-4d70-9349-cf59164cdd90" class="multiple-choice"><problem id="prob-00005"><para id="para-00030">\( (r^3-r^2s)-2(rs^2+s^3)+(r^2s+2rs^2)\)</para>
      <para id="para-00031">Multiple Choice:</para><para id="para-00032">\(r^3+2s^3\)</para><para id="para-00033">\(r^3-rs^2-2s^3\)</para><para id="para-00034">\(r^3-2s^3\)</para><para id="para-00035">\(r^3+rs^2-2s^3\)</para></problem><solution id="sol-00005"><para id="para-00036">Try again. Revisit activity 6.1.2.
    </para><para id="para-00037">The correct answer is \(r^3-2s^3\).
    </para></solution></exercise>
      
      <exercise id="e60fdd8f-2742-4743-8f88-f7a439b07006" class="multiple-choice"><problem id="prob-00006"><para id="para-00038">Use the following polynomial functions to answer questions 6 – 10.</para><para id="para-00039">\(p(x) = 12x^2+3x-4\)</para>
        <para id="para-00040">\(d(x) = 3x^2-11x-6\)</para>
      <para id="para-00041">\( p(4)\)</para>
      <para id="para-00042">Multiple Choice:</para><para id="para-00043">-2</para><para id="para-00044">200</para><para id="para-00045">192</para><para id="para-00046">48</para></problem><solution id="sol-00006"><para id="para-00047">Try again. Revisit activity 6.1.3.</para><para id="para-00048">The correct answer is 200.</para></solution></exercise>
      
      <exercise id="_8fcf5235-6283-48d4-9fc9-ad17a1884704" class="multiple-choice"><problem id="prob-00007"><para id="para-00049">\(d(-3)\)</para>
      <para id="para-00050">Multiple Choice:</para><para id="para-00051">95</para><para id="para-00052">113</para><para id="para-00053">54</para><para id="para-00054">-12</para></problem><solution id="sol-00007"><para id="para-00055">Try again. Revisit activity 6.1.3.
    </para><para id="para-00056">The correct answer is 54.</para></solution></exercise>
      
      <exercise id="e91603e4-fd35-4283-b26e-1992129584f9" class="multiple-choice"><problem id="prob-00008"><para id="para-00057">\(p(x) + d(x)\)</para>
      </problem><solution id="sol-00008"><para id="para-00058">Try again. Revisit activity 6.1.4.
    </para><para id="para-00059">The correct answer is \(15x^2-8x-10\).
    </para></solution></exercise>
      
      <exercise id="_3f34a974-1aba-4f60-adcf-6b92b4e3dd79" class="multiple-choice"><problem id="prob-00009"><para id="para-00060">\(p(x) - d(x)\)</para>
      </problem><solution id="sol-00009"><para id="para-00061">Try again. Revisit activity 6.1.4.
    </para><para id="para-00062">The correct answer is \(9x^2+14x+2\).
    </para></solution></exercise>
      
      <exercise id="_47d347ab-9731-419f-8748-37d9ece502a9" class="multiple-choice"><problem id="prob-00010"><para id="para-00063">\( p(5) - d(-6)\)</para>
      <para id="para-00064">Multiple Choice:</para><para id="para-00065">143</para><para id="para-00066">311</para><para id="para-00067">168</para><para id="para-00068">479</para></problem><solution id="sol-00010"><para id="para-00069">Try again. Revisit activity 6.1.4.
    </para><para id="para-00070">The correct answer is 143.</para></solution></exercise></section></section>
</content>
