<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Determining the Number of Solutions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02123</md:content-id>
    <md:title>Determining the Number of Solutions</md:title>
    <md:uuid>a2f460f9-3e2f-45db-b804-983d9ec4cba6</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>
      <para id="para-00001">How many solutions does each equation have? Be prepared to show your reasoning.</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00001">

          <para id="para-00004">Compare your answer: </para>
          <para id="para-00005">Two solutions</para>
          <para id="para-00006">Both <m:math display="inline"><m:mrow><m:msup><m:mn>3</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math> equal 9.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00007"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00002">

          <para id="para-00009">Compare your answer: </para>
          <para id="para-00010">One solution</para>
          <para id="para-00011">Only <m:math display="inline"><m:mrow><m:msup><m:mn>0</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math> is 0.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00012"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00003">

          <para id="para-00014">Compare your answer: </para>
          <para id="para-00015">Two solutions</para>
          <para id="para-00016">Add 1 to both sides of the equation. Then, both <m:math display="inline"><m:mrow><m:msup><m:mn>2</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math> equal 4.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00017"><m:math><m:mrow><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>50</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00004">

          <para id="para-00019">Compare your answer: </para>
          <para id="para-00020">Two solutions</para>
          <para id="para-00021">Divide both sides of the equation by 2. Then, both <m:math display="inline"><m:mrow><m:msup><m:mn>5</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math> equal 25.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00005">
        <problem id="prob-00005">
          <para id="para-00022"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00005">

          <para id="para-00024">Compare your answer: </para>
          <para id="para-00025">One solution</para>
          <para id="para-00026">Setting each factor equal to zero results in −1 being the only solution.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00006">
        <problem id="prob-00006">
          <para id="para-00027"><m:math><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00006">

          <para id="para-00029">Compare your answer: </para>
          <para id="para-00030">Two solutions</para>
          <para id="para-00031">Setting each factor equal to zero results in 0 and 6 being solutions.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00007">
        <problem id="prob-00007">
          <para id="para-00032"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00007">

          <para id="para-00034">Compare your answer: </para>
          <para id="para-00035">Two solutions</para>
          <para id="para-00036">By trial and error, both 3 and −1 make the equation true.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00008">
        <problem id="prob-00008">
          <para id="para-00037">How are the solutions to questions 2 and 5 different from the other solutions?</para>
        </problem>
        <solution id="sol-00008">
          
          <para id="para-00039">Compare your answer: </para>
          <para id="para-00040">Questions 2 and 5 only have one solution each, while the others have two solutions.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <para id="para-00041">A <term class="glossary-tooltip" id="term-00001">double root</term> is a root that appears twice in the solution of an algebraic equation.</para>
    </section>
  </content>
</document>