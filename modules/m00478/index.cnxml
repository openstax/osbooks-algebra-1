      <!--Interaction
      End -->
      <!--Question
      4 -->
      <exercise>
        <problem>
          <para>Then make 1 – 2 observations about your graphs.</para>
        </problem>
        <solution>
          <para>Compare your answer: Your answer may vary, but here are some samples.</para>
          <list>
            <item>The graphs are two parallel lines that don’t intersect. </item>
            <item>The lines have the same slope but different vertical intercepts.</item>
          </list>
        </solution>
      </exercise>
      <!--Q#5-->
      <exercise>
        <problem>
          <para>How do your observations about the graph of this system relate to the fact that the
            system was determined to not have a solution?</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>Answers will vary.</para>
        </solution>
      </exercise>
