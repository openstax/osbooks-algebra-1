                  <emphasis>Number of characters texted</emphasis>
                </entry>
                <entry>
                  <emphasis>Distance (feet)</emphasis>
                </entry>
                <entry>
                  <emphasis>Number of characters texted</emphasis>
                </entry>
              </row>
            </thead>
            <tbody>
              <row>
                <entry> 105 </entry>
