    <section id="sect-00006">
      <title>Additional Resources</title>

      <section id="sect-00007">
        <title> Correlation Coefficient </title>
        <para id="para-00052">Try matching each scatter plot to one of the following correlation
          coefficients:</para>
        <para id="para-00053"><m:math display="inline">
            <m:mrow>
              <m:mi>r</m:mi>
              <m:mo>=</m:mo>
              <m:mo>–</m:mo>
              <m:mn>0.02</m:mn>
            </m:mrow>
          </m:math>, <m:math display="inline">
            <m:mrow>
              <m:mi>r</m:mi>
              <m:mo>=</m:mo>
              <m:mn>0.84</m:mn>
            </m:mrow>
          </m:math>, <m:math display="inline">
            <m:mrow>
              <m:mi>r</m:mi>
              <m:mo>=</m:mo>
              <m:mo>–</m:mo>
              <m:mn>0.72</m:mn>
            </m:mrow>
          </m:math>, <m:math display="inline">
            <m:mrow>
              <m:mi>r</m:mi>
              <m:mo>=</m:mo>
              <m:mn>0.65</m:mn>
            </m:mrow>
          </m:math></para>
        <media alt="Four scatter plots are labeled A, B, C, D, each with unique data distributions. Plots are on a grid that extend from 0 to 9 on both axes, showing varied clustering.">
          <image mime-type="image/jpeg" src="../../media/Algebra-1_03_06_11_01.jpg"/>
        </media>

        <table class="unnumbered os-raise-doubleheadertable unnumbered" id="table-00003">
          <tgroup cols="2">
            <tbody>
              <row>
                <entry>
                  <emphasis>Scatter plot</emphasis>
                </entry>
                <entry>
                  <emphasis>Correlation coefficient</emphasis>
                </entry>
              </row>
