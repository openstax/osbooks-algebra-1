                </entry>
                <entry>
                  <para id="para-00055"><m:math>
                      <m:mrow>
                        <m:mi>r</m:mi>
                        <m:mo>=</m:mo>
                        <m:mo>–</m:mo>
                        <m:mn>0.72</m:mn>
                      </m:mrow>
                    </m:math></para></entry>
              </row>
              <row>
                <entry>
                  <emphasis>Scatter plot B</emphasis>
                </entry>
                <entry>
                  <para id="para-00056"><m:math>
                      <m:mrow>
                        <m:mi>r</m:mi>
                        <m:mo>=</m:mo>
                        <m:mn>0.84</m:mn>
                      </m:mrow>
                    </m:math></para></entry>
              </row>
              <row>
                <entry>
                  <emphasis>Scatter plot C</emphasis>
                </entry>
                <entry>
                  <para id="para-00057"><m:math>
                      <m:mrow>
                        <m:mi>r</m:mi>
                        <m:mo>=</m:mo>
