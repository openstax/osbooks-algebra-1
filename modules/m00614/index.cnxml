<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.13.5: Graphing Solutions to an Inequality</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00614</md:content-id>
    <md:title>2.13.5: Graphing Solutions to an Inequality</md:title>
    <md:uuid>d65f0b6d-0222-4869-ac1a-bca3ce6c72f1</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001"><title>Cool Down</title>
      <para id="para-00001">For questions 1 – 4, use the following scenario to write, graph, and find solutions to
        inequalities.</para>
      <quote id="quote-00001">A band is playing at an auditorium with floor seats and balcony seats. The band wants
        to sell the floor tickets for $15 each and balcony tickets for $12 each. They want to make
        at least $3,000 in ticket sales.</quote>

      <!--Q#1-->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00003">How much money will they collect for selling <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> floor tickets?</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00004">Compare your answer: </para>
          <para id="para-00005"><m:math><m:mrow><m:mn>15</m:mn><m:mi>x</m:mi></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#2-->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00006">How much money will they collect for selling <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> balcony tickets?</para>

        </problem>
        <solution id="sol-00002">
          <para id="para-00007">Compare your answer: </para>
          <para id="para-00008"><m:math><m:mrow><m:mn>12</m:mn><m:mi>y</m:mi></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#3-->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00009">Write an inequality whose solutions are the number of floor and balcony tickets sold
            if they make at least $3,000 in ticket sales.</para>

        </problem>
        <solution id="sol-00003">
          <para id="para-00010">Compare your answer: </para>
          <para id="para-00011"><m:math><m:mrow><m:mn>15</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>y</m:mi><m:mo>≥</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mspace width="negativethinmathspace"/><m:mn>000</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#4-->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <!--QUESTION
          IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
          <para id="para-00012">Use the graphing tool or technology outside the course. Graph the inequality that
            represents this scenario using the Desmos tool below.</para>
        <media alt="insert alt text">
        <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
        </media>
          <para id="para-00013">Write down your answer, then select the <emphasis>solution</emphasis> button to
            compare your work.</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00014">Compare your answer: </para>
          <para id="para-00015">
            
              <media alt="Graph of an inequality on a coordinate grid.">
                <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_15_12_01.svg"/>
              </media>
            
         </para>
        </solution>
      </exercise>

      <!--Interaction
      End -->
      <!--Q#-->
      <exercise id="exer-00005">
        <problem id="prob-00005">
          <para id="para-00016">Write 3 linear inequalities in two variables given this table of values:</para>
          <table class="unnumbered os-raise-skinnytable unnumbered" id="table-00001">
            <tgroup cols="2" align="center">
<thead>
                <row>
                  <entry>
                    <emphasis><m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math></emphasis>
                  </entry>
                  <entry>
                    <emphasis><m:math><m:mrow><m:mi>y</m:mi></m:mrow></m:math></emphasis>
                  </entry>
                </row>
                </thead>
<<<<<<< HEAD
                <tbody>
=======
              
