                </row>
                <row>
                  <entry>1</entry>
                  <entry>5</entry>
                </row>
                <row>
                  <entry>-2</entry>
                  <entry>3</entry>
                </row>
                <row>
                  <entry>0</entry>
                  <entry>0</entry>
                </row>
              </tbody>
            </tgroup>
          </table>

        </problem>
        <solution id="sol-00005">
          <para id="para-00017">Compare your answer: </para>
          <para id="para-00018">Answers will vary.</para>
        </solution>
      </exercise>
      <!--Interaction
