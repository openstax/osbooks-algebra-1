      <!--Interaction End -->
      <!--Q#5-->
      <exercise id="exer-00004">
        <problem id="prob-00005">
          <para id="para-00015">What is the axis of symmetry?</para>
        </problem>
        <solution id="sol-00005">
          
          <para id="para-00016">Compare your answer:</para>
          <para id="para-00020"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></para></solution>
