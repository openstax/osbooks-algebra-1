  <content>
    <section id="sect-00001">
      <!--Q#1-->
      <example id="exam-00001">
        <exercise>
          <problem id="prob-00001">
            <para id="para-00001"> Write the quadratic function \(f(x)=x^2+6x+13\) in vertex form.</para>
            <para id="para-00002">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00003">Compare your answer:</para>
            <para id="para-00004">\(f(x)=(x+3)^2+4\)</para>
            <para id="para-00005">\((\frac{b}{2})^2=(\frac{6}{2})^2=\frac{36}{4}=9\)
    \(f(x)=x^2+6x+9+13-9\)
    \(f(x)=x^2+6x+9+4\)
    \(f(x)=(x+3)^2+4\)</para>
          </solution>
        </exercise>
      </example>
      <!--Interaction End -->
      <!--Q#2-->
      <exercise>
        <problem id="prob-00002">
          <para id="para-00006"> Using the vertex form of the quadratic found in question 1, what is the vertex?</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00007">Enter your answer here:</para>
          <para id="para-00008">Compare your answer:</para>
          <para id="para-00009">\((-3, 4)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
