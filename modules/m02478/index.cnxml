      <section class="check-understanding">
        <title>Warm Up Activity</title>
        <exercise id="_72cb5b64-be50-496b-83bc-a1ea8b6ccbb0" class="multiple-choice">
          <problem>
            <para> Determine if the vertex for the quadratic function is a maximum or minimum.</para>
          </problem>
          <solution>
            <para>Correct! Minimum</para>
            <para>Nice try! The correct answer is Minimum.</para>
          </solution>
        </exercise>
      </section>
      <!--Q#5-->
      <exercise>
        <problem>
          <para> What is the axis of symmetry?</para>
        </problem>
        <solution>
