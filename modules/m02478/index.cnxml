      <section class="check-understanding" id="sect-00002">
        <title>Warm Up Activity</title>
        <exercise id="_72cb5b64-be50-496b-83bc-a1ea8b6ccbb0" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00013"> Determine if the vertex for the quadratic function is a maximum or minimum.</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00014">Correct! Minimum</para>
            <para id="para-00015">Nice try! The correct answer is Minimum.</para>
          </solution>
