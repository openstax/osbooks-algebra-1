<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.9.1: Finding the Vertex in Vertex Form</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02478</md:content-id>
    <md:title>9.9.1: Finding the Vertex in Vertex Form</md:title>
    <md:uuid>ecbad763-a271-4559-9d72-a403d64ae6f3</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001"><title>Warm Up Activity</title>
      <exercise id="_72cb5b64-be50-496b-83bc-a1ea8b6ccbb0" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00001"> Determine if the vertex for the quadratic function is a maximum or minimum.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00002">Correct! Minimum</para>
          <para id="para-00003">Nice try! The correct answer is Minimum.</para>
        </solution>
      </exercise>
    </section>
    <section id="sect-00002">
      <!--Q#1-->
      <exercise id="exer-00001">
        <problem id="prob-00002">
          <para id="para-00004"> Write the quadratic function <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>13</m:mn></m:mrow></m:math> in vertex form.</para>
          <para id="para-00005">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00006">Compare your answer:</para>
          <para id="para-00007"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00008"><m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mi>b</m:mi></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>6</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>36</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math></para><para id="para-00011"><m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mo>+</m:mo><m:mn>13</m:mn><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math></para><para id="para-00017"><m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00018"><m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#2-->
      <exercise id="exer-00002">
        <problem id="prob-00003">
          <para id="para-00009">Using the vertex form of the quadratic found in question 1, what is the vertex?</para>
        </problem>
        <solution id="sol-00003">
          
          <para id="para-00010">Compare your answer:</para>
          <para id="para-00019"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#-->
      <list class="os-raise-noindent" list-type="enumerated" id="list-00001">
        <item>Graph both equations from question 1 (in standard form and vertex form).</item>
