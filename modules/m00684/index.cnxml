      <entry> 10 </entry>
      <entry/>
    </row>
  </tbody>
</table>

<para><emphasis>Answer:</emphasis> </para>
<table class="os-raise-skinnytable">
  <thead>
    <row>
      <entry><emphasis>number of oranges</emphasis></entry><entry><emphasis>weight in kilograms</emphasis></entry></row>
  </thead>
  <tbody>
    <row>
      <entry> 3 </entry>
      <entry> 1.027 </entry>
    </row>
    <row>
      <entry> 4 </entry>
      <entry> 1.162 </entry>
    </row>
    <row>
      <entry> 5 </entry>
      <entry> 1.502 </entry>
    </row>
    <row>
      <entry> 6 </entry>
      <entry> 1.617 </entry>
    </row>
    <row>
      <entry> 7 </entry>
      <entry> 1.761 </entry>
    </row>
    <row>
      <entry> 8 </entry>
      <entry> 2.115 </entry>
    </row>
    <row>
      <entry> 9 </entry>
      <entry> 2.233 </entry>
    </row>
    <row>
      <entry> 10 </entry>
      <entry> 2.569 </entry>
    </row>
