      <section id="sect-00002">
        <title>Video: Finding a Quadratic Function from Its Zeros and a Point</title>
        <para id="para-00032">Watch the following video to learn more about finding a quadratic function from its zeros and a point.</para>
        <media alt="Placeholder for Alt Text">
          <iframe width="660" height="371.4" src="https://k12.openstax.org/contents/raise/resources/edd0a3e9d4afdfbd30566216317a5425c3ae450b"/>
        </media>
    </section>
    <note class="self-check" id="note-00001">
      <exercise id="exer-00008">
        <problem id="prob-00008">
        <para id="para-00033"><link class="os-embed" url="#exercise/Alg1_8_11_3_SC"/></para>
