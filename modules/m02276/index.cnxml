<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.11.3: Finding a Quadratic Function from Its Zeros and a Point</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02276</md:content-id>
    <md:title>8.11.3: Finding a Quadratic Function from Its Zeros and a Point</md:title>
    <md:uuid>96f67fd3-3d70-4805-9fdd-7359061284e2</md:uuid>
  </metadata>
