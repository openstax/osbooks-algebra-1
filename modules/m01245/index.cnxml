<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.1.5: Simplifying Exponents</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01245</md:content-id>
    <md:title>5.1.5: Simplifying Exponents</md:title>
    <md:uuid>0eae6d9a-ed82-4755-8b05-db0b5882f0e9</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
<para id="para-00001">Complete the table using all of the exponent properties you learned in the lesson.</para>
<exercise id="exer-00001">
  <problem id="prob-00001">
    
    <table class="unnumbered os-raise-textheavytable" id="table-00001">
      <tgroup cols="2"><tbody><row>
          <entry><emphasis>Expression</emphasis></entry><entry><emphasis>Simplified Result</emphasis></entry></row>
          <row>
          <entry>
            <m:math display="inline"><m:mrow><m:msup><m:mi>j</m:mi><m:mn>5</m:mn></m:msup><m:mi>·</m:mi><m:msup><m:mi>j</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math>
          </entry>
          <entry> </entry>
        </row>
        <row>
          <entry>
           <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:msup><m:mi>h</m:mi><m:mn>7</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mi>h</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math>
          </entry>
          <entry> </entry>
        </row>
        <row>
          <entry>
           <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mi>a</m:mi><m:mi>b</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>0</m:mn></m:msup></m:mrow></m:math>
          </entry>
          <entry> </entry>
        </row>
        <row>
          <entry>
            <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:msup><m:mi>s</m:mi><m:mrow><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:msup></m:mrow></m:mfrac></m:mrow></m:math>
          </entry>
          <entry> </entry>
        </row>
        <row>
          <entry>
            <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mi>m</m:mi></m:mrow><m:mrow><m:mi>n</m:mi></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:msup></m:mrow></m:math>
          </entry>
          <entry> </entry>
        </row>
        <row>
          <entry>
           <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:msup><m:mi>p</m:mi><m:mn>5</m:mn></m:msup><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>
          </entry>
          <entry> </entry>
        </row>
        <row>
          <entry>
            <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:msup><m:mi>s</m:mi><m:mn>3</m:mn></m:msup><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mo stretchy="false">)</m:mo><m:mn>3</m:mn></m:msup></m:mrow></m:math>
          </entry>
          <entry> </entry>
        </row>
        <row>
          <entry>
          <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mi>b</m:mi></m:mrow><m:mrow><m:mi>d</m:mi></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:msup></m:mrow></m:math>
          </entry>
          <entry> </entry>
        </row>
      </tbody></tgroup><caption>Exponent Property Review</caption>
      </table>
    
    
  
  <para id="para-00002">Write down your answers. Then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00001">
  <para id="para-00003">Compare your answers:</para>
  
  
  
  <table class="unnumbered os-raise-textheavytable" id="table-00002">
    <tgroup cols="2"><tbody><row>
        <entry><emphasis>Expression</emphasis></entry><entry><emphasis>Simplified Result</emphasis></entry></row>
        <row>
          <entry>
         <m:math display="inline"><m:mrow><m:msup><m:mi>j</m:mi><m:mn>5</m:mn></m:msup><m:mi>·</m:mi><m:msup><m:mi>j</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math>
        </entry>
        <entry>
          <m:math display="inline"><m:mrow><m:msup><m:mi>j</m:mi><m:mn>8</m:mn></m:msup></m:mrow></m:math>
        </entry>
      </row>
      <row>
        <entry>
          <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:msup><m:mi>h</m:mi><m:mn>7</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mi>h</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math>
        </entry>
        <entry>
         <m:math display="inline"><m:mrow><m:msup><m:mi>h</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:math>
        </entry>
      </row>
      <row>
        <entry>
         <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mi>a</m:mi><m:mi>b</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>0</m:mn></m:msup></m:mrow></m:math>
        </entry>
        <entry>
        <m:math display="inline"><m:mrow><m:mn>1</m:mn></m:mrow></m:math>
        </entry>
      </row>
      <row>
        <entry>
          <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:msup><m:mi>s</m:mi><m:mrow><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:msup></m:mrow></m:mfrac></m:mrow></m:math>
        </entry>
        <entry>
         <m:math display="inline"><m:mrow><m:msup><m:mi>s</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:math>
        </entry>
      </row>
      <row>
        <entry>
         <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mi>m</m:mi></m:mrow><m:mrow><m:mi>n</m:mi></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:msup></m:mrow></m:math>
        </entry>
        <entry>
         <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:msup><m:mi>n</m:mi><m:mn>4</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mi>m</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math>
        </entry>
      </row>
      <row>
        <entry>
        <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:msup><m:mi>p</m:mi><m:mn>5</m:mn></m:msup><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>
        </entry>
        <entry>
        <m:math display="inline"><m:mrow><m:msup><m:mi>p</m:mi><m:mrow><m:mn>10</m:mn></m:mrow></m:msup></m:mrow></m:math>
        </entry>
      </row>
      <row>
        <entry>
         <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:msup><m:mi>s</m:mi><m:mn>3</m:mn></m:msup><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mo stretchy="false">)</m:mo><m:mn>3</m:mn></m:msup></m:mrow></m:math>
        </entry>
        <entry>
         <m:math display="inline"><m:mrow><m:msup><m:mn>3</m:mn><m:mn>3</m:mn></m:msup><m:msup><m:mi>s</m:mi><m:mn>9</m:mn></m:msup><m:msup><m:mi>t</m:mi><m:mn>6</m:mn></m:msup><m:mo>=</m:mo><m:mn>27</m:mn><m:msup><m:mi>s</m:mi><m:mn>9</m:mn></m:msup><m:msup><m:mi>t</m:mi><m:mn>6</m:mn></m:msup></m:mrow></m:math>
        </entry>
      </row>
      <row>
        <entry>
          <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mi>b</m:mi></m:mrow><m:mrow><m:mi>d</m:mi></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:msup></m:mrow></m:math>
        </entry>
        <entry>
          <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:msup><m:mi>d</m:mi><m:mn>2</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math>
        </entry>
      </row>
    </tbody></tgroup><caption>Exponent Property Review</caption>
    </table>
  
  

</solution></exercise>
<para id="para-00004">Take some time to review each of the exponential properties you learned in the lesson. Look at each property and be
  sure you know when to use it.</para>

<note id="note-00001">
  <title>Summary of Exponent Properties</title>
  
  <para id="para-00006">If <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math> are real numbers and <m:math display="inline"><m:mrow><m:mi>m</m:mi></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>n</m:mi></m:mrow></m:math> are integers, then</para>
  <table class="unnumbered os-raise-midsizetable" id="table-00003">
    <tgroup cols="2"><tbody><row>
        <entry><emphasis>Property</emphasis></entry><entry><emphasis>Description</emphasis></entry></row>
    <row>
        <entry> Product Property </entry>
        <entry> <m:math display="inline"><m:mrow><m:msup><m:mi>a</m:mi><m:mi>m</m:mi></m:msup><m:mi>·</m:mi><m:msup><m:mi>a</m:mi><m:mi>n</m:mi></m:msup><m:mo>=</m:mo><m:mrow><m:msup><m:mi>a</m:mi><m:mrow><m:mi>m</m:mi><m:mo>+</m:mo><m:mi>n</m:mi></m:mrow></m:msup></m:mrow></m:mrow></m:math> </entry>
      </row>
      <row>
        <entry> Power Property </entry>
        <entry> <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:msup><m:mi>a</m:mi><m:mi>m</m:mi></m:msup><m:msup><m:mo stretchy="false">)</m:mo><m:mi>n</m:mi></m:msup><m:mo>=</m:mo><m:msup><m:mi>a</m:mi><m:mrow><m:mi>m</m:mi><m:mi>·</m:mi><m:mi>n</m:mi></m:mrow></m:msup></m:mrow></m:math> </entry>
      </row>
      <row>
        <entry> Product to a Power </entry>
        <entry> <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mi>b</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mi>m</m:mi></m:msup><m:mo>=</m:mo><m:msup><m:mi>a</m:mi><m:mi>m</m:mi></m:msup><m:msup><m:mi>b</m:mi><m:mi>m</m:mi></m:msup></m:mrow></m:math> </entry>
      </row>
      <row>
        <entry> Quotient Property </entry>
        <entry> <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:msup><m:mi>a</m:mi><m:mi>m</m:mi></m:msup></m:mrow><m:mrow><m:msup><m:mi>a</m:mi><m:mi>n</m:mi></m:msup></m:mrow></m:mfrac><m:mo>=</m:mo><m:msup><m:mi>a</m:mi><m:mrow><m:mi>m</m:mi><m:mi>−</m:mi><m:mi>n</m:mi></m:mrow></m:msup></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn></m:mrow></m:math> </entry>
      </row>
      <row>
        <entry> Zero Exponent Property </entry>
        <entry> <m:math display="inline"><m:mrow><m:msup><m:mi>a</m:mi><m:mn>0</m:mn></m:msup><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn></m:mrow></m:math> </entry>
      </row>
      <row>
        <entry> Quotient to a Power Property </entry>
        <entry> <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mi>a</m:mi></m:mrow><m:mrow><m:mi>b</m:mi></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mi>m</m:mi></m:msup><m:mo>=</m:mo><m:mfrac><m:mrow><m:msup><m:mi>a</m:mi><m:mi>m</m:mi></m:msup></m:mrow><m:mrow><m:msup><m:mi>b</m:mi><m:mi>m</m:mi></m:msup></m:mrow></m:mfrac></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn></m:mrow></m:math> </entry>
      </row>
      <row>
        <entry> Properties of Negative Exponents </entry>
        <entry> <m:math display="inline"><m:mrow><m:msup><m:mi>a</m:mi><m:mrow><m:mi>−</m:mi><m:mi>n</m:mi></m:mrow></m:msup><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:msup><m:mi>a</m:mi><m:mi>n</m:mi></m:msup></m:mrow></m:mfrac></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:msup><m:mi>a</m:mi><m:mrow><m:mi>−</m:mi><m:mi>n</m:mi></m:mrow></m:msup></m:mrow></m:mfrac><m:mo>=</m:mo><m:msup><m:mi>a</m:mi><m:mi>n</m:mi></m:msup></m:mrow></m:math> </entry>
      </row>
      <row>
        <entry> Quotient to a Negative Exponent </entry>
        <entry> <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mi>a</m:mi></m:mrow><m:mrow><m:mi>b</m:mi></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mi>−</m:mi><m:mi>n</m:mi></m:mrow></m:msup><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mi>b</m:mi></m:mrow><m:mrow><m:mi>a</m:mi></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mi>n</m:mi></m:msup></m:mrow></m:math> </entry>
      </row>
    </tbody></tgroup></table>
</note>
</section>
</content>
</document>
