<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.7.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00485</md:content-id>
    <md:title>2.7.5: Practice</md:title>
    <md:uuid>9983b6b2-8c74-4a2c-b5df-900bd0efa8c4</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <para id="para-00002">For questions 1 – 8, solve each system of equations to determine if there is one solution, no solution, or infinitely many solutions.</para>

      <exercise id="_2a17b9ee-0868-435e-9a4f-0dbdd1d9ec7c" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00003"> <m:math display="inline"><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>5</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>3</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mn>7</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>0.6</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mn>1.4</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00004">Correct! infinitely many solutions</para>
          <para id="para-00005">Try again. Revisit activity 2.7.1.</para>
          <para id="para-00006">The correct answer is infinitely many solutions.</para>
        </solution>
      </exercise>
      <exercise id="_664076ff-bb5c-445e-8be2-859452344a5f" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00007"> <m:math display="inline"><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>2</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>1</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>5</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>10</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mn>6</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00008">Correct! no solution</para>
          <para id="para-00009">Try again. Revisit activity 2.7.2 .</para>
          <para id="para-00010">The correct answer is no solutions.</para>
        </solution>
      </exercise>
      <exercise id="e49b74e7-9d0c-459f-bfe4-246f55d48cbe" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00011"> <m:math display="inline"><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>28</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>24</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>8</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00012">Correct! infinitely many solutions</para>
          <para id="para-00013">Try again. Revisit activity 2.7.1.</para>
          <para id="para-00014">The correct answer is infinitely many solutions.</para>
        </solution>
      </exercise>
      <exercise id="_71d06919-7e8f-4cb4-88f2-64dfc9b5aa60" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00015"> <m:math display="inline"><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>0.2</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>0.4</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mn>0.6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>3</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00016">Correct! infinitely many solutions</para>
          <para id="para-00017">Try again. Revisit activity 2.7.1.</para>
          <para id="para-00018">The correct answer is infinitely many solutions.</para>
        </solution>
      </exercise>
      <exercise id="_4db03d63-ee9f-4b64-94af-63c24270bc96" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00019"> <m:math display="inline"><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>0.1</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>0.2</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mn>0.6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>10</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>1</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00020">Correct! no solution</para>
          <para id="para-00021">Try again. Revisit activity 2.7.2.</para>
          <para id="para-00022">The correct answer is infinitely no solution.</para>
        </solution>
      </exercise>
      <exercise id="_750540c7-d146-4947-8f4d-311f1f65f541" class="multiple-choice">
        <problem id="prob-00006">
          <para id="para-00023"> <m:math display="inline"><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>11</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mspace width="0.278em"/><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>9</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00024">Correct! no solution</para>
          <para id="para-00025">Try again. Revisit activity 2.7.2 .</para>
          <para id="para-00026">The correct answer is no solution.</para>
        </solution>
      </exercise>
      <exercise id="c4feb987-f0b2-46ca-8d87-dda6dbc51f6f" class="multiple-choice">
        <problem id="prob-00007">
          <para id="para-00027"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mspace width="0.278em"/><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>1</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00028">Correct! no solution</para>
          <para id="para-00029">Try again. Revisit activity 2.7.2.</para>
          <para id="para-00030">The correct answer is no solution.</para>
        </solution>
      </exercise>
      <exercise id="c5397197-3143-4960-9059-4af843fb916d" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00031"> <m:math display="inline"><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>5</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>15</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00032">Correct! infinitely many solutions</para>
          <para id="para-00033">Try again. Revisit activity 2.7.1 .</para>
          <para id="para-00034">The correct answer is infinitely many solutions.</para>
        </solution>
      </exercise>
      <exercise id="_96189aa5-1253-411f-9357-e39b90990101" class="multiple-choice">
        <problem id="prob-00009">
          <para id="para-00035">Which system of equations has infinitely many solutions?</para>
          <para id="para-00036">Multiple Choice:</para>
          <para id="para-00037"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>4</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>3</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>12</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>8</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>6</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>24</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
          <para id="para-00038"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>4</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>3</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>12</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>8</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>6</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>12</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
          <para id="para-00039"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>3</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>12</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>8</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>6</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mn>24</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
          <para id="para-00040"> <m:math display="inline"><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>3</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>12</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>6</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>24</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00041">Correct! <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>12</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>24</m:mn></m:mrow></m:math></para>
          <para id="para-00042">Try again. Revisit activities 2.7.3 and 2.7.4.</para>
          <para id="para-00043">The correct answer is <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>12</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>24</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_64f15677-6ec4-4a06-b000-22081ca23b7c" class="multiple-choice">
        <problem id="prob-00010">
          <para id="para-00044">Multiple choice:</para>
          <para id="para-00045">Which system of equations has no solution?</para>
          <para id="para-00046">Multiple Choice:</para>
          <para id="para-00047"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>15</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>40</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
          <para id="para-00048"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>15</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>14</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>30</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
          <para id="para-00049"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>7</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>15</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>40</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
          <para id="para-00050"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>21</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>270</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>90</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00051">Correct! <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>15</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>40</m:mn></m:mrow></m:math></para>
          <para id="para-00052">Try again. Revisit activities 2.7.3 and 2.7.4 .</para>
          <para id="para-00053">The correct answer is <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>15</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>40</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
    </section>
  </content>
