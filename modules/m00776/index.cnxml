              </row>
              <row>
                <entry><m:math><m:mrow><m:mo>−</m:mo><m:mn>0.3</m:mn><m:mo>&lt;</m:mo><m:mi>r</m:mi><m:mo>&lt;</m:mo><m:mn>0</m:mn></m:mrow></m:math></entry>
                <entry>There is a weak negative linear relationship.</entry>
              </row>
              <row>
                <entry><m:math><m:mrow><m:mo>−</m:mo><m:mn>0.7</m:mn><m:mo>&lt;</m:mo><m:mi>r</m:mi><m:mo>≤</m:mo><m:mo>−</m:mo><m:mn>0.3</m:mn></m:mrow></m:math></entry>
                <entry>There is a moderate negative linear relationship.</entry>
              </row>
              <row>
                <entry><m:math><m:mrow><m:mo>−</m:mo><m:mn>1.0</m:mn><m:mo>&lt;</m:mo><m:mi>r</m:mi><m:mo>≤</m:mo><m:mo>−</m:mo><m:mn>0.7</m:mn></m:mrow></m:math></entry>
                <entry>There is a strong negative linear relationship.</entry>
              </row>
              <row>
                <entry><m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1.0</m:mn></m:mrow></m:math></entry>
                <entry>There is a perfect negative linear relationship.</entry>
              </row>
            </tbody>
          </tgroup>
        </table>

