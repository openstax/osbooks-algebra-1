        <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->
        <!--Q#-->

        <exercise id="exer-00007">
          <problem id="prob-00007">
            <para id="para-00030">What is the correlation coefficient for this data and what does it tell us about
              the strength and type of relationship represented?</para>
            <para id="para-00031">Write down your answer, then select the <emphasis>solution</emphasis> button to
              compare your work.</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00032">Compare your answer: Your answer many vary, but here is a sample.</para>
            <para id="para-00033"> The correlation coefficient is <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mi>≈</m:mi><m:mn>0.44</m:mn></m:mrow></m:math>. By the table, this indicates a
              moderate, positive linear relationship between fat content and calories.</para>
          </solution>
        </exercise>
        </note>

