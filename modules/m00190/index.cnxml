<!--Q7-->
<exercise>
  <problem>
    <para>How many minutes, \(m\), have passed when Tank A contains \(p\) liters of water?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(\frac{p-124}{9}\)</para>
  </solution></exercise>
<!--Interaction End -->

<para>For questions 8 – 14, use the following scenario:</para>
<para>Tank B, which initially contained 80 liters of water, is being drained at a rate of 2.5 liters per minute.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="4c38cb85-4cdb-45f0-a96a-4c928525c945" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q8-->
  <exercise data-content-id="b69ebe38-b909-4b91-a2be-57d87cd67ce9" data-problem-comparator="floatt" data-problem-type="input" data-solution="78.75">
    <problem>
      <para>How many liters of water are in Tank B after 30 seconds?</para>
      <para>Enter your answer here.</para>
    </problem>
    <solution>
      <para>Correct! 78.75</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
