<!--Q10-->
<exercise>
  <problem>
    <para>How many liters of water are in Tank B after \(t\) minutes?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(80 -2.5t\)</para>
  </solution></exercise>
<!--Interaction End -->

<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="369e7511-fc66-496f-92ca-f8b3ff5c04ec" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q11-->
  <exercise data-content-id="faf4b7e6-5040-40d6-acb4-8942ac268566" data-problem-comparator="floatt" data-problem-type="input" data-solution="2">
    <problem>
      <para>For how many minutes, \(t\), has the water been draining when Tank B contains 75 liters of water?</para>
      <para>Enter your answer here.</para>
    </problem>
    <solution>
      <para>Correct! 2</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Q12-->
