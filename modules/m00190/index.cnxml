<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.8.3: Writing Equations and Isolating Variables</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00190</md:content-id>
    <md:title>1.8.3: Writing Equations and Isolating Variables</md:title>
