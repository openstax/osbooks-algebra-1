  <section><title>Activity</title>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="4a860393-f63f-482f-b072-7e2462e92598" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1-->
  <exercise data-content-id="02cd7ec6-2c93-4a63-8c84-579687fa77e9" data-problem-comparator="integer" data-problem-type="input" data-solution="160">
    <problem>
      <para>Use the following scenario for questions 1 – 7:</para>
      <para>
        Tank A initially contained 124 liters of water. It is then filled with more water, at a constant rate of 9 liters per minute.
      </para>
      <para>
          How many liters of water are in Tank A after 4 minutes?
        </para>
      <para>Enter your answer here.</para>
    </problem>
    <solution>
      <para>Correct! 160</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Q1-->
  <exercise data-content-id="7cca0ed8-6958-4125-a692-7aefdee8e06b" data-problem-comparator="integer" data-problem-type="input" data-solution="136">
    <problem>
      <para>How many liters of water are in Tank A after 80 seconds?</para>
      <para>Enter your answer here.</para>
    </problem>
    <solution>
      <para>Correct! 136</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
