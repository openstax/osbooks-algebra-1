  <content>
  <section><section class="check-understanding"><title>Activity</title><exercise data-content-id="02cd7ec6-2c93-4a63-8c84-579687fa77e9" class="multiple-choice"><problem><para>Use the following scenario for questions 1 – 7:</para><para>
        Tank A initially contained 124 liters of water. It is then filled with more water, at a constant rate of 9 liters per minute.
      </para>
      <para>
          How many liters of water are in Tank A after 4 minutes?
        </para>
      <para>Enter your answer here.</para>
    </problem><solution><para>Correct! 160</para><para>Nice try! The correct answer is 160</para></solution></exercise><exercise data-content-id="7cca0ed8-6958-4125-a692-7aefdee8e06b" class="multiple-choice"><problem><para>Enter your answer here.</para><para>How many liters of water are in Tank A after 80 seconds?</para>
      </problem><solution><para>Correct! 136</para><para>Nice try! The correct answer is 136</para></solution></exercise></section><!--Q3-->
<exercise>
  <problem>
    <para>How many liters of water are in Tank A after 4 minutes?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
  <para>Compare your answer:</para>
    
    <para>\(124+9m\)</para>
  
  </solution></exercise>
<!--Interaction End -->

<section class="check-understanding"><exercise data-content-id="64f729a2-90bb-4753-9f2c-0cbf4faf3a14" class="multiple-choice"><problem><para>Enter your answer here.</para><para>How many minutes, \(m\), have passed when Tank A contains 151 liters of water?</para>
      </problem><solution><para>Correct! 3</para><para>Nice try! The correct answer is 3</para></solution></exercise><exercise data-content-id="58431f0d-4e03-4eab-83d6-6a8fba7eebfb" class="multiple-choice"><problem><para>Enter your answer here.</para><para>How many minutes, \(m\), have passed when Tank A contains 191.5 liters of water?</para>
      </problem><solution><para>Correct! 7.5</para><para>Nice try! The correct answer is 7.5</para></solution></exercise><exercise data-content-id="18a4e338-8371-4387-8b0b-404af3e07d5d" class="multiple-choice"><problem><para>Enter your answer here.</para><para>How many minutes, \(m\), have passed when Tank A contains 270.25 liters of water?</para>
      </problem><solution><para>Correct! 16.25</para><para>Nice try! The correct answer is 16.25</para></solution></exercise></section><!--Q7-->
<exercise>
  <problem>
    <para>How many minutes, \(m\), have passed when Tank A contains \(p\) liters of water?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
  <para>Compare your answer:</para>
    
    <para>\(\frac{p-124}{9}\)</para>
  
  </solution></exercise>
<!--Interaction End -->

<para>For questions 8 – 14, use the following scenario:</para>
<para>Tank B, which initially contained 80 liters of water, is being drained at a rate of 2.5 liters per minute.</para>
<section class="check-understanding"><exercise data-content-id="b69ebe38-b909-4b91-a2be-57d87cd67ce9" class="multiple-choice"><problem><para>Enter your answer here.</para><para>How many liters of water are in Tank B after 30 seconds?</para>
      </problem><solution><para>Correct! 78.75</para><para>Nice try! The correct answer is 78.75</para></solution></exercise><exercise data-content-id="c8613b4f-ce83-4e05-afbe-280478f7b8ac" class="multiple-choice"><problem><para>Enter your answer here.</para><para>How many liters of water are in Tank B after 7 minutes?</para>
      </problem><solution><para>Correct! 62.5</para><para>Nice try! The correct answer is 62.5</para></solution></exercise></section><!--Q10-->
<exercise>
  <problem>
    <para>How many liters of water are in Tank B after \(t\) minutes?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
  <para>Compare your answer:</para>
    
    <para>\(80 -2.5t\)</para>
  
  </solution></exercise>
<!--Interaction End -->

<section class="check-understanding"><exercise data-content-id="faf4b7e6-5040-40d6-acb4-8942ac268566" class="multiple-choice"><problem><para>Enter your answer here.</para><para>For how many minutes, \(t\), has the water been draining when Tank B contains 75 liters of water?</para>
      </problem><solution><para>Correct! 2</para><para>Nice try! The correct answer is 2</para></solution></exercise><exercise data-content-id="5a22dfc4-28bd-4658-86b9-60e3bb15bc01" class="multiple-choice"><problem><para>Enter your answer here.</para><para>For how many minutes, \(t\), has the water been draining when Tank B contains 32.5 liters of water?</para>
      </problem><solution><para>Correct! 19</para><para>Nice try! The correct answer is 19</para></solution></exercise><exercise data-content-id="4b4843d7-b07d-4bb1-ab87-dd68b284af61" class="multiple-choice"><problem><para>Enter your answer here.</para><para>For how many minutes, \(t\), has the water been draining when Tank B contains 18 liters of water?</para>
      </problem><solution><para>Correct! 24.8</para><para>Nice try! The correct answer is 24.8</para></solution></exercise></section><!--Q14-->
<exercise>
  <problem>
    <para>For how many minutes, \(t\), has the water been draining when Tank B contains v liters of water?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
  <para>Compare your answer:</para>
    
    <para>\(\frac{80-v}{2.5}\)</para>
  
  </solution></exercise>
<!--Interaction End -->

