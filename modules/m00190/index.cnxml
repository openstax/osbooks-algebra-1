<!--Q3-->
<exercise>
  <problem>
    <para>How many liters of water are in Tank A after 4 minutes?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(124+9m\)</para>
  </solution></exercise>
<!--Interaction End -->

<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="d9506767-0a91-417c-8816-6e9d4b8243f9" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q4-->
