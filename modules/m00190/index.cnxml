      End -->

        <exercise id="faf4b7e6-5040-40d6-acb4-8942ac268566" class="multiple-choice">
          <problem>
            <para>For how many minutes, \(t\), has the water been draining when Tank B contains 75
              liters of water?</para>
              
          </problem>
          <solution>
            <para>Correct! 2</para>
            <para>Nice try! The correct answer is 2</para>
          </solution>
        </exercise>
        <exercise id="_5a22dfc4-28bd-4658-86b9-60e3bb15bc01" class="multiple-choice">
          <problem>
            <para>For how many minutes, \(t\), has the water been draining when Tank B contains 32.5
              liters of water?</para>
              
          </problem>
          <solution>
            <para>Correct! 19</para>
            <para>Nice try! The correct answer is 19</para>
          </solution>
        </exercise>
        <exercise id="_4b4843d7-b07d-4bb1-ab87-dd68b284af61" class="multiple-choice">
          <problem>
            <para>For how many minutes, \(t\), has the water been draining when Tank B contains 18
              liters of water?</para>
              
          </problem>
          <solution>
            <para>Correct! 24.8</para>
            <para>Nice try! The correct answer is 24.8</para>
          </solution>
        </exercise>
<!--Q14-->
      <exercise>
        <problem>
          <para>For how many minutes, \(t\), has the water been draining when Tank B contains v
            liters of water?</para>
            
          </problem>
        <solution>



          <para>Compare your answer:</para>

          <para>\(\frac{80-v}{2.5}\)</para>

        </solution>
      </exercise>
