  <content>
    <section>
        <title>Activity</title>
        <para>Use the following scenario for questions 1 – 7:</para>
            <para> Tank A initially contained 124 liters of water. It is then filled with more
              water, at a constant rate of 9 liters per minute.</para>
        <exercise id="_02cd7ec6-2c93-4a63-8c84-579687fa77e9" class="multiple-choice">
          <problem>
            <para> How many liters of water are in Tank A after 4 minutes?</para>
            
          </problem>
          <solution>
            <para>Correct! 160</para>
            <para>Nice try! The correct answer is 160</para>
          </solution>
        </exercise>
        <exercise id="_7cca0ed8-6958-4125-a692-7aefdee8e06b" class="multiple-choice">
          <problem>
            <para>How many liters of water are in Tank A after 80 seconds?</para>
            
          </problem>
          <solution>
            <para>Correct! 136</para>
            <para>Nice try! The correct answer is 136</para>
          </solution>
        </exercise>
<!--Q3-->
      <exercise>
        <problem>
          <para>How many liters of water are in Tank A after 4 minutes?</para>
          
        </problem>
        <solution>

          <para>Compare your answer:</para>

          <para>\(124+9m\)</para>

        </solution>
      </exercise>
      <!--Interaction
      End -->

        <exercise id="_64f729a2-90bb-4753-9f2c-0cbf4faf3a14" class="multiple-choice">
          <problem>
            <para>How many minutes, \(m\), have passed when Tank A contains 151 liters of water?</para>
            
          </problem>
          <solution>
            <para>Correct! 3</para>
            <para>Nice try! The correct answer is 3</para>
          </solution>
        </exercise>
        <exercise id="_58431f0d-4e03-4eab-83d6-6a8fba7eebfb" class="multiple-choice">
          <problem>
            <para>How many minutes, \(m\), have passed when Tank A contains 191.5 liters of water?</para>
            
          </problem>
          <solution>
            <para>Correct! 7.5</para>
            <para>Nice try! The correct answer is 7.5</para>
          </solution>
        </exercise>
        <exercise id="_18a4e338-8371-4387-8b0b-404af3e07d5d" class="multiple-choice">
          <problem>
            <para>How many minutes, \(m\), have passed when Tank A contains 270.25 liters of water?</para>
            
          </problem>
          <solution>
            <para>Correct! 16.25</para>
            <para>Nice try! The correct answer is 16.25</para>
          </solution>
        </exercise>
     <!--Q7-->
      <exercise>
        <problem>
          <para>How many minutes, \(m\), have passed when Tank A contains \(p\) liters of water?</para>
          
        </problem>
        <solution>



          <para>Compare your answer:</para>

          <para>\(\frac{p-124}{9}\)</para>

        </solution>
      </exercise>
      <!--Interaction
      End -->

      <para>For questions 8 – 14, use the following scenario:</para>
      <para>Tank B, which initially contained 80 liters of water, is being drained at a rate of 2.5
        liters per minute.</para>

        <exercise id="b69ebe38-b909-4b91-a2be-57d87cd67ce9" class="multiple-choice">
          <problem>
            <para>How many liters of water are in Tank B after 30 seconds?</para>
                      
          </problem>
          <solution>
            <para>Correct! 78.75</para>
            <para>Nice try! The correct answer is 78.75</para>
          </solution>
        </exercise>
        <exercise id="c8613b4f-ce83-4e05-afbe-280478f7b8ac" class="multiple-choice">
          <problem>
            <para>How many liters of water are in Tank B after 7 minutes?</para>
            
          </problem>
          <solution>
            <para>Correct! 62.5</para>
            <para>Nice try! The correct answer is 62.5</para>
          </solution>
        </exercise>
  <!--Q10-->
      <exercise>
        <problem>
          <para>How many liters of water are in Tank B after \(t\) minutes?</para>
          
        </problem>
        <solution>


          <para>Compare your answer:</para>

          <para>\(80 -2.5t\)</para>

        </solution>
      </exercise>
