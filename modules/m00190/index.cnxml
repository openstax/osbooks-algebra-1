      <para>How many minutes, \(m\), have passed when Tank A contains 151 liters of water?</para>
      <para>Enter your answer here.</para>
    </problem>
    <solution>
      <para>Correct! 3</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
