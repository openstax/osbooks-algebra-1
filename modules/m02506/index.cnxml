<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="bc51e486-051f-42a8-8f63-f27be4e0babc" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1a-->
  <exercise data-content-id="17d649c9-6290-4ffb-bae6-8fdcdd52431d" data-problem-comparator="integer" data-problem-type="input" data-solution="2">
    <problem>
      <para>What is the \(x\)-coordinate of the <term data-schema-version="1.0" data-store="glossary-tooltip">vertex (of a graph)</term> representing function \(b\)?</para>
      <para>Enter the \(x\)-coordinate of the vertex. </para>
    </problem>
    <solution>
      <para>Correct! The \(x\)-coordinate of the vertex is 2.</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  
  <!--Q1b-->
  <exercise data-content-id="59187891-7e0c-42db-8bb2-dfc257a013db" data-problem-comparator="integer" data-problem-type="input" data-solution="-9">
    <problem>
      <para>What is the \(y\)-coordinate of the vertex of the graph representing function \(b\)?</para>
      <para>Enter the \(y\)-coordinate of the vertex. </para>
    </problem>
    <solution>
      <para>Correct! The \(y\)-coordinate of the vertex is -9.</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
