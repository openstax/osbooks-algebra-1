  <content>
    <section id="sect-00001">
      <para id="para-00001">Complete the table with the length, width, and area of each rectangle. Two dimensions are entered in the table.</para>
      <para id="para-00002"> 
          <media alt="Figures A through F.">
            <image mime-type="image/svg+xml" src="../../media/Algebra-1_07_11_02_01.svg"/>
          </media>
        
    </para>
