            <entry>
             <emphasis> Length (units)</emphasis>
            </entry>
            <entry>
             <emphasis> Width (units)</emphasis> 
            </entry>
            <entry>
             <emphasis> Area (square units)</emphasis> 
            </entry>
          </row>
        <row>
