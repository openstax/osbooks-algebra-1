<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.4.3: Standard Form and Squared Factors</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02391</md:content-id>
    <md:title>9.4.3: Standard Form and Squared Factors</md:title>
    <md:uuid>fcd97ae3-a609-4ad7-a227-209688de7ed2</md:uuid>
  </metadata>
  <content>
  <section><title>Activity</title>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="41b811f4-624a-4070-994b-49eb1c83b55d" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1a-->
  <exercise data-content-id="97d0b972-5ed8-4a24-9dff-c3012234f97b" data-problem-comparator="integer" data-problem-type="input" data-solution="16">
    <problem>
      <para>For each expression, find the value of \(c\) to make a perfect square in standard form.</para>
      <para>\(100x^2+80x+c\)</para>
      <para>Enter the value of \(c\). </para>
    </problem>
    <solution>
      <para>Correct! 16. Standard form: \(100x^2+80x+16\).</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1b-->
  <exercise data-content-id="9f6e72ef-9827-4c3d-81d0-1e19f8a05bfb" data-problem-comparator="integer" data-problem-type="input" data-solution="25">
    <problem>
      <para>\(36x^2−60x+c\)</para>
      <para>Enter the value of \(c\). </para>
    </problem>
    <solution>
      <para>Correct! 25. Standard form: \(36x^2−60x+25\).</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1c-->
  <exercise data-content-id="05257978-50a0-491b-8cc8-8e0b3c904423" data-problem-comparator="integer" data-problem-type="input" data-solution="16">
    <problem>
      <para>\(25x^2+40x+c\)</para>
      <para>Enter the value of \(c\). </para>
    </problem>
    <solution>
      <para>Correct! 16. Standard form: \(25x^2+40x+16\).</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1d-->
  <exercise data-content-id="66181411-a044-470f-8072-fa681f155500" data-problem-comparator="integer" data-problem-type="input" data-solution="196">
    <problem>
      <para>\(0.25x^2−14x+c\)</para>
      <para>Enter the value of \(c\). </para>
    </problem>
    <solution>
      <para>Correct! 196. Standard form: \(0.25x^2−14x+196\).</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>
<list class="os-raise-noindent" start="2" type="enumerated">
  <item>For each expression, refer to your responses in question 1 to help write an equivalent expression in the form of squared <term data-schema-version="1.0" data-store="glossary-tooltip">factors</term>.</item>
</list>
<example><exercise>
  <problem>
    
    <para>\(100x^2+80x+c\)</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\((10x+4)^2\)</para>
</solution></exercise>
</example><example><exercise>
  <problem>
    
    <para>\(36x^2−60x+c\)</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\((6x-5)^2\)</para>
</solution></exercise>
</example><example><exercise>
  <problem>
    
    <para>\(25x^2+40x+c\)</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\((5x+4)^2\)</para>
</solution></exercise>
</example><example><exercise>
  <problem>
    
    <para>\(0.25x^2−14x+c\)</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\((0.5x-14)^2\)</para>
</solution></exercise>
</example><example><exercise>
  <problem>
    
    <para>Write your own pair of equivalent expressions.</para>
    <para>Create an expression that is a perfect square trinomial in standard form \((ax^2+bx+c)\).</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>Answers will vary. One expression in standard form is: \(49x^2+14x+1\).</para>
</solution></exercise>
</example><example><exercise>
  <problem>
    
    <para>Now write the same equivalent expression in the form of squared factors \((kx+m)^2\).</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>Answers will vary. Using the expression above, for example, the squared factor of \(49x^2+14x+1\) would be \((7x+1)^2\).</para>
</solution></exercise>
</example><example><exercise>
  <problem>
    
    <para>Solve each equation by completing the square.</para>
    <para>\(25x^2+40x=-12\)</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\(\begin{aligned} 25 x^{2}+40 x &amp;=-12 \\ 25 x^{2}+40 x+12 &amp;=0 \\ 25 x^{2}+40 x+12+4 &amp;=4 \\ 25 x^{2}+40 x+16 &amp;=4 \\ (5 x+4)^{2} &amp;=4 \\ \sqrt{(5 x+4)^{2}} &amp;=\sqrt{4} \\ 5 x+4 &amp;=2 \\ 5 x+4 &amp;=-2 \\ 5 x &amp;=-2 \\ 5 x &amp;=-6 \\ \\ x=-\frac{2}{5} &amp; \text { and } x=-\frac{6}{5} \end{aligned} \)</para>
</solution></exercise>
</example><example><exercise>
  <problem>
    
    <para>\(36x^2−60x+10=-6\)</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\(\begin{aligned} 36 x^{2}-60 x+10 &amp;=-6 \\ 36 x^{2}-60 x+10+15 &amp;=-6+15 \\ 36 x^{2}-60 x+25 &amp;=9 \\ (6 x-5)^{2} &amp;=9 \\ \sqrt{(6 x-5)^{2}} &amp;=\sqrt{9} \\ 6 x-5 &amp;=3 \\ 6 x-5 &amp;=-3 \\ 6 x &amp;=8 \\ 6 x &amp;=2 \\ \\ x=\frac{8}{6}=\frac{4}{3} &amp; \text { and } x=\frac{2}{6}=\frac{1}{3} \end{aligned}\)</para>
</solution></exercise>
</example></section>
</content>
