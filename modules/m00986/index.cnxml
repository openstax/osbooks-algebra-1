<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.8.3: Self Check</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00986</md:content-id>
    <md:title>4.8.3: Self Check</md:title>
    <md:uuid>c646042e-ddaa-484f-9e56-b83fb86b7681</md:uuid>
  </metadata>
  <content>
  <section><para dir="ltr">Brooke was racing bikes with a friend on the way to the park. A table of her distance traveled over time is shown.</para>
<table class="os-raise-midsizetable">
  <caption>Brooke</caption>
  <thead>
    <row>
      <entry scope="col" class="emphasis">Time (minutes)</entry>
      <entry scope="col" class="emphasis">Distance (miles)</entry>
    </row>
  </thead>
  <tbody>
    <row>
      <entry>
        0
      </entry>
      <entry>
        0
      </entry>
    </row>
    <row>
      <entry>
        5
      </entry>
      <entry>
        1.2
      </entry>
    </row>
    <row>
      <entry>
        10
      </entry>
      <entry>
        2.4
      </entry>
    </row>
    <row>
      <entry>
        15
      </entry>
      <entry>
        3.6
      </entry>
    </row>
    <row>
      <entry>
        20
      </entry>
      <entry>
        4.8
      </entry>
    </row>
    <row>
      <entry>
        25
      </entry>
      <entry>
        6.0
      </entry>
    </row>
  </tbody>
</table>
<para>What was Brooke’s average rate of change between 5 minutes and 20 minutes? </para></section>
</content>
</document>
