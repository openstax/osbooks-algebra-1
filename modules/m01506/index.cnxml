</div>
<para>Use the given information for problems 4 – 6. Technology is required. Function \(f\) is defined by \(f(x)=3x+5\),
  and function \(g\) is defined by \(g(x)=(1.1)^x\).</para>
<table class="os-raise-doubleheadertable">
  <thead>
    <row>
      <entry scope="col" class="emphasis">
      </entry>
      <entry scope="col" class="emphasis">
        \(f(x)\)
      </entry>
      <entry scope="col" class="emphasis">
        \(g(x)\)
      </entry>
    </row>
  </thead>
  <tbody>
    <row>
      <entry scope="row" class="emphasis">
        1
      </entry>
      <entry/>
      <entry/>
    </row>
    <row>
      <entry scope="row" class="emphasis">
        5
      </entry>
      <entry/>
      <entry/>
    </row>
    <row>
      <entry scope="row" class="emphasis">
        10
      </entry>
      <entry/>
      <entry/>
    </row>
    <row>
      <entry scope="row" class="emphasis">
        20
      </entry>
      <entry/>
      <entry/>
    </row>
  </tbody>
</table>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="00c876a5-4442-4118-9794-2a6211681fca" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--Q4-->
  <exercise data-content-id="04eb6bed-b602-46eb-95d3-8bcd36a15239" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="8, 20, 35, 65" data-solution-options="[&quot;8, 11, 14, 17&quot;, &quot;8, 20, 35, 65&quot;, &quot;3, 15, 30, 60&quot;, &quot;8, 15, 30, 60&quot;]">
    <problem>
      <para>Which values will complete the table for \(f(x)\)?</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 5.14.2.</para>
    </div>
    </exercise>
  <!--Q5-->
  <exercise data-content-id="f8c05a03-2554-4d04-9263-88fb53e061e5" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="1.1, 1.6, 2.59, 6.73" data-solution-options="[&quot;8, 20, 35, 65&quot;, &quot;1.1, 5.5, 10.10, 20.20&quot;, &quot;1.1, 1.6, 2.59, 6.73&quot;, &quot;1.1, 1.21, 1.33, 1.46&quot;]">
    <problem>
      <para>Which of the following sets of values will complete the table for \(g(x)\)? </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.14.2. 
      </para>
    </div>
    </exercise>
  <!--q6a-->
  <exercise data-content-id="02e97ed5-02f5-4a77-affa-d83b7b8287f2" data-problem-type="dropdown" data-retry-limit="2" data-solution="f(x)" data-solution-options="[&quot;f(x)&quot;, &quot;g(x)&quot;, &quot;neither&quot;]">
    <problem>
      <para>
          <para>________ is a linear function.</para>
          </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 5.14.3.</para>
    </div>
    </exercise>
  <!--q6b-->
  <exercise data-content-id="e02206a3-611d-4186-b1af-4a9fffd02411" data-problem-type="dropdown" data-retry-limit="2" data-solution="g(x)" data-solution-options="[&quot;f(x)&quot;, &quot;g(x)&quot;, &quot;neither&quot;]">
    <problem>
      <para>________ is an exponential function.</para>
        </problem>
    <solution>
