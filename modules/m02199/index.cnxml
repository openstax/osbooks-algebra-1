      <exercise id="exer-00009">
        <problem id="prob-00009">
          <para><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>99</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>100</m:mn></m:mrow></m:math></para></problem>
