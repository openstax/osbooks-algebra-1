      <para id="para-00080">For problems 6 – 9, write each expression in factored form. Note that the leading coefficient for each expression is 1.</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00006">
        <problem id="prob-00006">
          <para><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>25</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>100</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00006">
          <para id="para-00082">Enter the expression in factored form.</para>
          <para id="para-00083">Compare your answer:</para>
          <para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>20</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00007">
        <problem id="prob-00007">
          <para><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>15</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>100</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00007">
          <para id="para-00086">Enter the expression in factored form.</para>
          <para id="para-00087">Compare your answer:</para>
          <para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>20</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
