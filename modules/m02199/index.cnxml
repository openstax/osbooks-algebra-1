  <content>
  <section><title>Activity </title>
<para>For questions 1 - 2, consider the expression \(x^2 + bx + 100\). (Note the leading coefficient is 1.)</para>
<example><exercise>
  <problem>
    
    <para>Create a table with all pairs of factors of +100 that would give positive values of \(b\).</para>
    <para>For each pair, state the \(b\) value they produce. (Use as many rows as needed.)</para>
    <table class="os-raise-midsizetable">
      <thead>
        <row>
          <entry scope="col" class="emphasis">
            Factor 1
          </entry>
          <entry scope="col" class="emphasis">
            Factor 2
          </entry>
          <entry scope="col" class="emphasis">
            \(b\) (positive)
          </entry>
        </row>
      </thead>
      <tbody>
        <row>
          <entry> </entry>
          <entry> </entry>
          <entry> </entry>
        </row>
        <row>
          <entry> </entry>
          <entry> </entry>
          <entry> </entry>
        </row>
        <row>
          <entry> </entry>
          <entry> </entry>
          <entry> </entry>
        </row>
        <row>
          <entry> </entry>
          <entry> </entry>
          <entry> </entry>
        </row>
        <row>
          <entry> </entry>
          <entry> </entry>
          <entry> </entry>
        </row>
      </tbody>
    </table>
    
  <para>Write down your answers, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answers:</para>
  <table class="os-raise-midsizetable">
    <thead>
      <row>
        <entry scope="col" class="emphasis">
          Factor 1
        </entry>
        <entry scope="col" class="emphasis">
          Factor 2
        </entry>
        <entry scope="col" class="emphasis">
          \(b\) (positive)
        </entry>
      </row>
    </thead>
    <tbody>
      <row>
        <entry>
          <para>10</para>
        </entry>
        <entry>
          <para>10</para>
        </entry>
        <entry>
          <para>20</para>
        </entry>
      </row>
      <row>
        <entry>
          <para>20</para>
        </entry>
        <entry>
          <para>5</para>
        </entry>
        <entry>
          <para>25</para>
        </entry>
      </row>
      <row>
        <entry>
          <para>25</para>
        </entry>
        <entry>
          <para>4</para>
        </entry>
        <entry>
          <para>29</para>
        </entry>
      </row>
      <row>
        <entry>
          <para>50</para>
        </entry>
        <entry>
          <para>2</para>
        </entry>
        <entry>
          <para>52</para>
        </entry>
      </row>
      <row>
        <entry>
          <para>100</para>
        </entry>
        <entry>
          <para>1</para>
        </entry>
        <entry>
          <para>101</para>
        </entry>
      </row>
    </tbody>
  </table>
</solution></exercise>
</example>
