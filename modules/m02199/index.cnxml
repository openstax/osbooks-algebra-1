          <para>50</para>
        </entry>
        <entry>
          <para>2</para>
        </entry>
        <entry>
          <para>52</para>
        </entry>
      </row>
      <row>
        <entry>
          <para>100</para>
        </entry>
        <entry>
          <para>1</para>
        </entry>
        <entry>
          <para>101</para>
        </entry>
      </row>
    </tbody></tgroup></table>

</solution></exercise>

