<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.2.3: Multiplying a Polynomial by a Polynomial</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01595</md:content-id>
    <md:title>6.2.3: Multiplying a Polynomial by a Polynomial</md:title>
    <md:uuid>726c954c-b57a-4f1b-93f7-d05ffdb39a5f</md:uuid>
  </metadata>
  <content>
  <section><title>Activity</title>
<para>For questions 1 - 5, match each polynomial expression to its simplified solution. Be prepared to explain or show your work.</para>
<!-- BEGIN ACTIVITY DROP DOWN 1 TRY -->
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="f1d65059-30c2-4765-8e76-8c64043bb1be" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q#1-->
  <exercise data-content-id="99fecd6c-c3ad-440d-b80f-2c9a69d3347f" data-problem-type="dropdown" data-solution="𝑐³+4𝑐²+9𝑐+6" data-solution-options="[&quot;𝑐³+5𝑐²−48𝑐+20&quot;, &quot;𝑐³+4𝑐²+9𝑐+6&quot;, &quot;𝑐³+7𝑐²+6𝑐−20&quot;, &quot;𝑐³−5𝑐²−5𝑐−6&quot;, &quot;𝑐³−7𝑐²+11𝑐+3&quot;]">
    <problem>
      <para>\((c+1)(c^2+3c+6)\) </para>
      </problem>
    <solution>
      <para>Correct! \(c^3+4c^2+9c+6\).</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#2-->
  <exercise data-content-id="7bbd5af4-51cd-455d-bfb0-e04c0e8a09ba" data-problem-type="dropdown" data-solution="𝑐³−5𝑐²−5𝑐−6" data-solution-options="[&quot;𝑐³+5𝑐²−48𝑐+20&quot;, &quot;𝑐³+4𝑐²+9𝑐+6&quot;, &quot;𝑐³+7𝑐²+6𝑐−20&quot;, &quot;𝑐³−5𝑐²−5𝑐−6&quot;, &quot;𝑐³−7𝑐²+11𝑐+3&quot;]">
    <problem>
      <para> \((c-6)(c^2+c+1) \) </para>
      </problem>
    <solution>
      <para>Correct! \(c^3-5c^2-5c-6\).</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#3-->
  <exercise data-content-id="df45d4b3-d0a6-4846-a345-016c629d5648" data-problem-type="dropdown" data-solution="𝑐³+7𝑐²+6𝑐−20" data-solution-options="[&quot;𝑐³+5𝑐²−48𝑐+20&quot;, &quot;𝑐³+4𝑐²+9𝑐+6&quot;, &quot;𝑐³+7𝑐²+6𝑐−20&quot;, &quot;𝑐³−5𝑐²−5𝑐−6&quot;, &quot;𝑐³−7𝑐²+11𝑐+3&quot;]">
    <problem>
      <para> \((c+5)(c^2+2c-4)\) </para>
      </problem>
    <solution>
      <para>Correct! \(c^3+7c^2+6c-20\).</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#4-->
  <exercise data-content-id="5d853b17-d067-438b-a037-032f6c8202b1" data-problem-type="dropdown" data-solution="𝑐⁴−4c³−4c²+12c+3" data-solution-options="[&quot;𝑐⁴−4c³−4c²+12c+3&quot;, &quot;𝑐⁴−c³−4c²+7c−3&quot;, &quot;c⁴−c³−2c²+12c+3&quot;, &quot;c⁴−7c³−2c²+7c+3&quot;]">
    <problem>
      <para>\((c^2-3)(c^2-4c-1)\)</para>
      </problem>
    <solution>
      <para>Correct! \(c^4-4c^3−4c^2+12c+3 \).</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#5-->
  <exercise data-content-id="45acc9f0-2233-4fa7-87d7-3c233b5c49f3" data-problem-type="dropdown" data-solution="c4²−5c³+8c²−50c+20" data-solution-options="[&quot;2c4²−5c³+12c²−15c+20&quot;, &quot;c4²−5c³+8c²−50c+20&quot;, &quot;c4²−5c³−8c²−50c+20&quot;, &quot;2c4²−5c³−8c²−15c+12&quot;]">
    <problem>
      <para>\((c^2+10)(c^2-5c+2)\) </para>
      </problem>
    <solution>
      <para>Correct! \(c^4-5c^3+8c^2-50c+20\).</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
