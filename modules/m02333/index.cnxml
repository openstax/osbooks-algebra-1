<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.1.2: Recognizing Structure in Perfect-Square Expressions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02333</md:content-id>
    <md:title>9.1.2: Recognizing Structure in Perfect-Square Expressions</md:title>
    <md:uuid>6d790f8d-e20d-4980-8513-ac9d225c61c1</md:uuid>
  </metadata>
  <content>
  <section><title>Activity</title>
<list class="os-raise-noindent" type="enumerated">
  <item>Each expression is written as the product of factors. Write an equivalent expression in standard form.</item>
</list>
<example><exercise>
  <problem>
    
    <para> \((3x)^2\) </para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\(9x^2\)</para>
</solution></exercise>
</example>
<example><exercise>
  <problem>
    
    <para> \(7x \cdot 7x\) </para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para> \(49x^2\)</para>
</solution></exercise>
</example>
<example><exercise>
  <problem>
    
    <para> \((x+4)(x+4)\) </para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para> \(x^2+8x+16\)</para>
</solution></exercise>
</example>
<example><exercise>
  <problem>
    
    <para> \((x+1)^2\) </para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\(x^2+2x+1\)</para>
</solution></exercise>
</example>
<example><exercise>
  <problem>
    
    <para> \((x−7)^2\) </para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\(x^2−14x+49\)</para>
</solution></exercise>
</example>
<example><exercise>
  <problem>
    
    <para> \((x+n)^2\) </para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\(x^2+2nx+n^2\)</para>
</solution></exercise>
</example>
<list class="os-raise-noindent" start="2" type="enumerated">
  <item>Why do you think the following expressions can be described as <term data-schema-version="1.0" data-store="glossary-tooltip">perfect square</term>s?</item>
</list>
<example><exercise>
  <problem>
    
    <para>\(x^2+6x+9\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;x^2−16x+64\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;x^2+ \frac {1}{3}x+ \frac {1}{36}\)</para>
  <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>If these expressions are written in factored form, each one is the square of a linear expression:</para>
  <para>\((x+3)^2\), \((x−8)^2\), and \((x+\frac {1}{6})^2\).</para>
</solution></exercise>
</example>
<!-- "Start "Are you Ready for More? click to reveal.  If you have more than one on a page, you will need to change the Data-fire/data-wait-for-events for each set.-->
<example><exercise>
  <problem>
    
    <!-- INSERT ANY VALID HTML HERE -->
  <!-- INSERT ANY VALID HTML HERE -->
  </problem></exercise>
</example><!--Start interaction.  If multiple interactions appear under "are you ready for more?, they should all have matching "data-wait-for-event", which should also match the "data-fire-event" for the button. Note in this sample, they are all RFM1-->
<example><exercise data-content-id="98bb2177-78bd-418f-8bce-0281b92105e1">
  <problem>
    
    <title>Extending Your Thinking</title>
    <para>Write each expression in factored form.</para>
    <para>\(x^4 - 30x^2 + 225\)</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\((x^2 - 15)^2\)</para>
</solution></exercise>
</example><!-- End CTA block -->

<example><exercise data-content-id="98f46003-e34f-4b77-8941-de4c32937d47">
  <problem>
    
    <para>\(x + 14\sqrt{x} + 49\)</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\((\sqrt{x} + 7)^2\)</para>
</solution></exercise>
</example>
<!-- End CTA block -->

<example><exercise data-content-id="37387496-60e5-4afe-95cc-4ab2cfee8365">
  <problem>
    
    <para>\(5^{2x} + 6 \cdot 5^x + 9\)</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\((5^x + 3)^2\)</para>
</solution></exercise>
</example>
<!-- End CTA block -->
<example><exercise data-content-id="98bb2177-78bd-418f-8bce-0281b92105e1">
  <problem>
    
    <title>Extending Your Thinking</title>
    <para>Write each expression in factored form.</para>
    <para>\(x^4 - 30x^2 + 225\)</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\((x^2 - 15)^2\)</para>
</solution></exercise>
</example>
<!-- End CTA block -->

<example><exercise data-content-id="98f46003-e34f-4b77-8941-de4c32937d47">
  <problem>
    
    <para>\(x + 14\sqrt{x} + 49\)</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\((\sqrt{x} + 7)^2\)</para>
</solution></exercise>
</example><!-- End CTA block -->

<example><exercise data-content-id="37387496-60e5-4afe-95cc-4ab2cfee8365">
  <problem>
    
    <para>\(5^{2x} + 6 \cdot 5^x + 9\)</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\((5^x + 3)^2\)</para>
</solution></exercise>
</example><!-- End CTA block -->
</section>
