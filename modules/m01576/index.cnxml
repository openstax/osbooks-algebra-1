<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.1.4: Adding and Subtracting Polynomial Functions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01576</md:content-id>
    <md:title>6.1.4: Adding and Subtracting Polynomial Functions</md:title>
