  <content>
  <section><title>Activity</title>
<para>Write the following terms and definitions in your math notebook:</para>
<para>A <term class="glossary-tooltip">geometric sequence</term> is a sequence in which each term is found by multiplying the previous term by the same constant.
</para>
<para>The number that is multiplied by each term is called the <term class="glossary-tooltip">common ratio</term>.</para>
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>
        Complete each geometric sequence.
      </para>
      <para>
          1.5, 3, 6, _a__, 24, _b__
        </para>
      </problem><solution>
    
    <para>Enter your answer for blank “a” here:
    </para>
  
  <para>Compare your answer:</para>
    
    <para>12</para>
  
  </solution></exercise>
<!--Interaction End -->

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
  </problem><solution>
    
    <para>Enter your answer for blank “b” here:</para>
  
  <para>Compare your answer:</para>
    
    <para>48</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
