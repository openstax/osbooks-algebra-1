        <problem id="prob-00001">
          <para id="para-00004"> Complete each geometric sequence. </para>
          <para id="para-00005"> 1.5, 3, 6, _a__, 24, _b__ </para>
        </problem>
        <solution id="sol-00001">

          <para id="para-00006">Enter your answer for blank “a” here: </para>

