<title>Try It: Using Standard Form</title>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="a1ebc9ca-aa64-498c-a390-478908c2b099" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q#1-->
  <exercise data-content-id="0f1de370-c230-4ff2-aaad-89d86d1320f2" data-problem-comparator="integer" data-problem-type="input" data-solution="5">
    <problem>
      <para>Find the slope for \( 5x - y =15 \). 
        </para>
      <para>Enter your answer here.</para>
    </problem>
    <solution>
      <para>Correct! 5</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Q#2-->
  <exercise data-content-id="03b195b3-dccf-4316-b25e-ef90e22b0d8e" data-problem-comparator="float" data-problem-type="input" data-solution="-15">
    <problem>
      <para>Find the \(y\)-intercept for \( 5x - y =15 \). 
        </para>
      <para>Enter your answer here.</para>
    </problem>
    <solution>
      <para>Correct! -15</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
