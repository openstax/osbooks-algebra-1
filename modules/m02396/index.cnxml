  <!--6a-->
  <exercise data-content-id="646f9b6b-4d47-4645-8ba1-973246df0c71" data-problem-comparator="integer" data-problem-type="input" data-solution="1">
    <problem>
      <para>For each expression, find the value of \(c\) to make a perfect square in standard form \((ax^2+bx+c)\).</para>
      <para>\(4x^2+4x+c\)
          <para> Enter the value of \(c\).</para>
        </para>
      </problem>
    <solution>
      <para>Correct! \(4x^2+4x+1\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.4.3.</para>
    </div>
    </exercise>
  <!--6b-->
  <exercise data-content-id="9cbbc656-1839-4d22-9351-0148dd6af177" data-problem-comparator="integer" data-problem-type="input" data-solution="9">
    <problem>
      <para>\(25x^2-30x+c\)
          <para> Enter the value of \(c\).</para>
        </para>
      </problem>
    <solution>
      <para>Correct! \(25x^2−30x+9\) </para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
