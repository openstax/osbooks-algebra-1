                  <para id="para-00075"> <m:math display="inline"><m:mrow><m:mn>49</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>28</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi></m:mrow></m:math></para>
