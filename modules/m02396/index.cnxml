  <exercise data-content-id="47a081a1-7b99-457b-ae6b-1aac8dbf22ba" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((11x+3)^2\)" data-solution-options="[&quot;\\((11x+3)^2\\)&quot;, &quot;\\((121x-9)^2\\)&quot;, &quot;\\((3x-3)^2\\)&quot;,&quot;\\((11x-3)^2\\)&quot; ]">
