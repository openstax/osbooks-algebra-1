            <exercise id="_646f9b6b-4d47-4645-8ba1-973246df0c71" class="multiple-choice">
               <problem id="prob-00021">
                  <para id="para-00141">For each expression, find the value of <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math> to make a perfect square in standard form <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>b</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
                  <para id="para-00142"><m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi></m:mrow></m:math></para>
                  <para id="para-00143">Enter the value of <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math>.</para>
               </problem>
               <solution id="sol-00021">
                  <para id="para-00144">Correct! <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
                  <para id="para-00145">Try again. Revisit activity 9.4.3.</para>
                  <para id="para-00146">The correct answer is 1. <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_9cbbc656-1839-4d22-9351-0148dd6af177" class="multiple-choice">
               <problem id="prob-00022">
                  <para id="para-00147"><m:math><m:mrow><m:mn>25</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>30</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi></m:mrow></m:math></para>
                  <para id="para-00148">Enter the value of <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math>.</para>
               </problem>
               <solution id="sol-00022">
                  <para id="para-00149">Correct! <m:math display="inline"><m:mrow><m:mn>25</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>30</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
                  <para id="para-00150">Try again. Revisit activity 9.4.3.</para>
                  <para id="para-00151">The correct answer is 9. <m:math display="inline"><m:mrow><m:mn>25</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>30</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math> .</para>
               </solution>
            </exercise>
            <exercise id="_5f115dc3-9078-43ec-96cb-a75ade162d8e" class="multiple-choice">
               <problem id="prob-00023">
                  <para id="para-00152">Use the value of <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math> needed to make the expression a perfect square (from the previous question). Then, solve each equation.</para>
                  <para id="para-00153"><m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para>
                  <para id="para-00154">Multiple Choice:</para>
                  <para id="para-00155"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
                  <para id="para-00156"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
                  <para id="para-00157"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
                  <para id="para-00158"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
                  <para id="para-00159"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
                  <para id="para-00160"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math></para>
               </problem>
               <solution id="sol-00023">
                  <para id="para-00161">Correct! <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
                  <para id="para-00162">Try again. Revisit activities 9.4.3 – 9.4.5.</para>
                  <para id="para-00163">The correct answer is: <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_02ccc131-0826-45b1-9c8f-15eb1f7ae2c9" class="multiple-choice">
               <problem id="prob-00024">
                  <para id="para-00164"><m:math><m:mrow><m:mn>25</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>30</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para>
                  <para id="para-00165">Multiple Choice:</para>
                  <para id="para-00166"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
                  <para id="para-00167"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
                  <para id="para-00168"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
                  <para id="para-00169"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
                  <para id="para-00170"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
                  <para id="para-00171"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
               </problem>
               <solution id="sol-00024">
                  <para id="para-00172">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
                  <para id="para-00173">Try again. Revisit activities 9.4.3 – 9.4.5.</para>
                  <para id="para-00174">The correct answer is: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math>.</para>
               </solution>
            </exercise>
         </section>
   </content>
