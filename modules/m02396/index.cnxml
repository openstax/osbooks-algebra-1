  <exercise data-content-id="4130d641-f12b-4805-8167-6c38b3e23a93" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((3x+7)^2\)" data-solution-options="[&quot;\\((3x+7)^2\\)&quot;, &quot;\\((9x-21)^2\\)&quot;, &quot;\\((3x-7)^2\\)&quot;, &quot;\\((9x+3)^2\\)&quot;]">
