   <content>
      <section class="practice" id="sect-00001">
         <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
            <exercise id="_8cb61b91-f898-4326-a943-82a15a7e45cf" class="multiple-choice">
               <problem id="prob-00001">
                  <para id="para-00002"><emphasis>Select three</emphasis> expressions that are perfect squares.</para>
               </problem>
               <solution id="sol-00001">
                  <para id="para-00003">Correct! \(9x^2+24x+16\), \((7-3x)^2\), \((1-2x)(-2x+1)\)</para>
                  <para id="para-00004">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00005">The correct answers are: \(9x^2+24x+16\), \((7-3x)^2\), \((1-2x)(-2x+1)\).</para>
               </solution>
            </exercise>
            <exercise id="_90cd1566-01f1-4ae5-869d-6ae4f7672f8e" class="multiple-choice">
               <problem id="prob-00002">
                  <para id="para-00006">Find the missing number that makes the expression a perfect square.</para>
                  <para id="para-00007">\(49x^2-\_\_\_\_\_\_x+16\)</para>
                  <para id="para-00008">Enter the missing number</para>
               </problem>
               <solution id="sol-00002">
                  <para id="para-00009">Correct! \(49x^2−56x+16\)</para>
                  <para id="para-00010">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00011">The correct answer is 56. \(49x^2−56x+16\).</para>
               </solution>
            </exercise>
            <exercise id="_5ea07411-6348-4906-95df-e7ae55167a0c" class="multiple-choice">
               <problem id="prob-00003">
                  <para id="para-00012">\(36x^2+\_\_\_\_\_\_x+4\)</para>
                  <para id="para-00013">Enter the missing number.</para>
               </problem>
               <solution id="sol-00003">
                  <para id="para-00014">Correct! \(36x^2+24x+4\)</para>
                  <para id="para-00015">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00016">The correct answer is 24. \(36x^2+24x+4\).</para>
               </solution>
            </exercise>
            <exercise id="_43a1355d-8fcf-463e-80df-1c6958cb6228" class="multiple-choice">
               <problem id="prob-00004">
                  <para id="para-00017">\(4x^2-\_\_\_\_\_\_x+25\)</para>
                  <para id="para-00018">Enter the missing number.</para>
               </problem>
               <solution id="sol-00004">
                  <para id="para-00019">Correct! \(4x^2−20x+25\)</para>
                  <para id="para-00020">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00021">The correct answer is 20. \(4x^2−20x+25\).</para>
               </solution>
            </exercise>
            <exercise id="_41350ad7-d9ba-47e7-a761-ade2a2fdeedf" class="multiple-choice">
               <problem id="prob-00005">
                  <para id="para-00022">\(9x^2+\_\_\_\_\_\_x+9\)</para>
                  <para id="para-00023">Enter the missing number.</para>
               </problem>
               <solution id="sol-00005">
                  <para id="para-00024">Correct! \(9x^2+18x+9\)</para>
                  <para id="para-00025">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00026">The correct answer is 18. \(9x^2+18x+9\).</para>
               </solution>
            </exercise>
            <exercise id="dbbde4b2-9b7d-44f3-b2e8-f427a5464c70" class="multiple-choice">
               <problem id="prob-00006">
                  <para id="para-00027">\(121x^2+\_\_\_\_\_\_x+9\)</para>
                  <para id="para-00028">Enter the missing number.</para>
               </problem>
               <solution id="sol-00006">
                  <para id="para-00029">Correct! \(121x^2+66x+9\)</para>
                  <para id="para-00030">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00031">The correct answer is 66. \(121x^2+66x+9\).</para>
               </solution>
            </exercise>
            <exercise id="bb7a6593-60a3-4aa1-946a-bb11e82f2fe7" class="multiple-choice">
               <problem id="prob-00007">
                  <para id="para-00032"> Choose the completely factored form of the expression.</para>
                  <para id="para-00033">\(49x^2-56x+16\)</para>
                  <para id="para-00034">Multiple Choice:</para>
                  <para id="para-00035">\((7x+4)^2\)</para>
                  <para id="para-00036">\((49x-16)^2\)</para>
                  <para id="para-00037">\((7x-4)^2\)</para>
                  <para id="para-00038">\((28x-11)^2\)</para>
               </problem>
               <solution id="sol-00007">
                  <para id="para-00039">Correct! \((7x-4)^2\)</para>
                  <para id="para-00040">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00041">The correct answer is: \((7x-4)^2\).</para>
               </solution>
            </exercise>
            <exercise id="f5a6787e-5e5a-4596-a765-05d0ddd12951" class="multiple-choice">
               <problem id="prob-00008">
                  <para id="para-00042">\(36x^2+24x+4\)</para>
                  <para id="para-00043">Multiple Choice:</para>
                  <para id="para-00044">\((6x-2)^2\)</para>
                  <para id="para-00045">\((36x+4)^2\)</para>
                  <para id="para-00046">\((6x+2)^2\)</para>
                  <para id="para-00047">\(4(3x+1)^2\)</para>
               </problem>
               <solution id="sol-00008">
                  <para id="para-00048">Correct! \(4(3x+1)^2\)</para>
                  <para id="para-00049">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00050">The correct answer is: \(4(3x+1)^2\).</para>
               </solution>
            </exercise>
            <exercise id="_2a0b4c94-e582-4c27-9243-e427297fef83" class="multiple-choice">
               <problem id="prob-00009">
                  <para id="para-00051">\(4x^2-20x+25\)</para>
                  <para id="para-00052">Multiple Choice:</para>
                  <para id="para-00053">(\(10x+7)^2\)</para>
                  <para id="para-00054">\((2x-5)^2\)</para>
                  <para id="para-00055">\((4x-25)^2\)</para>
                  <para id="para-00056">\((2x+5)^2\)</para>
               </problem>
               <solution id="sol-00009">
                  <para id="para-00057">Correct! \((2x-5)^2\)</para>
                  <para id="para-00058">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00059">The correct answer is: \((2x-5)^2\).</para>
               </solution>
            </exercise>
            <exercise id="_47a081a1-7b99-457b-ae6b-1aac8dbf22ba" class="multiple-choice">
               <problem id="prob-00010">
                  <para id="para-00060">\(121x^2+66x+9\)</para>
                  <para id="para-00061">Multiple Choice:</para>
                  <para id="para-00062">\((11x+3)^2\)</para>
                  <para id="para-00063">\((121x-9)^2\)</para>
                  <para id="para-00064">\((3x-3)^2\)</para>
                  <para id="para-00065">\((11x-3)^2\)</para>
               </problem>
               <solution id="sol-00010">
                  <para id="para-00066">Correct! \((11x+3)^2\)</para>
                  <para id="para-00067">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00068">The correct answer is: \((11x+3)^2\).</para>
               </solution>
            </exercise>
            <exercise id="a5d43333-fc76-4205-ba6c-38de749d4f55" class="multiple-choice">
               <problem id="prob-00011">
                  <para id="para-00069">Find the missing number that makes the expression a perfect square.</para>
                  <para id="para-00070">\(9x^2+42x+\_\_\_\_\_\)</para>
                  <para id="para-00071">Enter the missing number.</para>
               </problem>
               <solution id="sol-00011">
                  <para id="para-00072">Correct! \(9x^2+42x+49\)</para>
                  <para id="para-00073">Try again. Revisit activity 9.4.3.</para>
                  <para id="para-00074">The correct answer is 49. \(9x^2+42x+49)\.</para>
               </solution>
            </exercise>
            <exercise id="_2bb17e4e-fb1e-45a6-87ac-e8182620fa2e" class="multiple-choice">
               <problem id="prob-00012">
                  <para id="para-00075"> \(49x^2-28x+\_\_\_\_\_\)</para>
                  <para id="para-00076">Enter the missing number.</para>
               </problem>
               <solution id="sol-00012">
                  <para id="para-00077">Correct! \(49x^2-28x+4\)</para>
                  <para id="para-00078">Try again. Revisit activity 9.4.3.</para>
                  <para id="para-00079">The correct answer is 4. \(49x^2-28x+4\).</para>
               </solution>
            </exercise>
            <exercise id="bb643eb6-5cbe-42bd-8c88-4195f7ffe5b5" class="multiple-choice">
               <problem id="prob-00013">
                  <para id="para-00080">\(25x^2+110x+\_\_\_\_\_\)</para>
                  <para id="para-00081">Enter the missing number.</para>
               </problem>
               <solution id="sol-00013">
                  <para id="para-00082">Correct! \(25x^2+110x+121\)</para>
                  <para id="para-00083">Try again. Revisit activity 9.4.3.</para>
                  <para id="para-00084">The correct answer is 121. \(25x^2+110x+121\).</para>
               </solution>
            </exercise>
            <exercise id="_94ad2467-b43a-44ae-a6f1-9004b90c96fe" class="multiple-choice">
               <problem id="prob-00014">
                  <para id="para-00085">\(64x^2-144x+\_\_\_\_\_\)</para>
                  <para id="para-00086">Enter the missing number.</para>
               </problem>
               <solution id="sol-00014">
                  <para id="para-00087">Correct! \(64x^2-144x+81\)</para>
                  <para id="para-00088">Try again. Revisit activity 9.4.3.</para>
                  <para id="para-00089">The correct answer is 81. \(64x^2-144x+81\).</para>
               </solution>
            </exercise>
            <exercise id="c0fcba19-49c5-4e46-8f68-bca31c8a2a84" class="multiple-choice">
               <problem id="prob-00015">
                  <para id="para-00090">\(4x^2+24x+\_\_\_\_\_\)</para>
                  <para id="para-00091">Enter the missing number.</para>
               </problem>
               <solution id="sol-00015">
                  <para id="para-00092">Correct! \(4x^2+24x+36\)</para>
                  <para id="para-00093">Try again. Revisit activity 9.4.3.</para>
                  <para id="para-00094">The correct answer is 36. \(4x^2+24x+36\).</para>
               </solution>
            </exercise>
            <exercise id="_4130d641-f12b-4805-8167-6c38b3e23a93" class="multiple-choice">
               <problem id="prob-00016">
                  <para id="para-00095">Based on your responses in question 4 above, choose the factored form of the expression.</para>
                  <para id="para-00096">\(9x^2+42x+\_\_\_\_\_\)</para>
                  <para id="para-00097">Multiple Choice:</para>
                  <para id="para-00098">\((3x+7)^2\)</para>
                  <para id="para-00099">\((9x-21)^2\)</para>
                  <para id="para-00100">\((3x-7)^2\)</para>
                  <para id="para-00101">\((9x+3)^2\)</para>
               </problem>
               <solution id="sol-00016">
                  <para id="para-00102">Correct! \((3x+7)^2\)</para>
                  <para id="para-00103">Try again. Revisit activity 9.4.3.</para>
                  <para id="para-00104">The correct answer is: \((3x+7)^2\).</para>
               </solution>
            </exercise>
            <exercise id="_61886b43-e74d-4a1f-94ec-397886fad3c0" class="multiple-choice">
               <problem id="prob-00017">
                  <para id="para-00105">\(49x^2-28x+\_\_\_\_\_\)</para>
                  <para id="para-00106">Multiple Choice:</para>
                  <para id="para-00107">\((4x+7)^2\)</para>
                  <para id="para-00108">\((7x+2)^2\)</para>
                  <para id="para-00109">\((7x-2)^2\)</para>
                  <para id="para-00110">\((7x+7)^2\)</para>
               </problem>
               <solution id="sol-00017">
                  <para id="para-00111">Correct! \((7x-2)^2\)</para>
                  <para id="para-00112">Try again. Revisit activity 9.4.3.</para>
                  <para id="para-00113">The correct answer is: \((7x-2)^2\).</para>
               </solution>
            </exercise>
            <exercise id="_912afd57-5fcc-4819-8456-ba63574d40f3" class="multiple-choice">
               <problem id="prob-00018">
                  <para id="para-00114">\(25x^2+110x+\_\_\_\_\_\)</para>
                  <para id="para-00115">Multiple Choice:</para>
                  <para id="para-00116">\((5x-11)^2\)</para>
                  <para id="para-00117">\((11x+5)^2\)</para>
                  <para id="para-00118">\((11x-5)^2\)</para>
                  <para id="para-00119">\((5x+11)^2\)</para>
               </problem>
               <solution id="sol-00018">
                  <para id="para-00120">Correct! \((5x+11)^2\)</para>
                  <para id="para-00121">Try again. Revisit activity 9.4.3.</para>
                  <para id="para-00122">The correct answer is: \((5x+11)^2\).</para>
               </solution>
            </exercise>
            <exercise id="_36112b04-a847-4368-9589-fd637f961558" class="multiple-choice">
               <problem id="prob-00019">
                  <para id="para-00123">\(64x^2-144x+\_\_\_\_\_\)</para>
                  <para id="para-00124">Multiple Choice:</para>
                  <para id="para-00125">\((72x-17)^2\)</para>
                  <para id="para-00126">\((8x-9)^2\)</para>
                  <para id="para-00127">\((64x-9)^2\)</para>
                  <para id="para-00128">\((8x+9)^2\)</para>
               </problem>
               <solution id="sol-00019">
                  <para id="para-00129">Correct! \((8x-9)^2\)</para>
                  <para id="para-00130">Try again. Revisit activity 9.4.3.</para>
                  <para id="para-00131">The correct answer is: \((8x-9)^2\).</para>
               </solution>
            </exercise>
            <exercise id="_0104e28c-b9ff-4c13-a368-c57767dcad9f" class="multiple-choice">
               <problem id="prob-00020">
                  <para id="para-00132">\(4x^2+24x+\_\_\_\_\_\)</para>
                  <para id="para-00133">Multiple Choice:</para>
                  <para id="para-00134">\((2x-6)^2\)</para>
                  <para id="para-00135">\((4x-26)^2\)</para>
                  <para id="para-00136">\((2x+6)^2\)</para>
                  <para id="para-00137">\((x+6)^2\)</para>
               </problem>
               <solution id="sol-00020">
                  <para id="para-00138">Correct! \((2x+6)^2\)</para>
                  <para id="para-00139">Try again. Revisit activity 9.4.3.</para>
                  <para id="para-00140"> The correct answer is: \((2x+6)^2\).</para>
               </solution>
            </exercise>
            <exercise id="_646f9b6b-4d47-4645-8ba1-973246df0c71" class="multiple-choice">
               <problem id="prob-00021">
                  <para id="para-00141">For each expression, find the value of \(c\) to make a perfect square in standard form \((ax^2+bx+c)\).</para>
                  <para id="para-00142">\(4x^2+4x+c\)</para>
                  <para id="para-00143">Enter the value of \(c\).</para>
               </problem>
               <solution id="sol-00021">
                  <para id="para-00144">Correct! \(4x^2+4x+1\)</para>
                  <para id="para-00145">Try again. Revisit activity 9.4.3.</para>
                  <para id="para-00146">The correct answer is 1. \(4x^2+4x+1\).</para>
               </solution>
            </exercise>
            <exercise id="_9cbbc656-1839-4d22-9351-0148dd6af177" class="multiple-choice">
               <problem id="prob-00022">
                  <para id="para-00147">\(25x^2-30x+c\)</para>
                  <para id="para-00148">Enter the value of \(c\).</para>
               </problem>
               <solution id="sol-00022">
                  <para id="para-00149">Correct! \(25x^2−30x+9\)</para>
                  <para id="para-00150">Try again. Revisit activity 9.4.3.</para>
                  <para id="para-00151">The correct answer is 9. \(25x^2−30x+9\) .</para>
               </solution>
            </exercise>
            <exercise id="_5f115dc3-9078-43ec-96cb-a75ade162d8e" class="multiple-choice">
               <problem id="prob-00023">
                  <para id="para-00152">Use the value of \(c\) needed to make the expression a perfect square (from the previous question). Then, solve each equation.</para>
                  <para id="para-00153">\(4x^2+4x+c=0\)</para>
                  <para id="para-00154">Multiple Choice:</para>
                  <para id="para-00155">\(x=\frac12\)</para>
                  <para id="para-00156">\(x=-\frac12\)</para>
                  <para id="para-00157">\(x=\frac32\)</para>
                  <para id="para-00158">\(x=-\frac32\)</para>
                  <para id="para-00159">\(x=2\)</para>
                  <para id="para-00160">\(x=\frac16\)</para>
               </problem>
               <solution id="sol-00023">
                  <para id="para-00161">Correct! \(-\frac12\)</para>
                  <para id="para-00162">Try again. Revisit activities 9.4.3 – 9.4.5.</para>
                  <para id="para-00163">The correct answer is: \(-\frac12\).</para>
               </solution>
            </exercise>
            <exercise id="_02ccc131-0826-45b1-9c8f-15eb1f7ae2c9" class="multiple-choice">
               <problem id="prob-00024">
                  <para id="para-00164">\(25x^2-30x+c=0\)</para>
                  <para id="para-00165">Multiple Choice:</para>
                  <para id="para-00166">\(x=\frac12\)</para>
                  <para id="para-00167">\(x=-\frac45\)</para>
                  <para id="para-00168">\(x=\frac25\)</para>
                  <para id="para-00169">\(x = 4\)</para>
                  <para id="para-00170">\(x = 5\)</para>
                  <para id="para-00171">\(x=\frac35\)</para>
               </problem>
               <solution id="sol-00024">
                  <para id="para-00172">Correct! \(x=\frac35\)</para>
                  <para id="para-00173">Try again. Revisit activities 9.4.3 – 9.4.5.</para>
                  <para id="para-00174">The correct answer is: \(x=\frac35\).</para>
               </solution>
            </exercise>
         </section>
