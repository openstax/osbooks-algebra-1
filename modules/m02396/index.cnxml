    </exercise>
  <!--3c-->
  <exercise data-content-id="2a0b4c94-e582-4c27-9243-e427297fef83" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((2x-5)^2\)" data-solution-options="[&quot;(\\(10x+7)^2\\)&quot;, &quot;\\((2x-5)^2\\)&quot;, &quot;\\((4x-25)^2\\)&quot;, &quot;\\((2x+5)^2\\)&quot;]">
