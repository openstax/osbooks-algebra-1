  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="5aabc73c-cbbc-40b5-81e7-0b88e65c5310" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--1-->
  <exercise data-content-id="8cb61b91-f898-4326-a943-82a15a7e45cf" data-problem-type="multiselect" data-solution="[&quot;\\(9x^2+24x+16\\)&quot;, &quot;\\((7-3x)^2\\)&quot;, &quot;\\((1-2x)(-2x+1)\\)&quot;]" data-solution-options="[&quot;\\(9x^2+24x+16\\)&quot;, &quot;\\(2x^2+20x+100\\)&quot;, &quot;\\((7-3x)^2\\)&quot;, &quot;\\((5x+4)(5x-4)\\)&quot;, &quot;\\((1-2x)(-2x+1)\\)&quot;, &quot;\\(4x^2+6x+94\\)&quot;]">
    <problem>
      <para><emphasis>Select three </emphasis>expressions that are perfect squares.</para>
      </problem>
    <solution>
      <para>Correct! \(9x^2+24x+16\), \((7-3x)^2\), \((1-2x)(-2x+1)\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 9.4.1 and 9.4.2.</para>
    </div>
    </exercise>
  <!--2a-->
  <exercise data-content-id="90cd1566-01f1-4ae5-869d-6ae4f7672f8e" data-problem-comparator="integer" data-problem-type="input" data-solution="56">
    <problem>
      <para>Find the missing number that makes the expression a perfect square.</para>
      <para>\(49x^2-\_\_\_\_\_\_x+16\)<para>Enter the missing number</para>
        </para>
      </problem>
    <solution>
      <para>Correct! \(49x^2−56x+16\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 9.4.1 and 9.4.2.</para>
    </div>
    </exercise>
  <!--2b-->
  <exercise data-content-id="5ea07411-6348-4906-95df-e7ae55167a0c" data-problem-comparator="integer" data-problem-type="input" data-solution="24">
    <problem>
      <para>\(36x^2+\_\_\_\_\_\_x+4\)
          <para> Enter the missing number. </para>
        </para>
      </problem>
    <solution>
      <para>Correct! \(36x^2+24x+4\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 9.4.1 and 9.4.2.</para>
    </div>
    </exercise>
  <!--2c-->
