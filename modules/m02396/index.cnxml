  <!--3a-->
  <exercise data-content-id="bb7a6593-60a3-4aa1-946a-bb11e82f2fe7" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((7x-4)^2\)" data-solution-options="[&quot;\\((7x+4)^2\\)&quot;, &quot;\\((49x-16)^2\\)&quot;, &quot;\\((7x-4)^2\\)&quot;, &quot;\\((28x-11)^2\\)&quot;]">
    <problem>
      <para> Choose the completely factored form of the expression.</para>
      <para>\(49x^2-56x+16\)</para>
      </problem>
    <solution>
      <para>Correct! \((7x-4)^2\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 9.4.1 and 9.4.2.</para>
    </div>
    </exercise>
  <!--3b-->
  <exercise data-content-id="f5a6787e-5e5a-4596-a765-05d0ddd12951" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(4(3x+1)^2\)" data-solution-options="[&quot;\\((6x-2)^2\\)&quot;, &quot;\\((36x+4)^2\\)&quot;, &quot;\\((6x+2)^2\\)&quot;, &quot;\\(4(3x+1)^2\\)&quot;]">
