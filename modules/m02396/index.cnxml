    </div>
    </exercise>
  <!--7a-->
  <exercise data-content-id="5f115dc3-9078-43ec-96cb-a75ade162d8e" data-problem-type="multiplechoice" data-retry-limit="5" data-solution="\(x=-\frac12\)" data-solution-options="[&quot;\\(x=\\frac12\\)&quot;, &quot;\\(x=-\\frac12\\)&quot;, &quot;\\(x=\\frac32\\)&quot;, &quot;\\(x=-\\frac32\\)&quot;, &quot;\\(x=2\\)&quot;, &quot;\\(x=\\frac16\\)&quot;]">
    <problem>
      <para>Use the value of \(c\) needed to make the expression a perfect square (from the previous question). Then, solve each equation.</para>
      <para>\(4x^2+4x+c=0\)</para>
      </problem>
    <solution>
      <para>Correct! \(-\frac12\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 9.4.3 – 9.4.5.</para>
    </div>
    </exercise>
  <!--7b-->
  <exercise data-content-id="02ccc131-0826-45b1-9c8f-15eb1f7ae2c9" data-problem-type="multiplechoice" data-retry-limit="5" data-solution="\(x=\frac35\)" data-solution-options="[&quot;\\(x=\\frac12\\)&quot;, &quot;\\(x=-\\frac45\\)&quot;, &quot;\\(x=\\frac25\\)&quot;, &quot;\\(x = 4\\)&quot;, &quot;\\(x = 5\\)&quot;, &quot;\\(x=\\frac35\\)&quot;]">
    <problem>
      <para>\(25x^2-30x+c=0\)</para>
      </problem>
    <solution>
      <para>Correct! \(x=\frac35\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 9.4.3 – 9.4.5.</para>
    </div>
    </exercise>
