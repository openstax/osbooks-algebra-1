<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
   <title>9.4.6: Practice</title>
   <metadata xmlns:md="http://cnx.rice.edu/mdml">
      <md:content-id>m02396</md:content-id>
      <md:title>9.4.6: Practice</md:title>
      <md:uuid>77d935b4-0a30-4780-8b40-e08dd1c07f34</md:uuid>
   </metadata>
   <content>
      <section class="practice" id="sect-00001">
         <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
            <exercise id="_8cb61b91-f898-4326-a943-82a15a7e45cf" class="multiple-choice">
               <problem id="prob-00001">
                  <para id="para-00002"><emphasis>Select three</emphasis> expressions that are perfect squares.</para>
               </problem>
               <solution id="sol-00001">
                  <para id="para-00003">Correct! <m:math display="inline"><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>24</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>16</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
                  <para id="para-00004">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00005">The correct answers are: <m:math display="inline"><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>24</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>16</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_90cd1566-01f1-4ae5-869d-6ae4f7672f8e" class="multiple-choice">
               <problem id="prob-00002">
                  <para id="para-00006">Find the missing number that makes the expression a perfect square.</para>
                  <para id="para-00007"><m:math><m:mrow><m:mn>49</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>16</m:mn></m:mrow></m:math></para>
                  <para id="para-00008">Enter the missing number</para>
               </problem>
               <solution id="sol-00002">
                  <para id="para-00009">Correct! <m:math display="inline"><m:mrow><m:mn>49</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>56</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>16</m:mn></m:mrow></m:math></para>
                  <para id="para-00010">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00011">The correct answer is 56. <m:math display="inline"><m:mrow><m:mn>49</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>56</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>16</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_5ea07411-6348-4906-95df-e7ae55167a0c" class="multiple-choice">
               <problem id="prob-00003">
                  <para id="para-00012"><m:math><m:mrow><m:mn>36</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
                  <para id="para-00013">Enter the missing number.</para>
               </problem>
               <solution id="sol-00003">
                  <para id="para-00014">Correct! <m:math display="inline"><m:mrow><m:mn>36</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>24</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
                  <para id="para-00015">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00016">The correct answer is 24. <m:math display="inline"><m:mrow><m:mn>36</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>24</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_43a1355d-8fcf-463e-80df-1c6958cb6228" class="multiple-choice">
               <problem id="prob-00004">
                  <para id="para-00017"><m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>25</m:mn></m:mrow></m:math></para>
                  <para id="para-00018">Enter the missing number.</para>
               </problem>
               <solution id="sol-00004">
                  <para id="para-00019">Correct! <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>20</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>25</m:mn></m:mrow></m:math></para>
                  <para id="para-00020">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00021">The correct answer is 20. <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>20</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>25</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_41350ad7-d9ba-47e7-a761-ade2a2fdeedf" class="multiple-choice">
               <problem id="prob-00005">
                  <para id="para-00022"><m:math><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
                  <para id="para-00023">Enter the missing number.</para>
               </problem>
               <solution id="sol-00005">
                  <para id="para-00024">Correct! <m:math display="inline"><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>18</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
                  <para id="para-00025">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00026">The correct answer is 18. <m:math display="inline"><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>18</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="dbbde4b2-9b7d-44f3-b2e8-f427a5464c70" class="multiple-choice">
               <problem id="prob-00006">
                  <para id="para-00027"><m:math><m:mrow><m:mn>121</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
                  <para id="para-00028">Enter the missing number.</para>
               </problem>
               <solution id="sol-00006">
                  <para id="para-00029">Correct! <m:math display="inline"><m:mrow><m:mn>121</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>66</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
                  <para id="para-00030">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00031">The correct answer is 66. <m:math display="inline"><m:mrow><m:mn>121</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>66</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="bb7a6593-60a3-4aa1-946a-bb11e82f2fe7" class="multiple-choice">
               <problem id="prob-00007">
                  <para id="para-00032"> Choose the completely factored form of the expression.</para>
                  <para id="para-00033"><m:math><m:mrow><m:mn>49</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>56</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>16</m:mn></m:mrow></m:math></para>
                  <para id="para-00034">Multiple Choice:</para>
                  <para id="para-00035"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
                  <para id="para-00036"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>49</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>16</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
                  <para id="para-00037"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
                  <para id="para-00038"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>28</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>11</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
               </problem>
               <solution id="sol-00007">
                  <para id="para-00039">Correct! <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
                  <para id="para-00040">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00041">The correct answer is: <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="f5a6787e-5e5a-4596-a765-05d0ddd12951" class="multiple-choice">
               <problem id="prob-00008">
                  <para id="para-00042"><m:math><m:mrow><m:mn>36</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>24</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
                  <para id="para-00043">Multiple Choice:</para>
                  <para id="para-00044"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
                  <para id="para-00045"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>36</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
                  <para id="para-00046"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
                  <para id="para-00047"><m:math><m:mrow><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
               </problem>
               <solution id="sol-00008">
                  <para id="para-00048">Correct! <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
                  <para id="para-00049">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00050">The correct answer is: <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_2a0b4c94-e582-4c27-9243-e427297fef83" class="multiple-choice">
               <problem id="prob-00009">
                  <para id="para-00051"><m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>20</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>25</m:mn></m:mrow></m:math></para>
                  <para id="para-00052">Multiple Choice:</para>
                  <para id="para-00053">(<m:math display="inline"><m:mrow><m:mn>10</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
                  <para id="para-00054"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
                  <para id="para-00055"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>25</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
                  <para id="para-00056"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
               </problem>
               <solution id="sol-00009">
                  <para id="para-00057">Correct! <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
                  <para id="para-00058">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00059">The correct answer is: <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_47a081a1-7b99-457b-ae6b-1aac8dbf22ba" class="multiple-choice">
               <problem id="prob-00010">
                  <para id="para-00060"><m:math><m:mrow><m:mn>121</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>66</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
                  <para id="para-00061">Multiple Choice:</para>
                  <para id="para-00062"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>11</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
                  <para id="para-00063"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>121</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>9</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
                  <para id="para-00064"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
                  <para id="para-00065"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>11</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
               </problem>
               <solution id="sol-00010">
                  <para id="para-00066">Correct! <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>11</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
                  <para id="para-00067">Try again. Revisit activities 9.4.1 and 9.4.2.</para>
                  <para id="para-00068">The correct answer is: <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>11</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="a5d43333-fc76-4205-ba6c-38de749d4f55" class="multiple-choice">
               <problem id="prob-00011">
                  <para id="para-00069">Find the missing number that makes the expression a perfect square.</para>
                  <para id="para-00070"><m:math><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>42</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi><m:mi>_</m:mi></m:mrow></m:math></para>
                  <para id="para-00071">Enter the missing number.</para>
               </problem>
               <solution id="sol-00011">
                  <para id="para-00072">Correct! <m:math display="inline"><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>42</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>49</m:mn></m:mrow></m:math></para>
                  <para id="para-00073">Try again. Revisit activity 9.4.3.</para>
                  <para id="para-00074">The correct answer is 49. \(9x^2+42x+49)\.</para>
               </solution>
            </exercise>
