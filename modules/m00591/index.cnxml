<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.12.4: Recognizing Points Along Boundary Line</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00591</md:content-id>
    <md:title>2.12.4: Recognizing Points Along Boundary Line</md:title>
    <md:uuid>6639380a-2450-48ab-9621-b84ed4b8101e</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">      <title>Activity</title>
      <para id="para-00001">This activity is an extension of the expectations in the TEKS.</para>
      <para id="para-00002">For questions 1 – 6, use the following scenario:</para>
      <quote id="quote-00001">A popular band is trying to raise at least $20,000 for charity by holding multiple
        concerts at a park. It plans to sell tickets at $25 each. For each 2-hour concert, the band
        would need to pay the park $1,250 in fees for security, cleaning, and traffic services.</quote>
        <quote id="quote-00002">The
        band needs to find the combinations of number of tickets sold, <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math>, and number of
        concerts held, <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math>, that would allow it to reach its fundraising goal.</quote>

      <!--Q#1-->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00004">Write an inequality to represent the constraints in this situation.</para>

        </problem>
        <solution id="sol-00001">
          <para id="para-00005">Compare your answer:</para>
          <para id="para-00006"><m:math><m:mrow><m:mn>25</m:mn><m:mi>t</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>250</m:mn><m:mi>c</m:mi><m:mo>≥</m:mo><m:mn>20</m:mn><m:mo>,</m:mo><m:mn>000</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--START
      QUESTION #2 -->

      <exercise id="exer-00002">
        <problem id="prob-00002">
          <!--QUESTION
          IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
          <para id="para-00007">Use the graphing tool or technology outside the course. Graph your inequality from
            question 1 that represents this scenario using the Desmos tool below.</para>
        <media alt="insert alt text">
        <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
        </media>
        <!--BEGIN
        ADD DESMOS INTERATIVE-->

          <para id="para-00008">When you have finished graphing, then select the <emphasis>solution</emphasis>
            button to compare your work.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00009">Compare your answer:</para>
          <!--REPLACE
          IMAGE BELOW WITH CORRECT IMAGE-->
          
            <media alt="The graph of an inequality in the first quadrant. The x-axis represents the number of tickets sold and the y-axis represents the number of concerts held.">
              <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_14_09_01.svg"/>
            </media>
          
        </solution>
      </exercise>

      <!--END
      ADD DESMOS INTERATIVE-->
      <!--Q#3-->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010">Name two possible combinations of number of tickets sold and number of concerts held
            that would allow the band to meet its goal.</para>

        </problem>
        <solution id="sol-00003">
          <para id="para-00011">Compare your answer:</para>
          <list id="list-00001">
            <item><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1000</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></item>
            <item><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1400</m:mn><m:mo>,</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></item>
          </list>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <para id="para-00012">For questions 4 – 6, decide which combination of tickets and concerts would mean more
        money for charity:</para>
      <!--Q#4-->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00013">1,300 tickets and 10 concerts, or 1,300 tickets and 5 concerts?</para>

        </problem>
        <solution id="sol-00004">
          <para id="para-00014">Compare your answer:</para>
          <para id="para-00015">1,300 tickets and 5 concerts</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#5-->
      <exercise id="exer-00005">
        <problem id="prob-00005">
          <para id="para-00016">1,600 tickets and 16 concerts, or 1,200 tickets and 9 concerts?</para>

        </problem>
        <solution id="sol-00005">
          <para id="para-00017">Compare your answer:</para>
          <para id="para-00018">1,600 tickets and 16 concerts.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#6-->
      <exercise id="exer-00006">
        <problem id="prob-00006">
          <para id="para-00019">2,000 tickets and 4 concerts, or 2,500 tickets and 10 concerts?</para>

        </problem>
        <solution id="sol-00006">
          <para id="para-00020">Compare your answer:</para>
          <para id="para-00021">2,500 tickets and 10 concerts</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
    </section>
  </content>
