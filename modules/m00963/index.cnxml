<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.7.2: Finding Slope From Tables, Graphs, and Points</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00963</md:content-id>
    <md:title>4.7.2: Finding Slope From Tables, Graphs, and Points</md:title>
    <md:uuid>4bc31d1b-82a6-4807-ac76-493572675576</md:uuid>
  </metadata>
  <content>
  <section><title>Activity</title>
<para>Recall that the <term data-schema-version="1.0" data-store="glossary-tooltip">slope</term> of a line is the rate of change of the linear function. On the graph, it is the steepness of the line.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="06c43255-c4fe-4f2f-9628-4af2219ecf4e" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q#1-->
  <exercise data-content-id="431b54f0-b83b-4912-bcc2-9bda8cb5d327" data-problem-comparator="text" data-problem-type="input" data-solution="2/3">
    <problem>
      <para> Find the slope of the line that connects \((0,0)\) and \((3,2)\)</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(\frac23\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#2-->
  <exercise data-content-id="88ced5ad-5839-4508-b36d-779d23898f6a" data-problem-comparator="text" data-problem-type="input" data-solution="2/3">
    <problem>
      <para> Find the slope of the line that connects \((4,2)\) and \((10,7)\)</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(\frac56\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#3-->
  <exercise data-content-id="eef828ee-e5ce-4f27-8b8d-531aae6195c2" data-problem-comparator="integer" data-problem-type="input" data-solution="7">
    <problem>
      <para> Find the slope of the line that connects \((1,-2)\) and \((2,5) \)</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(7\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#4-->
  <exercise data-content-id="3bf173be-910d-4ae4-a7c3-4d74aa5d1398" data-problem-comparator="integer" data-problem-type="input" data-solution="3">
    <problem>
      <para> Find the slope of the line that connects \((-3,4)\) and \((-5,-2)\)</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(3\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#5-->
  <exercise data-content-id="dbdc4f2a-7893-4e9a-ba42-55e83f7eae6e" data-problem-comparator="float" data-problem-type="input" data-solution="-6">
    <problem>
      <para> Find the slope of the line that connects \((8, 3)\) and \((10, -9)\)</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(-6\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#6-->
  <exercise data-content-id="84a05cf3-cfc6-4368-82c0-ce1a451b3371" data-problem-comparator="float" data-problem-type="input" data-solution="-2">
    <problem>
      <para>For numbers 6 – 9, use the graph to find the slope of the line that goes through the two points.</para>
      <para><figure><media alt="Insert Alt Text"><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/9303eae78e40ae55bfb1f2e23c03359c1b07fdbe"/></media></figure></para>
      <para> A and B </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(-2\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#7-->
  <exercise data-content-id="081d3633-cb17-4803-8858-d3a8ca8c952b" data-problem-comparator="integer" data-problem-type="input" data-solution="2">
    <problem>
      <para> A and D </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(2\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#8-->
  <exercise data-content-id="41f98757-9a5a-4acf-84a9-ef139c4934c0" data-problem-comparator="float" data-problem-type="input" data-solution="-1">
    <problem>
      <para> B and C </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(-1\) </para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#9-->
  <exercise data-content-id="ca9ce444-7dfe-45ba-b8f3-17471cc14ebf" data-problem-comparator="integer" data-problem-type="input" data-solution="-8">
    <problem>
      <para> C and D </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(-8\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#10-->
  <exercise data-content-id="55714a1e-becd-4be8-8f38-b7000dd75e5e" data-problem-comparator="text" data-problem-type="input" data-solution="5/2">
    <problem>
      <para> Determine the slope of the equation whose values are in the given table. </para>
      <table class="os-raise-horizontaltable">
        <thead>
        </thead>
        <tbody>
          <row>
            <entry scope="row" class="emphasis">\(x\)</entry>
            <entry>1</entry>
            <entry>3</entry>
            <entry>5</entry>
            <entry>7</entry>
          </row>
          <row>
            <entry scope="row" class="emphasis">\(y\)</entry>
            <entry>5</entry>
            <entry>10</entry>
            <entry>15</entry>
            <entry>20</entry>
          </row>
        </tbody>
      </table>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(\frac52\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#11-->
  <exercise data-content-id="6e60b31f-878d-44e9-ba3a-80f7683af806" data-problem-comparator="text" data-problem-type="input" data-solution="-3/3=-1">
    <problem>
      <para> Determine the slope of the equation whose values are in the given table. Simplify your answer. </para>
      <table class="os-raise-horizontaltable">
        <thead>
        </thead>
        <tbody>
          <row>
            <entry scope="row" class="emphasis">\(x\)</entry>
            <entry>2</entry>
            <entry>5</entry>
            <entry>8</entry>
            <entry>11</entry>
          </row>
          <row>
            <entry scope="row" class="emphasis">\(y\)</entry>
            <entry>4</entry>
            <entry>1</entry>
            <entry>-3</entry>
            <entry>-6</entry>
          </row>
        </tbody>
      </table>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(\frac{-3}{3}=-1\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
