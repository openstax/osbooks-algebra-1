        <exercise id="_6e60b31f-878d-44e9-ba3a-80f7683af806" class="multiple-choice">
          <problem>
            
            <para>Determine the slope of the equation whose values are in the given table. Simplify your answer.</para>
            <table class="os-raise-horizontaltable">
              <tgroup cols="5"><tbody><row>
                  <entry>
                   <emphasis>\(x\)</emphasis>
                  </entry>
                  <entry>2</entry>
                  <entry>5</entry>
                  <entry>8</entry>
                  <entry>11</entry>
                </row>
                <row>
                  <entry>
                   <emphasis>\(y\)</emphasis>
                  </entry>
                  <entry>4</entry>
                  <entry>1</entry>
                  <entry>-3</entry>
                  <entry>-6</entry>
                </row>
              </tbody></tgroup></table>
          </problem>
          <solution>
            <para>Correct! \(\frac{-3}{3}=-1\)</para>
            <para>The correct answer is \(\frac{-3}{3}=-1\)</para>
          </solution>
