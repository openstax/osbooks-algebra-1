<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.15.2: Using Tables and Graphs to Represent Geometric Sequences</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01133</md:content-id>
    <md:title>4.15.2: Using Tables and Graphs to Represent Geometric Sequences</md:title>
    <md:uuid>32822512-2150-4250-87e0-f96ea235dfa0</md:uuid>
  </metadata>
  <content>
  <section><title>Activity </title>
<para>Clare takes a piece of paper, cuts it in half, and then stacks the pieces. She takes the stack of two pieces and cuts
  it in half again to form four pieces, stacking them. She keeps repeating the process.</para>
<list class="os-raise-noindent" type="enumerated">
  <item>
    The original piece of paper has length 8 inches and width 10 inches. Complete the table.
  </item>
</list>
<table class="os-raise-midsizetable">
  <thead>
    <row>
      <entry scope="col" class="emphasis">number of cuts</entry>
      <entry scope="col" class="emphasis">number of pieces</entry>
      <entry scope="col" class="emphasis">area in square inches of each piece</entry>
    </row>
  </thead>
  <tbody>
    <row>
      <entry>
        0
      </entry>
      <entry> </entry>
      <entry> </entry>
    </row>
    <row>
      <entry>
        1
      </entry>
      <entry> </entry>
      <entry> </entry>
    </row>
    <row>
      <entry>
        2
      </entry>
      <entry> </entry>
      <entry> </entry>
    </row>
    <row>
      <entry>
        3
      </entry>
      <entry> </entry>
      <entry> </entry>
    </row>
    <row>
      <entry>
        4
      </entry>
      <entry> </entry>
      <entry> </entry>
    </row>
    <row>
      <entry>
        5
      </entry>
      <entry> </entry>
      <entry> </entry>
    </row>
  </tbody>
</table>

<example><exercise>
  <problem>
  
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.
    </para>
  </problem><solution>
  <table class="os-raise-midsizetable">
    <thead>
      <row>
        <entry scope="col" class="emphasis">number of cuts</entry>
        <entry scope="col" class="emphasis">number of pieces</entry>
        <entry scope="col" class="emphasis">area in square inches of each piece</entry>
      </row>
    </thead>
    <tbody>
      <row>
        <entry>
          0
        </entry>
        <entry>1</entry>
        <entry>80</entry>
      </row>
      <row>
        <entry>
          1
        </entry>
        <entry>2</entry>
        <entry>40</entry>
      </row>
      <row>
        <entry>
          2
        </entry>
        <entry>4</entry>
        <entry>20</entry>
      </row>
      <row>
        <entry>
          3
        </entry>
        <entry>8</entry>
        <entry>10</entry>
      </row>
      <row>
        <entry>
          4
        </entry>
        <entry>16</entry>
        <entry>5</entry>
      </row>
      <row>
        <entry>
          5
        </entry>
        <entry>32</entry>
        <entry>\(\frac52\) or 2.5</entry>
      </row>
    </tbody>
  </table>
  
</solution></exercise>
</example><!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>
        Describe in words how you can use the results after 5 cuts to find the results after 6 cuts.
      </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para> Double the number of pieces, from 32 to 64. Halve the area of each piece, from \(\frac52\) to \(\frac54\).</para>
  </solution></exercise>
<!--Interaction End -->


<div class="os-raise-ib-desmos-gc" data-schema-version="1.0"> </div>


<!--Text Entry Interaction Start -->
<example><exercise>
  <problem>
    
    <para>
        <para>Use the graphing tool above or technology outside the course, on the given axes, sketch a graph of the
            number of pieces as a function of the number of cuts.

          </para>
        </para>
    <para> Then select the <emphasis>solution</emphasis> button to compare your work.
    </para>
  </problem><solution>
  <para><figure><media alt="Insert Alt Text"><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/640fe44d97e424cf3eefce9289f118c6bba06e3a"/></media></figure></para>
</solution></exercise>
</example><!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>How can you see on the graph how the number of pieces is changing with each cut?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>The height of each plotted point is twice the height of the previous plotted point.</para>
  </solution></exercise>
<!--Interaction End -->

<div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>


<!--Text Entry Interaction Start -->
<example><exercise>
  <problem>
    
    <para>
        <para>Use the graphing tool above or technology outside the course, on the given axes, sketch a graph of the
            area of each piece as a function of the number of cuts.
          </para>
        </para>
    <para> Then select the <emphasis>solution</emphasis> button to compare your work.
    </para>
  </problem><solution>
  <para><figure><media alt="Insert Alt Text"><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/34702f050443b6b744a80e597b878040eca08b03"/></media></figure></para>
</solution></exercise>
</example>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>How can you see how the area of each piece is changing with each cut?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>The height of each plotted point is half the height of the previous plotted point.</para>
  </solution></exercise>
<!--Interaction End -->

