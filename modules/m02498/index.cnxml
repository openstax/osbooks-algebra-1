</div>

<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="951a0d06-e2b7-4ea4-9614-3685f83a9b8d" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1a-->
  <exercise data-content-id="8dd03ced-8b05-43a1-b1e7-bf429fcbcb0b" data-problem-comparator="integer" data-problem-type="input" data-solution="8">
    <problem>
      <para>The \(y\)-coordinate of the <term data-schema-version="1.0" data-store="glossary-tooltip">\(y\)-intercept</term> \((0, \_\_\_\_\_)\)</para>
      <para>Enter the \(y\)-coordinate of the \(y\)-intercept. </para>
    </problem>
    <solution>
      <para>Correct! The \(y\)-intercept is \((0,8)\).</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
