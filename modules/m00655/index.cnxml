<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Identifying Graph Regions Included in a System’s Solution</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00655</md:content-id>
    <md:title>Identifying Graph Regions Included in a System’s Solution</md:title>
    <md:uuid>1cbe63a0-831e-4eef-8fa8-6ef66d4279d8</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
      <note class="document" id="note-00001">
      <para id="para-00001">Access the <link url="https://openstax.org/r/desmos-guide">Desmos
        guide PDF</link> for tips on solving problems with the Desmos graphing calculator.</para>
        </note>

      <para id="para-00002">Use this information to answer questions 1 – 7.</para>
      <quote id="quote-00001">A factory produces “widgets” and “zurls.” The combined number of widgets and zurls
        made each day cannot be more than 12. The maximum number of widgets the factory can produce
        in a day is 4.</quote>
        <quote id="quote-00002">Let <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> be the number of widgets and <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> be the number of
        zurls.</quote>

      <!--BEGIN
      ACTIVITY MULTISELECTION 1 TRY -->

        <exercise id="_098f8697-a574-4da1-a25e-310a94269385" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00004">Select <emphasis>two</emphasis> inequalities that represent this situation.</para>
            <list id="list-00001" list-type="enumerated" number-style="lower-alpha">
              <item><math xmlns="http://www.w3.org/1998/Math/MathML">
                <mi>x</mi>
                <mo>≥</mo>
                <mn>4</mn>
              </math></item>
              <item xmlns="http://cnx.rice.edu/cnxml"><math xmlns="http://www.w3.org/1998/Math/MathML">
                <mi>x</mi>
                <mo>+</mo>
                <mi>y</mi>
                <mo>≤</mo>
                <mn>12</mn>
              </math></item>

              <item xmlns="http://cnx.rice.edu/cnxml"><math xmlns="http://www.w3.org/1998/Math/MathML">
                <mi>x</mi>
                <mo>&gt;</mo>
                <mn>4</mn>
              </math></item>
              <item xmlns="http://cnx.rice.edu/cnxml"><math xmlns="http://www.w3.org/1998/Math/MathML">
  <mi>x</mi>
  <mo>+</mo>
  <mi>y</mi>
  <mo>≥</mo>
  <mn>12</mn>
</math></item>
              <item xmlns="http://cnx.rice.edu/cnxml"><math xmlns="http://www.w3.org/1998/Math/MathML">
                <mi>x</mi>
                <mo>≤</mo>
                <mn>4</mn>
              </math></item>
                        </list>
          </problem>
          <solution xmlns="http://cnx.rice.edu/cnxml" id="sol-00001">
            <para id="para-00005"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>12</m:mn></m:mrow></m:math></para>
          </solution>
        </exercise>

      <!--END
      ACTIVITY MULTISELECTION 1 TRY -->
      <!--BEGIN
      ADD DESMOS INTERATIVE-->
      <!--START
      QUESTION #2 -->

      <exercise id="exer-00001">
        <problem id="prob-00002">
          <!--QUESTION
          IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
          <para id="para-00007">Use the graphing tool or technology outside the course. Graph the equations <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math>
            and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>12</m:mn></m:mrow></m:math> using the Desmos tool below.</para>
        <media alt="insert alt text">
        <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
        </media>

        </problem>
        <solution id="sol-00002">
          <para id="para-00009">Compare your answer: </para>
          <media alt="Graph of a system of two linear equations on a coordinate plane.">
            <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_17_09_01.svg"/>
          </media>

        </solution>
      </exercise>

        <!--END
      ADD DESMOS INTERATIVE-->
      <!--BEGIN
      ADD DESMOS INTERATIVE-->
      <!--START
      QUESTION #3 -->

      <exercise id="exer-00002">
        <problem id="prob-00003">
          <!--QUESTION
          IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
          <para id="para-00010">Use the graphing tool or technology outside the course. Graph the system of
            inequalities that shows all the allowable numbers of widgets and zurls that the factory
            can produce in one day using the Desmos tool below.</para>
        <media alt="insert alt text">
        <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
        </media>

        </problem>
        <solution id="sol-00003">
          <para id="para-00012">Compare your answer: </para>
          <media alt="Graph of a system of two linear inequalities on a coordinate plane.">
            <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_17_09_02.svg"/>
          </media>

        </solution>
      </exercise>
<!--END
      ADD DESMOS INTERATIVE-->

      <para id="para-00013">In questions 4 – 7 answer the question:</para>
      <quote id="quote-00003">Does the ordered pair represent an allowable combination of widgets and zurls
        produced in one day?</quote>

      <!-- BEGIN ACTIVITY DROP DOWN 1 TRY -->

        <exercise id="_6347f36e-02cd-47ac-8f39-15175e49b066" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00015">(4, 5)</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00016">Yes.</para>
          </solution>
        </exercise>
        <exercise id="_9595ed26-46a3-4722-bbc4-c5eee9719b21" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00018">(11, 1)</para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00019">No.</para>
          </solution>
        </exercise>
        <exercise id="c0590817-905b-4d81-85e6-cc92f5bc9db9" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00021">(4, 12)</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00022">No.</para>
          </solution>
        </exercise>
        <exercise id="_9469d38c-b0fc-4747-8b57-ba9aec3abc18" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00024">(3, 9)</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00025">Yes.</para>
          </solution>
        </exercise>
      <!--END
      ACTIVITY DROP DOWN 1 TRY -->
    </section>
  </content>
