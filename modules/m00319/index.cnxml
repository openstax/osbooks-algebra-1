<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.14.7: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00319</md:content-id>
    <md:title>1.14.7: Practice</md:title>
    <md:uuid>1f662fad-6252-4b64-afbb-1cbe479ca913</md:uuid>
  </metadata>
  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<blockquote>
  <para>In questions 1 - 5, choose an equation of a line parallel to the given line and contains the given point. The choices are in slope-intercept form.</para>
</blockquote>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="16edde3f-4bd7-4329-a8de-43c9e2bd357c" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--Enter Questions Below this line-->
  <!--Q1-->
  <exercise data-content-id="909f5114-1beb-4172-83b5-3cfc322d081c" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(y=4x-2\)" data-solution-options="[&quot;\\(y=4x+2\\)&quot;, &quot;\\(y=4x-2\\)&quot;, &quot;\\(y=-\\frac14x-2\\)&quot;, &quot;\\(y=-\\frac14x+2\\)&quot;]">
    <problem>
      <para>Line \(y = 4x + 2\)
          Point
          \((1, 2)\) </para>
      </problem>
    <solution>
      <para>Correct! \(y=4x-2\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.14.2.</para>
    </div>
    </exercise>
  
  <!--Q2-->
  <exercise data-content-id="61d898ac-c69c-4b32-8003-4768a55fa342" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(y=-3x +3\)" data-solution-options="[&quot;\\(y=-3x +3\\)&quot;, &quot;\\(y=-3x-3\\)&quot;, &quot;\\(y=\\frac13x+3\\)&quot;, &quot;\\(y=\\frac13x-3\\)&quot;]">
    <problem>
      <para>Line \(y = -3x -1\)
          Point \((2, -3)\) </para>
      </problem>
    <solution>
      <para>Correct! \(y=-3x +3\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.14.2.</para>
    </div>
    </exercise>
  
  <!--Q3-->
  <exercise data-content-id="39322255-26c6-4b83-98b0-7e16753f6a4c" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(y=2x-6\)" data-solution-options="[&quot;\\(y=2x\\)&quot;, &quot;\\(y=-2x+6\\)&quot;, &quot;\\(y=-2x\\)&quot;, &quot;\\(y=2x-6\\)&quot;]">
    <problem>
      <para>Line \(2x - y = 6\)
          Point \((3, 0)\) </para>
      </problem>
    <solution>
      <para>Correct! \(y=2x-6\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.14.2.</para>
    </div>
    </exercise>
  
  <!--Q4-->
  <exercise data-content-id="72376f8b-6771-4aa4-8484-40c9d04b1f19" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x=-3\)" data-solution-options="[&quot;\\(x=-3\\)&quot;, &quot;\\(y=-5\\)&quot;, &quot;\\(x=-5\\)&quot;, &quot;\\(y=-4\\)&quot;]">
    <problem>
      <para>Line \(x = -4\)
          Point \((-3, -5)\) </para>
      </problem>
    <solution>
      <para>Correct! \(x=-3\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.14.4.</para>
    </div>
    </exercise>
  
  <!--Q5-->
  <exercise data-content-id="e11b16ef-f53c-40c9-bf63-f5f54930aa72" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(y=-2\)" data-solution-options="[&quot;\\(x=2\\)&quot;, &quot;\\(x=5\\)&quot;, &quot;\\(y=-2\\)&quot;, &quot;\\(y=2\\)&quot;]">
    <problem>
      <para>Line \(y = 5\)
          Point \((2, -2)\) </para>
      </problem>
    <solution>
      <para>Correct! \(y=-2\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.14.4.</para>
    </div>
    </exercise>
  
  <!--Q6-->
  <exercise data-content-id="5980b1f7-cf0a-4fbc-94a4-7a42d531e127" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(y=\frac12x+1\)" data-solution-options="[&quot;\\(y=-2x+6\\)&quot;, &quot;\\(y=-\\frac12x+3\\)&quot;, &quot;\\(y=\\frac12x+3\\)&quot;, &quot;\\(y=\\frac12x+1\\)&quot;]">
    <problem>
      <blockquote>
        <para>In questions 6 – 10, find an equation of a line that is perpendicular to the given line and contains the given point. The choices are in slope-intercept form.</para>
      </blockquote>
      <para>Line \(y = -2x +3\)
          Point \((2, 2)\) </para>
      </problem>
    <solution>
      <para>Correct! \(y=\frac12x+1\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.14.3.</para>
    </div>
    </exercise>
  
  <!--Q7-->
  <exercise data-content-id="34f5f688-d8a6-44c9-ad20-c0035d7de4f2" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(y=x\)" data-solution-options="[&quot;\\(y=-x+6\\)&quot;, &quot;\\(y=x\\)&quot;, &quot;\\(y=x+5\\)&quot;, &quot;\\(y=-x+3\\)&quot;]">
    <problem>
      <para>Line \(y = -x +5\)
          Point \((3, 3)\) </para>
      </problem>
    <solution>
      <para>Correct! \(y=x\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.14.3.</para>
    </div>
    </exercise>
  
  <!--Q8-->
  <exercise data-content-id="3854c9ff-58ec-4025-9fbb-4ee11fad4cae" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(y=-\frac43x\)" data-solution-options="[&quot;\\(y=-\\frac43x\\)&quot;, &quot;\\(y=-\\frac43x+4\\)&quot;, &quot;\\(y=\\frac34x+4\\)&quot;, &quot;\\(y=\\frac34x+\\frac{17}4\\)&quot;]">
    <problem>
      <para>Line \(y = \frac{3}{4}x - 2\)
          Point \((-3, 4)\) </para>
      </problem>
    <solution>
      <para>Correct! \(y=-\frac43x\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.14.3.</para>
    </div>
    </exercise>
  
  <!--Q9-->
  <exercise data-content-id="69dbb715-5c57-4a0a-b43b-7937bcb9423c" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(y=-2\)" data-solution-options="[&quot;\\(y=-5\\)&quot;, &quot;\\(x=1\\)&quot;, &quot;\\(y=-2\\)&quot;, &quot;\\(x=-2\\)&quot;]">
    <problem>
      <para>Line \(x = -5\)
          Point \((1, -2)\) </para>
      </problem>
    <solution>
      <para>Correct! \(y=-2\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.14.4.</para>
    </div>
    </exercise>
  
  <!--Q10-->
  <exercise data-content-id="61146fd3-06de-4520-a2b4-fc2d65f3e87d" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x=-2\)" data-solution-options="[&quot;\\(y=33\\)&quot;, &quot;\\(y=-4\\)&quot;, &quot;\\(x=3\\)&quot;, &quot;\\(x=-2\\)&quot;]">
    <problem>
      <para>Line \(y - 3 = 0\)
          Point \((-2, -4)\) </para>
      </problem>
    <solution>
      <para>Correct! \(x=-2\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.14.4.</para>
    </div>
    </exercise>
  
