<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.14.7: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00319</md:content-id>
    <md:title>1.14.7: Practice</md:title>
    <md:uuid>a17a8484-7cc7-48f1-b301-b6c45ac0f4b9</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <para id="para-00002"><quote id="quote-00001">In questions 1 - 5, choose an equation of a line parallel to the given line and contains the given point. The choices are in slope-intercept form.</quote></para>
      <exercise id="_909f5114-1beb-4172-83b5-3cfc322d081c" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00003">Line <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math> Point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00004">Multiple Choice:</para>
          <para id="para-00005"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math></para><para id="para-00006"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para><para id="para-00007"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para><para id="para-00008"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00001">
          <para id="para-00009">Correct! <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
          <para id="para-00010">Try again. Revisit activity 1.14.2.</para>
          <para id="para-00011">The correct answer is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
          <para id="para-00012">The slope of a line parallel to <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math> is 4. The line contains the point (1,2).</para>
          <para id="para-00013"><m:math><m:mrow><m:mrow><m:mi>y</m:mi><m:mi>−</m:mi><m:msub><m:mi>y</m:mi><m:mn>1</m:mn></m:msub><m:mi/><m:mo>=</m:mo><m:mi>m</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:msub><m:mi>x</m:mi><m:mn>1</m:mn></m:msub><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi>−</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mi/><m:mo>=</m:mo><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mi/><m:mo>=</m:mo><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mi/><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi/><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>2</m:mn></m:mrow></m:mrow></m:math></para></solution>
      </exercise>
      <exercise id="_61d898ac-c69c-4b32-8003-4768a55fa342" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00014">Line <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math> Point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00015">Multiple Choice:</para>
          <para id="para-00016"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para><para id="para-00017"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></para><para id="para-00018"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para><para id="para-00019"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00002">
          <para id="para-00020">Correct! <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
          <para id="para-00021">Try again. Revisit activity 1.14.2.</para>
          <para id="para-00022">The correct answer is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math>.</para>
          <para id="para-00023">The slope of a line parallel to <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>3</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>1</m:mn></m:mrow></m:math> is <m:math display="inline"><m:mrow><m:mi>−</m:mi><m:mn>3</m:mn></m:mrow></m:math>. The line contains the point (2,−3).</para>
          <para id="para-00024"><m:math><m:mrow><m:mrow><m:mi>y</m:mi><m:mi>−</m:mi><m:msub><m:mi>y</m:mi><m:mn>1</m:mn></m:msub><m:mi/><m:mo>=</m:mo><m:mi>m</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:msub><m:mi>x</m:mi><m:mn>1</m:mn></m:msub><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi>−</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mi/><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi/><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi/><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi/><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:mrow></m:math></para></solution>
      </exercise>
      <exercise id="_39322255-26c6-4b83-98b0-7e16753f6a4c" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00025">Line <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math> Point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00026">Multiple Choice:</para>
          <para id="para-00027"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00028"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn></m:mrow></m:math></para><para id="para-00029"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00030"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00003">
          <para id="para-00031">Correct! <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
          <para id="para-00032">Try again. Revisit activity 1.14.2.</para>
          <para id="para-00033">The correct answer is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math>.</para>
          <para id="para-00034">The slope of a line parallel to <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math> is 2. The line contains the point (3,0).</para>
          <para id="para-00035"><m:math><m:mrow><m:mrow><m:mi>y</m:mi><m:mi>−</m:mi><m:msub><m:mi>y</m:mi><m:mn>1</m:mn></m:msub><m:mi/><m:mo>=</m:mo><m:mi>m</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:msub><m:mi>x</m:mi><m:mn>1</m:mn></m:msub><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi>−</m:mi><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mi/><m:mo>=</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi/><m:mo>=</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi/><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mspace linebreak="newline"/></m:mrow></m:mrow></m:math></para></solution>
      </exercise>
      <exercise id="_72376f8b-6771-4aa4-8484-40c9d04b1f19" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00036">Line <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math> Point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00037">Multiple Choice:</para>
          <para id="para-00038"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></para><para id="para-00039"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math></para><para id="para-00040"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math></para><para id="para-00041"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00004">
          <para id="para-00042">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
          <para id="para-00043">Try again. Revisit activity 1.14.4.</para>
          <para id="para-00044">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math>.</para>
          <para id="para-00045">The slope of a line parallel to <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>4</m:mn></m:mrow></m:math> is undefined. The line contains the point (−3,−5). The only equation with an undefined slope passing through (−3,−5) is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>3</m:mn></m:mrow></m:math>. The only equation with an undefined slope passing through (−3,−5) is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>3</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="e11b16ef-f53c-40c9-bf63-f5f54930aa72" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00046">Line <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math> Point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00047">Multiple Choice:</para>
          <para id="para-00048"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para><para id="para-00049"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math></para><para id="para-00050"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para><para id="para-00051"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00005">
          <para id="para-00052">Correct! <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
          <para id="para-00053">Try again. Revisit activity 1.14.4.</para>
          <para id="para-00054">The correct answer is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
          <para id="para-00055">The slope of a line parallel to <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math> is 0. The line contains the point (2,−2). The only equation with a slope of 0 passing through (2, −2) is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>2</m:mn></m:mrow></m:math>. The only equation with a slope of 0 passing through (2, −2) is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>2</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_5980b1f7-cf0a-4fbc-94a4-7a42d531e127" class="multiple-choice">
        <problem id="prob-00006">
          <para id="para-00056"><quote id="quote-00002">In questions 6 – 10, find an equation of a line that is perpendicular to the given line and contains the given point. The choices are in slope-intercept form.</quote></para>
          <para id="para-00057">Line <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math> Point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00058">Multiple Choice:</para>
          <para id="para-00059"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn></m:mrow></m:math></para><para id="para-00060"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para><para id="para-00061"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para><para id="para-00062"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00006">
          <para id="para-00063">Correct! <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
          <para id="para-00064">Try again. Revisit activity 1.14.3.</para>
          <para id="para-00065">The correct answer is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math>.</para>
          <para id="para-00066">TThe slope of a line perpendicular to <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math> is <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math>. The line contains the point (2,2).</para>
          <para id="para-00067"><m:math><m:mrow><m:mrow><m:mi>y</m:mi><m:mi>−</m:mi><m:msub><m:mi>y</m:mi><m:mn>1</m:mn></m:msub><m:mi/><m:mo>=</m:mo><m:mi>m</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:msub><m:mi>x</m:mi><m:mn>1</m:mn></m:msub><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi>−</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mi/><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mi/><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mi/><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi/><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:mrow></m:math></para></solution>
      </exercise>
      <exercise id="_34f5f688-d8a6-44c9-ad20-c0035d7de4f2" class="multiple-choice">
        <problem id="prob-00007">
          <para id="para-00068">Line <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math> Point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00069">Multiple Choice:</para>
          <para id="para-00070"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn></m:mrow></m:math></para><para id="para-00071"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00072"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para><para id="para-00073"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00007">
          <para id="para-00074">Correct! <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>x</m:mi></m:mrow></m:math></para>
          <para id="para-00075">Try again. Revisit activity 1.14.3.</para>
          <para id="para-00076">The correct answer is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>x</m:mi></m:mrow></m:math>.</para>
          <para id="para-00077">The slope of a line perpendicular to <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>−</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math> is 1. The line contains the point (3,3).</para>
          <para id="para-00078"><m:math><m:mrow><m:mrow><m:mi>y</m:mi><m:mi>−</m:mi><m:msub><m:mi>y</m:mi><m:mn>1</m:mn></m:msub><m:mi/><m:mo>=</m:mo><m:mi>m</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:msub><m:mi>x</m:mi><m:mn>1</m:mn></m:msub><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi>−</m:mi><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mi/><m:mo>=</m:mo><m:mn>1</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mi/><m:mo>=</m:mo><m:mn>1</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mi/><m:mo>=</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi/><m:mo>=</m:mo><m:mi>x</m:mi><m:mspace linebreak="newline"/></m:mrow></m:mrow></m:math></para></solution>
      </exercise>
      <exercise id="_3854c9ff-58ec-4025-9fbb-4ee11fad4cae" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00079">Line <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math> Point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00080">Multiple Choice:</para>
          <para id="para-00081"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00082"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00083"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00084"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para></problem>
        <solution id="sol-00008">
          <para id="para-00085">Correct! <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>x</m:mi></m:mrow></m:math></para>
          <para id="para-00086">Try again. Revisit activity 1.14.3.</para>
          <para id="para-00087">The correct answer is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>x</m:mi></m:mrow></m:math>.</para>
          <para id="para-00088">The slope of a line perpendicular to <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>2</m:mn></m:mrow></m:math> is <m:math display="inline"><m:mrow><m:mi>−</m:mi><m:mfrac><m:mn>4</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math> The line contains the point (−3,4).</para>
          <para id="para-00089"><m:math><m:mrow><m:mrow><m:mi>y</m:mi><m:mi>−</m:mi><m:msub><m:mi>y</m:mi><m:mn>1</m:mn></m:msub><m:mi/><m:mo>=</m:mo><m:mi>m</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:msub><m:mi>x</m:mi><m:mn>1</m:mn></m:msub><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi>−</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mi/><m:mo>=</m:mo><m:mi>−</m:mi><m:mfrac><m:mn>4</m:mn><m:mn>3</m:mn></m:mfrac><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mi/><m:mo>=</m:mo><m:mi>−</m:mi><m:mfrac><m:mn>4</m:mn><m:mn>3</m:mn></m:mfrac><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mi/><m:mo>=</m:mo><m:mi>−</m:mi><m:mfrac><m:mn>4</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi/><m:mo>=</m:mo><m:mi>−</m:mi><m:mfrac><m:mn>4</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>x</m:mi></m:mrow></m:mrow></m:math></para></solution>
      </exercise>
      <exercise id="_69dbb715-5c57-4a0a-b43b-7937bcb9423c" class="multiple-choice">
        <problem id="prob-00009">
          <para id="para-00090">Line <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math> Point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00091">Multiple Choice:</para>
          <para id="para-00092"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math></para><para id="para-00093"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math></para><para id="para-00094"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para><para id="para-00095"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00009">
          <para id="para-00096">Correct! <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
          <para id="para-00097">Try again. Revisit activity 1.14.4.</para>
          <para id="para-00098">The correct answer is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
          <para id="para-00099">The slope of a line perpendicular to <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>5</m:mn></m:mrow></m:math> is 0. The line contains the point (1,−2). The only equation with a slope of 0 passing through (1,−2) is y <m:math display="inline"><m:mrow><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>2</m:mn></m:mrow></m:math>. The only equation with a slope of 0 passing through (1,−2) is y <m:math display="inline"><m:mrow><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>2</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_61146fd3-06de-4520-a2b4-fc2d65f3e87d" class="multiple-choice">
        <problem id="prob-00010">
          <para id="para-00100">Line <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> Point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00101">Multiple Choice:</para>
          <para id="para-00102"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>33</m:mn></m:mrow></m:math></para><para id="para-00103"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00104"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math></para><para id="para-00105"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00010">
          <para id="para-00106">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
          <para id="para-00107">Try again. Revisit activity 1.14.4.</para>
          <para id="para-00108">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
          <para id="para-00109">The slope of a line parallel to <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> is undefined. The line contains the point (−2,−4). The only equation with an undefined slope passing through (−2,−4) is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>2</m:mn></m:mrow></m:math>. The only equation with an undefined slope passing through (−2,−4) is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>2</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
    </section>
  </content>
