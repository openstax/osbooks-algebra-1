      <section class="check-understanding">
        <title>Activity</title>
        <exercise id="_21381c81-2eb2-4899-bc6c-a0b1cc716e12" class="multiple-choice">
          <problem>
            <para>Enter your answer here:</para>
            <para> For Option A, identify the \(y\)-intercept (where \(x = 0\)). </para>
          </problem>
          <solution>
            <para>Correct! 100</para>
            <para>The correct answer is 100.</para>
          </solution>
        </exercise>
        <exercise id="_3f6c27ff-0752-4d44-a43c-61303c490b27" class="multiple-choice">
          <problem>
            <para>Enter your answer here:</para>
            <para> For Option A, identify the slope between any two points. </para>
          </problem>
          <solution>
            <para>Correct! 20</para>
            <para>The correct answer is 20.</para>
          </solution>
        </exercise>
      </section>
      <!--Q#5-->
      <exercise>
        <problem>
          <para> For Option A, write an equation of the line in slope-intercept form. </para>
          <para>Enter your answer here:</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y=20x +100\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <section class="check-understanding">
        <exercise id="_66d335d1-6a37-4341-8387-f3cf896b5252" class="multiple-choice">
          <problem>
            <para>Enter your answer here:</para>
            <para> For Option B, identify the \(y\)-intercept (where \(x = 0\)). </para>
          </problem>
          <solution>
            <para>Correct! 250</para>
            <para>The correct answer is 250.</para>
          </solution>
        </exercise>
        <exercise id="_0fe7f6a8-c586-40ab-bc2f-5f5a6fed8573" class="multiple-choice">
          <problem>
            <para>Enter your answer here:</para>
            <para> For Option B, identify the slope between any two points. </para>
          </problem>
          <solution>
            <para>Correct! 5</para>
            <para>The correct answer is 5.</para>
          </solution>
        </exercise>
      </section>
      <!--Q#8-->
      <exercise>
        <problem>
          <para> For Option B, write an equation of the line in slope-intercept form. </para>
          <para>Enter your answer here:</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y=5x +250\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#9-->
      <exercise>
        <problem>
          <para> Write the system of equations. </para>
          <para>Enter your answer here:</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para><emphasis>Answer:</emphasis> </para>
          <para>\(y=20x +100\)</para>
          <para>\(y=5x +250\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
