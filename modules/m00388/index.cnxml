      <!-- Q#3-->
        <exercise id="_21381c81-2eb2-4899-bc6c-a0b1cc716e12" class="multiple-choice">
          <problem>
            <para>For Option A, identify the \(y\)-intercept (where \(x = 0\)).</para>
          </problem>
          <solution>
            <para>Correct! 100</para>
            <para>The correct answer is 100.</para>
          </solution>
        </exercise>
        <exercise id="_3f6c27ff-0752-4d44-a43c-61303c490b27" class="multiple-choice">
          <problem>
            <para>For Option A, identify the slope between any two points.</para>
          </problem>
          <solution>
            <para>Correct! 20</para>
            <para>The correct answer is 20.</para>
          </solution>
        </exercise>

      <!--Q#5-->
      <exercise>
        <problem>
          <para>For Option A, write an equation of the line in slope-intercept form.</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y=20x +100\)</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

