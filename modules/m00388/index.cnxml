      <!--Q#12-->
      <exercise>
        <problem>
          <para>Talk with your partner. What does this intersection mean in the context of the
            problem?</para>

        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>At 10 visits, the cost is the same at $300.</para>
        </solution>
      </exercise>
