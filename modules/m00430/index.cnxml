  </div>
</div>
<!--Q#5-->
<exercise>
  <problem>
    <para> Explain or show your reasoning. </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>Your answer may vary, but here is a sample.</para>
    <para> \(\begin{array}{r}\underline{\;\;\;\;\;\;\;\;\;\;2x+\frac12y=7\\+\;\;\;\;\;\;6x-\frac12y=5}\\8x=12\\x=\frac{12}8\\x=\frac32\\\end{array}\) </para>
  </solution></exercise>
<!--Interaction End -->

