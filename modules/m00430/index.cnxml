<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Determining the Best Method for Solving a System of Equations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00430</md:content-id>
    <md:title>Determining the Best Method for Solving a System of Equations</md:title>
    <md:uuid>039f44d9-9bac-4da5-8d12-f501832aa1c7</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">
      <title>Cool Down</title>
      <para id="para-00001">Graphing technology should not be used in this cool down.</para>
      <section id="sect-00002">

        <para id="para-00002">Use this linear equation to answer questions 1 - 2.</para>
        <para id="para-00003"><m:math>
            <m:mrow>
              <m:mrow>
                <m:mo stretchy="true" fence="true" form="prefix">{</m:mo>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="center">
                      <m:mn>2</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mfrac>
                        <m:mn>1</m:mn>
                        <m:mn>2</m:mn>
                      </m:mfrac>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>7</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="center">
                      <m:mn>6</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>–</m:mo>
                      <m:mfrac>
                        <m:mn>1</m:mn>
                        <m:mn>2</m:mn>
                      </m:mfrac>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>5</m:mn>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
                <m:mo stretchy="true" fence="true" form="postfix"/>
              </m:mrow>
            </m:mrow>
          </m:math></para>
        <exercise id="_6b5fdee3-467c-42a4-b98d-d5e30434c8e9" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00004">Which would be a more helpful method for solving the system?</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00005">The answer is to add the two equations.</para>
          </solution>
        </exercise>

        <!--Q#2-->
        <exercise id="exer-00001">
          <problem id="prob-00002">
            <para id="para-00007">Explain or show how you know.</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00008">Compare your answer: </para>

            <para id="para-00009">Your answer may vary, but here is a sample. <m:math display="inline">
                <m:mrow>
                  <m:mfrac>
                    <m:mn>1</m:mn>
                    <m:mn>2</m:mn>
                  </m:mfrac>
                  <m:mi>y</m:mi>
                  <m:mo>+</m:mo>
                  <m:mo>–</m:mo>
                  <m:mfrac>
                    <m:mn>1</m:mn>
                    <m:mn>2</m:mn>
                  </m:mfrac>
                  <m:mi>y</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>0</m:mn>
                </m:mrow>
              </m:math>, so adding the
              equations would eliminate the <m:math display="inline">
                <m:mrow>
                  <m:mi>y</m:mi>
                </m:mrow>
              </m:math>-variable and enable
              solving for <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                </m:mrow>
              </m:math>.</para>
          </solution>
        </exercise>
        <!--Interaction
      End -->

        <para id="para-00010">Solve the system without graphing to answer questions 3 – 5.</para>

        <!--Q#3-->
        <exercise id="exer-00002">
          <problem id="prob-00003">
            <para id="para-00011">Identify the <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                </m:mrow>
              </m:math> coordinate of the
              solution.</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00012">Compare your answer: </para>

            <para id="para-00013"><m:math display="inline">
                <m:mrow>
                  <m:mfrac>
                    <m:mn>3</m:mn>
                    <m:mn>2</m:mn>
                  </m:mfrac>
                </m:mrow>
              </m:math>
              or equivalent</para>

          </solution>
        </exercise>
        <!--Interaction
      End -->

        <exercise id="ed1b5c81-1750-469d-8d13-0383aa66fb24" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00014">Identify the <m:math display="inline">
                <m:mrow>
                  <m:mi>y</m:mi>
                </m:mrow>
              </m:math> coordinate of the
              solution.</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00015">8.</para>
          </solution>
        </exercise>

        <!--Q#5-->
        <exercise id="exer-00003">
          <problem id="prob-00005">
            <para id="para-00017">Explain or show your reasoning.</para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00018">Compare your answer: </para>

            <para id="para-00019">Your answer may vary, but here is a sample.</para>

            <para id="para-00020"><m:math display="inline">
                <m:mrow>
                  <m:mtable>
                    <m:mtr>
                      <m:mtd columnalign="right">
                        <m:munder>
                          <m:mrow>
                            <m:mspace width="0.278em"/>
                            <m:mspace width="0.278em"/>
                            <m:mspace width="0.278em"/>
                            <m:mspace width="0.278em"/>
                            <m:mspace width="0.278em"/>
                            <m:mspace width="0.278em"/>
                            <m:mspace width="0.278em"/>
                            <m:mspace width="0.278em"/>
                            <m:mspace width="0.278em"/>
                            <m:mspace width="0.278em"/>
                            <m:mn>2</m:mn>
                            <m:mi>x</m:mi>
                            <m:mo>+</m:mo>
                            <m:mfrac>
                              <m:mn>1</m:mn>
                              <m:mn>2</m:mn>
                            </m:mfrac>
                            <m:mi>y</m:mi>
                            <m:mo>=</m:mo>
                            <m:mn>7</m:mn>
                            <m:mspace linebreak="newline"/>
                            <m:mo>+</m:mo>
                            <m:mspace width="0.278em"/>
                            <m:mspace width="0.278em"/>
                            <m:mspace width="0.278em"/>
                            <m:mspace width="0.278em"/>
                            <m:mspace width="0.278em"/>
                            <m:mspace width="0.278em"/>
                            <m:mn>6</m:mn>
                            <m:mi>x</m:mi>
                            <m:mo>–</m:mo>
                            <m:mfrac>
                              <m:mn>1</m:mn>
                              <m:mn>2</m:mn>
                            </m:mfrac>
                            <m:mi>y</m:mi>
                            <m:mo>=</m:mo>
                            <m:mn>5</m:mn>
                          </m:mrow>
                          <m:mo accent="true">―</m:mo>
                        </m:munder>
                      </m:mtd>
                    </m:mtr>
                    <m:mtr>
                      <m:mtd columnalign="right">
                        <m:mn>8</m:mn>
                        <m:mi>x</m:mi>
                        <m:mo>=</m:mo>
                        <m:mn>12</m:mn>
                      </m:mtd>
                    </m:mtr>
                    <m:mtr>
                      <m:mtd columnalign="right">
                        <m:mi>x</m:mi>
                        <m:mo>=</m:mo>
                        <m:mfrac>
                          <m:mrow>
                            <m:mn>12</m:mn>
                          </m:mrow>
                          <m:mn>8</m:mn>
                        </m:mfrac>
                      </m:mtd>
                    </m:mtr>
                    <m:mtr>
                      <m:mtd columnalign="right">
                        <m:mi>x</m:mi>
                        <m:mo>=</m:mo>
                        <m:mfrac>
                          <m:mn>3</m:mn>
                          <m:mn>2</m:mn>
                        </m:mfrac>
                      </m:mtd>
                    </m:mtr>
                  </m:mtable>
                </m:mrow>
              </m:math></para>
          </solution>
        </exercise>
        <!--Interaction
      End -->
      </section>
    </section>

    <section id="sect-00003">
      <title>Video: Determining the Best Method for Solving a System of Equations</title>
      <para id="para-00021">Watch the following video to learn more about finding the best method to
        solve a system of equations.</para>
