      <para>a. _____</para>
    </entry>
  </row>
  <row>
    <entry>
      <para>\(15\)</para>
    </entry>
    <entry> </entry>
    <entry>
      <para>b. _____</para>
    </entry>
  </row>
  <row>
    <entry>
      <para>\(20\)</para>
    </entry>
    <entry> </entry>
    <entry>
      <para>c. _____</para>
    </entry>
  </row>
  <row>
    <entry>
      <para>\(30\)</para>
    </entry>
    <entry> </entry>
    <entry>
      <para>d. _____</para>
    </entry>
  </row>
  <row>
    <entry>
      <para>\(45\)</para>
    </entry>
