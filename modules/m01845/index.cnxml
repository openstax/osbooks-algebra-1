    </entry>
  </row>
  <row>
    <entry>
      <para>\(50\)</para>
    </entry>
    <entry> </entry>
    <entry>
      <para>f. _____</para>
    </entry>
  </row>
  <row>
    <entry>
      <para>\(p\)</para>
    </entry>
    <entry> </entry>
    <entry>
      <para>g. _____</para>
