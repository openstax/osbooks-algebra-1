  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Warm Up Activity</title>
      <para id="para-00001">Here is an expression:</para>
      <para id="para-00002"><m:math><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>y</m:mi></m:mrow></m:math></para><para id="para-00003">Decide if the values in each ordered pair, <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>,</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>, make the value of the expression
        less than, greater than, or equal to 12.</para>

      <!--Q1-->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00004"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
        <solution id="sol-00001">
          <para id="para-00005">Compare your answer: </para>

          <para id="para-00006">greater than 12</para>

        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!--Q2-->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00007"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
        <solution id="sol-00002">


          <para id="para-00008">Compare your answer: </para>

          <para id="para-00009">equal to 12</para>

        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!--Q3-->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
        <solution id="sol-00003">


          <para id="para-00011">Compare your answer: </para>

          <para id="para-00012">less than 12</para>

        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!--Q4-->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00013"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
        <solution id="sol-00004">


          <para id="para-00014">Compare your answer: </para>

          <para id="para-00015">greater than 12</para>

        </solution>
      </exercise>
      <!--Interaction
      End -->
    </section>
