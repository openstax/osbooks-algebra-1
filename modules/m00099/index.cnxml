  <exercise data-content-id="01389e45-0f85-49f5-ab9c-a627dd91487e" data-problem-type="multiplechoice" data-retry-limit="4" data-solution="\(\frac34\)" data-solution-options="[&quot;\\(\\frac34\\)&quot;, &quot;32&quot;, &quot;64&quot;, &quot;96&quot;, &quot;144&quot;]">
