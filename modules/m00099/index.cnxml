  <!--Q4d-->
  <exercise data-content-id="487b241e-1926-4620-b221-e8022719898d" data-problem-type="multiplechoice" data-retry-limit="4" data-solution="144" data-solution-options="[&quot;\\(\\frac34\\)&quot;, &quot;32&quot;, &quot;64&quot;, &quot;96&quot;, &quot;144&quot;]">
    <problem>
