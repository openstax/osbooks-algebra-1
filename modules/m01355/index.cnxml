<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.6.6: Interpreting Negative Exponents and Scientific Notation</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01355</md:content-id>
    <md:title>5.6.6: Interpreting Negative Exponents and Scientific Notation</md:title>
    <md:uuid>7e04628f-ae29-4153-b6cb-ba0d75e6dd3d</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Cool Down Activity</title>
<para id="para-00001">The equation \(p=5,000\cdot2^t\) represents the population of an invasive fish species in a large lake, \(t\) years since 2005, when the fish population in the lake was first surveyed. Use the '^' symbol to enter an exponent.</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002">What was the population in 2005?</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00003">Compare your answer:</para>
    
    <para id="para-00004">5,000, because \(5,000\cdot 2^0=5,000\).</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00005">What is this value of the population in 2005 in scientific notation?</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00006">Compare your answer:</para>
    
    <para id="para-00007">\(5.0\times 10^3\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00008">For this model, what does it mean when \(t\) is –2?</para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00009">Compare your answer:</para>
    
    <para id="para-00010">It means 2 years before 2005, which is 2003.</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00011">For \( t=-2\), is the fish population more or less than 1,000? How do you know?</para>
    </problem><solution id="sol-00004">
    
    
  
  <para id="para-00012">Compare your answer:</para>
    
    <para id="para-00013">More than 1,000. For \(t=-2\) yeilds \(5,000\cdot 2^{-2}=1,250\).</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00005">
  <problem id="prob-00005">
    <para id="para-00014">Write the value of the fish population when \(t=-2\) in scientific notation.</para>
    </problem><solution id="sol-00005">
    
    
  
  <para id="para-00015">Compare your answer:</para>
    
    <para id="para-00016">\(1.25\times 10^3
      \)</para>
  
  </solution></exercise>
<!--Interaction End --></section>
