  </div>
</div>
<para>For questions 2–4, use the function \(f(x)=(x-4)(x+2)\).</para>
<!--Q#2-->
<exercise>
  <problem>
    <para>Write the function in standard form. Use the "^" symbol to enter an exponent.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(f(x)=x^2-2x-8\)</para>
    <para>\(f(x)=(x-4)(x+2)\)</para>
  </solution></exercise>
<!--Interaction End -->
<!--Q#3-->
<exercise>
  <problem>
    <para>Write the function from question 2 in vertex form. Use the "^" symbol to enter an exponent.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(f(x)=(x-1)^2-9\)</para>
    <para>\(f(x)=x^2 - 2x + 1 - 8 - 1\)</para>
  </solution></exercise>
<!--Interaction End -->
<!--Q#4-->
<exercise>
  <problem>
    <para>Identify the vertex from question 3. Use the "^" symbol to enter an exponent.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para> \((1, -9)\)</para>
  </solution></exercise>
<!--Interaction End -->
<para>For questions 5 - 6, write an equation in vertex form of the quadratic function that has a vertex at \((-4, 1)\) and also goes through the point \((6, -1)\).</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="f5e9b4a1-8214-4115-88b7-d427810fc1b5" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0"> <!--Q#5-->
  <exercise data-content-id="1ed28060-bc51-4003-91db-cfee70fddd12" data-problem-comparator="text" data-problem-type="input" data-solution="-1/50">
    <problem>
      <para>Find the value of \(a\) for vertex form in simplest form. Use the "^" symbol to enter an exponent.</para>
      <para>Enter your answer here.</para>
    </problem>
    <solution>
      <para>Correct!</para>
      <para>\(\frac{-1}{50}\)</para>
      <para>\(-1=a(6-(-4))^2+(1)\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.9.3.</para>
    </div>
    </exercise>
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>
<!--Q#6-->
<exercise>
  <problem>
    <para>Write the equation in vertex form. Use the "^" symbol to enter an exponent.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(y=\frac{-1}{50}(x+4)^2+1\)</para>

  </solution></exercise>
<!--Interaction End -->
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="afc3edaf-66a8-4487-95fe-8b4d1bc66439" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0"> <!--Q#7-->
  <exercise data-content-id="a801a69a-ce71-4fc4-8cf5-402892a8e844" data-problem-comparator="text" data-problem-type="input" data-solution="5/36">
    <problem>
            <para>For questions 7 and 8, write an equation in vertex form of the quadratic function that has a vertex at \((-2, -3)\) and also goes through the point \((4, 2)\). Use the "^" symbol to enter an exponent.</para>
      <para>Find the value of \(a\) for vertex form in simplest form.</para>
      <para>Enter your answer here.</para>
    </problem>
    <solution>
      <para>Correct!</para>
      <para>\(\frac{5}{36}\)</para>
      <para>\(2=a(4-(-2))^2+(-3)\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.9.3.</para>
    </div>
    </exercise>
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>
<!--Q#8-->
<exercise>
  <problem>
    <para>Write the equation in vertex form. Use the "^" symbol to enter an exponent.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(y=\frac{5}{36}(x+2)^2-3\)</para>
  </solution></exercise>
<!--Interaction End -->
<!--Q#9-->
<exercise>
  <problem>
    <para>For questions 9 - 10, use the function \(f(x)=x^2\) that is shifted to create the function \(g(x)\) that has a vertex at \((-4, 6)\). Use the "^" symbol to enter an exponent.</para>
    <para>Write \(g(x)\) in vertex form.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(g(x)=(x+4)^2+6\)</para>
    <para>Substitute the vertex in for \((h, k)\) </para>
  </solution></exercise>
<!--Interaction End -->
<!--Q#10-->
<exercise>
  <problem>
    <para> Write \(g(x)\) in standard form. Use the "^" symbol to enter an exponent.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(g(x)=x^2+8x+22\)</para>
    <para>Multiply the binomials then simplify.</para>
  </solution></exercise>
