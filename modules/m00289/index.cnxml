<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.13.3: Matching Tables, Equations, and Graphs</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00289</md:content-id>
    <md:title>1.13.3: Matching Tables, Equations, and Graphs</md:title>
    <md:uuid>0eb2a137-57a6-49eb-b93e-4925742f8916</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">
      <para id="para-00001">Take turns with your partner to match a graph with each set of <link url="https://k12.openstax.org/contents/raise/resources/af91afbca772fa436edb464f00683c24d9a68a68">matching cards</link>. Eventually all the cards will be sorted into groups of four cards (an equation, situation, table, and graph).</para>
      <para id="para-00002">For each match that you find, explain to your partner how you know it’s a match. Ask your partner if they agree with your thinking.</para>
      <para id="para-00003">For each match that your partner finds, listen carefully to their explanation. If you disagree, discuss your thinking and work to reach an agreement.</para>
      <!--Q#1-->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00004">What did you and your partner agree are the cards that match the equation on card 1?</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00005">Compare your answer: </para>
          <para id="para-00006">Cards 1, 11, 20, 32</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#2-->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00007">What did you and your partner agree are the cards that match the equation on card 2?</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00008">Compare your answer: </para>
          <para id="para-00009">Cards 2, 16, 18, 25</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#3-->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010">What did you and your partner agree are the cards that match the equation on card 3?</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00011">Compare your answer: </para>
          <para id="para-00012">Cards 3, 10, 21, 29</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#4-->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00013">What did you and your partner agree are the cards that match the equation on card 4?</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00014">Compare your answer: </para>
          <para id="para-00015">Cards 4, 9, 23, 30</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#5-->
      <exercise id="exer-00005">
        <problem id="prob-00005">
          <para id="para-00016">What did you and your partner agree are the cards that match the equation on card 5?</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00017">Compare your answer: </para>
          <para id="para-00018">Cards 5, 12, 22, 31</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#6-->
      <exercise id="exer-00006">
        <problem id="prob-00006">
          <para id="para-00019">What did you and your partner agree are the cards that match the equation on card 6?</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00020">Compare your answer: </para>
          <para id="para-00021">Cards 6, 15, 24, 26</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#7-->
      <exercise id="exer-00007">
        <problem id="prob-00007">
          <para id="para-00022">What did you and your partner agree are the cards that match the equation on card 7?</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00023">Compare your answer: </para>
          <para id="para-00024">Cards 7, 14, 19, 27</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#8-->
      <exercise id="exer-00008">
        <problem id="prob-00008">
          <para id="para-00025">What did you and your partner agree are the cards that match the equation on card 8?</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00026">Compare your answer: </para>
          <para id="para-00027">Cards 8, 13, 17, 28</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
    <note class="self-check" id="note-00001">
      <exercise id="exer-00010">
        <problem id="prob-00010">
