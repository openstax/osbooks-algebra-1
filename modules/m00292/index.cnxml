<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.13.4: Creating a Table from an Equation</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00292</md:content-id>
    <md:title>1.13.4: Creating a Table from an Equation</md:title>
    <md:uuid>8748e667-6f5b-4c73-b452-2547496da46d</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001"><title>Cool Down</title>
      <!--Q#-->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00001">Using the equation <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>6</m:mn></m:mrow></m:mfrac></m:mrow></m:math>, complete the table of values.</para>
          <table class="unnumbered os-raise-horizontaltable" id="table-00001">
            <tgroup cols="6">
<tbody>
                <row>
                  <entry><emphasis><m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math></emphasis></entry>
                  <entry>0</entry>
                  <entry>1</entry>
                  <entry>2</entry>
                  <entry>3</entry>
                  <entry>4</entry>
                </row>
                <row>
                  <entry><emphasis><m:math><m:mrow><m:mi>m</m:mi></m:mrow></m:math></emphasis></entry>
                  <entry/>
                  <entry/>
                  <entry/>
                  <entry/>
                  <entry/>
                </row>
              </tbody>
            </tgroup>
          </table>
          <para id="para-00002"></para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Compare your answer: </para>
          <table class="unnumbered os-raise-horizontaltable" id="table-00002">
            <tgroup cols="6">
<tbody>
                <row>
                  <entry><emphasis><m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math></emphasis></entry>
                  <entry>0</entry>
                  <entry>1</entry>
                  <entry>2</entry>
                  <entry>3</entry>
                  <entry>4</entry>
                </row>
                <row>
                  <entry><emphasis><m:math><m:mrow><m:mi>m</m:mi></m:mrow></m:math></emphasis></entry>
                  <entry>-1</entry>
                  <entry><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></entry>
                  <entry><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></entry>
                  <entry><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></entry>
                  <entry>0</entry>
                </row>
              </tbody>
            </tgroup>
          </table>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>
