<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.13.4: Creating a Table from an Equation</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00292</md:content-id>
    <md:title>1.13.4: Creating a Table from an Equation</md:title>
    <md:uuid>47d41b7f-caa3-4c1f-977f-c1412faafbcd</md:uuid>
  </metadata>
  <content>
  <section><title>Cool Down Activity</title>

<!--Q#-->
<example><exercise>
  <problem>
    
    <para>Using the equation \(m=\frac{x-4}{6}\), complete the table of values.</para>
    <table class="os-raise-horizontaltable">
      <thead>
      </thead>
      <tbody>
        <row>
          <entry><emphasis>\(x\)</emphasis></entry><entry>0</entry>
          <entry>1</entry>
          <entry>2</entry>
          <entry>3</entry>
          <entry>4</entry>
        </row>
        <row>
          <entry><emphasis>\(m\)</emphasis></entry><entry/>
          <entry/>
          <entry/>
          <entry/>
          <entry/>
        </row>
      </tbody>
    </table>
    
    
  <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <table class="os-raise-horizontaltable">
    <thead>
    </thead>
    <tbody>
      <row>
        <entry><emphasis>\(x\)</emphasis></entry><entry>0</entry>
        <entry>1</entry>
        <entry>2</entry>
        <entry>3</entry>
        <entry>4</entry>
      </row>
      <row>
        <entry><emphasis>\(m\)</emphasis></entry><entry>-1</entry>
        <entry>\(-\frac34\)</entry>
        <entry>\(-\frac12\)</entry>
        <entry>\(-\frac14\)</entry>
        <entry>0</entry>
      </row>
    </tbody>
  </table>
</solution></exercise>
</example><!--Interaction End --> 

</section>
</content>
</document>
