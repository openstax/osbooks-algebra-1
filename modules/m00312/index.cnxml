        <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
      </media>
      
        <exercise id="exer-00009">
          <problem id="prob-00009">
            <!--QUESTION IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
            <para id="para-00025">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00026">Compare your answer:</para>
            <para id="para-00027">
                      <media alt="A graph with two intersecting lines: a blue line slopes upward from left to right, and a green line slopes downward from left to right. The lines intersect above the x-axis and to the right of the y-axis.">
                  <image mime-type="image/jpeg" src="../../media/Algebra-1_01_16_09_01.jpg"/>
                </media>
              
           </para>
          </solution>
        </exercise>
      
      <!--Interaction End -->
      <!--Q#10-->
      <list class="os-raise-noindent" list-type="enumerated" id="list-00002">
        <item>Use the graphing tool or technology outside the course. Graph your equations from questions 6 and 8 using the Desmos tool below.</item>
      </list>
      <media alt="...">
        <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
      </media>
      
        <exercise id="exer-00010">
          <problem id="prob-00010">
            <!--QUESTION IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
            <para id="para-00028">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00029">Compare your answer:</para>
            <para id="para-00030">
                      <media alt="A graph with two intersecting lines: a downward red line and an upward light blue line, crossing near the origin on a grid with labeled axes.">
                  <image mime-type="image/jpeg" src="../../media/Algebra-1_01_16_09_02.jpg"/>
                </media>
              
           </para>
            <note id="note-00002">
              <para id="para-00031">Perpendicular lines have slopes that have opposite signs and are reciprocals of each other. Here are some examples and non-examples of the slopes of lines that are perpendicular:</para>
              <table class="unnumbered os-raise-midsizetable" id="table-00001">
                <tgroup cols="2">
                  <tbody>
                    <row>
                      <entry>
                       <emphasis>Examples</emphasis>
                      </entry>
                      <entry>
                       <emphasis>Non-Examples</emphasis>
                      </entry>
                    </row>
                    <row>
                      <entry><m:math><m:mrow><m:mn>5</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac></m:mrow></m:math></entry>
                      <entry><m:math><m:mrow><m:mn>5</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math></entry>
                    </row>
                    <row>
                      <entry><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac><m:mo>,</m:mo><m:mn>7</m:mn></m:mrow></m:math></entry>
                      <entry><m:math><m:mrow><m:mo>−</m:mo><m:mn>7</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac></m:mrow></m:math></entry>
                    </row>
                    <row>
                      <entry><m:math><m:mrow><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>9</m:mn></m:mrow></m:mfrac><m:mo>,</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>9</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></entry>
                      <entry><m:math><m:mrow><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>9</m:mn></m:mrow></m:mfrac><m:mo>,</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>9</m:mn></m:mrow></m:mfrac></m:mrow></m:math></entry>
                    </row>
                  </tbody>
                </tgroup>
                <caption> Slopes of Perpendicular Lines </caption>
              </table>
            </note>
          </solution>
        </exercise>
      
      <!--Interaction End -->
      <!--Q#11-->
      <exercise id="exer-00011">
        <problem id="prob-00011">
          <para id="para-00032">What is the slope of the line perpendicular to a line with a slope of <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math>?</para>
        </problem>
        <solution id="sol-00011">
          <para id="para-00033">Compare your answer:</para>
          <para id="para-00034">The slope of the perpendicular line is -4.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#12-->
      <exercise id="exer-00012">
        <problem id="prob-00012">
          <para id="para-00035">What is the slope of the line perpendicular to a line with a slope of -8?</para>
        </problem>
        <solution id="sol-00012">
          <para id="para-00036">Compare your answer:</para>
          <para id="para-00037">The slope of the perpendicular line is <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#13-->
      <exercise id="exer-00013">
        <problem id="prob-00013">
          <para id="para-00038">What is the slope of the line perpendicular to a line with a slope of <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>6</m:mn></m:mrow><m:mrow><m:mn>11</m:mn></m:mrow></m:mfrac></m:mrow></m:math>?</para>
        </problem>
        <solution id="sol-00013">
          <para id="para-00039">Compare your answer:</para>
          <para id="para-00040">The slope of the perpendicular line is <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mo stretchy="false">[</m:mo></m:mfrac><m:mn>6</m:mn><m:mi>}</m:mi></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
    <note class="self-check" id="note-00003">
      <exercise id="exer-00015">
        <problem id="prob-00015">
