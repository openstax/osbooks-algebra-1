<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.14.4: Writing an Equation of a Line Perpendicular to a Given Line</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00312</md:content-id>
    <md:title>1.14.4: Writing an Equation of a Line Perpendicular to a Given Line</md:title>
    <md:uuid>54af9a85-0f5c-4b21-9c83-747c16a7fca6</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">      <title>Activity</title>
      <!--Q#1-->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00001">Find the equation of the line using point-slope form: <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00002">Compare your answer:</para>
          <para id="para-00003"><m:math><m:mrow><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#2-->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00004">Rewrite your equation from Question 1 in slope-intercept form.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00005">Compare your answer:</para>
          <para id="para-00006"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>5</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#3-->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00007">Find the equation of the line using point-slope form: <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00008">Compare your answer:</para>
          <para id="para-00009"><m:math><m:mrow><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#4-->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00010">Rewrite your equation from Question 3 in slope-intercept form.</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00011">Compare your answer:</para>
          <para id="para-00012"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#5-->
      <exercise id="exer-00005">
        <problem id="prob-00005">
          <para id="para-00013">Find the equation of the line using point-slope form: <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>4</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00014">Compare your answer:</para>
          <para id="para-00015"><m:math><m:mrow><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#6-->
      <exercise id="exer-00006">
        <problem id="prob-00006">
          <para id="para-00016">Rewrite your equation from Question 5 in slope-intercept form.</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00017">Compare your answer:</para>
          <para id="para-00018"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#7-->
      <exercise id="exer-00007">
        <problem id="prob-00007">
          <para id="para-00019">Find the equation of the line using point-slope form: <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00020">Compare your answer:</para>
          <para id="para-00021"><m:math><m:mrow><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#8-->
      <exercise id="exer-00008">
        <problem id="prob-00008">
          <para id="para-00022">Rewrite your equation from Question 7 in slope-intercept form.</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00023">Compare your answer:</para>
          <para id="para-00024"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#9-->
      <list class="os-raise-noindent" list-type="enumerated" id="list-00001">
        <item>Use the graphing tool or technology outside the course. Graph your equations from questions 2 and 4 on the same graph using the Desmos tool below.</item>
      </list>
