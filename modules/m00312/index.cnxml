  <title>1.14.4: Writing an Equation of a Line Perpendicular to a Given Line</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00312</md:content-id>
    <md:title>1.14.4: Writing an Equation of a Line Perpendicular to a Given Line</md:title>
    <md:uuid>54af9a85-0f5c-4b21-9c83-747c16a7fca6</md:uuid>
  </metadata>
  <content>
    <section>
      <title>Activity</title>
      <!--Q#1-->
      <exercise>
        <problem>
          <para>Find the equation of the line using point-slope form: \(m = 2\), \((3,1)\)</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y − 1 = 2(x − 3)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#2-->
      <exercise>
        <problem>
          <para>Rewrite your equation from Question 1 in slope-intercept form.</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y = 2x − 5\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#3-->
      <exercise>
        <problem>
          <para>Find the equation of the line using point-slope form: \(m = -\frac12\), \((−1,4)\)</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y − 4 = -\frac{1}{2}(x + 1)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#4-->
      <exercise>
        <problem>
          <para>Rewrite your equation from Question 3 in slope-intercept form.</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y = -\frac{1}{2}x + \frac72\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#5-->
      <exercise>
        <problem>
          <para>Find the equation of the line using point-slope form: \(m = −4\), \((2,1)\)</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y − 1 = −4(x − 2)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#6-->
      <exercise>
        <problem>
          <para>Rewrite your equation from Question 5 in slope-intercept form.</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y = −4x + 9\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#7-->
      <exercise>
        <problem>
          <para>Find the equation of the line using point-slope form: \(m = \frac14\), \((3,2)\)</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y − 2 = \frac{1}{4}(x − 3)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#8-->
      <exercise>
        <problem>
          <para>Rewrite your equation from Question 7 in slope-intercept form.</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y = \frac{1}{4}x + \frac{5}{4}\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
