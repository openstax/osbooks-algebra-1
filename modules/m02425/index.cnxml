<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.6.1: Evaluating Expressions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02425</md:content-id>
    <md:title>9.6.1: Evaluating Expressions</md:title>
    <md:uuid>501242d9-8072-406c-ab1c-6c3ccc602302</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Warm Up Activity</title>
      <para id="para-00001">Each expression represents two numbers. Evaluate the expressions and find the <emphasis>two</emphasis> numbers.</para>

        <exercise id="_3367bcd2-5353-4c00-b027-056a5d3e866e" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00002"><m:math><m:mrow><m:mn>1</m:mn><m:mi>±</m:mi><m:msqrt><m:mrow><m:mn>49</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00003">Correct! 8, -6</para>
            <para id="para-00004">The correct answers are: 8, -6.</para>
          </solution>
        </exercise>
        <exercise id="_3cf44a08-dd84-4e6f-9325-448021a03919" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00005"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>8</m:mn><m:mi>±</m:mi><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00006">Correct! 2, <m:math display="inline"><m:mrow><m:mfrac><m:mn>6</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
            <para id="para-00007">The correct answers are:2, <m:math display="inline"><m:mrow><m:mfrac><m:mn>6</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_588a324c-e455-438f-8480-1f3b842881cb" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00008"><m:math><m:mrow><m:mi>±</m:mi><m:mspace width="0.278em"/><m:msqrt><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>·</m:mi><m:mn>4</m:mn><m:mi>·</m:mi><m:mn>1</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00009">Correct! 3, -3</para>
            <para id="para-00010">The correct answers are: 3, -3.</para>
          </solution>
        </exercise>
        <exercise id="_9bcf7718-35b4-444e-b547-675c485075f3" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00011"><m:math><m:mrow><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>18</m:mn><m:mi>±</m:mi><m:msqrt><m:mrow><m:mn>36</m:mn></m:mrow></m:msqrt></m:mrow><m:mrow><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>3</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00012">Correct! -2, -4</para>
            <para id="para-00013">The correct answers are: -2, -4.</para>
          </solution>
        </exercise>
    </section>
  </content>
</document>
