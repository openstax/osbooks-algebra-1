<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.6.1: Evaluating Expressions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02425</md:content-id>
    <md:title>9.6.1: Evaluating Expressions</md:title>
    <md:uuid>38bb9652-36f0-4513-a2e2-e43f74c6ac5e</md:uuid>
  </metadata>
  <content>
  <section><title>Warm Up Activity</title>
<para>Each expression represents two numbers. Evaluate the expressions and find the <emphasis>two</emphasis> numbers.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="62686222-ca82-47de-8714-c6ec23799a71" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1-->
  <exercise data-content-id="3367bcd2-5353-4c00-b027-056a5d3e866e" data-problem-type="multiselect" data-solution="[&quot;\\(8\\)&quot;, &quot;\\(-6\\)&quot;]" data-solution-options="[&quot;\\(8\\)&quot;, &quot;\\(50\\)&quot;, &quot;\\(-48\\)&quot;,&quot;\\(-6\\)&quot;]">
    <problem>
      <para>\(1 \pm\sqrt{49}\)</para>
      </problem>
    <solution>
      <para>Correct! 8, -6</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q2-->
  <exercise data-content-id="3cf44a08-dd84-4e6f-9325-448021a03919" data-problem-type="multiselect" data-solution="[&quot;\\(2\\)&quot;, &quot;\\(\\frac{6}{5}\\)&quot;]" data-solution-options="[&quot;\\(\\frac45\\)&quot;, &quot;\\(2\\)&quot;, &quot;\\(\\frac{16}{5}\\)&quot;,&quot;\\(\\frac{6}{5}\\)&quot;]">
    <problem>
      <para>\(\frac{8 \pm2}{5}\)</para>
      </problem>
    <solution>
      <para> Correct! 2, \(\frac65\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q3-->
  <exercise data-content-id="588a324c-e455-438f-8480-1f3b842881cb" data-problem-type="multiselect" data-solution="[&quot;\\(3\\)&quot;, &quot;\\(-3\\)&quot;]" data-solution-options="[&quot;\\(\\sqrt{-6}\\)&quot;, &quot;\\(3\\)&quot;, &quot;\\(-3\\)&quot;,&quot;\\(-\\sqrt{-6}\\)&quot;]">
    <problem>
      <para>\(\pm \; \sqrt{(-5)^2-4 \cdot 4 \cdot 1}\)</para>
      </problem>
    <solution>
      <para>Correct! 3, -3</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q4-->
  <exercise data-content-id="9bcf7718-35b4-444e-b547-675c485075f3" data-problem-type="multiselect" data-solution="[&quot;\\(-2\\)&quot;, &quot;\\(-4\\)&quot;]" data-solution-options="[&quot;\\(-2\\)&quot;, &quot;\\(-17\\)&quot;, &quot;\\(-19\\)&quot;,&quot;\\(-4\\)&quot;]">
    <problem>
      <para>\(\frac{-18 \pm \sqrt{36}}{2 \cdot3}\)</para>
      </problem>
    <solution>
      <para>Correct! -2, -4</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
