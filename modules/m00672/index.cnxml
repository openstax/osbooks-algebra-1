<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Unit 3 Overview: Why Should I Care?</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00672</md:content-id>
    <md:title>Unit 3 Overview: Why Should I Care?</md:title>
    <md:uuid>5d20dae3-3399-4ba1-8a35-35f1a485a9d0</md:uuid>
