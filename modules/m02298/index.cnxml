    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.12.3.</para>
    </div>
    </exercise>
  <!--9-->
  <exercise data-content-id="15839ded-e850-4b5f-8918-5debe5f219e3" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="5.08 seconds" data-solution-options="[&quot;2.50 seconds &quot;, &quot;4.63 seconds&quot;, &quot;5.08 seconds&quot;, &quot;6.12 seconds&quot;]">
    <problem>
      <para>Approximately how long will it take for the rocket to land on the ground?</para>
