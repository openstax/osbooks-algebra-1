<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.2.4: Understanding Function Notation Using Application Problems</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00870</md:content-id>
    <md:title>4.2.4: Understanding Function Notation Using Application Problems</md:title>
    <md:uuid>e0615886-a95e-4019-82c8-02a3c0fa362a</md:uuid>
  </metadata>
  <content>
  <section><title>Cool Down Activity</title>
<para>Function \(Q\) gives a puppy’s weight, in pounds, as a function of its age, in months.</para>

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>What does each expression or equation represent in this situation?
        
        <para>\(Q(18)\)</para>
      </para>
    </problem><solution>
    
    <para/>
  
  <para>Compare your answers:</para>
    
    <para>The weight of the puppy when it was 18 months old</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(Q(30)=27.5\)</para>
      </problem><solution>
    
    <para/>
  
  <para>Compare your answers:</para>
    
    <para>When the puppy was 30 months old, it weighed 27.5 pounds.</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>
        Use function notation to represent each statement.
        
        <para>When the puppy turned 12 months old, it weighed 19.6 pounds.</para>
      </para>
    </problem><solution>
    
    <para/>
  
  <para>Compare your answers:</para>
    
    <para>\(Q(12)=19.6\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>
          When the puppy was \(m\) months old, it weighed \(w\) pounds.</para>
      </problem><solution>
    
    <para/>
  
  <para>Compare your answers:</para>
    
    <para>\(Q(m)=w\)</para>
  
  </solution></exercise>
<!--Interaction End --></section>
</content>
