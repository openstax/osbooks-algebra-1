<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.2.4: Understanding Function Notation Using Application Problems</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00870</md:content-id>
    <md:title>4.2.4: Understanding Function Notation Using Application Problems</md:title>
    <md:uuid>e0615886-a95e-4019-82c8-02a3c0fa362a</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Cool Down Activity</title>
      <para id="para-00001">Function <m:math display="inline"><m:mrow><m:mi>Q</m:mi></m:mrow></m:math> gives a puppy’s weight, in pounds, as a function of its age, in months.</para>

      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002">What does each expression or equation represent in this situation?</para>

          <para id="para-00003"><m:math><m:mrow><m:mi>Q</m:mi><m:mo stretchy="false">(</m:mo><m:mn>18</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
        <solution id="sol-00001">


          <para id="para-00004">Compare your answers:</para>

          <para id="para-00005">The weight of the puppy when it was 18 months old</para>

        </solution>
      </exercise>
      <!--Interaction End -->


      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00006"><m:math><m:mrow><m:mi>Q</m:mi><m:mo stretchy="false">(</m:mo><m:mn>30</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>27.5</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00002">

          <para id="para-00008">Compare your answers:</para>

          <para id="para-00009">When the puppy was 30 months old, it weighed 27.5 pounds.</para>

        </solution>
      </exercise>
      <!--Interaction End -->


      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010"> Use function notation to represent each statement.</para>
          <para id="para-00011">When the puppy turned 12 months old, it weighed 19.6 pounds.</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00012">Compare your answers:</para>
          <para id="para-00007"><m:math><m:mrow><m:mi>Q</m:mi><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>19.6</m:mn></m:mrow></m:math></para></solution>
      </exercise>

      <!--Interaction End -->


      <!--Text Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00014"> When the puppy was <m:math display="inline"><m:mrow><m:mi>m</m:mi></m:mrow></m:math> months old, it weighed <m:math display="inline"><m:mrow><m:mi>w</m:mi></m:mrow></m:math> pounds.</para>
        </problem>
        <solution id="sol-00004">

          <para id="para-00016">Compare your answers:</para>

          <para id="para-00013"><m:math><m:mrow><m:mi>Q</m:mi><m:mo stretchy="false">(</m:mo><m:mi>m</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>w</m:mi></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>