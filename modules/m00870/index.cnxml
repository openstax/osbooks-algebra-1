  <content>
  <section id="sect-00001"><title>Cool Down Activity</title>
<para id="para-00001">Function \(Q\) gives a puppy’s weight, in pounds, as a function of its age, in months.</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002">What does each expression or equation represent in this situation?
        
        <para id="para-00003">\(Q(18)\)</para>
        </para>
    </problem><solution id="sol-00001">
    
    <para id="para-00004">Enter your answer here:</para>
  
  <para id="para-00005">Compare your answers:</para>
    
    <para id="para-00006">The weight of the puppy when it was 18 months old </para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00007">\(Q(30)=27.5\)</para>
      </problem><solution id="sol-00002">
    
    <para id="para-00008">Enter your answer here:</para>
  
  <para id="para-00009">Compare your answers:</para>
    
    <para id="para-00010">When the puppy was 30 months old, it weighed 27.5 pounds. </para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00011">
        Use function notation to represent each statement.
        
        <para id="para-00012">When the puppy turned 12 months old, it weighed 19.6 pounds.</para>
        </para>
    </problem><solution id="sol-00003">
    
    <para id="para-00013">Enter your answer here:</para>
  
  <para id="para-00014">Compare your answers:</para>
    
    <para id="para-00015">\(Q(12)=19.6\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00016">
          When the puppy was \(m\) months old, it weighed \(w\) pounds. </para>
      </problem><solution id="sol-00004">
    
    <para id="para-00017">Enter your answer here:</para>
  
  <para id="para-00018">Compare your answers:</para>
    
    <para id="para-00019">\(Q(m)=w\)</para>
  
  </solution></exercise>
<!--Interaction End --></section>
