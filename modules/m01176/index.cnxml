<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.17.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01176</md:content-id>
    <md:title>4.17.5: Practice</md:title>
    <md:uuid>6e2d1af4-e630-46ed-b201-863c0fdcdc17</md:uuid>
  </metadata>
  <content>
  <section class="practice" id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
<section id="sect-00002">
  <exercise id="_4346f584-c163-4d4f-af5b-ff3f4e32e6dc" class="multiple-choice"><problem id="prob-00001"><para id="para-00002">For questions 1 – 3, match each sequence with one of the definitions. Note that only the part of the definition showing the relationship between the current term and the previous term is given so as not to give away the solutions.</para><para id="para-00003">6, 12, 18, 24</para>
      <para id="para-00004">Multiple Choice:</para><para id="para-00005"><m:math><m:mrow><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>7</m:mn><m:mi>·</m:mi><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00006"><m:math><m:mrow><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00007"><m:math><m:mrow><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>6</m:mn></m:mrow></m:math></para><para id="para-00008"><m:math><m:mrow><m:mi>d</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>d</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>20</m:mn></m:mrow></m:math></para></problem><solution id="sol-00001"><para id="para-00009">Correct! <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>6</m:mn></m:mrow></m:math></para><para id="para-00010">Try again. Revisit activity 4.17.2.</para><para id="para-00011">The correct answer is <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>6</m:mn></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="f0bb4279-bc18-410e-9f1e-cf2a4f7c4a18" class="multiple-choice"><problem id="prob-00002"><para id="para-00012">2, 14, 98, 686</para>
      <para id="para-00013">Multiple Choice:</para><para id="para-00014"><m:math><m:mrow><m:mi>a</m:mi><m:mrow><m:mo stretchy="false">(</m:mo><m:mi mathvariant="normal">n</m:mi></m:mrow><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>7</m:mn><m:mi>·</m:mi><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00015"><m:math><m:mrow><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00016"><m:math><m:mrow><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>6</m:mn></m:mrow></m:math></para><para id="para-00017"><m:math><m:mrow><m:mi>d</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>d</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>20</m:mn></m:mrow></m:math></para></problem><solution id="sol-00002"><para id="para-00018">Correct! <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>7</m:mn><m:mi>·</m:mi><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00019">Try again. Revisit activities 4.17.2.</para><para id="para-00020">The correct answer is <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>7</m:mn><m:mi>·</m:mi><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_9e8f3213-c781-466f-b0c9-960969c82d9e" class="multiple-choice"><problem id="prob-00003"><para id="para-00021">160, 80, 40, 20</para>
      <para id="para-00022">Multiple Choice:</para><para id="para-00023"><m:math><m:mrow><m:mi>a</m:mi><m:mrow><m:mo stretchy="false">(</m:mo><m:mi mathvariant="normal">n</m:mi></m:mrow><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>7</m:mn><m:mi>·</m:mi><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00024"><m:math><m:mrow><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00025"><m:math><m:mrow><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>6</m:mn></m:mrow></m:math></para><para id="para-00026"><m:math><m:mrow><m:mi>d</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>d</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>20</m:mn></m:mrow></m:math></para></problem><solution id="sol-00003"><para id="para-00027">Correct! <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00028">Try again. Revisit activity 4.17.2.</para><para id="para-00029">The correct answer is <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_3a1ca587-2e2c-4c2b-9366-97eff10d778b" class="multiple-choice"><problem id="prob-00004"><para id="para-00030">For questions 4 – 5, select the first five terms of each sequence. Determine whether each sequence is arithmetic, geometric, or neither.</para><para id="para-00031"><m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mi>−</m:mi><m:mn>3</m:mn></m:mrow></m:math> for <m:math display="inline"><m:mrow><m:mi>n</m:mi><m:mi>≥</m:mi><m:mn>2</m:mn></m:mrow></m:math>.</para>
      <para id="para-00032">Multiple Choice:</para><para id="para-00033">7, 4, 1, -2, -5, geometric</para><para id="para-00034">7, -21, 63, -189, geometric</para><para id="para-00035">7, -21, 63, -189, arithmetic</para><para id="para-00036">7, 4, 1, -2, -5, arithmetic</para></problem><solution id="sol-00004"><para id="para-00037">Correct! 7, 4, 1, –2, –5, arithmetic</para><para id="para-00038">Try again. Revisit activities 4.17.2.</para><para id="para-00039">The correct answer is 7, 4, 1, –2, –5, arithmetic.</para></solution></exercise>
      
      <exercise id="a3ae435e-517b-4dd8-a419-01290f5af8d7" class="multiple-choice"><problem id="prob-00005"><para id="para-00040"><m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>10</m:mn><m:mi>⋅</m:mi><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> for <m:math display="inline"><m:mrow><m:mi>n</m:mi><m:mi>≥</m:mi><m:mn>2</m:mn></m:mrow></m:math>.</para>
      <para id="para-00041">Multiple Choice:</para><para id="para-00042">3, 30, 300, 3000, 30000, arithmetic</para><para id="para-00043">3, 30, 300, 3000, 30000, geometric</para><para id="para-00044">3, 13, 23, 33, 43, geometric</para><para id="para-00045">3, 13, 23, 33, 43, arithmetic</para></problem><solution id="sol-00005"><para id="para-00046">Correct! 3, 30, 300, 3000, 30000, geometric</para><para id="para-00047">Try again. Revisit activity 4.17.2.</para><para id="para-00048">The correct answer is 3, 30, 300, 3000, 30000, geometric.</para></solution></exercise>
      
      <exercise id="_50bf737d-9ce3-4460-aee2-daf2767eecf9" class="multiple-choice"><problem id="prob-00006"><para id="para-00049">For questions 6 – 8, match each sequence with one of the recursive definitions. Note that only the part of the definition showing the relationship between the current term and the previous term is given so as not to give away the solutions.</para><para id="para-00050">3, 15, 75, 375</para>
      <para id="para-00051">Multiple Choice:</para><para id="para-00052"><m:math><m:mrow><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>·</m:mi><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00053"><m:math><m:mrow><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00054"><m:math><m:mrow><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>5</m:mn><m:mi>·</m:mi><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00055"><m:math><m:mrow><m:mi>d</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>d</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math></para></problem><solution id="sol-00006"><para id="para-00056">Correct! <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>5</m:mn><m:mi>·</m:mi><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00057">Try again. Revisit activities 4.17.2 – 4.17.3.</para><para id="para-00058">The correct answer is <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>5</m:mn><m:mi>·</m:mi><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="de90b110-dd9b-4dab-a220-43138f2ab7ac" class="multiple-choice"><problem id="prob-00007"><para id="para-00059">18, 6, 2, <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
      <para id="para-00060">Multiple Choice:</para><para id="para-00061"><m:math><m:mrow><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>·</m:mi><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00062"><m:math><m:mrow><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00063"><m:math><m:mrow><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>5</m:mn><m:mi>·</m:mi><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00064"><m:math><m:mrow><m:mi>d</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>d</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math></para></problem><solution id="sol-00007"><para id="para-00065">Correct! <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00066">Try again. Revisit activities 4.17.2 – 4.17.3.</para><para id="para-00067">The correct answer is <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>·</m:mi><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="cbd7a717-07d5-4ad6-a639-e457a6d9956c" class="multiple-choice"><problem id="prob-00008"><para id="para-00068">17, 13, 9, 5</para>
      <para id="para-00069">Multiple Choice:</para><para id="para-00070"><m:math><m:mrow><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>·</m:mi><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00071"><m:math><m:mrow><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00072"><m:math><m:mrow><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>5</m:mn><m:mi>·</m:mi><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00073"><m:math><m:mrow><m:mi>d</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>d</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math></para></problem><solution id="sol-00008"><para id="para-00074">Correct! <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00075">Try again. Revisit activities 4.17.2-–.16.3.</para><para id="para-00076">The correct answer is <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_70384a16-aac0-49c2-a57c-91d05f23be77" class="multiple-choice"><problem id="prob-00009"><para id="para-00077">An arithmetic sequence <m:math display="inline"><m:mrow><m:mi>k</m:mi></m:mrow></m:math> starts 12, 6, . . . and is represented by the graph below.</para>
      <para id="para-00078">Which of the following is a recursive definition for sequence <m:math display="inline"><m:mrow><m:mi>k</m:mi></m:mrow></m:math> when <m:math display="inline"><m:mrow><m:mi>n</m:mi><m:mo>≥</m:mo><m:mn>2</m:mn></m:mrow></m:math>?</para>
     
    <para id="para-00079">Multiple Choice:</para><para id="para-00080"><m:math><m:mrow><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math></para><para id="para-00081"><m:math><m:mrow><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math></para><para id="para-00082"><m:math><m:mrow><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>6</m:mn></m:mrow></m:math></para><para id="para-00083"><m:math><m:mrow><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mn>6</m:mn><m:mi>⋅</m:mi><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00009"><para id="para-00084">Correct! <m:math display="inline"><m:mrow><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math></para><para id="para-00085">Try again. Revisit activities 4.17.2 – 4.17.4.</para><para id="para-00086">The correct answer is <m:math display="inline"><m:mrow><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math>.</para></solution></exercise></section></section>
</content></document>
