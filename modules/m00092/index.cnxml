<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.3.2: Describing Relationships Using Words and Equations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00092</md:content-id>
    <md:title>1.3.2: Describing Relationships Using Words and Equations</md:title>
    <md:uuid>b5bb6f20-63df-4752-89de-05dea9820576</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">      <title>Activity</title>
      <para id="para-00001">Create a math story that describes how the two quantities in each table are related.</para>
      <!-- Q1 -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002"><emphasis>Table A</emphasis></para>
          <table class="unnumbered os-raise-horizontaltable unnumbered" id="table-00001">
            <tgroup cols="6">
            
  <tbody>
                <row>
                  <entry>
                    <emphasis> Number of Laps, <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> </emphasis>
                  </entry>
                  <entry> 0 </entry>
                  <entry> 1 </entry>
                  <entry> 2.5 </entry>
                  <entry> 6 </entry>
                  <entry> 9 </entry>
                </row>
                <row>
                  <entry>
                    <emphasis> Meters Run, <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> </emphasis>
                  </entry>
                  <entry> 0 </entry>
                  <entry> 400 </entry>
                  <entry> 1,000 </entry>
                  <entry> 2,400 </entry>
                  <entry> 3,600 </entry>
                </row>
              </tbody>
            </tgroup>
          </table>
          <para id="para-00003">Enter the story here:</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00004">Your answer may vary, but here is an example</para>
          <para id="para-00005">Every lap is 400 meters, so the distance run is 400 times the number of laps.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- Q2-->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00006"><emphasis>Table B</emphasis></para>
          <table class="unnumbered os-raise-horizontaltable unnumbered" id="table-00002">
            <tgroup cols="6">
            
  <tbody>
                <row>
                  <entry>
                    <emphasis> Meters From Home, <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> </emphasis>
                  </entry>
                  <entry> 0 </entry>
                  <entry> 75 </entry>
                  <entry> 128 </entry>
                  <entry> 319 </entry>
                  <entry> 396 </entry>
                </row>
                <row>
                  <entry>
                    <emphasis> Meters From School, <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> </emphasis>
                  </entry>
                  <entry> 400 </entry>
                  <entry> 325 </entry>
                  <entry> 272 </entry>
                  <entry> 81 </entry>
                  <entry> 4 </entry>
                </row>
              </tbody>
            </tgroup>
          </table>
          <para id="para-00007">Enter the story here:</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00008">Your answer may vary, but here is an example.</para>
          <para id="para-00009">The distance between home and school is 400 meters. Every meter traveled away from home is a meter closer to school.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q3 -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010"><emphasis>Table C</emphasis></para>
          <table class="unnumbered os-raise-horizontaltable unnumbered" id="table-00003">
            <tgroup cols="5">
            
  <tbody>
                <row>
                  <entry>
                    <emphasis> Electricity Bills in Dollars, <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> </emphasis>
                  </entry>
                  <entry> 85 </entry>
                  <entry> 124 </entry>
                  <entry> 309 </entry>
                  <entry> 816 </entry>
                </row>
                <row>
                  <entry>
                    <emphasis> Total Expenses in Dollars, <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> </emphasis>
                  </entry>
                  <entry> 485 </entry>
                  <entry> 524 </entry>
                  <entry> 709 </entry>
                  <entry> 1,216 </entry>
                </row>
              </tbody>
            </tgroup>
          </table>
          <para id="para-00011">Enter the story here:</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00012">Your answer may vary, but here is an example.</para>
          <para id="para-00013">Total expenses can be found by adding $400 to electricity bills. (The $400 could represent rent payment.)</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q4 -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00014"><emphasis>Table D</emphasis></para>
          <table class="unnumbered os-raise-horizontaltable unnumbered" id="table-00004">
            <tgroup cols="5">
            
  <tbody>
                <row>
                  <entry>
                    <emphasis> Monthly Salary in Dollars, <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> </emphasis>
                  </entry>
                  <entry> 872 </entry>
                  <entry> 998 </entry>
                  <entry> 1,015 </entry>
                  <entry> 2,110 </entry>
                </row>
                <row>
                  <entry>
                    <emphasis> Amount Deposited in Dollars, <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> </emphasis>
                  </entry>
                  <entry> 472 </entry>
                  <entry> 598 </entry>
                  <entry> 615 </entry>
                  <entry> 1,710 </entry>
                </row>
              </tbody>
            </tgroup>
          </table>
          <para id="para-00015">Enter the story here:</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00016">Your answer may vary, but here is an example.</para>
          <para id="para-00017">The amount deposited is $400 less than the monthly salary. (The employer might deduct $400 per paycheck for taxes, health insurance, retirement savings, and so on. Or, the employee might first pay $400 in rent or other expenses before depositing the rest of the monthly salary.)</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <para id="para-00018">For questions 5 - 8, match each table from 1 - 4 to an equation that represents the relationship.</para>
      <!--Q5 -->
      <exercise id="exer-00005">
        <problem id="prob-00005">
          <para id="para-00019">Equation 1: <m:math display="inline"><m:mrow><m:mn>400</m:mn><m:mo>+</m:mo><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>y</m:mi></m:mrow></m:math></para>
          <para id="para-00020">Enter the table letter here:</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00021">Compare your answer:</para>
          <para id="para-00022">Table C</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q6-->
      <exercise id="exer-00006">
        <problem id="prob-00006">
          <para id="para-00023">Equation 2: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>400</m:mn><m:mo>=</m:mo><m:mi>y</m:mi></m:mrow></m:math></para>
          <para id="para-00024">Enter the table letter here:</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00025">Compare your answer:</para>
          <para id="para-00026">Table D</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q7 -->
      <exercise id="exer-00007">
        <problem id="prob-00007">
          <para id="para-00027">Equation 3: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>400</m:mn></m:mrow></m:math></para>
          <para id="para-00028">Enter the table letter here:</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00029">Compare your answer:</para>
          <para id="para-00030">Table B</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00008">
        <problem id="prob-00008">
          <para id="para-00031">Equation 4: <m:math display="inline"><m:mrow><m:mn>400</m:mn><m:mi>⋅</m:mi><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>y</m:mi></m:mrow></m:math></para>
          <para id="para-00032">Enter the table letter here:</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00033">Compare your answer:</para>
          <para id="para-00034">Table A</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
    </section>
    <section id="sect-00002">
      <title>Are you ready for more?</title>
      <section class="numbered-exercises" id="sect-00003"><title>Extending Your Thinking</title>
        <exercise class="RFM1" id="exer-00009">
          <problem id="prob-00009">
            <para id="para-00035">Express every number between 1 and 20 at least one way using exactly four 4s and any operations. For example, 1 could be written as <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math>.</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00036">Compare your answer:</para>
            <para id="para-00037">Your answer may vary, but here are some samples:</para>
            <para id="para-00038"><m:math display="inline"><m:mrow><m:mn>1</m:mn><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00064"><m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00065"><m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mo>=</m:mo><m:msqrt><m:mn>4</m:mn></m:msqrt><m:mo>+</m:mo><m:msqrt><m:mn>4</m:mn></m:msqrt><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00066"><m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>=</m:mo><m:msqrt><m:mn>4</m:mn></m:msqrt><m:mo>+</m:mo><m:msqrt><m:mn>4</m:mn></m:msqrt><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00067"><m:math display="inline"><m:mrow><m:mn>5</m:mn><m:mo>=</m:mo><m:msqrt><m:mn>4</m:mn></m:msqrt><m:mo>+</m:mo><m:msqrt><m:mn>4</m:mn></m:msqrt><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00068"><m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00069"><m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00070"><m:math display="inline"><m:mrow><m:mn>8</m:mn><m:mo>=</m:mo><m:msqrt><m:mn>4</m:mn></m:msqrt><m:mo>+</m:mo><m:msqrt><m:mn>4</m:mn></m:msqrt><m:mo>+</m:mo><m:msqrt><m:mn>4</m:mn></m:msqrt><m:mo>+</m:mo><m:msqrt><m:mn>4</m:mn></m:msqrt></m:mrow></m:math></para><para id="para-00071"><m:math display="inline"><m:mrow><m:mn>9</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00072"><m:math display="inline"><m:mrow><m:mn>10</m:mn><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">)</m:mo><m:msqrt><m:mn>4</m:mn></m:msqrt></m:mrow></m:math></para><para id="para-00073"><m:math display="inline"><m:mrow><m:mn>11</m:mn><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn><m:mo>!</m:mo><m:msqrt><m:mn>4</m:mn></m:msqrt><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00074"><m:math display="inline"><m:mrow><m:mn>12</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00075"><m:math display="inline"><m:mrow><m:mn>13</m:mn><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn><m:mo>!</m:mo><m:msqrt><m:mn>4</m:mn></m:msqrt><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00076"><m:math display="inline"><m:mrow><m:mn>14</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>·</m:mi><m:mn>4</m:mn><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:msqrt><m:mn>4</m:mn></m:msqrt></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00077"><m:math display="inline"><m:mrow><m:mn>15</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>·</m:mi><m:mn>4</m:mn><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00078"><m:math display="inline"><m:mrow><m:mn>16</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00079"><m:math display="inline"><m:mrow><m:mn>17</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>·</m:mi><m:mn>4</m:mn><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00080"><m:math display="inline"><m:mrow><m:mn>18</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>·</m:mi><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>−</m:mo><m:msqrt><m:mn>4</m:mn></m:msqrt></m:mrow></m:math></para><para id="para-00081"><m:math display="inline"><m:mrow><m:mn>19</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>!</m:mo><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00082"><m:math display="inline"><m:mrow><m:mn>20</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
        </exercise>
      </section>
    </section>
    <section id="sect-00004">
      <title>Video: Describing Relationships</title>
      <para id="para-00039">Watch the following video to learn more about describing relationships using words and equations, specifically looking at the base and height of different rectangles.</para>
