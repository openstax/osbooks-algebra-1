    <section>
      <title>Self Check</title>
      <table class="os-raise-horizontaltable">
      <tgroup cols="4">
      <tbody>
        <row>
          <entry><emphasis>
            Miles from Home, \( x \)
          </emphasis></entry><entry>
            0
          </entry>
          <entry>
            5
          </entry>
          <entry>
            10
          </entry>
        </row>
        <row>
          <entry><emphasis>
            Miles from School, \( y \)
          </emphasis></entry><entry>
            30
          </entry>
          <entry>
