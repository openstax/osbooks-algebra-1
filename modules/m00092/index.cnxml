<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.3.2: Describing Relationships Using Words and Equations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00092</md:content-id>
    <md:title>1.3.2: Describing Relationships Using Words and Equations</md:title>
    <md:uuid>b5bb6f20-63df-4752-89de-05dea9820576</md:uuid>
  </metadata>
  <content>
    <section>
      <title>Activity</title>
      <para>Create a math story that describes how the two quantities in each table are related.</para>
      <!-- Q1 -->
      <exercise>
        <problem>
          <para><emphasis>Table A</emphasis></para>
          <table class="os-raise-horizontaltable">
          <tgroup cols="6">
            <tbody>
              <row>
                <entry>
                  <emphasis>
                    Number of Laps, \(x \)
                  </emphasis>
                </entry>
                <entry>
                  0
                </entry>
                <entry>
                  1
                </entry>
                <entry>
                  2.5
                </entry>
                <entry>
                  6
                </entry>
                <entry>
                  9
                </entry>
              </row>
              <row>
                <entry>
                  <emphasis>
                    Meters Run, \(y \)
                  </emphasis>
                </entry>
                <entry>
                  0
                </entry>
                <entry>
                  400
                </entry>
                <entry>
                  1,000
                </entry>
                <entry>
                  2,400
                </entry>
                <entry>
                  3,600
                </entry>
              </row>
            </tbody>
            </tgroup>
          </table>

        <para>Enter the story here:</para>
        </problem>

        <solution>
        <para>Your answer may vary, but here is an example</para>

          <para>Every lap is 400 meters, so the distance run is 400 times the number of laps. </para>

        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!-- Q2-->
      <exercise>
        <problem>
          <para><emphasis>Table B</emphasis></para>
          <table class="os-raise-horizontaltable">
            <tgroup cols="6">
            <tbody>
              <row>
                <entry>
                  <emphasis>
                    Meters From Home, \(x \)
                  </emphasis>
                </entry>
                <entry>
                  0
                </entry>
                <entry>
                  75
                </entry>
                <entry>
                  128
                </entry>
                <entry>
                  319
                </entry>
                <entry>
                  396
                </entry>
              </row>
              <row>
                <entry>
                  <emphasis>
                    Meters From School, \(y \)
                  </emphasis>
                </entry>
                <entry>
                  400
                </entry>
                <entry>
                  325
                </entry>
                <entry>
                  272
                </entry>
                <entry>
                  81
                </entry>
                <entry>
                  4
                </entry>
              </row>
            </tbody>
            </tgroup>
          </table>

<para>Enter the story here: </para>
        </problem>
        <solution>
          <para>Your answer may vary, but here is an example. </para>

          <para>The distance between home and school is 400 meters. Every meter traveled away from
            home is a meter closer to school. </para>

        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!--Q3 -->
      <exercise>
        <problem>
          <para><emphasis>Table C</emphasis></para>
          <table class="os-raise-horizontaltable">
            <tgroup cols="6">
            <tbody>
              <row>
                <entry>
                  <emphasis>
                    Electricity Bills in Dollars, \(x \)
                  </emphasis>
                </entry>
                <entry>
                  85
                </entry>
                <entry>
                  124
                </entry>
                <entry>
                  309
                </entry>
                <entry>
                  816
                </entry>
              </row>
              <row>
                <entry>
                  <emphasis>
                    Total Expenses in Dollars, \(y \)
                  </emphasis>
                </entry>
                <entry>
                  485
                </entry>
                <entry>
                  524
                </entry>
                <entry>
                  709
                </entry>
                <entry>
                  1,216
                </entry>
              </row>
            </tbody>
            </tgroup>
          </table>

          <para>Enter the story here: </para>
        </problem>
        <solution>
          <para>Your answer may vary, but here is an example.</para>

          <para>Total expenses can be found by adding $400 to electricity bills. (The $400 could
            represent rent payment.) </para>

        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!--Q4 -->
      <exercise>
        <problem>
          <para><emphasis>Table D</emphasis></para>
          <table class="os-raise-horizontaltable">
            <tgroup cols="6">
            <tbody>
              <row>
                <entry>
                  <emphasis>
                    Monthly Salary in Dollars, \(x \)
                  </emphasis>
                </entry>
                <entry>
                  872
                </entry>
                <entry>
                  998
                </entry>
                <entry>
                  1,015
                </entry>
                <entry>
                  2,110
                </entry>
              </row>
              <row>
                <entry>
                  <emphasis>
                    Amount Deposited in Dollars, \(y \)
                  </emphasis>
                </entry>
                <entry>
                  472
                </entry>
                <entry>
                  598
                </entry>
                <entry>
                  615
                </entry>
                <entry>
                  1,710
                </entry>
              </row>
            </tbody>
            </trgroup>
          </table>

          <para>Enter the story here: </para>
        </problem>
        <solution>
          <para>Your answer may vary, but here is an example.</para>

          <para>The amount deposited is $400 less than the monthly salary. (The employer might
            deduct $400 per paycheck for taxes, health insurance, retirement savings, and so on. Or,
            the employee might first pay $400 in rent or other expenses before depositing the rest
            of the monthly salary.) </para>

        </solution>
      </exercise>
      <!--Interaction
      End -->

      <para>For questions 5 - 8, match each table from 1 - 4 to an equation that represents the
        relationship. </para>

      <!--Q5 -->
      <exercise>
        <problem>
          <para>Equation 1: \( 400 + x = y \)</para>
          <para>Enter the table letter here: </para>
        </problem>
        <solution>
          <para>Compare your answer:</para>

          <para>Table C </para>

        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!--Q6-->
      <exercise>
        <problem>
          <para>Equation 2: \( x-400 = y \)</para>
          <para>Enter the table letter here: </para>
        </problem>
        <solution>
          <para>Compare your answer:</para>

          <para>Table D </para>

        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!--Q7 -->
      <exercise>
        <problem>
          <para>Equation 3: \( x + y = 400 \)</para>
          <para>Enter the table letter here: </para>
        </problem>
        <solution>
          <para>Compare your answer:</para>

          <para>Table B </para>

        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!--Text
      Entry Interaction Start -->
      <exercise>
        <problem>
          <para>Equation 4: \( 400⋅x = y \)</para>
          <para>Enter the table letter here: </para>
        </problem>
        <solution>
          <para>Compare your answer:</para>

          <para>Table A </para>

        </solution>
      </exercise>
      <!--Interaction
      End -->
</section>

      <section>
      <title>Extending Your Thinking</title>
      <exercise class="RFM1">
        <problem>
          <para>Express every number between 1 and 20 at least one way using exactly four 4s and any
            operations. For example, 1 could be written as \( \frac{4}{4}+4-4 \).</para>

          <para>Write your answer here:</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>

          <para>Your answer may vary, but here are some samples: </para>

          <para>\(1= \frac{4}{4}+4-4 \)\(2= \frac{4}{4}+\frac{4}{4} \)\(3=
            \sqrt4+\sqrt4-\frac{4}{4} \)\(4= \sqrt4+\sqrt4+4-4 \)\(5=
            \sqrt4+\sqrt4+\frac{4}{4} \)\(6= 4+\frac{4+4}{4} \)\(7= 4+4-\frac{4}{4} \)\(8=
            \sqrt4+\sqrt4+\sqrt4+\sqrt4 \)\(9= 4+4+\frac{4}{4} \)\(10= (4+\frac{4}{4})\sqrt4 \)\(11=
            \frac{4!\sqrt4-4}{4} \)\(12= 4(4-\frac{4}{4}) \)\(13= \frac{4!\sqrt4+4}{4} \)\(14=
            4\cdot4-\frac{4}{\sqrt4} \)\(15= 4\cdot4-\frac{4}{4} \)\(16= 4+4+4+4 \)\(17=
            4\cdot4+\frac{4}{4} \)\(18= 4\cdot4+4-\sqrt4 \)      \(19= 4!-(4+\frac{4}{4}) \)\(20=
            4(4+\frac{4}{4}) \)</para>
        </solution>
      </exercise>
      </section>

