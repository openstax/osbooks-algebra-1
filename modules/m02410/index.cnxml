      <exercise id="exer-00005">
        <problem id="prob-00007">
          <para id="para-00031">\(x^2+5x+\frac{1}{4}=0\)</para>
          <para id="para-00032">Find the exact solutions by completing the square.</para>
          <para id="para-00033">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00034">Compare your answer:</para>
          <para id="para-00035">\(\begin{array}{rcl} x^{2}+5 x+\frac{1}{4} &amp;=&amp; 0 \\ x^{2}+5 x &amp;=&amp; -\frac{1}{4} \\ x^{2}+5 x+\left(\frac{5}{2}\right)^{2} &amp;=&amp; -\frac{1}{4}+\left(\frac{5}{2}\right)^{2} \\ x^{2}+5 x+\frac{25}{4} &amp;=&amp; -\frac{1}{4}+\frac{25}{4} \\ x^{2}+5 x+\frac{25}{4} &amp;=&amp; \frac{24}{4} \\ x^{2}+5 x+\frac{25}{4} &amp;=&amp; 6 \\ \left(x+\frac{5}{2}\right)^{2} &amp;=&amp; 6 \\ \sqrt{\left(x+\frac{5}{2}\right)^{2}} &amp;=&amp; \sqrt{6} \\ x+\frac{5}{2} &amp;=&amp; \pm \sqrt{6} \\ x &amp;=&amp; -\frac{5}{2} \pm \sqrt{6} \end{array}\)</para>
        </solution>
      </exercise>
      <list class="os-raise-noindent" list-type="enumerated" id="list-00003">
        <item>Graph the equation to find approximate solutions.</item>
      </list>
      <para id="para-00036">Use the Desmos graphing tool or technology outside the course.</para>
      <media alt="...">
        <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
      </media>
      <exercise id="exer-00006">
