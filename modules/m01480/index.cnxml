<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.13.1: Comparing Functions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01480</md:content-id>
    <md:title>5.13.1: Comparing Functions</md:title>
    <md:uuid>74ab219b-02c5-492f-98b5-61a3dd793e4f</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Warm Up Activity</title>
<exercise id="exer-00001">
  <problem id="prob-00001">
    
    <para id="para-00001">Which one doesn’t belong?</para>
    
    <para id="para-00002"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>8</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mi>n</m:mi></m:msup></m:mrow></m:math></para><para id="para-00003"><m:math><m:mrow><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>·</m:mi><m:msup><m:mn>8</m:mn><m:mi>n</m:mi></m:msup></m:mrow></m:math></para><para id="para-00004"><m:math><m:mrow><m:mi>h</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>8</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>n</m:mi></m:mrow></m:math></para><para id="para-00005"><m:math><m:mrow><m:mi>j</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>8</m:mn><m:mi>·</m:mi><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mi>n</m:mi></m:msup></m:mrow></m:math></para><para id="para-00006">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00001">
  <para id="para-00007">Compare your answer: </para>
  
  <para id="para-00008"><m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math> is the only one that doubles when <m:math display="inline"><m:mrow><m:mi>n</m:mi></m:mrow></m:math> increases by 1.</para>
  
  <para id="para-00009"><m:math display="inline"><m:mrow><m:mi>g</m:mi></m:mrow></m:math> is the only one that does not have 8 for its vertical intercept.</para>
  
  <para id="para-00010"><m:math display="inline"><m:mrow><m:mi>h</m:mi></m:mrow></m:math> is the only one that is not an exponential function.</para>
  
  <para id="para-00011"><m:math display="inline"><m:mrow><m:mi>j</m:mi></m:mrow></m:math> is the only one that is not increasing.</para>

</solution></exercise>
</section>
</content></document>