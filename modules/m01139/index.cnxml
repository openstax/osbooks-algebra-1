<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Connecting the Common Ratio and the Term in a Sequence</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01139</md:content-id>
    <md:title>Connecting the Common Ratio and the Term in a Sequence</md:title>
    <md:uuid>08a494e4-71b8-4a48-9888-353caa5d297b</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
<para id="para-00001">Here is a sequence: 500, 100, 20, . . .</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002">Explain why this sequence could be a geometric sequence.</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00003">Compare your answer: </para>
    
    <para id="para-00004">The given terms have a common ratio. <m:math display="inline"><m:mrow><m:mn>100</m:mn><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>5</m:mn></m:mfrac><m:mi>·</m:mi><m:mn>500</m:mn></m:mrow></m:math>, and <m:math display="inline"><m:mrow><m:mn>20</m:mn><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>5</m:mn></m:mfrac><m:mi>·</m:mi><m:mn>100</m:mn></m:mrow></m:math>.</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00005">What is the next term?</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00006">Compare your answer:</para>
    
    <para id="para-00007"><m:math><m:mrow><m:mn>20</m:mn><m:mi>·</m:mi><m:mfrac><m:mn>1</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para></solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00008">Explain how you know the next term.</para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00009">Compare your answer:</para>
    
    <para id="para-00010">Multiplying a term by the common ratio gives the next term.</para>
  
  </solution></exercise>
<!--Interaction End --></section>
</content></document>