  <exercise data-content-id="bbdef143-5768-4382-9d92-567213e895f4" data-problem-type="multiplechoice" data-solution="\((6,1)\)" data-solution-options="[&quot;\\((9,-11)\\)&quot;, &quot;\\((1,6)\\)&quot;, &quot;\\((6,1)\\)&quot;, &quot;\\((-11,9)\\)&quot;]">
    <problem>
      <para>Solve the system by substitution, then choose the correct ordered pair. \(\left\{\begin{array}{l}-2x\;+\;y\;=\;-11\\x\;+\;3y\;=\;9\end{array}\right.\)</para>
    </problem>
    <solution>
      <para>Correct! \((6,1)\)</para>
    </solution>
        <!--END OF EXPLANATION-->
