<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.3.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01624</md:content-id>
    <md:title>6.3.6: Practice</md:title>
    <md:uuid>d8dddaa6-bf4d-4792-9923-3704da452c4f</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson. Double click on mathematical expressions/equations to enlarge.</para>

<para id="para-00002">For questions 1 - 2, find the quotients using division.</para>
<!--Do not edit this div tag.  It must surround the interaction block-->
<section id="sect-00002"><exercise id="af56f7e8-d1e7-434e-b3eb-e09a0a5bd450" class="multiple-choice"><problem id="prob-00001"><para id="para-00003">\(\frac{45x^5y^9}{-60x^8y^6}\)</para>
      <para id="para-00004">Multiple Choice:</para><para id="para-00005">\(-\frac{3x^3}{4y^3}\)</para><para id="para-00006">\(-\frac{4y^3}{3x^3}\)</para><para id="para-00007">\(-\frac{3y^3}{4x^3}\)</para><para id="para-00008">\(-\frac{3}{4}x^3y^3\)</para></problem><solution id="sol-00001"><para id="para-00009">Try again. Revisit activity 6.3.1. 
    </para><para id="para-00010">The correct answer is \(-\frac{3y^3}{4x^3}\).
    </para></solution></exercise>
      
      <exercise id="_3bf78ebd-82c8-4f1f-8b4c-05ee2395ef08" class="multiple-choice"><problem id="prob-00002"><para id="para-00011">\((48y-24x) \div (2y-x)\)</para>
      <para id="para-00012">Multiple Choice:</para><para id="para-00013">\(24\)</para><para id="para-00014">\(-24x\)</para><para id="para-00015">\(24y\)</para><para id="para-00016">\(-24\)</para></problem><solution id="sol-00002"><para id="para-00017">Try again. Revisit activity 6.3.1.
    </para><para id="para-00018">The correct answer is \(24\).
    </para></solution></exercise>
      
      <exercise id="_8c897ca2-721c-4794-b080-53466399c4be" class="multiple-choice"><problem id="prob-00003"><para id="para-00019">For questions 3 and 4, divide using long division.</para><para id="para-00020">\((m^3+1000) \div (m+10)\)</para>
      <para id="para-00021">Multiple Choice:</para><para id="para-00022">\(m^2+10m\)</para><para id="para-00023">\( m^2-100\)</para><para id="para-00024">\(m^2+10m-100\)</para><para id="para-00025">\(m^2-10m+100\)</para></problem><solution id="sol-00003"><para id="para-00026">Try again. Revisit activity 6.3.2.</para><para id="para-00027">The correct answer is \(m^2-10m+100\).
    </para></solution></exercise>
      
      <exercise id="da27cc16-8c18-479e-ae6f-af78cd8f76c1" class="multiple-choice"><problem id="prob-00004"><para id="para-00028">\((125y^3-64) \div (5y+4)\)</para>
      <para id="para-00029">Multiple Choice:</para><para id="para-00030">\(25y^2-20y+16- \frac{128}{5y+4}\)</para><para id="para-00031">\(25y^2-20y+16- \frac{64}{5y+4}\)</para><para id="para-00032">\(25y^2+20y+16\)</para><para id="para-00033">\(25y^2-20y+16\)</para></problem><solution id="sol-00004"><para id="para-00034">Try again. Revisit activity 6.3.2.
    </para><para id="para-00035">The correct answer is \(25y^2-20y+16- \frac{128}{5y+4}\).</para></solution></exercise>
      
      <exercise id="bf202dfc-071e-44eb-ab0e-101d9a6c3441" class="multiple-choice"><problem id="prob-00005"><para id="para-00036">For questions 5 - 6, divide using synthetic division.</para><para id="para-00037">\((b^3-3b^2-4b+12) \div (b+2)\)</para>
      <para id="para-00038">Multiple Choice:</para><para id="para-00039">\(b^2+5b\); remainder \(6\)</para><para id="para-00040">\( b^2-5b+6\); remainder \(0\)</para><para id="para-00041">\(b^2-5b\); remainder \(6\)</para><para id="para-00042">\(b^2+5b-6\); remainder \(0\)</para></problem><solution id="sol-00005"><para id="para-00043">Try again. Revisit activity 6.3.3.</para><para id="para-00044">The correct answer is \( b^2-5b+6\); remainder \(0\).
    </para></solution></exercise>
      
      <exercise id="_348c050e-ab7c-4194-ba9c-dc70001ba540" class="multiple-choice"><problem id="prob-00006"><para id="para-00045">\((3x^4-11x^3+2x^2+10x+6) \div (x-3)\)</para>
      <para id="para-00046">Multiple Choice:</para><para id="para-00047">\(3x^3+2x^2+4x+2\); remainder \(0\)</para><para id="para-00048">\(3x^3-20x^2-62x-180\); remainder \(0\)</para><para id="para-00049">\(3x^3-2x^2-4x-2\); remainder \(0\)</para><para id="para-00050">\(3x^3-2x^2-4x\); remainder \(-2\)</para></problem><solution id="sol-00006"><para id="para-00051">Try again. Revisit activity 6.3.3.</para><para id="para-00052">The correct answer is \(3x^3-2x^2-4x-2\); remainder \(0\).</para></solution></exercise>
      
      <exercise id="_22d7851a-2f27-4df6-8c77-1829103c897a" class="multiple-choice"><problem id="prob-00007"><para id="para-00053">For questions 7 and 8, use the following polynomial functions.</para><para id="para-00054">\(f(x)=x^2-13x+36\)
      </para>
        <para id="para-00055">\(g(x)=x-4\)</para>
      <para id="para-00056">Find \((\frac{f}{g})(x)\).</para>
      <para id="para-00057">Multiple Choice:</para><para id="para-00058">\(x+9\)</para><para id="para-00059">\(x-12\)</para><para id="para-00060">\(x-3\)</para><para id="para-00061">\(x-9\)</para></problem><solution id="sol-00007"><para id="para-00062">Try again. Revisit activity 6.3.4. 
    </para><para id="para-00063">The correct answer is \(x-9\).

    </para></solution></exercise>
      
      <exercise id="bc2aeeea-7d9b-4b1b-9759-b1227a6756df" class="multiple-choice"><problem id="prob-00008"><para id="para-00064">Find \((\frac{f}{g})(-1)\).</para>
      <para id="para-00065">Multiple Choice:</para><para id="para-00066">\(-8\)</para><para id="para-00067">\( -10\)</para>
      <para id="para-00068">\( -4\)</para><para id="para-00069">\( 8\)</para></problem><solution id="sol-00008"><para id="para-00070">Try again. Revisit activity 6.3.4.</para><para id="para-00071">The correct answer is –10.</para></solution></exercise>
      
      <exercise id="_932f9bd3-9a6c-4230-9522-bcfc683c8ce7" class="multiple-choice"><problem id="prob-00009">
        <para id="para-00072">Use the Remainder Theorem to find the remainder.</para>
          <para id="para-00073">\(f(x)=x^2-4x-9\) is divided by \(x + 2\)</para>
      <para id="para-00074">Multiple Choice:</para><para id="para-00075">3</para><para id="para-00076">21</para><para id="para-00077">-13</para><para id="para-00078">-9</para>
    </problem>
    <solution id="sol-00009"><para id="para-00079">Try again. Revisit activity 6.3.5.</para><para id="para-00080">The correct answer is 3.</para></solution></exercise>
      
      <exercise id="ef170a4b-4c96-4a7e-9036-fcf0b2a55c3a" class="multiple-choice"><problem id="prob-00010">
        <para id="para-00081">Use the Factor Theorem to determine if \(x-3\) is a factor of \(x^3-7x^2+11x+3\).
      </para>
      <para id="para-00082">Multiple Choice:</para><para id="para-00083">Yes</para><para id="para-00084">No</para></problem><solution id="sol-00010"><para id="para-00085">Try again. Revisit activity 6.3.5.
    </para><para id="para-00086">The correct answer is yes.</para></solution></exercise></section></section>
