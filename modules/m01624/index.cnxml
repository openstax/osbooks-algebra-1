<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.3.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01624</md:content-id>
    <md:title>6.3.6: Practice</md:title>
    <md:uuid>d8dddaa6-bf4d-4792-9923-3704da452c4f</md:uuid>
  </metadata>
  <content>
  <section class="practice" id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson. Double click on mathematical expressions/equations to enlarge.</para>

<para id="para-00002">For questions 1 - 2, find the quotients using division.</para>
<!--Do not edit this div tag.  It must surround the interaction block-->
<section id="sect-00002"><exercise id="af56f7e8-d1e7-434e-b3eb-e09a0a5bd450" class="multiple-choice"><problem id="prob-00001"><para id="para-00003"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>45</m:mn><m:msup><m:mi>x</m:mi><m:mn>5</m:mn></m:msup><m:msup><m:mi>y</m:mi><m:mn>9</m:mn></m:msup></m:mrow><m:mrow><m:mo>−</m:mo><m:mn>60</m:mn><m:msup><m:mi>x</m:mi><m:mn>8</m:mn></m:msup><m:msup><m:mi>y</m:mi><m:mn>6</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00004">Multiple Choice:</para><para id="para-00005"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup></m:mrow><m:mrow><m:mn>4</m:mn><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00006"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup></m:mrow><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00007"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup></m:mrow><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00008"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para></problem><solution id="sol-00001"><para id="para-00009">Try again. Revisit activity 6.3.1. 
    </para><para id="para-00010">The correct answer is <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup></m:mrow><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_3bf78ebd-82c8-4f1f-8b4c-05ee2395ef08" class="multiple-choice"><problem id="prob-00002"><para id="para-00011"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>48</m:mn><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>24</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mi>÷</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>−</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00012">Multiple Choice:</para><para id="para-00013"><m:math><m:mrow><m:mn>24</m:mn></m:mrow></m:math></para><para id="para-00014"><m:math><m:mrow><m:mo>−</m:mo><m:mn>24</m:mn><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00015"><m:math><m:mrow><m:mn>24</m:mn><m:mi>y</m:mi></m:mrow></m:math></para><para id="para-00016"><m:math><m:mrow><m:mo>−</m:mo><m:mn>24</m:mn></m:mrow></m:math></para></problem><solution id="sol-00002"><para id="para-00017">Try again. Revisit activity 6.3.1.
    </para><para id="para-00018">The correct answer is <m:math display="inline"><m:mrow><m:mn>24</m:mn></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_8c897ca2-721c-4794-b080-53466399c4be" class="multiple-choice"><problem id="prob-00003"><para id="para-00019">For questions 3 and 4, divide using long division.</para><para id="para-00020"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:msup><m:mi>m</m:mi><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:mn>1000</m:mn><m:mo stretchy="false">)</m:mo><m:mi>÷</m:mi><m:mo stretchy="false">(</m:mo><m:mi>m</m:mi><m:mo>+</m:mo><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00021">Multiple Choice:</para><para id="para-00022"><m:math><m:mrow><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>10</m:mn><m:mi>m</m:mi></m:mrow></m:math></para><para id="para-00023"><m:math><m:mrow><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>100</m:mn></m:mrow></m:math></para><para id="para-00024"><m:math><m:mrow><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>10</m:mn><m:mi>m</m:mi><m:mo>−</m:mo><m:mn>100</m:mn></m:mrow></m:math></para><para id="para-00025"><m:math><m:mrow><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>10</m:mn><m:mi>m</m:mi><m:mo>+</m:mo><m:mn>100</m:mn></m:mrow></m:math></para></problem><solution id="sol-00003"><para id="para-00026">Try again. Revisit activity 6.3.2.</para><para id="para-00027">The correct answer is <m:math display="inline"><m:mrow><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>10</m:mn><m:mi>m</m:mi><m:mo>+</m:mo><m:mn>100</m:mn></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="da27cc16-8c18-479e-ae6f-af78cd8f76c1" class="multiple-choice"><problem id="prob-00004"><para id="para-00028"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>125</m:mn><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup><m:mo>−</m:mo><m:mn>64</m:mn><m:mo stretchy="false">)</m:mo><m:mi>÷</m:mi><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00029">Multiple Choice:</para><para id="para-00030"><m:math><m:mrow><m:mn>25</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>20</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>16</m:mn><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>128</m:mn></m:mrow><m:mrow><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00031"><m:math><m:mrow><m:mn>25</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>20</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>16</m:mn><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>64</m:mn></m:mrow><m:mrow><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00032"><m:math><m:mrow><m:mn>25</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>20</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>16</m:mn></m:mrow></m:math></para><para id="para-00033"><m:math><m:mrow><m:mn>25</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>20</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>16</m:mn></m:mrow></m:math></para></problem><solution id="sol-00004"><para id="para-00034">Try again. Revisit activity 6.3.2.
    </para><para id="para-00035">The correct answer is <m:math display="inline"><m:mrow><m:mn>25</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>20</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>16</m:mn><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>128</m:mn></m:mrow><m:mrow><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="bf202dfc-071e-44eb-ab0e-101d9a6c3441" class="multiple-choice"><problem id="prob-00005"><para id="para-00036">For questions 5 - 6, divide using synthetic division.</para><para id="para-00037"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:msup><m:mi>b</m:mi><m:mn>3</m:mn></m:msup><m:mo>−</m:mo><m:mn>3</m:mn><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>12</m:mn><m:mo stretchy="false">)</m:mo><m:mi>÷</m:mi><m:mo stretchy="false">(</m:mo><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00038">Multiple Choice:</para><para id="para-00039"><m:math display="inline"><m:mrow><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>b</m:mi></m:mrow></m:math>; remainder <m:math display="inline"><m:mrow><m:mn>6</m:mn></m:mrow></m:math></para><para id="para-00040"><m:math display="inline"><m:mrow><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>6</m:mn></m:mrow></m:math>; remainder <m:math display="inline"><m:mrow><m:mn>0</m:mn></m:mrow></m:math></para><para id="para-00041"><m:math display="inline"><m:mrow><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>b</m:mi></m:mrow></m:math>; remainder <m:math display="inline"><m:mrow><m:mn>6</m:mn></m:mrow></m:math></para><para id="para-00042"><m:math display="inline"><m:mrow><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>b</m:mi><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math>; remainder <m:math display="inline"><m:mrow><m:mn>0</m:mn></m:mrow></m:math></para></problem><solution id="sol-00005"><para id="para-00043">Try again. Revisit activity 6.3.3.</para><para id="para-00044">The correct answer is <m:math display="inline"><m:mrow><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>6</m:mn></m:mrow></m:math>; remainder <m:math display="inline"><m:mrow><m:mn>0</m:mn></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_348c050e-ab7c-4194-ba9c-dc70001ba540" class="multiple-choice"><problem id="prob-00006"><para id="para-00045"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>4</m:mn></m:msup><m:mo>−</m:mo><m:mn>11</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>10</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mi>÷</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00046">Multiple Choice:</para><para id="para-00047"><m:math display="inline"><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math>; remainder <m:math display="inline"><m:mrow><m:mn>0</m:mn></m:mrow></m:math></para><para id="para-00048"><m:math display="inline"><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>−</m:mo><m:mn>20</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>62</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>180</m:mn></m:mrow></m:math>; remainder <m:math display="inline"><m:mrow><m:mn>0</m:mn></m:mrow></m:math></para><para id="para-00049"><m:math display="inline"><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>−</m:mo><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math>; remainder <m:math display="inline"><m:mrow><m:mn>0</m:mn></m:mrow></m:math></para><para id="para-00050"><m:math display="inline"><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>−</m:mo><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>x</m:mi></m:mrow></m:math>; remainder <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para></problem><solution id="sol-00006"><para id="para-00051">Try again. Revisit activity 6.3.3.</para><para id="para-00052">The correct answer is <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>−</m:mo><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math>; remainder <m:math display="inline"><m:mrow><m:mn>0</m:mn></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_22d7851a-2f27-4df6-8c77-1829103c897a" class="multiple-choice"><problem id="prob-00007"><para id="para-00053">For questions 7 and 8, use the following polynomial functions.</para><para id="para-00054"><m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>13</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>36</m:mn></m:mrow></m:math></para><para id="para-00055"><m:math><m:mrow><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00056">Find <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mi>f</m:mi></m:mrow><m:mrow><m:mi>g</m:mi></m:mrow></m:mfrac><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
      <para id="para-00057">Multiple Choice:</para><para id="para-00058"><m:math><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math></para><para id="para-00059"><m:math><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>12</m:mn></m:mrow></m:math></para><para id="para-00060"><m:math><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></para><para id="para-00061"><m:math><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math></para></problem><solution id="sol-00007"><para id="para-00062">Try again. Revisit activity 6.3.4. 
    </para><para id="para-00063">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math>.

    </para></solution></exercise>
      
      <exercise id="bc2aeeea-7d9b-4b1b-9759-b1227a6756df" class="multiple-choice"><problem id="prob-00008"><para id="para-00064">Find <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mi>f</m:mi></m:mrow><m:mrow><m:mi>g</m:mi></m:mrow></m:mfrac><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
      <para id="para-00065">Multiple Choice:</para><para id="para-00066"><m:math><m:mrow><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow></m:math></para><para id="para-00067"><m:math><m:mrow><m:mo>−</m:mo><m:mn>10</m:mn></m:mrow></m:math></para><para id="para-00068"><m:math><m:mrow><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00069"><m:math><m:mrow><m:mn>8</m:mn></m:mrow></m:math></para></problem><solution id="sol-00008"><para id="para-00070">Try again. Revisit activity 6.3.4.</para><para id="para-00071">The correct answer is –10.</para></solution></exercise>
      
      <exercise id="_932f9bd3-9a6c-4230-9522-bcfc683c8ce7" class="multiple-choice"><problem id="prob-00009">
        <para id="para-00072">Use the Remainder Theorem to find the remainder.</para>
          <para id="para-00073"><m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math> is divided by <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
      <para id="para-00074">Multiple Choice:</para><para id="para-00075">3</para><para id="para-00076">21</para><para id="para-00077">-13</para><para id="para-00078">-9</para>
    </problem>
    <solution id="sol-00009"><para id="para-00079">Try again. Revisit activity 6.3.5.</para><para id="para-00080">The correct answer is 3.</para></solution></exercise>
      
      <exercise id="ef170a4b-4c96-4a7e-9036-fcf0b2a55c3a" class="multiple-choice"><problem id="prob-00010">
        <para id="para-00081">Use the Factor Theorem to determine if <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math> is a factor of <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>−</m:mo><m:mn>7</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>11</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math>.
      </para>
      <para id="para-00082">Multiple Choice:</para><para id="para-00083">Yes</para><para id="para-00084">No</para></problem><solution id="sol-00010"><para id="para-00085">Try again. Revisit activity 6.3.5.
    </para><para id="para-00086">The correct answer is yes.</para></solution></exercise></section></section>
