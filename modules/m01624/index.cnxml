<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.3.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01624</md:content-id>
    <md:title>6.3.6: Practice</md:title>
    <md:uuid>54616f02-7e0b-444d-8569-f0aa149cf9fd</md:uuid>
  </metadata>
  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson. Double click on mathematical expressions/equations to enlarge.</para>

<para>For questions 1 - 2, find the quotients using division.</para>
<!--Do not edit this div tag.  It must surround the interaction block-->
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="7bb698b5-c7d8-4a33-93b2-3efea1d76203" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--q1-->
  <exercise data-content-id="af56f7e8-d1e7-434e-b3eb-e09a0a5bd450" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(-\frac{3y^3}{4x^3}\)" data-solution-options="[&quot;\\(-\\frac{3x^3}{4y^3}\\)&quot;, &quot;\\(-\\frac{4y^3}{3x^3}\\)&quot;, &quot;\\(-\\frac{3y^3}{4x^3}\\)&quot;, &quot;\\(-\\frac{3}{4}x^3y^3\\)&quot;]">
    <problem>
      <para>\(\frac{45x^5y^9}{-60x^8y^6}\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.3.1. 
      </para>
    </div>
    </exercise>
  <!--q2-->
  <exercise data-content-id="3bf78ebd-82c8-4f1f-8b4c-05ee2395ef08" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(24\)" data-solution-options="[&quot;\\(24\\)&quot;, &quot;\\(-24x\\)&quot;, &quot;\\(24y\\)&quot;, &quot;\\(-24\\)&quot;]">
    <problem>
      <para>\((48y-24x) \div (2y-x)\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.3.1.
      </para>
    </div>
    </exercise>
  <!--q3-->
  <exercise data-content-id="8c897ca2-721c-4794-b080-53466399c4be" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(m^2-10m+100\)" data-solution-options="[&quot;\\(m^2+10m\\)&quot;, &quot;\\( m^2-100\\)&quot;, &quot;\\(m^2+10m-100\\) &quot;, &quot;\\(m^2-10m+100\\)&quot;]">
    <problem>
      <para>For questions 3 and 4, divide using long division.</para>
      <para>\((m^3+1000) \div (m+10)\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.3.2. </para>
    </div>
    </exercise>
  <!--q4-->
  <exercise data-content-id="da27cc16-8c18-479e-ae6f-af78cd8f76c1" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(25y^2-20y+16- \frac{128}{5y+4}\)" data-solution-options="[&quot;\\(25y^2-20y+16- \\frac{128}{5y+4}\\)&quot;, &quot;\\(25y^2-20y+16- \\frac{64}{5y+4}\\)&quot;, &quot;\\(25y^2+20y+16\\)&quot;, &quot;\\(25y^2-20y+16\\)&quot;]">
    <problem>
      <para>\((125y^3-64) \div (5y+4)\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.3.2.
      </para>
    </div>
    </exercise>
  <!--q5-->
  <exercise data-content-id="bf202dfc-071e-44eb-ab0e-101d9a6c3441" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\( b^2-5b+6\); remainder \(0\)" data-solution-options="[&quot;\\(b^2+5b\\); remainder \\(6\\)&quot;, &quot;\\( b^2-5b+6\\); remainder \\(0\\)&quot;, &quot;\\(b^2-5b\\); remainder \\(6\\)&quot;, &quot;\\(b^2+5b-6\\); remainder \\(0\\)&quot;]">
    <problem>
      <para>For questions 5 - 6, divide using synthetic division.</para>
      <para>\((b^3-3b^2-4b+12) \div (b+2)\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.3.3. </para>
    </div>
    </exercise>
  <!--q6-->
  <exercise data-content-id="348c050e-ab7c-4194-ba9c-dc70001ba540" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(3x^3-2x^2-4x-2\); remainder \(0\)" data-solution-options="[&quot;\\(3x^3+2x^2+4x+2\\); remainder \\(0\\)&quot;, &quot;\\(3x^3-20x^2-62x-180\\); remainder \\(0\\)&quot;, &quot;\\(3x^3-2x^2-4x-2\\); remainder \\(0\\)&quot;, &quot;\\(3x^3-2x^2-4x\\); remainder \\(-2\\)&quot;]">
    <problem>
      <para>\((3x^4-11x^3+2x^2+10x+6) \div (x-3)\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.3.3.</para>
    </div>
    </exercise>
  <!--q7-->
  <exercise data-content-id="22d7851a-2f27-4df6-8c77-1829103c897a" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x-9\)" data-solution-options="[&quot;\\(x+9\\)&quot;, &quot;\\(x-12\\)&quot;, &quot;\\(x-3\\)&quot;, &quot;\\(x-9\\)&quot;]">
    <problem>
      <para>For questions 7 and 8, use the following polynomial functions.</para>
      <para>\(f(x)=x^2-13x+36\)
        </para>
        <para>\(g(x)=x-4\)</para>
      <para>Find \((\frac{f}{g})(x)\).</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.3.4. 
      </para>
    </div>
    </exercise>
  <!--q8-->
  <exercise data-content-id="bc2aeeea-7d9b-4b1b-9759-b1227a6756df" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\( -10\)" data-solution-options="[&quot;\\(-8\\)&quot;, &quot;\\( -10\\)&quot;, &quot;\\( -4\\)&quot;, &quot;\\( 8\\) &quot;]">
    <problem>
      <para>Find \((\frac{f}{g})(-1)\).</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.3.4.</para>
    </div>
    </exercise>
  <!--Q9-->
  <exercise data-content-id="932f9bd3-9a6c-4230-9522-bcfc683c8ce7" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="3" data-solution-options="[&quot;3&quot;, &quot;21&quot;, &quot;-13&quot;, &quot;-9&quot;]">
    <problem>
      <para>Use the Remainder Theorem to find the remainder.
          <para>\(f(x)=x^2-4x-9\) is divided by \(x + 2\)</para>
        </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.3.5. </para>
    </div>
    </exercise>
  <!--q10-->
  <exercise data-content-id="ef170a4b-4c96-4a7e-9036-fcf0b2a55c3a" data-problem-type="multiplechoice" data-retry-limit="1" data-solution="Yes" data-solution-options="[&quot;Yes&quot;, &quot;No&quot;]">
    <problem>
      <para>Use the Factor Theorem to determine if \(x-3\) is a factor of \(x^3-7x^2+11x+3\).
        </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 6.3.5.
      </para>
    </div>
    </exercise>
  <!--Do not edit below this line-->
  <solution> </solution>
  <div class="os-raise-ib-pset-encourage-response"> </div>
</div></section>
