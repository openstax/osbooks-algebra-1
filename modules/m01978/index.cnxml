  <exercise data-content-id="d5887686-b139-4874-86d2-d295948cb807" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(y=x^2+7x+12\)" data-solution-options="[&quot;\\(y=x^2-7x+12\\)&quot;, &quot;\\(y=x^2+7x+12\\)&quot;, &quot;\\(y=x^2+7x-12\\)&quot;, &quot;\\(y=x^2-7x-12\\)&quot;]">
    <problem>
      <para>Choose the quadratic equation written from the real solutions \(x=-4\) and \(x=-3\). </para>
      </problem>
