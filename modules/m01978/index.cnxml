<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>7.13.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01978</md:content-id>
    <md:title>7.13.6: Practice</md:title>
    <md:uuid>9f8ab34d-7755-42e5-800c-d5b426523ffc</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <section id="sect-00002">
        <exercise id="_10c18699-63a8-4727-aef9-554b952c18ad" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00002">Choose the quadratic equation that represents each graph.</para>
            <para id="para-00003"><media alt="&lt;p>A curve in an x y plane, origin O. Horizontal axis, scale negative 6 to 5, by 1’s. Vertical axis, scale negative 4 to 4, by 1’s. A curve passes through the points negative 2 comma 2, 0 comma 0, and 2 comma 6.&lt;/p>">
                    <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_15_13_01.svg"/>
                  </media>
                          </para>
            <para id="para-00004">Multiple Choice:</para>
            <para id="para-00005"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00006"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math></para><para id="para-00007"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00008"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math></para></problem>
          <solution id="sol-00001">
            <para id="para-00009">Correct! <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>x</m:mi></m:mrow></m:math></para>
            <para id="para-00010">Try again. Revisit activity 7.13.3.</para>
            <para id="para-00011">The correct answer is: <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>x</m:mi></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="b82293b7-d121-4b1a-af04-9a782684acca" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00012">
                          <media alt="&lt;p>A curve in an x y plane, origin O. Horizontal axis, scale negative 6 to 5, by 1’s. Vertical axis, scale negative 4 to 4, by 1’s. A curve passes through the points negative 1 comma 1, 0 comma 0, 2 comma 2.&lt;/p>">
                    <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_15_13_02.svg"/>
                  </media>
          </para>
            <para id="para-00013">Multiple Choice:</para>
            <para id="para-00014"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00015"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math></para><para id="para-00016"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00017"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math></para></problem>
          <solution id="sol-00002">
            <para id="para-00018">Correct! <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
            <para id="para-00019">Try again. Revisit activity 7.13.3.</para>
            <para id="para-00020">The correct answer is: <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_3904b634-9a02-4278-8669-0f52e59f3a73" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00021">
                          <media alt="&lt;p>A curve in an x y plane, origin O. Horizontal axis, scale negative 6 to 5, by 1’s. Vertical axis, scale negative 4 to 4, by 1’s. A curve passes through the points negative 1 comma 1, 0 comma 0, 2 comma 2.&lt;/p>">
                    <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_15_13_03.svg"/>
                  </media>
                
          </para>
            <para id="para-00022">Multiple Choice:</para>
            <para id="para-00023"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00024"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math></para><para id="para-00025"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00026"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math></para></problem>
          <solution id="sol-00003">
            <para id="para-00027">Correct! <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mi>x</m:mi></m:mrow></m:math></para>
            <para id="para-00028">Try again. Revisit activity 7.13.3.</para>
            <para id="para-00029">The correct answer is: <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mi>x</m:mi></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="ac6c8d51-6ddd-408e-8c9a-09724b084945" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00030"><media alt="&lt;p>A curve in an x y plane, origin O. Horizontal axis, scale negative 6 to 5, by 1’s. Vertical axis, scale negative 4 to 4, by 1’s. A curve passes through the points negative 3 comma 3, negative 1 comma negative 2, and 0 comma 0.&lt;/p>">
                    <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_15_13_04.svg"/>
                  </media>
                </para>
            <para id="para-00031">Multiple Choice:</para>
            <para id="para-00032"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00033"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math></para><para id="para-00034"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00035"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math></para></problem>
          <solution id="sol-00004">
            <para id="para-00036">Correct! <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math></para>
            <para id="para-00037">Try again. Revisit activity 7.13.3.</para>
            <para id="para-00038">The correct answer is: <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_47b221e5-5ecf-47ef-a87c-6397d45e81c0" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00039">Without graphing the equations, answer questions 2 – 5 to complete the table.</para>
            <table class="os-raise-wideequaltable" id="table-00001">
              <tgroup cols="3"><tbody><row>
                  <entry>
                   <emphasis>Equation</emphasis>
                  </entry>
                  <entry>
                   <emphasis><m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts</emphasis>
                  </entry>
                  <entry>
                   <emphasis><m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-coordinate of vertex</emphasis>
                  </entry>
                </row>
              <row>
                  <entry>
                    <para id="para-00040"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>x</m:mi></m:mrow></m:math></para></entry>
                  <entry>
                    <para id="para-00041">2a. _____</para>
                  </entry>
                  <entry>
                    <para id="para-00042">2b. _____</para>
                  </entry>
                </row>
                <row>
                  <entry>
                    <para id="para-00043"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math></para></entry>
                  <entry>
                    <para id="para-00044">3a. _____</para>
                  </entry>
                  <entry>
                    <para id="para-00045">3b. _____</para>
                  </entry>
                </row>
                <row>
                  <entry>
                    <para id="para-00046"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>16</m:mn><m:mi>x</m:mi></m:mrow></m:math></para></entry>
                  <entry>
                    <para id="para-00047">4a. _____</para>
                  </entry>
                  <entry>
                    <para id="para-00048">4b. _____</para>
                  </entry>
                </row>
                <row>
                  <entry>
                    <para id="para-00049"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>24</m:mn><m:mi>x</m:mi></m:mrow></m:math></para></entry>
                  <entry>
                    <para id="para-00050">5a. _____</para>
                  </entry>
                  <entry>
                    <para id="para-00051">5b. _____</para>
                  </entry>
                </row>
              </tbody></tgroup></table>
            <para id="para-00052">Find the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts and the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-coordinate of the vertex for the equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>x</m:mi></m:mrow></m:math>.</para>
            <para id="para-00053">What are the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts for the equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>x</m:mi></m:mrow></m:math>?
        </para>
            <para id="para-00054">Multiple Choice:</para>
            <para id="para-00055"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00056"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00057"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>16</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00058"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>24</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00005">
            <para id="para-00059">Correct! <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00060">Try again. Revisit activities 7.13.2 – 7.13.4.!</para>
            <para id="para-00061">The correct answer is: <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_3dcd0fb3-d5f6-4512-87e4-078c17bde828" class="multiple-choice">
          <problem id="prob-00006">
            
            <para id="para-00062">What is the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-coordinate of the vertex for the equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>x</m:mi></m:mrow></m:math>?</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00063">Correct! -6</para>
            <para id="para-00064">Try again. Revisit activities 7.13.2 – 7.13.4.</para>
            <para id="para-00065">The correct answer is -6.</para>
          </solution>
        </exercise>
        <exercise id="_14d4938b-e405-400d-93d0-80c66d6d6c8f" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00066">Find the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts and the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-coordinate of the vertex for the equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math>.</para>
            <para id="para-00067">What are the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts for the equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math>?
        </para>
            <para id="para-00068">Multiple Choice:</para>
            <para id="para-00069"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00070"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00071"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>16</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00072"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>24</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00007">
            <para id="para-00073">Correct! <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00074">Try again. Revisit activities 7.13.2 – 7.13.4.</para>
            <para id="para-00075">The correct answer is: <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_7d788c97-8fc3-4ac2-9c93-5682536af420" class="multiple-choice">
          <problem id="prob-00008">
            
            <para id="para-00076">What is the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-coordinate of the vertex for the equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math>?</para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00077">Correct! 1.5</para>
            <para id="para-00078">Try again. Revisit activities 7.13.2 – 7.13.4.</para>
            <para id="para-00079">The correct answer is 1.5.</para>
          </solution>
        </exercise>
        <exercise id="_44d02fe9-ead0-4214-a431-386e3bc84345" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00080">Find the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts and the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-coordinate of the vertex for the equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>16</m:mn><m:mi>x</m:mi></m:mrow></m:math>.</para>
            <para id="para-00081">What are the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts for the equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>16</m:mn><m:mi>x</m:mi></m:mrow></m:math>?
        </para>
            <para id="para-00082">Multiple Choice:</para>
            <para id="para-00083"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00084"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00085"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>16</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00086"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>24</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00009">
            <para id="para-00087">Correct! <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>16</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00088">Try again. Revisit activities 7.13.2 – 7.13.4.</para>
            <para id="para-00089">The correct answer is: <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>16</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="c941cd33-a878-4346-989f-33be17d96f3b" class="multiple-choice">
          <problem id="prob-00010">
            
            <para id="para-00090">What is the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-coordinate of the vertex for the equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>16</m:mn><m:mi>x</m:mi></m:mrow></m:math>?</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00091">Correct! 8</para>
            <para id="para-00092">Try again. Revisit activity 7.13.3.</para>
            <para id="para-00093">The correct answer is 8.</para>
          </solution>
        </exercise>
        <exercise id="daee3cea-92e3-4ed5-bfa5-8ec55ee29adb" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00094">Find the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts and the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-coordinate of the vertex for the equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>24</m:mn><m:mi>x</m:mi></m:mrow></m:math>.</para>
            <para id="para-00095">What are the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts for the equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>24</m:mn><m:mi>x</m:mi></m:mrow></m:math>?
        </para>
            <para id="para-00096">Multiple Choice:</para>
            <para id="para-00097"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00098"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00099"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>16</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00100"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>24</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00011">
            <para id="para-00101">Correct! <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>24</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00102">Try again. Revisit activities 7.13.3 and 7.13.4.</para>
            <para id="para-00103">The correct answer is:<m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>24</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="f7b96024-18a1-40e0-9882-0fa5a72c36e2" class="multiple-choice">
          <problem id="prob-00012">
            
            <para id="para-00104">What is the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-coordinate of the vertex for the equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>24</m:mn><m:mi>x</m:mi></m:mrow></m:math>?</para>
          </problem>
          <solution id="sol-00012">
            <para id="para-00105">Correct! -12</para>
            <para id="para-00106">Try again. Revisit activity 7.13.3.</para>
            <para id="para-00107">The correct answer is -12.</para>
          </solution>
        </exercise>
        <exercise id="d6cf80d4-5580-4e13-8a35-00fd2bee55ae" class="multiple-choice">
          <problem id="prob-00013">
            <para id="para-00108">Here is a graph that represents <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>.    </para>

          <para id="para-00109">(<media alt=" &lt;p>A curve in an x y plane, origin O. Horizontal axis, scale negative 8 to 8, by 2’s. Vertical axis, scale negative 12 to 12, by 2’s. A curve, labeled y equals x squared, passes through the points negative 2 comma 4, 0 comma 0, and 2 comma 4.&lt;/p>"><image mime-type="image/svg+xml" src="../../media/Algebra-1_08_15_13_05.svg"/></media>)</para>
  
            <para id="para-00110">Describe what would happen to the graph if the original equation were changed to <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi></m:mrow></m:math>.
      </para>
            <para id="para-00111">Multiple Choice:</para>
            <para id="para-00112">The graph would move to the right and down.</para>
            <para id="para-00113">The graph would move to the left and down.</para>
            <para id="para-00114">The graph would move to the right and up.</para>
            <para id="para-00115">The graph would move to the left and up.</para>
          </problem>
          <solution id="sol-00013">
            <para id="para-00116">Correct! The graph would move to the right and down.</para>
            <para id="para-00117">Try again. Revisit activity 7.13.3.</para>
            <para id="para-00118">The correct answer is: The graph would move to the right and down.</para>
          </solution>
        </exercise>
        <exercise id="_3ca7ea2c-96ba-4c27-973a-0a56c436cdc1" class="multiple-choice">
          <problem id="prob-00014">
            <para id="para-00119">Predict the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts of the graph if the original equation were changed to <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi></m:mrow></m:math>.</para>
            <para id="para-00120">Multiple Choice:</para>
            <para id="para-00121"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00122"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00123"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00124"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00014">
            <para id="para-00125">Correct! <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00126">Try again. Revisit activity 7.13.3.</para>
            <para id="para-00127">The correct answer is:<m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_430d5ce7-c22e-4d78-bbf5-ec84afbfdc46" class="multiple-choice">
          <problem id="prob-00015">
            <para id="para-00128">In which quadrant is the vertex located if the original equation were changed to <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi></m:mrow></m:math>?</para>
          </problem>
          <solution id="sol-00015">
            <para id="para-00129">Correct! Fourth Quadrant</para>
            <para id="para-00130">Try again. Revisit activity 7.13.3.</para>
            <para id="para-00131">The correct answer is: Fourth Quadrant.</para>
          </solution>
        </exercise>
        <exercise id="acf83bce-9750-4918-a6ff-1dcc561f61ac" class="multiple-choice">
          <problem id="prob-00016">
            <para id="para-00132"><emphasis>Select two</emphasis> equations whose graph opens upward.</para>
          </problem>
          <solution id="sol-00016">
            <para id="para-00133">Correct! <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>8</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>7</m:mn></m:mrow></m:math></para>
            <para id="para-00134">Try again. Revisit activity 7.13.3.</para>
            <para id="para-00135">The correct answers are: <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>8</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>7</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_0e291e11-6eef-42fb-9eeb-31e8067d7732" class="multiple-choice">
          <problem id="prob-00017">
            <para id="para-00136">Graph A</para>
            <para id="para-00137">Technology required. Use the three graphs to answer questions a–c. Then, use graphing technology to check each equation.</para>
            <para id="para-00138">
                      <media alt="Parabola. Opens up. X intercepts = 0&amp;nbsp;and -7.&amp;nbsp;">
                  <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_15_13_06.svg"/>
                </media>
              
          </para>
            <para id="para-00139">Graph B</para>
            <para id="para-00140">
                      <media alt="Parabola. Opens up. Vertex = 0&amp;nbsp;comma -16.&amp;nbsp;X intercepts = -4 and 4.&amp;nbsp;">
                  <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_15_13_07.svg"/>
                </media>
              
          </para>
            <para id="para-00141">Graph C</para>
            <para id="para-00142">
                      <media alt="Parabola. Opens up. X intercepts = -9&amp;nbsp;and 3.&amp;nbsp;">
                  <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_15_13_08.svg"/>
                </media>
              
          </para>
            <para id="para-00143">Which graph represents the equation <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>x</m:mi></m:mrow></m:math>? Then, use graphing technology to check your answer.</para>
          </problem>
          <solution id="sol-00017">
            <para id="para-00144">Correct! Graph A</para>
            <para id="para-00145">Try again. Revisit activities 7.13.2 – 7.13.4.</para>
            <para id="para-00146">The correct answer is: Graph A.</para>
          </solution>
        </exercise>
        <exercise id="ed2a78ec-d3d7-400c-bbf2-5f40578b5460" class="multiple-choice">
          <problem id="prob-00018">
            <para id="para-00147">Which graph represents the equation <m:math display="inline"><m:mrow><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>16</m:mn></m:mrow></m:math>? Then, use graphing technology to check your answer.</para>
          </problem>
          <solution id="sol-00018">
            <para id="para-00148">Correct! Graph B</para>
            <para id="para-00149">Try again. Revisit activities 7.13.2 – 7.13.4.</para>
            <para id="para-00150">The correct answer is: Graph B.</para>
          </solution>
        </exercise>
        <exercise id="_437286ec-77dc-4d6c-a768-4e4ee1a8bd6a" class="multiple-choice">
          <problem id="prob-00019">
            <para id="para-00151">Which graph represents the equation <m:math display="inline"><m:mrow><m:mi>h</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mi>h</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>27</m:mn></m:mrow></m:math>? Then, use graphing technology to check your answer.</para>
          </problem>
          <solution id="sol-00019">
            <para id="para-00152">Correct! Graph C</para>
            <para id="para-00153">Try again. Revisit activities 7.13.2 – 7.13.4.</para>
            <para id="para-00154">The correct answer is: Graph C.</para>
          </solution>
        </exercise>
      </section>
      <!--BEGIN PRACTICE PROBLEM MULTIPLE CHOICE -->
        <exercise id="d5887686-b139-4874-86d2-d295948cb807" class="multiple-choice">
          <problem id="prob-00020">
            <para id="para-00155">Choose the quadratic equation written from the real solutions <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math>.</para>
            <para id="para-00156">Multiple Choice:</para>
            <para id="para-00157"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>12</m:mn></m:mrow></m:math></para><para id="para-00158"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>12</m:mn></m:mrow></m:math></para><para id="para-00159"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>12</m:mn></m:mrow></m:math></para><para id="para-00160"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>12</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00020">
            <para id="para-00161">Correct! <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>12</m:mn></m:mrow></m:math></para>
            <para id="para-00162">Try again. Revisit activity 7.13.4.</para>
            <para id="para-00163">The correct answer is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>12</m:mn></m:mrow></m:math>.</para>
            <para id="para-00164"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math> means that <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math>. <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>12</m:mn><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>12</m:mn><m:mo>.</m:mo></m:mrow></m:math>
    </para>
          </solution>
        </exercise>
 
      <!--END PRACTICE PROBLEM MULTIPLE CHOICE -->
    </section>
  </content>
