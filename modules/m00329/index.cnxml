<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.15.1: Solving Proportions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00329</md:content-id>
    <md:title>1.15.1: Solving Proportions</md:title>
    <md:uuid>2606d736-afed-44ae-84ae-8b1625ebfc5c</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001"><title>Warm Up</title>
      <para id="para-00001">Solve each of the following proportions:</para>
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002"><m:math><m:mrow><m:mfrac><m:mrow><m:mi>x</m:mi></m:mrow><m:mrow><m:mn>56</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>7</m:mn></m:mrow><m:mrow><m:mn>8</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para></problem>
        <solution id="sol-00001">
          <para id="para-00003">Compare your answer:</para>
          <table class="unnumbered os-raise-textheavytable unnumbered" id="table-00001">
            <tgroup cols="2">
              <tbody>
                <row>
                  <entry/>
                  <entry/>
                </row>
                <row>
                  <entry>Cross multiply.</entry>
                  <entry><m:math><m:mrow><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>7</m:mn><m:mo stretchy="false">(</m:mo><m:mn>56</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></entry>
                </row>
                <row>
                  <entry>Simplify.</entry>
                  <entry><m:math><m:mrow><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>392</m:mn></m:mrow></m:math></entry>
                </row>
                <row>
                  <entry>Divide both sides by 8.</entry>
                  <entry><m:math><m:mrow><m:mfrac><m:mrow><m:mn>8</m:mn><m:mi>x</m:mi></m:mrow><m:mrow><m:mn>8</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>392</m:mn></m:mrow><m:mrow><m:mn>8</m:mn></m:mrow></m:mfrac></m:mrow></m:math></entry>
                </row>
                <row>
                  <entry>Simplify.</entry>
                  <entry><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>49</m:mn></m:mrow></m:math></entry>
                </row>
              </tbody>
            </tgroup>
          </table>
        </solution>
      </exercise>
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00004"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>56</m:mn></m:mrow><m:mrow><m:mn>72</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>y</m:mi></m:mrow><m:mrow><m:mn>9</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para></problem>
        <solution id="sol-00002">
          <para id="para-00005">Compare your answer:</para>
          <table class="unnumbered os-raise-textheavytable unnumbered" id="table-00002">
            <tgroup cols="2">
              <tbody>
                <row>
                  <entry/>
                  <entry/>
                </row>
                <row>
                  <entry>Cross multiply.</entry>
                  <entry><m:math><m:mrow><m:mn>56</m:mn><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>72</m:mn><m:mi>y</m:mi></m:mrow></m:math></entry>
                </row>
                <row>
                  <entry>Simplify.</entry>
                  <entry><m:math><m:mrow><m:mn>504</m:mn><m:mo>=</m:mo><m:mn>72</m:mn><m:mi>y</m:mi></m:mrow></m:math></entry>
                </row>
                <row>
                  <entry>Divide both sides by 72.</entry>
                  <entry><m:math><m:mrow><m:mfrac><m:mrow><m:mn>504</m:mn></m:mrow><m:mrow><m:mn>72</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>72</m:mn><m:mi>y</m:mi></m:mrow><m:mrow><m:mn>72</m:mn></m:mrow></m:mfrac></m:mrow></m:math></entry>
                </row>
                <row>
                  <entry>Simplify.</entry>
                  <entry><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></entry>
                </row>
              </tbody>
            </tgroup>
          </table>
        </solution>
      </exercise>
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00006"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>98</m:mn></m:mrow><m:mrow><m:mn>154</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow><m:mrow><m:mi>p</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para></problem>
        <solution id="sol-00003">
          <para id="para-00007">Compare your answer:</para>
          <table class="unnumbered os-raise-textheavytable unnumbered" id="table-00003">
            <tgroup cols="2">
              <tbody>
                <row>
                  <entry/>
                  <entry/>
                </row>
                <row>
                  <entry>Cross multiply.</entry>
                  <entry><m:math><m:mrow><m:mn>98</m:mn><m:mi>p</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>7</m:mn><m:mo stretchy="false">(</m:mo><m:mn>154</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></entry>
                </row>
                <row>
                  <entry>Simplify.</entry>
                  <entry><m:math><m:mrow><m:mn>98</m:mn><m:mi>p</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1078</m:mn></m:mrow></m:math></entry>
                </row>
                <row>
                  <entry>Divide both sides by 98.</entry>
                  <entry><m:math><m:mrow><m:mfrac><m:mrow><m:mn>98</m:mn><m:mi>p</m:mi></m:mrow><m:mrow><m:mn>98</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>1078</m:mn></m:mrow><m:mrow><m:mn>98</m:mn></m:mrow></m:mfrac></m:mrow></m:math></entry>
                </row>
                <row>
                  <entry>Simplify.</entry>
                  <entry><m:math><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>11</m:mn></m:mrow></m:math></entry>
                </row>
              </tbody>
            </tgroup>
          </table>
        </solution>
      </exercise>
    </section>
  </content>
</document>