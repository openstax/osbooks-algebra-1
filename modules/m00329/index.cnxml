<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.15.1: Solving Proportions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00329</md:content-id>
    <md:title>1.15.1: Solving Proportions</md:title>
    <md:uuid>2606d736-afed-44ae-84ae-8b1625ebfc5c</md:uuid>
  </metadata>
  <content>
    <section>
      <title>Warm Up Activity</title>
      <para>Solve each of the following proportions:</para>
      <exercise>
        <problem>
          <para>\( \frac{x}{56} = \frac{7}{8} \)</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <table class="os-raise-textheavytable unnumbered">
            <tgroup cols="2">
              <tbody>
                <row>
                  <entry></entry>
                  <entry></entry>
                </row>
                <row>
                  <entry>Cross multiply.</entry>
                  <entry>\( 8x = 7(56) \)</entry>
                </row>
                <row>
                  <entry>Simplify.</entry>
                  <entry>\( 8x = 392 \)</entry>
                </row>
                <row>
                  <entry>Divide both sides by 8.</entry>
                  <entry>\( \frac{8x}{8}=\frac{392}{8} \)</entry>
                </row>
                <row>
                  <entry>Simplify.</entry>
                  <entry>\( x=49 \)</entry>
                </row>
              </tbody>
            </tgroup>
          </table>
        </solution>
      </exercise>
      <exercise>
        <problem>
          <para>\( \frac{56}{72} = \frac{y}{9} \)</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <table class="os-raise-textheavytable unnumbered">
            <tgroup cols="2">
              <tbody>
                <row>
                  <entry></entry>
                  <entry></entry>
                </row>
                <row>
                  <entry>Cross multiply.</entry>
                  <entry>\( 56(9)=72y \)</entry>
                </row>
                <row>
                  <entry>Simplify.</entry>
                  <entry>\( 504 =72y \)</entry>
                </row>
                <row>
                  <entry>Divide both sides by 72.</entry>
                  <entry>\( \frac{504}{72}=\frac{72y}{72} \)</entry>
                </row>
                <row>
                  <entry>Simplify.</entry>
                  <entry>\( x=7 \)</entry>
                </row>
              </tbody>
            </tgroup>
          </table>
        </solution>
      </exercise>
      <exercise>
        <problem>
          <para>\( \frac{98}{154} = \frac{-7}{p} \)</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <table class="os-raise-textheavytable unnumbered">
            <tgroup cols="2">
              <tbody>
                <row>
                  <entry></entry>
                  <entry></entry>
                </row>
                <row>
                  <entry>Cross multiply.</entry>
                  <entry>\( 98p= -7(154) \)</entry>
                </row>
                <row>
                  <entry>Simplify.</entry>
                  <entry>\( 98p = -1078 \)</entry>
                </row>
                <row>
                  <entry>Divide both sides by 98.</entry>
                  <entry>\( \frac{98p}{98}=\frac{-1078}{98} \)</entry>
                </row>
                <row>
                  <entry>Simplify.</entry>
                  <entry>\( p = -11 \)</entry>
                </row>
              </tbody>
            </tgroup>
          </table>
        </solution>
      </exercise>
    </section>
  </content>
</document>