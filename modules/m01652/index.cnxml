                <m:mi>x</m:mi>
                <m:mo>−</m:mo>
                <m:mn>5</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mtd>
            </m:mtr>
            <m:mtr>
              <m:mtd>
                <m:mn>4</m:mn>
                <m:mi>x</m:mi>
                <m:mo stretchy="false">(</m:mo>
