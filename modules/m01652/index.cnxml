                <m:mo>−</m:mo>
                <m:mn>10</m:mn>
                <m:mi>x</m:mi>
                <m:mi>y</m:mi>
                <m:mo>−</m:mo>
                <m:mn>27</m:mn>
                <m:mi>x</m:mi>
                <m:mi>y</m:mi>
                <m:mo>+</m:mo>
                <m:mn>15</m:mn>
                <m:msup>
                  <m:mi>y</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mtd>
            </m:mtr>
            <m:mtr>
              <m:mtd columnalign="center">
                <m:mn>18</m:mn>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>−</m:mo>
                <m:mn>37</m:mn>
                <m:mi>x</m:mi>
                <m:mi>y</m:mi>
                <m:mo>+</m:mo>
                <m:mn>15</m:mn>
                <m:msup>
                  <m:mi>y</m:mi>
