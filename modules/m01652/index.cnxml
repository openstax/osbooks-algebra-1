                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>5</m:mn>
                <m:mi>x</m:mi>
                <m:mo>−</m:mo>
                <m:mi>x</m:mi>
                <m:mo>−</m:mo>
                <m:mn>5</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mtd>
            </m:mtr>
            <m:mtr>
              <m:mtd>
                <m:mn>4</m:mn>
                <m:mi>x</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>4</m:mn>
                <m:mi>x</m:mi>
                <m:mo>−</m:mo>
                <m:mn>5</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mtd>
            </m:mtr>
            <m:mtr>
              <m:mtd>
                <m:mn>4</m:mn>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>3</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>16</m:mn>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
