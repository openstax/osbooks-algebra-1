  <title>Interpret Slope and <emphasis effect="italics">y</emphasis>-intercept: Mini-Lesson Review</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00679</md:content-id>
    <md:title>Interpret Slope and y-intercept: Mini-Lesson
