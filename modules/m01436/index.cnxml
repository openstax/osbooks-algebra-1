</table>

<para>Answer:</para>
<para>Your answer may vary, but here is a sample.</para>
<table class="os-raise-wideequaltable">
  <thead>
    <row>
      <entry><emphasis>\(n\), Number of Bounces</emphasis></entry><entry><emphasis>\(a\), Height for Ball 1 (cm)</emphasis></entry><entry><emphasis>\(b\), Height for Ball 2 (cm)</emphasis></entry><entry><emphasis>\(c\), Height for Ball 3 (cm)</emphasis></entry></row>
  </thead>
  <tbody>
    <row>
      <entry>
        0
      </entry>
      <entry>
        150
      </entry>
      <entry>
        150
      </entry>
      <entry>
        150
      </entry>
    </row>
    <row>
      <entry>
        1
      </entry>
      <entry>
        80
      </entry>
      <entry>
        100
      </entry>
      <entry>
        60
      </entry>
    </row>
    <row>
      <entry>
        2
      </entry>
      <entry>
        41
      </entry>
      <entry>
        70
      </entry>
