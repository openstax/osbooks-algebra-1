  <title>5.3.3: Compare and Contrast Two Patterns</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01279</md:content-id>
    <md:title>5.3.3: Compare and Contrast Two Patterns</md:title>
