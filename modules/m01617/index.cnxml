<exercise>
  <problem>
    <para> \((2x^3-11x^2+16x-12) \div (x -4)\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
  <para>Compare your answer:</para>
    
    <para>\(2x^2-3x+4\); remainder of 4</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(
        (x^4-9x^2+2x+6) \div (x + 3)\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
  <para>Compare your answer:</para>
    
    <para>\(x^3-3x^2+2\); remainder of 0</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\((3x^4-11x^3+2x^2+10x+6) \div (x - 3)\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
  <para>Compare your answer:</para>
    
    <para>\(3x^3-2x^2-4x-2\); remainder of 0</para>
  
  </solution></exercise>
