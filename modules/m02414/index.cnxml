<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.5.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02414</md:content-id>
    <md:title>9.5.5: Practice</md:title>
    <md:uuid>4cbe3f97-2268-47fa-8be5-f6442c835cf7</md:uuid>
  </metadata>
  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="348c07f9-ba13-4f89-9546-1482d49b1cd2" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--1a-->
  <exercise data-content-id="aa770c91-6152-463d-9f99-edbe3fb79379" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x= \pm\; 12\)" data-solution-options="[&quot;\\(x= \\pm\\; 144\\)&quot;, &quot;\\(x= \\pm\\; 72\\)&quot;, &quot;\\(x= \\pm\\; 12\\)&quot;, &quot;\\(x= \\pm\\; 24\\)&quot;]">
    <problem>
      <para>Solve each equation and write the solutions using the ± notation, then choose the correct solution from the list.</para>
      <para>\(x^2=144\)</para>
      </problem>
    <solution>
      <para>Correct! \(x= \pm\; 12\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.5.2.</para>
    </div>
    </exercise>
  <!--1b-->
  <exercise data-content-id="9c17d561-1f7d-4b84-a828-eb6bc2674a19" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x= \pm\; \sqrt{5}\) " data-solution-options="[&quot;\\(x= \\pm\\; \\sqrt{5}\\) &quot;, &quot;\\(x= \\pm\\; 5\\)&quot;, &quot;\\(x= \\pm\\; \\frac{5}{2}\\)&quot;, &quot;\\(x= \\pm\\; \\sqrt{10}\\) &quot;]">
    <problem>
      <para>\(x^2=5\)</para>
      </problem>
    <solution>
      <para>Correct! \(x= \pm\; \sqrt{5}\) </para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.5.2.</para>
    </div>
    </exercise>
  <!--1c-->
  <exercise data-content-id="5a29821c-570d-4176-b0ad-403f43515e37" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x= \pm\; \sqrt{7}\)" data-solution-options="[&quot;\\(x= \\pm\\; \\sqrt {\\frac{7}{2}}\\)&quot;, &quot;\\( x= \\pm\\; 7\\)&quot;, &quot;\\(x= \\pm\\; \\frac{7}{2}\\)&quot;, &quot;\\(x= \\pm\\; \\sqrt{7}\\)&quot;]">
    <problem>
      <para>\(4x^2=28\)</para>
      </problem>
    <solution>
      <para>Correct! \(x= \pm\; \sqrt{7}\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.5.2.</para>
    </div>
    </exercise>
  <!--1d-->
  <exercise data-content-id="c8664b91-9471-408e-8c77-c482d15e691b" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x= \pm\; \frac{5}{2}\)" data-solution-options="[&quot;\\(x= \\pm\\; \\frac{25}{4}\\)&quot;, &quot;\\(x= \\pm\\; \\frac{5}{2}\\)&quot;, &quot;\\(x= \\pm\\; \\frac{10}{2}\\)&quot;, &quot;\\(x= \\pm\\; \\frac{5}{4}\\)&quot;]">
    <problem>
      <para>\(x^2=\frac{25}{4}\)</para>
      </problem>
    <solution>
      <para>Correct! \(x= \pm\; \frac{5}{2}\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.5.2.</para>
    </div>
    </exercise>
  <!--1e-->
  <exercise data-content-id="09ef6dde-3940-48ed-97eb-ffffc682c2d7" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x= \pm\; \sqrt{11}\)" data-solution-options="[&quot;\\(x= \\pm\\; \\sqrt{\\frac{11}{2}}\\)&quot;, &quot;\\(x= \\pm\\; 11\\)&quot;, &quot;\\(x= \\pm\\; \\frac{11}{2}\\)&quot;, &quot;\\(x= \\pm\\; \\sqrt{11}\\)&quot;]">
    <problem>
      <para>\(2x^2=22\)</para>
      </problem>
    <solution>
      <para>Correct! \(x= \pm\; \sqrt{11}\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.5.2.</para>
    </div>
    </exercise>
  <!--1f-->
  <exercise data-content-id="5a8ed6eb-d457-4dca-a7ae-6ff48710eb3a" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x= \pm\; \sqrt{\frac{16}{7}}\)" data-solution-options="[&quot;\\(x= \\pm\\; \\sqrt{\\frac{16}{7}}\\)&quot;, &quot;\\(x= \\pm\\; 16\\)&quot;, &quot;\\(x= \\pm\\; 8\\)&quot;, &quot;\\(x= \\pm\\; \\frac {\\sqrt{16}}{7}\\)&quot;]">
    <problem>
      <para>\(7x^2=16\)</para>
      </problem>
    <solution>
      <para>Correct! \(x= \pm\; \sqrt{\frac{16}{7}}\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.5.2.</para>
    </div>
    </exercise>
  <!--2a-->
  <exercise data-content-id="20fac294-8500-40b9-9be9-801062d93322" data-problem-type="multiplechoice" data-retry-limit="4" data-solution="8 and 12" data-solution-options="[&quot;-17 and 5 &quot;, &quot;\\(4+ \\sqrt{2}\\) and \\(4- \\sqrt{2}\\)&quot;, &quot;8 and 12&quot;, &quot;3 and 5&quot;, &quot;\\(4+ \\sqrt{10}\\) and \\(4- \\sqrt{10}\\)&quot;]">
    <problem>
      <para>For each expression, choose an equivalent expression.</para>
      <para>\(10 \pm \sqrt{4}\)</para>
      </problem>
    <solution>
      <para>Correct! 8 and 12</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.5.2.</para>
    </div>
    </exercise>
  <!--2b-->
  <exercise data-content-id="1d3cc2ba-12ad-404c-ba1d-48d5c65f7deb" data-problem-type="multiplechoice" data-retry-limit="4" data-solution="\(4+ \sqrt{10}\) and \(4- \sqrt{10}\)" data-solution-options="[&quot;-17 and 5&quot;, &quot;\\(4+ \\sqrt{2}\\) and \\(4- \\sqrt{2}\\)&quot;, &quot;8 and 12&quot;, &quot;3 and 5&quot;, &quot;\\(4+ \\sqrt{10}\\) and \\(4- \\sqrt{10}\\)&quot;]">
    <problem>
      <para>\(4 \pm \sqrt{10}\)</para>
      </problem>
    <solution>
      <para>Correct! \(4+ \sqrt{10}\) and \(4- \sqrt{10}\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.5.2.</para>
    </div>
    </exercise>
  <!--2c-->
  <exercise data-content-id="46a3bfd3-b470-45a0-af0e-3026a58aed89" data-problem-type="multiplechoice" data-retry-limit="4" data-solution="\(4+ \sqrt{2}\) and \(4- \sqrt{2}\)" data-solution-options="[&quot;-17 and 5 &quot;, &quot;\\(4+ \\sqrt{2}\\) and \\(4- \\sqrt{2}\\)&quot;, &quot;8 and 12&quot;, &quot;3 and 5&quot;, &quot;\\(4+ \\sqrt{10}\\) and \\(4- \\sqrt{10}\\)&quot;]">
    <problem>
      <para>\(\sqrt{16} \pm \sqrt{2}\)</para>
      </problem>
    <solution>
      <para>Correct! \(4+ \sqrt{2}\) and \(4- \sqrt{2}\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.5.2.</para>
    </div>
    </exercise>
  <!--3-->
  <exercise data-content-id="d5a44196-2396-47d2-90b8-0c135a49cdd2" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(\sqrt{9}\) is equal to 3, while there are two numbers that make \(x^2=9\) true: 3 and -3." data-solution-options="[&quot;\\(\\sqrt{9}\\) is equal to 3, while \\(x^2=9\\) is equal to -3.&quot;, &quot;\\(\\sqrt{9}\\) is equal to -3, while there are two numbers that make \\(x^2=9\\) true: 3 and -3.&quot;, &quot;\\(\\sqrt{9}\\) is equal to 3, while there are two numbers that make \\(x^2=9\\) true: 3 and -3.&quot;, &quot;There is no difference; they are equal.&quot;]">
    <problem>
      <para>What is the difference between \(\sqrt{9}\) and the solutions to \(x^2=9\)?</para>
      </problem>
    <solution>
      <para>Correct! \(\sqrt{9}\) is equal to 3, while there are two numbers that make \(x^2=9\) true: 3 and -3.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.5.2.</para>
    </div>
    </exercise>
  <!--4a-->
  <exercise data-content-id="5828e49f-09bc-4b72-b74e-42464e580ef1" data-problem-type="multiselect" data-solution="[&quot;\\(x= -5+ \\sqrt{17}\\)&quot;, &quot;\\(x= -5- \\sqrt{17}\\)&quot;]" data-solution-options="[&quot;\\(x= -5+ \\sqrt{17}\\)&quot;, &quot;\\(x=5+ \\sqrt{17}\\)&quot;, &quot;\\(x=5- \\sqrt{17}\\)&quot;, &quot;\\(x= -5- \\sqrt{17}\\)&quot;]">
    <problem>
      <para>Technology required. For each equation, find the exact solutions by completing the square and the approximate solutions by graphing. Then, verify that the solutions found using the two methods are close.</para>
      <para> Solve the equation \(x^2+10x+8=0\) by completing the square. <emphasis>Select two</emphasis> exact solutions.</para>
      </problem>
    <solution>
      <para>Correct! \(x= -5+ \sqrt{17}\), \(x= -5- \sqrt{17}\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.5.2.</para>
    </div>
    </exercise>
  <!--4b-->
  <exercise data-content-id="8b10c10d-c9c2-4abe-8642-97d37b21e99f" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="D" data-solution-options="[&quot;A&quot;, &quot;B&quot;, &quot;C&quot;, &quot;D&quot;]">
    <problem>
      <para>Choose the graph that best represents the equation \(x^2+10x+8=0\).</para>
      <para> <figure><media alt=""><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/9406eab7a0c9ca8be81ab3b1231099c82f6740b8"/></media></figure></para>
      <para> <figure><media alt=""><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/ce2e1c819f40a1056015664904a30aa436866e09"/></media></figure></para>
      <para> <figure><media alt=""><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/2ef2964dd6a6f0f40ff2b04d05a30c9db470be0d"/></media></figure></para>
      <para> <figure><media alt=""><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/c49ec8e6ffdb34fd50c28da8cff08ace3d38cab2"/></media></figure></para>
      </problem>
    <solution>
      <para>Correct! <figure><media alt=""><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/c49ec8e6ffdb34fd50c28da8cff08ace3d38cab2"/></media></figure></para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.5.2.</para>
    </div>
    </exercise>
  <!--4c-->
  <exercise data-content-id="9b88a133-7601-4a81-aaf9-41c2a596d0a0" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="They are similar because the solutions are close." data-solution-options="[&quot;They are not similar.&quot;, &quot;They are similar because the solutions are close.&quot;, &quot;They are not similar because the square root of a number is always positive.&quot;, &quot;They are similar because the square root of a number is always positive.&quot;]">
    <problem>
      <para>Are the solutions and the graph for the equation \(x^2+10x+8=0\) similar? </para>
      </problem>
    <solution>
      <para>Correct! They are similar because the solutions are close. \(-5- \sqrt{17} \approx -9.123\) and \(-5+ \sqrt{17} \approx -0.877\).</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 9.5.3 and 9.5.4.</para>
    </div>
    </exercise>
  <!--5a-->
  <exercise data-content-id="1dd47cdf-1502-4859-b8b9-851a99c3e986" data-problem-type="multiselect" data-solution="[&quot;\\(x=2+ \\sqrt{15}\\)&quot;, &quot;\\(x=2- \\sqrt{15}\\)&quot;]" data-solution-options="[&quot;\\(x=-2+ \\sqrt{15}\\)&quot;, &quot;\\(x=2+ \\sqrt{15}\\)&quot;, &quot;\\(x=2- \\sqrt{15}\\)&quot;, &quot;\\(x=-2- \\sqrt{15}\\)&quot;]">
    <problem>
      <para>Answer the following questions about \(x^2-4x-11=0\).</para>
      <para>Solve the equation \(x^2-4x-11=0\) by completing the square. <emphasis>Select two</emphasis> exact solutions.</para>
      </problem>
    <solution>
      <para>Correct! \(x=2+ \sqrt{15}\), \(x=2-\sqrt{15}\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.5.2.</para>
    </div>
    </exercise>
  <!--5b-->
  <exercise data-content-id="7384b198-2183-4abe-8b9c-9747c72b0b8f" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="A" data-solution-options="[&quot;A&quot;, &quot;B&quot;, &quot;C&quot;, &quot;D&quot;]">
    <problem>
      <para>Choose the graph that best represents the equation \(x^2-4x-11=0\).    </para>
      <para> <figure><media alt=""><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/041e8dc43448e170283ce1fa6d615adfe3dac8e4"/></media></figure></para>
      <para> <figure><media alt=""><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/e93edafd840fe7d3ab7494edb47bcf276250779b"/></media></figure></para>
      <para> <figure><media alt=""><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/03435b7e473da5a2f72742a8f6b0c0a119cb9379"/></media></figure></para>
      <para> <figure><media alt=""><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/dcd702a64a9589ebd4139bc950b0487352e9b6d4"/></media></figure></para>
      </problem>
    <solution>
      <para>Correct! A.<figure><media alt=""><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/041e8dc43448e170283ce1fa6d615adfe3dac8e4"/></media></figure></para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para dir="ltr" id="docs-internal-guid-3928dc3b-7fff-2889-d6f7-c1b86335d540">Try again. Revisit activity 9.5.3. </para>
    </div>
    </exercise>
  <!--5c-->
  <exercise data-content-id="e34dd45b-d934-43e2-a0c2-00692e36905a" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="They are similar because the solutions are close" data-solution-options="[&quot;They are similar because the solutions are close&quot;, &quot;They are not similar because the square root of a number is always positive.&quot;, &quot;They are not similar.&quot;, &quot;They are similar because the square root of a number is always positive.&quot;]">
    <problem>
      <para>Are the solutions and the graph for the equation \(x^2-4x-11=0\) similar? </para>
      </problem>
    <solution>
      <para>Correct! They are similar because the solutions are close.
        \(2-\sqrt{15} \approx -1.873\) and \(2+ \sqrt{15} \approx 5.873\).</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 9.5.3 and 9.5.4.</para>
    </div>
    </exercise>
  <!--Do not edit below this line-->
  <solution> </solution>
  <div class="os-raise-ib-pset-encourage-response"> </div>
