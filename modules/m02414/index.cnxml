<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.5.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02414</md:content-id>
    <md:title>9.5.5: Practice</md:title>
    <md:uuid>204ba181-49b5-41e8-a810-1fa5f3c6106a</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
        <exercise id="aa770c91-6152-463d-9f99-edbe3fb79379" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00002">Solve each equation and write the solutions using the ± notation, then choose the correct solution from the list.</para>
            <para id="para-00003"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>144</m:mn></m:mrow></m:math></para><para id="para-00004">Multiple Choice:</para>
            <para id="para-00005"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mn>144</m:mn></m:mrow></m:math></para><para id="para-00006"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mn>72</m:mn></m:mrow></m:math></para><para id="para-00007"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mn>12</m:mn></m:mrow></m:math></para><para id="para-00008"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mn>24</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00001">
            <para id="para-00009">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mn>12</m:mn></m:mrow></m:math></para>
            <para id="para-00010">Try again. Revisit activity 9.5.2.</para>
            <para id="para-00011">The correct answer is: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mn>12</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_9c17d561-1f7d-4b84-a828-eb6bc2674a19" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00012"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math></para><para id="para-00013">Multiple Choice:</para>
            <para id="para-00014"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:msqrt><m:mrow><m:mn>5</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para><para id="para-00015"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mn>5</m:mn></m:mrow></m:math></para><para id="para-00016"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00017"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:msqrt><m:mrow><m:mn>10</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para></problem>
          <solution id="sol-00002">
            <para id="para-00018">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:msqrt><m:mrow><m:mn>5</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para>
            <para id="para-00019">Try again. Revisit activity 9.5.2.</para>
            <para id="para-00020">The correct answer is: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:msqrt><m:mrow><m:mn>5</m:mn></m:mrow></m:msqrt></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_5a29821c-570d-4176-b0ad-403f43515e37" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00021"><m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>28</m:mn></m:mrow></m:math></para><para id="para-00022">Multiple Choice:</para>
            <para id="para-00023"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:msqrt><m:mrow><m:mfrac><m:mrow><m:mn>7</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:msqrt></m:mrow></m:math></para><para id="para-00024"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mn>7</m:mn></m:mrow></m:math></para><para id="para-00025"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mfrac><m:mrow><m:mn>7</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00026"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:msqrt><m:mrow><m:mn>7</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para></problem>
          <solution id="sol-00003">
            <para id="para-00027">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:msqrt><m:mrow><m:mn>7</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para>
            <para id="para-00028">Try again. Revisit activity 9.5.2.</para>
            <para id="para-00029">The correct answer is: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:msqrt><m:mrow><m:mn>7</m:mn></m:mrow></m:msqrt></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="c8664b91-9471-408e-8c77-c482d15e691b" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00030"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>25</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00031">Multiple Choice:</para>
            <para id="para-00032"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mfrac><m:mrow><m:mn>25</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00033"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00034"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00035"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para></problem>
          <solution id="sol-00004">
            <para id="para-00036">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
            <para id="para-00037">Try again. Revisit activity 9.5.2.</para>
            <para id="para-00038">The correct answer is: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_09ef6dde-3940-48ed-97eb-ffffc682c2d7" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00039"><m:math><m:mrow><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>22</m:mn></m:mrow></m:math></para><para id="para-00040">Multiple Choice:</para>
            <para id="para-00041"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:msqrt><m:mrow><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:msqrt></m:mrow></m:math></para><para id="para-00042"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mn>11</m:mn></m:mrow></m:math></para><para id="para-00043"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00044"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:msqrt><m:mrow><m:mn>11</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para></problem>
          <solution id="sol-00005">
            <para id="para-00045">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:msqrt><m:mrow><m:mn>11</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para>
            <para id="para-00046">Try again. Revisit activity 9.5.2.</para>
            <para id="para-00047">The correct answer is: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:msqrt><m:mrow><m:mn>11</m:mn></m:mrow></m:msqrt></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_5a8ed6eb-d457-4dca-a7ae-6ff48710eb3a" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00048"><m:math><m:mrow><m:mn>7</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>16</m:mn></m:mrow></m:math></para><para id="para-00049">Multiple Choice:</para>
            <para id="para-00050"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:msqrt><m:mrow><m:mfrac><m:mrow><m:mn>16</m:mn></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac></m:mrow></m:msqrt></m:mrow></m:math></para><para id="para-00051"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mn>16</m:mn></m:mrow></m:math></para><para id="para-00052"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mn>8</m:mn></m:mrow></m:math></para><para id="para-00053"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:mfrac><m:mrow><m:msqrt><m:mrow><m:mn>16</m:mn></m:mrow></m:msqrt></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para></problem>
          <solution id="sol-00006">
            <para id="para-00054">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:msqrt><m:mrow><m:mfrac><m:mrow><m:mn>16</m:mn></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac></m:mrow></m:msqrt></m:mrow></m:math></para>
            <para id="para-00055">Try again. Revisit activity 9.5.2.</para>
            <para id="para-00056">The correct answer is: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:mspace width="0.278em"/><m:msqrt><m:mrow><m:mfrac><m:mrow><m:mn>16</m:mn></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac></m:mrow></m:msqrt></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_20fac294-8500-40b9-9be9-801062d93322" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00057">For each expression, choose an equivalent expression.</para>
            <para id="para-00058"><m:math><m:mrow><m:mn>10</m:mn><m:mi>±</m:mi><m:msqrt><m:mrow><m:mn>4</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para><para id="para-00059">Multiple Choice:</para>
            <para id="para-00060">-17 and 5</para>
            <para id="para-00061"><m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>+</m:mo><m:msqrt><m:mrow><m:mn>2</m:mn></m:mrow></m:msqrt></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>−</m:mo><m:msqrt><m:mrow><m:mn>2</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para>
            <para id="para-00062">8 and 12</para>
            <para id="para-00063">3 and 5</para>
            <para id="para-00064"><m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>+</m:mo><m:msqrt><m:mrow><m:mn>10</m:mn></m:mrow></m:msqrt></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>−</m:mo><m:msqrt><m:mrow><m:mn>10</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00065">Correct! 8 and 12</para>
            <para id="para-00066">Try again. Revisit activity 9.5.2.</para>
            <para id="para-00067">The correct answer is: 8 and 12.</para>
          </solution>
        </exercise>
        <exercise id="_1d3cc2ba-12ad-404c-ba1d-48d5c65f7deb" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00068"><m:math><m:mrow><m:mn>4</m:mn><m:mi>±</m:mi><m:msqrt><m:mrow><m:mn>10</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para><para id="para-00069">Multiple Choice:</para>
            <para id="para-00070">-17 and 5</para>
            <para id="para-00071"><m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>+</m:mo><m:msqrt><m:mrow><m:mn>2</m:mn></m:mrow></m:msqrt></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>−</m:mo><m:msqrt><m:mrow><m:mn>2</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para>
            <para id="para-00072">8 and 12</para>
            <para id="para-00073">3 and 5</para>
            <para id="para-00074"><m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>+</m:mo><m:msqrt><m:mrow><m:mn>10</m:mn></m:mrow></m:msqrt></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>−</m:mo><m:msqrt><m:mrow><m:mn>10</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00075">Correct! <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>+</m:mo><m:msqrt><m:mrow><m:mn>10</m:mn></m:mrow></m:msqrt></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>−</m:mo><m:msqrt><m:mrow><m:mn>10</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para>
            <para id="para-00076">Try again. Revisit activity 9.5.2.</para>
            <para id="para-00077">The correct answer is: <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>+</m:mo><m:msqrt><m:mrow><m:mn>10</m:mn></m:mrow></m:msqrt></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>−</m:mo><m:msqrt><m:mrow><m:mn>10</m:mn></m:mrow></m:msqrt></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_46a3bfd3-b470-45a0-af0e-3026a58aed89" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00078"><m:math><m:mrow><m:msqrt><m:mrow><m:mn>16</m:mn></m:mrow></m:msqrt><m:mi>±</m:mi><m:msqrt><m:mrow><m:mn>2</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para><para id="para-00079">Multiple Choice:</para>
            <para id="para-00080">-17 and 5</para>
            <para id="para-00081"><m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>+</m:mo><m:msqrt><m:mrow><m:mn>2</m:mn></m:mrow></m:msqrt></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>−</m:mo><m:msqrt><m:mrow><m:mn>2</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para>
            <para id="para-00082">8 and 12</para>
            <para id="para-00083">3 and 5</para>
            <para id="para-00084"><m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>+</m:mo><m:msqrt><m:mrow><m:mn>10</m:mn></m:mrow></m:msqrt></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>−</m:mo><m:msqrt><m:mrow><m:mn>10</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00085">Correct! <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>+</m:mo><m:msqrt><m:mrow><m:mn>2</m:mn></m:mrow></m:msqrt></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>−</m:mo><m:msqrt><m:mrow><m:mn>2</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para>
            <para id="para-00086">Try again. Revisit activity 9.5.2.</para>
            <para id="para-00087">The correct answer is: <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>+</m:mo><m:msqrt><m:mrow><m:mn>2</m:mn></m:mrow></m:msqrt></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mo>−</m:mo><m:msqrt><m:mrow><m:mn>2</m:mn></m:mrow></m:msqrt></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="d5a44196-2396-47d2-90b8-0c135a49cdd2" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00088">What is the difference between <m:math display="inline"><m:mrow><m:msqrt><m:mrow><m:mn>9</m:mn></m:mrow></m:msqrt></m:mrow></m:math> and the solutions to <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math>?</para>
            <para id="para-00089">Multiple Choice:</para>
            <para id="para-00090"><m:math display="inline"><m:mrow><m:msqrt><m:mrow><m:mn>9</m:mn></m:mrow></m:msqrt></m:mrow></m:math> is equal to 3, while <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> is equal to -3.</para>
            <para id="para-00091"><m:math display="inline"><m:mrow><m:msqrt><m:mrow><m:mn>9</m:mn></m:mrow></m:msqrt></m:mrow></m:math> is equal to -3, while there are two numbers that make <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> true: 3 and -3.</para>
            <para id="para-00092"><m:math display="inline"><m:mrow><m:msqrt><m:mrow><m:mn>9</m:mn></m:mrow></m:msqrt></m:mrow></m:math> is equal to 3, while there are two numbers that make <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> true: 3 and -3.</para>
            <para id="para-00093">There is no difference; they are equal.</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00094">Correct! <m:math display="inline"><m:mrow><m:msqrt><m:mrow><m:mn>9</m:mn></m:mrow></m:msqrt></m:mrow></m:math> is equal to 3, while there are two numbers that make <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> true: 3 and -3.</para>
            <para id="para-00095">Try again. Revisit activity 9.5.2.</para>
            <para id="para-00096">The correct answer is: <m:math display="inline"><m:mrow><m:msqrt><m:mrow><m:mn>9</m:mn></m:mrow></m:msqrt></m:mrow></m:math> is equal to 3, while there are two numbers that make <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> true: 3 and -3..</para>
          </solution>
        </exercise>
        <exercise id="_5828e49f-09bc-4b72-b74e-42464e580ef1" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00097">Technology required. For each equation, find the exact solutions by completing the square and the approximate solutions by graphing. Then, verify that the solutions found using the two methods are close.</para>
            <para id="para-00098">Solve the equation <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>10</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> by completing the square.<emphasis>Select two</emphasis> exact solutions.</para>
          </problem>
          <solution id="sol-00011">
            <para id="para-00099">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>+</m:mo><m:msqrt><m:mrow><m:mn>17</m:mn></m:mrow></m:msqrt></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>−</m:mo><m:msqrt><m:mrow><m:mn>17</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para>
            <para id="para-00100">Try again. Revisit activity 9.5.2.</para>
            <para id="para-00101">The correct answers are: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>+</m:mo><m:msqrt><m:mrow><m:mn>17</m:mn></m:mrow></m:msqrt></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>−</m:mo><m:msqrt><m:mrow><m:mn>17</m:mn></m:mrow></m:msqrt></m:mrow></m:math>.</para>
          </solution>
        </exercise>
