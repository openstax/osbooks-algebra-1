  <content>
  <section><title>Warm Up Activity</title>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="09924438-c2dc-45ef-b3b7-b5427d3f560a" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1-->
  <exercise data-content-id="48f644b8-f3c3-4365-8e2f-aad6c1ca3ec3" data-problem-type="multiselect" data-solution="[&quot;\\((x+5)(5+x)\\)&quot;, &quot;\\((x−3)^2\\)&quot;, &quot;\\(x^2+8x+16\\)&quot;]" data-solution-options="[&quot;\\((x+5)(5+x)\\)&quot;, &quot;\\((x+5)(x−5)\\)&quot;, &quot;\\((x−3)^2\\)&quot;,&quot;\\(x−3^2\\)&quot;, &quot;\\(x^2+8x+16\\)&quot;, &quot;\\(x^2+10x+20\\)&quot;]">
    <problem>
      <para><emphasis>Select three</emphasis> expressions that are perfect squares. </para>
      </problem>
    <solution>
      <para>Correct! \((x+5)(5+x)\), \((x−3)^2\), \(x^2+8x+16\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>
<example><exercise>
  <problem>
    
    <para>Explain how you know the expressions you selected are perfect squares.</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>Because each of them is the product of an expression and itself. \(x^2+8x+16\) is equivalent to \((x+4)(x+4)\).</para>
</solution></exercise>
</example></section>
