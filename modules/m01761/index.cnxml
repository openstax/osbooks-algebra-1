      </entry>
      <entry>a. _____</entry>
    </row>
    <row>
      <entry>
        5
      </entry>
      <entry>b. _____</entry>
    </row>
    <row>
      <entry>
        10
      </entry>
      <entry>c. _____</entry>
    </row>
    <row>
