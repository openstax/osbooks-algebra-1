        12
      </entry>
      <entry>d. _____</entry>
    </row>
    <row>
      <entry>
        \(n\)
      </entry>
      <entry>e. _____</entry>
    </row>
  </tbody>
</table>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="bfb18594-7ef3-4cce-91b5-4deb3fd6b8fe" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q2a-->
  <exercise data-content-id="20799070-1abe-475a-8519-4dec9738d609" data-problem-comparator="integer" data-problem-type="input" data-solution="18">
    <problem>
      <para> In Step 4, what is the number of small squares?</para>
        <para>Enter your answer here: </para>
    </problem>
    <solution>
      <para>Correct! Step 4 has 18 small squares.</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q2b-->
  <exercise data-content-id="92cd14c1-8001-44de-a4a8-46e28a78acb7" data-problem-comparator="integer" data-problem-type="input" data-solution="27">
    <problem>
      <para> In Step 5, what is the number of small squares?</para>
        <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! Step 5 has 27 small squares.</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q2c-->
  <exercise data-content-id="613d1789-d831-41a4-b28b-1781ac708a7a" data-problem-comparator="integer" data-problem-type="input" data-solution="102">
    <problem>
      <para> In Step 10, what is the number of small squares?</para>
        <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! Step 10 has 102 small squares.</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q2d-->
  <exercise data-content-id="baa64dc5-ff5e-4fe2-a9af-588bdfb5d003" data-problem-comparator="integer" data-problem-type="input" data-solution="146">
