                </row>
                <row>
                  <entry> 4 </entry>
                  <entry> 1.162 </entry>
                </row>
                <row>
                  <entry> 5 </entry>
                  <entry> 1.502 </entry>
                </row>
                <row>
                  <entry> 6 </entry>
                  <entry> 1.617 </entry>
                </row>
                <row>
                  <entry> 7 </entry>
