<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>3.1.2: Creating a Scatter Plot Using Data</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00692</md:content-id>
    <md:title>3.1.2: Creating a Scatter Plot Using Data</md:title>
    <md:uuid>af970849-fde2-480a-b1ec-3bddfccd7f8a</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Activity</title>
      <div class="os-raise-familysupport">
        <para id="para-00001">Access the <link url="https://k12.openstax.org/contents/raise/resources/b62c9150250bf52d6cc37569213ab516e0090dca">Desmos guide PDF</link> for tips on solving problems with the Desmos graphing calculator.</para>
      
      <para id="para-00002">Watch the following video to help you answer the questions below.</para>
      <newline/>
      <media alt="Placeholder for Alt Text">
        <iframe width="660" height="371.4" src="https://player.vimeo.com/video/304121358"/>
      </media>
      <!--Q#1-->
      <example id="exam-00001">
        <exercise>
          <problem id="prob-00001">
            <para id="para-00003">To complete the table, record the weight for the number of oranges in the box from the video.</para>
            <table class="os-raise-skinnytable" id="table-00001">
              <tgroup cols="2"><tbody><row>
                  <entry>
                   <emphasis>number of oranges</emphasis>
                  </entry>
                  <entry>
                   <emphasis>weight in kilograms</emphasis>
                  </entry>
                </row>
              <row>
                  <entry> 3 </entry>
                  <entry>
                   <emphasis>
           </emphasis> 
                  </entry>
                </row>
                <row>
                  <entry> 4 </entry>
                  <entry>
                   <emphasis>
           </emphasis> 
                  </entry>
                </row>
                <row>
                  <entry> 5 </entry>
                  <entry>
                   <emphasis>
           </emphasis> 
                  </entry>
                </row>
                <row>
                  <entry> 6 </entry>
                  <entry>
                   <emphasis>
           </emphasis> 
                  </entry>
                </row>
                <row>
                  <entry> 7 </entry>
                  <entry>
                   <emphasis>
           </emphasis> 
                  </entry>
                </row>
                <row>
                  <entry> 8 </entry>
                  <entry>
                   <emphasis>
           </emphasis> 
                  </entry>
                </row>
                <row>
                  <entry> 9 </entry>
                  <entry>
                   <emphasis>
           </emphasis> 
                  </entry>
                </row>
                <row>
                  <entry> 10 </entry>
                  <entry/>
                </row>
              </tbody></tgroup></table>
            <para id="para-00004">Write down your answers, then select the <emphasis>solution</emphasis> button to compare your work.</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00005">Compare your answers:</para>
            <table class="os-raise-skinnytable" id="table-00002">
              <tgroup cols="2"><tbody><row>
                  <entry>
                   <emphasis>number of oranges</emphasis>
                  </entry>
                  <entry>
                   <emphasis>weight in kilograms</emphasis>
                  </entry>
                </row>
              <row>
                  <entry> 3 </entry>
                  <entry> 1.027 </entry>
                </row>
                <row>
                  <entry> 4 </entry>
                  <entry> 1.162 </entry>
                </row>
                <row>
                  <entry> 5 </entry>
                  <entry> 1.502 </entry>
                </row>
                <row>
                  <entry> 6 </entry>
                  <entry> 1.617 </entry>
                </row>
                <row>
                  <entry> 7 </entry>
                  <entry> 1.761 </entry>
                </row>
                <row>
                  <entry> 8 </entry>
                  <entry> 2.115 </entry>
                </row>
                <row>
                  <entry> 9 </entry>
                  <entry> 2.233 </entry>
                </row>
                <row>
                  <entry> 10 </entry>
                  <entry> 2.569 </entry>
                </row>
              </tbody></tgroup></table>
          </solution>
        </exercise>
      </example>
      <!--Interaction End -->
      <list class="os-raise-noindent" list-type="enumerated" id="list-00001">
        <item>Create a scatter plot of the data.</item>
      </list>
      <iframe src="../../media/desmos/07fc80ad88200557d177340fd8af317ef8ad972d.html" width="600" height="500"/><!--Q#2-->
      <example id="exam-00002">
        <exercise>
          <problem id="prob-00002">
            <!-- had to move question content above to allow desmos to show up under question-->
            <para id="para-00006">Use the graphing tool here. Then select the <emphasis>solution</emphasis> button to compare your work.</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00007">Compare your answer:</para>
            <para id="para-00008">
<<<<<<< HEAD
              <b>Answer:</b>
           </para>
=======
             <emphasis>Answer:</emphasis>
            </para>
>>>>>>> 5c1958f50784484f08112b07ce40607802ad64fa
            <figure id="fig-00001">
              <media alt="Scatter plot. Weight in kilograms. Number of oranges.">
                <image mime-type="image/svg+xml" src="../../media/Algebra-1_03_03_03_01.svg"/>
              </media>
            </figure>
          </solution>
        </exercise>
      </example>
      <!--Interaction End -->
      <!--Q#3-->
      <example id="exam-00003">
        <exercise>
          <problem id="prob-00003">
            <para id="para-00009"> Approximate the equation of the line that best fits the data. Use the same graphing tool you used in the question above. Approximate the equation of the line that best fits the data.</para>
            <para id="para-00010">When you have finished graphing, then select the <emphasis>solution</emphasis> button to compare your work.</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00011">Compare your answer:</para>
            <para id="para-00012">Your answer may vary, but here is a sample. The least squares regression line is shown in the scatter plot.
    \(y=0.216x+0.345\)</para>
            <figure id="fig-00002">
              <media alt="Scatter plot. Weight in kilograms. Number of oranges.">
                <image mime-type="image/svg+xml" src="../../media/Algebra-1_03_03_03_02.svg"/>
              </media>
            </figure>
          </solution>
        </exercise>
      </example>
      <!--Interaction End -->
      <!--Interaction End -->
      <exercise>
        <problem id="prob-00004">
          <para id="para-00013">Estimate a value for the slope of the line that you drew. What does the value of the slope represent?</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00014"/>
          <para id="para-00015">Compare your answer:</para>
          <para id="para-00016"><emphasis>Answer:</emphasis> The slope is about 0.2. This means that for each additional orange added to the box, the weight is predicted to increase by about 0.2 kg.</para>
        </solution>
      </exercise>
      <!--Text Entry Interaction Start -->
      <exercise>
        <problem id="prob-00005">
          <para id="para-00017">Estimate the weight of a box containing 11 oranges. Will this estimate be close to the actual value? Be prepared to show your reasoning.</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00018"/>
          <para id="para-00019">Compare your answer:</para>
          <para id="para-00020"><emphasis>Answer:</emphasis> About 2.8 kilograms \((2.6+0.2=2.8)\). The estimate should be close to the actual value since there is only 1 additional orange added, and while there is some variability, it is not great.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise>
        <problem id="prob-00006">
          <para id="para-00021">Estimate the weight of a box containing 50 oranges. Will this estimate be close to the actual value? Be prepared to show your reasoning.</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00022"/>
          <para id="para-00023">Compare your answer:</para>
          <para id="para-00024"><emphasis>Answer:</emphasis> About 10.6 kilograms \((2.6+40⋅0.2=10.6)\). This estimate will probably not be very close. With data only going to 10 oranges, the variability in orange weight will make it harder to get an estimate that is close to the actual value with more oranges.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <note id="note-00001"><para id="para-00025">When you use a linear</para><term class="glossary-tooltip" id="term-00001">model</term> to estimate a value in the data given in a scatter plot, that is called <term class="glossary-tooltip" id="term-00002">interpolation</term>. When you use a linear model to estimate the value outside the data given in the scatter plot, that is called <term class="glossary-tooltip" id="term-00003">extrapolation</term>.</note>
      <!--Text Entry Interaction Start -->
      <exercise>
        <problem id="prob-00007">
          <para id="para-00026">Estimate the coordinates for the vertical intercept of the line you drew. What might the <emphasis effect="italics">y</emphasis>-coordinate for this point represent?</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00027"/>
          <para id="para-00028">Compare your answer:</para>
          <para id="para-00029"><emphasis>Answer:</emphasis> About 0.3 kilogram. The <emphasis effect="italics">y</emphasis>-coordinate estimates the weight of the box with no oranges in it.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise>
        <problem id="prob-00008">
          <para id="para-00030">Which point(s) are best fit by your linear model? How did you decide?</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00031"/>
          <para id="para-00032">Compare your answer:</para>
          <para id="para-00033"><emphasis>Answer:</emphasis> When there were 6 oranges in the box, it was closest to my line. I decided this because the line almost goes through that point.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise>
        <problem id="prob-00009">
          <para id="para-00034">Which point(s) fit the least well by your linear model? How did you decide?</para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00035"/>
          <para id="para-00036">Compare your answer:</para>
          <para id="para-00037"><emphasis>Answer:</emphasis> When there were 7 oranges in the basket, it was the worst estimate. I decided this since this point is the farthest from the line.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <para id="para-00038">Compare your line with that of a partner. Discuss why you chose to put your lines where you did. How are your answers different? Which of you has a line that is the better fit? Why?</para>
    </section>
  </content>
