                  <entry> 1.617 </entry>
                </row>
                <row>
                  <entry> 7 </entry>
                  <entry> 1.761 </entry>
                </row>
                <row>
                  <entry> 8 </entry>
                  <entry> 2.115 </entry>
                </row>
                <row>
                  <entry> 9 </entry>
                  <entry> 2.233 </entry>
                </row>
