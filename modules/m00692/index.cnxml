                  </entry>
                </row>
                <row>
                  <entry> 4 </entry>
                  <entry>
                   <emphasis>
           </emphasis> 
                  </entry>
                </row>
                <row>
                  <entry> 5 </entry>
                  <entry>
                   <emphasis>
           </emphasis> 
                  </entry>
                </row>
                <row>
                  <entry> 6 </entry>
                  <entry>
                   <emphasis>
           </emphasis> 
                  </entry>
                </row>
                <row>
                  <entry> 7 </entry>
                  <entry>
                   <emphasis>
           </emphasis> 
                  </entry>
                </row>
                <row>
                  <entry> 8 </entry>
                  <entry>
                   <emphasis>
           </emphasis> 
                  </entry>
                </row>
                <row>
                  <entry> 9 </entry>
                  <entry>
                   <emphasis>
           </emphasis> 
                  </entry>
                </row>
                <row>
                  <entry> 10 </entry>
                  <entry/>
                </row>
              </tbody></tgroup></table>
            <para>Write down your answers, then select the <emphasis>solution</emphasis> button to compare your work.</para>
          </problem>
          <solution>
            <para>Compare your answers:</para>
            <table class="os-raise-skinnytable" id="table-00002">
              <tgroup cols="2"><tbody><row>
                  <entry>
                   <emphasis>number of oranges</emphasis>
                  </entry>
                  <entry>
                   <emphasis>weight in kilograms</emphasis>
                  </entry>
                </row>
              <row>
                  <entry> 3 </entry>
