<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.6.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02174</md:content-id>
    <md:title>8.6.5: Practice</md:title>
    <md:uuid>fb09968d-35f0-4f0e-956f-ff4ed76d9fd4</md:uuid>
  </metadata>
  <content>
  <section><emphasis><emphasis>
    <para>Students will complete the following questions to practice the skills they have learned in this lesson.</para>
  </emphasis></emphasis>
<list class="os-raise-noindent" type="enumerated">
  <item>Write \((x + 6)(x + 5)\) in standard form.</item>
</list>
<list class="os-raise-noindent">
  <item> \(x^2+10x −30\) </item>
  <item> \(x^2+11x +30\) </item>
  <item> \(x^2+30\) </item>
  <item> \(x^2−11x +30\) </item>
</list>
<para><emphasis>Answer:</emphasis> \(x^2+11x +30\)</para>
<list class="os-raise-noindent" start="2" type="enumerated">
  <item>Write \((x − 3)(x − 7)\) in standard form.</item>
</list>
<list class="os-raise-noindent">
  <item> \(x^2+21\) </item>
  <item> \(x^2+10x −21\) </item>
  <item> \(x^2+10x +21\) </item>
  <item> \(x^2−10x +21\) </item>
</list>
<para><emphasis>Answer:</emphasis> \(x^2−10x +21\)</para>
<list class="os-raise-noindent" start="3" type="enumerated">
  <item>An expression in standard form is shown. The diagram below shows it is equivalent to which expression in factored
    form?</item>
</list>
<para>\(x^2+11x +18\)</para>
<table class="os-raise-doubleheadertable os-raise-skinnytable">
  <thead>
    <row>
      <entry scope="col" class="emphasis"/>
      <entry scope="col" class="emphasis">
        \(x\)
      </entry>
      <entry scope="col" class="emphasis">
        2
      </entry>
    </row>
  </thead>
  <tbody>
    <row>
      <entry scope="row" class="emphasis">
        \(x\)
      </entry>
      <entry>
        \(x^2\)
      </entry>
      <entry>
        \(2x\)
      </entry>
    </row>
    <row>
      <entry scope="row" class="emphasis">
        9
      </entry>
      <entry>
        \(9x\)
      </entry>
      <entry>
        18
      </entry>
    </row>
  </tbody>
</table>
<list class="os-raise-noindent">
  <item> \((x − 2)(x − 9)\) </item>
  <item> \((x + 2)(x + 9)\) </item>
  <item> \((x + 2)(x − 9)\) </item>
  <item> \(x(x + 18)\) </item>
</list>
<para><emphasis>Answer:</emphasis> \((x + 2)(x + 9)\)</para>
<list class="os-raise-noindent" start="4" type="enumerated">
  <item>An expression in standard form is shown. The diagram below shows it is equivalent to which expression in factored
    form?</item>
</list>
<para>\(x^2− 12x + 35\)</para>
<table class="os-raise-doubleheadertable os-raise-skinnytable">
  <thead>
    <row>
      <entry scope="col" class="emphasis"/>
      <entry scope="col" class="emphasis">
        \(x\)
      </entry>
      <entry scope="col" class="emphasis">
        –5
      </entry>
    </row>
  </thead>
  <tbody>
    <row>
      <entry scope="row" class="emphasis">
        \(x\)
      </entry>
      <entry>
        \(x^2\)
      </entry>
      <entry>
        \(-5x\)
      </entry>
    </row>
    <row>
      <entry scope="row" class="emphasis">
        –7
      </entry>
      <entry>
        \(-7x\)
      </entry>
      <entry>
        35
      </entry>
    </row>
  </tbody>
</table>
<list class="os-raise-noindent">
  <item> \((x − 5)(x − 7)\) </item>
  <item> \((x − 5)(x + 7)\) </item>
  <item> \(x(x − 35)\) </item>
  <item> \((x + 5)(x + 7)\) </item>
</list>
<para><emphasis>Answer:</emphasis> \((x − 5)(x − 7)\)</para>
<list class="os-raise-noindent" start="5" type="enumerated">
  <item>Find the factored form of \(x^2+13x +36\).</item>
</list>
<list class="os-raise-noindent">
  <item> \((x − 12)(x − 3)\) </item>
  <item> \((x + 12)(x + 1)\) </item>
  <item> \((x + 18)(x + 2)\) </item>
  <item> \((x + 9)(x + 4)\) </item>
</list>
<para><emphasis>Answer:</emphasis> \((x + 9)(x + 4)\)</para>
<list class="os-raise-noindent" start="6" type="enumerated">
  <item>Find the factored form of \(x^2−14x +48\).</item>
</list>
<list class="os-raise-noindent">
  <item> \((x − 10)(x − 4)\) </item>
  <item> \((x − 12)(x − 4)\) </item>
  <item> \((x − 7)(x − 7)\) </item>
  <item> \((x − 6)(x − 8)\) </item>
</list>
<para><emphasis>Answer:</emphasis> \((x − 6)(x − 8)\)</para>
<list class="os-raise-noindent" start="7" type="enumerated">
  <item>Find the factored form of \(x^2+13x +30\).</item>
</list>
<list class="os-raise-noindent">
  <item> \((x + 15)(x + 2)\) </item>
  <item> \((x + 6)(x + 5)\) </item>
  <item> \((x + 3)(x + 10)\) </item>
  <item> \((x + 6)(x + 7)\) </item>
</list>
<para><emphasis>Answer:</emphasis> \((x + 3)(x + 10)\)</para>
<list class="os-raise-noindent" start="8" type="enumerated">
  <item>Find the factored form of \(x^2−12x +27\).</item>
</list>
<list class="os-raise-noindent">
  <item> \((x − 9)(x − 3)\) </item>
  <item> \((x − 7)(x − 5)\) </item>
  <item> \((x − 27)(x − 1)\) </item>
  <item> \((x − 6)(x − 6)\) </item>
</list>
<para><emphasis>Answer:</emphasis> \((x − 9)(x − 3)\)</para>
<list class="os-raise-noindent" start="9" type="enumerated">
  <item>Find the factored form of \(x^2−13x +22\).</item>
</list>
<list class="os-raise-noindent">
  <item> \((x − 11)(x − 2)\) </item>
  <item> \((x − 12)(x − 1)\) </item>
  <item> \((x − 22)(x − 1)\) </item>
  <item> \((x − 6)(x − 7)\) </item>
</list>
<para><emphasis>Answer:</emphasis> \((x − 11)(x − 2)\)</para>
<list class="os-raise-noindent" start="10" type="enumerated">
  <item>Here are pairs of equivalent expressions: one in standard form and the other in factored form. Find the missing
    numbers.</item>
</list>
<para>\(x^2+20x +96\) and \((x\; +\) __\()(x \;+\) __\()\)</para>
<list class="os-raise-noindent">
  <item> 10, 10 </item>
  <item> 12, 8 </item>
  <item> 24, 4 </item>
  <item> 14, 6 </item>
</list>
<para><emphasis>Answer:</emphasis> 12, 8</para></section>
</content>
</document>
