            3
          </entry>
                  <entry> </entry>
                  <entry> </entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry>
            4
          </entry>
                  <entry> </entry>
                  <entry> </entry>
                  <entry> </entry>
                </row>
              </tbody></tgroup></table>
            <para id="para-00005">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00006">Compare your answers: 
    Sample Data:</para>
            <list class="os-raise-noindent" list-type="enumerated" id="list-00001">
              <item/>
            </list>
            <table class="os-raise-wideequaltable" id="table-00002">
              <tgroup cols="4"><tbody><row>
                  <entry>
                   <emphasis><m:math display="inline"><m:mrow><m:mi>n</m:mi></m:mrow></m:math>, Number of Bounces</emphasis>
                  </entry>
                  <entry>
                   <emphasis><m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>, Height for Ball 1 (cm)</emphasis>
                  </entry>
                  <entry>
                   <emphasis><m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>, Height for Ball 2 (cm)</emphasis>
                  </entry>
                  <entry>
                   <emphasis><m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math>, Height for Ball 3 (cm)</emphasis>
                  </entry>
                </row>
              <row>
                  <entry>
          0
        </entry>
                  <entry>
          150
        </entry>
                  <entry>
          150
        </entry>
                  <entry>
          150
        </entry>
                </row>
                <row>
                  <entry>
          1
        </entry>
                  <entry>
          80
        </entry>
                  <entry>
          100
        </entry>
