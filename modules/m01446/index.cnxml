            <para id="para-00005">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work. </para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00006">Compare your answers: 
    Sample Data:</para>
            <list class="os-raise-noindent" type="enumerated" id="list-00001">
