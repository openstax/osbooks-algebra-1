          <entry> </entry>
          <entry> </entry>
        </row>
        <row>
          <entry>
            4
          </entry>
          <entry> </entry>
          <entry> </entry>
          <entry> </entry>
        </row>
      </tbody>
    </table>
    
  <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work. </para>
  </problem><solution>
  <para>Compare your answers: 
    Sample Data:</para>
  <list class="os-raise-noindent" type="enumerated">
    <item/>
  </list>
  <table class="os-raise-wideequaltable">
    <thead>
      <row>
        <entry scope="col" class="emphasis">\(n\), Number of Bounces</entry>
        <entry scope="col" class="emphasis">\(a\), Height for Ball 1 (cm)</entry>
        <entry scope="col" class="emphasis">\(b\), Height for Ball 2 (cm)</entry>
        <entry scope="col" class="emphasis">\(c\), Height for Ball 3 (cm)</entry>
      </row>
    </thead>
    <tbody>
      <row>
        <entry>
          0
        </entry>
        <entry>
          150
        </entry>
        <entry>
          150
        </entry>
        <entry>
          150
        </entry>
      </row>
      <row>
        <entry>
          1
        </entry>
        <entry>
          80
        </entry>
        <entry>
          100
        </entry>
