<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.11.4: Writing Quadratics When Given Any Format</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02279</md:content-id>
    <md:title>8.11.4: Writing Quadratics When Given Any Format</md:title>
    <md:uuid>02127b31-cfff-4abe-b24d-19149f9774f7</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
<para id="para-00001">In this lesson, you have learned how to write a quadratic function from different starting contexts and when provided different information.</para>
<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002">Identify a quadratic function in standard form, <math xmlns="http://www.w3.org/1998/Math/MathML">
      <mi>b</mi>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo stretchy="false">)</mo>
    </math>, with the zeros –6 and 8.</para>
    </problem><solution id="sol-00001" xmlns="http://cnx.rice.edu/cnxml">
    
    <para id="para-00003">Enter a quadratic function in standard form, <math xmlns="http://www.w3.org/1998/Math/MathML">
      <mi>b</mi>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo stretchy="false">)</mo>
    </math>.</para>
  <para id="para-00004">Compare your answer:</para>
    <para id="para-00005"><math xmlns="http://www.w3.org/1998/Math/MathML">
      <mi>b</mi>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo stretchy="false">)</mo>
      <mo>=</mo>
      <msup>
        <mi>x</mi>
        <mn>2</mn>
      </msup>
      <mo>−</mo>
      <mn>2</mn>
      <mi>x</mi>
      <mo>−</mo>
      <mn>48</mn>
    </math></para>
  </solution></exercise>
<!--Interaction End -->

<!--Text Entry Interaction Start -->
<exercise id="exer-00002" xmlns="http://cnx.rice.edu/cnxml">
  <problem id="prob-00002">
    <para id="para-00006">Identify a quadratic function in standard form, <math xmlns="http://www.w3.org/1998/Math/MathML">
      <mi>m</mi>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo stretchy="false">)</mo>
    </math>, with the given zero.</para>
    <para id="para-00007">
      <media alt="A PARABOLA THAT OPENS UP WITH AN \(x\)-intercepts OF 6."><image mime-type="image/png" src="../../media/b3c2e79ea248f2e456cd3375fb701cf47b884168.jpg" width="400"/></media></para>
  </problem><solution id="sol-00002">
    
    <para id="para-00008">Enter a quadratic function in standard form, <math xmlns="http://www.w3.org/1998/Math/MathML">
      <mi>m</mi>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo stretchy="false">)</mo>
    </math>.</para>
  <para id="para-00009">Compare your answer:</para>
    <para id="para-00010"><math xmlns="http://www.w3.org/1998/Math/MathML">
      <mi>m</mi>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo stretchy="false">)</mo>
      <mo>=</mo>
      <msup>
        <mi>x</mi>
        <mn>2</mn>
      </msup>
      <mo>−</mo>
      <mn>12</mn>
      <mi>x</mi>
      <mo>+</mo>
      <mn>36</mn>
    </math></para>
  </solution></exercise>
<!--Interaction End -->

<!--Text Entry Interaction Start -->
<exercise id="exer-00003" xmlns="http://cnx.rice.edu/cnxml">
  <problem id="prob-00003">
    <para id="para-00011">Write the specific quadratic function, <math xmlns="http://www.w3.org/1998/Math/MathML">
      <mi>d</mi>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo stretchy="false">)</mo>
    </math>, in standard form, that has the zeros 2 and 5 and passes through the point <math xmlns="http://www.w3.org/1998/Math/MathML">
      <mo stretchy="false">(</mo>
      <mn>1</mn>
      <mo>,</mo>
      <mn>16</mn>
      <mo stretchy="false">)</mo>
    </math>.</para>
    </problem><solution id="sol-00003" xmlns="http://cnx.rice.edu/cnxml">
    
    <para id="para-00012">Enter the quadratic function, <math xmlns="http://www.w3.org/1998/Math/MathML">
      <mi>d</mi>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo stretchy="false">)</mo>
    </math>, in standard form.</para>
  <para id="para-00013">Compare your answer:</para>
    <para id="para-00014">Intercept form: <math xmlns="http://www.w3.org/1998/Math/MathML">
      <mi>d</mi>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo stretchy="false">)</mo>
      <mo>=</mo>
      <mi>a</mi>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo>−</mo>
      <mn>2</mn>
      <mo stretchy="false">)</mo>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo>−</mo>
      <mn>5</mn>
      <mo stretchy="false">)</mo>
    </math></para>
    <para id="para-00015">Find the value of <math xmlns="http://www.w3.org/1998/Math/MathML">
      <mi>a</mi>
    </math>. Use point <math xmlns="http://www.w3.org/1998/Math/MathML">
      <mo stretchy="false">(</mo>
      <mn>1</mn>
      <mo>,</mo>
      <mn>16</mn>
      <mo stretchy="false">)</mo>
    </math>.</para>
    <para id="para-00016"><math xmlns="http://www.w3.org/1998/Math/MathML">
  <mi>d</mi>
  <mo stretchy="false">(</mo>
  <mi>x</mi>
  <mo stretchy="false">)</mo>
  <mo>=</mo>
  <mi>a</mi>
  <mo stretchy="false">(</mo>
  <mi>x</mi>
  <mo>−</mo>
  <mn>2</mn>
  <mo stretchy="false">)</mo>
  <mo stretchy="false">(</mo>
  <mi>x</mi>
  <mo>−</mo>
  <mn>5</mn>
  <mo stretchy="false">)</mo>
</math></para>
<para id="para-00017"><math xmlns="http://www.w3.org/1998/Math/MathML">
  <mn>16</mn>
  <mo>=</mo>
  <mi>a</mi>
  <mo stretchy="false">(</mo>
  <mo stretchy="false">(</mo>
  <mn>1</mn>
  <mo stretchy="false">)</mo>
  <mo>−</mo>
  <mn>2</mn>
  <mo stretchy="false">)</mo>
  <mo stretchy="false">(</mo>
  <mo stretchy="false">(</mo>
  <mn>1</mn>
  <mo stretchy="false">)</mo>
  <mo>−</mo>
  <mn>5</mn>
  <mo stretchy="false">)</mo>
</math></para>
      <para id="para-00018"><math xmlns="http://www.w3.org/1998/Math/MathML">
  <mn>16</mn>
  <mo>=</mo>
  <mi>a</mi>
  <mo stretchy="false">(</mo>
  <mo>−<!-- − --></mo>
  <mn>1</mn>
  <mo stretchy="false">)</mo>
  <mo stretchy="false">(</mo>
  <mo>−<!-- − --></mo>
  <mn>4</mn>
  <mo stretchy="false">)</mo>
</math></para>
      <para id="para-00019"><math xmlns="http://www.w3.org/1998/Math/MathML">
        <mn>16</mn>
        <mo>=</mo>
        <mn>4</mn>
        <mi>a</mi>
      </math></para>
      <para id="para-00020"><math xmlns="http://www.w3.org/1998/Math/MathML">
        <mn>4</mn>
        <mo>=</mo>
        <mi>a</mi>
      </math></para>
    <para id="para-00021">Substitute 4 for \(a\).</para>
    <para id="para-00022"><math xmlns="http://www.w3.org/1998/Math/MathML">
      <mi>d</mi>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo stretchy="false">)</mo>
      <mo>=</mo>
      <mi>a</mi>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo>−</mo>
      <mn>2</mn>
      <mo stretchy="false">)</mo>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo>−</mo>
      <mn>5</mn>
      <mo stretchy="false">)</mo>
    </math></para>
    <para id="para-00023"><math xmlns="http://www.w3.org/1998/Math/MathML">
      <mi>d</mi>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo stretchy="false">)</mo>
      <mo>=</mo>
      <mn>4</mn>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo>−</mo>
      <mn>2</mn>
      <mo stretchy="false">)</mo>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo>−</mo>
      <mn>5</mn>
      <mo stretchy="false">)</mo>
    </math></para>
      <para id="para-00024">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <mi>d</mi>
          <mo stretchy="false">(</mo>
          <mi>x</mi>
          <mo stretchy="false">)</mo>
          <mo>=</mo>
          <mn>4</mn>
          <mo stretchy="false">(</mo>
          <msup>
            <mi>x</mi>
            <mn>2</mn>
          </msup>
          <mo>−</mo>
          <mn>2</mn>
          <mi>x</mi>
          <mo>−</mo>
          <mn>5</mn>
          <mi>x</mi>
          <mo>+</mo>
          <mn>10</mn>
          <mo stretchy="false">)</mo>
        </math></para>
      <para id="para-00025"><math xmlns="http://www.w3.org/1998/Math/MathML">
  <mi>d</mi>
  <mo stretchy="false">(</mo>
  <mi>x</mi>
  <mo stretchy="false">)</mo>
  <mo>=</mo>
  <mn>4</mn>
  <mo stretchy="false">(</mo>
  <msup>
    <mi>x</mi>
    <mn>2</mn>
  </msup>
  <mo>−</mo>
  <mn>7</mn>
  <mi>x</mi>
  <mo>+</mo>
  <mn>10</mn>
  <mo stretchy="false">)</mo>
</math></para>
      <para id="para-00026"><math xmlns="http://www.w3.org/1998/Math/MathML">
        <mi>d</mi>
        <mo stretchy="false">(</mo>
        <mi>x</mi>
        <mo stretchy="false">)</mo>
        <mo>=</mo>
        <mn>4</mn>
        <msup>
          <mi>x</mi>
          <mn>2</mn>
        </msup>
        <mo>−</mo>
        <mn>28</mn>
        <mi>x</mi>
        <mo>+</mo>
        <mn>40</mn>
      </math></para>
    <para id="para-00027">So, the specific quadratic function written in standard form is <math xmlns="http://www.w3.org/1998/Math/MathML">
      <mi>d</mi>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo stretchy="false">)</mo>
      <mo>=</mo>
      <mn>4</mn>
      <msup>
        <mi>x</mi>
        <mn>2</mn>
      </msup>
      <mo>−</mo>
      <mn>28</mn>
      <mi>x</mi>
      <mo>+</mo>
      <mn>40</mn>
    </math>.</para>
  </solution></exercise>
<!--Interaction End --></section>
</content>
</document>