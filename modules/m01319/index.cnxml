<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Identifying Linear and Exponential Quantities</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01319</md:content-id>
    <md:title>Identifying Linear and Exponential Quantities</md:title>
    <md:uuid>259a08d0-36dc-4e41-bd40-0d48adf31822</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>
<para id="para-00001">Use the patterns you notice to complete the tables. Show your reasoning. Complete your work on paper. </para>
<exercise id="exer-00001">
  <problem id="prob-00001">
    
    <para id="para-00002">Table A</para>
    
    <table class="unnumbered os-raise-horizontaltable" id="table-00001">
      <tgroup cols="7"><tbody><row>
          <entry><emphasis><m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math></emphasis></entry><entry>
          0
          </entry>
          <entry>
           1
          </entry>
          <entry>
            2
          </entry>
          <entry>
            3
          </entry>
          <entry>
            4
          </entry>
          <entry>
           25
          </entry>
        </row>
        <row>
          <entry><emphasis><m:math><m:mrow><m:mi>y</m:mi></m:mrow></m:math></emphasis></entry><entry>
            2.5
          </entry>
          <entry>
            10
          </entry>
          <entry>
            17.5
          </entry>
          <entry>
            25
          </entry>
          <entry> </entry>
          <entry> </entry>
        </row>
      </tbody></tgroup></table>
    
    
  
  <para id="para-00003"></para>
  
  </problem><solution id="sol-00001">
  <para id="para-00004">Compare your answers:</para>
  
  <para id="para-00005">Table A: 32.5 when <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> is 4, and 190 (or <m:math display="inline"><m:mrow><m:mn>2.5</m:mn><m:mo>+</m:mo><m:mn>25</m:mn><m:mi>·</m:mi><m:mn>7.5</m:mn></m:mrow></m:math>) when <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> is 25.</para>

</solution></exercise>

<exercise id="exer-00002">
  <problem id="prob-00002">
    
    <para id="para-00006">Table B</para>
    
    <table class="unnumbered os-raise-horizontaltable" id="table-00002">
      <tgroup cols="7"><tbody><row>
          <entry><emphasis><m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math></emphasis></entry><entry>
          0
          </entry>
          <entry>
           1
          </entry>
          <entry>
            2
          </entry>
          <entry>
            3
          </entry>
          <entry>
            4
          </entry>
          <entry>
           25
          </entry>
        </row>
        <row>
          <entry><emphasis><m:math><m:mrow><m:mi>y</m:mi></m:mrow></m:math></emphasis></entry><entry>	
            2.5
          </entry>
          <entry>
            10
          </entry>
          <entry>
            40
          </entry>
          <entry>
            160
          </entry>
          <entry> </entry>
          <entry> </entry>
        </row>
      </tbody></tgroup></table>
    
    
  
  <para id="para-00007"></para>
  
  </problem><solution id="sol-00002">
  <para id="para-00008">Compare your answers:</para>
  
  <para id="para-00009">Table B: 640 when <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> is 4, and <m:math display="inline"><m:mrow><m:mn>2.5</m:mn><m:mi>·</m:mi><m:msup><m:mn>4</m:mn><m:mrow><m:mn>25</m:mn></m:mrow></m:msup></m:mrow></m:math> when <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> is 25.</para>

</solution></exercise>
</section>
