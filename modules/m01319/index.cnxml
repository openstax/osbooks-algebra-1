<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.5.1: Identifying Linear and Exponential Quantities</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01319</md:content-id>
    <md:title>5.5.1: Identifying Linear and Exponential Quantities</md:title>
    <md:uuid>ca5e86dc-5a01-498b-ae45-e658e392dcd1</md:uuid>
  </metadata>
  <content>
  <section><title>Warm Up Activity</title>
<para>Use the patterns you notice to complete the tables. Show your reasoning. Complete your work on paper. Then select the
  <emphasis>Solution</emphasis> button to compare your work.</para>
<example><exercise>
  <problem>
    
    <para>Table A</para>
    <table class="os-raise-horizontaltable">
      <thead/>
      <tbody>
        <row>
          <entry><emphasis>\(x\)</emphasis></entry><entry>
          0
          </entry>
          <entry>
           1
          </entry>
          <entry>
            2
          </entry>
          <entry>
            3
          </entry>
          <entry>
            4
          </entry>
          <entry>
           25
          </entry>
        </row>
        <row>
          <entry><emphasis>\(y\)</emphasis></entry><entry>
            2.5
          </entry>
          <entry>
            10
          </entry>
          <entry>
            17.5
          </entry>
          <entry>
            25
          </entry>
          <entry> </entry>
          <entry> </entry>
        </row>
      </tbody>
    </table>
    
  <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work. </para>
  </problem><solution>
  <para>Compare your answers:</para>
  <para>Table A: 32.5 when \(x\) is 4, and 190 (or \(2.5+25 \cdot 7.5\)) when \(x\) is 25.</para>
</solution></exercise>
</example>
<example><exercise>
  <problem>
    
    <para>Table B</para>
    <table class="os-raise-horizontaltable">
      <thead/>
      <tbody>
        <row>
          <entry><emphasis>\(x\)</emphasis></entry><entry>
          0
          </entry>
          <entry>
           1
          </entry>
          <entry>
            2
          </entry>
          <entry>
            3
          </entry>
          <entry>
            4
          </entry>
          <entry>
           25
          </entry>
        </row>
        <row>
          <entry><emphasis>\(y\)</emphasis></entry><entry>	
            2.5
          </entry>
          <entry>
            10
          </entry>
          <entry>
            40
          </entry>
          <entry>
            160
          </entry>
          <entry> </entry>
          <entry> </entry>
        </row>
      </tbody>
    </table>
    
  <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work. </para>
  </problem><solution>
  <para>Compare your answers:</para>
  <para>Table B: 640 when \(x\) is 4, and \(2.5 \cdot 4^{25}\) when \(x\) is 25.</para>
</solution></exercise>
</example></section>
</content>
