<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Checking Exponent Rules</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01342</md:content-id>
    <md:title>Checking Exponent Rules</md:title>
    <md:uuid>9536d8d0-2c73-41b0-9797-7c6127ce5dc2</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>
<para id="para-00001">How would you rewrite each of the following as an equivalent expression with a single exponent?</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mn>4</m:mn></m:msup><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mn>0</m:mn></m:msup></m:mrow></m:math></para></problem><solution id="sol-00001">
    
    
  
  <para id="para-00003">Compare your answer: </para>
    
    <para id="para-00004"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mn>4</m:mn></m:msup></m:mrow></m:math></para></solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00005"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mn>4</m:mn></m:msup><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mrow><m:mo>–</m:mo><m:mn>1</m:mn></m:mrow></m:msup></m:mrow></m:math></para></problem><solution id="sol-00002">
    
    
  
  <para id="para-00006">Compare your answer: </para>
    
    <para id="para-00007"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mn>3</m:mn></m:msup></m:mrow></m:math></para></solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00008"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mn>4</m:mn></m:msup><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mrow><m:mo>–</m:mo><m:mn>3</m:mn></m:mrow></m:msup></m:mrow></m:math></para></problem><solution id="sol-00003">
    
    
  
  <para id="para-00009">Compare your answer: </para>
    
    <para id="para-00010"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mn>1</m:mn></m:msup></m:mrow></m:math></para></solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00011"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mn>4</m:mn></m:msup><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mrow><m:mo>–</m:mo><m:mn>4</m:mn></m:mrow></m:msup></m:mrow></m:math></para></problem><solution id="sol-00004">
    
    
  
  <para id="para-00012">Compare your answer: </para>
    
    <para id="para-00013"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mn>0</m:mn></m:msup></m:mrow></m:math></para></solution></exercise>
<!--Interaction End -->
</section>
