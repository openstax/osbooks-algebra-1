<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.6.1: Checking Exponent Rules</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01342</md:content-id>
    <md:title>5.6.1: Checking Exponent Rules</md:title>
    <md:uuid>9536d8d0-2c73-41b0-9797-7c6127ce5dc2</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Warm Up Activity</title>
<para id="para-00001">How would you rewrite each of the following as an equivalent expression with a single exponent?</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002">\(2^4\cdot 2^0\)</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00003">Compare your answer:</para>
    
    <para id="para-00004">\(2^4\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00005">\(2^4\cdot 2^{-1}\)</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00006">Compare your answer:</para>
    
    <para id="para-00007">\(2^3\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00008">\(2^4\cdot 2^{-3}\)</para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00009">Compare your answer:</para>
    
    <para id="para-00010">\(2^1\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00011">\(2^4\cdot 2^{-4}\)</para>
    </problem><solution id="sol-00004">
    
    
  
  <para id="para-00012">Compare your answer:</para>
    
    <para id="para-00013">\(2^0\)</para>
  
  </solution></exercise>
<!--Interaction End -->
</section>
