  <content>
  <section><title>Warm Up Activity</title>
<para>How would you rewrite each of the following as an equivalent expression with a single exponent?</para>

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(2^4\cdot 2^0\)</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para> \(2^4\)</para>
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(2^4\cdot 2^{-1}\)</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para> \(2^3\)</para>
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> \(2^4\cdot 2^{-3}\)</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para> \(2^1\)</para>
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> \(2^4\cdot 2^{-4}\)</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para> \(2^0\)</para>
  </solution></exercise>
<!--Interaction End -->
</section>
