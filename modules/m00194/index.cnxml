<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.8.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00194</md:content-id>
    <md:title>1.8.5: Practice</md:title>
    <md:uuid>4fb61913-2b4d-453b-a9b0-87e15a5edaed</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <para id="para-00002">For 1 - 4 use the problem below:</para>
      <para id="para-00003"><quote id="quote-00001">Priya is buying raisins and almonds to make trail mix. Almonds cost $5.20 per pound and raisins cost $2.75 per pound. Priya spent $11.70 buying almonds and raisins. The relationship between pounds of almonds, pounds of raisins, and the total cost is represented by the equation <m:math display="inline"><m:mrow><m:mn>5.2</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>2.75</m:mn><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>11.7</m:mn></m:mrow></m:math>.</quote></para>
      <para id="para-00004">How many pounds of raisins did Priya buy if she bought the following amount of almonds:</para>
      <exercise id="_141ee309-47d6-4ef8-a902-faf57beecc60" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00005">2 pounds of almonds</para>
          <para id="para-00006">Multiple Choice:</para>
          <para id="para-00007">1.192</para>
          <para id="para-00008">2.75</para>
          <para id="para-00009">0.946</para>
          <para id="para-00010">0.473</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00011">Correct! 0.473</para>
          <para id="para-00012"><m:math display="inline"><m:mrow><m:mn>5.2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>2.75</m:mn><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>11.7</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mn>10.4</m:mn><m:mo>+</m:mo><m:mn>2.75</m:mn><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>11.7</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mn>10.4</m:mn><m:mo>+</m:mo><m:mn>2.75</m:mn><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>11.7</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mn>10.4</m:mn><m:mo>+</m:mo><m:mn>2.75</m:mn><m:mi>r</m:mi><m:mo>−</m:mo><m:mn>10.4</m:mn><m:mo>=</m:mo><m:mn>11.7</m:mn><m:mo>−</m:mo><m:mn>10.4</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mn>10.4</m:mn><m:mo>+</m:mo><m:mn>2.75</m:mn><m:mi>r</m:mi><m:mo>−</m:mo><m:mn>10.4</m:mn><m:mo>=</m:mo><m:mn>11.7</m:mn><m:mo>−</m:mo><m:mn>10.4</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mn>2.75</m:mn><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>1.3</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mn>2.75</m:mn><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>1.3</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>/</m:mo><m:mn>2.75</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2.75</m:mn><m:mi>r</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>/</m:mo><m:mn>2.75</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>1.3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>/</m:mo><m:mn>2.75</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2.75</m:mn><m:mi>r</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>/</m:mo><m:mn>2.75</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>1.3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>0.473</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>0.473</m:mn></m:mrow></m:math></para>
          <para id="para-00013">Try again. Revisit activity 1.8.2.</para>
          <para id="para-00014">The correct answer is 0.473.</para>
        </solution>
      </exercise>
      <exercise id="aa71602e-9229-4eea-a6a2-8eb5dfac8752" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00015">1.06 pounds of almonds</para>
          <para id="para-00016">Multiple Choice:</para>
          <para id="para-00017">2.25</para>
          <para id="para-00018">1.689</para>
          <para id="para-00019">5.5</para>
          <para id="para-00020">2.811</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00021">Correct! 2.25</para>
          <para id="para-00022"><m:math><m:mrow><m:mn>5.2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>1.06</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>2.75</m:mn><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>11.7</m:mn></m:mrow></m:math></para>
          <para id="para-00023">Try again. Revisit activity 1.8.2.</para>
          <para id="para-00024">The correct answer is 2.25.</para>
        </solution>
      </exercise>
      <exercise id="_2ecb1097-cef5-424f-938a-28c3ab6edf15" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00025">0.64 pounds of almonds</para>
          <para id="para-00026">Multiple Choice:</para>
          <para id="para-00027">9.94</para>
          <para id="para-00028">1.911</para>
          <para id="para-00029">3.044</para>
          <para id="para-00030">8.371</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00031">Correct! 3.044</para>
          <para id="para-00032"><m:math><m:mrow><m:mn>5.2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>0.64</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>2.75</m:mn><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>11.7</m:mn></m:mrow></m:math></para>
          <para id="para-00033">Try again. Revisit activity 1.8.2.</para>
          <para id="para-00034">The correct answer is 3.044.</para>
        </solution>
      </exercise>
      <exercise id="_04e4c308-5efd-4fe9-b71d-e10a46997b05" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00035"><m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math> pounds of almonds</para>
          <para id="para-00036">Multiple Choice:</para>
          <para id="para-00037"><m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>11.7</m:mn><m:mo>+</m:mo><m:mn>5.2</m:mn><m:mi>a</m:mi></m:mrow><m:mrow><m:mn>275</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
          <para id="para-00038"><m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>11.7</m:mn><m:mo>−</m:mo><m:mn>2.75</m:mn><m:mi>a</m:mi></m:mrow><m:mrow><m:mn>5.2</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
          <para id="para-00039"><m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>2.75</m:mn></m:mrow><m:mrow><m:mn>11.7</m:mn><m:mo>−</m:mo><m:mn>5.2</m:mn><m:mi>a</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para>
          <para id="para-00040"><m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>11.7</m:mn><m:mo>−</m:mo><m:mn>5.2</m:mn><m:mi>a</m:mi></m:mrow><m:mrow><m:mn>2.75</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00041">Correct! <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1.7</m:mn><m:mo>−</m:mo><m:mn>5.2</m:mn><m:mi>a</m:mi></m:mrow><m:mrow><m:mn>2.75</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
          <para id="para-00042"><m:math><m:mrow><m:mn>5.2</m:mn><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>2.75</m:mn><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>11.7</m:mn></m:mrow></m:math></para>
          <para id="para-00043">Try again. Revisit activity 1.8.2.</para>
          <para id="para-00044">The correct answer is <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>11.7</m:mn><m:mo>−</m:mo><m:mn>5.2</m:mn><m:mi>a</m:mi></m:mrow><m:mrow><m:mn>2.75</m:mn></m:mrow></m:mfrac></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <para id="para-00045">For 5 - 6 use the problem below:</para>
      <para id="para-00046"><quote id="quote-00002">A car traveled 180 miles at a constant rate.</quote></para>
      <exercise id="b5b4af86-a741-4892-a2a9-94abd8e233ed" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00047">For each of the missing spaces in the table, a-d, select the missing value that completes the table to show the rate at which the car was traveling if it completed the same distance in each number of hours.</para>
          <table class="unnumbered" id="table-00001">
            <tgroup cols="2">
              <tbody>
                <row>
                  <entry>5</entry>
                  <entry>a. ____ </entry>
                </row>
                <row>
                  <entry>4.5</entry>
                  <entry>b. ____ </entry>
                </row>
                <row>
                  <entry>3</entry>
                  <entry>c. ____ </entry>
                </row>
                <row>
                  <entry>2.25</entry>
                  <entry>d. ____ </entry>
                </row>
              </tbody>
            </tgroup>
          </table>
          <para id="para-00048">   a.______</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00049">Correct! 36</para>
          <para id="para-00050"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>180</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mn>36</m:mn></m:mrow></m:math></para>
          <para id="para-00051">Try again. Revisit activity 1.8.2.</para>
          <para id="para-00052">The correct answer is 36.</para>
        </solution>
      </exercise>
      <exercise id="_949cd5c8-e172-4c75-9046-f688c03bbaba" class="multiple-choice">
        <problem id="prob-00006">
          <para id="para-00053">b. _____</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00054">Correct! 40</para>
          <para id="para-00055"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>180</m:mn></m:mrow><m:mrow><m:mn>4.5</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mn>40</m:mn></m:mrow></m:math></para>
          <para id="para-00056">Try again. Revisit activity 1.8.2.</para>
          <para id="para-00057">The correct answer is 40.</para>
        </solution>
      </exercise>
      <exercise id="ed99f41d-13e6-4be7-b1ba-e786dd1d841c" class="multiple-choice">
        <problem id="prob-00007">
          <para id="para-00058">c. _____</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00059">Correct! 60</para>
          <para id="para-00060"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>180</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mn>60</m:mn></m:mrow></m:math></para>
          <para id="para-00061">Try again. Revisit activity 1.8.2.</para>
          <para id="para-00062">The correct answer is 60.</para>
          <para id="para-00063"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>180</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mn>60</m:mn></m:mrow></m:math></para>
        </solution>
      </exercise>
      <exercise id="e46a957b-f722-4e79-acb0-5917929b9c84" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00064">d. _____</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00065">Correct! 80</para>
          <para id="para-00066"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>180</m:mn></m:mrow><m:mrow><m:mn>2.25</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mn>80</m:mn></m:mrow></m:math></para>
          <para id="para-00067">Try again. Revisit activity 1.8.2.</para>
          <para id="para-00068">The correct answer is 80.</para>
          <para id="para-00069"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>180</m:mn></m:mrow><m:mrow><m:mn>2.25</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mn>80</m:mn></m:mrow></m:math></para>
        </solution>
      </exercise>
      <exercise id="_0d45981e-3d0c-4b99-9426-0f75365c3047" class="multiple-choice">
        <problem id="prob-00009">
          <para id="para-00070">Choose the equation that would make it easy to find the rate at which the car was traveling in miles per hour <m:math display="inline"><m:mrow><m:mi>r</m:mi></m:mrow></m:math>, if it traveled for <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> hours.</para>
          <para id="para-00071">Multiple Choice:</para>
          <para id="para-00072"><m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mfrac><m:mi>t</m:mi><m:mrow><m:mn>180</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
          <para id="para-00073"><m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>180</m:mn></m:mrow><m:mi>t</m:mi></m:mfrac></m:mrow></m:math></para>
          <para id="para-00074"><m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>180</m:mn><m:mi>t</m:mi></m:mrow></m:math></para>
          <para id="para-00075"><m:math><m:mrow><m:mi>r</m:mi><m:mo>−</m:mo><m:mn>180</m:mn><m:mo>−</m:mo><m:mi>t</m:mi></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00076">Correct! <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>180</m:mn></m:mrow><m:mi>t</m:mi></m:mfrac></m:mrow></m:math></para>
          <para id="para-00077">Try again. Revisit activity 1.8.2.</para>
          <para id="para-00078">The correct answer is <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>180</m:mn></m:mrow><m:mi>t</m:mi></m:mfrac></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_48e38499-b2ca-4eb1-ba5e-2bb72198961b" class="multiple-choice">
        <problem id="prob-00010">
          <para id="para-00079">Bananas cost $0.50 each, and apples cost $1.00 each.<emphasis>Select all three</emphasis> combinations of bananas and apples that Elena could buy for exactly $3.50.</para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00080">Correct! 3 bananas and 2 apples,1 banana and 3 apples, 5 bananas and 1 apple</para>
          <para id="para-00081"><m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>0.5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>3.50</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mn>1</m:mn><m:mo stretchy="false">(</m:mo><m:mn>0.5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>3.50</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mn>1</m:mn><m:mo stretchy="false">(</m:mo><m:mn>0.5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>3.50</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mi>.5</m:mi><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>3.50</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mi>.5</m:mi><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>3.50</m:mn></m:mrow></m:math></para>
          <para id="para-00082">Try again. Revisit activity 1.8.2.</para>
          <para id="para-00083">The correct answers are 3 bananas and 2 apples,1 banana and 3 apples, 5 bananas and 1 apple.</para>
        </solution>
      </exercise>
      <exercise id="e41358fd-8187-4c65-b531-f0ea183aee73" class="multiple-choice">
        <problem id="prob-00011">
          <para id="para-00084">Choose the best answer to solve the formula <m:math display="inline"><m:mrow><m:mi>A</m:mi><m:mo>=</m:mo><m:mi>P</m:mi><m:mo>+</m:mo><m:mi>P</m:mi><m:mi>r</m:mi><m:mi>t</m:mi></m:mrow></m:math> for <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math>.</para>
          <para id="para-00085">Multiple Choice:</para>
          <para id="para-00086"><m:math><m:mrow><m:mi>t</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>P</m:mi><m:mo>−</m:mo><m:mi>A</m:mi></m:mrow><m:mrow><m:mi>P</m:mi><m:mi>r</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para>
          <para id="para-00087"><m:math><m:mrow><m:mi>t</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>A</m:mi><m:mo>−</m:mo><m:mi>P</m:mi></m:mrow><m:mrow><m:mi>P</m:mi><m:mi>r</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para>
          <para id="para-00088"><m:math><m:mrow><m:mi>t</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>A</m:mi><m:mo>+</m:mo><m:mi>P</m:mi></m:mrow><m:mrow><m:mi>P</m:mi><m:mi>r</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para>
          <para id="para-00089"><m:math><m:mrow><m:mi>t</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>r</m:mi><m:mo stretchy="false">(</m:mo><m:mi>A</m:mi><m:mo>−</m:mo><m:mi>P</m:mi><m:mo stretchy="false">)</m:mo></m:mrow><m:mi>P</m:mi></m:mfrac></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00011">
          <para id="para-00090">Correct! <m:math display="inline"><m:mrow><m:mi>t</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>A</m:mi><m:mo>−</m:mo><m:mi>P</m:mi></m:mrow><m:mrow><m:mi>P</m:mi><m:mi>r</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para>
