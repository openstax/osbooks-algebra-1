            <media alt="Graph of an inequality. Number of bracelets. Number of necklaces.">
              <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_14_06_01.svg"/>
            </media>
          
        </solution>
      </exercise>

      <!--END
      ADD DESMOS INTERATIVE-->
        <exercise id="_0ace0214-876b-4331-8699-f38ca15a2ec8" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00014">Is (3,18.6) a solution to the inequality?</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00015">Correct! Both.</para>
            <para id="para-00016">The correct answer is Both.</para>
          </solution>
        </exercise>

      <!--END
      ACTIVITY YES/NO DROP DOWN 1 TRY -->
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00006">
        <problem id="prob-00007">
          <para id="para-00017">Explain your reasoning.</para>

        </problem>
        <solution id="sol-00007">
          <list id="list-00001">
            <item>Compare your answer: Your answer may vary, but here is a sample.</item>
            <item>The answer is both because:</item>
            <item>Yes, it is a solution. The point (3,18.6) is in the shaded region.</item>
            <item>No, it is not a solution. The vendor can't sell 18.6 bracelets.</item>
          </list>
        </solution>
      </exercise>
    </section>
