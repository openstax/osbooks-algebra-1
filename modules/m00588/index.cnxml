</example><exercise data-wait-for-event="eventShowMore1">
  <problem>
    <title>Extending Your Thinking</title>
    <para>Write an inequality using two variables \(x\) and \(y\) where the solution would be represented by shading the entire coordinate plane.</para>
    </problem><solution>
    Enter your answer here:
  
    <para>\(x^2+y^2\geq0\)</para>
  </solution></exercise>


<exercise data-wait-for-event="eventShowMore1">
  <problem>
    <para>Write an inequality using two variables \(x\) and \(y\) where the solution would be represented by not shading any of the coordinate plane.</para>
    </problem><solution>
    Enter your answer here:
  
    
    <para>\(x^2+y^2&lt;0\)</para>
  </solution></exercise></section>
