      <section class="check-understanding">
        <title>Activity</title>
        <exercise id="_0ace0214-876b-4331-8699-f38ca15a2ec8" class="multiple-choice">
          <problem>
            <para>Is (3,18.6) a solution to the inequality?</para>
          </problem>
          <solution>
            <para>Correct! Both.</para>
            <para>The correct answer is Both.</para>
          </solution>
        </exercise>
      </section>
      <!--END ACTIVITY YES/NO DROP DOWN 1 TRY -->
      <!--Text Entry Interaction Start -->
      <exercise>
        <problem>
          <para>Explain your reasoning.</para>
          
        </problem>
        <solution>
          <list>
            <para>Compare your answer: Your answer may vary, but here is a sample.</para>
            <para>The answer is both because:</para>
            <item>Yes, it is a solution. The point (3,18.6) is in the shaded region.</item>
            <item>No, it is not a solution. The vendor can't sell 18.6 bracelets.</item>
          </list>
        </solution>
      </exercise>
