  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="a5502ca1-b67c-4376-b539-fe5f1e55b7a6" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--Q1-->
  <exercise data-content-id="9e1a192e-92b5-4cc3-8e4d-694ab599ef05" data-problem-comparator="integer" data-problem-type="input" data-solution="22">
    <problem>
      <para>Here are the first two terms of some different arithmetic sequences. What is the 5th term of each sequence?</para>
        <para>–2, 4 ...
          </para>
        </problem>
    <solution>
      <para>Correct! 22; The pattern continues 10, 16, 22. </para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4. </para>
    </div>
    </exercise>
  <!--Q1b-->
  <exercise data-content-id="ae3d4215-f4a0-4a51-b7c6-0de5945ab529" data-problem-comparator="integer" data-problem-type="input" data-solution="411">
    <problem>
      <para>11, 111 ...
          </para>
        </problem>
    <solution>
      <para>Correct! 411</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4. </para>
    </div>
    </exercise>
  <!--Q1c-->
  <exercise data-content-id="332a2382-f74b-47a1-88cb-4a05bf2c1838" data-problem-comparator="integer" data-problem-type="input" data-solution="15">
    <problem>
      <para>5, 7.5 ...
          </para>
        </problem>
    <solution>
      <para>Correct! 15</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4. </para>
    </div>
    </exercise>
  <!--Q1d-->
  <exercise data-content-id="4c5df2cc-8470-4d51-a689-97308a1240d2" data-problem-comparator="integer" data-problem-type="input" data-solution="-31">
    <problem>
      <para>5, –4 ...
          </para>
        </problem>
    <solution>
      <para>Correct! –31</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4. </para>
    </div>
    </exercise>
  <!--Q2a-->
  <exercise data-content-id="51d5aeab-0fb5-4586-912a-4119fb6a104c" data-problem-type="dropdown" data-retry-limit="2" data-solution="Geometric" data-solution-options="[&quot;Geometric&quot;, &quot;Arithmetic&quot;, &quot;Neither&quot;]">
    <problem>
      <para>For each sequence, decide whether it could be arithmetic, geometric, or neither.</para>
        <para>200, 40, 8, . . .</para>
        </problem>
    <solution>
      <para>Correct! Geometric</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4.</para>
    </div>
    </exercise>
  <!--Q2b-->
  <exercise data-content-id="0cb87d46-c2f5-4357-bb6e-b0742f759f5a" data-problem-type="dropdown" data-retry-limit="2" data-solution="Neither" data-solution-options="[&quot;Geometric&quot;, &quot;Arithmetic&quot;, &quot;Neither&quot;]">
    <problem>
      <para>2, 4, 16, . . .</para>
        </problem>
    <solution>
      <para>Correct! Neither</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4.</para>
    </div>
    </exercise>
  <!--Q2c-->
  <exercise data-content-id="4dcc112e-63f1-405f-800b-b4c6cdd6f006" data-problem-type="dropdown" data-retry-limit="2" data-solution="Arithmetic" data-solution-options="[&quot;Geometric&quot;, &quot;Arithmetic&quot;, &quot;Neither&quot;]">
    <problem>
      <para>10, 20, 30, . . .</para>
        </problem>
    <solution>
      <para>Correct! Arithmetic</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4.</para>
    </div>
    </exercise>
  <!--Q2d-->
  <exercise data-content-id="17190c7d-fe9c-4dc9-b7b5-cc966b3c5f44" data-problem-type="dropdown" data-retry-limit="2" data-solution="Geometric" data-solution-options="[&quot;Geometric&quot;, &quot;Arithmetic&quot;, &quot;Neither&quot;]">
    <problem>
      <para>100, 20, 4, . . .</para>
        </problem>
    <solution>
      <para>Correct! Geometric</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4.</para>
    </div>
    </exercise>
  <!--Q2e-->
  <exercise data-content-id="fc75b2e8-89fc-422f-8c59-1e4848f8e18f" data-problem-type="dropdown" data-retry-limit="2" data-solution="Arithmetic" data-solution-options="[&quot;Geometric&quot;, &quot;Arithmetic&quot;, &quot;Neither&quot;]">
    <problem>
      <para>6, 12, 18, . . .</para>
        </problem>
    <solution>
      <para>Correct! Arithmetic</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4.</para>
    </div>
    </exercise>
  <!--Q3-->
  <exercise data-content-id="214b23a3-97ae-4369-bb95-c6e9c5563ca6" data-problem-comparator="integer" data-problem-type="input" data-solution="1">
    <problem>
      <para>For each arithmetic sequence with missing terms, find the common difference that might help determine the missing terms.  </para>
        <para>–3, –2, ___, ___, 1
            
          </para>
        </problem>
    <solution>
      <para>Correct! 1; The missing terms are 1, 0.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4. </para>
    </div>
    </exercise>
  <!--Q3b-->
  <exercise data-content-id="e3e7cb84-d233-4167-83af-7a5523e28658" data-problem-comparator="integer" data-problem-type="input" data-solution="12">
    <problem>
      <para> ___, 13, 25, ___, ___
          </para>
        </problem>
    <solution>
      <para>Correct! 12; The sequence should be 1, 13, 25, 37, 49.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4. </para>
    </div>
    </exercise>
  <!--Q3c-->
  <exercise data-content-id="9d6f669c-cdda-41e5-93ae-e82b626c39fe" data-problem-comparator="float" data-problem-type="input" data-solution="-0.75">
    <problem>
      <para> 1, 0.25, ___, –1.25, ___ </para>
        </problem>
    <solution>
      <para>Correct! –0.75; The sequence is 1, 0.25, –0.5, –1.25, –2.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4. </para>
    </div>
    </exercise>
  <!--Q3d-->
  <exercise data-content-id="153b2854-d4fd-4dd2-800c-a12b27f28957" data-problem-comparator="integer" data-problem-type="input" data-solution="-3">
    <problem>
      <para> 92, ___, ___ ,___, 80
          </para>
        </problem>
    <solution>
      <para>Correct! –3; The sequence is 92, 89, 86, 83, 80.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4. </para>
    </div>
    </exercise>
  <!--4a-->
  <exercise data-content-id="be845a8f-ef8c-44af-9941-4b30f6d98a92" data-problem-comparator="integer" data-problem-type="input" data-solution="4">
    <problem>
      <para>Find the common difference for each of the following arithmetic sequences. 
          HINT: It may be helpful to complete the sequence with the missing terms. 
          </para>
        <para>___, 6, 10, ___, 18
          </para>
        </problem>
    <solution>
      <para>Correct! 4; The sequence is 2, 6, 10, 14, 18.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4.</para>
    </div>
    </exercise>
  <!--Q4b-->
  <exercise data-content-id="1b52ae5c-000d-4c4d-9927-e4b1f7fa33d2" data-problem-comparator="integer" data-problem-type="input" data-solution="-5">
    <problem>
      <para>–1, ___, –11, –16, ___
          </para>
        </problem>
    <solution>
      <para>Correct! –5; The sequence is –1, –6, –11, –16, –21.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4.</para>
    </div>
    </exercise>
  <!--Q4c-->
  <exercise data-content-id="2dbd198f-96c1-41b3-8c00-da290fb2b3f4" data-problem-comparator="integer" data-problem-type="input" data-solution="-5">
    <problem>
      <para>10, 5, ___, ___, –10
          </para>
        </problem>
    <solution>
      <para>Correct! –5; The sequence is 10, 5, 0, –5, –10.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4.</para>
    </div>
    </exercise>
  <!--Q4d-->
  <exercise data-content-id="3c8b811d-ce4a-4603-86b7-01544732fec3" data-problem-comparator="float" data-problem-type="input" data-solution="1.5">
    <problem>
      <para>___, ___, 4.5, 6, ___</para>
        </problem>
    <solution>
      <para>Correct! 1.5; The sequence is 1.5, 3, 4.5, 6.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4.</para>
    </div>
    </exercise>
  <!--Q4e-->
  <exercise data-content-id="99db774a-25d2-481f-ba9d-3b0f1f5aa0be" data-problem-comparator="integer" data-problem-type="input" data-solution="-6">
    <problem>
      <para>___, 12, 6, 0, ___
          </para>
        </problem>
    <solution>
      <para>Correct! –6; The sequence is 18, 12, 6, 0, –6.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 4.16.2 – 4.16.4.</para>
    </div>
    </exercise>
