<!--
      END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

      <!--Q12-->
        <exercise id="exer-00005">
          <problem id="prob-00012">
            <para id="para-00054">Explain your solution.</para>
            <para id="para-00055"></para>

          </problem>
          <solution id="sol-00012">
            <para id="para-00056">Compare your answer: Your answer may vary, but here is a sample.</para>

            <!--BEGIN
            ALIGN TO EQUALS -->

            <para id="para-00057"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mi>w</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>7</m:mn></m:mfrac><m:mi>z</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>w</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>7</m:mn></m:mfrac><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>w</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>7</m:mn><m:mi>w</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>w</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>28</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>10</m:mn><m:mi>w</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>28</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>10</m:mn><m:mi>w</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>30</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>w</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>3</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            ALIGN TO EQUALS -->

            <para id="para-00058"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mi>z</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>3</m:mn><m:mi>w</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>z</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>z</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>9</m:mn><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>z</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>7</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            SIDE BY SIDE EQUATIONSS-->

            <para id="para-00059"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mi>w</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>7</m:mn></m:mfrac><m:mi>z</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mtd><m:mtd columnalign="center"/><m:mtd columnalign="right"><m:mi>z</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mi>w</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>7</m:mn></m:mfrac><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>4</m:mn></m:mtd><m:mtd columnalign="center"/><m:mtd columnalign="right"><m:mn>7</m:mn><m:mo>=</m:mo><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>1</m:mn><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>4</m:mn></m:mtd><m:mtd columnalign="center"/><m:mtd columnalign="right"><m:mn>7</m:mn><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>9</m:mn><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>✓</m:mi></m:mtd><m:mtd columnalign="center"/><m:mtd columnalign="right"><m:mn>7</m:mn><m:mo>=</m:mo><m:mn>7</m:mn><m:mi>✓</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
            SIDE BY SIDE EQUATIONS -->
          </solution>
        </exercise>
      </section>
<!--Interaction
      End -->

      <!-- END CLICK TO REVEAL NO TEXTBOX -->
       <section id="sect-00002">
        <title>Are you ready for more?</title>
        <section class="numbered-exercises" id="sect-00003"><title>Extending Your Thinking</title>

      <para id="para-00060">Solve this system with four equations.</para>
      <para id="para-00061">Use this system of equations to answer questions 1 – 4.</para>
      <quote id="quote-00005"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>−</m:mo><m:mi>z</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>w</m:mi><m:mo>=</m:mo><m:mn>20</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>z</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>w</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mi>z</m:mi><m:mo>=</m:mo><m:mi>w</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>2</m:mn><m:mi>w</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></quote>


