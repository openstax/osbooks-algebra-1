  <content>
    <section>
      <title>Activity</title>
      <para>Solve each system without graphing.</para>

      <para>Use this system of equations to answer questions 1 – 3.</para>
      <para><quote>\( \begin{cases} x + 2y = 8 \\x = -5 \end{cases} \)</quote></para>
      <para>Here are the four systems of equations you saw in the previous exercise. Solve each
        system. Then, check your solutions by substituting them into the original equations to see
        if the equations are true.</para>


        <exercise id="_33fba438-5fcc-4669-afb7-7f659afd783b" class="multiple-choice">
          <problem>
            <para>What is the \(x\) value?</para>
          </problem>
          <solution>
            <para>Correct! 6</para>
            <para>Nice try! The correct answer is 6.</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->

        <exercise id="b552fe1d-7d76-4a1e-b0a4-b65888a5a287" class="multiple-choice">
          <problem>
            <para>What is the \(y\) value?</para>
          </problem>
          <solution>
            <para>Correct! 2</para>
            <para>Nice try! The correct answer is 2.</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

      <!--Q3-->
        <exercise>
          <problem>
            <para>Explain your solution.</para>
            <para>Write down your answer, then select the <emphasis>solution</emphasis> button to
              compare your work.</para>
          </problem>
          <solution>
            <para>Compare your answer: Your answer may vary, but here is a sample.</para>

            <!--BEGIN
            ALIGN TO EQUALS -->

            <para>\(\begin{array}{rcl} 5x-2y&amp;=&amp;26 \\ 5(y+4)-2y&amp;=&amp;26 \\
              5y+20-2y&amp;=&amp;26 \\ 3y+20&amp;=&amp;26 \\ 3y&amp;=&amp;6 \\ y&amp;=&amp;=2 \\
              \end{array}\)</para>

            <!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            ALIGN TO EQUALS -->

            <para>\(\begin{array}{rcl} \\ 2+4&amp;=&amp;x \\ 6&amp;=&amp;x \\ \end{array}\)</para>

            <!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            SIDE BY SIDE EQUATIONSS-->

            <para>\(\begin{array}{rcr} 5(6)-2(2)=26 &amp;   &amp; \\ 30-4\overset?=26 &amp;   &amp;
              2+4\overset?=6 \\ 26=26\checkmark &amp;   &amp; 6=6\checkmark \end{array}\)</para>

            <!--END
            SIDE BY SIDE EQUATIONS -->

          </solution>
        </exercise>
    <!--Interaction
      End -->

      <!-- END CLICK TO REVEAL NO TEXTBOX -->

      <para>Use this system of equations to answer 4 - 6.</para>
      <para><quote>\( \begin{cases} 2m - 2p = -6\\ p = 2m + 10 \end{cases} \)</quote></para>
      
        <exercise id="c58b42e1-2db3-413d-9503-72c0745a55a7" class="multiple-choice">
          <problem>
            <para>What is the \(m\) value?</para>
          </problem>
          <solution>
            <para>Correct! -7</para>
            <para>Nice try! The correct answer is -7.</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->

        <exercise id="_6f943379-eb55-44a5-9c30-69d7b46fa41d" class="multiple-choice">
          <problem>
            <para>What is the \(p\) value?</para>
          </problem>
          <solution>
            <para>Correct! -4</para>
            <para>Nice try! The correct answer is -4.</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

      <!--Q6-->
        <exercise>
          <problem>
            <para>Explain your solution.</para>
            <para>Write down your answer, then select the <emphasis>solution</emphasis> button to
              compare your work.</para>
          </problem>
          <solution>
            <para>Compare your answer: Your answer may vary, but here is a sample.</para>

            <!--BEGIN
            ALIGN TO EQUALS -->

            <para>\(\begin{array}{rcl} 2m-2p&amp;=&amp;-6 \\ 2m-2(2m+10)&amp;=&amp;-6 \\
              2m-4m-20&amp;=&amp;-6 \\ -2m-20&amp;=&amp;-6 \\ -2m&amp;=&amp;14 \\ m&amp;=&amp;-7 \\
              \end{array}\)</para>

            <!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            ALIGN TO EQUALS -->

            <para>\(\begin{array}{rcl} p&amp;=&amp;2m+10 \\ p&amp;=&amp;2(-7)+10 \\
              p&amp;=&amp;-14+10 \\ p&amp;=&amp;-4 \\ \end{array}\)</para>

            <!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            SIDE BY SIDE EQUATIONSS-->

            <para>\(\begin{array}{rcr} 2(-7)-2(-4)=-6 &amp;   &amp; -4=2(-7)+10\\ -14+8\overset?=-6
              &amp;   &amp; -4\overset?=(-14)+10 \\ -6=-6\checkmark &amp;   &amp; -4=-4\checkmark
              \end{array}\)</para>

            <!--END
            SIDE BY SIDE EQUATIONS -->

          </solution>
        </exercise>
<!--Interaction
      End -->

      <!-- END CLICK TO REVEAL NO TEXTBOX -->

      <para>Use this system of equations to answer 7 - 9.</para>
      <para><quote>\( \begin{cases} 2d = 8f \\ 18 - 4f = 2d \end{cases} \)</quote></para>

        <exercise id="_8ce6e32e-2f46-4628-ba5b-daa3c7b9ccb0" class="multiple-choice">
          <problem>
            <para>What is the \(d\) value?</para>
          </problem>
          <solution>
            <para>Correct! 6</para>
            <para>Nice try! The correct answer is 6.</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->

      <!--Q8-->
      <exercise>
        <problem>
          <para>What is the \(f\) value?</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>

          <para>\(\frac32\)</para>

        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

      <!--Q9-->
        <exercise>
          <problem>
            <para>Explain your solution.</para>
            <para>Write down your answer, then select the <emphasis>solution</emphasis> button to
              compare your work.</para>

          </problem>
          <solution>
            <para>Compare your answer: Your answer may vary, but here is a sample.</para>

            <!--BEGIN
            ALIGN TO EQUALS -->

            <para>\(\begin{array}{rcl} 2d&amp;=&amp;8f \\ d&amp;=&amp;4f \\ \end{array}\)</para>

            <!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            ALIGN TO EQUALS -->

            <para>\(\begin{array}{rcl} 18-4f&amp;=&amp;2d \\ 18-4f&amp;=&amp;2(4f) \\
              18-4f&amp;=&amp;8f \\ 18&amp;=&amp;12f \\ \frac{18}{12}&amp;=&amp;f \\
              \frac32&amp;=&amp;f \\ \end{array}\)</para>

            <!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            ALIGN TO EQUALS -->

            <para>\(\begin{array}{rcl} 2d&amp;=&amp;8(\frac32) \\ 2d&amp;=&amp;12 \\ d&amp;=&amp;6
              \\ \end{array}\)</para>

            <!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            SIDE BY SIDE EQUATIONSS-->

            <para>\(\begin{array}{rcr} &amp;   &amp; 18-4f=2d \\ 2d=8f &amp;   &amp;
              18-4(\frac32)=2(6) \\ 2(6)=8(\frac32) &amp;   &amp; 18-(2)(3)=12 \\ 12\overset?=(4)(3)
              &amp;   &amp; 18-6=12 \\ 12=12\checkmark &amp;   &amp; 12=12\checkmark \end{array}\)</para>

            <!--END
            SIDE BY SIDE EQUATIONS -->

          </solution>
        </exercise>
   <!--Interaction
      End -->

      <!-- END CLICK TO REVEAL NO TEXTBOX -->
      <para>Use this system of equations to answer 10 - 12.</para>
      <para><quote>\( \begin{cases} w + \frac17z = 4 \\ z = 3w -2 \end{cases} \)</quote></para>
  
        <exercise id="_7b3cebfa-349d-41c3-b87b-c80149441ef6" class="multiple-choice">
          <problem>
            <para>What is the \(w\) value?</para>
          </problem>
          <solution>
            <para>Correct! 3</para>
            <para>Nice try! The correct answer is 3</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->

        <exercise id="d4deb8ba-7cb4-4b57-8d73-8e7b37797294" class="multiple-choice">
          <problem>
            <para>What is the \(z\) value?</para>
          </problem>
          <solution>
            <para>Correct! 7</para>
            <para>Nice try! The correct answer is 7.</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

      <!--Q12-->
        <exercise>
          <problem>
            <para>Explain your solution.</para>
            <para>Write down your answer, then select the <emphasis>solution</emphasis> button to
              compare your work.</para>

          </problem>
          <solution>
            <para>Compare your answer: Your answer may vary, but here is a sample.</para>

            <!--BEGIN
            ALIGN TO EQUALS -->

            <para>\(\begin{array}{rcl} w+\frac17z&amp;=&amp;4 \\ w+\frac17(3w-2)&amp;=&amp;4 \\
              7w+3w-2&amp;=&amp;28 \\ 10w-2&amp;=&amp;28 \\ 10w&amp;=&amp;30 \\ w&amp;=&amp;3 \\
              \end{array}\)</para>

            <!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            ALIGN TO EQUALS -->

            <para>\(\begin{array}{rcl} z&amp;=&amp;3w-2 \\ z&amp;=&amp;3(3)-2 \\ z&amp;=&amp;9-2 \\
              z&amp;=&amp;7 \\ \end{array}\)</para>

            <!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            SIDE BY SIDE EQUATIONSS-->

            <para>\(\begin{array}{rcr} w+\frac17z=4 &amp;   &amp; z=3w-2 \\ 3+\frac17(7)=4 &amp;  
              &amp; 7=3(3)-2 \\ 3+1\overset?=1=4 &amp;   &amp; 7\overset?=1=9-2 \\ 4=4 \checkmark
              &amp;   &amp; 7=7 \checkmark \\ \end{array}\)</para>

            <!--END
            SIDE BY SIDE EQUATIONS -->
          </solution>
        </exercise>
      </section>
<!--Interaction
      End -->

      <!-- END CLICK TO REVEAL NO TEXTBOX -->
       <section>
        <title>Are you ready for more?</title>
        <section>
          <title>Extending Your Thinking</title>

