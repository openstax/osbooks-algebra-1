<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.3.3: Solving Equations Using Substitution</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00409</md:content-id>
    <md:title>2.3.3: Solving Equations Using Substitution</md:title>
    <md:uuid>662dc060-0315-42d0-9d29-6c073fa9339d</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">      <title>Activity</title>
      <para id="para-00001">Solve each system without graphing.</para>

      <para id="para-00002">Use this system of equations to answer questions 1 – 3.</para>
      <quote id="quote-00001"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></quote>

      <para id="para-00004">Here are the four systems of equations you saw in the previous exercise. Solve each
        system. Then, check your solutions by substituting them into the original equations to see
        if the equations are true.</para>


        <exercise id="_33fba438-5fcc-4669-afb7-7f659afd783b" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00005">What is the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> value?</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00006">Correct! 6</para>
            <para id="para-00007">Nice try! The correct answer is 6.</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->

        <exercise id="b552fe1d-7d76-4a1e-b0a4-b65888a5a287" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00008">What is the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> value?</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00009">Correct! 2</para>
            <para id="para-00010">Nice try! The correct answer is 2.</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

      <!--Q3-->
        <exercise id="exer-00001">
          <problem id="prob-00003">
            <para id="para-00011">Explain your solution.</para>
            <para id="para-00012"></para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00013">Compare your answer: Your answer may vary, but here is a sample.</para>

            <!--BEGIN
            ALIGN TO EQUALS -->

            <para id="para-00014"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>26</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>26</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>20</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>26</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>20</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>26</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo><m:mn>2</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            ALIGN TO EQUALS -->

            <para id="para-00015"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"/></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>4</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>x</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>6</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>x</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            SIDE BY SIDE EQUATIONSS-->

            <para id="para-00016"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>26</m:mn></m:mtd><m:mtd columnalign="center"/><m:mtd columnalign="right"/></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>30</m:mn><m:mo>−</m:mo><m:mn>4</m:mn><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mn>26</m:mn></m:mtd><m:mtd columnalign="center"/><m:mtd columnalign="right"><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>26</m:mn><m:mo>=</m:mo><m:mn>26</m:mn><m:mi>✓</m:mi></m:mtd><m:mtd columnalign="center"/><m:mtd columnalign="right"><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>6</m:mn><m:mi>✓</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
            SIDE BY SIDE EQUATIONS -->

          </solution>
        </exercise>
    <!--Interaction
      End -->

      <!-- END CLICK TO REVEAL NO TEXTBOX -->

      <para id="para-00017">Use this system of equations to answer 4 - 6.</para>
      <quote id="quote-00002"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>2</m:mn><m:mi>m</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>p</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>m</m:mi><m:mo>+</m:mo><m:mn>10</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></quote>

      
        <exercise id="c58b42e1-2db3-413d-9503-72c0745a55a7" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00019">What is the <m:math display="inline"><m:mrow><m:mi>m</m:mi></m:mrow></m:math> value?</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00020">Correct! -7</para>
            <para id="para-00021">Nice try! The correct answer is -7.</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->

        <exercise id="_6f943379-eb55-44a5-9c30-69d7b46fa41d" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00022">What is the <m:math display="inline"><m:mrow><m:mi>p</m:mi></m:mrow></m:math> value?</para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00023">Correct! -4</para>
            <para id="para-00024">Nice try! The correct answer is -4.</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

      <!--Q6-->
        <exercise id="exer-00002">
          <problem id="prob-00006">
            <para id="para-00025">Explain your solution.</para>
            <para id="para-00026"></para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00027">Compare your answer: Your answer may vary, but here is a sample.</para>

            <!--BEGIN
            ALIGN TO EQUALS -->

            <para id="para-00028"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>m</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>p</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>m</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>m</m:mi><m:mo>+</m:mo><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>m</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>m</m:mi><m:mo>−</m:mo><m:mn>20</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>m</m:mi><m:mo>−</m:mo><m:mn>20</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>m</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>14</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>m</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>7</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            ALIGN TO EQUALS -->

            <para id="para-00029"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mi>p</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>2</m:mn><m:mi>m</m:mi><m:mo>+</m:mo><m:mn>10</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>p</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>10</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>p</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>14</m:mn><m:mo>+</m:mo><m:mn>10</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>p</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>4</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            SIDE BY SIDE EQUATIONSS-->

            <para id="para-00030"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mtd><m:mtd columnalign="center"/><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>10</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>14</m:mn><m:mo>+</m:mo><m:mn>8</m:mn><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mo>−</m:mo><m:mn>6</m:mn></m:mtd><m:mtd columnalign="center"/><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>4</m:mn><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>14</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>10</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>✓</m:mi></m:mtd><m:mtd columnalign="center"/><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>✓</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
            SIDE BY SIDE EQUATIONS -->

          </solution>
        </exercise>
<!--Interaction
      End -->

      <!-- END CLICK TO REVEAL NO TEXTBOX -->

      <para id="para-00031">Use this system of equations to answer 7 - 9.</para>
      <quote id="quote-00003"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>2</m:mn><m:mi>d</m:mi><m:mo>=</m:mo><m:mn>8</m:mn><m:mi>f</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>18</m:mn><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>f</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>d</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></quote>


        <exercise id="_8ce6e32e-2f46-4628-ba5b-daa3c7b9ccb0" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00033">What is the <m:math display="inline"><m:mrow><m:mi>d</m:mi></m:mrow></m:math> value?</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00034">Correct! 6</para>
            <para id="para-00035">Nice try! The correct answer is 6.</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->

      <!--Q8-->
      <exercise id="exer-00003">
        <problem id="prob-00008">
          <para id="para-00036">What is the <m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math> value?</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00037">Compare your answer: </para>

          <para id="para-00038"><m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->

      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

      <!--Q9-->
        <exercise id="exer-00004">
          <problem id="prob-00009">
            <para id="para-00039">Explain your solution.</para>
            <para id="para-00040"></para>

          </problem>
          <solution id="sol-00009">
            <para id="para-00041">Compare your answer: Your answer may vary, but here is a sample.</para>

            <!--BEGIN
            ALIGN TO EQUALS -->

            <para id="para-00042"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>d</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>8</m:mn><m:mi>f</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>d</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>4</m:mn><m:mi>f</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            ALIGN TO EQUALS -->

            <para id="para-00043"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>18</m:mn><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>f</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>2</m:mn><m:mi>d</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>18</m:mn><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>f</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>f</m:mi><m:mo stretchy="false">)</m:mo></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>18</m:mn><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>f</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>8</m:mn><m:mi>f</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>18</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>12</m:mn><m:mi>f</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mfrac><m:mrow><m:mn>18</m:mn></m:mrow><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>f</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>f</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            ALIGN TO EQUALS -->

            <para id="para-00044"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>d</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>8</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>d</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>12</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>d</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>6</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            SIDE BY SIDE EQUATIONSS-->

            <para id="para-00045"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"/><m:mtd columnalign="center"/><m:mtd columnalign="right"><m:mn>18</m:mn><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>f</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>d</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>d</m:mi><m:mo>=</m:mo><m:mn>8</m:mn><m:mi>f</m:mi></m:mtd><m:mtd columnalign="center"/><m:mtd columnalign="right"><m:mn>18</m:mn><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>8</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd columnalign="center"/><m:mtd columnalign="right"><m:mn>18</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>12</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>12</m:mn><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd columnalign="center"/><m:mtd columnalign="right"><m:mn>18</m:mn><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>12</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>12</m:mn><m:mo>=</m:mo><m:mn>12</m:mn><m:mi>✓</m:mi></m:mtd><m:mtd columnalign="center"/><m:mtd columnalign="right"><m:mn>12</m:mn><m:mo>=</m:mo><m:mn>12</m:mn><m:mi>✓</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
            SIDE BY SIDE EQUATIONS -->

          </solution>
        </exercise>
   <!--Interaction
      End -->

      <!-- END CLICK TO REVEAL NO TEXTBOX -->
      <para id="para-00046">Use this system of equations to answer 10 - 12.</para>
      <quote id="quote-00004"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mi>w</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>7</m:mn></m:mfrac><m:mi>z</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mi>z</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mi>w</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></quote>

  
