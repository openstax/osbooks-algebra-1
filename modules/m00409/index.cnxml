  <section id="sect-00005">
    <title>Additional Resources</title>

    <section id="sect-00006">
      <title>Reinforcing the Substitution Method</title>
      <para id="para-00077">Solve the system by substitution:</para>

      <!--BEGIN
      SYSTEM OF EQUATIONS-->

      <para id="para-00078"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>4</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>2</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>6</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>8</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para><!--END
      SYSTEM OF EQUATIONS -->
      <para id="para-00079">We need to solve one equation for one variable. We will solve the first equation for
        <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>.</para>
      <!--BEGIN
      STEPS-->

        <para id="para-00080"><emphasis>Step 1</emphasis> - Solve the first equation for <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>.</para>
        <!--BEGIN
        ALIGN TO EQUALS -->
     <para id="para-00081"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
        ALIGN TO EQUALS -->

   <para id="para-00082"><emphasis>Step
        2 </emphasis>- Substitute <m:math display="inline"><m:mrow><m:mi>−</m:mi><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math> for <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> in the second equation.</para>
        <!--BEGIN
        ALIGN TO EQUALS -->
   <para id="para-00083"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>8</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
        ALIGN TO EQUALS -->

	<para id="para-00084"><emphasis>Step 3</emphasis> -
        Solve the equation for <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>.</para>
        <!--BEGIN
        ALIGN TO EQUALS -->
  <para id="para-00085"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>8</m:mn><m:mi>x</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>10</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mrow><m:mn>8</m:mn></m:mrow></m:mfrac></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mfrac><m:mn>5</m:mn><m:mn>4</m:mn></m:mfrac></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
        ALIGN TO EQUALS -->

	<para id="para-00086"><emphasis>Step 4</emphasis> - Substitute
        <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> into <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math> to find <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>.</para>
        <!--BEGIN
        ALIGN TO EQUALS -->
  <para id="para-00087"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>4</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>1</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
        ALIGN TO EQUALS -->

	<para id="para-00088"><emphasis>Step 5</emphasis> - Check
        the ordered pair. <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>,</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">)</m:mo></m:mrow></m:math> in both equations.</para>
        <!--BEGIN
        SIDE BY SIDE EQUATIONS-->
  <para id="para-00089"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"/><m:mtd columnalign="right"><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"/><m:mtd columnalign="right"><m:mn>6</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>4</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mtd><m:mtd columnalign="right"><m:mfrac><m:mrow><m:mn>30</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>4</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mn>4</m:mn></m:mtd><m:mtd columnalign="right"><m:mfrac><m:mrow><m:mn>15</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>5</m:mn><m:mo>−</m:mo><m:mn>1</m:mn><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mn>4</m:mn></m:mtd><m:mtd columnalign="right"><m:mfrac><m:mrow><m:mn>15</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>✓</m:mi></m:mtd><m:mtd columnalign="right"><m:mn>8</m:mn><m:mo>=</m:mo><m:mn>8</m:mn><m:mi>✓</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END
        SIDE BY SIDE EQUATIONS -->

      <!-- END STEPS -->

      <note class="try look-at-me" id="note-00002">
      <title>Try It: Reinforcing the Substitution Method</title>

      <!--Q#-->
        <exercise id="exer-00006">
          <problem id="prob-00017">

            <para id="para-00090">Solve the system by substitution:</para>
            <!--BEGIN
            SYSTEM OF EQUATIONS-->
            <para id="para-00091"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>0</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para><!--END
            SYSTEM OF EQUATIONS -->
            <para id="para-00092"></para>

          </problem>
          <solution id="sol-00017">
            <para id="para-00093">Compare your answer: Your answer may vary, but here is a sample.</para>

            <para id="para-00094"><emphasis>Step 1</emphasis> - Solve the first equation for <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> to isolate a
              variable.</para>

            <para id="para-00095"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mrow><m:mo style="color:red">+</m:mo></m:mrow><m:mspace width="0.278em"/><m:mrow><m:mn style="color:red">4</m:mn></m:mrow><m:mrow><m:mi style="color:red">y</m:mi></m:mrow><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>4</m:mn><m:mspace width="0.278em"/><m:mrow><m:mo style="color:red">+</m:mo></m:mrow><m:mspace width="0.278em"/><m:mrow><m:mn style="color:red">4</m:mn></m:mrow><m:mrow><m:mi style="color:red">y</m:mi></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>4</m:mn><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mi>y</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00096"><emphasis>Step 2</emphasis> - Replace the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> in the second equation with the
              expression <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>y</m:mi></m:mrow></m:math>.</para>

            <para id="para-00097"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mn>0</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>3</m:mn><m:mrow><m:mo style="color:red" stretchy="false">(</m:mo></m:mrow><m:mrow><m:mo style="color:red">−</m:mo></m:mrow><m:mrow><m:mn style="color:red">4</m:mn></m:mrow><m:mspace width="0.278em"/><m:mrow><m:mo style="color:red">+</m:mo></m:mrow><m:mspace width="0.278em"/><m:mrow><m:mn style="color:red">4</m:mn></m:mrow><m:mrow><m:mi style="color:red">y</m:mi></m:mrow><m:mrow><m:mo style="color:red" stretchy="false">)</m:mo></m:mrow><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mn>0</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00098"><emphasis>Step 3</emphasis> - Solve the equation with just one variable.</para>

            <para id="para-00099"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mn>0</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>12</m:mn><m:mo>−</m:mo><m:mn>12</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mn>0</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>8</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>12</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00100"><emphasis>Step 4</emphasis> - Use the first equation and replace <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> with
              <m:math display="inline"><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math>.</para>

            <para id="para-00101"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>6</m:mn><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi><m:mspace width="0.278em"/></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mn>2</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00102"><emphasis>Step 5</emphasis> - The ordered pair is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>,</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>

            <para id="para-00103"><m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00104"><emphasis>Step 6</emphasis> - Substitute <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math> to check the
              solution in both equations.</para>

            <para id="para-00105"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mspace width="0.278em"/><m:mrow><m:mo style="color:red" stretchy="false">(</m:mo></m:mrow><m:mrow><m:mn style="color:red">2</m:mn></m:mrow><m:mrow><m:mo style="color:red" stretchy="false">)</m:mo></m:mrow><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mrow><m:mo style="color:red" stretchy="false">(</m:mo></m:mrow><m:mfrac><m:mrow><m:mn style="color:red">3</m:mn></m:mrow><m:mrow><m:mn style="color:red">2</m:mn></m:mrow></m:mfrac><m:mrow><m:mo style="color:red" stretchy="false">)</m:mo></m:mrow><m:mover>
  <m:mo>=</m:mo>
  <m:mo>?</m:mo>
</m:mover><m:mo>−</m:mo><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mspace width="0.278em"/><m:mn>2</m:mn><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>6</m:mn><m:mover>
  <m:mo>=</m:mo>
  <m:mo>?</m:mo>
</m:mover><m:mo>−</m:mo><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>4</m:mn><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>4</m:mn><m:mspace width="0.278em"/><m:mrow><m:mi style="color:red">✔</m:mi></m:mrow></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00106"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>0</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>3</m:mn><m:mrow><m:mo style="color:red" stretchy="false">(</m:mo></m:mrow><m:mrow><m:mn style="color:red">2</m:mn></m:mrow><m:mrow><m:mo style="color:red" stretchy="false">)</m:mo></m:mrow><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mrow><m:mo style="color:red" stretchy="false">(</m:mo></m:mrow><m:mfrac><m:mrow><m:mn style="color:red">3</m:mn></m:mrow><m:mrow><m:mn style="color:red">2</m:mn></m:mrow></m:mfrac><m:mrow><m:mo style="color:red" stretchy="false">)</m:mo></m:mrow><m:mover>
  <m:mo>=</m:mo>
  <m:mo>?</m:mo>
</m:mover><m:mn>0</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>6</m:mn><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>6</m:mn><m:mover>
  <m:mo>=</m:mo>
  <m:mo>?</m:mo>
</m:mover><m:mn>0</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>0</m:mn><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>0</m:mn><m:mspace width="0.278em"/><m:mrow><m:mi style="color:red">✔</m:mi></m:mrow></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para></solution>
        </exercise>
      </note><!--Interaction
