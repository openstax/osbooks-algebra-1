<!--Q6-->
<example><exercise>
  <problem>
    
    <para>Explain your solution.</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer: Your answer may vary, but here is a sample.</para>
  <!--BEGIN ALIGN TO EQUALS -->
  <para>\(\begin{array}{rcl}
    2m-2p&amp;=&amp;-6
    \\ 2m-2(2m+10)&amp;=&amp;-6
    \\ 2m-4m-20&amp;=&amp;-6
    \\ -2m-20&amp;=&amp;-6
    \\ -2m&amp;=&amp;14
    \\ m&amp;=&amp;-7
    \\ \end{array}\)</para>
  <!--END ALIGN TO EQUALS -->
  
  <!--BEGIN ALIGN TO EQUALS -->
  <para>\(\begin{array}{rcl}
    p&amp;=&amp;2m+10
    \\ p&amp;=&amp;2(-7)+10
    \\ p&amp;=&amp;-14+10
    \\ p&amp;=&amp;-4
    \\ \end{array}\)</para>
  <!--END ALIGN TO EQUALS -->
  
  <!--BEGIN SIDE BY SIDE EQUATIONSS-->
  <para>\(\begin{array}{rcr}
    2(-7)-2(-4)=-6 &amp;   &amp; -4=2(-7)+10\\
    -14+8\overset?=-6 &amp;   &amp; -4\overset?=(-14)+10 \\
    -6=-6\checkmark &amp;   &amp; -4=-4\checkmark
    \end{array}\) </para>
  <!--END SIDE BY SIDE EQUATIONS -->
</solution></exercise>
</example><!--Interaction End -->

