        <exercise id="d4deb8ba-7cb4-4b57-8d73-8e7b37797294" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00051">What is the <m:math display="inline"><m:mrow><m:mi>z</m:mi></m:mrow></m:math> value?</para>
          </problem>
