<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Writing More Inequalities</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00503</md:content-id>
    <md:title>Writing More Inequalities</md:title>
    <md:uuid>205dca80-de11-4b7a-ba61-671791646231</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
      <para id="para-00001">Han has a budget of $25 to buy grapes. Write inequalities to represent the number of
        pounds of grapes that Han could buy in each situation:</para>

      <!--Q#1-->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002">Grapes cost $1.99 per pound.</para>
        </problem>
        <solution id="sol-00001">


          <para id="para-00003">Compare your answer: </para>

          <para id="para-00004"><emphasis>Answer:</emphasis> <m:math display="inline"><m:mrow><m:mn>1.99</m:mn><m:mi>g</m:mi><m:mo>≤</m:mo><m:mn>25</m:mn></m:mrow></m:math></para>

        </solution>
      </exercise>
      <!--Interaction
      End -->


      <!--Q#2-->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00005">Grapes cost $2.49 per pound.</para>
        </problem>
        <solution id="sol-00002">


          <para id="para-00006">Compare your answer: </para>

          <para id="para-00007"><emphasis>Answer:</emphasis> <m:math display="inline"><m:mrow><m:mn>2.49</m:mn><m:mi>g</m:mi><m:mo>≤</m:mo><m:mn>25</m:mn></m:mrow></m:math></para>

        </solution>
      </exercise>
      <!--Interaction
      End -->


      <!--Q#3-->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00008">Grapes cost $<m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math> per pound.</para>
        </problem>
        <solution id="sol-00003">


          <para id="para-00009">Compare your answer: </para>

          <para id="para-00010"><emphasis>Answer:</emphasis> <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mi>g</m:mi><m:mo>≤</m:mo><m:mn>25</m:mn></m:mrow></m:math></para>

        </solution>
      </exercise>
      <!--Interaction
      End -->
    </section>
  </content>
</document>