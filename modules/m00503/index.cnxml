  <content>
  <section><title>Cool Down Activity</title>
<para>Han has a budget of $25 to buy grapes. Write inequalities to represent the number of pounds of grapes that Han could buy in each situation:</para>

<!--Q#1-->
<exercise>
  <problem>
    <para>Grapes cost $1.99 per pound.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para><emphasis>Answer:</emphasis> \( 1.99g ≤ 25 \)</para>
  </solution></exercise>
<!--Interaction End -->


<!--Q#2-->
<exercise>
  <problem>
    <para>Grapes cost $2.49 per pound.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para><emphasis>Answer:</emphasis> \( 2.49g ≤ 25 \)</para>
  </solution></exercise>
<!--Interaction End -->


<!--Q#3-->
<exercise>
  <problem>
    <para>Grapes cost $\(c\) per pound.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para><emphasis>Answer:</emphasis> \( cg ≤ 25 \)</para>
  </solution></exercise>
<!--Interaction End --></section>
