<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.13.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01103</md:content-id>
    <md:title>4.13.6: Practice</md:title>
    <md:uuid>47d7fa48-eb66-4663-bd3f-df8748b53b14</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <section id="sect-00002">
        <exercise id="_79dcc02b-722b-43fa-b175-5d7a3be32eb9" class="multiple-choice">
          <problem id="prob-00001">

            <para id="para-00002">The graph of function <m:math display="inline"><m:mrow><m:mi>H</m:mi></m:mrow></m:math> shows the height, in meters, of a rocket <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> seconds after it was launched.  </para>
          <para id="para-00003"><media alt=""><image mime-type="image/svg+xml" src="../../media/Algebra-1_04_16_13_01.svg"/></media></para>
          <para id="para-00004">Find <m:math display="inline"><m:mrow><m:mi>H</m:mi><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> in meters.</para>
      
          </problem>
          <solution id="sol-00001">
            <para id="para-00005">Correct! 15 meters, This is the height that the rocket was launched.</para>
            <para id="para-00006">Try again. Revisit activity 4.13.3.</para>
            <para id="para-00007">The correct answer is 15 meters. This is the height that the rocket was launched.</para>
          </solution>
        </exercise>
        <exercise id="_401eedc3-c9dd-4ed4-8ce4-c33756bc18bb" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00008">Which of the following describes the domain of this function?</para>
            <para id="para-00009">Multiple Choice:</para>
            <para id="para-00010"><m:math><m:mrow><m:mn>0</m:mn><m:mi>≤</m:mi><m:mi>x</m:mi><m:mi>≤</m:mi><m:mn>35</m:mn></m:mrow></m:math></para>
            <para id="para-00011"><m:math><m:mrow><m:mn>0</m:mn><m:mi>≤</m:mi><m:mi>x</m:mi><m:mi>≤</m:mi><m:mn>4.5</m:mn></m:mrow></m:math></para>
            <para id="para-00012"><m:math><m:mrow><m:mn>0</m:mn><m:mi>≤</m:mi><m:mi>x</m:mi><m:mi>≤</m:mi><m:mn>2</m:mn></m:mrow></m:math></para>
            <para id="para-00013"><m:math><m:mrow><m:mn>15</m:mn><m:mi>≤</m:mi><m:mi>x</m:mi><m:mi>≤</m:mi><m:mn>35</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00014">Correct! <m:math display="inline"><m:mrow><m:mn>0</m:mn><m:mi>≤</m:mi><m:mi>x</m:mi><m:mi>≤</m:mi><m:mn>4.5</m:mn></m:mrow></m:math>.; The domain includes all values from 0 to approximately 4.5, <m:math display="inline"><m:mrow><m:mn>0</m:mn><m:mi>≤</m:mi><m:mi>x</m:mi><m:mi>≤</m:mi><m:mn>4.5</m:mn></m:mrow></m:math>.</para>
            <para id="para-00015">Try again. Revisit activities 4.13.2-4.13.4.</para>
            <para id="para-00016">The correct answer is <m:math display="inline"><m:mrow><m:mn>0</m:mn><m:mi>≤</m:mi><m:mi>x</m:mi><m:mi>≤</m:mi><m:mn>4.5</m:mn></m:mrow></m:math>.; The domain includes all values from 0 to approximately 4.5, <m:math display="inline"><m:mrow><m:mn>0</m:mn><m:mi>≤</m:mi><m:mi>x</m:mi><m:mi>≤</m:mi><m:mn>4.5</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_9d5fb4c0-2545-417f-bb2f-b1720b557e40" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00017">Which of the following describes the range of this function?</para>
            <para id="para-00018">Multiple Choice:</para>
            <para id="para-00019"><m:math><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>35</m:mn></m:mrow></m:math></para>
            <para id="para-00020"><m:math><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>4.5</m:mn></m:mrow></m:math></para>
            <para id="para-00021"><m:math><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
            <para id="para-00022"><m:math><m:mrow><m:mn>15</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>35</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00023">Correct! <m:math display="inline"><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>35</m:mn></m:mrow></m:math>; The range includes all values from 0 to 35 meters, <m:math display="inline"><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>35</m:mn></m:mrow></m:math>.</para>
            <para id="para-00024">Try again. Revisit activities 4.13.2-4.13.4.</para>
            <para id="para-00025">The correct answer is <m:math display="inline"><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>35</m:mn></m:mrow></m:math>. The range includes all values from 0 to 35 meters, <m:math display="inline"><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>35</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_308650af-809d-41dc-99a1-98177f84e23c" class="multiple-choice">
          <problem id="prob-00004">

            <para id="para-00026">Which of the following describes the domain of the function graphed below?</para>
            <para id="para-00027">Multiple Choice:</para>
            <para id="para-00028"><m:math><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
            <para id="para-00029"><m:math><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
            <para id="para-00030"><m:math><m:mrow><m:mn>2</m:mn><m:mo>≤</m:mo><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
            <para id="para-00031"><m:math><m:mrow><m:mn>2</m:mn><m:mo>≤</m:mo><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00032">Correct! <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>≤</m:mi><m:mi>x</m:mi><m:mi>≤</m:mi><m:mn>7</m:mn></m:mrow></m:math>; The domain is all values from at least 2 to a maximum of 7, <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>≤</m:mi><m:mi>x</m:mi><m:mi>≤</m:mi><m:mn>7</m:mn></m:mrow></m:math>.</para>
            <para id="para-00033">Try again. Revisit activity 4.13.4.</para>
            <para id="para-00034">The correct answer is <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>≤</m:mi><m:mi>x</m:mi><m:mi>≤</m:mi><m:mn>7</m:mn></m:mrow></m:math>; the domain is all values from at least 2 to a maximum of 7, <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>≤</m:mi><m:mi>x</m:mi><m:mi>≤</m:mi><m:mn>7</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_54e556fe-abbd-4d44-9fe1-5e2eae99e5db" class="multiple-choice">
          <problem id="prob-00005">

            <para id="para-00035">Which of the following describes the range of the graph below?</para>
            <para id="para-00036">Multiple Choice:</para>
            <para id="para-00037"><m:math><m:mrow><m:mn>2</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
            <para id="para-00038"><m:math><m:mrow><m:mn>2</m:mn><m:mo>≤</m:mo><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
            <para id="para-00039"><m:math><m:mrow><m:mn>2</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
            <para id="para-00040"><m:math><m:mrow><m:mn>2</m:mn><m:mo>≤</m:mo><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00041">Correct! <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>≤</m:mi><m:mi>y</m:mi><m:mi>≤</m:mi><m:mn>4</m:mn></m:mrow></m:math>; The range is all values from at least 2 to a maximum of 4, <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>≤</m:mi><m:mi>y</m:mi><m:mi>≤</m:mi><m:mn>4</m:mn></m:mrow></m:math>.</para>
            <para id="para-00042">Try again. Revisit activity 4.13.4.</para>
            <para id="para-00043">The correct answer is 2≤y≤4. The range is all values from at least 2 to a maximum of 4, 2≤y≤4.</para>
          </solution>
        </exercise>
        <exercise id="fbedf477-1e0e-4f57-85b8-283e720f9c26" class="multiple-choice">
          <problem id="prob-00006">

            <para id="para-00044"><emphasis>Select four</emphasis> of the values of the range for the function <m:math display="inline"><m:mrow><m:mi>h</m:mi></m:mrow></m:math>, graphed below.</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00045">Correct! -3, -2, 2, 4</para>
            <para id="para-00046">Try again. Revisit activity 4.13.4.</para>
            <para id="para-00047">The correct answers are -3, -2, 2, 4.</para>
          </solution>
        </exercise>
        <exercise id="_825d31c6-a7df-4505-a96d-d1ca287623d0" class="multiple-choice">
          <problem id="prob-00007">

            <para id="para-00048">Which of the following is the domain of the function graphed below?</para>
            <para id="para-00049">Multiple Choice:</para>
            <para id="para-00050"><m:math><m:mrow><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>≤</m:mo><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
            <para id="para-00051"><m:math><m:mrow><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>≤</m:mo><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
            <para id="para-00052"><m:math><m:mrow><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
            <para id="para-00053"><m:math><m:mrow><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00054">Correct! <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>≤</m:mi><m:mi>x</m:mi><m:mi>≤</m:mi><m:mn>5</m:mn></m:mrow></m:math></para>
            <para id="para-00055">Try again. Revisit activity 4.13.4.</para>
            <para id="para-00056">The correct answer is <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>≤</m:mi><m:mi>x</m:mi><m:mi>≤</m:mi><m:mn>5</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_1cc90588-8a4b-4dd4-8ace-97732fc4dbe6" class="multiple-choice">
          <problem id="prob-00008">

            <para id="para-00057">Which of the following represents the domain of the function graphed below?</para>
            <para id="para-00058">Multiple Choice:</para>
            <para id="para-00059"><m:math><m:mrow><m:mi>y</m:mi><m:mo>≥</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
            <para id="para-00060"><m:math><m:mrow><m:mi>x</m:mi><m:mo>≥</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
            <para id="para-00061"><m:math><m:mrow><m:mi>y</m:mi><m:mo>≥</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
            <para id="para-00062"><m:math><m:mrow><m:mi>x</m:mi><m:mo>≥</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00063">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mi>≥</m:mi><m:mn>2</m:mn></m:mrow></m:math></para>
            <para id="para-00064">Try again. Revisit activity 4.13.4.</para>
            <para id="para-00065">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mi>≥</m:mi><m:mn>2</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_86d3ccd0-8185-44eb-aa19-e218144f4a7b" class="multiple-choice">
          <problem id="prob-00009">

            <para id="para-00066">Which of the following represents the range of the function graphed below?</para>
            <para id="para-00067">Multiple Choice:</para>
            <para id="para-00068"><m:math><m:mrow><m:mi>y</m:mi><m:mo>≥</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
            <para id="para-00069"><m:math><m:mrow><m:mi>x</m:mi><m:mo>≥</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
            <para id="para-00070"><m:math><m:mrow><m:mi>y</m:mi><m:mo>≥</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
            <para id="para-00071"><m:math><m:mrow><m:mi>x</m:mi><m:mo>≥</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00072">Correct! <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>≥</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
            <para id="para-00073">Try again. Revisit activity 4.13.4.</para>
            <para id="para-00074">The correct answer is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mi>≥</m:mi><m:mn>5</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
      </section>
    </section>
  </content></document>
