    <md:content-id>m01570</md:content-id>
    <md:title>6.1.2: Adding and Subtracting Polynomials</md:title>
    <md:uuid>7a38b2ed-90c4-4b17-9644-6c53fd8ea531</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Activity</title>
<para id="para-00001">We will solve these two problems as a class.</para>

<exercise id="exer-00001">
  <problem id="prob-00001">
    
    <para id="para-00002">Do these terms have the same variables with the same exponents? Explain your answer. 
        
        \(6x^4y^2\)         \(8x^4y^2\)</para>
    <para id="para-00003">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00001">
  <para id="para-00004">Compare your answer:</para>
  
  <para id="para-00005">Yes. Both terms have the same variables raised to the same degrees: \(x\) is raised to the fourth power, and \(y\) is squared.</para>

</solution></exercise>

<exercise id="exer-00002">
  <problem id="prob-00002">
    
    <para id="para-00006">Add the terms together: \(6x^4y^2+8x^4y^2\). What is the sum? 
    </para>
    <para id="para-00007">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00002">
  <para id="para-00008">Compare your answer:</para>
  
  <para id="para-00009">\(14x^4y^2\)</para>

</solution></exercise>

<para id="para-00010">In problems 3 - 7, simplify the monomial addition and subtraction problems on your own. Write down your answer, then select the solution button to compare your work.</para>

<!--Q#3-->
<exercise id="exer-00003">
  <problem id="prob-00003">
    
    <para id="para-00011">\(12q+9q\)</para>
    <para id="para-00012">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00003">
  <para id="para-00013">Compare your answer:</para>
  
  <para id="para-00014">\(21q\)</para>

</solution></exercise>
<!--Interaction End --> 

<!--Q#4-->
<exercise id="exer-00004">
  <problem id="prob-00004">
    
    <para id="para-00015">\(-14c^3+5c^3\)</para>
    <para id="para-00016">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00004">
  <para id="para-00017">Compare your answer:</para>
  
  <para id="para-00018">\(-9c^3\)</para>

</solution></exercise>
<!--Interaction End --> 

<!--Q#5-->
<exercise id="exer-00005">
  <problem id="prob-00005">
    
    <para id="para-00019">\(8g^2h^2+(-6g^2h^2)\)</para>
    <para id="para-00020">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00005">
  <para id="para-00021">Compare your answer:</para>
  
  <para id="para-00022">\(2g^2h^2\)</para>

</solution></exercise>
<!--Interaction End --> 

<!--Q#6-->
<exercise id="exer-00006">
  <problem id="prob-00006">
    
    <para id="para-00023">\(8mn^3p-(-5mn^3p)\)</para>
    <para id="para-00024">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00006">
  <para id="para-00025">Compare your answer:</para>
  
  <para id="para-00026">\(13mn^3p\)</para>

</solution></exercise>
<!--Interaction End --> 

<!--Q#7-->
<exercise id="exer-00007">
  <problem id="prob-00007">
    
    <para id="para-00027">\(-16a^2+3b^2+8a^2 \)</para>
    <para id="para-00028">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00007">
  <para id="para-00029">Compare your answer:</para>
  
  <para id="para-00030">\(-8a^2+3b^2\)</para>

</solution></exercise>
<!--Interaction End --> 

<!--Text Entry Interaction Start -->
<exercise id="exer-00008">
  <problem id="prob-00008">
    <para id="para-00031">Can the following monomials be simplified using like terms? Explain. 
        
        \(17a^2bc^3+6a^2b^2c^3\)</para>
    </problem><solution id="sol-00008">
    
    
  
  <para id="para-00032">Compare your answer:</para>
    
    <para id="para-00033">No, the monomial terms do not contain the same variables with the same exponents. The first term has the variable \(b\) with an exponent of 1. The second term has the variable \(b\) with an exponent of 2. The monomials are not like terms.</para>
  
  </solution></exercise>

<para id="para-00034">In problems 9 - 14, simplify the polynomial addition and subtraction problems on your own.  Write down your answer, then select the solution button to compare your work.</para>

<!--Q#9-->
<exercise id="exer-00009">
  <problem id="prob-00009">
    
    <para id="para-00035">\( (5k+7m-2)+(7k+9m-4)\)</para>
    <para id="para-00036">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00009">
  <para id="para-00037">Compare your answer:</para>
  
  <para id="para-00038">\(12k+16m-6\)</para>

</solution></exercise>
<!--Interaction End --> 


<!--Q#10-->
<exercise id="exer-00010">
  <problem id="prob-00010">
    
    <para id="para-00039">\((12w-11)-(5w+6) \)</para>
    <para id="para-00040">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00010">
  <para id="para-00041">Compare your answer:</para>
  
  <para id="para-00042">\(7w-5\)</para>

</solution></exercise>
<!--Interaction End --> 


<!--Q#11-->
<exercise id="exer-00011">
  <problem id="prob-00011">
    
    <para id="para-00043">\((5k^2+7k-2)+(7k^2+9k-4)\)</para>
    <para id="para-00044">You can use the following video if you need some help.</para>
    
    <media alt="Placeholder for Alt Text"><iframe width="660" height="371.4" src="https://k12.openstax.org/contents/raise/resources/ba5bc330fb9f7f706e35cf5a38cdfedb85f34aec"/></media><para id="para-00045">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00011">
  <para id="para-00046">Compare your answer:</para>
  
  <para id="para-00047">\(12k^2+16k-6\)</para>

</solution></exercise>
<!--Interaction End --> 


<!--Q#12-->
<exercise id="exer-00012">
  <problem id="prob-00012">
    
    <para id="para-00048">\((9h^2-4h+17)+(2h^2-9)\)</para>
    <para id="para-00049">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00012">
  <para id="para-00050">Compare your answer:</para>
  
  <para id="para-00051">\(11h^2-4h+8\)</para>

</solution></exercise>
<!--Interaction End --> 




<!--Q#13-->
<exercise id="exer-00013">
  <problem id="prob-00013">
    
    <para id="para-00052">\((8f^2+6fv-3v^2)-(6f^2-3v^2)\)</para>
    <para id="para-00053">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00013">
  <para id="para-00054">Compare your answer:</para>
  
  <para id="para-00055">\(2f^2+6fv\)</para>

</solution></exercise>
<!--Interaction End --> 


<!--Q#14-->
<exercise id="exer-00014">
  <problem id="prob-00014">
    
    <para id="para-00056">\((8z^3-6zx+3x^2)+(12z^3-4zx)\)</para>
    <para id="para-00057">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00014">
  <para id="para-00058">Compare your answer:</para>
  
  <para id="para-00059">\(20z^3-10zx+3x^2\)</para>

</solution></exercise>
<!--Interaction End --> 
</section>

<!-- "Start "Are you Ready for More? click to reveal.  If you have more than one on a page, you will need to change the Data-fire/data-wait-for-events for each set.-->
<section id="sect-00002">
  <title>Are you ready for more?</title>
    <section id="sect-00003">    <title>Extending Your Thinking</title>

<!--Start interaction.  If multiple interactions appear under "are you ready for more?, they should all have matching "data-wait-for-event", which should also match the "data-fire-event" for the button. Note in this sample, they are all RFM1-->
<exercise class="RFM1" id="exer-00015">
  <problem id="prob-00015">
    
    <para id="para-00060">Simplify. Use the "^" symbol to enter an exponent.</para>
    
    <para id="para-00061">\((6a^3-2a^2b)-2(ab^2+3b^3)+(2a^2b+2ab^2)\)</para>
  
  </problem><solution id="sol-00015">
    
    
  
  <para id="para-00062">Compare your answer:</para>
    
    <para id="para-00063">\(6a^3-6b^3\)</para>
    
    <para id="para-00064">Here is how to solve this problem:
      \((6a^3-2a^2b)-2(ab^2+3b^3)+(2a^2b+2ab^2)\)</para>
    
    <para id="para-00065"><emphasis>Step 1 - 
     </emphasis> Distribute the multiplication over addition.</para>
    
    <para id="para-00066">     \(6a^3-2a^2b-2ab^2-6b^3+2a^2b+2ab^2\)</para>
    
    <para id="para-00067"><emphasis>Step 2 - 
     </emphasis> Use the Commutative Property to rearrange like terms together.</para>
    
    <para id="para-00068">     \(6a^3-2a^2b+2a^2b-2ab^2+2ab^2-6b^3\)</para>
    
    <para id="para-00069"><emphasis>Step 3 - 
     </emphasis> Combine like terms.</para>
    
    <para id="para-00070">     \(6a^3-6b^3\)</para>
  
  </solution></exercise>
<!--End interaction--></section>
</section>


<note class="self-check" id="note-00001"><para id="para-00071">Find the sum.</para>
  <para id="para-00072">\((14y^2+6y-4)+(3y^2+8y+5)\)</para></note>

  
<section id="sect-00004"><title>Additional Resources</title>
  <section id="sect-00005"><title>Adding and Subtracting Monomials</title>
    <para id="para-00073">We have learned how to simplify expressions by combining like terms. Remember, like terms must have the same variables with the same exponent. Since monomials are terms, adding and subtracting monomials is the same as combining like terms. If the monomials are like terms, we just combine them by adding or subtracting the coefficients. Remember that like terms must have the same variables with the same exponents.</para>
    <para id="para-00074">These terms have the same variables and the same exponents:</para>
    <list id="list-00001">
      <item>\(5m^3n^2\)          \(2m^3n^2\)</item>
    </list>
    <para id="para-00075">So we can add the monomials:</para>
    <list id="list-00002">
      <item>\(5m^3n^2 + 2m^3n^2 = 7m^3n^2\)</item>
    </list>
    <para id="para-00076">The variables and exponents of the monomials do not change when we add or subtract them.</para>
    <para><emphasis id="para-00077">Example 1</emphasis></para>
    <para id="para-00078">\(18a+2a\)</para>
    <para id="para-00079"><emphasis>Step 1 -</emphasis> Combine like terms.</para>
    <para id="para-00080">\(18a+2a = 20a\)</para>
    <para><emphasis id="para-00081">Example 2</emphasis></para>
    <para id="para-00082">\(37t-15t\)</para>
    <para id="para-00083"><emphasis>Step 1 -</emphasis> Combine like terms.</para>
    <para id="para-00084">\(37t-15t =22t\)</para>
    <para><emphasis id="para-00085">Example 3</emphasis></para>
    <para id="para-00086">\(25y^2+15y^2\)</para>
    <para id="para-00087"><emphasis>Step 1 -</emphasis> Combine like terms.</para>
    <para id="para-00088">\(25y^2+15y^2=40y^2\)</para>
    
    
    <note class="try" id="note-00002">
    <title>Try It: Adding and Subtracting Monomials</title>
    
    <exercise id="exer-00016">
      <problem id="prob-00016">
          
        <para id="para-00089">\(16pq^3-(-7pq^3)\)</para>
      
      <para id="para-00090">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
      
      </problem><solution id="sol-00016">
      <para id="para-00091">Compare your answer:</para>
      
      <para id="para-00092">\(\begin{array}{rcl}16pq^3-(-7pq^3)&amp;=&amp;16pq^3+7pq^3\\&amp;=&amp;23pq^3\end{array}\)</para>
    
    </solution></exercise></note>
    <!--Interaction End --> 
    
    
    <para id="para-00093">We can think of adding and subtracting polynomials as just adding and subtracting a series of monomials. Look for the like terms—those with the same variables and the same exponent. The Commutative Property allows us to rearrange the terms to put like terms together.</para>
    <para id="para-00094">Let’s look at some examples.</para>
    <para><emphasis id="para-00095">Example 1</emphasis></para>
    <para id="para-00096">Find the sum: \((7y^2-2y+9)+(4y^2-8y-7)\).</para>
    <para id="para-00097"><emphasis>Step 1 -</emphasis> Identify like terms by finding those with the same variable and same exponent.</para>
    <para id="para-00098">\(({\style{color:red}7}{\style{color:red}y}^{\style{color:red}2} - {\style{color:blue}2}{\style{color:blue}y} + 9) + ({\style{color:red}4}{\style{color:red}y}^{\style{color:red}2} - {\style{color:blue}8}{\style{color:blue}y} - 7)\)</para>
    <para id="para-00099"><emphasis>Step 2 -</emphasis> Use the Commutative Property to rearrange like terms together. Be sure to take the appropriate sign with each term \((+/-)\).</para>
    <para id="para-00100">\({\style{color:red}7}{\style{color:red}y}^{\style{color:red}2} + {\style{color:red}4}{\style{color:red}y}^{\style{color:red}2} - {\style{color:blue}2}{\style{color:blue}y} - {\style{color:blue}8}{\style{color:blue}y} + 9 - 7\)</para>
    <para id="para-00101"><emphasis>Step 3 -</emphasis> Combine like terms.</para>
    <para id="para-00102">\({\style{color:red}1}{\style{color:red}1}{\style{color:red}y}^{\style{color:red}2} - {\style{color:blue}1}{\style{color:blue}0}{\style{color:blue}y} + 2\)</para>
    <para><emphasis id="para-00103">Example 2</emphasis></para>
    <para id="para-00104">Find the sum: \((22g-14h+3)+(10g+8h-9)\)</para>
    <para id="para-00105"><emphasis>Step 1 -</emphasis> Identify like terms.</para>
    <para id="para-00106">\(({\style{color:red}2}{\style{color:red}2}{\style{color:red}g}-{\style{color:blue}1}{\style{color:blue}4}{\style{color:blue}h}+3)+({\style{color:red}1}{\style{color:red}0}{\style{color:red}g}+{\style{color:blue}8}{\style{color:blue}h}-9)\)</para>
    <para id="para-00107">Color 22g, 10g in red.  14h, 8h in blue.</para>
    <para id="para-00108"><emphasis>Step 2 -</emphasis> Use the Commutative Property to rearrange like terms together. Be sure to take the appropriate sign with each term (+/−).</para>
    <para id="para-00109">\(({\style{color:red}2}{\style{color:red}2}{\style{color:red}g}+{\style{color:red}1}{\style{color:red}0}{\style{color:red}g}-{\style{color:blue}1}{\style{color:blue}4}{\style{color:blue}h}+{\style{color:blue}8}{\style{color:blue}h} +3+9)\)</para>
    <para id="para-00110"><emphasis>Step 3 -</emphasis> Combine like terms.</para>
    <para id="para-00111">\(32g-6h +12\)</para>
    <para><emphasis id="para-00112">Example 3</emphasis></para>
    <para id="para-00113">Find the sum: \((8j+7k)+(2s^2-3k+26)\)</para>
    <para id="para-00114"><emphasis>Step 1 -</emphasis> Identify like terms.</para>
    <para id="para-00115">\((8j+{\style{color:blue}7}{\style{color:blue}k}-3)+({\style{color:red}2}{\style{color:red}s}^{\style{color:red}2}-{\style{color:blue}3}{\style{color:blue}k}+26)\)</para>
    <para id="para-00116"><emphasis>Step 2 -</emphasis> Rearrange like terms together.</para>
    <para id="para-00117">\({\style{color:red}2}{\style{color:red}s}^{\style{color:red}2}+{\style{color:blue}7}{\style{color:blue}k}-{\style{color:blue}3}{\style{color:blue}k}+8j-3+26\)</para>
    <para id="para-00118"><emphasis>Step 3 -</emphasis> Combine like terms.</para>
    <para><emphasis id="para-00119">Example 4</emphasis></para>
    <para id="para-00120">Find the difference: \((15g-4h+8)-(10g+13h-1)\)</para>
    <para id="para-00121"><emphasis>Step 1 -</emphasis> Identify like terms.</para>
    <para id="para-00122">\(({\style{color:red}1}{\style{color:red}5}{\style{color:red}g}-{\style{color:blue}4}{\style{color:blue}h}+8)-({\style{color:red}1}{\style{color:red}0}{\style{color:red}g}+{\style{color:blue}1}{\style{color:blue}3}{\style{color:blue}h}-1)\)</para>
    <para id="para-00123"><emphasis>Step 2 -</emphasis> Rearrange like terms together.</para>
    <para id="para-00124">Remember to distribute the subtraction to all terms in the second polymnomial.</para>
    <para id="para-00125">\({\style{color:red}1}{\style{color:red}5}{\style{color:red}g}-{\style{color:red}1}{\style{color:red}0}{\style{color:red}g}-{\style{color:blue}4}{\style{color:blue}h}-{\style{color:blue}1}{\style{color:blue}3}{\style{color:blue}h}+8+1\)</para>
    <para id="para-00126"><emphasis>Step 3 -</emphasis> Combine like terms.</para>
    <para id="para-00127">\(5g-17h+9\)</para>
    <para><emphasis id="para-00128">Example 5</emphasis></para>
    <para id="para-00129">Find the difference: \((16y^2+12y+9)-(3y^2+2y-12) \)</para>
    <para id="para-00130"><emphasis>Step 1 -</emphasis> Identify like terms.</para>
    <para id="para-00131">\(({\style{color:red}1}{\style{color:red}6}{\style{color:red}y}^{\style{color:red}2}+{\style{color:blue}1}{\style{color:blue}2}{\style{color:blue}y}+9)-({\style{color:red}3}{\style{color:red}y}^{\style{color:red}2}+{\style{color:blue}2}{\style{color:blue}y}-12) \)</para>
    <para id="para-00132"><emphasis>Step 2 -</emphasis> Rearrange like terms together.</para>
    <para id="para-00133">\(({\style{color:red}1}{\style{color:red}6}{\style{color:red}y}^{\style{color:red}2}-{\style{color:red}3}{\style{color:red}y}^{\style{color:red}2}+{\style{color:blue}1}{\style{color:blue}2}{\style{color:blue}y}-{\style{color:blue}2}{\style{color:blue}y}+9+12) \)</para>
    <para id="para-00134"><emphasis>Step 3 -</emphasis> Combine like terms.</para>
    <para id="para-00135">\((13y^2+10y+21) \)</para>
    
    <note class="try" id="note-00003">
    <title>Try It: Adding and Subtracting Polynomials</title>
    
    <exercise id="exer-00017">
      <problem id="prob-00017">
        
        <para id="para-00136">Find the sum and difference. If necessary, be careful with the signs as you distribute while subtracting the polynomials.</para>
        
        <para id="para-00137">\((7x^2-4x+5)+(x^2-7x+3)\)</para>
        <para id="para-00138">Write down your answers. Then select the <emphasis>solution</emphasis> button to compare your work.</para>
      
      </problem><solution id="sol-00017">
      <para id="para-00139">Compare your answer:</para>
      
      <para id="para-00140">\((7x^2-4x+5)+(x^2-7x+3)=8x^2-11x+8\)</para>
    
    </solution></exercise>
  </note>
    <!--Q#2b-->
    <!--Interaction End --> 
    
    <!--Q#3c-->
    <!--Interaction End --> 
    
    <exercise id="exer-00018">
      <problem id="prob-00018">
        
        <para id="para-00141">\((8a+12b)-(10a+3b)\)</para>
        <para id="para-00142">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
      
      </problem><solution id="sol-00018">
      <para id="para-00143">Compare your answer:</para>
      
      <para id="para-00144">\(\begin{array}{rcl}(8a+12b)-(10a+3b)&amp;=&amp;8a+12b-10a-3b\\&amp;=&amp;-2a+9b\\&amp;=&amp;2a-9b\end{array}\)</para>
    
    </solution></exercise>
    <exercise id="exer-00019">
      <problem id="prob-00019">
        
        <para id="para-00145">\((9w^2-7w+5)-(2w^2-4)\)</para>
        <para id="para-00146">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
      
      </problem><solution id="sol-00019">
      <para id="para-00147">Compare your answer:</para>
      
      <para id="para-00148">\(\begin{array}{rcl}(9w^2-7w+5)-(2w^2-4)&amp;=&amp;(9w^2-7w+5)-2w^2+4\\&amp;=&amp;7w^2-7w+9\end{array}\)</para>
    
    </solution></exercise>
    </section></section>
</content>
</document>