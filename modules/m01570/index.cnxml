          <para id="para-00015"><m:math>
              <m:mrow>
                <m:mo>−</m:mo>
                <m:mn>14</m:mn>
                <m:msup>
                  <m:mi>c</m:mi>
                  <m:mn>3</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>5</m:mn>
                <m:msup>
                  <m:mi>c</m:mi>
                  <m:mn>3</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
          <para id="para-00016">Write down your answer, then select the <emphasis>solution</emphasis>
            button to compare your work.</para>

        </problem>
        <solution id="sol-00004">
          <para id="para-00017">Compare your answer:</para>

          <para id="para-00018"><m:math>
              <m:mrow>
                <m:mo>−</m:mo>
                <m:mn>9</m:mn>
                <m:msup>
                  <m:mi>c</m:mi>
                  <m:mn>3</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!--Q#5-->
      <exercise id="exer-00005">
        <problem id="prob-00005">

          <para id="para-00019"><m:math>
              <m:mrow>
                <m:mn>8</m:mn>
                <m:msup>
                  <m:mi>g</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:msup>
                  <m:mi>h</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>−</m:mo>
                <m:mn>6</m:mn>
                <m:msup>
                  <m:mi>g</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:msup>
                  <m:mi>h</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
          <para id="para-00020">Write down your answer, then select the <emphasis>solution</emphasis>
            button to compare your work.</para>

        </problem>
        <solution id="sol-00005">
          <para id="para-00021">Compare your answer:</para>

          <para id="para-00022"><m:math>
              <m:mrow>
                <m:mn>2</m:mn>
                <m:msup>
                  <m:mi>g</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:msup>
                  <m:mi>h</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!--Q#6-->
      <exercise id="exer-00006">
        <problem id="prob-00006">

          <para id="para-00023"><m:math>
              <m:mrow>
                <m:mn>8</m:mn>
                <m:mi>m</m:mi>
                <m:msup>
                  <m:mi>n</m:mi>
                  <m:mn>3</m:mn>
                </m:msup>
                <m:mi>p</m:mi>
                <m:mo>−</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>−</m:mo>
                <m:mn>5</m:mn>
                <m:mi>m</m:mi>
                <m:msup>
                  <m:mi>n</m:mi>
                  <m:mn>3</m:mn>
                </m:msup>
                <m:mi>p</m:mi>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
          <para id="para-00024">Write down your answer, then select the <emphasis>solution</emphasis>
            button to compare your work.</para>

        </problem>
        <solution id="sol-00006">
          <para id="para-00025">Compare your answer:</para>

          <para id="para-00026"><m:math>
              <m:mrow>
                <m:mn>13</m:mn>
                <m:mi>m</m:mi>
                <m:msup>
                  <m:mi>n</m:mi>
                  <m:mn>3</m:mn>
                </m:msup>
                <m:mi>p</m:mi>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!--Q#7-->
      <exercise id="exer-00007">
        <problem id="prob-00007">

          <para id="para-00027"><m:math>
              <m:mrow>
                <m:mo>−</m:mo>
                <m:mn>16</m:mn>
                <m:msup>
                  <m:mi>a</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>3</m:mn>
                <m:msup>
                  <m:mi>b</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>8</m:mn>
                <m:msup>
                  <m:mi>a</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
          <para id="para-00028">Write down your answer, then select the <emphasis>solution</emphasis>
            button to compare your work.</para>

        </problem>
        <solution id="sol-00007">
          <para id="para-00029">Compare your answer:</para>

          <para id="para-00030"><m:math>
              <m:mrow>
                <m:mo>−</m:mo>
                <m:mn>8</m:mn>
                <m:msup>
                  <m:mi>a</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>3</m:mn>
                <m:msup>
                  <m:mi>b</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00008">
        <problem id="prob-00008">
          <para id="para-00031">Can the following monomials be simplified using like terms? Explain. <m:math
              display="inline">
              <m:mrow>
                <m:mn>17</m:mn>
                <m:msup>
                  <m:mi>a</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mi>b</m:mi>
                <m:msup>
                  <m:mi>c</m:mi>
                  <m:mn>3</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>6</m:mn>
                <m:msup>
                  <m:mi>a</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:msup>
                  <m:mi>b</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:msup>
                  <m:mi>c</m:mi>
                  <m:mn>3</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00008">


          <para id="para-00032">Compare your answer:</para>

          <para id="para-00033">No, the monomial terms do not contain the same variables with the
            same exponents. The first term has the variable <m:math display="inline">
              <m:mrow>
                <m:mi>b</m:mi>
              </m:mrow>
            </m:math> with an exponent of 1.
            The second term has the variable <m:math display="inline">
              <m:mrow>
                <m:mi>b</m:mi>
              </m:mrow>
            </m:math> with an exponent of 2.
            The monomials are not like terms.</para>

        </solution>
      </exercise>

      <para id="para-00034">In problems 9 - 14, simplify the polynomial addition and subtraction
        problems on your own. Write down your answer, then select the solution button to compare
        your work.</para>

      <!--Q#9-->
      <exercise id="exer-00009">
        <problem id="prob-00009">

          <para id="para-00035"><m:math>
