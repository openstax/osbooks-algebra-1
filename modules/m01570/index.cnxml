                <m:mo>−</m:mo>
                <m:mn>4</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
          <para id="para-00036">Write down your answer, then select the <emphasis>solution</emphasis>
