        </problem>
        <solution id="sol-00009">
          <para id="para-00037">Compare your answer:</para>

          <para id="para-00038"><m:math>
              <m:mrow>
                <m:mn>12</m:mn>
                <m:mi>k</m:mi>
                <m:mo>+</m:mo>
                <m:mn>16</m:mn>
                <m:mi>m</m:mi>
                <m:mo>−</m:mo>
                <m:mn>6</m:mn>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->


      <!--Q#10-->
