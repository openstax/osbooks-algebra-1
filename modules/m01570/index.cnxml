                <m:mo stretchy="false">)</m:mo>
                <m:mo>+</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>7</m:mn>
                <m:mi>k</m:mi>
                <m:mo>+</m:mo>
                <m:mn>9</m:mn>
