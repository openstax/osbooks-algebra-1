<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.1.2: Adding and Subtracting Polynomials</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01570</md:content-id>
    <md:title>6.1.2: Adding and Subtracting Polynomials</md:title>
    <md:uuid>7a38b2ed-90c4-4b17-9644-6c53fd8ea531</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">
      <title>Activity</title>
      <para id="para-00001">We will solve these two problems as a class.</para>

      <exercise id="exer-00001">
        <problem id="prob-00001">

          <para id="para-00002">Do these terms have the same variables with the same exponents?
            Explain your answer. <m:math display="inline">
              <m:mrow>
                <m:mn>6</m:mn>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>4</m:mn>
                </m:msup>
                <m:msup>
                  <m:mi>y</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math> 
                   <m:math display="inline">
              <m:mrow>
                <m:mn>8</m:mn>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>4</m:mn>
                </m:msup>
                <m:msup>
                  <m:mi>y</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
          <para id="para-00003">Write down your answer, then select the <emphasis>solution</emphasis>
            button to compare your work.</para>

        </problem>
        <solution id="sol-00001">
          <para id="para-00004">Compare your answer:</para>

          <para id="para-00005">Yes. Both terms have the same variables raised to the same degrees: <m:math
              display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math> is raised to the fourth
            power, and <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math> is squared.</para>

        </solution>
      </exercise>

      <exercise id="exer-00002">
        <problem id="prob-00002">

          <para id="para-00006">Add the terms together: <m:math display="inline">
              <m:mrow>
                <m:mn>6</m:mn>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>4</m:mn>
                </m:msup>
                <m:msup>
                  <m:mi>y</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>8</m:mn>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>4</m:mn>
                </m:msup>
                <m:msup>
                  <m:mi>y</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math>.
            What is the sum? </para>
          <para id="para-00007">Write down your answer, then select the <emphasis>solution</emphasis>
            button to compare your work.</para>

        </problem>
        <solution id="sol-00002">
          <para id="para-00008">Compare your answer:</para>

          <para id="para-00009"><m:math>
              <m:mrow>
                <m:mn>14</m:mn>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>4</m:mn>
                </m:msup>
                <m:msup>
                  <m:mi>y</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>

      <para id="para-00010">In problems 3 - 7, simplify the monomial addition and subtraction
        problems on your own. Write down your answer, then select the solution button to compare
        your work.</para>

      <!--Q#3-->
      <exercise id="exer-00003">
        <problem id="prob-00003">

          <para id="para-00011"><m:math>
              <m:mrow>
                <m:mn>12</m:mn>
                <m:mi>q</m:mi>
                <m:mo>+</m:mo>
                <m:mn>9</m:mn>
                <m:mi>q</m:mi>
              </m:mrow>
            </m:math></para>
          <para id="para-00012">Write down your answer, then select the <emphasis>solution</emphasis>
            button to compare your work.</para>

        </problem>
        <solution id="sol-00003">
          <para id="para-00013">Compare your answer:</para>

          <para id="para-00014"><m:math>
              <m:mrow>
                <m:mn>21</m:mn>
                <m:mi>q</m:mi>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!--Q#4-->
      <exercise id="exer-00004">
