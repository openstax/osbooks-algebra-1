<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Finding Solutions to Unordered Sets of Equivalent Systems</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00463</md:content-id>
    <md:title>Finding Solutions to Unordered Sets of Equivalent Systems</md:title>
    <md:uuid>1f377df3-5bf3-4ba4-a9f8-09643dea8dd3</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001">    <title>Activity</title>
<para id="para-00001">Your teacher will give you <link url="https://k12.openstax.org/contents/raise/resources/74b1462d9980264eb938b40c3495ef692bca5728">some slips of paper</link> with systems of equations written on them. Each system represents a step in solving this system:</para>
<para id="para-00002"><m:math display="inline"><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>15</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>-</m:mtext><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>18</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>11</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></para><para id="para-00003">Arrange the slips in the order that would lead to a solution. Be prepared to:</para>
<!-- BEGIN TEXT ENTRY WITH REVEAL -->

<!--Q#-->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00004">Describe what move takes one system to the next system.</para>
    </problem>
    <solution id="sol-00001">
  <para id="para-00005">Compare your answer: </para>
    
    <para id="para-00006"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>15</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>-</m:mtext><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>18</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>11</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></para><para id="para-00007"><emphasis>Step 1</emphasis> -</para>
    
    <para id="para-00008"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>30</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>75</m:mn><m:mspace linebreak="newline"/><m:mtext>-</m:mtext><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>18</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>11</m:mn></m:mrow></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></para><para id="para-00009"><emphasis>Step 2</emphasis> -</para>
    
    <para id="para-00010"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>30</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>75</m:mn><m:mspace linebreak="newline"/><m:mtext>-</m:mtext><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>72</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>44</m:mn></m:mrow></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></para><para id="para-00011"><emphasis>Step 3</emphasis> -</para>
    
    <para id="para-00012"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>30</m:mn><m:mi>y</m:mi><m:mi/><m:mo>=</m:mo><m:mspace width="2mm"/><m:mn>75</m:mn><m:mspace linebreak="newline"/><m:mn>102</m:mn><m:mi>y</m:mi><m:mi/><m:mo>=</m:mo><m:mn>119</m:mn></m:mrow></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></para><para id="para-00013"><emphasis>Step 4</emphasis> -</para>
    
    <para id="para-00014"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>30</m:mn><m:mi>y</m:mi><m:mi/><m:mo>=</m:mo><m:mn>75</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi/><m:mo>=</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></para><para id="para-00015"><emphasis>Step 5</emphasis> -</para>
    
    <para id="para-00016"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>35</m:mn><m:mi/><m:mo>=</m:mo><m:mn>75</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi/><m:mo>=</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></para><para id="para-00017"><emphasis>Step 6</emphasis> -</para>
    
    <para id="para-00018"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mi/><m:mo>=</m:mo><m:mn>40</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi/><m:mo>=</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></para><para id="para-00019"><emphasis>Step 7</emphasis> -</para>
    
    <para id="para-00020"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mrow><m:mi>x</m:mi><m:mi/><m:mo>=</m:mo><m:mn>10</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mi/><m:mo>=</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></para></solution>
</exercise>
<!--Interaction End -->

<!-- END TEXT ENTRY WITH REVEAL -->
<!-- BEGIN TEXT ENTRY WITH REVEAL -->

<!--Q#2-->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00021">Explain why the systems are equivalent between the original system and step 1.</para>
    </problem>
    <solution id="sol-00002">
  <para id="para-00022">Compare your answer: </para>
    
    <para id="para-00023">Your answer may vary, but here is a sample.</para>
    
    <list id="list-00001">
      <item>Multiply the first equation by 5.</item>
    </list>
  </solution>
</exercise>
<!--Interaction End -->

<!-- END TEXT ENTRY WITH REVEAL -->
<!-- BEGIN TEXT ENTRY WITH REVEAL -->

<!--Q#3-->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00024">Explain why the systems are equivalent between the system in step 1 to the system in step 2.</para>
    </problem>
    <solution id="sol-00003">
  <para id="para-00025">Compare your answer: </para>
    
    <para id="para-00026">Your answer may vary, but here is a samples.</para>
    
    <list id="list-00002">
      <item>Multiply the second equation by 4.</item>
    </list>
  </solution>
</exercise>
<!--Interaction End -->

<!-- END TEXT ENTRY WITH REVEAL -->
<!-- BEGIN TEXT ENTRY WITH REVEAL -->

<!--Q#4-->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00027">Explain why the systems are equivalent between the system in step 2 to the system in step 3.</para>
    </problem>
    <solution id="sol-00004">
  <para id="para-00028">Compare your answer: </para>
    
    <para id="para-00029">Your answer may vary, but here is a samples.</para>
    
    <list id="list-00003">
      <item>Add the two equations in Step 2.</item>
    </list>
  </solution>
  </exercise>
<!--Interaction End -->

<!-- END TEXT ENTRY WITH REVEAL -->
<!-- BEGIN TEXT ENTRY WITH REVEAL -->

<!--Q#5-->
<exercise id="exer-00005">
  <problem id="prob-00005">
    <para id="para-00030">Explain why the systems are equivalent between the system in step 3 to the system in step 4.</para>
    </problem>
    <solution id="sol-00005">
    <para id="para-00031">Compare your answer: </para>
    
    <para id="para-00032">Your answer may vary, but here is a samples.</para>
    
    <list id="list-00004">
      <item>Divide each side of <m:math display="inline"><m:mrow><m:mn>102</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>119</m:mn></m:mrow></m:math> by 102 to solve for <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>.</item>
    </list>
  </solution>
</exercise>
<!--Interaction End -->

<!-- END TEXT ENTRY WITH REVEAL -->
<!-- BEGIN TEXT ENTRY WITH REVEAL -->

<!--Q#6-->
<exercise id="exer-00006">
  <problem id="prob-00006">
    <para id="para-00033">Explain why the systems are equivalent between the system in step 4 to the system in step 5.</para>
    </problem>
    <solution id="sol-00006">
    <para id="para-00034">Compare your answer: </para>
    
    <para id="para-00035">Your answer may vary, but here is a samples.</para>
    
    <list id="list-00005">
      <item>Substitute <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>7</m:mn></m:mrow><m:mrow><m:mn>6</m:mn></m:mrow></m:mfrac></m:mrow></m:math>  for y in the first equation and evaluating the expression.</item>
    </list>
  
  </solution></exercise>
<!--Interaction End -->

<!-- END TEXT ENTRY WITH REVEAL -->
<!--Q#7-->
<exercise id="exer-00007">
  <problem id="prob-00007">
    <para id="para-00036">Explain why the systems are equivalent between the system in step 5 to the system in step 6.</para>
    </problem>
    <solution id="sol-00007">
  <para id="para-00037">Compare your answer: </para>
    
    <para id="para-00038">Your answer may vary, but here is a samples.</para>
    
    <para id="para-00039">From Step 5 to Step 6 - Subtract 35 from each side of the first equation.</para>
  
  </solution>
</exercise>
<!--Interaction End -->

<!-- END TEXT ENTRY WITH REVEAL -->
<!--Q#8-->
<exercise id="exer-00008">
  <problem id="prob-00008">
    <para id="para-00040">Explain why the systems are equivalent between the system in step 6 to the system in step 7.</para>
    </problem>
    <solution id="sol-00008">
  <para id="para-00041">Compare your answer: </para>
    
    <para id="para-00042">Your answer may vary, but here is a samples.</para>
    
    <para id="para-00043">From Step 6 to Step 7 - Divide each side of <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>40</m:mn></m:mrow></m:math> by 4 to solve for <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>.</para>
  </solution>
</exercise>
</section>
<!--Interaction End -->

<!-- END TEXT ENTRY WITH REVEAL -->

<!-- "Start "Are you Ready for More? click to reveal.  If you have more than one on a page, you will need to change the Data-fire/data-wait-for-events for each set.-->

<!--Start interaction.  If multiple interactions appear under "are you ready for more?, they should all have matching "data-wait-for-event", which should also match the "data-fire-event" for the button. Note in this sample, they are all RFM1-->
<section id="sect-00002">
  <title>Are you ready for more?</title>
  <section class="numbered-exercises" id="sect-00003"><title>Extending Your Thinking</title>
    <para id="para-00044">This system of equations has the solution <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mtext>-</m:mtext><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>: <m:math display="inline"><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mi>A</m:mi><m:mi>x</m:mi><m:mo>−</m:mo><m:mi>B</m:mi><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>24</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mi>B</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>A</m:mi><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>31</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></para>

<exercise class="RFM1" id="exer-00009">
  <problem id="prob-00009">
    <para id="para-00045">Find the missing value of <m:math display="inline"><m:mrow><m:mi>A</m:mi></m:mrow></m:math>.</para>
    </problem>
    <solution id="sol-00009">
  <para id="para-00046">Compare your answer: </para>
    
    <para id="para-00047"><m:math><m:mrow><m:mi>A</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para></solution>
</exercise>
<!--End interaction-->

<exercise class="RFM1" id="exer-00010">
  <problem id="prob-00010">
    <para id="para-00048">Find the missing value of <m:math display="inline"><m:mrow><m:mi>B</m:mi></m:mrow></m:math>.
    </para>
    </problem>
    <solution id="sol-00010">  
  <para id="para-00049">Compare your answer: </para>
    
    <para id="para-00050"><m:math><m:mrow><m:mi>B</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para></solution>
</exercise>
<!--End interaction-->

<!-- END ARE YOU READY FOR MORE-->
</section>
</section>


<section id="sect-00004">
  <note class="self-check" id="note-00001">
    <exercise id="exer-00012">
      <problem id="prob-00012">
      <para id="para-00051"><link class="os-embed" url="#exercise/Alg1_2_6_3_SC"/></para>
      </problem>
      </exercise>
  </note>
</section>

<section id="sect-00005">
  <title>Additional Resources</title>
  <section id="sect-00006">
    <title>Solving a System of Equations by Elimination Involving Fractions</title>
  <para id="para-00053">You just ordered the steps for solving a system of equations using elimination. Try
    using these steps when the system has equations containing fractions.</para>
  <para id="para-00054">When the system of equations contains fractions, we will first clear the fractions by
    multiplying each equation by the least common denominator (LCD) of all the
    fractions in the equation.</para>
  <para id="para-00055">Solve the system by elimination: <m:math display="inline"><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="center"><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
  
  <!--BEGIN STEPS-->
  <para id="para-00056"><emphasis>Step 1</emphasis> - Check to see if each equation is in standard form <m:math display="inline"><m:mrow><m:mi>A</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>B</m:mi><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>C</m:mi></m:mrow></m:math>.
    Both equations are in standard form.</para>
    <para id="para-00057"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math></para><para id="para-00059"><m:math display="inline"><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00058"><emphasis>Step 2</emphasis> - To clear the fractions, multiply each equation by its LCD (Least Common Denominator).</para>
   <para id="para-00061"><m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00063"><m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00060"><emphasis>Step 3</emphasis> - Simplify the equations.</para>
    <para id="para-00065"><m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>12</m:mn></m:mrow></m:math></para><para id="para-00067"><m:math display="inline"><m:mrow><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>51</m:mn></m:mrow></m:math></para><para id="para-00062"><emphasis>Step 4</emphasis> - Eliminate one of the variables and simplify the equation.</para>
    <para id="para-00071"><m:math><m:mrow><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>12</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>48</m:mn></m:mrow></m:math></para><para id="para-00064"><emphasis>Step 5</emphasis> - Add the two equations to eliminate <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>.</para>
    <!--BEGIN ALIGN TO EQUALS WITH LINE-->
    <para id="para-00074"><m:math display="inline"><m:mrow><m:mtable displaystyle="true" rowspacing="3pt" rowlines="none solid" columnspacing="0em 2em"><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>48</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>51</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>3</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--End ALIGN TO EQUALS WITH LINE-->	
  <para id="para-00066"><emphasis>Step 6</emphasis> - Solve for <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> by substituting <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> back into one of the equations.</para>
  <!--BEGIN ALIGN TO EQUALS -->
  <para id="para-00078"><m:math display="inline"><m:mrow><m:mtable displaystyle="true" rowspacing="3pt" columnspacing="0em 2em"><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>12</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>12</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>6</m:mn><m:mo>+</m:mo><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>12</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>6</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END ALIGN TO EQUALS -->		
  <para id="para-00068"><emphasis>Step 7</emphasis> - Write the solution as an ordered pair.</para>
  <para id="para-00069">The ordered pair is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>

  <para id="para-00070"><emphasis>Step 8</emphasis> - Check that the ordered pair is a solution to <emphasis>both</emphasis> original equations.</para>
   <!--BEGIN SIDE BY SIDE EQUATIONS-->
  <para id="para-00080"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"/><m:mtd columnalign="right"><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>y</m:mi><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mn>6</m:mn></m:mtd><m:mtd columnalign="right"><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mn>6</m:mn></m:mtd><m:mtd columnalign="right"><m:mfrac><m:mn>9</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>4</m:mn><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mn>6</m:mn></m:mtd><m:mtd columnalign="right"><m:mfrac><m:mn>9</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>8</m:mn><m:mn>2</m:mn></m:mfrac><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>6</m:mn><m:mi>✓</m:mi></m:mtd><m:mtd columnalign="right"><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mi>✓</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END SIDE BY SIDE EQUATIONS -->
   
   <para id="para-00072">The solution is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
  <!-- END STEPS -->

  <section id="sect-00007"><note class="try" id="note-00002">
  <title>Try It: Solving a System of Equations by Elimination Involving Fractions</title>

  <exercise id="exer-00011">
    <problem id="prob-00011">
      <para id="para-00073">Solve the following system of equations.</para>      
      <para id="para-00082"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mspace width="0.278em"/><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>1</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para><para id="para-00075"/>
    </problem>
    <solution id="sol-00011">
     <para id="para-00076">Compare your answer: </para>
    
    <para id="para-00077"><emphasis>Step 1</emphasis> - Check to see if each equation is in standard form <m:math display="inline"><m:mrow><m:mi>A</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>B</m:mi><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>C</m:mi></m:mrow></m:math>.
      Both equations are in standard form.</para>
      <para id="para-00084"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1</m:mn><m:mspace linebreak="newline"/><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>−</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para><para id="para-00079"><emphasis>Step 2</emphasis> - To clear the fractions, multiply each equation by its LCD (Least Common Denominator).</para>
       <para id="para-00086"><m:math><m:mrow><m:mrow><m:mn style="color:red">6</m:mn></m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mrow><m:mn style="color:red">6</m:mn></m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mspace linebreak="newline"/><m:mrow><m:mn style="color:red">4</m:mn></m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>−</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mrow><m:mn style="color:red">4</m:mn></m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00081"><emphasis>Step 3</emphasis> - Simplify the equations.</para>
      <para id="para-00088"><m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math></para><para id="para-00090"><m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math></para><para id="para-00083"><emphasis>Step 4</emphasis> - To get equivalent coefficients of <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>, we will need to multiply the first equation by 3 and the second equation by 2.</para>
     <para id="para-00094"><m:math display="inline"><m:mrow><m:mrow><m:mn style="color:red">3</m:mn></m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mi>–</m:mi><m:mn>3</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mrow><m:mn style="color:red">3</m:mn></m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00096"><m:math display="inline"><m:mrow><m:mrow><m:mn style="color:red">2</m:mn></m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mi>–</m:mi><m:mn>4</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mrow><m:mn style="color:red">2</m:mn></m:mrow><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00085"><emphasis>Step 5</emphasis> - Simplify.</para>
     <para id="para-00097"><m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mi>x</m:mi><m:mi>–</m:mi><m:mn>9</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>18</m:mn></m:mrow></m:math></para><para id="para-00098"><m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mi>x</m:mi><m:mi>–</m:mi><m:mn>8</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>20</m:mn></m:mrow></m:math></para><para id="para-00087"><emphasis>Step 6</emphasis> - Subtract the equations to eliminate one variable.</para>
      <!--BEGIN ALIGN TO EQUALS WITH LINE-->		
      <para id="para-00099"><m:math display="inline"><m:mrow><m:mtable displaystyle="true" rowspacing="3pt" rowlines="none solid none" columnspacing="0em 2em"><m:mtr><m:mtd columnalign="right"><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>9</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>18</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>8</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>20</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>2</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--BEGIN ALIGN TO EQUALS WITH LINE-->	
     <para id="para-00089"><emphasis>Step 7</emphasis> - Solve for <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> by substituting <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> back into one of the equations.</para>
      <!--BEGIN ALIGN TO EQUALS -->	
      <para id="para-00100"><m:math display="inline"><m:mrow><m:mtable displaystyle="true" rowspacing="3pt" columnspacing="0em 2em"><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>x</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>12</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>6</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END ALIGN TO EQUALS -->		
     <para id="para-00091"><emphasis>Step 8</emphasis> - Write the solution as an ordered pair.</para>
      <para id="para-00092">The ordered pair is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>

     <para id="para-00093"><emphasis>Step 9</emphasis> - Check that the ordered pair is a solution to <emphasis>both</emphasis> original equations.	</para>
        
        <!--BEGIN SIDE BY SIDE EQUATIONS-->
      
      <para id="para-00101"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"/><m:mtd columnalign="right"><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>−</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"/><m:mtd columnalign="right"><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mn>1</m:mn></m:mtd><m:mtd columnalign="right"><m:mfrac><m:mrow><m:mn>18</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mn>2</m:mn><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mn>6</m:mn></m:mtd><m:mtd columnalign="right"><m:mfrac><m:mrow><m:mn>18</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mfrac><m:mn>8</m:mn><m:mn>4</m:mn></m:mfrac><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mo>−</m:mo><m:mn>1</m:mn><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mn>1</m:mn></m:mtd><m:mtd columnalign="right"><m:mfrac><m:mn>9</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mover><m:mo>=</m:mo><m:mo>?</m:mo></m:mover><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>1</m:mn><m:mi>✓</m:mi></m:mtd><m:mtd columnalign="right"><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>✓</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><!--END SIDE BY SIDE EQUATIONS -->
    
    <para id="para-00095">The solution is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
  </solution>
</exercise>
</note></section>
  </section>
</section>
</content>
</document>