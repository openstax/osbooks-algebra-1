  <problem>
    <title>Extending Your Thinking</title>
    <para>This system of equations has the solution \( (5,\text-2) \): \( \begin {cases}Ax - By = 24\\ Bx + Ay = 31 \end{cases} \)</para>
    <para>Find the missing value of \( A \).</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\( A = 2 \)</para>
  </solution></exercise>
<!--End interaction-->

<exercise data-wait-for-event="RFM1">
  <problem>
    <para>Find the missing value of \( B \).
      </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\( B = 7 \)</para>
  </solution></exercise>
