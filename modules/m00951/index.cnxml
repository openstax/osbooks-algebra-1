  <content>
    <section id="sect-00001">
      <title>Cool Down Activity</title>
      <para id="para-00001">A squirrel runs up and down a tree.</para>
      <para id="para-00002">The graph shows the height of the squirrel, \(h\) (feet), as a function of time, \(t\) (seconds).</para>
      <para id="para-00003">
        <figure id="fig-00001">
          <media alt="Piecewise graph. Horizontal axis, 0 to 8, time, seconds. Vertical axis, 0 to 16, height, feet. Graph starts at 0 comma 9, increases, deceases to 4 comma 0, increases, then flattens out at 6 comma 10.">
            <image mime-type="image/svg+xml" src="../../media/Algebra-1_04_09_12_01.svg"/>
          </media>
        </figure>
      </para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00004">What is the highest point the squirrel reaches?</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00005">Enter your answer here:</para>
          <para id="para-00006">Compare your answer:</para>
          <para id="para-00007">14 feet</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00008">Solve \(h(t)=0\). What does this solution tell you about the squirrel?</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00009">Enter your answer here:</para>
          <para id="para-00010">Compare your answer:</para>
          <para id="para-00011">\(t=4\) means that after 4 seconds, the squirrel is at the bottom of the tree on the ground.
    </para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00012">Find the vertical intercept of the graph. What does it tell you about the squirrel?</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00013">Enter your answer here:</para>
          <para id="para-00014">Compare your answer:</para>
          <para id="para-00015">\((0,9)\) means that at the beginning, the squirrel is 9 feet high in the tree.
    </para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
