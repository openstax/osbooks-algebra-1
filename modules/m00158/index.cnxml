<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.6.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00158</md:content-id>
    <md:title>1.6.5: Practice</md:title>
    <md:uuid>f7073de3-e0cf-4327-a38e-256bc38ee098</md:uuid>
  </metadata>
  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="21edbea3-3cb2-402d-ac90-f3b8dbec36cc" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--Enter Questions Below this line-->
  <!--Q1-->
  <!--
   <div class="os-raise-ib-pset-problem" data-problem-type="multiselect" data-solution='[\\(15x-60=120\\)", "\\(3x=36\\)", "\\(x-4=8\\)"]' data-solution-options='["\\(15x-60=120\\)", "\\(3x=12\\)", "\\(3x=36\\)", "\\(x-4=8\\)", "\\(12x-12=24\\)"]'>-->
  <exercise data-content-id="75ab0de5-d0d8-464a-8fc5-06a2360884f3" data-problem-type="multiselect" data-solution="[&quot;\\(15x-60=120\\)&quot;, &quot;\\(3x=36\\)&quot;, &quot;\\(x-4=8\\)&quot;]" data-solution-options="[&quot;\\(15x-60=120\\)&quot;, &quot;\\(3x=12\\)&quot;, &quot;\\(3x=36\\)&quot;, &quot;\\(x-4=8\\)&quot;, &quot;\\(12x-12=24\\)&quot;]">
    <problem>
      <para>1. <emphasis>Select three</emphasis> the equations that have the same solution as the equation \(3x-12=24\).</para>
    </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.6.3.</para>
    </div>
    </exercise>
  <!--Q2-->
  <exercise data-content-id="dd027593-d07a-43ea-8d5e-67b8b5569b1e" data-problem-type="multiselect" data-solution="[&quot;\\(2x=20\\)&quot;, &quot;\\(2x-20=0\\)&quot;, &quot;\\(4x-10=30\\)&quot;]" data-solution-options="[&quot;\\(2x=10\\)&quot;, &quot;\\(2x=20\\)&quot;, &quot;\\(2(x-5)=15\\)&quot;, &quot;\\(2x-20=0\\)&quot;, &quot;\\(4x-10=30\\)&quot;, &quot;\\(15=5-2x\\)&quot;]">
    <problem>
      <para>2. <emphasis>Select three</emphasis> the equations that have the same solution as \(2x-5=15\).</para>
    </problem>
    <solution>
      <para>Correct! \(2x=20,\;2x-20=0,\;4x-10=30\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.6..</para>
    </div>
    </exercise>
  <!--Q3-->
  <exercise data-content-id="01ada8b9-a708-4ddb-b38d-50d129283b51" data-problem-type="multiselect" data-solution="[&quot;\\(1.4x - 4.2 =12.8\\)&quot;, &quot;\\(1.4x = 17\\)&quot;, &quot;\\(14x - 42 =128\\)&quot;, &quot;\\(14x =170\\)&quot; ]" data-solution-options="[&quot;\\(1.4x - 4.2 =12.8\\)&quot;, &quot;\\(1.4x = 8.6\\)&quot;, &quot;\\(1.4x = 17\\)&quot;, &quot;\\(14x - 42 =128\\)&quot;, &quot;\\(10x +4x -42=12.8\\)&quot;, &quot;\\(14x =170\\)&quot;]">
    <problem>
      <para>3. <emphasis>Select four </emphasis>of the equations that are equivalent to: \(x + 0.4x - 4.2 =12.8\).</para>
    </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.6.2.</para>
    </div>
    </exercise>
  <!--Q4-->
  <exercise data-content-id="0331b218-3e9b-45ec-ad25-e6d74a049ed7" data-problem-type="multiselect" data-solution="[&quot;\\(3(x-2) = 12\\)&quot;, &quot;\\(x - 2 =4\\)&quot;]" data-solution-options="[&quot;\\(3x = 6\\)&quot;, &quot;\\(3(x-2) = 12\\)&quot;, &quot;\\(x - 2 =4\\)&quot;,&quot;\\(x - 2 = 12\\)&quot;, &quot;\\(x -6 = 4\\)&quot;]">
    <problem>
      <para>4. <emphasis>Select two </emphasis>of the following that are equivalent to \(3x -6 =12.\)</para>
    </problem>
    <solution>
      <para>Correct! </para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.6.3.</para>
    </div>
    </exercise>
  <!--Q5-->
  <exercise data-content-id="56557040-0379-48a2-a762-f030812bac8f" data-problem-type="dropdown" data-retry-limit="2" data-solution="Step 1" data-solution-options="[&quot;Step 1&quot;, &quot;Step 2&quot;, &quot;Step 3&quot;]">
    <problem>
      <para>5. Identify which step the mistake is made in finding an equivalent equation to \(2(x - 4) = 16\).</para>
      <para>Step 1: \(2x -4 = 16\)
        Step 2: \(2x =20\)
        Step 3: \(x =10\)</para>
    </problem>
    <solution>
      <para>Correct! Step 1. Distribute the 2 to both terms in the parentheses.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.6.3.</para>
    </div>
    </exercise>
  <!--Q6-->
  <exercise data-content-id="75fd1f4b-6ad8-4568-93d1-a1ae87c3c273" data-problem-type="dropdown" data-retry-limit="2" data-solution="Step 2" data-solution-options="[&quot;Step 1&quot;, &quot;Step 2&quot;, &quot;Step 3&quot;]">
    <problem>
      <para>6. Identify which step the mistake is made in finding an equivalent equation to \(2x +3x -4 = 20\).</para>
      <para>Step 1: \(5x - 4 =20\)
        Step 2: \(5x = 16\)
        Step 3: \(x =16/5\)</para>
    </problem>
    <solution>
      <para>Correct! Step 2. The student should add 4 to both sides of the equation.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.6.3.</para>
    </div>
    </exercise>
  <!--Q7-->
  <exercise data-content-id="c8bf940b-6ba4-4176-aacb-57cb0c1e47c8" data-problem-type="dropdown" data-retry-limit="2" data-solution="Step 3" data-solution-options="[&quot;Step 1&quot;, &quot;Step 2&quot;, &quot;Step 3&quot;]">
    <problem>
      <para>7. Identify which step the mistake is made in finding an equivalent equation to \(7x - 4x - 5 =16\).</para>
      <para>Step \(1: 3x -5 =16\)
        Step 2: \(3x = 21\)
        Step 3: \(x =62\)</para>
    </problem>
    <solution>
      <para>Correct! Step 3. The student should divide both sides of the equation by 3.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.6.3.</para>
    </div>
    </exercise>
  <!--Q8-->
  <exercise data-content-id="e065c300-3340-4075-b263-af12b406a5d8" data-problem-comparator="integer" data-problem-type="input" data-solution="15">
    <problem>
      <para>8. Fill in the blank to complete the equivalent equation to 3(<emphasis>x</emphasis> - 5) = 30. </para>
      <para>\(3x\)- ____ =30</para>
    </problem>
    <solution>
      <para>Correct! 15. Distribute the 3 to the 5 with multiplication.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.6.3.</para>
    </div>
    </exercise>
  <!--Q9-->
  <exercise data-content-id="401ce19a-68a6-4497-9c4a-31beacefbf67" data-problem-comparator="integer" data-problem-type="input" data-solution="10">
    <problem>
      <para>9. Fill in the blank to complete the equivalent equation to \(\frac x2-5=11\). <emphasis> .</emphasis></para>
      <para>\(x\) - ______ = 22</para>
    </problem>
    <solution>
      <para>Correct! 10. Multiply each term in the equation by 2.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.6.3.</para>
    </div>
    </exercise>
  <!--Q10-->
  <exercise data-content-id="0df20ed8-b4a3-4125-85ba-698f73c3b8ee" data-problem-comparator="integer" data-problem-type="input" data-solution="9">
    <problem>
      <para>10. Fill in the blank to complete the equivalent equation to \( 3(x - 9) = 24\). <emphasis> .</emphasis></para>
      <para>\(x\) - ____ = 8</para>
    </problem>
    <solution>
      <para>Correct! 9. Divide both sides of the equation by 3.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.6.3.</para>
    </div>
    </exercise>
