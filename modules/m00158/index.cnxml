<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.6.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00158</md:content-id>
    <md:title>1.6.5: Practice</md:title>
    <md:uuid>68bfef7e-c272-4cad-a0d6-c43958927b06</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <exercise id="_75ab0de5-d0d8-464a-8fc5-06a2360884f3" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00002"><emphasis>Select three</emphasis> the equations that have the same solution as the equation <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>12</m:mn><m:mo>=</m:mo><m:mn>24</m:mn></m:mrow></m:math>.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Try again. Revisit activity 1.6.3.</para>
          <para id="para-00004">The correct answers are <m:math display="inline"><m:mrow><m:mn>15</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>60</m:mn><m:mo>=</m:mo><m:mn>120</m:mn><m:mo>,</m:mo><m:mspace width="0.278em"/><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>36</m:mn><m:mo>,</m:mo><m:mspace width="0.278em"/><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="dd027593-d07a-43ea-8d5e-67b8b5569b1e" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00005"><emphasis>Select three</emphasis> the equations that have the same solution as <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>=</m:mo><m:mn>15</m:mn></m:mrow></m:math>.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00006">Correct! <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>20</m:mn><m:mo>,</m:mo><m:mspace width="0.278em"/><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>20</m:mn><m:mo>=</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>10</m:mn><m:mo>=</m:mo><m:mn>30</m:mn></m:mrow></m:math></para>
          <para id="para-00007">Try again. Revisit activity 1.6..</para>
          <para id="para-00008">The correct answers are <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>20</m:mn><m:mo>,</m:mo><m:mspace width="0.278em"/><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>20</m:mn><m:mo>=</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>10</m:mn><m:mo>=</m:mo><m:mn>30</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_01ada8b9-a708-4ddb-b38d-50d129283b51" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00009"><emphasis>Select four</emphasis> of the equations that are equivalent to: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>0.4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4.2</m:mn><m:mo>=</m:mo><m:mn>12.8</m:mn></m:mrow></m:math>.</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00010">Try again. Revisit activity 1.6.2.</para>
          <para id="para-00011">The correct answers are <m:math display="inline"><m:mrow><m:mn>1.4</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>4.2</m:mn><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mn>12.8</m:mn><m:mo>,</m:mo><m:mspace width="0.278em"/><m:mn>1.4</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>17</m:mn><m:mo>,</m:mo><m:mspace width="0.278em"/><m:mn>14</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>42</m:mn><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mn>128</m:mn><m:mo>,</m:mo><m:mspace width="0.278em"/><m:mn>14</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mn>170</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_0331b218-3e9b-45ec-ad25-e6d74a049ed7" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00012"><emphasis>Select two</emphasis> of the following that are equivalent to <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>12</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00013">Try again. Revisit activity 1.6.3.</para>
          <para id="para-00014">The correct answers are <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>12</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_56557040-0379-48a2-a762-f030812bac8f" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00015">Identify which step the mistake is made in finding an equivalent equation to <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>16</m:mn></m:mrow></m:math>.</para>
          <para id="para-00016">Step 1: <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>16</m:mn></m:mrow></m:math> Step 2: <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>20</m:mn></m:mrow></m:math> Step 3: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00017">Correct! Step 1. Distribute the 2 to both terms in the parentheses.</para>
          <para id="para-00018">Try again. Revisit activity 1.6.3.</para>
          <para id="para-00019">The correct answer is Step 1 has the mistake.The 2 should be distributed to BOTH terms in the parenthesis.</para>
        </solution>
      </exercise>
      <exercise id="_75fd1f4b-6ad8-4568-93d1-a1ae87c3c273" class="multiple-choice">
        <problem id="prob-00006">
          <para id="para-00020">Identify which step the mistake is made in finding an equivalent equation to <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>20</m:mn></m:mrow></m:math>.</para>
          <para id="para-00021">Step 1: <m:math display="inline"><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>20</m:mn></m:mrow></m:math> Step 2: <m:math display="inline"><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>16</m:mn></m:mrow></m:math> Step 3: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>16</m:mn><m:mo>/</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00022">Correct! Step 2. The student should add 4 to both sides of the equation.</para>
          <para id="para-00023">Try again. Revisit activity 1.6.3.</para>
          <para id="para-00024">The correct answer is Step 2 has the mistake, The 4 should be ADDED to both sides of the equation.</para>
        </solution>
      </exercise>
      <exercise id="c8bf940b-6ba4-4176-aacb-57cb0c1e47c8" class="multiple-choice">
        <problem id="prob-00007">
          <para id="para-00025">Identify which step the mistake is made in finding an equivalent equation to <m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>=</m:mo><m:mn>16</m:mn></m:mrow></m:math>.</para>
          <para id="para-00026">Step <m:math display="inline"><m:mrow><m:mn>1</m:mn><m:mi>:</m:mi><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>=</m:mo><m:mn>16</m:mn></m:mrow></m:math> Step 2: <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>21</m:mn></m:mrow></m:math> Step 3: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>62</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00027">Correct! Step 3. The student should divide both sides of the equation by 3.</para>
          <para id="para-00028">Try again. Revisit activity 1.6.3.</para>
          <para id="para-00029">The correct answer is Step 3 has the mistake. The 3 should be DIVIDED on both sides of the equation.</para>
        </solution>
      </exercise>
      <exercise id="e065c300-3340-4075-b263-af12b406a5d8" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00030">Fill in the blank to complete the equivalent equation to 3(x - 5) = 30.</para>
          <para id="para-00031"><m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math>- ____ =30</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00032">Correct! 15. Distribute the 3 to the 5 with multiplication.</para>
          <para id="para-00033">Try again. Revisit activity 1.6.3.</para>
          <para id="para-00034">The correct answer is 15. Distribute the 3 to the 5 with multiplication.</para>
        </solution>
      </exercise>
      <exercise id="_401ce19a-68a6-4497-9c4a-31beacefbf67" class="multiple-choice">
        <problem id="prob-00009">
          <para id="para-00035">Fill in the blank to complete the equivalent equation to <m:math display="inline"><m:mrow><m:mfrac><m:mi>x</m:mi><m:mn>2</m:mn></m:mfrac><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>=</m:mo><m:mn>11</m:mn></m:mrow></m:math>. .</para>
          <para id="para-00036"><m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> - ______ = 22</para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00037">Correct! 10. Multiply each term in the equation by 2.</para>
          <para id="para-00038">Try again. Revisit activity 1.6.3.</para>
          <para id="para-00039">Correct! 10. Multiply each term in the equation by 2.</para>
        </solution>
      </exercise>
      <exercise id="_0df20ed8-b4a3-4125-85ba-698f73c3b8ee" class="multiple-choice">
        <problem id="prob-00010">
          <para id="para-00040">Fill in the blank to complete the equivalent equation to <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>24</m:mn></m:mrow></m:math>. .</para>
          <para id="para-00041"><m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> - ____ = 8</para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00042">Correct! 9. Divide both sides of the equation by 3.</para>
          <para id="para-00043">Try again. Revisit activity 1.6.3.</para>
          <para id="para-00044">The correct answer is 9.</para>
        </solution>
      </exercise>
    </section>
  </content>
</document>
