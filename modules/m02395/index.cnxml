  <content>
  <section><title>Cool Down Activity</title>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="4c802518-9b18-49a2-a4ad-f5ca991961e3" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1a-->
  <exercise data-content-id="40d670be-9621-4051-b6fe-46dc38a51273" data-problem-comparator="integer" data-problem-type="input" data-solution="49">
    <problem>
      <para>Answer the following questions for expression \(4x^2−28x+c\).</para>
      <para>Find the value of \(c\) to make the expression a perfect square.</para>
      <para>Enter the value of \(c\). </para>
    </problem>
    <solution>
      <para>Correct! 49. Standard form: \(4x^2−28x+49\).</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
