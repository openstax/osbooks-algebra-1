<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.4.5: Perfect Square and Squared Factors</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02395</md:content-id>
    <md:title>9.4.5: Perfect Square and Squared Factors</md:title>
    <md:uuid>31f90e7b-32d1-4626-a1db-aaf001591f7f</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001"><title>Cool Down</title>
      <exercise id="_40d670be-9621-4051-b6fe-46dc38a51273" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00002">1. Answer the following questions for expression <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>28</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi></m:mrow></m:math>.</para>
          <para id="para-00003">a. Find the value of <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math> to make the expression a perfect square.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00005">49. Standard form: <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>28</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>49</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
    </section>
    <exercise id="exer-00001">
      <problem id="prob-00002">
        <para id="para-00006">b. Write an equivalent expression in the form of squared factors.</para>
        <para id="para-00007"></para>
      </problem>
      <solution id="sol-00002">
        <para id="para-00008">Compare your answer: </para>
        <para id="para-00009">Squared factors: <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>7</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para>
      </solution>
    </exercise>
    <exercise id="exer-00002">
      <problem id="prob-00003">
        <para id="para-00010">2. Solve the equation <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>28</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>33</m:mn></m:mrow></m:math> by completing the square. Show your reasoning.</para>
        <para id="para-00011"></para>
      </problem>
      <solution id="sol-00003">
        <para id="para-00012">Compare your answer: </para>
        <para id="para-00013"><m:math><m:mrow><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mrow><m:mn>2</m:mn></m:mrow></m:msup><m:mo>−</m:mo><m:mn>28</m:mn><m:mi>x</m:mi><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>33</m:mn><m:mspace linebreak="newline"/><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mrow><m:mn>2</m:mn></m:mrow></m:msup><m:mo>−</m:mo><m:mn>28</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>49</m:mn><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>33</m:mn><m:mo>+</m:mo><m:mn>49</m:mn><m:mspace linebreak="newline"/><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>7</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mn>2</m:mn></m:mrow></m:msup><m:mi/><m:mo>=</m:mo><m:mn>16</m:mn><m:mspace linebreak="newline"/><m:msqrt><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>7</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mn>2</m:mn></m:mrow></m:msup></m:mrow></m:msqrt><m:mi/><m:mo>=</m:mo><m:msqrt><m:mrow><m:mn>16</m:mn></m:mrow></m:msqrt><m:mspace linebreak="newline"/><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>7</m:mn><m:mi/><m:mo>=</m:mo><m:mn>4</m:mn><m:mspace linebreak="newline"/><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>7</m:mn><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mspace linebreak="newline"/><m:mn>2</m:mn><m:mi>x</m:mi><m:mi/><m:mo>=</m:mo><m:mn>11</m:mn><m:mspace linebreak="newline"/><m:mn>2</m:mn><m:mi>x</m:mi><m:mi/><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:mrow></m:math></para><para id="para-00014"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mtext> and </m:mtext><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para></solution>
    </exercise>
  </content>
</document>