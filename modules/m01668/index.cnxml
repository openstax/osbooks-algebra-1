<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Choosing Your Own Method to Factor Trinomials</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01668</md:content-id>
    <md:title>Choosing Your Own Method to Factor Trinomials</md:title>
    <md:uuid>1b8c0d6f-713f-4fb9-973e-4f378b49d43c</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
<para id="para-00001">Work with a partner. For each trinomial, explain which method you would use to factor. When you have discussed your reasoning, factor the trinomial and compare solutions.</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>14</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>32</m:mn></m:mrow></m:math></para></problem><solution id="sol-00001">
    
    
  
  <para id="para-00003">Compare your answer: </para>
    
    <para id="para-00004">trial and error; for example, <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>16</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00005"><m:math><m:mrow><m:mn>6</m:mn><m:msup><m:mi>r</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>30</m:mn><m:mi>r</m:mi><m:mo>+</m:mo><m:mn>36</m:mn></m:mrow></m:math></para></problem><solution id="sol-00002">
    
    
  
  <para id="para-00006">Compare your answer: </para>
    
    <para id="para-00007">the “<m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mi>c</m:mi></m:mrow></m:math>” method; for example, <m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mo stretchy="false">(</m:mo><m:mi>r</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>r</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00008"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>9</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mi>−</m:mi><m:mn>36</m:mn></m:mrow></m:math></para></problem><solution id="sol-00003">
    
    
  
  <para id="para-00009">Compare your answer: </para>
    
    <para id="para-00010">substitution; for example, <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
  
  </solution></exercise>
<!--Interaction End --></section>
</content>
</document>