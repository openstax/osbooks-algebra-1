<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.5.5: Choosing Your Own Method to Factor Trinomials</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01668</md:content-id>
    <md:title>6.5.5: Choosing Your Own Method to Factor Trinomials</md:title>
    <md:uuid>1b8c0d6f-713f-4fb9-973e-4f378b49d43c</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Cool Down Activity</title>
<para id="para-00001">Work with a partner. For each trinomial, explain which method you would use to factor. When you have discussed your reasoning, factor the trinomial and compare solutions.</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002">\(
        x^2 − 14x − 32\)</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00003">Compare your answer:</para>
    
    <para id="para-00004">trial and error; for example, \((x − 16)(x + 2)\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00005">\(6r^2 + 30r + 36\)</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00006">Compare your answer:</para>
    
    <para id="para-00007">the “\(ac\)” method; for example, \(6(r + 3)(r + 2)\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00008">\((x + 3)^2 − 9(x + 3) − 36\)</para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00009">Compare your answer:</para>
    
    <para id="para-00010">substitution; for example, \((x − 9)(x + 6)\)</para>
  
  </solution></exercise>
<!--Interaction End --></section>
</content>
