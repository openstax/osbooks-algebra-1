<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.7.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01705</md:content-id>
    <md:title>6.7.5: Practice</md:title>
    <md:uuid>bff05d66-5916-4bd0-9aba-c86ec8b48a23</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.  </para>
<para id="para-00002">For questions 1 - 10, factor each of the expressions completely.</para>
<section id="sect-00002">
  <exercise id="_715ac5a8-aefe-4d4b-9b17-f9c908eca5a1" class="multiple-choice"><problem id="prob-00001"><para id="para-00003">\(36x^2y + 15xy − 6y\)</para>
      <para id="para-00004">Multiple Choice:</para><para id="para-00005">\(3y(3x − 2)(4x + 1)\)</para><para id="para-00006">\(3y(3x − 2)(4x − 1)\)</para><para id="para-00007">\((3x + 2)(4x − 1)\)</para><para id="para-00008">\(3y(3x + 2)(4x − 1)\)</para></problem><solution id="sol-00001"><para id="para-00009">Try again. Revisit 6.7.2 and 6.7.3.</para><para id="para-00010">The correct answer is \(3y(3x + 2)(4x − 1)\).
    </para></solution></exercise>
      
      <exercise id="_608ee0d5-33c6-4fd4-9df1-7090dd016177" class="multiple-choice"><problem id="prob-00002"><para id="para-00011">\(49b^2 - 36a^2\)</para>
      <para id="para-00012">Multiple Choice:</para><para id="para-00013">\((6b − 7a)(6b + 7a)\)</para><para id="para-00014">\((7b − 6a)^2\)</para><para id="para-00015">\((7b − 6a)(7b + 6a)\)</para><para id="para-00016">\((7b + 6a)^2\)</para></problem><solution id="sol-00002"><para id="para-00017">Try again. Revisit 6.7.2 and 6.7.3.</para><para id="para-00018">The correct answer is \((7b − 6a)(7b + 6a)\).</para></solution></exercise>
      
      <exercise id="eacafd78-8888-42c1-9b94-bb4fe6036c00" class="multiple-choice"><problem id="prob-00003"><para id="para-00019">\(49b^2 − 112b + 64\)</para>
      <para id="para-00020">Multiple Choice:</para><para id="para-00021">\((7b + 8)(7b − 8)\)</para><para id="para-00022">\((7b + 8)^2\)</para><para id="para-00023">\((8b + 7)(8b − 7)\)</para><para id="para-00024">\((7b − 8)^2\)</para></problem><solution id="sol-00003"><para id="para-00025">Try again. Revisit 6.7.2 and 6.7.3.
    </para><para id="para-00026">The correct answer is \((7b − 8)^2\).</para></solution></exercise>
     <exercise id="_9f6b740e-7bac-4227-ad9b-22ac1236fea8" class="multiple-choice"><problem id="prob-00004"><para id="para-00027">\(7b^2 + 7b − 42\)</para>
      <para id="para-00028">Multiple Choice:</para><para id="para-00029">\(7(b + 3)(b − 2)\)</para><para id="para-00030">\(7(b − 3)(b − 2)\)</para><para id="para-00031">\(7(b − 3)(b + 2)\)</para><para id="para-00032">\(7(b + 3)(b + 2)\)</para></problem><solution id="sol-00004"><para id="para-00033">Try again. Revisit 6.7.2 and 6.7.3.
    </para><para id="para-00034">The correct answer is \(7(b + 3)(b − 2)\).
    </para></solution></exercise>
      
      <exercise id="eda1f0c4-66f7-483c-ac33-a1e93c6abca1" class="multiple-choice"><problem id="prob-00005"><para id="para-00035">\(15pq − 15p + 12q − 12\)</para>
      <para id="para-00036">Multiple Choice:</para><para id="para-00037">\(3(5p + 4)(q − 1)\)</para><para id="para-00038">\(3(5p + 4)(q + 1)\)</para><para id="para-00039">\(3(4p + 5)(q − 1)\)</para><para id="para-00040">\(3(5p − 4)(q − 1)\)</para></problem><solution id="sol-00005"><para id="para-00041">Try again. Revisit 6.7.2 and 6.7.3.</para><para id="para-00042">The correct answer is \(3(5p + 4)(q − 1)\).

    </para></solution></exercise>
      
      <exercise id="fa8f8479-19dd-48bf-b7aa-bcb7370368a4" class="multiple-choice"><problem id="prob-00006"><para id="para-00043">\(4x^2 + 40x + 84\)</para>
      <para id="para-00044">Multiple Choice:</para><para id="para-00045">\( 4(x + 3)(x − 7)\)</para><para id="para-00046">\((4x + 3)(x + 7)\)</para><para id="para-00047">\(4(x − 3)(x − 7)\)</para><para id="para-00048">\(4(x + 3)(x + 7)\)</para></problem><solution id="sol-00006"><para id="para-00049">Try again. Revisit 6.7.2 and 6.7.3.
    </para><para id="para-00050">The correct answer is \(4(x + 3)(x + 7)\).
    </para></solution></exercise>
      
      <exercise id="_72c5aa4b-1018-4cb7-bc6d-adee911e43d4" class="multiple-choice"><problem id="prob-00007"><para id="para-00051">\(m^2 + 14mn + 49n^2\)</para>
      <para id="para-00052">Multiple Choice:</para><para id="para-00053">\((7m + n)^2\)</para><para id="para-00054">\((m + 7n)^2\)</para><para id="para-00055">\((m + 7n)(m − 7n)\)</para><para id="para-00056">\((7m + n)(7m − n)\)</para></problem><solution id="sol-00007"><para id="para-00057">Try again. Revisit 6.7.2 and 6.7.3.
    </para><para id="para-00058">The correct answer is \((m + 7n)^2\).</para></solution></exercise>
      
      <exercise id="_46a8e2b8-1559-4e0c-b357-b697b6a25504" class="multiple-choice"><problem id="prob-00008"><para id="para-00059">\((4x − 5)^2 − 7(4x − 5) + 12\)</para>
      <para id="para-00060">Multiple Choice:</para><para id="para-00061">\((4x − 4)(4x − 3)\)</para><para id="para-00062">\((x − 4)(x − 3)\)</para><para id="para-00063">\((4x − 9)(4x − 8)\)</para><para id="para-00064">\((4x − 4)(4x + 3)\)</para></problem><solution id="sol-00008"><para id="para-00065">Try again. Revisit 6.7.2 and 6.7.3.</para><para id="para-00066">The correct answer is \((4x − 9)(4x − 8)\).</para></solution></exercise>
      
      <exercise id="a8beca4d-27ea-40cb-a8ff-8d9516af4b0a" class="multiple-choice"><problem id="prob-00009"><para id="para-00067">\(8m^2 − 32\)</para>
      <para id="para-00068">Multiple Choice:</para><para id="para-00069">\(4(2m − 2)(2m + 2)\)</para><para id="para-00070">\(8(m + 2)^2\)</para><para id="para-00071">\(8(m − 2)^2\)</para><para id="para-00072">\(8(m − 2)(m + 2)\)</para></problem><solution id="sol-00009"><para id="para-00073">Try again. Revisit 6.7.2 and 6.7.3.
    </para><para id="para-00074">The correct answer is \(8(m − 2)(m + 2)\).
    </para></solution></exercise>
      
      <exercise id="_2af68609-449f-4dda-829f-161c7fb5ffb2" class="multiple-choice"><problem id="prob-00010"><para id="para-00075">\(9x^2 − 6xy + y^2 − 49\)</para>
      <para id="para-00076">Multiple Choice:</para><para id="para-00077">\((3x − y + 7)^2\)</para><para id="para-00078">\((3x − y + 7)(3x − y − 7)\)</para><para id="para-00079">\((3x − y − 7)^2\)</para><para id="para-00080">\((x − 3y + 7)(x − 3y − 7)\)</para></problem><solution id="sol-00010"><para id="para-00081">Try again. Revisit 6.7.2 and 6.7.3.
    </para><para id="para-00082">The correct answer is \((3x − y + 7)(3x − y − 7)\).
    </para></solution></exercise></section></section>
</content>
