<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.7.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01705</md:content-id>
    <md:title>6.7.5: Practice</md:title>
    <md:uuid>62727d59-abed-4e2c-8c17-337c264ae211</md:uuid>
  </metadata>
  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.    </para>
<para>For questions 1 - 10, factor each of the expressions completely.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="635c3714-869e-43fa-b1ae-ed74fd6f8803" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--q1-->
  <exercise data-content-id="715ac5a8-aefe-4d4b-9b17-f9c908eca5a1" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(3y(3x + 2)(4x − 1)\)" data-solution-options="[&quot;\\(3y(3x − 2)(4x + 1)\\)&quot;, &quot;\\(3y(3x − 2)(4x − 1)\\)&quot;, &quot;\\((3x + 2)(4x − 1)\\)&quot;, &quot;\\(3y(3x + 2)(4x − 1)\\)&quot;]">
    <problem>
      <para>\(36x^2y + 15xy − 6y\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.7.2 and 6.7.3.</para>
    </div>
    </exercise>
  <!--q2-->
  <exercise data-content-id="608ee0d5-33c6-4fd4-9df1-7090dd016177" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((7b − 6a)(7b + 6a)\)" data-solution-options="[&quot;\\((6b − 7a)(6b + 7a)\\)&quot;, &quot;\\((7b − 6a)^2\\)&quot;, &quot;\\((7b − 6a)(7b + 6a)\\)&quot;, &quot;\\((7b + 6a)^2\\)&quot;]">
    <problem>
      <para>\(49b^2 - 36a^2\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.7.2 and 6.7.3.</para>
    </div>
    </exercise>
  <!--q3-->
  <exercise data-content-id="eacafd78-8888-42c1-9b94-bb4fe6036c00" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((7b − 8)^2\)" data-solution-options="[&quot;\\((7b + 8)(7b − 8)\\)&quot;, &quot;\\((7b + 8)^2\\)&quot;, &quot;\\((8b + 7)(8b − 7)\\)&quot;, &quot;\\((7b − 8)^2\\)&quot;]">
    <problem>
      <para>\(49b^2 − 112b + 64\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.7.2 and 6.7.3.
      </para>
    </div>
    </exercise>
  <!--q4-->
  <exercise data-content-id="9f6b740e-7bac-4227-ad9b-22ac1236fea8" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(7(b + 3)(b − 2)\)" data-solution-options="[&quot;\\(7(b + 3)(b − 2)\\)&quot;, &quot;\\(7(b − 3)(b − 2)\\)&quot;, &quot;\\(7(b − 3)(b + 2)\\)&quot;, &quot;\\(7(b + 3)(b + 2)\\)&quot;]">
    <problem>
      <para>\(7b^2 + 7b − 42\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.7.2 and 6.7.3.
      </para>
    </div>
    </exercise>
  <!--q5-->
  <exercise data-content-id="eda1f0c4-66f7-483c-ac33-a1e93c6abca1" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(3(5p + 4)(q − 1)\)" data-solution-options="[&quot;\\(3(5p + 4)(q − 1)\\)&quot;, &quot;\\(3(5p + 4)(q + 1)\\)&quot;, &quot;\\(3(4p + 5)(q − 1)\\)&quot;, &quot;\\(3(5p − 4)(q − 1)\\)&quot;]">
    <problem>
      <para>\(15pq − 15p + 12q − 12\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.7.2 and 6.7.3.</para>
    </div>
    </exercise>
  <!--q6-->
  <exercise data-content-id="fa8f8479-19dd-48bf-b7aa-bcb7370368a4" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(4(x + 3)(x + 7)\)" data-solution-options="[&quot;\\( 4(x + 3)(x − 7)\\)&quot;, &quot;\\((4x + 3)(x + 7)\\)&quot;, &quot;\\(4(x − 3)(x − 7)\\)&quot;, &quot;\\(4(x + 3)(x + 7)\\)&quot;]">
    <problem>
      <para>\(4x^2 + 40x + 84\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.7.2 and 6.7.3.
      </para>
    </div>
    </exercise>
  <!--q7-->
  <exercise data-content-id="72c5aa4b-1018-4cb7-bc6d-adee911e43d4" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((m + 7n)^2\)" data-solution-options="[&quot;\\((7m + n)^2\\)&quot;, &quot;\\((m + 7n)^2\\)&quot;, &quot;\\((m + 7n)(m − 7n)\\)&quot;, &quot;\\((7m + n)(7m − n)\\)&quot;]">
    <problem>
      <para>\(m^2 + 14mn + 49n^2\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.7.2 and 6.7.3.
      </para>
    </div>
    </exercise>
  <!--q8-->
  <exercise data-content-id="46a8e2b8-1559-4e0c-b357-b697b6a25504" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((4x − 9)(4x − 8)\)" data-solution-options="[&quot;\\((4x − 4)(4x − 3)\\)&quot;, &quot;\\((x − 4)(x − 3)\\)&quot;, &quot;\\((4x − 9)(4x − 8)\\)&quot;, &quot;\\((4x − 4)(4x + 3)\\)&quot;]">
    <problem>
      <para>\((4x − 5)^2 − 7(4x − 5) + 12\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.7.2 and 6.7.3.</para>
    </div>
    </exercise>
  <!--q9-->
  <exercise data-content-id="a8beca4d-27ea-40cb-a8ff-8d9516af4b0a" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(8(m − 2)(m + 2)\)" data-solution-options="[&quot;\\(4(2m − 2)(2m + 2)\\)&quot;, &quot;\\(8(m + 2)^2\\)&quot;, &quot;\\(8(m − 2)^2\\)&quot;, &quot;\\(8(m − 2)(m + 2)\\)&quot;]">
    <problem>
      <para> \(8m^2 − 32\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.7.2 and 6.7.3.
      </para>
    </div>
    </exercise>
  <!--q10-->
  <exercise data-content-id="2af68609-449f-4dda-829f-161c7fb5ffb2" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((3x − y + 7)(3x − y − 7)\)" data-solution-options="[&quot;\\((3x − y + 7)^2\\)&quot;, &quot;\\((3x − y + 7)(3x − y − 7)\\)&quot;, &quot;\\((3x − y − 7)^2\\)&quot;, &quot;\\((x − 3y + 7)(x − 3y − 7)\\) &quot;]">
    <problem>
      <para>\(9x^2 − 6xy + y^2 − 49\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.7.2 and 6.7.3.
      </para>
    </div>
    </exercise>
  <!--Do not edit below this line-->
  <solution> </solution>
  <div class="os-raise-ib-pset-encourage-response"> </div>
</div></section>
