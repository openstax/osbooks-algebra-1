<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>7.15.4: The Graph of a Function in Vertex Form</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02015</md:content-id>
    <md:title>7.15.4: The Graph of a Function in Vertex Form</md:title>
    <md:uuid>1f7911a0-2353-4113-a7da-05a1547b8015</md:uuid>
  </metadata>
  <content>
  <section><title>Cool Down (5 minutes)</title>
<title>Launch</title>
<para>Since this activity was designed to be completed without technology, ask students to put away any devices.</para>
<title>Student Activity</title>
<para>Answer questions 1 – 3 about the function \(f\), given by \(f(x)=(x+3)^2−1\).</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="0dc34c6c-421e-419a-a201-3220b07cd2fb" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1-->
  <exercise data-content-id="fdeab50c-b8e2-4440-b2c6-db723a810af4" data-problem-comparator="float" data-problem-type="input" data-solution="-3">
    <problem>
      <para>What is the \(x\)-coordinate of the vertex of the graph of \(f\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! -3</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q2-->
  <exercise data-content-id="7e781736-842e-456a-bb60-65431c204ede" data-problem-comparator="float" data-problem-type="input" data-solution="-1">
    <problem>
      <para>What is the \(y\)-coordinate of the vertex of the graph of \(f\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! -3</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q3-->
  <exercise data-content-id="9b46c74b-35c7-4669-a791-76fa42b078a3" data-problem-type="dropdown" data-solution="Up" data-solution-options="[&quot;Up&quot;, &quot;Down&quot;]">
    <problem>
      <para>Does the graph open up or down?</para>
      </problem>
    <solution>
      <para>Correct! The graph opens upward. The squared term has a positive coefficient \((1)\).</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
