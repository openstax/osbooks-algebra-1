    <section id="sect-00006">
      <title>Additional Resources</title>
      <section id="sect-00007">
        <title>Video: Using Standard Form</title>
        <para id="para-00080">Watch the following video to learn more about using standard form to
          find slope and <m:math display="inline">
            <m:mrow>
              <m:mi>y</m:mi>
            </m:mrow>
          </m:math>-intercepts.</para>
        <media alt="Placeholder for Alt Text">
          <iframe width="660" height="371.4" src="https://openstax.org/r/standard-form"/>
        </media>
        <section class="numbered-exercises" id="sect-00002">
          <note class="try" id="note-00002">
            <title>Using Standard Form</title>
          <exercise id="_0f1de370-c230-4ff2-aaad-89d86d1320f2" class="multiple-choice">
              <problem id="prob-00014">
                <para id="para-00081">Find the slope for <m:math display="inline">
                    <m:mrow>
                      <m:mn>5</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>−</m:mo>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>15</m:mn>
                    </m:mrow>
                  </m:math>.</para>
              </problem>
              <solution id="sol-00014">
                <para id="para-00082">5</para>
              </solution>
            </exercise>
          <exercise id="_03b195b3-dccf-4316-b25e-ef90e22b0d8e" class="multiple-choice">
              <problem id="prob-00015">
                <para id="para-00084">Find the <m:math display="inline">
                    <m:mrow>
                      <m:mi>y</m:mi>
                    </m:mrow>
                  </m:math>-intercept
            for <m:math display="inline">
                    <m:mrow>
                      <m:mn>5</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>−</m:mo>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>15</m:mn>
                    </m:mrow>
                  </m:math>.</para>
              </problem>
              <solution id="sol-00015">
                <para id="para-00085">-15</para>
              </solution>
            </exercise><!--Q#3-->
          <exercise id="exer-00005">
              <problem id="prob-00016">
                <para id="para-00087">Explain your reasoning.</para>
              </problem>
              <solution id="sol-00016">
                <para id="para-00088">Compare your answer: </para>
                <para id="para-00089"><emphasis>Strategy 1: Solve for <m:math display="inline">
                      <m:mrow>
                        <m:mi>y</m:mi>
                      </m:mrow>
                    </m:math>.</emphasis></para>
                <para id="para-00090"><emphasis>Step 1</emphasis> - Subtract the <m:math display="inline">
                    <m:mrow>
                      <m:mi>x</m:mi>
                    </m:mrow>
                  </m:math> term
            from both sides.</para>
            <para id="para-00010">Subtract <m:math display="inline">
                    <m:mrow>
                      <m:mn>5</m:mn>
                    </m:mrow>
                  </m:math> from
            both sides.</para><para id="para-00019"><m:math display="inline">
                    <m:mrow>
                      <m:mn>5</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>−</m:mo>
                      <m:mn>5</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>−</m:mo>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>15</m:mn>
                      <m:mo>−</m:mo>
                      <m:mn>5</m:mn>
                      <m:mi>x</m:mi>
                    </m:mrow>
                  </m:math></para>
                <para id="para-00091"><emphasis>Step 2</emphasis> - Simplify.</para><para id="para-00028"><m:math display="inline">
                    <m:mrow>
                      <m:mo>−</m:mo>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>15</m:mn>
                      <m:mo>−</m:mo>
                      <m:mn>5</m:mn>
                      <m:mi>x</m:mi>
                    </m:mrow>
                  </m:math></para>
                <para id="para-00092"><emphasis>Step 3</emphasis> - Divide both sides by the
            coefficient of <m:math display="inline">
                    <m:mrow>
                      <m:mi>y</m:mi>
                    </m:mrow>
                  </m:math>.</para><para id="para-00037">Divide
            both sides by <m:math display="inline">
                    <m:mrow>
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                    </m:mrow>
                  </m:math>.</para><para id="para-00046"><m:math display="inline">
                    <m:mrow>
                      <m:mfrac>
                        <m:mrow>
                          <m:mo>−</m:mo>
                          <m:mi>y</m:mi>
                        </m:mrow>
                        <m:mrow>
                          <m:mo>−</m:mo>
                          <m:mn>1</m:mn>
                        </m:mrow>
                      </m:mfrac>
                      <m:mo>=</m:mo>
                      <m:mfrac>
                        <m:mrow>
                          <m:mn>15</m:mn>
                          <m:mtext> </m:mtext>
                          <m:mo>−</m:mo>
                          <m:mn>5</m:mn>
                          <m:mi>x</m:mi>
                        </m:mrow>
                        <m:mrow>
                          <m:mo>−</m:mo>
                          <m:mn>1</m:mn>
                        </m:mrow>
                      </m:mfrac>
                    </m:mrow>
                  </m:math></para>
                <para id="para-00093"><emphasis>Step 4</emphasis> - Simplify.</para><para id="para-00049"><m:math display="inline">
                    <m:mrow>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>5</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>−</m:mo>
                      <m:mn>15</m:mn>
                    </m:mrow>
                  </m:math></para><para id="para-00052">The
            slope is the coefficient of <m:math display="inline">
                    <m:mrow>
                      <m:mi>x</m:mi>
                    </m:mrow>
                  </m:math>, so the
            slope is 5. The <m:math display="inline">
                    <m:mrow>
                      <m:mi>y</m:mi>
                    </m:mrow>
                  </m:math>-intercept
            is the constant, which is −15.</para>
            
            <para id="para-00055"><emphasis>Strategy 2: Use standard form.</emphasis>
                </para>
                <para id="para-00094"><emphasis>Step 1</emphasis> - Identify A, B, and C.</para><para id="para-00058">In <m:math display="inline">
                    <m:mrow>
                      <m:mn>5</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>−</m:mo>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>15</m:mn>
                    </m:mrow>
                  </m:math>, <m:math display="inline">
                    <m:mrow>
                      <m:mi>A</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>5</m:mn>
                    </m:mrow>
                  </m:math>, <m:math display="inline">
                    <m:mrow>
                      <m:mi>B</m:mi>
                      <m:mo>=</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                    </m:mrow>
                  </m:math>, <m:math display="inline">
                    <m:mrow>
                      <m:mi>C</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>15</m:mn>
                    </m:mrow>
                  </m:math>.</para><para id="para-00061">
            Slope: <m:math display="inline">
                    <m:mrow>
                      <m:mo>−</m:mo>
                      <m:mfrac>
                        <m:mrow>
                          <m:mi>A</m:mi>
                        </m:mrow>
                        <m:mrow>
                          <m:mi>B</m:mi>
                        </m:mrow>
                      </m:mfrac>
                      <m:mo>=</m:mo>
                      <m:mo>−</m:mo>
                      <m:mfrac>
                        <m:mrow>
                          <m:mn>5</m:mn>
                        </m:mrow>
                        <m:mrow>
                          <m:mo>−</m:mo>
                          <m:mn>1</m:mn>
                        </m:mrow>
                      </m:mfrac>
                      <m:mo>=</m:mo>
                      <m:mn>5</m:mn>
                    </m:mrow>
                  </m:math></para><para id="para-00069"><m:math display="inline">
                    <m:mrow>
                      <m:mi>y</m:mi>
                    </m:mrow>
                  </m:math>
            -intercept: <m:math display="inline">
                    <m:mrow>
                      <m:mfrac>
                        <m:mrow>
                          <m:mi>C</m:mi>
                        </m:mrow>
                        <m:mrow>
                          <m:mi>B</m:mi>
                        </m:mrow>
                      </m:mfrac>
                      <m:mo>=</m:mo>
                      <m:mfrac>
                        <m:mrow>
                          <m:mn>15</m:mn>
                        </m:mrow>
                        <m:mrow>
                          <m:mo>−</m:mo>
                          <m:mn>1</m:mn>
                        </m:mrow>
                      </m:mfrac>
                      <m:mo>=</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>15</m:mn>
                    </m:mrow>
                  </m:math></para>
              </solution>
            </exercise>
          </note>
        </section>
        <!--Interaction
          End -->
      </section>
    </section>
