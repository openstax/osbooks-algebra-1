  <content>
  <section><title>Activity</title>
<para>For numbers 1 – 5, select the slope and intercept that corresponds to each equation:</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="ddc8cc1b-4b5c-4970-bde1-f2ae532c4819" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q#1-->
  <exercise data-content-id="6c21e788-9cde-4e5b-94cc-e15e1e947b3f" data-problem-type="multiplechoice" data-solution="\( m=\frac 43 \), \( y\text{-int}=(0,1) \)" data-solution-options="[&quot;\\( m=3 \\), \\( y\\text{-int}=(0,1) \\)&quot;, &quot;\\( m=\\frac 43 \\), \\( y\\text{-int}=(0,1) \\)&quot;, &quot;\\( m=\\frac 43 \\), \\( y\\text{-int}=(0,-2) \\)&quot;, &quot;\\( m=-4 \\), \\( y\\text{-int}=(0,8) \\)&quot;, &quot;\\( m=3 \\), \\( y\\text{-int}=(0,-2) \\)&quot;]">
    <problem>
      <para>\( -4x+3y=3 \)</para>
      </problem>
    <solution>
      <para>Correct! \( m=\frac 43 \), \( y\text{-int}=(0,1) \)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#2-->
  <exercise data-content-id="290e6cf0-44ff-4e9c-88f4-1105c2b6945d" data-problem-type="multiplechoice" data-solution="\( m=3 \), \( y\text{-int}=(0,-2) \)" data-solution-options="[&quot;\\( m=3 \\), \\( y\\text{-int}=(0,1) \\)&quot;, &quot;\\( m=\\frac 43 \\), \\( y\\text{-int}=(0,1) \\)&quot;, &quot;\\( m=\\frac 43 \\), \\( y\\text{-int}=(0,-2) \\)&quot;, &quot;\\( m=-4 \\), \\( y\\text{-int}=(0,8) \\)&quot;, &quot;\\( m=3 \\), \\( y\\text{-int}=(0,-2) \\)&quot;]">
    <problem>
      <para>\( 12x-4y=8 \)</para>
      </problem>
    <solution>
      <para>Correct! \( m=3 \), \( y\text{-int}=(0,-2) \)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#3-->
  <exercise data-content-id="dc16004d-1b6c-4990-830a-3a35112e31e5" data-problem-type="multiplechoice" data-solution="\( m=-4 \), \( y\text{-int}=(0,8) \)" data-solution-options="[&quot;\\( m=3 \\), \\( y\\text{-int}=(0,1) \\)&quot;, &quot;\\( m=\\frac 43 \\), \\( y\\text{-int}=(0,1) \\)&quot;, &quot;\\( m=\\frac 43 \\), \\( y\\text{-int}=(0,-2) \\)&quot;, &quot;\\( m=-4 \\), \\( y\\text{-int}=(0,8) \\)&quot;, &quot;\\( m=3 \\), \\( y\\text{-int}=(0,-2) \\)&quot;]">
    <problem>
      <para>\( 8x+2y=16 \)</para>
      </problem>
    <solution>
      <para>Correct! \( m=-4 \), \( y\text{-int}=(0,8) \)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#4-->
  <exercise data-content-id="85f7342e-2dc9-4623-b35e-32e5737b516d" data-problem-type="multiplechoice" data-solution="\( m=3, y\text{-int}=(0,1) \)" data-solution-options="[&quot;\\( m=3, y\\text{-int}=(0,1) \\)&quot;, &quot;\\( m=\\frac 43 \\), \\( y\\text{-int}=(0,1) \\)&quot;, &quot;\\( m=\\frac 43 \\), \\( y\\text{-int}=(0,-2) \\)&quot;, &quot;\\( m=-4 \\), \\( y\\text{-int}=(0,8) \\)&quot;, &quot;\\( m=3 \\), \\( y\\text{-int}=(0,-2) \\)&quot;]">
    <problem>
      <para>\( -x+\frac 13 y=\frac 13 \)</para>
      </problem>
    <solution>
      <para>Correct! ( m=3 \), \( y\text{-int}=(0,1) \)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#5-->
  <exercise data-content-id="4f72d334-bc7f-4d5d-bf3e-1696a83110e9" data-problem-type="multiplechoice" data-solution="\( m=\frac 43 \), \( y\text{-int}=(0,-2) \)" data-solution-options="[&quot;\\( m=3 \\), \\( y\\text{-int}=(0,1) \\)&quot;, &quot;\\( m=\\frac 43 \\), \\( y\\text{-int}=(0,1) \\)&quot;, &quot;\\( m=\\frac 43 \\), \\( y\\text{-int}=(0,-2) \\)&quot;, &quot;\\( m=-4 \\), \\( y\\text{-int}=(0,8) \\)&quot;, &quot;\\( m=3 \\), \\( y\\text{-int}=(0,-2) \\)&quot;]">
    <problem>
      <para>\( -4x + 3y = -6 \)</para>
      </problem>
    <solution>
      <para>Correct! \( m=\frac 43 \), \( y\text{-int}=(0,-2) \)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
