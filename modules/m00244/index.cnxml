      <!--Q#11-->
      <exercise>
        <problem>
          <para>Using the graph from question 10, what is the slope of the line in simplest form?</para>
          <para>Enter your answer here:</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para> \(\frac32\)</para>
        </solution>
      </exercise>
