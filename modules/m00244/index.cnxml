<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Reasoning Symbolically and Abstractly about Linear Equations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00244</md:content-id>
    <md:title>Reasoning Symbolically and Abstractly about Linear Equations</md:title>
    <md:uuid>4a21ca3e-11e7-4b29-b12e-40fb195885ba</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">
      <title>Activity</title>
      <para id="para-00001">For numbers 1 – 5, select the slope and intercept that corresponds to
        each equation:</para>
      <exercise id="_6c21e788-9cde-4e5b-94cc-e15e1e947b3f" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00002"><m:math>
              <m:mrow>
                <m:mo>−</m:mo>
                <m:mn>4</m:mn>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>3</m:mn>
                <m:mi>y</m:mi>
                <m:mo>=</m:mo>
                <m:mn>3</m:mn>
              </m:mrow>
            </m:math></para>
          <list list-type="enumerated" number-style="lower-alpha" id="list-00001">
          <item><para id="para-00004"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mn>3</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>1</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item><para id="para-00005"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mn>4</m:mn>
                  <m:mn>3</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math>
            , <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>1</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item><para id="para-00006"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mn>4</m:mn>
                  <m:mn>3</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math>
            , <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mo>−</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item><para id="para-00007"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>4</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>8</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item><para id="para-00008"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mn>3</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mo>−</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
            </list>
        </problem>
        <solution id="sol-00001">
          <para id="para-00009"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mn>4</m:mn>
                  <m:mn>3</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math>
            , <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>1</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <exercise id="_290e6cf0-44ff-4e9c-88f4-1105c2b6945d" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00011"><m:math>
              <m:mrow>
                <m:mn>12</m:mn>
                <m:mi>x</m:mi>
                <m:mo>−</m:mo>
                <m:mn>4</m:mn>
                <m:mi>y</m:mi>
                <m:mo>=</m:mo>
                <m:mn>8</m:mn>
              </m:mrow>
            </m:math></para>
            <list list-type="enumerated" number-style="lower-alpha" id="list-00002">
          <item>
            <para id="para-00013"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mn>3</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>1</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item>
            <para id="para-00014"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mn>4</m:mn>
                  <m:mn>3</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math>
            , <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>1</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item>
            <para id="para-00015"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mn>4</m:mn>
                  <m:mn>3</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math>
            , <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mo>−</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item>
            <para id="para-00016"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>4</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>8</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item>
            <para id="para-00017"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mn>3</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mo>−</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
            </list>
        </problem>
        <solution id="sol-00002">
          <para id="para-00018"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mn>3</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mo>−</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <exercise id="dc16004d-1b6c-4990-830a-3a35112e31e5" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00020"><m:math>
              <m:mrow>
                <m:mn>8</m:mn>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
                <m:mi>y</m:mi>
                <m:mo>=</m:mo>
                <m:mn>16</m:mn>
              </m:mrow>
            </m:math></para>
<list list-type="enumerated" number-style="lower-alpha" id="list-00003">
            <item><para id="para-00022"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mn>3</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>1</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item><para id="para-00023"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mn>4</m:mn>
                  <m:mn>3</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math>
            , <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>1</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item><para id="para-00024"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mn>4</m:mn>
                  <m:mn>3</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math>
            , <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mo>−</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item><para id="para-00025"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>4</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>8</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item><para id="para-00026"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mn>3</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mo>−</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
            </list>
        </problem>
        <solution id="sol-00003">
          <para id="para-00027"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>4</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>8</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <exercise id="_85f7342e-2dc9-4623-b35e-32e5737b516d" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00029"><m:math>
              <m:mrow>
                <m:mo>−</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mfrac>
                  <m:mn>1</m:mn>
                  <m:mn>3</m:mn>
                </m:mfrac>
                <m:mi>y</m:mi>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mn>1</m:mn>
                  <m:mn>3</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math></para>
<list list-type="enumerated" number-style="lower-alpha" id="list-00004">
            <item><para id="para-00031"><m:math>
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mn>3</m:mn>
                <m:mo>,</m:mo>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>1</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item><para id="para-00032"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mn>4</m:mn>
                  <m:mn>3</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math>
            , <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>1</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item><para id="para-00033"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mn>4</m:mn>
                  <m:mn>3</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math>
            , <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mo>−</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item><para id="para-00034"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>4</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>8</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item><para id="para-00035"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mn>3</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mo>−</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
           </list>
        </problem>
        <solution id="sol-00004">
          <para id="para-00036">( m=3 \), <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>1</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <exercise id="_4f72d334-bc7f-4d5d-bf3e-1696a83110e9" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00038"><m:math>
              <m:mrow>
                <m:mo>−</m:mo>
                <m:mn>4</m:mn>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>3</m:mn>
                <m:mi>y</m:mi>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>6</m:mn>
              </m:mrow>
            </m:math></para>
<list list-type="enumerated" number-style="lower-alpha" id="list-00005">
            <item><para id="para-00040"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mn>3</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>1</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item><para id="para-00041"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mn>4</m:mn>
                  <m:mn>3</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math>
            , <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>1</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item><para id="para-00042"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mn>4</m:mn>
                  <m:mn>3</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math>
            , <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mo>−</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item><para id="para-00043"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>4</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>8</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
          <item><para id="para-00044"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mn>3</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mo>−</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></item>
            </list>
        </problem>
        <solution id="sol-00005">
          <para id="para-00045"><m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mn>4</m:mn>
                  <m:mn>3</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math>
            , <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mtext>-int</m:mtext>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mo>−</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>

      <para id="para-00099"><emphasis>Using Standard Form and Intercepts to Graph</emphasis></para>
      <para id="para-00047">Standard form, <m:math display="inline">
          <m:mrow>
            <m:mi>A</m:mi>
            <m:mi>x</m:mi>
            <m:mo>+</m:mo>
            <m:mi>B</m:mi>
            <m:mi>y</m:mi>
            <m:mo>=</m:mo>
            <m:mi>C</m:mi>
          </m:mrow>
        </m:math>, is helpful for finding the <m:math display="inline">
          <m:mrow>
            <m:mi>x</m:mi>
          </m:mrow>
        </m:math>-intercepts and <m:math display="inline">
          <m:mrow>
            <m:mi>y</m:mi>
          </m:mrow>
        </m:math>-intercepts of an equation.</para>
      <para id="para-00048">For questions 6 - 11, use the equation <m:math display="inline">
          <m:mrow>
            <m:mn>6</m:mn>
            <m:mi>x</m:mi>
            <m:mo>−</m:mo>
            <m:mn>4</m:mn>
            <m:mi>y</m:mi>
            <m:mo>=</m:mo>
            <m:mn>24</m:mn>
          </m:mrow>
        </m:math>.</para>

      <exercise id="d693b658-f7c3-4288-9f1b-0baf9a491166" class="multiple-choice">
        <problem id="prob-00006">
          <para id="para-00050">What is the value of <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math> at the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercept?</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00051">0</para>
        </solution>
      </exercise>
      <exercise id="_8bab532e-ecf3-48f9-a6e5-4505f13ce64e" class="multiple-choice">
        <problem id="prob-00007">
          <para id="para-00053">What is the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercept of the
            equation?</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00054">4</para>
        </solution>
      </exercise>
      <exercise id="_04605dc6-d8fc-45b1-a167-4208032018fe" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00056">What is the value of <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math> at the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept?</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00057">0</para>
        </solution>
      </exercise>
      <exercise id="_59849d8c-16fa-497f-85ed-a7fc1d68615a" class="multiple-choice">
        <problem id="prob-00009">
          <para id="para-00059">What is the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept of the
            equation?</para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00060">-6</para>
        </solution>
      </exercise>
      <!--BEGIN
      ADD DESMOS INTERATIVE-->
      <!--START
