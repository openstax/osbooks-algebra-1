      <!--Q#11-->
      <exercise id="exer-00002">
        <problem id="prob-00011">
          <para id="para-00065">Using the graph from question 10, what is the slope of the line in simplest form?</para>
        </problem>
        <solution id="sol-00011">
          <para id="para-00066">Compare your answer:</para>
          <para id="para-00067">\(\frac32\)</para>
        </solution>
