<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.1.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01246</md:content-id>
    <md:title>5.1.6: Practice</md:title>
    <md:uuid>7d9855ce-6416-4bd7-af16-dff08c44c3d1</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.
</para>
<para id="para-00002">
  Simplify each expression using the appropriate property from the lesson. Double click on mathematical expressions/equations to enlarge.
</para>
<!--Do not edit this div tag.  It must surround the interaction block-->
<section id="sect-00002"><exercise id="_5bc25e84-3ebc-45a4-b6f7-6fbd0bb8aa7c" class="multiple-choice"><problem id="prob-00001"><para id="para-00003">\(f^2 \cdot f^6\)</para>
      <para id="para-00004">Multiple Choice:</para><para id="para-00005">\(f^{36}\)</para><para id="para-00006">\(f^4\)</para><para id="para-00007">\(f^{12}\)</para><para id="para-00008">\(f^8\)</para></problem><solution id="sol-00001"><para id="para-00009">Try again. Revisit activity 5.1.2.
    </para><para id="para-00010">The correct answer is \(f^8\).
    </para></solution></exercise>
      
      <exercise id="d5986df5-4414-4eef-91a0-d11f39dab078" class="multiple-choice"><problem id="prob-00002"><para id="para-00011">\(\frac{(-y)^6}{(-y)^3}\)</para>
      <para id="para-00012">Multiple Choice:</para><para id="para-00013">\((-y)^3\)</para><para id="para-00014">\((-y)^2\)</para><para id="para-00015">\((-y)^9\)</para><para id="para-00016">\((-y)^{18}\)</para></problem><solution id="sol-00002"><para id="para-00017">Try again. Revisit activity 5.1.2.
    </para><para id="para-00018">The correct answer is \((-y)^3\).
    </para></solution></exercise>
      
      <exercise id="_09c7219f-b70c-4d73-ae66-7e7299eeb99b" class="multiple-choice"><problem id="prob-00003"><para id="para-00019">\((-4)^0\)</para>
      <para id="para-00020">Multiple Choice:</para><para id="para-00021">\(0\)</para><para id="para-00022">\(4\)</para><para id="para-00023">\(1\)</para><para id="para-00024">\(-4\)</para></problem><solution id="sol-00003"><para id="para-00025">Try again. Revisit activity 5.1.3.
    </para><para id="para-00026">The correct answer is 1.
    </para></solution></exercise>
      
      <exercise id="ac9e29df-1ce0-4c16-897a-72c97c47e385" class="multiple-choice"><problem id="prob-00004"><para id="para-00027">\(2^{-3}\)</para>
      <para id="para-00028">Multiple Choice:</para><para id="para-00029">\( 8\)</para><para id="para-00030">\(-6 \)</para><para id="para-00031">\(\frac18\)</para><para id="para-00032">\( -\frac18 \)</para></problem><solution id="sol-00004"><para id="para-00033">Try again. Revisit activity 5.1.3.</para><para id="para-00034">The correct answer is \(\frac18\).</para></solution></exercise>
      
      <exercise id="_347ae9cf-eb9c-4b6e-ac4e-3f0d83da8d33" class="multiple-choice"><problem id="prob-00005"><para id="para-00035">\(\frac{1}{(-t)^{-5}}\)</para>
      <para id="para-00036">Multiple Choice:</para><para id="para-00037">\( t^4\)</para><para id="para-00038">\(t^5\)</para><para id="para-00039">\(\frac{1}{t^5}\)</para><para id="para-00040">\((-t)^5\)</para></problem><solution id="sol-00005"><para id="para-00041">Try again. Revisit activity 5.1.3.

    </para><para id="para-00042">The correct answer is \((-t)^5\).
    </para></solution></exercise>
      
      <exercise id="a33cdfaf-1aff-458f-b3e2-01d0c57f8eee" class="multiple-choice"><problem id="prob-00006"><para id="para-00043">\((-\frac{m}{n})^{-3}\)</para>
      <para id="para-00044">Multiple Choice:</para><para id="para-00045">\(\frac{n^3}{m^3} \)</para><para id="para-00046">\(\frac{m^3}{n^3}\)</para><para id="para-00047">\(-\frac{n^3}{m^3}\)</para><para id="para-00048">\( -\frac{m^3}{n^3}\)</para></problem><solution id="sol-00006"><para id="para-00049">Try again. Revisit activity 5.1.4.
    </para><para id="para-00050">The correct answer is \(-\frac{n^3}{m^3}\).
    </para></solution></exercise>
      
      <exercise id="_1875b481-fb1c-4781-bc11-32b495e8b2b4" class="multiple-choice"><problem id="prob-00007"><para id="para-00051">\((d^3)^5\)</para>
      <para id="para-00052">Multiple Choice:</para><para id="para-00053">\( d^{15}\)</para><para id="para-00054">\(d^8\)</para><para id="para-00055">\(d^5 \)</para><para id="para-00056">\(d^{-2}\)</para></problem><solution id="sol-00007"><para id="para-00057">Try again. Revisit activity 5.1.4.
    </para><para id="para-00058">The correct answer is \( d^{15}\).
    </para></solution></exercise>
      
      <exercise id="d043cfe7-16bd-4e49-a07d-bc62308ca3cc" class="multiple-choice"><problem id="prob-00008"><para id="para-00059">\(( 5x^{-2})^3\)</para>
      <para id="para-00060">Multiple Choice:</para><para id="para-00061">\(\frac{ 125}{x^5}\)</para><para id="para-00062">\(5x\)</para><para id="para-00063">\(\frac{125}{x^6}\)</para><para id="para-00064">\(125x\)</para></problem><solution id="sol-00008"><para id="para-00065">Try again. Revisit activity 5.1.4.
    </para><para id="para-00066">The correct answer is \(\frac{125}{x^6}\).
    </para></solution></exercise>
      
      <exercise id="_811cfafd-0236-4b3b-816f-f9b65160ab88" class="multiple-choice"><problem id="prob-00009"><para id="para-00067">\((\frac{7b^3c}{d^2})^2\)</para>
      <para id="para-00068">Multiple Choice:</para><para id="para-00069">\(\frac{d^4}{49b^6c^2}\)</para><para id="para-00070">\(\frac{7b^6c^2}{d^4}\)</para><para id="para-00071">\(\frac{49b^6c^2}{d^4}\)</para><para id="para-00072">\(\frac{49b^5c^2}{d^4}\)</para></problem><solution id="sol-00009"><para id="para-00073">Try again. Revisit activity 5.1.4.
    </para><para id="para-00074">The correct answer is \(\frac{49b^6c^2}{d^4}\).
    </para></solution></exercise>
      
      <exercise id="bd146c8a-717e-498e-9add-216142ce0c5f" class="multiple-choice"><problem id="prob-00010"><para id="para-00075">\((\frac{3z^{-2}}{w^2})^{-2}\)</para>
      <para id="para-00076">Multiple Choice:</para><para id="para-00077">\(9z^4w^4\)</para><para id="para-00078">\(\frac{9w^4}{z^4}\)</para><para id="para-00079">\(\frac{w^4}{9z^4}\)</para><para id="para-00080">\(\frac{z^4w^4}{9}\)</para></problem><solution id="sol-00010"><para id="para-00081">Try again. Revisit activity 5.1.4.
    </para><para id="para-00082">The correct answer is \(\frac{z^4w^4}{9}\).
    </para></solution></exercise></section></section>
