<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.1.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01246</md:content-id>
    <md:title>5.1.6: Practice</md:title>
    <md:uuid>7d9855ce-6416-4bd7-af16-dff08c44c3d1</md:uuid>
  </metadata>
  <content>
  <section class="practice" id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.
</para>
<para id="para-00002">
  Simplify each expression using the appropriate property from the lesson. Double click on mathematical expressions/equations to enlarge.
</para>
<!--Do not edit this div tag.  It must surround the interaction block-->
<section id="sect-00002"><exercise id="_5bc25e84-3ebc-45a4-b6f7-6fbd0bb8aa7c" class="multiple-choice"><problem id="prob-00001"><para id="para-00003"><m:math><m:mrow><m:msup><m:mi>f</m:mi><m:mn>2</m:mn></m:msup><m:mi>·</m:mi><m:msup><m:mi>f</m:mi><m:mn>6</m:mn></m:msup></m:mrow></m:math></para>
  <para id="para-00004">Multiple Choice:</para>
  <para id="para-00005"><m:math><m:mrow><m:msup><m:mi>f</m:mi><m:mrow><m:mn>36</m:mn></m:mrow></m:msup></m:mrow></m:math></para>
  <para id="para-00006"><m:math><m:mrow><m:msup><m:mi>f</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:math></para>
  <para id="para-00007"><m:math><m:mrow><m:msup><m:mi>f</m:mi><m:mrow><m:mn>12</m:mn></m:mrow></m:msup></m:mrow></m:math></para>
  <para id="para-00008"><m:math><m:mrow><m:msup><m:mi>f</m:mi><m:mn>8</m:mn></m:msup></m:mrow></m:math></para></problem><solution id="sol-00001"><para id="para-00009">Try again. Revisit activity 5.1.2.
    </para><para id="para-00010">The correct answer is <m:math display="inline"><m:mrow><m:msup><m:mi>f</m:mi><m:mn>8</m:mn></m:msup></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="d5986df5-4414-4eef-91a0-d11f39dab078" class="multiple-choice"><problem id="prob-00002"><para id="para-00011"><m:math><m:mrow><m:mfrac><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mi>y</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>6</m:mn></m:msup></m:mrow><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mi>y</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>3</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00012">Multiple Choice:</para><para id="para-00013"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mi>y</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>3</m:mn></m:msup></m:mrow></m:math></para><para id="para-00014"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mi>y</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00015"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mi>y</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>9</m:mn></m:msup></m:mrow></m:math></para><para id="para-00016"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mi>y</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mn>18</m:mn></m:mrow></m:msup></m:mrow></m:math></para></problem><solution id="sol-00002"><para id="para-00017">Try again. Revisit activity 5.1.2.
    </para><para id="para-00018">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mi>y</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>3</m:mn></m:msup></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_09c7219f-b70c-4d73-ae66-7e7299eeb99b" class="multiple-choice"><problem id="prob-00003"><para id="para-00019"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>0</m:mn></m:msup></m:mrow></m:math></para><para id="para-00020">Multiple Choice:</para><para id="para-00021"><m:math><m:mrow><m:mn>0</m:mn></m:mrow></m:math></para><para id="para-00022"><m:math><m:mrow><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00023"><m:math><m:mrow><m:mn>1</m:mn></m:mrow></m:math></para><para id="para-00024"><m:math><m:mrow><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para></problem><solution id="sol-00003"><para id="para-00025">Try again. Revisit activity 5.1.3.
    </para><para id="para-00026">The correct answer is 1.
    </para></solution></exercise>
      
      <exercise id="ac9e29df-1ce0-4c16-897a-72c97c47e385" class="multiple-choice"><problem id="prob-00004"><para id="para-00027"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mrow><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:msup></m:mrow></m:math></para><para id="para-00028">Multiple Choice:</para><para id="para-00029"><m:math><m:mrow><m:mn>8</m:mn></m:mrow></m:math></para><para id="para-00030"><m:math><m:mrow><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math></para><para id="para-00031"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para><para id="para-00032"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para></problem><solution id="sol-00004"><para id="para-00033">Try again. Revisit activity 5.1.3.</para><para id="para-00034">The correct answer is <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_347ae9cf-eb9c-4b6e-ac4e-3f0d83da8d33" class="multiple-choice"><problem id="prob-00005"><para id="para-00035"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mi>t</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00036">Multiple Choice:</para><para id="para-00037"><m:math><m:mrow><m:msup><m:mi>t</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:math></para><para id="para-00038"><m:math><m:mrow><m:msup><m:mi>t</m:mi><m:mn>5</m:mn></m:msup></m:mrow></m:math></para><para id="para-00039"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:msup><m:mi>t</m:mi><m:mn>5</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00040"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mi>t</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>5</m:mn></m:msup></m:mrow></m:math></para></problem><solution id="sol-00005"><para id="para-00041">Try again. Revisit activity 5.1.3.

    </para><para id="para-00042">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mi>t</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>5</m:mn></m:msup></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="a33cdfaf-1aff-458f-b3e2-01d0c57f8eee" class="multiple-choice"><problem id="prob-00006"><para id="para-00043"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mi>m</m:mi></m:mrow><m:mrow><m:mi>n</m:mi></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:msup></m:mrow></m:math></para><para id="para-00044">Multiple Choice:</para><para id="para-00045"><m:math><m:mrow><m:mfrac><m:mrow><m:msup><m:mi>n</m:mi><m:mn>3</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mi>m</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00046"><m:math><m:mrow><m:mfrac><m:mrow><m:msup><m:mi>m</m:mi><m:mn>3</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mi>n</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00047"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:msup><m:mi>n</m:mi><m:mn>3</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mi>m</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00048"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:msup><m:mi>m</m:mi><m:mn>3</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mi>n</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para></problem>
        <solution id="sol-00006">
        <para id="para-00049">Try again. Revisit activity 5.1.4.
    </para><para id="para-00050">The correct answer is <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:msup><m:mi>n</m:mi><m:mn>3</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mi>m</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_1875b481-fb1c-4781-bc11-32b495e8b2b4" class="multiple-choice"><problem id="prob-00007"><para id="para-00051"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:msup><m:mi>d</m:mi><m:mn>3</m:mn></m:msup><m:msup><m:mo stretchy="false">)</m:mo><m:mn>5</m:mn></m:msup></m:mrow></m:math></para><para id="para-00052">Multiple Choice:</para><para id="para-00053"><m:math><m:mrow><m:msup><m:mi>d</m:mi><m:mrow><m:mn>15</m:mn></m:mrow></m:msup></m:mrow></m:math></para><para id="para-00054"><m:math><m:mrow><m:msup><m:mi>d</m:mi><m:mn>8</m:mn></m:msup></m:mrow></m:math></para><para id="para-00055"><m:math><m:mrow><m:msup><m:mi>d</m:mi><m:mn>5</m:mn></m:msup></m:mrow></m:math></para><para id="para-00056"><m:math><m:mrow><m:msup><m:mi>d</m:mi><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:msup></m:mrow></m:math></para></problem>
        <solution id="sol-00007">
        <para id="para-00057">Try again. Revisit activity 5.1.4.
    </para><para id="para-00058">The correct answer is <m:math display="inline"><m:mrow><m:msup><m:mi>d</m:mi><m:mrow><m:mn>15</m:mn></m:mrow></m:msup></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="d043cfe7-16bd-4e49-a07d-bc62308ca3cc" class="multiple-choice"><problem id="prob-00008"><para id="para-00059"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:msup><m:mi>x</m:mi><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:msup><m:msup><m:mo stretchy="false">)</m:mo><m:mn>3</m:mn></m:msup></m:mrow></m:math></para><para id="para-00060">Multiple Choice:</para><para id="para-00061"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>125</m:mn></m:mrow><m:mrow><m:msup><m:mi>x</m:mi><m:mn>5</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00062"><m:math><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00063"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>125</m:mn></m:mrow><m:mrow><m:msup><m:mi>x</m:mi><m:mn>6</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00064"><m:math><m:mrow><m:mn>125</m:mn><m:mi>x</m:mi></m:mrow></m:math></para></problem>
        <solution id="sol-00008"><para id="para-00065">Try again. Revisit activity 5.1.4.
    </para><para id="para-00066">The correct answer is <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>125</m:mn></m:mrow><m:mrow><m:msup><m:mi>x</m:mi><m:mn>6</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_811cfafd-0236-4b3b-816f-f9b65160ab88" class="multiple-choice"><problem id="prob-00009"><para id="para-00067"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>7</m:mn><m:msup><m:mi>b</m:mi><m:mn>3</m:mn></m:msup><m:mi>c</m:mi></m:mrow><m:mrow><m:msup><m:mi>d</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00068">Multiple Choice:</para><para id="para-00069"><m:math><m:mrow><m:mfrac><m:mrow><m:msup><m:mi>d</m:mi><m:mn>4</m:mn></m:msup></m:mrow><m:mrow><m:mn>49</m:mn><m:msup><m:mi>b</m:mi><m:mn>6</m:mn></m:msup><m:msup><m:mi>c</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00070"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>7</m:mn><m:msup><m:mi>b</m:mi><m:mn>6</m:mn></m:msup><m:msup><m:mi>c</m:mi><m:mn>2</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mi>d</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00071"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>49</m:mn><m:msup><m:mi>b</m:mi><m:mn>6</m:mn></m:msup><m:msup><m:mi>c</m:mi><m:mn>2</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mi>d</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00072"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>49</m:mn><m:msup><m:mi>b</m:mi><m:mn>5</m:mn></m:msup><m:msup><m:mi>c</m:mi><m:mn>2</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mi>d</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para></problem>
        
        <solution id="sol-00009"><para id="para-00073">Try again. Revisit activity 5.1.4.
    </para><para id="para-00074">The correct answer is <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>49</m:mn><m:msup><m:mi>b</m:mi><m:mn>6</m:mn></m:msup><m:msup><m:mi>c</m:mi><m:mn>2</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mi>d</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="bd146c8a-717e-498e-9add-216142ce0c5f" class="multiple-choice"><problem id="prob-00010"><para id="para-00075"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn><m:msup><m:mi>z</m:mi><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:msup></m:mrow><m:mrow><m:msup><m:mi>w</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:msup></m:mrow></m:math></para><para id="para-00076">Multiple Choice:</para><para id="para-00077"><m:math><m:mrow><m:mn>9</m:mn><m:msup><m:mi>z</m:mi><m:mn>4</m:mn></m:msup><m:msup><m:mi>w</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:math></para><para id="para-00078"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>9</m:mn><m:msup><m:mi>w</m:mi><m:mn>4</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mi>z</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00079"><m:math><m:mrow><m:mfrac><m:mrow><m:msup><m:mi>w</m:mi><m:mn>4</m:mn></m:msup></m:mrow><m:mrow><m:mn>9</m:mn><m:msup><m:mi>z</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00080"><m:math><m:mrow><m:mfrac><m:mrow><m:msup><m:mi>z</m:mi><m:mn>4</m:mn></m:msup><m:msup><m:mi>w</m:mi><m:mn>4</m:mn></m:msup></m:mrow><m:mrow><m:mn>9</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para></problem>
        
        <solution id="sol-00010"><para id="para-00081">Try again. Revisit activity 5.1.4.
    </para><para id="para-00082">The correct answer is <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:msup><m:mi>z</m:mi><m:mn>4</m:mn></m:msup><m:msup><m:mi>w</m:mi><m:mn>4</m:mn></m:msup></m:mrow><m:mrow><m:mn>9</m:mn></m:mrow></m:mfrac></m:mrow></m:math>.
    </para></solution></exercise></section></section>
</content>
</document>