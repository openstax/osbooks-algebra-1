  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.
</para>
<para>
  Simplify each expression using the appropriate property from the lesson. Double click on mathematical expressions/equations to enlarge.
</para>
<!--Do not edit this div tag.  It must surround the interaction block-->
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="bbbb7bb2-7dc2-43b4-8fdb-bc4b9fe9c2b4" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--Q1-->
  <exercise data-content-id="5bc25e84-3ebc-45a4-b6f7-6fbd0bb8aa7c" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(f^8\)" data-solution-options="[&quot;\\(f^{36}\\) &quot;, &quot;\\(f^4\\) &quot;, &quot;\\(f^{12}\\) &quot;, &quot;\\(f^8\\)&quot;]">
    <problem>
      <para> \(f^2 \cdot f^6\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.1.2.
      </para>
    </div>
    </exercise>
  <!--Q2-->
  <exercise data-content-id="d5986df5-4414-4eef-91a0-d11f39dab078" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((-y)^3\) " data-solution-options="[&quot;\\((-y)^3\\) &quot;, &quot;\\((-y)^2\\)&quot;, &quot;\\((-y)^9\\)&quot;, &quot;\\((-y)^{18}\\)&quot;]">
    <problem>
      <para> \(\frac{(-y)^6}{(-y)^3}\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.1.2.
      </para>
    </div>
    </exercise>
  <!--Q3-->
  <exercise data-content-id="09c7219f-b70c-4d73-ae66-7e7299eeb99b" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(1\)" data-solution-options="[&quot;\\(0\\)&quot;, &quot;\\(4\\)&quot;, &quot;\\(1\\)&quot;, &quot;\\(-4\\)&quot;]">
    <problem>
      <para> \((-4)^0\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.1.3.
      </para>
    </div>
    </exercise>
  <!--Q4-->
  <exercise data-content-id="ac9e29df-1ce0-4c16-897a-72c97c47e385" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(\frac18\)" data-solution-options="[&quot;\\( 8\\)&quot;, &quot;\\(-6 \\)&quot;, &quot;\\(\\frac18\\)&quot;, &quot;\\( -\\frac18 \\)&quot;]">
    <problem>
      <para> \(2^{-3}\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.1.3.</para>
    </div>
    </exercise>
  <!--Q5-->
  <exercise data-content-id="347ae9cf-eb9c-4b6e-ac4e-3f0d83da8d33" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((-t)^5\)" data-solution-options="[&quot;\\( t^4\\)&quot;, &quot;\\(t^5\\)&quot;, &quot;\\(\\frac{1}{t^5}\\)&quot;, &quot;\\((-t)^5\\)&quot;]">
    <problem>
      <para>\(\frac{1}{(-t)^{-5}}\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.1.3.

      </para>
    </div>
    </exercise>
  <!--Q6-->
  <exercise data-content-id="a33cdfaf-1aff-458f-b3e2-01d0c57f8eee" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(-\frac{n^3}{m^3}\)" data-solution-options="[&quot;\\(\\frac{n^3}{m^3} \\)&quot;, &quot;\\(\\frac{m^3}{n^3}\\)&quot;, &quot;\\(-\\frac{n^3}{m^3}\\)&quot;, &quot;\\( -\\frac{m^3}{n^3}\\)&quot;]">
    <problem>
      <para>\((-\frac{m}{n})^{-3}\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.1.4.
      </para>
    </div>
    </exercise>
  <!--Q7-->
  <exercise data-content-id="1875b481-fb1c-4781-bc11-32b495e8b2b4" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\( d^{15}\)" data-solution-options="[&quot;\\( d^{15}\\)&quot;, &quot;\\(d^8\\)&quot;, &quot;\\(d^5 \\)&quot;, &quot;\\(d^{-2}\\)&quot;]">
    <problem>
      <para>\((d^3)^5\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.1.4.
      </para>
    </div>
    </exercise>
  <!--Q8-->
  <exercise data-content-id="d043cfe7-16bd-4e49-a07d-bc62308ca3cc" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(\frac{125}{x^6}\)" data-solution-options="[&quot;\\(\\frac{ 125}{x^5}\\)&quot;, &quot;\\(5x\\)&quot;, &quot;\\(\\frac{125}{x^6}\\)&quot;, &quot;\\(125x\\)&quot;]">
    <problem>
      <para>\(( 5x^{-2})^3\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.1.4.
      </para>
    </div>
    </exercise>
  <!--Q9-->
  <exercise data-content-id="811cfafd-0236-4b3b-816f-f9b65160ab88" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(\frac{49b^6c^2}{d^4}\)" data-solution-options="[&quot;\\(\\frac{d^4}{49b^6c^2}\\)&quot;, &quot;\\(\\frac{7b^6c^2}{d^4}\\)&quot;, &quot;\\(\\frac{49b^6c^2}{d^4}\\)&quot;, &quot;\\(\\frac{49b^5c^2}{d^4}\\)&quot;]">
    <problem>
      <para>\((\frac{7b^3c}{d^2})^2\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.1.4.
      </para>
    </div>
    </exercise>
  <!--Q10-->
  <exercise data-content-id="bd146c8a-717e-498e-9add-216142ce0c5f" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(\frac{z^4w^4}{9}\)" data-solution-options="[&quot;\\(9z^4w^4\\)&quot;, &quot;\\(\\frac{9w^4}{z^4}\\)&quot;, &quot;\\(\\frac{w^4}{9z^4}\\)&quot;, &quot;\\(\\frac{z^4w^4}{9}\\)&quot;]">
    <problem>
      <para>\((\frac{3z^{-2}}{w^2})^{-2}\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.1.4.
      </para>
    </div>
    </exercise>
