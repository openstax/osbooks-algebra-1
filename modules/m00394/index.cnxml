<!--Q#3-->
<exercise>
  <problem>
    <para> Use the graph to estimate the solution. </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>Answers may vary. Here is a sample response.</para>
    <para>\((11,8.5)\)</para>
    <para>The elliptical burns about 11 calories per minute. Lifting weights burns about 8.5 calories per minute.</para>
  </solution></exercise>
<!--Interaction End -->
