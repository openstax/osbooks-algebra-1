  <content>
    <section id="sect-00001">
      <title>Cool Down Activity</title>
      <para id="para-00001">Translate to a system of equations and then solve:</para>
      <para id="para-00002">When Jenna spent 10 minutes on the elliptical trainer and then lifted weights for 20
        minutes, her fitness app said she burned 278 calories. When she spent 20 minutes on the
        elliptical trainer and 30 minutes lifting weights she burned 473 calories. How many calories
        does she burn for each minute on the elliptical trainer? How many calories does she burn for
        each minute of lifting weights?</para>
      <para id="para-00003">Let \(x =\) calories burned per minute on the elliptical and \(y=\) calories burned per
        minute lifting weights.</para>
      <!--Q#1-->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00004">Write a system of equations.</para>

        </problem>
        <solution id="sol-00001">
          <para id="para-00005">Compare your answer:</para>
          <para id="para-00006">\(10x+20y=278\)</para>
          <para id="para-00007">\(20x+30y=473\)</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#2-->
      <para id="para-00008">Use the graphing tool or technology outside the course. Graph the equation that
          represents this scenario using the Desmos tool below.</para>
      <media alt="">
      <iframe src="../../media/desmos/71e4db97d64724762820bd43435b4ff54f6f3e83.html" width="500" height="400"/>
      </media>

        <exercise id="exer-00002">
          <problem id="prob-00002">
            <!--QUESTION
            IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
            <para id="para-00009">Write down your answer, then select the <emphasis>solution</emphasis> button to
              compare your work.</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00010">Compare your answer:</para>
            
              <media alt="Insert Alt Text">
                <image mime-type="image/jpeg" src="../../media/Algebra-1_02_04_09_01.jpg"/>
              </media>
            
          </solution>
        </exercise>
 
      <!--Interaction
      End -->
      <!--Q#3-->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00011">Use the graph to estimate the solution.</para>

        </problem>
        <solution id="sol-00003">
          <para id="para-00012">Compare your answer:</para>
          <para id="para-00013">Answers may vary. Here is a sample response.</para>
          <para id="para-00014">\((11,8.5)\)</para>
          <para id="para-00015">The elliptical burns about 11 calories per minute. Lifting weights burns about 8.5
            calories per minute.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
    </section>
