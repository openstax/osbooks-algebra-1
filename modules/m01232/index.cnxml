<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.1.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01232</md:content-id>
    <md:title>5.1.6: Practice</md:title>
    <md:uuid>764f55bb-6abd-40bc-924e-967bb5492661</md:uuid>
  </metadata>
  <content>
  <section><para><emphasis><emphasis>Students will complete the following questions to practice the skills they have learned in this lesson.</emphasis></emphasis></para>
<para>Simplify each expression using the appropriate property from the lesson. Double click on mathematical expressions/equations to enlarge.</para>
<list class="os-raise-noindent" type="enumerated">
  <item> \(f^2 \cdot f^6\)
  </item></list>
    <list>
    <item> \(f^{36}\) </item>
    <item> \(f^4\) </item>
    <item> \(f^{12}\) </item>
    <item> \(f^8\)</item>
    </list>
  

<para> <emphasis> Answer:</emphasis> \(f^8\) </para>
<list class="os-raise-noindent" start="2" type="enumerated">
  <item> \(\frac{(-y)^6}{(-y)^3}\)  </item>

  </list>
    <list>
      <item> \((-y)^3\) </item>
      <item> \((-y)^2\) </item>
      <item> \((-y)^9\) </item>
      <item> \((-y)^{18}\) </item>
    </list>
<para> <emphasis>Answer:</emphasis>  \((-y)^3\) </para>
<list class="os-raise-noindent" start="3" type="enumerated">
  <item> \((-4)^0\)  </item>

  </list>
    <list>
      <item> \(0\) </item>
      <item> \(4\) </item>
      <item> \(1\) </item>
      <item> \(-4\) </item>
    </list>
<para> <emphasis>Answer:</emphasis> \(1\) </para>
<list class="os-raise-noindent" start="4" type="enumerated">
  <item> \(2^{-3}\)  </item>
</list>
    <list>
      <item>\(
        8\) </item>
      <item> \(-6
        \)</item>
      <item> \(\frac18\) </item>
      <item>\(
        -\frac18
        \)</item>
      </list>
<para> <emphasis>Answer:</emphasis> \(\frac18\) </para>
<list class="os-raise-noindent" start="5" type="enumerated">
  <item>\(\frac{1}{(-t)^{-5}}\)  </item>
</list>
    <list>
      <item>\(
        t^4\) </item>
      <item> \(t^5\) </item>
      <item> \(\frac{1}{t^5}\) </item>
      <item> \((-t)^5\) </item>
    </list>

<para> <emphasis>Answer:</emphasis> \((-t)^5\) </para>
<list class="os-raise-noindent" start="6" type="enumerated">
  <item> \((-\frac{m}{n})^{-3}\)  </item>
</list>
    <list>
      <item> \(\frac{n^3}{m^3}
        \)</item>
      <item> \(\frac{m^3}{n^3}\) </item>
      <item> \(-\frac{n^3}{m^3}\) </item>
      <item>\(
        -\frac{m^3}{n^3}\) </item>
    </list>

<para> <emphasis>Answer:</emphasis>
  \(-\frac{n^3}{m^3}\) </para>
<list class="os-raise-noindent" start="7" type="enumerated">
  <item>\((d^3)^5\)  </item>
</list>
    <list>
      <item>\(
        d^{15}\) </item>
      <item> \(d^8\) </item>
      <item> \(d^5
        \)</item>
      <item> \(d^{-2}\) </item>
      </list>

<para> <emphasis>Answer: </emphasis> \(
  d^{15}\) </para>
<list class="os-raise-noindent" start="8" type="enumerated">
  <item>\(( 5x^{-2})^3\)</item>
</list>
    <list>
      <item>\(\frac{
        125}{x^5}\) </item>
      <item> \(5x\) </item>
      <item>\(\frac{125}{x^6}\) </item>
      <item>\(125x\) </item>
      </list>
  
<para> <emphasis>Answer:</emphasis> \(\frac{125}{x^6}\) </para>
<list class="os-raise-noindent" start="9" type="enumerated">
  <item>\((\frac{7b^3c}{d^2})^2\)  </item>
</list>
    <list>
      <item> \(\frac{d^4}{49b^6c^2}\) </item>
      <item>\(\frac{7b^6c^2}{d^4}\) </item>
      <item> \(\frac{49b^6c^2}{d^4}\) </item>
      <item> \(\frac{49b^5c^2}{d^4}\) </item>
    </list>

<para> <emphasis>Answer:</emphasis> \(\frac{49b^6c^2}{d^4}\) </para>
<list class="os-raise-noindent" start="10" type="enumerated">
  <item>\((\frac{3z^{-2}}{w^2})^{-2}\)  </item>
</list>
    <list>
      <item> \(9z^4w^4\) </item>
      <item>\(\frac{9w^4}{z^4}\) </item>
      <item> \(\frac{w^4}{9z^4}\) </item>
      <item> \(\frac{z^4w^4}{9}\) </item>
    </list>

<para> <emphasis>Answer:</emphasis>
  \(\frac{z^4w^4}{9}\) </para></section>
</content>
