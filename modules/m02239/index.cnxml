    </exercise>
  <!--10-->
  <exercise data-content-id="39a9a1bd-5d3a-4f62-aeb0-f5ab200dc47c" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x=9\)" data-solution-options="[&quot;\\(x = -9\\)&quot;, &quot;\\(x = -9\\) and \\(x=9\\)&quot;, &quot;\\(x= -10\\) and \\(x=8\\)&quot;, &quot;\\(x=9\\)&quot;]">
    <problem>
      <para>Solve the equation: \(x^2− 18x + 90 = 9\).</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.9.4.
      </para>
    </div>
    </exercise>
