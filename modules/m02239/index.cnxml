  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<para>For questions 1 – 5, solve each quadratic equation by rewriting it in factored form and using the zero product property.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="797dd8b2-a6a3-4dd0-9671-ff7b0031b3eb" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--1-->
  <exercise data-content-id="39ac4015-3c0f-469f-9d92-50f25665caf2" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x = -4\) and \(x = -7\)" data-solution-options="[&quot;\\(x = -4\\) and \\(x = -7\\)&quot;, &quot;\\(x = -6\\) and \\(x = -7\\)&quot;, &quot;\\(x = 14\\) and \\(x = -3\\)&quot;, &quot;\\(x = -5\\) and \\(x = -7\\)&quot;]">
    <problem>
      <para>\(x^2 + 11x + 35 = 7\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.9.2.</para>
    </div>
    </exercise>
  <!--2-->
  <exercise data-content-id="bc01d2d3-654d-4299-a9bf-ab2cd1a59ca7" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x = 9\) and \(x = 5\)" data-solution-options="[&quot;\\(x = 3\\) and \\(x = 15\\)&quot;, &quot;\\(x = 10\\) and \\(x = 2\\)&quot;, &quot;\\(x = -10\\) and \\(x = -4\\)&quot;, &quot;\\(x = 9\\) and \\(x = 5\\)&quot;]">
    <problem>
      <para>\(x^2− 14x + 20 = -25\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.9.2.</para>
    </div>
    </exercise>
  <!--3-->
  <exercise data-content-id="e6e8fb88-e85e-47d0-8e44-736e7880a25f" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x = 10\) and \(x = -4\)" data-solution-options="[&quot;\\(x = -16\\) and \\(x = 10\\)&quot;, &quot;\\(x = 8\\) and \\(x = -8\\)&quot;, &quot;\\(x = 10\\) and \\(x = -4\\)&quot;, &quot;\\(x = -8\\) and \\(x = 5\\)&quot;]">
    <problem>
      <para>\(x^2− 6x − 52 = -12\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.9.2.
      </para>
    </div>
    </exercise>
  <!--4-->
  <exercise data-content-id="e16128f0-fbba-4cb5-b03e-9004f3f6126d" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x = -7\) and \(x = 8\)" data-solution-options="[&quot;\\(x = 8\\) and \\(x = -8\\)&quot;, &quot;\\(x = -7\\) and \\(x = 8\\)&quot;, &quot;\\(x = 28\\) and \\(x = -2\\)&quot;, &quot;\\(x = 4\\) and \\(x = -14\\)&quot;]">
    <problem>
      <para>\(x^2 − x − 64 = -8\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.9.2.</para>
    </div>
    </exercise>
  <!--5-->
  <exercise data-content-id="1f6011d4-4680-4f06-a947-a1a6a4fb9ad4" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x = -3\) and \(x = -6\)" data-solution-options="[&quot;\\(x = -3\\) and \\(x = -6\\)&quot;, &quot;\\(x = -9\\) and \\(x = -2\\)&quot;, &quot;\\(x = 8\\) and \\(x = 1\\)&quot;, &quot;\\(x = 3\\) and \\(x = 6\\)&quot;]">
    <problem>
      <para>\(x^2 + 9x + 13 = -5\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.9.2.</para>
    </div>
    </exercise>
  <!--6-->
  <exercise data-content-id="14506be6-f1cd-4c73-8dc7-1026c3b54b75" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(f(x) = x^2 − 8x + 16\)" data-solution-options="[&quot;\\(f(x) = x^2− 9\\)&quot;, &quot;\\(f(x) = x^2− 13x + 42\\)&quot;, &quot;\\(f(x) = x^2 + 6x + 5\\)&quot;, &quot;\\(f(x) = x^2 − 8x + 16\\)&quot;]">
    <problem>
      <para>Without graphing, identify the function whose graph has only one zero.</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.9.3.</para>
    </div>
    </exercise>
  <!--7-->
  <exercise data-content-id="636fec47-b971-4621-aa0b-ab8977ee1b6b" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(f(x) = x^2+ 12x + 36\)" data-solution-options="[&quot;\\(f(x) = x^2+ 7x − 30\\)&quot;, &quot;\\(f(x) = x^2+ x − 30\\)&quot;, &quot;\\(f(x) = x^2+ 12x + 36\\)&quot;, &quot;\\(f(x) = x^2 − 10x + 9\\)&quot;]">
    <problem>
      <para>Without graphing, identify the function whose graph has only one zero.</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.9.3.
      </para>
    </div>
    </exercise>
  <!--8-->
  <exercise data-content-id="65e14f56-ac7d-46fd-82e9-43eb8625935e" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(f(x) = x^2− 81\)" data-solution-options="[&quot;\\(f(x) = x^2− 81\\)&quot;, &quot;\\(f(x) = x^2− 8x + 16\\)&quot;, &quot;\\(f(x) = x^2+ 8x + 16\\)&quot;, &quot;\\(f(x) = x^2− 12x + 36\\)&quot;]">
    <problem>
      <para>Without graphing, identify the function whose graph has two zeros.</para>
      </problem>
    <solution>
