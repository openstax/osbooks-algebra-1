<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.9.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02239</md:content-id>
    <md:title>8.9.5: Practice</md:title>
    <md:uuid>4f466432-776e-43b1-a130-5a62c5eda591</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <para id="para-00002">For questions 1 – 5, solve each quadratic equation by rewriting it in factored form and using the zero product property.</para>
      <exercise id="_39ac4015-3c0f-469f-9d92-50f25665caf2" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00003"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>11</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>35</m:mn><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
          <para id="para-00004">Multiple Choice:</para>
          <para id="para-00005"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
          <para id="para-00006"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
          <para id="para-00007"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>14</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
          <para id="para-00008"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00009">Try again. Revisit activity 8.9.2.</para>
          <para id="para-00010">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="bc01d2d3-654d-4299-a9bf-ab2cd1a59ca7" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00011"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>14</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>20</m:mn><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>25</m:mn></m:mrow></m:math></para>
          <para id="para-00012">Multiple Choice:</para>
          <para id="para-00013"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>15</m:mn></m:mrow></m:math></para>
          <para id="para-00014"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
          <para id="para-00015"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>10</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
          <para id="para-00016"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00017">Try again. Revisit activity 8.9.2.</para>
          <para id="para-00018">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="e6e8fb88-e85e-47d0-8e44-736e7880a25f" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00019"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>6</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>52</m:mn><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>12</m:mn></m:mrow></m:math></para>
          <para id="para-00020">Multiple Choice:</para>
          <para id="para-00021"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>16</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math></para>
          <para id="para-00022"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
          <para id="para-00023"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
          <para id="para-00024"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00025">Try again. Revisit activity 8.9.2.</para>
          <para id="para-00026">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="e16128f0-fbba-4cb5-b03e-9004f3f6126d" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00027"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>64</m:mn><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
          <para id="para-00028">Multiple Choice:</para>
          <para id="para-00029"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
          <para id="para-00030"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
          <para id="para-00031"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>28</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
          <para id="para-00032"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>14</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00033">Try again. Revisit activity 8.9.2.</para>
          <para id="para-00034">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_1f6011d4-4680-4f06-a947-a1a6a4fb9ad4" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00035"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>13</m:mn><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
          <para id="para-00036">Multiple Choice:</para>
          <para id="para-00037"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
          <para id="para-00038"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
          <para id="para-00039"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
          <para id="para-00040"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00041">Try again. Revisit activity 8.9.2.</para>
          <para id="para-00042">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_14506be6-f1cd-4c73-8dc7-1026c3b54b75" class="multiple-choice">
        <problem id="prob-00006">
          <para id="para-00043">Without graphing, identify the function whose graph has only one zero.</para>
          <para id="para-00044">Multiple Choice:</para>
          <para id="para-00045"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>9</m:mn></m:mrow></m:math></para>
          <para id="para-00046"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>13</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>42</m:mn></m:mrow></m:math></para>
          <para id="para-00047"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
          <para id="para-00048"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>16</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00049">Try again. Revisit activity 8.9.3.</para>
          <para id="para-00050">The correct answer is <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>16</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_636fec47-b971-4621-aa0b-ab8977ee1b6b" class="multiple-choice">
        <problem id="prob-00007">
          <para id="para-00051">Without graphing, identify the function whose graph has only one zero.</para>
          <para id="para-00052">Multiple Choice:</para>
          <para id="para-00053"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>30</m:mn></m:mrow></m:math></para>
          <para id="para-00054"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>30</m:mn></m:mrow></m:math></para>
          <para id="para-00055"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>36</m:mn></m:mrow></m:math></para>
          <para id="para-00056"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>10</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00057">Try again. Revisit activity 8.9.3.</para>
          <para id="para-00058">The correct answer is <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>36</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_65e14f56-ac7d-46fd-82e9-43eb8625935e" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00059">Without graphing, identify the function whose graph has two zeros.</para>
          <para id="para-00060">Multiple Choice:</para>
          <para id="para-00061"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>81</m:mn></m:mrow></m:math></para>
          <para id="para-00062"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>16</m:mn></m:mrow></m:math></para>
          <para id="para-00063"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>16</m:mn></m:mrow></m:math></para>
          <para id="para-00064"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>36</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00065">Try again. Revisit activity 8.9.3.</para>
          <para id="para-00066">The correct answer is <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>81</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="c4a59048-a9e1-4ed7-a225-a804f579731d" class="multiple-choice">
        <problem id="prob-00009">
          <para id="para-00067">Without graphing, identify the function whose graph has two zeros.</para>
          <para id="para-00068">Multiple Choice:</para>
          <para id="para-00069"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>10</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>25</m:mn></m:mrow></m:math></para>
          <para id="para-00070"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>21</m:mn></m:mrow></m:math></para>
          <para id="para-00071"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>16</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>64</m:mn></m:mrow></m:math></para>
          <para id="para-00072"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>14</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>49</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00073">Try again. Revisit activity 8.9.3.</para>
          <para id="para-00074">The correct answer is <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>21</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_39a9a1bd-5d3a-4f62-aeb0-f5ab200dc47c" class="multiple-choice">
        <problem id="prob-00010">
          <para id="para-00075">Solve the equation: <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>18</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>90</m:mn><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math>.</para>
          <para id="para-00076">Multiple Choice:</para>
          <para id="para-00077"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
          <para id="para-00078"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
          <para id="para-00079"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>10</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
          <para id="para-00080"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00081">Try again. Revisit activity 8.9.4.</para>
          <para id="para-00082">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
    </section>
  </content>
