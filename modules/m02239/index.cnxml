  <!--9-->
  <exercise data-content-id="c4a59048-a9e1-4ed7-a225-a804f579731d" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(f(x) = x^2+ 4x − 21\)" data-solution-options="[&quot;\\(f(x) = x^2− 10x + 25\\)&quot;, &quot;\\(f(x) = x^2+ 4x − 21\\)&quot;, &quot;\\(f(x) = x^2+16x + 64\\)&quot;, &quot;\\(f(x) = x^2− 14x + 49\\)&quot;]">
    <problem>
      <para>Without graphing, identify the function whose graph has two zeros.</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.9.3.</para>
