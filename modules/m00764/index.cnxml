<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>3.4.5: Using Correlation Coefficient to Determine Best Fit</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00764</md:content-id>
    <md:title>3.4.5: Using Correlation Coefficient to Determine Best Fit</md:title>
    <md:uuid>01366669-7cb9-4539-8900-cb9b3ef009a9</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Cool Down Activity</title>
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00001">What information does a correlation coefficient tell you about the data in a scatter
            plot? </para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00002">Compare your answer: Your answer may vary, but here is a sample.</para>
          <para id="para-00003">The sign of the correlation coefficient matches the sign of the slope for the best
            fit line. The closer the correlation coefficient value is to 0, the weaker the linear
            relationship. The closer the correlation coefficient is to 1 or –1, the stronger the
            linear relationship. </para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00004">Which value best estimates the value for the correlation coefficient of the scatter
            plot: –1, –0.8, –0.2, 0.2, 0.8, or 1? Be prepared to show your reasoning.</para>
          <media alt="Graph of a scatter plot, xy-plane, origin O.">
            <image mime-type="image/svg+xml" src="../../media/Algebra-1_03_06_12_01.svg"/>
          </media>
        </problem>
        <solution id="sol-00002">
          <para id="para-00005">Compare your answer: Your answer may vary, but here is a sample.</para>
          <para id="para-00006">–0.8, since the points form a fairly strong linear pattern that is decreasing to the
            right</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
    </section>
  </content>
</document>
