<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Analyze Percent Change Over Time</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01208</md:content-id>
    <md:title>Analyze Percent Change Over Time</md:title>
    <md:uuid>856df525-b7be-4e94-90ca-2c30e77c17f5</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><para id="para-00001"><quote id="quote-00001">A cell phone is plugged in to be charged. The table below shows the percent of battery power at a few times after it was plugged in. Use the data to find out. Be prepared to show your reasoning.</quote></para><table class="os-raise-midsizetable" id="table-00001">
  <tgroup cols="2"><tbody><row>
      <entry><emphasis>Time</emphasis></entry><entry><emphasis>Percentage Charged</emphasis></entry></row>
  <row>
      <entry>11:00 a.m.</entry>
      <entry>6%</entry>
    </row>
    <row>
      <entry>11:10 a.m.</entry>
      <entry>15%</entry>
    </row>
    <row>
      <entry>11:30 a.m.</entry>
      <entry>35%</entry>
    </row>
    <row>
      <entry>11:40 a.m.</entry>
      <entry>43%</entry>
    </row>
  </tbody></tgroup></table>

<list list-type="enumerated" id="list-00001"><item>At what time will the battery be 100% charged?</item></list></section>
</content></document>