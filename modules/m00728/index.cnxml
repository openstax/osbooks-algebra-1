      </entry>
    </row>
    <row>
      <entry>
        Goat
      </entry>
      <entry>
        151
      </entry>
      <entry>
        8
      </entry>
    </row>
    <row>
      <entry>
        Lion
      </entry>
      <entry>
        100
      </entry>
      <entry>
        15
      </entry>
    </row>
    <row>
      <entry>
        Sheep
      </entry>
      <entry>
