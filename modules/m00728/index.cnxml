      <entry scope="col" class="emphasis">Animal </entry>
      <entry scope="col" class="emphasis">Gestation Time
        (Days) </entry>
      <entry scope="col" class="emphasis">Longevity
        (Years)</entry>
    </row>
  </thead>
  <tbody>
    <row>
      <entry>
        Baboon
      </entry>
      <entry>
        187
      </entry>
      <entry>
        20
      </entry>
