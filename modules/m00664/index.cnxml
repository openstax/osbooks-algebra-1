  <content>
    <section id="sect-00001">
      <para id="para-00001"><emphasis>Step 1</emphasis> - Examine the following nutrition information for some trail
        mix ingredients.</para>

      <table class="unnumbered os-raise-doubleheadertable unnumbered" id="table-00001">
        <tgroup cols="6" align="center">
<thead>
            <row>
              <entry>
                <emphasis/>
              </entry>
              <entry>
                <emphasis>Calories per gram (kcal)</emphasis>
              </entry>
              <entry>
                <emphasis>Protein per gram (g)</emphasis>
              </entry>
              <entry>
                <emphasis>Sugar per gram (g)</emphasis>
              </entry>
              <entry>
                <emphasis>Fat per Gram (g)</emphasis>
              </entry>
              <entry>
                <emphasis>Fiber per Gram (g)</emphasis>
              </entry>
            </row>
            </thead>
<tbody>
            <row>
              <entry>
                <emphasis>Peanuts</emphasis>
              </entry>
              <entry>5.36</entry>
              <entry>0.21</entry>
              <entry>0.04</entry>
              <entry>0.46</entry>
              <entry>0.07</entry>
            </row>
            <row>
              <entry>
                <emphasis>Almonds</emphasis>
              </entry>
              <entry>5.71</entry>
              <entry>0.18</entry>
              <entry>0.21</entry>
              <entry>0.46</entry>
              <entry>0.07</entry>
            </row>
            <row>
              <entry>
                <emphasis>Raisins</emphasis>
              </entry>
              <entry>3.00</entry>
              <entry>0.03</entry>
              <entry>0.60</entry>
              <entry>0.00</entry>
              <entry>0.05</entry>
            </row>
            <row>
              <entry>
                <emphasis>Chocolate pieces</emphasis>
              </entry>
              <entry>4.76</entry>
              <entry>0.05</entry>
              <entry>0.67</entry>
              <entry>0.19</entry>
              <entry>0.02</entry>
            </row>
            <row>
              <entry>
                <emphasis>Shredded Coconut</emphasis>
              </entry>
              <entry>6.67</entry>
              <entry>0.07</entry>
              <entry>0.07</entry>
              <entry>0.67</entry>
              <entry>0.13</entry>
            </row>
            <row>
              <entry>
                <emphasis>Sunflower Seeds</emphasis>
              </entry>
              <entry>5.50</entry>
