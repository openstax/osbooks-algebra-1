<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.2.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01602</md:content-id>
    <md:title>6.2.6: Practice</md:title>
    <md:uuid>fe917a6b-48df-4670-821c-1f23c3f07916</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
<para id="para-00002">For questions 1 – 8, simplify each expression completely.</para>
<!--Do not edit this div tag.  It must surround the interaction block-->
<section id="sect-00002">
  <exercise id="_797d949c-c062-47f4-b4e6-85ada2754aee" class="multiple-choice"><problem id="prob-00001"><para id="para-00003">\((5h^2)(-3h^2)\)</para>
      <para id="para-00004">Multiple Choice:</para><para id="para-00005">\(-15h^2\)</para><para id="para-00006">\(-15h^4\)</para><para id="para-00007">\(-15h\)</para><para id="para-00008">\(-15h^8\)</para></problem><solution id="sol-00001"><para id="para-00009">Correct! \(-15h^4\)</para><para id="para-00010">Try again. Revisit 6.2.1.</para><para id="para-00011">The correct answer is \(-15h^4\).</para></solution></exercise>
      
      <exercise id="_22618669-f4bc-4be0-92f4-6dff2a78b09b" class="multiple-choice"><problem id="prob-00002"><para id="para-00012">\((-\frac45d^2s^2)(6ds^2)\)</para>
      <para id="para-00013">Multiple Choice:</para><para id="para-00014">\((-\frac{24}{5}d^2s^4)\)</para><para id="para-00015">\((-\frac{24}{30}d^3s^4)\)</para><para id="para-00016">\(-\frac{24}5d^3s^4\)</para><para id="para-00017">\(-\frac{24}{30}d^2s^4\)</para></problem><solution id="sol-00002"><para id="para-00018">Correct! \(-\frac{24}5d^3s^4\)</para><para id="para-00019">Try again. Revisit 6.2.1.
    </para><para id="para-00020">The correct answer is \(-\frac{24}5d^3s^4\).
    </para></solution></exercise>
      
      <exercise id="_0861affa-ea5a-4acb-966e-88432701743a" class="multiple-choice"><problem id="prob-00003"><para id="para-00021">\((n-4)(3n+7)\)</para>
      <para id="para-00022">Multiple Choice:</para><para id="para-00023">\(3n^2-19n+28\)</para><para id="para-00024">\(3n^2-12n+28\)</para><para id="para-00025">\(3n^2-5n-28\)</para><para id="para-00026">\(3n^2+5n-28\)</para></problem><solution id="sol-00003"><para id="para-00027">Try again. Revisit 6.2.2.</para><para id="para-00028">The correct answer is \(3n^2 - 5n - 28\).</para></solution></exercise>
      
      <exercise id="_866b08d7-8240-4892-b78a-1549bcca02fc" class="multiple-choice"><problem id="prob-00004"><para id="para-00029">\((3x^2+3)(7x-5)\)</para>
      </problem><solution id="sol-00004"><para id="para-00030">Try again. Revisit 6.2.2.</para><para id="para-00031">The correct answer is \(21x^3-15x^2+21x-15\).
    </para></solution></exercise>
      
      <exercise id="_6d99c7a7-fabd-4d36-806f-27f6328a41e0" class="multiple-choice"><problem id="prob-00005"><para id="para-00032">\((m-6)(2m^2-7m+8)\)</para>
      <para id="para-00033">Multiple Choice:</para><para id="para-00034">\(2m^3-7m^2+8m\)</para><para id="para-00035">\(-6m^2-42m-48\)</para><para id="para-00036">\(2m^3+19m^2+34m-48\)</para><para id="para-00037">\(2m^3-19m^2+50m-48\)</para></problem><solution id="sol-00005"><para id="para-00038">Try again. Revisit 6.2.3.
    </para><para id="para-00039">The correct answer is \(2m^3-19m^2+50m-48\).
    </para></solution></exercise>
      
      <exercise id="_6d38d9c3-f8f2-40ba-9488-f3b4fed9085d" class="multiple-choice"><problem id="prob-00006"><para id="para-00040">\((c-4)(c^2+5c-9)\)</para>
      <para id="para-00041">Multiple Choice:</para><para id="para-00042">\(c^3+5c^2-9c\)</para><para id="para-00043">\(c^3+c^2-29c+36\)</para><para id="para-00044">\(-4c^2-20c+36\)</para><para id="para-00045">\(-4c^3+c^2-29c+36\)</para></problem><solution id="sol-00006"><para id="para-00046">Try again. Revisit 6.2.3.
    </para><para id="para-00047">The correct answer is \(c^3+c^2-29c+36\).
    </para></solution></exercise>
      
      <exercise id="_8082a1a0-6da7-40f9-a7b3-24a712a76dec" class="multiple-choice"><problem id="prob-00007"><para id="para-00048">\((5x - 3)^2\)</para>
      </problem><solution id="sol-00007"><para id="para-00049">Try again. Revisit 6.2.4.
    </para><para id="para-00050">The correct answer is \(25x^2-30x+9\).
    </para></solution></exercise>
      
      <exercise id="c866048d-acb4-4e6b-98ee-bd95bb66069b" class="multiple-choice"><problem id="prob-00008"><para id="para-00051">\((11z + 7)(11z - 7)\)</para>
      <para id="para-00052">Multiple Choice:</para><para id="para-00053">\(121z^2-144z-49\)</para><para id="para-00054">\(121z^2-49\)</para><para id="para-00055">\(121z^2+144z-49\)</para><para id="para-00056">\(121z^2+49\)</para></problem><solution id="sol-00008"><para id="para-00057">Try again. Revisit 6.2.4.
    </para><para id="para-00058">The correct answer is \(121z^2-49\).
    </para></solution></exercise>
      
      <exercise id="_5dd80329-2e0f-428e-8f8a-0e32a84d0eb0" class="multiple-choice"><problem id="prob-00009"><para id="para-00059">For questions 9–10, use the following polynomial functions.</para><para id="para-00060">\(f(x) = 5x + 4v\)</para>
        <para id="para-00061">\(g(x) = 5x - 4v\)</para>
      <para id="para-00062">\(f(x) \cdot g(x)\)</para>
      <para id="para-00063">Multiple Choice:</para><para id="para-00064">\(25x^2+16v^2\)</para><para id="para-00065">\(25x^2-40xv+16v^2\)</para><para id="para-00066">\(25x^2+40xv+16v^2\)</para><para id="para-00067">\(25x^2-16v^2\)</para></problem><solution id="sol-00009"><para id="para-00068">Try again. Revisit 6.2.5.
    </para><para id="para-00069">The correct answer is \(25x^2-16v^2\).
    </para></solution></exercise>
      
      <exercise id="_973dfbb1-bf56-4e2e-884b-03bcb7a37d92" class="multiple-choice"><problem id="prob-00010"><para id="para-00070">\(f(x) \cdot f(x)\)</para>
      <para id="para-00071">Multiple Choice:</para><para id="para-00072">\(25x^2+16v^2\)</para><para id="para-00073">\(25x^2-40xv+16v^2\)</para><para id="para-00074">\(25x^2+40xv+16v^2\)</para><para id="para-00075">\(25x^2-16v^2\)</para></problem><solution id="sol-00010"><para id="para-00076">Try again. Revisit 6.2.5.
    </para><para id="para-00077">The correct answer is \(25x^2+40xv+16v^2\).
    </para></solution></exercise>
    </section></section>
</content>
