<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.2.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01602</md:content-id>
    <md:title>6.2.6: Practice</md:title>
    <md:uuid>fe917a6b-48df-4670-821c-1f23c3f07916</md:uuid>
  </metadata>
  <content>
  <section class="practice" id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
<para id="para-00002">For questions 1 – 8, simplify each expression completely.</para>
<!--Do not edit this div tag.  It must surround the interaction block-->
<section id="sect-00002">
  <exercise id="_797d949c-c062-47f4-b4e6-85ada2754aee" class="multiple-choice"><problem id="prob-00001"><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00004">Multiple Choice:</para><para><m:math><m:mrow><m:mo>−</m:mo><m:mn>15</m:mn><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mo>−</m:mo><m:mn>15</m:mn><m:msup><m:mi>h</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mo>−</m:mo><m:mn>15</m:mn><m:mi>h</m:mi></m:mrow></m:math></para><para><m:math><m:mrow><m:mo>−</m:mo><m:mn>15</m:mn><m:msup><m:mi>h</m:mi><m:mn>8</m:mn></m:msup></m:mrow></m:math></para></problem><solution id="sol-00001"><para id="para-00009">Correct! <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>15</m:mn><m:msup><m:mi>h</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:math></para><para id="para-00010">Try again. Revisit 6.2.1.</para><para id="para-00011">The correct answer is <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>15</m:mn><m:msup><m:mi>h</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_22618669-f4bc-4be0-92f4-6dff2a78b09b" class="multiple-choice"><problem id="prob-00002"><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac><m:msup><m:mi>d</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>s</m:mi><m:mn>2</m:mn></m:msup><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mi>d</m:mi><m:msup><m:mi>s</m:mi><m:mn>2</m:mn></m:msup><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00013">Multiple Choice:</para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>24</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac><m:msup><m:mi>d</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>s</m:mi><m:mn>4</m:mn></m:msup><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>24</m:mn></m:mrow><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac><m:msup><m:mi>d</m:mi><m:mn>3</m:mn></m:msup><m:msup><m:mi>s</m:mi><m:mn>4</m:mn></m:msup><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>24</m:mn></m:mrow><m:mn>5</m:mn></m:mfrac><m:msup><m:mi>d</m:mi><m:mn>3</m:mn></m:msup><m:msup><m:mi>s</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>24</m:mn></m:mrow><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac><m:msup><m:mi>d</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>s</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:math></para></problem><solution id="sol-00002"><para id="para-00018">Correct! <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>24</m:mn></m:mrow><m:mn>5</m:mn></m:mfrac><m:msup><m:mi>d</m:mi><m:mn>3</m:mn></m:msup><m:msup><m:mi>s</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:math></para><para id="para-00019">Try again. Revisit 6.2.1.
    </para><para id="para-00020">The correct answer is <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>24</m:mn></m:mrow><m:mn>5</m:mn></m:mfrac><m:msup><m:mi>d</m:mi><m:mn>3</m:mn></m:msup><m:msup><m:mi>s</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_0861affa-ea5a-4acb-966e-88432701743a" class="multiple-choice"><problem id="prob-00003"><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00022">Multiple Choice:</para><para><m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>19</m:mn><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>28</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>12</m:mn><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>28</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>28</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>28</m:mn></m:mrow></m:math></para></problem><solution id="sol-00003"><para id="para-00027">Try again. Revisit 6.2.2.</para><para id="para-00028">The correct answer is <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>28</m:mn></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_866b08d7-8240-4892-b78a-1549bcca02fc" class="multiple-choice"><problem id="prob-00004"><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00004"><para id="para-00030">Try again. Revisit 6.2.2.</para><para id="para-00031">The correct answer is <m:math display="inline"><m:mrow><m:mn>21</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>−</m:mo><m:mn>15</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>21</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>15</m:mn></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_6d99c7a7-fabd-4d36-806f-27f6328a41e0" class="multiple-choice"><problem id="prob-00005"><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>m</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>7</m:mn><m:mi>m</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00033">Multiple Choice:</para><para><m:math><m:mrow><m:mn>2</m:mn><m:msup><m:mi>m</m:mi><m:mn>3</m:mn></m:msup><m:mo>−</m:mo><m:mn>7</m:mn><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>m</m:mi></m:mrow></m:math></para><para><m:math><m:mrow><m:mo>−</m:mo><m:mn>6</m:mn><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>42</m:mn><m:mi>m</m:mi><m:mo>−</m:mo><m:mn>48</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>2</m:mn><m:msup><m:mi>m</m:mi><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:mn>19</m:mn><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>34</m:mn><m:mi>m</m:mi><m:mo>−</m:mo><m:mn>48</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>2</m:mn><m:msup><m:mi>m</m:mi><m:mn>3</m:mn></m:msup><m:mo>−</m:mo><m:mn>19</m:mn><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>50</m:mn><m:mi>m</m:mi><m:mo>−</m:mo><m:mn>48</m:mn></m:mrow></m:math></para></problem><solution id="sol-00005"><para id="para-00038">Try again. Revisit 6.2.3.
    </para><para id="para-00039">The correct answer is <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:msup><m:mi>m</m:mi><m:mn>3</m:mn></m:msup><m:mo>−</m:mo><m:mn>19</m:mn><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>50</m:mn><m:mi>m</m:mi><m:mo>−</m:mo><m:mn>48</m:mn></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_6d38d9c3-f8f2-40ba-9488-f3b4fed9085d" class="multiple-choice"><problem id="prob-00006"><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>c</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:msup><m:mi>c</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>c</m:mi><m:mo>−</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00041">Multiple Choice:</para><para><m:math><m:mrow><m:msup><m:mi>c</m:mi><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn><m:msup><m:mi>c</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>9</m:mn><m:mi>c</m:mi></m:mrow></m:math></para><para><m:math><m:mrow><m:msup><m:mi>c</m:mi><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:msup><m:mi>c</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>29</m:mn><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>36</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mo>−</m:mo><m:mn>4</m:mn><m:msup><m:mi>c</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>20</m:mn><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>36</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mo>−</m:mo><m:mn>4</m:mn><m:msup><m:mi>c</m:mi><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:msup><m:mi>c</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>29</m:mn><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>36</m:mn></m:mrow></m:math></para></problem><solution id="sol-00006"><para id="para-00046">Try again. Revisit 6.2.3.
    </para><para id="para-00047">The correct answer is <m:math display="inline"><m:mrow><m:msup><m:mi>c</m:mi><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:msup><m:mi>c</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>29</m:mn><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>36</m:mn></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_8082a1a0-6da7-40f9-a7b3-24a712a76dec" class="multiple-choice"><problem id="prob-00007"><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para></problem><solution id="sol-00007"><para id="para-00049">Try again. Revisit 6.2.4.
    </para><para id="para-00050">The correct answer is <m:math display="inline"><m:mrow><m:mn>25</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>30</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="c866048d-acb4-4e6b-98ee-bd95bb66069b" class="multiple-choice"><problem id="prob-00008"><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>11</m:mn><m:mi>z</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>11</m:mn><m:mi>z</m:mi><m:mo>−</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00052">Multiple Choice:</para><para><m:math><m:mrow><m:mn>121</m:mn><m:msup><m:mi>z</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>144</m:mn><m:mi>z</m:mi><m:mo>−</m:mo><m:mn>49</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>121</m:mn><m:msup><m:mi>z</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>49</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>121</m:mn><m:msup><m:mi>z</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>144</m:mn><m:mi>z</m:mi><m:mo>−</m:mo><m:mn>49</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>121</m:mn><m:msup><m:mi>z</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>49</m:mn></m:mrow></m:math></para></problem><solution id="sol-00008"><para id="para-00057">Try again. Revisit 6.2.4.
    </para><para id="para-00058">The correct answer is <m:math display="inline"><m:mrow><m:mn>121</m:mn><m:msup><m:mi>z</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>49</m:mn></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_5dd80329-2e0f-428e-8f8a-0e32a84d0eb0" class="multiple-choice"><problem id="prob-00009"><para id="para-00059">For questions 9–10, use the following polynomial functions.</para><para><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>v</m:mi></m:mrow></m:math></para><para><m:math><m:mrow><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>v</m:mi></m:mrow></m:math></para><para><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mi>·</m:mi><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00063">Multiple Choice:</para><para><m:math><m:mrow><m:mn>25</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>16</m:mn><m:msup><m:mi>v</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>25</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>40</m:mn><m:mi>x</m:mi><m:mi>v</m:mi><m:mo>+</m:mo><m:mn>16</m:mn><m:msup><m:mi>v</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>25</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>40</m:mn><m:mi>x</m:mi><m:mi>v</m:mi><m:mo>+</m:mo><m:mn>16</m:mn><m:msup><m:mi>v</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>25</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>16</m:mn><m:msup><m:mi>v</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para></problem><solution id="sol-00009"><para id="para-00068">Try again. Revisit 6.2.5.
    </para><para id="para-00069">The correct answer is <m:math display="inline"><m:mrow><m:mn>25</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>16</m:mn><m:msup><m:mi>v</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_973dfbb1-bf56-4e2e-884b-03bcb7a37d92" class="multiple-choice"><problem id="prob-00010"><para><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mi>·</m:mi><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00071">Multiple Choice:</para><para><m:math><m:mrow><m:mn>25</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>16</m:mn><m:msup><m:mi>v</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>25</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>40</m:mn><m:mi>x</m:mi><m:mi>v</m:mi><m:mo>+</m:mo><m:mn>16</m:mn><m:msup><m:mi>v</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>25</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>40</m:mn><m:mi>x</m:mi><m:mi>v</m:mi><m:mo>+</m:mo><m:mn>16</m:mn><m:msup><m:mi>v</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>25</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>16</m:mn><m:msup><m:mi>v</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para></problem><solution id="sol-00010"><para id="para-00076">Try again. Revisit 6.2.5.
    </para><para id="para-00077">The correct answer is <m:math display="inline"><m:mrow><m:mn>25</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>40</m:mn><m:mi>x</m:mi><m:mi>v</m:mi><m:mo>+</m:mo><m:mn>16</m:mn><m:msup><m:mi>v</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>.
    </para></solution></exercise>
