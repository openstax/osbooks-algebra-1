                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <exercise id="_890a1cc8-6178-4361-910f-b9f1fd5ef70d" class="multiple-choice">
        <problem id="prob-00010">

          <para id="para-00030">b. Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-value of the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept of the graph.</para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00031">Correct! 0, Graph of <m:math display="inline">
              <m:mrow>
                <m:mi>k</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00032">The correct answer is 0, Graph of <m:math display="inline">
              <m:mrow>
                <m:mi>k</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <para id="para-00086">6. Function <m:math display="inline">
          <m:mrow>
            <m:mi>l</m:mi>
          </m:mrow>
        </m:math>
    <m:math display="inline">
          <m:mrow>
            <m:msup>
              <m:mi>x</m:mi>
              <m:mn>2</m:mn>
            </m:msup>
            <m:mo>+</m:mo>
            <m:mn>4</m:mn>
            <m:mi>x</m:mi>
            <m:mo>+</m:mo>
            <m:mn>4</m:mn>
          </m:mrow>
        </m:math>
    <m:math display="inline">
          <m:mrow>
            <m:mo stretchy="false">(</m:mo>
            <m:mi>x</m:mi>
            <m:mo>+</m:mo>
            <m:mn>2</m:mn>
            <m:mo stretchy="false">)</m:mo>
            <m:mo stretchy="false">(</m:mo>
            <m:mi>x</m:mi>
            <m:mo>+</m:mo>
            <m:mn>2</m:mn>
            <m:mo stretchy="false">)</m:mo>
          </m:mrow>
        </m:math></para>

      <media alt="A parabola on a coordinate grid. The x-axis scale is 1 and extends from negative 6 to 6. The y-axis scale is 1 and extends from negative 2 to 8.">
        <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_12_06_06.svg" />
      </media>
      <exercise id="_91e3b870-5ded-41d7-b8b2-0d67ab29631a" class="multiple-choice">
        <problem id="prob-00011">

          <para id="para-00033">a. Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercept of the graph. <emphasis> Answer: </emphasis>  </para>
        </problem>
        <solution id="sol-00011">
          <para id="para-00034">Correct! – 2, Graph of <m:math display="inline">
              <m:mrow>
                <m:mi>l</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercept <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>−</m:mo>
                <m:mn>2</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00035">The correct answer is – 2. Graph of <m:math display="inline">
              <m:mrow>
                <m:mi>l</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercept <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>−</m:mo>
                <m:mn>2</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <exercise id="d8582297-86cb-47b6-9ce1-c1e401c54266" class="multiple-choice">
        <problem id="prob-00012">

          <para id="para-00036">b. Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-value of the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept of the graph.</para>
        </problem>
        <solution id="sol-00012">
          <para id="para-00037">Correct! Graph of <m:math display="inline">
              <m:mrow>
                <m:mi>l</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>4</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00038">The correct answer is 4. Graph of <m:math display="inline">
              <m:mrow>
                <m:mi>l</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>4</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>

      <exercise id="exer-00006">
        <problem id="prob-00013">
          <para id="para-00039">7. What do you notice about the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts, the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept, and the numbers in the expressions defining each function? Make a couple of observations.</para>
          <para id="para-00040">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00013">
          <para id="para-00041">Compare your answer: </para>
          <list id="list-00007">
            <item>The <m:math display="inline">
                <m:mrow>
                  <m:mi>y</m:mi>
                </m:mrow>
              </m:math>-coordinate of the <m:math display="inline">
                <m:mrow>
                  <m:mi>y</m:mi>
                </m:mrow>
              </m:math>-intercept is the constant term when the function is expressed in standard form. The <m:math display="inline">
                <m:mrow>
                  <m:mi>y</m:mi>
                </m:mrow>
              </m:math>-intercept is <m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mn>0</m:mn>
                  <m:mo>,</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>9</m:mn>
                  <m:mo stretchy="false">)</m:mo>
                </m:mrow>
              </m:math> for the function <m:math display="inline">
                <m:mrow>
                  <m:mi>h</m:mi>
                </m:mrow>
              </m:math>, <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>−</m:mo>
                  <m:mn>9</m:mn>
                </m:mrow>
              </m:math>.</item>
            <item>The <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                </m:mrow>
              </m:math>-intercepts in each graph seem to match the numbers in the factors of the expressions in factored form, but the signs seem to be the opposite. For example, when the expression is <m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mi>x</m:mi>
                  <m:mo>+</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mi>x</m:mi>
                  <m:mo>+</m:mo>
                  <m:mn>1</m:mn>
                  <m:mo stretchy="false">)</m:mo>
                </m:mrow>
              </m:math>, the <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                </m:mrow>
              </m:math>-intercepts are <m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo>,</m:mo>
                  <m:mn>0</m:mn>
                  <m:mo stretchy="false">)</m:mo>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>1</m:mn>
                  <m:mo>,</m:mo>
                  <m:mn>0</m:mn>
                  <m:mo stretchy="false">)</m:mo>
                </m:mrow>
              </m:math>.</item>
            <item>When one of the factors is just a variable (rather than a sum or a difference), one of the <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                </m:mrow>
              </m:math>-intercepts is <m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mn>0</m:mn>
                  <m:mo>,</m:mo>
                  <m:mn>0</m:mn>
                  <m:mo stretchy="false">)</m:mo>
                </m:mrow>
              </m:math>. For the function <m:math display="inline">
                <m:mrow>
                  <m:mi>i</m:mi>
                </m:mrow>
              </m:math>, <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mi>x</m:mi>
                  <m:mo>−</m:mo>
                  <m:mn>5</m:mn>
                  <m:mo stretchy="false">)</m:mo>
                </m:mrow>
              </m:math>, one of the intercepts is <m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mn>0</m:mn>
                  <m:mo>,</m:mo>
                  <m:mn>0</m:mn>
                  <m:mo stretchy="false">)</m:mo>
                </m:mrow>
              </m:math>.</item>
            <item>x(x-5) and x(5-x) have the same <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                </m:mrow>
              </m:math>-intercepts, but one graph opens upward and the other opens downward. </item>
            <item>When the two factors are the same, there is only one <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                </m:mrow>
              </m:math>-intercept. For the function <m:math display="inline">
                <m:mrow>
                  <m:mi>l</m:mi>
                </m:mrow>
              </m:math>, <m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mi>x</m:mi>
                  <m:mo>+</m:mo>
                  <m:mn>2</m:mn>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mi>x</m:mi>
                  <m:mo>+</m:mo>
                  <m:mn>2</m:mn>
                  <m:mo stretchy="false">)</m:mo>
                </m:mrow>
              </m:math>, – 2 is the <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                </m:mrow>
              </m:math>-intercept.</item>
          </list>
        </solution>
      </exercise>

      <para id="para-00087">8. Here is an expression that models function <m:math display="inline">
          <m:mrow>
            <m:mi>p</m:mi>
          </m:mrow>
        </m:math>, another quadratic function: <m:math display="inline">
          <m:mrow>
            <m:mo stretchy="false">(</m:mo>
            <m:mi>x</m:mi>
            <m:mo>−</m:mo>
            <m:mn>9</m:mn>
            <m:mo stretchy="false">)</m:mo>
            <m:mo stretchy="false">(</m:mo>
            <m:mi>x</m:mi>
            <m:mo>−</m:mo>
            <m:mn>1</m:mn>
            <m:mo stretchy="false">)</m:mo>
          </m:mrow>
        </m:math>.</para>
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00007">
        <problem id="prob-00014">
          <para id="para-00042">a. Predict the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts of the graph that represents this function.</para>

        </problem>
        <solution id="sol-00014">
          <para id="para-00043">Compare your answer: </para>
          <para id="para-00044">The <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts will be <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>9</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math> and <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>1</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <exercise id="c7f9f4d6-6cff-4424-897a-2c5368a6ce76" class="multiple-choice">
        <problem id="prob-00015">

          <para id="para-00045">b. Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-value of the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept of the graph that represents this function.</para>
        </problem>
        <solution id="sol-00015">
          <para id="para-00046">Correct! The <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept will be <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>9</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math> because 9 is the constant term when the expression is put in standard form.</para>
          <para id="para-00047">The correct answer is 9. The <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept will be <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>9</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math> because 9 is the constant term when the expression is put in standard form.</para>
        </solution>
      </exercise>

      <section id="sect-00003">
        <title> Video: Determining the <emphasis effect="italics">x</emphasis>- and <emphasis effect="italics">y</emphasis>-intercepts of Quadratic Expressions </title>
        <para id="para-00048">Watch the following video to learn more about the <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
            </m:mrow>
          </m:math>- and <m:math display="inline">
            <m:mrow>
              <m:mi>y</m:mi>
            </m:mrow>
          </m:math>-intercepts of quadratic expressions.</para>
        <media alt="Placeholder for Alt Text">
          <iframe width="660" height="371.4" src="https://k12.openstax.org/contents/raise/resources/30c97217de33b541ddaa8d862086fcf589af8285" />
        </media>
      </section>
      <!-- "Start "Are you Ready for More? click to reveal.  If you have more than one on a page, you
    will need to change the Data-fire/data-wait-for-events for each set.-->

      <section id="sect-00004">
        <title>Are you ready for more?</title>
        <section class="numbered-exercises" id="sect-00005">
          <title>Extending Your Thinking</title>

          <!--Start
        interaction.  If multiple interactions appear under "are you ready for more?, they should all
        have matching "data-wait-for-event", which should also match the "data-fire-event" for the
        button. Note in this sample, they are all RFM1-->
          <exercise class="RFM1" id="exer-00008">
            <problem id="prob-00016">
              <para id="para-00049">Find the values of <m:math display="inline">
                  <m:mrow>
                    <m:mi>a</m:mi>
                  </m:mrow>
                </m:math>, <m:math display="inline">
                  <m:mrow>
                    <m:mi>p</m:mi>
                  </m:mrow>
                </m:math>, and <m:math display="inline">
                  <m:mrow>
                    <m:mi>q</m:mi>
                  </m:mrow>
                </m:math> that will make <m:math display="inline">
                  <m:mrow>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mi>a</m:mi>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mi>x</m:mi>
                    <m:mo>−</m:mo>
                    <m:mi>p</m:mi>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mi>x</m:mi>
                    <m:mo>−</m:mo>
                    <m:mi>q</m:mi>
                    <m:mo stretchy="false">)</m:mo>
                  </m:mrow>
                </m:math> be the equation represented by the graph.</para>
                <media alt="A parabola on a coordinate grid. The x-axis scale is 1 and extends from negative 2 to 6. The y-axis scale is 1 and extends from negative 4 to 8.">
                  <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_12_06_07.svg" />
                </media>
              <para id="para-00051">What is the value of <m:math display="inline">
                  <m:mrow>
                    <m:mi>a</m:mi>
                  </m:mrow>
                </m:math>?</para>

            <para id="para-0051">What is the value of <m:math display="inline">
                <m:mrow><m:mi>a</m:mi></m:mrow>
              </m:math>?</para>

          </problem>
          <solution id="sol-00016">
            <para id="para-00052">Compare your answer: </para>
            <para id="para-00053"><m:math>
                <m:mrow>
                  <m:mi>a</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>2</m:mn>
                </m:mrow>
              </m:math></para>
          </solution>
        </exercise>
        <!--End
        interaction-->
          <exercise class="RFM1" id="exer-00009">
            <problem id="prob-00017">
              <para id="para-00054">Find the values of <m:math display="inline">
                  <m:mrow>
                    <m:mi>a</m:mi>
                  </m:mrow>
                </m:math>, <m:math display="inline">
                  <m:mrow>
                    <m:mi>p</m:mi>
                  </m:mrow>
                </m:math>, and <m:math display="inline">
                  <m:mrow>
                    <m:mi>q</m:mi>
                  </m:mrow>
                </m:math> that will make <m:math display="inline">
                  <m:mrow>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mi>a</m:mi>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mi>x</m:mi>
                    <m:mo>−</m:mo>
                    <m:mi>p</m:mi>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mi>x</m:mi>
                    <m:mo>−</m:mo>
                    <m:mi>q</m:mi>
                    <m:mo stretchy="false">)</m:mo>
                  </m:mrow>
                </m:math> be the equation represented by the graph.</para>
                <media alt="A parabola on a coordinate grid. The x-axis scale is 1 and extends from negative 2 to 6. The y-axis scale is 1 and extends from negative 4 to 8.">
                  <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_12_06_08.svg" />
                </media>

              <para id="para-00056">What is the value of <m:math display="inline">
                  <m:mrow>
                    <m:mi>p</m:mi>
                  </m:mrow>
                </m:math>?</para>

            </problem>
            <solution id="sol-00017">
              <para id="para-00057">Compare your answer:</para>
              <para id="para-00058"><m:math display="inline">
                  <m:mrow>
                    <m:mi>p</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>1</m:mn>
                  </m:mrow>
                </m:math> or <m:math display="inline">
                  <m:mrow>
                    <m:mi>p</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>3</m:mn>
                  </m:mrow>
                </m:math></para>
            </solution>
          </exercise>
  
        <!--End
        interaction-->
          <exercise class="RFM1" id="exer-00010">
            <problem id="prob-00018">
              <para id="para-00059">Find the values of <m:math display="inline">
                  <m:mrow>
                    <m:mi>a</m:mi>
                  </m:mrow>
                </m:math>, <m:math display="inline">
                  <m:mrow>
                    <m:mi>p</m:mi>
                  </m:mrow>
                </m:math>, and <m:math display="inline">
                  <m:mrow>
                    <m:mi>q</m:mi>
                  </m:mrow>
                  <m:mrow>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mi>a</m:mi>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mi>x</m:mi>
                    <m:mo>−</m:mo>
                    <m:mi>p</m:mi>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mi>x</m:mi>
                    <m:mo>−</m:mo>
                    <m:mi>q</m:mi>
                    <m:mo stretchy="false">)</m:mo>
                  </m:mrow>
                </m:math> be the equation represented by the graph.</para>
                <media alt="A parabola on a coordinate grid. The x-axis scale is 1 and extends from negative 2 to 6. The y-axis scale is 1 and extends from negative 4 to 8.">
                  <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_12_06_09.svg" />
                </media>

              <para id="para-00061">What is the value of <m:math display="inline">
                  <m:mrow>
                    <m:mi>q</m:mi>
                  </m:mrow>
                </m:math> ?</para>

          </problem>
          <solution id="sol-00018">
            <para id="para-00062">Compare your answer: </para>
            <para id="para-00063"><m:math display="inline">
                <m:mrow>
                  <m:mi>q</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>1</m:mn>
                </m:mrow>
              </m:math> or <m:math display="inline">
                <m:mrow>
                  <m:mi>q</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:math></para>
          </solution>
        </exercise>
        <!--End
        interaction-->
        </section>
      </section>
      <note class="self-check" id="note-00001">
        <exercise id="exer-00012">
          <problem id="prob-00020">
            <para id="para-00064"><link class="os-embed" url="#exercise/Alg1_7_10_3_SC" /></para>
          </problem>
        </exercise>
      </note>

      <section id="sect-00002">
        <title>Additional Resources</title>
        <section id="sect-00006">
          <title>Finding <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts Without Graphs</title>
          <para id="para-00066">When a quadratic is in factored form, the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts of a quadratic equation will be:</para>
          <list id="list-00009">
            <item>the opposite sign of the constant in the factor because if <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>+</m:mo>
                  <m:mi>a</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>0</m:mn>
                </m:mrow>
              </m:math> , then <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mi>–</m:mi>
                  <m:mi>a</m:mi>
                </m:mrow>
              </m:math>.</item>
            <item><m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>0</m:mn>
                </m:mrow>
              </m:math> is an option.</item>
            <item>If a factor is repeated, there is only one <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                </m:mrow>
              </m:math>-intercept.</item>
          </list>
          <para id="para-00067"><emphasis>Example</emphasis></para>
          <para id="para-00068">Find the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts of <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>−</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00069">The <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts occur when <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mo>=</m:mo>
                <m:mn>0</m:mn>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00070">Set each factor to 0 and solve.</para>
          <para id="para-00071"><m:math>
              <m:mrow>
                <m:mi>x</m:mi>
                <m:mo>−</m:mo>
                <m:mn>3</m:mn>
                <m:mo>=</m:mo>
                <m:mn>0</m:mn>
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
                <m:mo>=</m:mo>
                <m:mn>0</m:mn>
                <m:mspace linebreak="newline" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mi>x</m:mi>
                <m:mspace width="0.278em" />
                <m:mo>=</m:mo>
                <m:mspace width="0.278em" />
                <m:mn>3</m:mn>
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mspace width="0.278em" />
                <m:mi>x</m:mi>
                <m:mspace width="0.278em" />
                <m:mo>=</m:mo>
                <m:mspace width="0.278em" />
                <m:mi>–</m:mi>
                <m:mspace width="0.278em" />
                <m:mn>2</m:mn>
              </m:mrow>
            </m:math></para>
          <para id="para-00072">Notice that for the factor <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>−</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math> or <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>−</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>−</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>), the constant is – 3, so the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercept is <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
                <m:mo>=</m:mo>
                <m:mo>+</m:mo>
                <m:mn>3</m:mn>
              </m:mrow>
            </m:math> or the point <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>3</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00073">For the factor <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>, the constant is <m:math display="inline">
              <m:mrow>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
              </m:mrow>
            </m:math>, so the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercept is <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
                <m:mo>=</m:mo>
                <m:mi>–</m:mi>
                <m:mn>2</m:mn>
              </m:mrow>
            </m:math> or the point <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>−</m:mo>
                <m:mn>2</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
          <note class="try" id="note-00002">
            <title>Try It: Finding <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                </m:mrow>
              </m:math>-intercepts Without Graphs</title>
        
        <exercise id="exer-00011">
              <problem id="prob-00019">

                <para id="para-00074">Find the <m:math display="inline">
                    <m:mrow>
                      <m:mi>x</m:mi>
                    </m:mrow>
                  </m:math>-intercepts of <m:math display="inline">
                    <m:mrow>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mi>x</m:mi>
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>5</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                    </m:mrow>
                  </m:math> .</para>

                <para id="para-00075">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>

              </problem>
              <solution id="sol-00019">
                <para id="para-00076">Here is how to find the <m:math display="inline">
                    <m:mrow>
                      <m:mi>x</m:mi>
                    </m:mrow>
                  </m:math>-intercepts:</para>

                <para id="para-00077">The <m:math display="inline">
                    <m:mrow>
                      <m:mi>x</m:mi>
                    </m:mrow>
                  </m:math>-intercepts occur when <m:math display="inline">
                    <m:mrow>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>0</m:mn>
                    </m:mrow>
                  </m:math>.</para>

                <para id="para-00078">Set each factor to 0 and solve.</para>

                <para id="para-00079"><m:math>
                    <m:mrow>
                      <m:mi>x</m:mi>
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                      <m:mspace width="0.278em" />
                      <m:mo>=</m:mo>
                      <m:mn>0</m:mn>
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>5</m:mn>
                      <m:mo>=</m:mo>
                      <m:mn>0</m:mn>
                      <m:mspace linebreak="newline" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mi>x</m:mi>
                      <m:mspace width="0.278em" />
                      <m:mo>=</m:mo>
                      <m:mspace width="0.278em" />
                      <m:mn>1</m:mn>
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mspace width="0.278em" />
                      <m:mi>x</m:mi>
                      <m:mspace width="0.278em" />
                      <m:mo>=</m:mo>
                      <m:mspace width="0.278em" />
                      <m:mi>–</m:mi>
                      <m:mspace width="0.278em" />
                      <m:mn>5</m:mn>
                    </m:mrow>
                  </m:math></para>
                <para id="para-00080">Notice that for the factor <m:math display="inline">
                    <m:mrow>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mi>x</m:mi>
                      <m:mo>−</m:mo>
                      <m:mn>3</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                    </m:mrow>
                  </m:math> or <m:math display="inline">
                    <m:mrow>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mi>x</m:mi>
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                    </m:mrow>
                  </m:math>), the constant is – 1, so the <m:math display="inline">
                    <m:mrow>
                      <m:mi>x</m:mi>
                    </m:mrow>
                  </m:math>-intercept is <m:math display="inline">
                    <m:mrow>
                      <m:mi>x</m:mi>
                      <m:mo>=</m:mo>
                      <m:mo>+</m:mo>
                      <m:mn>1</m:mn>
                    </m:mrow>
                  </m:math> or the point <m:math display="inline">
                    <m:mrow>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mn>1</m:mn>
                      <m:mo>,</m:mo>
                      <m:mn>0</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                    </m:mrow>
                  </m:math> .</para>

                <para id="para-00081">For the factor <m:math display="inline">
                    <m:mrow>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>5</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                    </m:mrow>
                  </m:math>, the constant is +5, so the <m:math display="inline">
                    <m:mrow>
                      <m:mi>x</m:mi>
                    </m:mrow>
                  </m:math>-intercept is <m:math display="inline">
                    <m:mrow>
                      <m:mi>x</m:mi>
                      <m:mo>=</m:mo>
                      <m:mi>–</m:mi>
                      <m:mn>5</m:mn>
                    </m:mrow>
                  </m:math> or the point <m:math display="inline">
                    <m:mrow>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>5</m:mn>
                      <m:mo>,</m:mo>
                      <m:mn>0</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                    </m:mrow>
                  </m:math> .</para>

              </solution>
            </exercise></note>
        </section>
      </section>
    </section>
  </content>
</document>