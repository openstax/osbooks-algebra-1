<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>7.10.3: The <emphasis effect="italics">x</emphasis>- and <emphasis effect="italics">y</emphasis>-intercepts of Quadratic Expressions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01907</md:content-id>
    <md:title>7.10.3: The X- and Y-Intercepts of Quadratic Expressions</md:title>
    <md:uuid>55abafa1-c8ec-464f-ab9b-4109464f7f1c</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Activity</title>
      <para id="para-00001">Here are pairs of expressions in standard and factored forms. Each pair of expressions define the same quadratic function, which can be represented with the given graph.</para>
      <para id="para-00002">Identify the <m:math display="inline">
          <m:mrow>
            <m:mi>x</m:mi>
          </m:mrow>
        </m:math>-intercepts and the <m:math display="inline">
          <m:mrow>
            <m:mi>y</m:mi>
          </m:mrow>
        </m:math>-intercept of each graph.</para>
      <para id="para-00065">1. Function <m:math display="inline">
          <m:mrow>
            <m:mi>f</m:mi>
          </m:mrow>
        </m:math>
    <m:math display="inline">
          <m:mrow>
            <m:msup>
              <m:mi>x</m:mi>
              <m:mn>2</m:mn>
            </m:msup>
            <m:mo>+</m:mo>
            <m:mn>4</m:mn>
            <m:mi>x</m:mi>
            <m:mo>+</m:mo>
            <m:mn>3</m:mn>
          </m:mrow>
        </m:math>
    <m:math display="inline">
          <m:mrow>
            <m:mo stretchy="false">(</m:mo>
            <m:mi>x</m:mi>
            <m:mo>+</m:mo>
            <m:mn>3</m:mn>
            <m:mo stretchy="false">)</m:mo>
            <m:mo stretchy="false">(</m:mo>
            <m:mi>x</m:mi>
            <m:mo>+</m:mo>
            <m:mn>1</m:mn>
            <m:mo stretchy="false">)</m:mo>
          </m:mrow>
        </m:math></para>

      <media alt="A parabola on a coordinate grid. The x-axis scale is 1 and extends from negative 5 to 6. The y-axis scale is 1 and extends from negative 5 to 5.">
        <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_12_06_01.svg" />
      </media>
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00003">a. Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts of the graph.</para>

        </problem>
        <solution id="sol-00001">
          <para id="para-00004">Compare your answer: </para>
          <para id="para-00005">Graph of <m:math display="inline">
              <m:mrow>
                <m:mi>f</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts: <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>−</m:mo>
                <m:mn>3</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math> and <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>−</m:mo>
                <m:mn>1</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <exercise id="_67f58a73-d9ba-4806-a5a0-801efa0f1623" class="multiple-choice">
        <problem id="prob-00002">

          <para id="para-00006">b. Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-value of the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept of the graph.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00007">Correct! Graph of <m:math display="inline">
              <m:mrow>
                <m:mi>f</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00008">The correct answer is 3. Graph of <m:math display="inline">
              <m:mrow>
                <m:mi>f</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>

      <para id="para-00082">2. Function <m:math display="inline">
          <m:mrow>
            <m:mi>g</m:mi>
          </m:mrow>
        </m:math>
    <m:math display="inline">
          <m:mrow>
            <m:msup>
              <m:mi>x</m:mi>
              <m:mn>2</m:mn>
            </m:msup>
            <m:mo>−</m:mo>
            <m:mn>5</m:mn>
            <m:mi>x</m:mi>
            <m:mo>+</m:mo>
            <m:mn>4</m:mn>
          </m:mrow>
        </m:math>
    <m:math display="inline">
          <m:mrow>
            <m:mo stretchy="false">(</m:mo>
            <m:mi>x</m:mi>
            <m:mo>−</m:mo>
            <m:mn>4</m:mn>
            <m:mo stretchy="false">)</m:mo>
            <m:mo stretchy="false">(</m:mo>
            <m:mi>x</m:mi>
            <m:mo>−</m:mo>
            <m:mn>1</m:mn>
            <m:mo stretchy="false">)</m:mo>
          </m:mrow>
        </m:math></para>

      <media alt="A parabola on a coordinate grid. The x-axis scale is 1 and extends from negative 5 to 6. The y-axis scale is 1 and extends from negative 5 to 5.">
        <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_12_06_02.svg" />
      </media>
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00003">
          <para id="para-00009">a. Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts of the graph.</para>

        </problem>
        <solution id="sol-00003">
          <para id="para-00010">Compare your answer: </para>
          <para id="para-00011">Graph of <m:math display="inline">
              <m:mrow>
                <m:mi>g</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts: <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>1</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math> and <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>4</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <exercise id="_178b12d7-ad7f-4a82-91b9-f32055d91df2" class="multiple-choice">
        <problem id="prob-00004">

          <para id="para-00012">b. Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-value of the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept of the graph.</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00013">Correct! Graph of <m:math display="inline">
              <m:mrow>
                <m:mi>g</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>4</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00014">The correct answer is 4. Graph of <m:math display="inline">
              <m:mrow>
                <m:mi>g</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>4</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <para id="para-00083">3. Function <m:math display="inline">
          <m:mrow>
            <m:mi>h</m:mi>
          </m:mrow>
        </m:math>
    <m:math display="inline">
          <m:mrow>
            <m:msup>
              <m:mi>x</m:mi>
              <m:mn>2</m:mn>
            </m:msup>
            <m:mo>−</m:mo>
            <m:mn>9</m:mn>
          </m:mrow>
        </m:math>
    <m:math display="inline">
          <m:mrow>
            <m:mo stretchy="false">(</m:mo>
            <m:mi>x</m:mi>
            <m:mo>−</m:mo>
            <m:mn>3</m:mn>
            <m:mo stretchy="false">)</m:mo>
            <m:mo stretchy="false">(</m:mo>
            <m:mi>x</m:mi>
            <m:mo>+</m:mo>
            <m:mn>3</m:mn>
            <m:mo stretchy="false">)</m:mo>
          </m:mrow>
        </m:math></para>

      <media alt="A parabola on a coordinate grid. The x-axis scale is 1 and extends from negative 5 to 6. The y-axis scale is 1 and extends from negative 10 to 2.">
        <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_12_06_03.svg" />
      </media>
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00005">
          <para id="para-00015">a. Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts of the graph.</para>

        </problem>
        <solution id="sol-00005">
          <para id="para-00016">Compare your answer: </para>
          <para id="para-00017">Graph of <m:math display="inline">
              <m:mrow>
                <m:mi>h</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts: <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>3</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math> and <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>−</m:mo>
                <m:mn>3</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <exercise id="_561a8641-ac55-4e73-b668-3e53f80fb1f4" class="multiple-choice">
        <problem id="prob-00006">

          <para id="para-00018">b. Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-value of the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept of the graph.</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00019">Correct!– 9, Graph of <m:math display="inline">
              <m:mrow>
                <m:mi>h</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mo>−</m:mo>
                <m:mn>9</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00020">The correct answer is -9. Graph of <m:math display="inline">
              <m:mrow>
                <m:mi>h</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mo>−</m:mo>
                <m:mn>9</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <para id="para-00084">4. Function <m:math display="inline">
          <m:mrow>
            <m:mi>j</m:mi>
          </m:mrow>
        </m:math>
    <m:math display="inline">
          <m:mrow>
            <m:msup>
              <m:mi>x</m:mi>
              <m:mn>2</m:mn>
            </m:msup>
            <m:mo>−</m:mo>
            <m:mn>5</m:mn>
            <m:mi>x</m:mi>
          </m:mrow>
        </m:math>
    <m:math display="inline">
          <m:mrow>
            <m:mi>x</m:mi>
            <m:mo stretchy="false">(</m:mo>
            <m:mi>x</m:mi>
            <m:mo>−</m:mo>
            <m:mn>5</m:mn>
            <m:mo stretchy="false">)</m:mo>
          </m:mrow>
        </m:math></para>

      <media alt="A parabola on a coordinate grid. The x-axis scale is 1 and extends from negative 6 to 6. The y-axis scale is 1 and extends from negative 8 to 2.">
        <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_12_06_04.svg" />
      </media>
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00007">
          <para id="para-00021">a. Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts of the graph.</para>

        </problem>
        <solution id="sol-00007">
          <para id="para-00022">Compare your answer: </para>
          <para id="para-00023">Graph of <m:math display="inline">
              <m:mrow>
                <m:mi>j</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts: <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math> and <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>5</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <exercise id="_3725009b-5c7a-484f-9d88-30de64a4796e" class="multiple-choice">
        <problem id="prob-00008">

          <para id="para-00024">b. Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-value of the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept of the graph.</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00025">Correct! 0, Graph of <m:math display="inline">
