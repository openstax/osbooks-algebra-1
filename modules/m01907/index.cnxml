                <m:mi>j</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00026">The correct answer is 0, Graph of <m:math display="inline">
              <m:mrow>
                <m:mi>j</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>-intercept <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <para id="para-00085">5. Function <m:math display="inline">
          <m:mrow>
            <m:mi>k</m:mi>
          </m:mrow>
        </m:math>
    <m:math display="inline">
          <m:mrow>
            <m:mn>5</m:mn>
            <m:mi>x</m:mi>
            <m:mo>−</m:mo>
            <m:msup>
              <m:mi>x</m:mi>
              <m:mn>2</m:mn>
            </m:msup>
          </m:mrow>
        </m:math>
    <m:math display="inline">
          <m:mrow>
            <m:mi>x</m:mi>
            <m:mo stretchy="false">(</m:mo>
            <m:mn>5</m:mn>
            <m:mo>−</m:mo>
            <m:mi>x</m:mi>
