<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.8.1: Expressing Relationships between Two Quantities</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00186</md:content-id>
    <md:title>1.8.1: Expressing Relationships between Two Quantities</md:title>
