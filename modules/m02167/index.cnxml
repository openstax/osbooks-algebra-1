<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.5.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02167</md:content-id>
    <md:title>8.5.5: Practice</md:title>
    <md:uuid>f18da23d-f3ee-42a5-9adc-89b7aa071187</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <para id="para-00002">For questions 1 - 2, decide whether each statement is true or false.</para>
      <exercise id="a0bf2041-1f13-4d4f-89ca-4d2cb952cfe9" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00003">\(x(x−5)=0\) has only one solution.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00004">Try again. Revisit activity 8.5.1.</para>
          <para id="para-00005">The correct answer is false.</para>
        </solution>
      </exercise>
      <exercise id="_159a7839-3a9d-41c2-a0d4-9f73ec86a309" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00006">A solution to \(x^2−49=0\) is \(x=-7\).</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00007">Try again. Revisit activity 8.5.1.</para>
          <para id="para-00008">The correct answer is true.</para>
        </solution>
      </exercise>
      <exercise id="_98a10022-effb-4842-be8b-8f084b7d2334" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00009">Use graphing technology to determine the number of solutions for the equation \((x-4)(x+5)=−20\). Then find any solutions.</para>
          <para id="para-00010">Multiple Choice:</para>
          <para id="para-00011">No solution</para>
          <para id="para-00012">One solution; \(x=1\)</para>
          <para id="para-00013">Two solutions; \(x=1\) and \(x=0\)</para>
          <para id="para-00014">Two solutions; \(x=-1\) and \(x=0\)</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00015">Try again. Revisit activity 8.5.2.</para>
          <para id="para-00016">The correct answer is two solutions; \(x=-1\) and \(x=0\).</para>
        </solution>
      </exercise>
      <exercise id="_847dfb24-e2e5-44bb-9273-ea927ba44d16" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00017">Use graphing technology to determine the number of solutions for the equation \((x+2)(x+5)=−2\). Then find any solutions.</para>
          <para id="para-00018">Multiple Choice:</para>
          <para id="para-00019">No solution</para>
          <para id="para-00020">Two solutions; \(x=-3\) and \(x=4\)</para>
          <para id="para-00021">Two solutions; \(x=-3\) and \(x=-4\)</para>
          <para id="para-00022">Two solutions; \(x=3\) and \(x=4\)</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00023">Try again. Revisit activity 8.5.2.</para>
          <para id="para-00024">The correct answer is two solutions; \(x=-3\) and \(x=-4\).</para>
        </solution>
      </exercise>
      <exercise id="_37837e93-07f1-4768-b99a-0b78ecccaa74" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00025">For questions 5 – 8, choose the best method to solve the equation and then use the method to find the solution.</para>
          <para id="para-00026">\(x(x−6)=0\)</para>
          <para id="para-00027">Multiple Choice:</para>
          <para id="para-00028">\(x=0\) and \(x=-6\)</para>
          <para id="para-00029">\(x=6\)</para>
          <para id="para-00030">\(x=0\) and \(x=6\)</para>
          <para id="para-00031">\(x=6\) and \(x=-6\)</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00032">Try again. Revisit activity 8.5.3.</para>
          <para id="para-00033">The correct answer is \(x=0\) and \(x=6\).</para>
        </solution>
      </exercise>
      <exercise id="_859ba865-6cf5-439c-b0cc-27f65b66fde6" class="multiple-choice">
        <problem id="prob-00006">
          <para id="para-00034">\(\frac {1}{2}(x−4)^2=32\)</para>
          <para id="para-00035">Multiple Choice:</para>
          <para id="para-00036">\(x=-4\) and \(x=4\)</para>
          <para id="para-00037">\(x=-12\) and \(x=4\)</para>
          <para id="para-00038">\(x=-8\) and \(x=8\)</para>
          <para id="para-00039">\(x=12\) and \(x=-4\)</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00040">Try again. Revisit activity 8.5.3.</para>
          <para id="para-00041">The correct answer is \(x=12\) and \(x=-4\).</para>
        </solution>
      </exercise>
      <exercise id="a69c26e7-c3bd-4111-9ccf-d73f7be56067" class="multiple-choice">
        <problem id="prob-00007">
          <para id="para-00042">\((x+7)(x−2)=−8\)</para>
          <para id="para-00043">Multiple Choice:</para>
          <para id="para-00044">\(x=-7\) and \(x=2\)</para>
          <para id="para-00045">\(x=-8\) and \(x=-1\)</para>
          <para id="para-00046">\(x=-6\) and \(x=1\)</para>
          <para id="para-00047">No solutions</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00048">Try again. Revisit activity 8.5.3.</para>
          <para id="para-00049">The correct answer is \(x=-6\) and \(x=1\).</para>
        </solution>
      </exercise>
      <exercise id="_3329b76a-990f-408f-89f2-5cc0f61d140e" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00050">\((x−4)(x+9)=−42.25\)</para>
          <para id="para-00051">Multiple Choice:</para>
          <para id="para-00052">\(x=-2.5\)</para>
          <para id="para-00053">\(x=-3\) and \(x=-2\)</para>
          <para id="para-00054">\(x=-5\) and \(x=-1\)</para>
          <para id="para-00055">No solutions</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00056">Try again. Revisit activity 8.5.3.</para>
          <para id="para-00057">The correct answer is \(x=-2.5\).</para>
        </solution>
      </exercise>
      <exercise id="cff10a24-8cb6-44bb-9473-230b868cb91f" class="multiple-choice">
        <problem id="prob-00009">
          <para id="para-00058">Which statement is true of the equation \(x^2+36=0\)?</para>
          <para id="para-00059">Multiple Choice:</para>
          <para id="para-00060">The solutions are \(x=0\) and \(x=6\).</para>
          <para id="para-00061">The solution is \(x=6\).</para>
          <para id="para-00062">The solutions are \(x=6\) and \(x=-6\).</para>
          <para id="para-00063">The equation has no solutions.</para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00064">Try again. Revisit activity 8.5.4.</para>
          <para id="para-00065">The correct answer is the equation has no solutions.</para>
        </solution>
      </exercise>
      <exercise id="_4a2456ec-5131-48ff-a1c9-d72b16b89db0" class="multiple-choice">
        <problem id="prob-00010">
          <para id="para-00066">Which statement is true of the equation \(x^2+9x=0\)?</para>
          <para id="para-00067">Multiple Choice:</para>
          <para id="para-00068">The solution is \(x=-9\).</para>
          <para id="para-00069">The solutions are \(x=0\) and \(x=-9\).</para>
          <para id="para-00070">The solutions are \(x=9\) and \(x=-9\).</para>
          <para id="para-00071">The equation has no solutions.</para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00072">Try again. Revisit activity 8.5.4.</para>
          <para id="para-00073">The correct answer is the solutions are \(x=0\) and \(x=-9\).</para>
        </solution>
      </exercise>
    </section>
  </content>
</document>