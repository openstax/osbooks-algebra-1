<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.5.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02167</md:content-id>
    <md:title>8.5.5: Practice</md:title>
    <md:uuid>f18da23d-f3ee-42a5-9adc-89b7aa071187</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <para id="para-00002">For questions 1 - 2, decide whether each statement is true or false.</para>
      <exercise id="a0bf2041-1f13-4d4f-89ca-4d2cb952cfe9" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00003"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> has only one solution.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00004">Try again. Revisit activity 8.5.1.</para>
          <para id="para-00005">The correct answer is false.</para>
        </solution>
      </exercise>
      <exercise id="_159a7839-3a9d-41c2-a0d4-9f73ec86a309" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00006">A solution to <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>49</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math>.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00007">Try again. Revisit activity 8.5.1.</para>
          <para id="para-00008">The correct answer is true.</para>
        </solution>
      </exercise>
      <exercise id="_98a10022-effb-4842-be8b-8f084b7d2334" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00009">Use graphing technology to determine the number of solutions for the equation <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>20</m:mn></m:mrow></m:math>. Then find any solutions.</para>
          <para id="para-00010">Multiple Choice:</para>
          <para id="para-00011">No solution</para>
          <para id="para-00012">One solution; <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
          <para id="para-00013">Two solutions; <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para>
          <para id="para-00014">Two solutions; <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00015">Try again. Revisit activity 8.5.2.</para>
          <para id="para-00016">The correct answer is two solutions; <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_847dfb24-e2e5-44bb-9273-ea927ba44d16" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00017">Use graphing technology to determine the number of solutions for the equation <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>2</m:mn></m:mrow></m:math>. Then find any solutions.</para>
          <para id="para-00018">Multiple Choice:</para>
          <para id="para-00019">No solution</para>
          <para id="para-00020">Two solutions; <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
          <para id="para-00021">Two solutions; <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
          <para id="para-00022">Two solutions; <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00023">Try again. Revisit activity 8.5.2.</para>
          <para id="para-00024">The correct answer is two solutions; <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_37837e93-07f1-4768-b99a-0b78ecccaa74" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00025">For questions 5 – 8, choose the best method to solve the equation and then use the method to find the solution.</para>
          <para id="para-00026"><m:math><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para><para id="para-00027">Multiple Choice:</para>
          <para id="para-00028"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
          <para id="para-00029"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math></para><para id="para-00030"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
          <para id="para-00031"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00032">Try again. Revisit activity 8.5.3.</para>
          <para id="para-00033">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_859ba865-6cf5-439c-b0cc-27f65b66fde6" class="multiple-choice">
        <problem id="prob-00006">
          <para id="para-00034"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>32</m:mn></m:mrow></m:math></para><para id="para-00035">Multiple Choice:</para>
          <para id="para-00036"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
          <para id="para-00037"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>12</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
          <para id="para-00038"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
          <para id="para-00039"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>12</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00040">Try again. Revisit activity 8.5.3.</para>
          <para id="para-00041">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>12</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="a69c26e7-c3bd-4111-9ccf-d73f7be56067" class="multiple-choice">
        <problem id="prob-00007">
          <para id="para-00042"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>8</m:mn></m:mrow></m:math></para><para id="para-00043">Multiple Choice:</para>
          <para id="para-00044"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
          <para id="para-00045"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
          <para id="para-00046"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
          <para id="para-00047">No solutions</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00048">Try again. Revisit activity 8.5.3.</para>
          <para id="para-00049">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_3329b76a-990f-408f-89f2-5cc0f61d140e" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00050"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>42.25</m:mn></m:mrow></m:math></para><para id="para-00051">Multiple Choice:</para>
          <para id="para-00052"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2.5</m:mn></m:mrow></m:math></para><para id="para-00053"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
          <para id="para-00054"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
          <para id="para-00055">No solutions</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00056">Try again. Revisit activity 8.5.3.</para>
          <para id="para-00057">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2.5</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="cff10a24-8cb6-44bb-9473-230b868cb91f" class="multiple-choice">
        <problem id="prob-00009">
          <para id="para-00058">Which statement is true of the equation <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>36</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math>?</para>
          <para id="para-00059">Multiple Choice:</para>
          <para id="para-00060">The solutions are <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math>.</para>
          <para id="para-00061">The solution is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math>.</para>
          <para id="para-00062">The solutions are <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math>.</para>
          <para id="para-00063">The equation has no solutions.</para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00064">Try again. Revisit activity 8.5.4.</para>
          <para id="para-00065">The correct answer is the equation has no solutions.</para>
        </solution>
      </exercise>
      <exercise id="_4a2456ec-5131-48ff-a1c9-d72b16b89db0" class="multiple-choice">
        <problem id="prob-00010">
          <para id="para-00066">Which statement is true of the equation <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math>?</para>
          <para id="para-00067">Multiple Choice:</para>
          <para id="para-00068">The solution is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math>.</para>
          <para id="para-00069">The solutions are <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math>.</para>
          <para id="para-00070">The solutions are <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math>.</para>
          <para id="para-00071">The equation has no solutions.</para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00072">Try again. Revisit activity 8.5.4.</para>
          <para id="para-00073">The correct answer is the solutions are <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
    </section>
  </content>
