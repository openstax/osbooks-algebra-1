<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.5.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01669</md:content-id>
    <md:title>6.5.6: Practice</md:title>
    <md:uuid>b934f4e7-e4af-4f83-8345-706bcd3aeac5</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
<section id="sect-00002"><exercise id="_0bdb1b35-0352-4b50-bb3f-19b160395d83" class="multiple-choice"><problem id="prob-00001"><para id="para-00002">For questions 1 – 3, factor.</para><para id="para-00003">\(u^2 − 9u + 18\)</para>
      <para id="para-00004">Multiple Choice:</para><para id="para-00005">\((u + 9)(u + 2)\)</para><para id="para-00006">\((u − 3)(u − 6)\)</para><para id="para-00007">\((u + 3)(u + 6)\)</para><para id="para-00008">\((u + 3)(u − 6)\)</para></problem><solution id="sol-00001"><para id="para-00009">Try again. Revisit 6.5.2.
    </para><para id="para-00010">The correct answer is \((u − 3)(u − 6)\).
    </para></solution></exercise>
      
      <exercise id="_71bf43fc-e7e4-4f9f-b810-a5a0eea0a818" class="multiple-choice"><problem id="prob-00002"><para id="para-00011">\(8 − 6x + x^2\)</para>
      <para id="para-00012">Multiple Choice:</para><para id="para-00013">\((x + 4)(x + 2)\)</para><para id="para-00014">\((x − 8)(x + 1)\)</para><para id="para-00015">\((x − 4)(x − 2)\)</para><para id="para-00016">\((x + 4)(x − 2)\)</para></problem><solution id="sol-00002"><para id="para-00017">Try again. Revisit 6.5.2.</para><para id="para-00018">The correct answer is \((x - 4)(x - 2)\). You seem to be struggling. Who can you ask for help?</para></solution></exercise>
      
      <exercise id="_6c119771-bb68-4913-814a-cf496992cf5e" class="multiple-choice"><problem id="prob-00003"><para id="para-00019">\(a^2 + 5ab − 24b^2\)</para>
      <para id="para-00020">Multiple Choice:</para><para id="para-00021">\((a − 8b)(a + 3b)\)</para><para id="para-00022">\((a − 8b)(a − 3b)\)</para><para id="para-00023">\((a + 8b)(a + 3b)\)</para><para id="para-00024">\((a + 8b)(a − 3b)\)</para></problem><solution id="sol-00003"><para id="para-00025">Try again. Revisit 6.5.2.</para><para id="para-00026">The correct answer is \((a + 8b)(a − 3b)\).
    </para></solution></exercise>
      
      <exercise id="_72e0e494-14b6-4482-8d91-0fb4ba93310f" class="multiple-choice"><problem id="prob-00004"><para id="para-00027">For questions 4 – 5, factor using the trial and error method.</para><para id="para-00028">\( 4b^2 + 5b + 1\)</para>
      <para id="para-00029">Multiple Choice:</para><para id="para-00030">\((b − 1)(4b − 1)\)</para><para id="para-00031">\((5b + 1)(b − 1)\)</para><para id="para-00032">\((5b + 1)(b + 1)\)</para><para id="para-00033">\((b + 1)(4b + 1)\)</para></problem><solution id="sol-00004"><para id="para-00034">Try again. Revisit 6.5.4.</para><para id="para-00035">The correct answer is \((b + 1)(4b + 1)\). You seem to be struggling. Who can you ask for help?</para></solution></exercise>
      
      <exercise id="e338f769-c779-431c-add0-81dfafd9da0b" class="multiple-choice"><problem id="prob-00005"><para id="para-00036">\(30x^2 − 53xy − 21y^2\)</para>
      <para id="para-00037">Multiple Choice:</para><para id="para-00038">\((3x + y)(10x − 21y)\)</para><para id="para-00039">\((15x + y)(2x − 21y)\)</para><para id="para-00040">\((5x + y)(6x − 21y)\)</para><para id="para-00041">\((3x − y)(10x − 21y)\)</para></problem><solution id="sol-00005"><para id="para-00042">Try again. Revisit 6.5.3.
    </para><para id="para-00043">The correct answer is \((3x + y)(10x − 21y)\).
    </para></solution></exercise>
      
      <exercise id="_168e35c3-a6a1-4ad8-9956-e3a6f8072c1d" class="multiple-choice"><problem id="prob-00006"><para id="para-00044">Factor completely using the “\(ac\)” method: \(4y^2 + 8y + 3\).</para>
      <para id="para-00045">Multiple Choice:</para><para id="para-00046">\((2y − 1)(2y − 3)\)</para><para id="para-00047">\((2y + 1)(2y + 3)\)</para><para id="para-00048">\((2y − 1)(2y + 3)\)</para><para id="para-00049">\((2y + 1)(2y − 3)\)</para></problem><solution id="sol-00006"><para id="para-00050">Try again. Revisit 6.5.4.
    </para><para id="para-00051">The correct answer is \((2y + 1)(2y + 3)\).
    </para></solution></exercise>
      
      <exercise id="_9db4f6e2-ca63-485a-8b53-73856f64b8bd" class="multiple-choice"><problem id="prob-00007"><para id="para-00052">Factor completely using the “\(ac\)” method: \(18w^2 − 39w + 18\).</para>
      <para id="para-00053">Multiple Choice:</para><para id="para-00054">\((9w − 2)(2w − 3)\)</para><para id="para-00055">\( 3(3w − 2)(2w − 3)\)</para><para id="para-00056">\(3(3w + 2)(2w + 3)\)</para><para id="para-00057">\(3(3w + 2)(2w − 3)\)</para></problem><solution id="sol-00007"><para id="para-00058">Try again. Revisit 6.5.4.
    </para><para id="para-00059">The correct answer is \(3(3w − 2)(2w − 3)\).
    </para></solution></exercise>
      
      <exercise id="_156c246d-2c71-40e2-b461-8203f16fa9f9" class="multiple-choice"><problem id="prob-00008"><para id="para-00060">Factor by substitution: \(h^4 + 4h^2 − 12\).</para>
      <para id="para-00061">Multiple Choice:</para><para id="para-00062">\((h^2 + 2)(h^2 − 6)\)</para><para id="para-00063">\((h + 2)(h − 6)\)</para><para id="para-00064">\((h − 2)(h + 6)\)</para><para id="para-00065">\((h^2 − 2)(h^2 + 6)\)</para></problem><solution id="sol-00008"><para id="para-00066">Try again. Revisit 6.5.4.
    </para><para id="para-00067">The correct answer is \((h^2 − 2)(h^2 + 6)\).
    </para></solution></exercise>
      
      <exercise id="ff4ec407-60de-4cab-a76e-1df51a67d56c" class="multiple-choice"><problem id="prob-00009"><para id="para-00068">Factor by substitution: \((y − 4)^2 + 8(y − 4) + 15\).</para>
      <para id="para-00069">Multiple Choice:</para><para id="para-00070">\((y + 1)^2\)</para><para id="para-00071">\((y + 5)(y + 3)\)</para>
      <para id="para-00072">\((y − 1)(y + 1)\)</para><para id="para-00073">\((y − 5)(y − 3)\)</para></problem><solution id="sol-00009"><para id="para-00074">Try again. Revisit 6.5.4.
    </para><para id="para-00075">The correct answer is \((y − 1)(y + 1)\).</para></solution></exercise>
     <exercise id="bedcdf71-41c4-449a-8be9-5614b3fb34e1" class="multiple-choice"><problem id="prob-00010"><para id="para-00076">Factor using any method: \(13z^2 + 39z − 26\).</para>
      <para id="para-00077">Multiple Choice:</para><para id="para-00078">\(13(2z + 1)(z + 2)\)</para><para id="para-00079">\(13(2z − 1)(z + 2)\)</para><para id="para-00080">\(13(2z + 1)(z − 2)\)</para><para id="para-00081">\(13(z^2 + 3z - 2)\)</para></problem><solution id="sol-00010"><para id="para-00082">Try again. Revisit 6.5.5.
    </para><para id="para-00083">The correct answer is \(13(z^2 + 3z - 2)\).
    </para></solution></exercise></section></section>
</content>
