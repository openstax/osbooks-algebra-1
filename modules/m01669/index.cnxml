<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.5.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01669</md:content-id>
    <md:title>6.5.6: Practice</md:title>
    <md:uuid>b934f4e7-e4af-4f83-8345-706bcd3aeac5</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
<section id="sect-00002"><exercise id="_0bdb1b35-0352-4b50-bb3f-19b160395d83" class="multiple-choice"><problem id="prob-00001"><para id="para-00002">For questions 1 – 3, factor.</para><para id="para-00003"><m:math><m:mrow><m:msup><m:mi>u</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>9</m:mn><m:mi>u</m:mi><m:mo>+</m:mo><m:mn>18</m:mn></m:mrow></m:math></para>
      <para id="para-00004">Multiple Choice:</para><para id="para-00005"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00006"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00007"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00008"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00001"><para id="para-00009">Try again. Revisit 6.5.2.
    </para><para id="para-00010">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_71bf43fc-e7e4-4f9f-b810-a5a0eea0a818" class="multiple-choice"><problem id="prob-00002"><para id="para-00011"><m:math><m:mrow><m:mn>8</m:mn><m:mi>−</m:mi><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
      <para id="para-00012">Multiple Choice:</para><para id="para-00013"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00014"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00015"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00016"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00002"><para id="para-00017">Try again. Revisit 6.5.2.</para><para id="para-00018">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>. You seem to be struggling. Who can you ask for help?</para></solution></exercise>
      
      <exercise id="_6c119771-bb68-4913-814a-cf496992cf5e" class="multiple-choice"><problem id="prob-00003"><para id="para-00019"><m:math><m:mrow><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>a</m:mi><m:mi>b</m:mi><m:mi>−</m:mi><m:mn>24</m:mn><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
      <para id="para-00020">Multiple Choice:</para><para id="para-00021"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mi>−</m:mi><m:mn>8</m:mn><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00022"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mi>−</m:mi><m:mn>8</m:mn><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00023"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00024"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00003"><para id="para-00025">Try again. Revisit 6.5.2.</para><para id="para-00026">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_72e0e494-14b6-4482-8d91-0fb4ba93310f" class="multiple-choice"><problem id="prob-00004"><para id="para-00027">For questions 4 – 5, factor using the trial and error method.</para><para id="para-00028"><m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
      <para id="para-00029">Multiple Choice:</para><para id="para-00030"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>b</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>b</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00031"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>b</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00032"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00033"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00004"><para id="para-00034">Try again. Revisit 6.5.4.</para><para id="para-00035">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>. You seem to be struggling. Who can you ask for help?</para></solution></exercise>
      
      <exercise id="e338f769-c779-431c-add0-81dfafd9da0b" class="multiple-choice"><problem id="prob-00005"><para id="para-00036"><m:math><m:mrow><m:mn>30</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>53</m:mn><m:mi>x</m:mi><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>21</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
      <para id="para-00037">Multiple Choice:</para><para id="para-00038"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>21</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00039"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>15</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>21</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00040"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>21</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00041"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>21</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00005"><para id="para-00042">Try again. Revisit 6.5.3.
    </para><para id="para-00043">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>21</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_168e35c3-a6a1-4ad8-9956-e3a6f8072c1d" class="multiple-choice"><problem id="prob-00006"><para id="para-00044">Factor completely using the “<m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mi>c</m:mi></m:mrow></m:math>” method: <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math>.</para>
      <para id="para-00045">Multiple Choice:</para><para id="para-00046"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00047"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00048"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00049"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00006"><para id="para-00050">Try again. Revisit 6.5.4.
    </para><para id="para-00051">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_9db4f6e2-ca63-485a-8b53-73856f64b8bd" class="multiple-choice"><problem id="prob-00007"><para id="para-00052">Factor completely using the “<m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mi>c</m:mi></m:mrow></m:math>” method: <m:math display="inline"><m:mrow><m:mn>18</m:mn><m:msup><m:mi>w</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>39</m:mn><m:mi>w</m:mi><m:mo>+</m:mo><m:mn>18</m:mn></m:mrow></m:math>.</para>
      <para id="para-00053">Multiple Choice:</para><para id="para-00054"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mi>w</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>w</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00055"><m:math><m:mrow><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>w</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>w</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00056"><m:math><m:mrow><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>w</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>w</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00057"><m:math><m:mrow><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>w</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>w</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00007"><para id="para-00058">Try again. Revisit 6.5.4.
    </para><para id="para-00059">The correct answer is <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>w</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>w</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_156c246d-2c71-40e2-b461-8203f16fa9f9" class="multiple-choice"><problem id="prob-00008"><para id="para-00060">Factor by substitution: <m:math display="inline"><m:mrow><m:msup><m:mi>h</m:mi><m:mn>4</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>12</m:mn></m:mrow></m:math>.</para>
      <para id="para-00061">Multiple Choice:</para><para id="para-00062"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00063"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00064"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00065"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00008"><para id="para-00066">Try again. Revisit 6.5.4.
    </para><para id="para-00067">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="ff4ec407-60de-4cab-a76e-1df51a67d56c" class="multiple-choice"><problem id="prob-00009"><para id="para-00068">Factor by substitution: <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn><m:mo stretchy="false">(</m:mo><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>15</m:mn></m:mrow></m:math>.</para>
      <para id="para-00069">Multiple Choice:</para><para id="para-00070"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00071"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
      <para id="para-00072"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00073"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00009"><para id="para-00074">Try again. Revisit 6.5.4.
    </para><para id="para-00075">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para></solution></exercise>
     <exercise id="bedcdf71-41c4-449a-8be9-5614b3fb34e1" class="multiple-choice"><problem id="prob-00010"><para id="para-00076">Factor using any method: <m:math display="inline"><m:mrow><m:mn>13</m:mn><m:msup><m:mi>z</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>39</m:mn><m:mi>z</m:mi><m:mi>−</m:mi><m:mn>26</m:mn></m:mrow></m:math>.</para>
      <para id="para-00077">Multiple Choice:</para><para id="para-00078"><m:math><m:mrow><m:mn>13</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>z</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>z</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00079"><m:math><m:mrow><m:mn>13</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>z</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>z</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00080"><m:math><m:mrow><m:mn>13</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>z</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>z</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00081"><m:math><m:mrow><m:mn>13</m:mn><m:mo stretchy="false">(</m:mo><m:msup><m:mi>z</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>z</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00010"><para id="para-00082">Try again. Revisit 6.5.5.
    </para><para id="para-00083">The correct answer is <m:math display="inline"><m:mrow><m:mn>13</m:mn><m:mo stretchy="false">(</m:mo><m:msup><m:mi>z</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>z</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.
    </para></solution></exercise></section></section>
