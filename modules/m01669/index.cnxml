<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.5.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01669</md:content-id>
    <md:title>6.5.6: Practice</md:title>
    <md:uuid>1560e4d6-720c-4e27-8274-9896b5a562d9</md:uuid>
  </metadata>
  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="2333a58c-1cbf-4317-b1f2-4cfde049ba6c" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--Q1-->
  <exercise data-content-id="0bdb1b35-0352-4b50-bb3f-19b160395d83" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((u − 3)(u − 6)\)" data-solution-options="[&quot;\\((u + 9)(u + 2)\\)&quot;, &quot;\\((u − 3)(u − 6)\\)&quot;, &quot;\\((u + 3)(u + 6)\\)&quot;, &quot;\\((u + 3)(u − 6)\\)&quot;]">
    <problem>
      <para>For questions 1 – 3, factor.</para>
      <para>\(u^2 − 9u + 18\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.5.2.
      </para>
    </div>
    </exercise>
  <!--q2-->
  <exercise data-content-id="71bf43fc-e7e4-4f9f-b810-a5a0eea0a818" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((x − 4)(x − 2)\)" data-solution-options="[&quot;\\((x + 4)(x + 2)\\)&quot;, &quot;\\((x − 8)(x + 1)\\)&quot;, &quot;\\((x − 4)(x − 2)\\)&quot;, &quot;\\((x + 4)(x − 2)\\)&quot;]">
    <problem>
      <para>\(8 − 6x + x^2\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.5.2.</para>
    </div>
    </exercise>
  <!--q3-->
  <exercise data-content-id="6c119771-bb68-4913-814a-cf496992cf5e" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((a + 8b)(a − 3b)\)" data-solution-options="[&quot;\\((a − 8b)(a + 3b)\\)&quot;, &quot;\\((a − 8b)(a − 3b)\\)&quot;, &quot;\\((a + 8b)(a + 3b)\\)&quot;, &quot;\\((a + 8b)(a − 3b)\\)&quot;]">
    <problem>
      <para>\(a^2 + 5ab − 24b^2\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.5.2.</para>
    </div>
    </exercise>
  <!--q4-->
  <exercise data-content-id="72e0e494-14b6-4482-8d91-0fb4ba93310f" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((b + 1)(4b + 1)\)" data-solution-options="[&quot;\\((b − 1)(4b − 1)\\)&quot;, &quot;\\((5b + 1)(b − 1)\\)&quot;, &quot;\\((5b + 1)(b + 1)\\)&quot;, &quot;\\((b + 1)(4b + 1)\\)&quot;]">
    <problem>
      <para>For questions 4 – 5, factor using the trial and error method.</para>
      <para>\( 4b^2 + 5b + 1\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.5.4.</para>
    </div>
    </exercise>
  <!--q5-->
  <exercise data-content-id="e338f769-c779-431c-add0-81dfafd9da0b" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((3x + y)(10x − 21y)\)" data-solution-options="[&quot;\\((3x + y)(10x − 21y)\\)&quot;, &quot;\\((15x + y)(2x − 21y)\\)&quot;, &quot;\\((5x + y)(6x − 21y)\\)&quot;, &quot;\\((3x − y)(10x − 21y)\\)&quot;]">
    <problem>
      <para>\(30x^2 − 53xy − 21y^2\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.5.3.
      </para>
    </div>
    </exercise>
  <!--q6-->
  <exercise data-content-id="168e35c3-a6a1-4ad8-9956-e3a6f8072c1d" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((2y + 1)(2y + 3)\)" data-solution-options="[&quot;\\((2y − 1)(2y − 3)\\)&quot;, &quot;\\((2y + 1)(2y + 3)\\)&quot;, &quot;\\((2y − 1)(2y + 3)\\)&quot;, &quot;\\((2y + 1)(2y − 3)\\)&quot;]">
    <problem>
      <para>Factor completely using the “\(ac\)” method: \(4y^2 + 8y + 3\).</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.5.4.
      </para>
    </div>
    </exercise>
  <!--q7-->
  <exercise data-content-id="9db4f6e2-ca63-485a-8b53-73856f64b8bd" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\( 3(3w − 2)(2w − 3)\)" data-solution-options="[&quot;\\((9w − 2)(2w − 3)\\) &quot;, &quot;\\( 3(3w − 2)(2w − 3)\\)&quot;, &quot;\\(3(3w + 2)(2w + 3)\\)&quot;, &quot;\\(3(3w + 2)(2w − 3)\\)&quot;]">
    <problem>
      <para>Factor completely using the “\(ac\)” method: \(18w^2 − 39w + 18\).</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.5.4.
      </para>
    </div>
    </exercise>
  <!--q8-->
  <exercise data-content-id="156c246d-2c71-40e2-b461-8203f16fa9f9" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((h^2 − 2)(h^2 + 6)\)" data-solution-options="[&quot;\\((h^2 + 2)(h^2 − 6)\\)&quot;, &quot;\\((h + 2)(h − 6)\\)&quot;, &quot;\\((h − 2)(h + 6)\\)&quot;, &quot;\\((h^2 − 2)(h^2 + 6)\\)&quot;]">
    <problem>
      <para>Factor by substitution: \(h^4 + 4h^2 − 12\).</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.5.4.
      </para>
    </div>
    </exercise>
  <!--q9-->
  <exercise data-content-id="ff4ec407-60de-4cab-a76e-1df51a67d56c" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((y − 1)(y + 1)\)" data-solution-options="[&quot;\\((y + 1)^2\\) &quot;, &quot;\\((y + 5)(y + 3)\\)&quot;, &quot;\\((y − 1)(y + 1)\\)&quot;, &quot;\\((y − 5)(y − 3)\\)&quot;]">
    <problem>
      <para>Factor by substitution: \((y − 4)^2 + 8(y − 4) + 15\).</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.5.4.
      </para>
    </div>
    </exercise>
  <!--q10-->
  <exercise data-content-id="bedcdf71-41c4-449a-8be9-5614b3fb34e1" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(13(z^2 + 3z - 2)\)" data-solution-options="[&quot;\\(13(2z + 1)(z + 2)\\)&quot;, &quot;\\(13(2z − 1)(z + 2)\\)&quot;, &quot;\\(13(2z + 1)(z − 2)\\)&quot;, &quot;\\(13(z^2 + 3z - 2)\\)&quot;]">
    <problem>
      <para>Factor using any method: \(13z^2 + 39z − 26\).</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.5.5.
      </para>
    </div>
    </exercise>
  <!--Do not edit below this line-->
  <solution> </solution>
  <div class="os-raise-ib-pset-encourage-response"> </div>
</div></section>
