  <thead>
    <row>
      <entry scope="col" class="emphasis">Decimal Form</entry>
      <entry scope="col" class="emphasis">Scientific Notation</entry>
    </row>
  </thead>
  <tbody>
    <row>
      <entry>
        0.00000654
      </entry>
      <entry> </entry>
    </row>
    <row>
      <entry>
        0.0000947
      </entry>
      <entry> </entry>
    </row>
    <row>
      <entry>
        683,000
      </entry>
      <entry> </entry>
    </row>
    <row>
      <entry>
        0.022
      </entry>
      <entry> </entry>
    </row>
    <row>
      <entry>
        5,200
      </entry>
      <entry> </entry>
    </row>
    <row>
      <entry>
        0.000352
      </entry>
      <entry> </entry>
    </row>
  </tbody>
</table>

<para class="os-raise-text-bold">Answer: </para>
<table class="os-raise-midsizetable">
  <thead>
