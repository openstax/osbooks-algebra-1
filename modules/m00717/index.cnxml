<!--Q#11-->
<exercise>
  <problem>
    <para> Write the equation of the linear model that represents the situation in slope-intercept form. </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(C=10n + 30\)</para>
  </solution></exercise>
<!--Interaction End -->

<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="db064115-e006-4852-bb76-2ab0aa9571a4" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0"><!--Q#12-->
  <exercise data-content-id="18d01656-b556-4ad1-97c4-43280947ff88" data-problem-comparator="integer" data-problem-type="input" data-solution="80">
    <problem>
      <para> How much does it cost to rent a tent for 5 nights? </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct!</para>
      <para> Compare your answer: 
        \(C=10n + 30\)
        \(C=10(5) + 30=80\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
