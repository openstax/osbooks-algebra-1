<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Applying the Distributive Property to Rewrite Expressions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00240</md:content-id>
    <md:title>Applying the Distributive Property to Rewrite Expressions</md:title>
    <md:uuid>bbca9943-57d5-4675-afc3-12bfb58b83a2</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>
      <para id="para-00001">Rewrite each quotient as a sum or a difference.</para>
      <!-- q1 -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002"><m:math><m:mrow><m:mstyle displaystyle="true" scriptlevel="0"><m:mfrac><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>&#8722;</m:mo><m:mn>10</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mstyle></m:mrow></m:math></para></problem>
        <solution id="sol-00001">
          <para id="para-00003">Compare your answer: </para>
          <para id="para-00004"><m:math><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>&#8722;</m:mo><m:mn>5</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!-- q2 -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00005"><m:math><m:mrow><m:mstyle displaystyle="true" scriptlevel="0"><m:mfrac><m:mrow><m:mn>1</m:mn><m:mo>&#8722;</m:mo><m:mn>50</m:mn><m:mi>x</m:mi></m:mrow><m:mrow><m:mo>&#8722;</m:mo><m:mn>2</m:mn></m:mrow></m:mfrac></m:mstyle></m:mrow></m:math></para></problem>
        <solution id="sol-00002">
          <para id="para-00006">Compare your answer: </para>
          <para id="para-00007"><m:math><m:mrow><m:mo>&#8722;</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mn>25</m:mn><m:mi>x</m:mi></m:mrow></m:math></para></solution>
      </exercise>
      <!-- q3 -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00008"><m:math><m:mrow><m:mstyle displaystyle="true" scriptlevel="0"><m:mfrac><m:mrow><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo></m:mrow><m:mrow><m:mn>25</m:mn></m:mrow></m:mfrac></m:mstyle></m:mrow></m:math></para></problem>
        <solution id="sol-00003">
          <para id="para-00009">Compare your answer: </para>
          <para id="para-00010"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!-- q4 -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00011"><m:math><m:mrow><m:mstyle displaystyle="true" scriptlevel="0"><m:mfrac><m:mrow><m:mo>&#8722;</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>5</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mstyle></m:mrow></m:math></para></problem>
        <solution id="sol-00004">
          <para id="para-00012">Compare your answer: </para>
          <para id="para-00013"><m:math><m:mrow><m:mo>&#8722;</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para></solution>
      </exercise>
    </section>
  </content>
</document>