</div>
<!--Q3-->
<exercise>
  <problem>
    <para>
        \( w \) centimeters
      </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>
      \(2L + 2(w) = 48\)</para>
  </solution></exercise>
