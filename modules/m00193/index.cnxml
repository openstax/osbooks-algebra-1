<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Writing Equations Given Dimensions of Shapes</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00193</md:content-id>
    <md:title>Writing Equations Given Dimensions of Shapes</md:title>
    <md:uuid>b86a3591-9994-44fc-bc2c-cdca1dd73f6c</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">
      <title>Cool Down</title>
      <para id="para-00001">The perimeter of a rectangle is 48 centimeters. The relationship between
        the length, the width, and the perimeter of the rectangle can be described with the
        equation: <m:math display="inline">
          <m:mrow>
            <m:mn>2</m:mn>
            <m:mi>·</m:mi>
            <m:mtext>length</m:mtext>
            <m:mo>+</m:mo>
            <m:mn>2</m:mn>
            <m:mi>·</m:mi>
            <m:mtext>width</m:mtext>
            <m:mo>=</m:mo>
            <m:mn>48</m:mn>
          </m:mrow>
        </m:math>.</para>
      <para id="para-00002">Find the length, in centimeters, if the width is:</para>
      <exercise id="_7ffc205b-b5c3-4b88-9038-cd798a83705e" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00003">10 centimeters</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00004">14</para>
          <para id="para-00005"><m:math display="inline">
              <m:mrow>
                <m:mn>2</m:mn>
                <m:mi>L</m:mi>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>10</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mn>48</m:mn>
              </m:mrow>
            </m:math></para>
          <para id="para-00007"><m:math display="inline">
              <m:mrow>
                <m:mn>2</m:mn>
                <m:mi>L</m:mi>
                <m:mo>+</m:mo>
                <m:mn>20</m:mn>
                <m:mo>=</m:mo>
                <m:mn>48</m:mn>
              </m:mrow>
            </m:math></para>
          <para id="para-00016"><m:math display="inline">
              <m:mrow>
                <m:mn>2</m:mn>
                <m:mi>L</m:mi>
                <m:mo>+</m:mo>
                <m:mn>20</m:mn>
                <m:mo>&#8722;</m:mo>
                <m:mn>20</m:mn>
                <m:mo>=</m:mo>
                <m:mn>48</m:mn>
                <m:mo>&#8722;</m:mo>
                <m:mn>20</m:mn>
              </m:mrow>
            </m:math></para>
          <para id="para-00017"><m:math display="inline">
              <m:mrow>
                <m:mn>2</m:mn>
                <m:mi>L</m:mi>
                <m:mo>=</m:mo>
                <m:mn>28</m:mn>
              </m:mrow>
            </m:math></para>
          <para id="para-00019"><m:math display="inline">
              <m:mrow>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>1</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:mn>2</m:mn>
                  </m:mrow>
                </m:mfrac>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>2</m:mn>
                <m:mi>L</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>1</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:mn>2</m:mn>
                  </m:mrow>
                </m:mfrac>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>28</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
          <para id="para-00021"><m:math display="inline">
              <m:mrow>
                <m:mi>L</m:mi>
                <m:mo>=</m:mo>
                <m:mn>14</m:mn>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <exercise id="_07c3d8c2-ec3b-4992-90ee-3e264fc0822f" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00008">3.6 centimeters</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00034"><m:math display="inline">
              <m:mrow>
                <m:mn>2</m:mn>
                <m:mi>L</m:mi>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>3.6</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mn>48</m:mn>
              </m:mrow>
            </m:math></para>
          <para id="para-00035"><m:math display="inline">
              <m:mrow>
                <m:mn>2</m:mn>
                <m:mi>L</m:mi>
                <m:mo>+</m:mo>
                <m:mn>7.2</m:mn>
                <m:mo>=</m:mo>
                <m:mn>48</m:mn>
              </m:mrow>
            </m:math></para>
          <para id="para-00037"><m:math display="inline">
              <m:mrow>
                <m:mn>2</m:mn>
                <m:mi>L</m:mi>
                <m:mo>+</m:mo>
                <m:mn>7.2</m:mn>
                <m:mo>&#8722;</m:mo>
                <m:mn>7.2</m:mn>
                <m:mo>=</m:mo>
                <m:mn>48</m:mn>
                <m:mo>&#8722;</m:mo>
                <m:mn>7.2</m:mn>
              </m:mrow>
            </m:math></para>
          
          <para id="para-00039"><m:math display="inline">
              <m:mrow>
                <m:mn>2</m:mn>
                <m:mi>L</m:mi>
                <m:mo>=</m:mo>
                <m:mn>40.8</m:mn>
              </m:mrow>
            </m:math></para>
          
          <para id="para-00041"><m:math display="inline">
              <m:mrow>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>1</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:mn>2</m:mn>
                  </m:mrow>
                </m:mfrac>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>2</m:mn>
                <m:mi>L</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>1</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:mn>2</m:mn>
                  </m:mrow>
                </m:mfrac>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>40.8</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
          
          <para id="para-00043"><m:math display="inline">
              <m:mrow>
                <m:mi>L</m:mi>
                <m:mo>=</m:mo>
                <m:mn>20.4</m:mn>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <exercise id="exer-00001">
        <problem id="prob-00003">
          <para id="para-00013"><m:math display="inline">
              <m:mrow>
                <m:mi>w</m:mi>
              </m:mrow>
            </m:math> centimeters</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00014">Compare your answer: </para>
          <para id="para-00015"><m:math display="inline">
              <m:mrow>
                <m:mn>2</m:mn>
                <m:mi>L</m:mi>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>w</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mn>48</m:mn>
              </m:mrow>
            </m:math></para><para id="para-00006"><m:math display="inline">
              <m:mrow>
                <m:mn>2</m:mn>
                <m:mi>L</m:mi>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
                <m:mi>w</m:mi>
                <m:mo>=</m:mo>
                <m:mn>48</m:mn>
              </m:mrow>
            </m:math></para><para id="para-00010"><m:math display="inline">
              <m:mrow>
                <m:mn>2</m:mn>
                <m:mi>L</m:mi>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
                <m:mi>w</m:mi>
                <m:mo>&#8722;</m:mo>
                <m:mn>2</m:mn>
                <m:mi>w</m:mi>
                <m:mo>=</m:mo>
                <m:mn>48</m:mn>
                <m:mo>&#8722;</m:mo>
                <m:mn>2</m:mn>
                <m:mi>s</m:mi>
              </m:mrow>
            </m:math></para><para id="para-00011"><m:math display="inline">
              <m:mrow>
                <m:mn>2</m:mn>
                <m:mi>L</m:mi>
                <m:mo>=</m:mo>
                <m:mn>48</m:mn>
                <m:mo>&#8722;</m:mo>
                <m:mn>2</m:mn>
              </m:mrow>
            </m:math></para><para id="para-00012"><m:math display="inline">
              <m:mrow>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>1</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:mn>2</m:mn>
                  </m:mrow>
                </m:mfrac>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>2</m:mn>
                <m:mi>L</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>1</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:mn>2</m:mn>
                  </m:mrow>
                </m:mfrac>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>48</m:mn>
                <m:mo>&#8722;</m:mo>
                <m:mn>2</m:mn>
                <m:mi>s</m:mi>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para><para id="para-00018"><m:math display="inline">
              <m:mrow>
                <m:mi>L</m:mi>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>48</m:mn>
                    <m:mo>&#8722;</m:mo>
                    <m:mn>2</m:mn>
                    <m:mi>w</m:mi>
                  </m:mrow>
                  <m:mrow>
                    <m:mn>2</m:mn>
                  </m:mrow>
                </m:mfrac>
              </m:mrow>
            </m:math>
            or <m:math display="inline">
              <m:mrow>
                <m:mn>24</m:mn>
                <m:mo>&#8722;</m:mo>
                <m:mi>w</m:mi>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
    </section>
  </content>
</document>