<exercise>
  <problem>
    <para> In Step \(n\), what is the number of dots in Pattern 1?</para>
      </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(2n+1\)</para>
  </solution></exercise>
<!--Interaction End -->

