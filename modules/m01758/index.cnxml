<example><exercise>
  <problem>
    
    <para> Pattern 1 </para>
      <para>Select the <emphasis>solution</emphasis> button to compare your work. </para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para><figure><media alt="Points plotted on a grid. Number of dots. Step number."><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/cf515b348bca3de8f3b02eb7c8f2deca3dccc3e7"/></media></figure></para>
</solution></exercise>
