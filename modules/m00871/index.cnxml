<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.2.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00871</md:content-id>
    <md:title>4.2.5: Practice</md:title>
    <md:uuid>53f146c8-a81a-496a-a7eb-422d2cfe4cad</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <!--Do not edit this div tag.  It must surround the interaction block-->
      <section class="check-understanding" id="sect-00002">
        <exercise id="_9a0e8228-dbbc-42d4-9bc8-0ea042e64963" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00002">1. The height of water in a bathtub, <m:math display="inline"><m:mrow><m:mi>w</m:mi></m:mrow></m:math>, is a function of time, <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math>. Let <m:math display="inline"><m:mrow><m:mi>P</m:mi></m:mrow></m:math> represent this function. Height is measured in inches and time in minutes.</para>
            <para id="para-00003">What does each equation mean in this situation?</para>
            <para id="para-00004"><m:math><m:mrow><m:mi>P</m:mi><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00005">Correct! The bathtub starts out with no water.</para>
            <para id="para-00006">Try again. Revisit activity 4.2.2.</para>
            <para id="para-00007">The correct answer is the bathtub starts out with no water.</para>
          </solution>
        </exercise>
        <exercise id="_3379ac21-fa25-4ce5-a6a6-1d8e84d30603" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00008"><m:math><m:mrow><m:mi>P</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00009">Correct! The height of the water is 10 inches after 4 minutes.</para>
            <para id="para-00010">Try again. Revisit activity 4.2.2.</para>
            <para id="para-00011">The correct answer is the height of the water is 10 inches after 4 minutes.</para>
          </solution>
        </exercise>
        <exercise id="_9026ab6b-c2b5-4f4c-b535-f7c79714eed2" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00012"><m:math><m:mrow><m:mi>P</m:mi><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00013">Correct! After 10 minutes, the height of the water is 4 inches.</para>
            <para id="para-00014">Try again. Revisit activity 4.2.2.</para>
            <para id="para-00015">The correct answer is the height of the water is 10 inches after 4 minutes.</para>
          </solution>
        </exercise>
        <exercise id="e54beaa5-fe9d-410f-a372-7c182d63121a" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00016"><m:math><m:mrow><m:mi>P</m:mi><m:mo stretchy="false">(</m:mo><m:mn>20</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00017">Correct! After 20 minutes, the bathtub is empty.</para>
            <para id="para-00018">Try again. Revisit activity 4.2.2.</para>
            <para id="para-00019">The correct answer is: After 20 minutes, the bathtub is empty.</para>
          </solution>
        </exercise>
        <exercise id="_9ba0c414-9e72-40cf-8171-f1a2008ab925" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00020">Function <m:math display="inline"><m:mrow><m:mi>C</m:mi></m:mrow></m:math> takes time for its input and gives a student’s Monday class for its output.
          
          Use function notation to represent: A student has English at 10:00.
      </para>
            <para id="para-00021">Multiple Choice:</para>
            <para id="para-00022"><m:math><m:mrow><m:mi>C</m:mi><m:mo stretchy="false">(</m:mo><m:mi>E</m:mi><m:mi>n</m:mi><m:mi>g</m:mi><m:mi>l</m:mi><m:mi>i</m:mi><m:mi>s</m:mi><m:mi>h</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>10</m:mn><m:mi>:</m:mi><m:mn>00</m:mn></m:mrow></m:math></para>
            <para id="para-00023"><m:math><m:mrow><m:mi>C</m:mi><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>:</m:mi><m:mn>00</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>E</m:mi><m:mi>n</m:mi><m:mi>g</m:mi><m:mi>l</m:mi><m:mi>i</m:mi><m:mi>s</m:mi><m:mi>h</m:mi></m:mrow></m:math></para>
            <para id="para-00024"><m:math display="inline"><m:mrow><m:mi>C</m:mi><m:mo stretchy="false">(</m:mo><m:mi>M</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mi>d</m:mi><m:mi>a</m:mi><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>E</m:mi><m:mi>n</m:mi><m:mi>g</m:mi><m:mi>l</m:mi><m:mi>i</m:mi><m:mi>s</m:mi><m:mi>h</m:mi></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mi>t</m:mi></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mn>10</m:mn><m:mi>:</m:mi><m:mn>00</m:mn></m:mrow></m:math></para>
            <para id="para-00025"><m:math><m:mrow><m:mi>C</m:mi><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>:</m:mi><m:mn>00</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>M</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mi>d</m:mi><m:mi>a</m:mi><m:mi>y</m:mi></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00026">Correct! <m:math display="inline"><m:mrow><m:mi>C</m:mi><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>:</m:mi><m:mn>00</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>E</m:mi><m:mi>n</m:mi><m:mi>g</m:mi><m:mi>l</m:mi><m:mi>i</m:mi><m:mi>s</m:mi><m:mi>h</m:mi></m:mrow></m:math></para>
            <para id="para-00027">Try again. Revisit activities 4.2.2.</para>
            <para id="para-00028">The correct answer is <m:math display="inline"><m:mrow><m:mi>C</m:mi><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>:</m:mi><m:mn>00</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>E</m:mi><m:mi>n</m:mi><m:mi>g</m:mi><m:mi>l</m:mi><m:mi>i</m:mi><m:mi>s</m:mi><m:mi>h</m:mi></m:mrow></m:math>.
    </para>
          </solution>
        </exercise>
        <exercise id="db790a9a-4c23-4f64-99c6-d07ff5ce0469" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00029">Function <m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math> gives the distance of a dog from a post, in feet, as a function of time, in seconds, since its owner left.</para>
                  <media alt="Nonlinear function. time in seconds and distance from post in feet.  ">
                <image mime-type="image/svg+xml" src="../../media/Algebra-1_04_05_10_01.svg"/>
              </media>
            
            <para id="para-00030">Find the value of <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>20</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00031">Correct! <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>20</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>3.1</m:mn></m:mrow></m:math></para>
            <para id="para-00032">Try again. Revisit activity 4.2.2.</para>
            <para id="para-00033">The correct answer is <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>20</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>3.1</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_42a31a54-653c-4215-b686-a6f8274741d7" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00034">Find the value of <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>140</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00035">Correct! <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>140</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>3.5</m:mn></m:mrow></m:math></para>
            <para id="para-00036">Try again. Revisit activity 4.2.2.</para>
            <para id="para-00037">The correct answer is <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>140</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>3.5</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_908003dd-ec45-4360-990e-53b90e5315ba" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00038">Looking at the graph below, what does the point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1980</m:mn><m:mo>,</m:mo><m:mn>83</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> mean?</para>
                  <media alt="GRAPH TITLED `WORLD POPULATION INCREASE` WITH X-AXIS LABEL OF YEAR AND Y-AXIS LABEL OF MILLIONS OF PEOPLE">
                <image mime-type="image/jpeg" src="../../media/Algebra-1_04_05_10_02.jpg"/>
              </media>
            
          </problem>
          <solution id="sol-00008">
            <para id="para-00039">Correct! In 1980, the world population increased by 80 million people.</para>
            <para id="para-00040">Try again. Revisit activities 4.2.1 – 4.2.2.</para>
            <para id="para-00041">The correct answer is: In 1980, the world population increased by 80 million people.</para>
          </solution>
        </exercise>
        <exercise id="_0c5ed329-1ad3-4335-b6be-0b95861aeca4" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00042">Function <m:math display="inline"><m:mrow><m:mi>R</m:mi></m:mrow></m:math> gives the number of inches of rain after <m:math display="inline"><m:mrow><m:mi>h</m:mi></m:mrow></m:math> hours. What does the statement <m:math display="inline"><m:mrow><m:mi>R</m:mi><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math> mean?</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00043">Correct! After 6 hours, there was 5 inches of rain.</para>
            <para id="para-00044">Try again. Revisit activities 4.2.4.</para>
            <para id="para-00045">The correct answer is after 6 hours, there was 5 inches of rain.</para>
          </solution>
        </exercise>
        <exercise id="_4d8f6467-07db-4c6e-9a41-a64633c2c719" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00046">Function <m:math display="inline"><m:mrow><m:mi>R</m:mi></m:mrow></m:math> gives the number of inches, <m:math display="inline"><m:mrow><m:mi>T</m:mi></m:mrow></m:math>, of rain after <m:math display="inline"><m:mrow><m:mi>h</m:mi></m:mrow></m:math>, hours. Choose which function notation represents this situation.</para>
            <para id="para-00047">Multiple Choice:</para>
            <para id="para-00048"><m:math><m:mrow><m:mi>R</m:mi><m:mo>=</m:mo><m:mi>T</m:mi><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00049"><m:math><m:mrow><m:mi>h</m:mi><m:mo>=</m:mo><m:mi>R</m:mi><m:mo stretchy="false">(</m:mo><m:mi>T</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00050"><m:math><m:mrow><m:mi>h</m:mi><m:mo>=</m:mo><m:mi>T</m:mi><m:mo stretchy="false">(</m:mo><m:mi>R</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00051"><m:math><m:mrow><m:mi>T</m:mi><m:mo>=</m:mo><m:mi>R</m:mi><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00052">Correct! <m:math display="inline"><m:mrow><m:mi>T</m:mi><m:mo>=</m:mo><m:mi>R</m:mi><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00053">Try again. Revisit activity 4.2.4.</para>
            <para id="para-00054">The correct answer is <m:math display="inline"><m:mrow><m:mi>T</m:mi><m:mo>=</m:mo><m:mi>R</m:mi><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_821b6bf9-1c0c-45ce-9ef8-cfa4c4e4bd45" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00055">Use function notation to represent that the number of miles, <m:math display="inline"><m:mrow><m:mi>m</m:mi></m:mrow></m:math>, a car travels as a function of time, <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math>.</para>
            <para id="para-00056">Multiple Choice:</para>
            <para id="para-00057"><m:math><m:mrow><m:mi>f</m:mi><m:mo>=</m:mo><m:mi>m</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00058"><m:math><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00059"><m:math><m:mrow><m:mi>t</m:mi><m:mo>=</m:mo><m:mi>m</m:mi><m:mo stretchy="false">(</m:mo><m:mi>f</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00060"><m:math><m:mrow><m:mi>t</m:mi><m:mo>=</m:mo><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>m</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00011">
            <para id="para-00061">Correct! <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00062">Try again. Revisit activities 4.2.2 – 4.2.4.</para>
            <para id="para-00063">The correct answer is <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
      </section>
    </section>
  </content></document>
