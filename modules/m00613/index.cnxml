  <title>2.13.4 Additional Resources</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00613</md:content-id>
    <md:title>2.13.4 Additional Resources</md:title>
    <md:uuid>a7dc8115-1420-4d81-9211-99f4b4c38337</md:uuid>
