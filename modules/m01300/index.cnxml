<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.4.2: Additional Resources</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01300</md:content-id>
    <md:title>5.4.2: Additional Resources</md:title>
    <md:uuid>afafc176-0011-47aa-ab49-1502727b4746</md:uuid>
