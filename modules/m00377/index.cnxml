<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.1.5 Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00377</md:content-id>
    <md:title>2.1.5 Practice</md:title>
    <md:uuid>2050d1d9-6dbc-4e99-97e9-c6962a00be52</md:uuid>
  </metadata>
  <content>
  <section>
<div class="os-raise-familysupport">
  <para>Access the <link url="https://k12.openstax.org/contents/raise/resources/b62c9150250bf52d6cc37569213ab516e0090dca">Desmos guide PDF</link> for tips on solving problems with the Desmos graphing calculator.</para>
</div>


<!-- Directions -->
<para>In 1 - 4, determine if the following points are solutions to the given system of equations.</para>
<section class="check-understanding"><exercise data-content-id="1055a4fc-c177-493d-97d8-bf3dbeb17e02"><problem><para>
      <para>Determine if the point is a solution to the system of equations: \(\left\{\begin{array}{l}2x-6y=0\\3x-4y=5\end{array}\right.\)</para>
      </para><para>Multiple Choice:</para><para>(3,1)</para><para>(-3,4)</para><para>(8/7, 6/7)</para><para>(1, 3/4)</para></problem><solution><para>(3,1)</para></solution></exercise></section><list class="os-raise-noindent" start="5" type="enumerated">
  <item>Solve the system of equations by graphing: \(\left\{\begin{array}{l}3x + y = -3\\2x + 3y = 5\end{array}\right.\)</item>
</list>
<div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>
<section class="check-understanding"><exercise data-content-id="26e7af8f-b850-444d-9fb7-bd02e90ede73"><problem><newline/><para>Multiple Choice:</para><para>(-2,3)</para><para>(0,-3)</para><para>(-3,6)</para><para>(4,-1)</para></problem><solution><para>(-2,3)</para></solution></exercise></section><!-- Question 6 -->
<list class="os-raise-noindent" start="6" type="enumerated">
  <item>Solve the system of equations by graphing: \(\left\{\begin{array}{l}y = x + 2\\y = -2x + 2\end{array}\right.\)</item>
</list>
<div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>
<section class="check-understanding"><exercise data-content-id="39eb3a30-dad1-4781-b9f1-d0425a886b16"><problem><newline/><para>Multiple Choice:</para><para>(2,0)</para><para>(-1,4)</para><para>(0,2)</para><para>(-2,0)</para></problem><solution><para>(0,2)</para></solution></exercise></section><!-- Question 7 -->
<list class="os-raise-noindent" start="7" type="enumerated">
  <item>Solve the system of equations by graphing: \(\left\{\begin{array}{l}y = \frac{3}{2}x + 1\\y = -\frac{1}{2}x + 5\end{array}\right.\)</item>
</list>
<div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>
<section class="check-understanding"><exercise data-content-id="aa410934-3bff-419f-a3b7-87cc2575d70c"><problem><newline/><para>Multiple Choice:</para><para>(4,3)</para><para>(0,1)</para><para>(0,5)</para><para>(2,4)</para></problem><solution><para>(2,4)</para></solution></exercise></section><!-- Question 8 -->
<list class="os-raise-noindent" start="8" type="enumerated">
  <item>Solve the system of equations by graphing: \(\left\{\begin{array}{l}x + y = -4\\-x + 2y = -2\end{array}\right.\)</item>
</list>
<div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>
<section class="check-understanding"><exercise data-content-id="51654b4a-b819-4b70-800b-2141bb4cf1d4"><problem><newline/><para>Multiple Choice:</para><para>(2,0)</para><para>(-1,0)</para><para>(4,1)</para><para>(-2,-2)</para></problem><solution><para>(-2,-2)</para></solution></exercise></section><!-- Question 9 -->
<list class="os-raise-noindent" start="9" type="enumerated">
  <item>Solve the system of equations by graphing: \(\left\{\begin{array}{l}-2x + 3y = 3\\x + 3y = 12\end{array}\right.\)</item>
</list>
<div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>
<section class="check-understanding"><exercise data-content-id="7b9c0347-06f5-42e1-9185-c7c8dfa32680"><problem><newline/><para>Multiple Choice:</para><para>(6,2)</para><para>(4,0)</para><para>(3,3)</para><para>(0,1)</para></problem><solution><para>(3,3)</para></solution></exercise></section><!-- Question 10 -->
<list class="os-raise-noindent" start="10" type="enumerated">
  <item>Solve the system of equations by graphing: \(\left\{\begin{array}{l}2x - 4y = 8\\x + 3y = 9\end{array}\right.\)</item>
</list>
<div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>
<section class="check-understanding"><exercise data-content-id="df3a9916-9609-40e8-96e8-de3741236d91"><problem><newline/><para>Multiple Choice:</para><para>(6,1)</para><para>(4,0)</para><para>(-2,0)</para><para>(8,2)</para></problem><solution><para>(6,1)</para></solution></exercise></section><!-- Question 11 -->
<list class="os-raise-noindent" start="11" type="enumerated">
  <item>A bakery charges $2 per croissant and $4 per muffin. One day, they charge $42 in total and sell 15 baked goods. How many croissants and muffins did they sell?</item>
</list>

<div class="os-raise-ib-desmos-gc" data-schema-version="1.0" data-left="-2" data-right="20" data-top="20" data-bottom="-2"/>

<section class="check-understanding"><exercise data-content-id="9e9ade08-25a7-44cc-8681-d0c47f2f2da0"><problem><newline/><para>Multiple Choice:</para><para>5 croissants and 10 muffins</para><para>9 croissants and 6 muffins</para><para>10 croissants and 5 muffins</para><para>8 croissants and 7 muffins</para></problem><solution><para>9 croissants and 6 muffins</para></solution></exercise></section><!-- Question 12 -->
<list class="os-raise-noindent" start="12" type="enumerated">
  <item>A pet store sells mice for $7 each and gerbils for $9 each. They sell 17 animals for a total of $137. How many mice and gerbils did they sell?</item>
</list>
<div class="os-raise-ib-desmos-gc" data-schema-version="1.0" data-left="-2" data-right="20" data-top="20" data-bottom="-2"/>
<section class="check-understanding"><exercise data-content-id="59fc72e4-1b49-40e3-aedd-6a834435cefa"><problem><newline/><para>Multiple Choice:</para><para>15 mice and 2 gerbils</para><para>8 mice and 9 gerbils</para><para>7 mice and 10 gerbils</para><para>6 mice and 11 gerbils</para></problem><solution><para>8 mice and 9 gerbils</para></solution></exercise></section></section>
</content>
</document>
