  <content>
    <section class="practice" id="sect-00001">
<note class="link-to-learning" id="note-00001">
        <para id="para-00001">Access the <link url="https://k12.openstax.org/contents/raise/resources/b62c9150250bf52d6cc37569213ab516e0090dca">Desmos
        guide PDF</link> for tips on solving problems with the Desmos graphing calculator.</para>
      </note>


      <!-- Directions -->
      <para id="para-00002">In 1 - 4, determine if the following points are solutions to the given
        system of equations.</para>

        <exercise id="_1055a4fc-c177-493d-97d8-bf3dbeb17e02" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00003">Determine if the point is a solution to the system of equations:
              <m:math display="inline"><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
            <para id="para-00004">Multiple Choice:</para>
            <para id="para-00005">(3,1)</para>
            <para id="para-00006">(-3,4)</para>
            <para id="para-00007">(8/7, 6/7)</para>
            <para id="para-00008">(1, 3/4)</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00009">Correct! Replacing x with 3 and y with 1 in both equations makes both equations true.</para>
            </solution>
        </exercise>
        <exercise id="_141cdbc2-ad03-4115-afec-487a5b05ab4c" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00010">Determine if the point is a solution to the system of equations:
              <m:math display="inline"><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
            <para id="para-00011">Multiple Choice:</para>
            <para id="para-00012">(3,1)</para>
            <para id="para-00013">(-3,4)</para>
            <para id="para-00014">(8/7, 6/7)</para>
            <para id="para-00015">(1, 3/4)</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00016">Correct! Replacing x with 3 and y with 1 in both equations makes both equations true.</para>
            </solution>
        </exercise>
        <exercise id="d0ec0578-6e89-47cb-adea-5d9c6dca5e00" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00017">Determine if the point is a solution to the system of equations:
              <m:math display="inline"><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
            <para id="para-00018">Multiple Choice:</para>
            <para id="para-00019">(3,1)</para>
            <para id="para-00020">(-3,4)</para>
            <para id="para-00021">(8/7, 6/7)</para>
            <para id="para-00022">(1, 3/4)</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00023">Correct! Replacing x with 3 and y with 1 in both equations makes both equations true.</para>
            </solution>
        </exercise>
        <exercise id="_983346d9-18df-447b-9cdc-a373ad6d48d3" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00024">Determine if the point is a solution to the system of equations:
              <m:math display="inline"><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
            <para id="para-00025">Multiple Choice:</para>
            <para id="para-00026">(3,1)</para>
            <para id="para-00027">(-3,4)</para>
            <para id="para-00028">(<m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>8</m:mn></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>6</m:mn></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac></m:mrow></m:math>)</para>
            <para id="para-00029">(1, <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math>)</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00030">Answer</para>
            </solution>
        </exercise>


 
        <exercise id="_26e7af8f-b850-444d-9fb7-bd02e90ede73" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00031">Solve the system of equations by graphing: \(\left\{\begin{array}{l}3x + y = -3\\2x +
              3y = 5\end{array}\right.\)</para>
          <media alt="">
          <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
            </media>
            <para id="para-00032">Multiple Choice:</para>
            <para id="para-00033">(-2,3)</para>
            <para id="para-00034">(0,-3)</para>
            <para id="para-00035">(-3,6)</para>
            <para id="para-00036">(4,-1)</para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00037">Answer</para>
          </solution>
        </exercise>

<!-- Question 6 -->
        <exercise id="_39eb3a30-dad1-4781-b9f1-d0425a886b16" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00038">Solve the system of equations by graphing: \(\left\{\begin{array}{l}y = x + 2\\y = -2x
              + 2\end{array}\right.\)</para>
        <media alt="">
          <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
        </media>
            <para id="para-00039">Multiple Choice:</para>
            <para id="para-00040">(2,0)</para>
            <para id="para-00041">(-1,4)</para>
            <para id="para-00042">(0,2)</para>
            <para id="para-00043">(-2,0)</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00044">Answer</para>
          </solution>
        </exercise>
<!-- Question 7 -->

        <exercise id="aa410934-3bff-419f-a3b7-87cc2575d70c" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00045">Solve the system of equations by graphing: \(\left\{\begin{array}{l}y = \frac{3}{2}x +
              1\\y = -\frac{1}{2}x + 5\end{array}\right.\)</para>
          <media alt="">
          <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
            </media>
            <para id="para-00046">Multiple Choice:</para>
            <para id="para-00047">(4,3)</para>
            <para id="para-00048">(0,1)</para>
            <para id="para-00049">(0,5)</para>
            <para id="para-00050">(2,4)</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00051">Answer</para>
          </solution>
        </exercise>
  <!-- Question 8 -->

        <exercise id="_51654b4a-b819-4b70-800b-2141bb4cf1d4" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00052">Solve the system of equations by graphing: \(\left\{\begin{array}{l}x + y = -4\\-x +
              2y = -2\end{array}\right.\)</para>
          <media alt="">
          <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
            </media>
            <para id="para-00053">Multiple Choice:</para>
            <para id="para-00054">(2,0)</para>
            <para id="para-00055">(-1,0)</para>
            <para id="para-00056">(4,1)</para>
            <para id="para-00057">(-2,-2)</para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00058">Answer</para>
          </solution>
        </exercise>

<!-- Question 9 -->
        <exercise id="_7b9c0347-06f5-42e1-9185-c7c8dfa32680" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00059">Solve the system of equations by graphing: \(\left\{\begin{array}{l}-2x + 3y = 3\\x +
              3y = 12\end{array}\right.\)</para>
          <media alt="">
          <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
            </media>
            <para id="para-00060">Multiple Choice:</para>
            <para id="para-00061">(6,2)</para>
            <para id="para-00062">(4,0)</para>
            <para id="para-00063">(3,3)</para>
            <para id="para-00064">(0,1)</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00065">Answer</para>
          </solution>
        </exercise>

      <!-- Question 10 -->
        <exercise id="df3a9916-9609-40e8-96e8-de3741236d91" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00066">Solve the system of equations by graphing: \(\left\{\begin{array}{l}2x - 4y = 8\\x +
              3y = 9\end{array}\right.\)</para>
          <media alt="">
          <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
            </media>
            <para id="para-00067">Multiple Choice:</para>
            <para id="para-00068">(6,1)</para>
            <para id="para-00069">(4,0)</para>
            <para id="para-00070">(-2,0)</para>
            <para id="para-00071">(8,2)</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00072">Answer</para>
          </solution>
        </exercise>

<!-- Question 11 -->
        <exercise id="_9e9ade08-25a7-44cc-8681-d0c47f2f2da0" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00073">A bakery charges $2 per croissant and $4 per muffin. One day, they charge $42 in total
              and sell 15 baked goods. How many croissants and muffins did they sell?</para>
          <media alt="">
          <iframe src="../../media/desmos/7104a4516ff3633e4d48fe32be9394de21f11be0.html" width="500" height="400"/>
          </media>
            <para id="para-00074">Multiple Choice:</para>
            <para id="para-00075">5 croissants and 10 muffins</para>
            <para id="para-00076">9 croissants and 6 muffins</para>
            <para id="para-00077">10 croissants and 5 muffins</para>
            <para id="para-00078">8 croissants and 7 muffins</para>
          </problem>
          <solution id="sol-00011">
            <para id="para-00079">Answer</para>
          </solution>
        </exercise>

<!-- Question 12 -->
        <exercise id="_59fc72e4-1b49-40e3-aedd-6a834435cefa" class="multiple-choice">
          <problem id="prob-00012">
            <para id="para-00080">A pet store sells mice for $7 each and gerbils for $9 each. They sell 17 animals for a
              total of $137. How many mice and gerbils did they sell?</para>
          <media alt="">
          <iframe src="../../media/desmos/7104a4516ff3633e4d48fe32be9394de21f11be0.html" width="500" height="400"/>
            </media>
            <para id="para-00081">Multiple Choice:</para>
            <para id="para-00082">15 mice and 2 gerbils</para>
            <para id="para-00083">8 mice and 9 gerbils</para>
            <para id="para-00084">7 mice and 10 gerbils</para>
            <para id="para-00085">6 mice and 11 gerbils</para>
          </problem>
          <solution id="sol-00012">
            <para id="para-00086">Answer</para>
          </solution>
        </exercise>
    </section>
