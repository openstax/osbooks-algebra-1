<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.1.5 Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00377</md:content-id>
    <md:title>2.1.5 Practice</md:title>
    <md:uuid>9d7ae517-64e6-418d-823a-7f77f7bfb945</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001">
<div class="os-raise-familysupport">
  <para id="para-00001">Access the <link url="https://k12.openstax.org/contents/raise/resources/b62c9150250bf52d6cc37569213ab516e0090dca">Desmos guide PDF</link> for tips on solving problems with the Desmos graphing calculator.</para>
</div>


<!-- Directions -->
<para id="para-00002">In 1 - 4, determine if the following points are solutions to the given system of equations.</para>
<section class="check-understanding" id="sect-00002"><exercise id="1055a4fc-c177-493d-97d8-bf3dbeb17e02" class="multiple-choice" id="exer-00001"><problem id="prob-00001"><para id="para-00003">Determine if the point is a solution to the system of equations: \(\left\{\begin{array}{l}2x-6y=0\\3x-4y=5\end{array}\right.\)</para>
      <para id="para-00004">Multiple Choice:</para><para id="para-00005">(3,1)</para><para id="para-00006">(-3,4)</para><para id="para-00007">(8/7, 6/7)</para><para id="para-00008">(1, 3/4)</para></problem><solution id="sol-00001"/></exercise><exercise id="141cdbc2-ad03-4115-afec-487a5b05ab4c" class="multiple-choice" id="exer-00002"><problem id="prob-00002"><para id="para-00009">Determine if the point is a solution to the system of equations: \(\left\{\begin{array}{l}x-6y=0\\3x-4y=5\end{array}\right.\)</para>
      <para id="para-00010">Multiple Choice:</para><para id="para-00011">(3,1)</para><para id="para-00012">(-3,4)</para><para id="para-00013">(8/7, 6/7)</para><para id="para-00014">(1, 3/4)</para></problem><solution id="sol-00002"/></exercise><exercise id="d0ec0578-6e89-47cb-adea-5d9c6dca5e00" class="multiple-choice" id="exer-00003"><problem id="prob-00003"><para id="para-00015">Determine if the point is a solution to the system of equations: \(\left\{\begin{array}{l}x + y = 2\\y = \frac{3}{4}x\end{array}\right.\)</para>
      <para id="para-00016">Multiple Choice:</para><para id="para-00017">(3,1)</para><para id="para-00018">(-3,4)</para><para id="para-00019">(8/7, 6/7)</para><para id="para-00020">(1, 3/4)</para></problem><solution id="sol-00003"/></exercise><exercise id="983346d9-18df-447b-9cdc-a373ad6d48d3" class="multiple-choice" id="exer-00004"><problem id="prob-00004"><para id="para-00021">Determine if the point is a solution to the system of equations: \(\left\{\begin{array}{l}4x + 4y = 7\\y = \frac{3}{4}x\end{array}\right.\)</para>
      <para id="para-00022">Multiple Choice:</para><para id="para-00023">(3,1)</para><para id="para-00024">(-3,4)</para><para id="para-00025">(\(\frac{8}{7}\), \(\frac{6}{7}\))</para><para id="para-00026">(1, \(\frac{3}{4}\))</para></problem><solution id="sol-00004"/></exercise></section><list class="os-raise-noindent" start="5" type="enumerated" id="list-00001">
  <item>Solve the system of equations by graphing: \(\left\{\begin{array}{l}3x + y = -3\\2x + 3y = 5\end{array}\right.\)</item>
</list>
<div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>
<section class="check-understanding" id="sect-00003"><exercise id="26e7af8f-b850-444d-9fb7-bd02e90ede73" class="multiple-choice" id="exer-00005"><problem id="prob-00005"><para id="para-00027">Multiple Choice:</para><para id="para-00028">(-2,3)</para><para id="para-00029">(0,-3)</para><para id="para-00030">(-3,6)</para><para id="para-00031">(4,-1)</para></problem><solution id="sol-00005"/></exercise></section><!-- Question 6 -->
<list class="os-raise-noindent" start="6" type="enumerated" id="list-00002">
  <item>Solve the system of equations by graphing: \(\left\{\begin{array}{l}y = x + 2\\y = -2x + 2\end{array}\right.\)</item>
</list>
<div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>
<section class="check-understanding" id="sect-00004"><exercise id="39eb3a30-dad1-4781-b9f1-d0425a886b16" class="multiple-choice" id="exer-00006"><problem id="prob-00006"><para id="para-00032">Multiple Choice:</para><para id="para-00033">(2,0)</para><para id="para-00034">(-1,4)</para><para id="para-00035">(0,2)</para><para id="para-00036">(-2,0)</para></problem><solution id="sol-00006"/></exercise></section><!-- Question 7 -->
<list class="os-raise-noindent" start="7" type="enumerated" id="list-00003">
  <item>Solve the system of equations by graphing: \(\left\{\begin{array}{l}y = \frac{3}{2}x + 1\\y = -\frac{1}{2}x + 5\end{array}\right.\)</item>
</list>
<div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>
<section class="check-understanding" id="sect-00005"><exercise id="aa410934-3bff-419f-a3b7-87cc2575d70c" class="multiple-choice" id="exer-00007"><problem id="prob-00007"><para id="para-00037">Multiple Choice:</para><para id="para-00038">(4,3)</para><para id="para-00039">(0,1)</para><para id="para-00040">(0,5)</para><para id="para-00041">(2,4)</para></problem><solution id="sol-00007"/></exercise></section><!-- Question 8 -->
<list class="os-raise-noindent" start="8" type="enumerated" id="list-00004">
  <item>Solve the system of equations by graphing: \(\left\{\begin{array}{l}x + y = -4\\-x + 2y = -2\end{array}\right.\)</item>
</list>
<div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>
<section class="check-understanding" id="sect-00006"><exercise id="51654b4a-b819-4b70-800b-2141bb4cf1d4" class="multiple-choice" id="exer-00008"><problem id="prob-00008"><para id="para-00042">Multiple Choice:</para><para id="para-00043">(2,0)</para><para id="para-00044">(-1,0)</para><para id="para-00045">(4,1)</para><para id="para-00046">(-2,-2)</para></problem><solution id="sol-00008"/></exercise></section><!-- Question 9 -->
<list class="os-raise-noindent" start="9" type="enumerated" id="list-00005">
  <item>Solve the system of equations by graphing: \(\left\{\begin{array}{l}-2x + 3y = 3\\x + 3y = 12\end{array}\right.\)</item>
</list>
<div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>
<section class="check-understanding" id="sect-00007"><exercise id="7b9c0347-06f5-42e1-9185-c7c8dfa32680" class="multiple-choice" id="exer-00009"><problem id="prob-00009"><para id="para-00047">Multiple Choice:</para><para id="para-00048">(6,2)</para><para id="para-00049">(4,0)</para><para id="para-00050">(3,3)</para><para id="para-00051">(0,1)</para></problem><solution id="sol-00009"/></exercise></section><!-- Question 10 -->
<list class="os-raise-noindent" start="10" type="enumerated" id="list-00006">
  <item>Solve the system of equations by graphing: \(\left\{\begin{array}{l}2x - 4y = 8\\x + 3y = 9\end{array}\right.\)</item>
</list>
<div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>
<section class="check-understanding" id="sect-00008"><exercise id="df3a9916-9609-40e8-96e8-de3741236d91" class="multiple-choice" id="exer-00010"><problem id="prob-00010"><para id="para-00052">Multiple Choice:</para><para id="para-00053">(6,1)</para><para id="para-00054">(4,0)</para><para id="para-00055">(-2,0)</para><para id="para-00056">(8,2)</para></problem><solution id="sol-00010"/></exercise></section><!-- Question 11 -->
<list class="os-raise-noindent" start="11" type="enumerated" id="list-00007">
  <item>A bakery charges $2 per croissant and $4 per muffin. One day, they charge $42 in total and sell 15 baked goods. How many croissants and muffins did they sell?</item>
</list>

<div class="os-raise-ib-desmos-gc" data-schema-version="1.0" data-left="-2" data-right="20" data-top="20" data-bottom="-2"/>

<section class="check-understanding" id="sect-00009"><exercise id="9e9ade08-25a7-44cc-8681-d0c47f2f2da0" class="multiple-choice" id="exer-00011"><problem id="prob-00011"><para id="para-00057">Multiple Choice:</para><para id="para-00058">5 croissants and 10 muffins</para><para id="para-00059">9 croissants and 6 muffins</para><para id="para-00060">10 croissants and 5 muffins</para><para id="para-00061">8 croissants and 7 muffins</para></problem><solution id="sol-00011"/></exercise></section><!-- Question 12 -->
<list class="os-raise-noindent" start="12" type="enumerated" id="list-00008">
  <item>A pet store sells mice for $7 each and gerbils for $9 each. They sell 17 animals for a total of $137. How many mice and gerbils did they sell?</item>
</list>
<div class="os-raise-ib-desmos-gc" data-schema-version="1.0" data-left="-2" data-right="20" data-top="20" data-bottom="-2"/>
<section class="check-understanding" id="sect-00010"><exercise id="59fc72e4-1b49-40e3-aedd-6a834435cefa" class="multiple-choice" id="exer-00012"><problem id="prob-00012"><para id="para-00062">Multiple Choice:</para><para id="para-00063">15 mice and 2 gerbils</para><para id="para-00064">8 mice and 9 gerbils</para><para id="para-00065">7 mice and 10 gerbils</para><para id="para-00066">6 mice and 11 gerbils</para></problem><solution id="sol-00012"/></exercise></section></section>
</content>
