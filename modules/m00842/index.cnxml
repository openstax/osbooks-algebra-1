                    <entry/>
                  </row>
                  <row>
                    <entry align="center">6</entry>
                    <entry>7.50</entry>
                    <entry>6.00</entry>
                    <entry/>
                    <entry/>
                  </row>
                  <row>
                    <entry align="center">7</entry>
                    <entry>8.75</entry>
                    <entry>7.25</entry>
                    <entry/>
                    <entry/>
                  </row>
                  <row>
                    <entry align="center">8</entry>
                    <entry>10.00</entry>
                    <entry>8.50</entry>
                    <entry/>
                    <entry/>
                  </row>
                  <row>
                    <entry align="center">9</entry>
                    <entry>11.25</entry>
                    <entry>9.75</entry>
                    <entry>8.00</entry>
                    <entry/>
                  </row>
                  <row>
                    <entry align="center">10</entry>
