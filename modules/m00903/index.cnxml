<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Using Tables to Find Function Rules</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00903</md:content-id>
    <md:title>Using Tables to Find Function Rules</md:title>
    <md:uuid>9d4f41c8-b247-44e7-8251-bb4224155828</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Activity</title>
      <para id="para-00060">1. A square that has a side length of 9 cm has an area of 81 <m:math display="inline">
            <m:mrow>
              <m:mi>c</m:mi>
              <m:msup>
                <m:mi>m</m:mi>
                <m:mn>2</m:mn>
              </m:msup>
            </m:mrow>
          </m:math>. The
          relationship between the side length and the area of the square is a function.</para><para id="para-00061">For
          questions a-e use the table by answering each question. </para>
      <table class="unnumbered os-raise-midsizetable" id="table-00001">
        <tgroup cols="2">
          <tbody>
            <row>
              <entry>
                <para id="para-00001"><emphasis>Side Length <m:math display="inline">
                      <m:mrow>
                        <m:mo stretchy="false">(</m:mo>
                        <m:mi>c</m:mi>
                        <m:mi>m</m:mi>
                        <m:mo stretchy="false">)</m:mo>
                      </m:mrow>
                    </m:math></emphasis></para>
              </entry>
              <entry>
                <para id="para-00002"><emphasis>Area <m:math display="inline">
                      <m:mrow>
                        <m:mo stretchy="false">(</m:mo>
                        <m:mi>c</m:mi>
                        <m:msup>
                          <m:mi>m</m:mi>
                          <m:mn>2</m:mn>
                        </m:msup>
                        <m:mo stretchy="false">)</m:mo>
                      </m:mrow>
                    </m:math></emphasis></para>
              </entry>
            </row>
            <row>
              <entry>
                <para id="para-00003">1</para>
              </entry>
              <entry>a. _______</entry>
            </row>
            <row>
              <entry>
                <para id="para-00004">2</para>
              </entry>
              <entry>b. _______</entry>
            </row>
            <row>
              <entry>
                <para id="para-00005">4</para>
              </entry>
              <entry>c. _______</entry>
            </row>
            <row>
              <entry>
                <para id="para-00006">6</para>
              </entry>
              <entry>d. _______</entry>
            </row>
            <row>
              <entry>
                <para id="para-00007"><m:math>
                    <m:mrow>
                      <m:mi>s</m:mi>
                    </m:mrow>
                  </m:math></para></entry>
              <entry> e. _______ </entry>
            </row>
          </tbody>
        </tgroup>
      </table>

      <exercise id="_60bc1e49-59df-48af-9cf1-c6f24dbad542" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00008">a. What is the area in <m:math display="inline">
              <m:mrow>
                <m:mi>c</m:mi>
                <m:msup>
                  <m:mi>m</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math>
            when the side length is <m:math display="inline">
              <m:mrow>
                <m:mn>1cm</m:mn>
              </m:mrow>
            </m:math>?</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00009">The area is 1 <m:math display="inline">
              <m:mrow>
                <m:mi>c</m:mi>
                <m:msup>
                  <m:mi>m</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math>
            when the side length is <m:math display="inline">
              <m:mrow>
                <m:mn>1cm</m:mn>
              </m:mrow>
            </m:math>.</para>
          
        </solution>
      </exercise>
      <exercise id="d734b03b-2f68-4d9a-ac01-c45de8b9bd8e" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00011">b. What is the area in <m:math display="inline">
              <m:mrow>
                <m:mi>c</m:mi>
                <m:msup>
                  <m:mi>m</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math>
            when the side length is <m:math display="inline">
              <m:mrow>
                <m:mn>2cm</m:mn>
              </m:mrow>
            </m:math>?</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00012">The area is 4 <m:math display="inline">
              <m:mrow>
                <m:mi>c</m:mi>
                <m:msup>
                  <m:mi>m</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math>
            when the side length is <m:math display="inline">
              <m:mrow>
                <m:mn>2cm</m:mn>
              </m:mrow>
            </m:math>.</para>
         
        </solution>
      </exercise>
      <exercise id="_5ad92f96-7e7a-4767-824e-8d30915336d7" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00014">c. What is the area in <m:math display="inline">
              <m:mrow>
                <m:mi>c</m:mi>
                <m:msup>
                  <m:mi>m</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math>
            when the side length is <m:math display="inline">
              <m:mrow>
                <m:mn>4cm</m:mn>
              </m:mrow>
            </m:math>?</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00015">The area is <m:math display="inline">
              <m:mrow>
                <m:msup>
                  <m:mn>16cm</m:mn>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math>
            when the side length is <m:math display="inline">
              <m:mrow>
                <m:mn>4cm</m:mn>
              </m:mrow>
            </m:math>.</para>
        
        </solution>
      </exercise>
      <exercise id="_042e8ace-36ac-417f-b4a8-f3abc655352e" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00017">d. What is the area in <m:math display="inline">
              <m:mrow>
                <m:mi>c</m:mi>
                <m:msup>
                  <m:mi>m</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math>
            when the side length is <m:math display="inline">
              <m:mrow>
                <m:mn>6cm</m:mn>
              </m:mrow>
            </m:math>?</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00018">The area is <m:math display="inline">
              <m:mrow>
                <m:msup>
                  <m:mn>36cm</m:mn>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math>
            when the side length is <m:math display="inline">
              <m:mrow>
                <m:mn>6cm</m:mn>
              </m:mrow>
            </m:math>.</para>
        
        </solution>
      </exercise>

      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00005">
          <para id="para-00020">e. Write a rule for a function, <m:math display="inline">
              <m:mrow>
                <m:mi>A</m:mi>
              </m:mrow>
            </m:math>, that gives the area of
            the square in <m:math display="inline">
              <m:mrow>
                <m:mi>c</m:mi>
                <m:msup>
                  <m:mi>m</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math>
            when the side length is <m:math display="inline">
              <m:mrow>
                <m:mi>s</m:mi>
              </m:mrow>
            </m:math> <m:math display="inline">
              <m:mrow>
                <m:mi>c</m:mi>
                <m:mi>m</m:mi>
              </m:mrow>
            </m:math>.</para>

        </problem>
        <solution id="sol-00005">
          <para id="para-00021">Compare your answer: </para>
          <para id="para-00022"><m:math>
              <m:mrow>
                <m:mi>A</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>s</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:msup>
                  <m:mi>s</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00006">
          <para id="para-00023">f. What does <m:math display="inline">
              <m:mrow>
                <m:mi>A</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>
            represent in this situation? What is its value? Write your answers, then click <emphasis>
            solution</emphasis> to compare your answer.</para>

        </problem>
        <solution id="sol-00006">
          <para id="para-00024">Compare your answer: </para>
          <para id="para-00025"><m:math display="inline">
              <m:mrow>
                <m:mi>A</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math> is the
            area of the square in cm2 when the side length is 2 cm. Its value is 4.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <media alt="insert alt text">
        <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
      </media>
      <exercise id="exer-00003">
        <problem id="prob-00007">      <para id="para-00062">g. Sketch a graph of this function. Use the desmos graphing tool or technology outside
          the course. </para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00027">Compare your answer: </para>
          <para id="para-00028">
            <media alt="A graph showing area (cm²) on the y-axis and side length (cm) on the x-axis. The curve rises steeply, illustrating that as side length increases, area increases rapidly. Points are marked at side lengths 1, 2, 4, and 6 cm.">
              <image mime-type="image/svg+xml" src="../../media/Algebra-1_04_07_06_01.svg"/>
            </media>

          </para>
        </solution>
      </exercise>

      <para id="para-00063">2. A roll of paper that is 3 feet wide can be cut to any length. <media alt="Roll of paper, slightly unrolled. Its width is 3 feet.">
            <image mime-type="image/jpeg" src="../../media/Algebra-1_04_07_06_02.jpg"/>
          </media></para>

      <exercise id="d950e5f9-6c9d-4634-914a-7b1c2e36f47b" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00029">a. If we cut a length of 2.5 feet, what is the perimeter of the paper?
            Enter your answer in feet.<emphasis>Use integers only.</emphasis>
          </para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00030">The perimeter of the paper is 11 feet.</para>
         
        </solution>
      </exercise>

      <para id="para-00032">For questions b-f, keep in mind that the roll of paper is 3 feet wide.
        Complete the table by answering each question.</para>
      <table class="unnumbered os-raise-midsizetable" id="table-00002">
        <tgroup cols="2">
          <tbody>
            <row>
              <entry>
                <emphasis> side length (feet) </emphasis>
              </entry>
              <entry>
                <emphasis> perimeter (feet) </emphasis>
              </entry>
            </row>
            <row>
              <entry>
                <para id="para-00033">1</para>
              </entry>
              <entry>b. _______</entry>
            </row>
            <row>
              <entry>
                <para id="para-00034">2</para>
              </entry>
              <entry>c. _______</entry>
            </row>
            <row>
              <entry>
                <para id="para-00035">6.3</para>
              </entry>
              <entry>d. _______</entry>
            </row>
            <row>
              <entry>
                <para id="para-00036">11</para>
              </entry>
              <entry>f. _______</entry>
            </row>
          </tbody>
        </tgroup>
      </table>

      <exercise id="_911a1006-037e-4c7a-945c-912d511b8773" class="multiple-choice">
        <problem id="prob-00009">
          <para id="para-00037">b. If we cut a length of 1 foot, what is the perimeter of the paper to
            the nearest whole foot? </para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00038">The perimeter is 8 feet when the side length is <m:math display="inline">
              <m:mrow>
                <m:mn>1cm</m:mn>
              </m:mrow>
            </m:math> <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>1</m:mn>
                <m:mo>+</m:mo>
                <m:mn>3</m:mn>
                <m:mo>+</m:mo>
                <m:mn>1</m:mn>
                <m:mo>+</m:mo>
                <m:mn>3</m:mn>
                <m:mo>=</m:mo>
                <m:mn>8</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
         
        </solution>
      </exercise>
      <exercise id="_60456465-1eca-4c06-ab98-33262f38a76c" class="multiple-choice">
        <problem id="prob-00010">
          <para id="para-00040">c. To the nearest whole foot, what is the perimeter when the side
            length is 2 feet? </para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00041">The perimeter is 10 feet when the side length is <m:math display="inline">
              <m:mrow>
                <m:mn>2cm</m:mn>
              </m:mrow>
            </m:math> <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>2</m:mn>
                <m:mo>+</m:mo>
                <m:mn>3</m:mn>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
                <m:mo>+</m:mo>
                <m:mn>3</m:mn>
                <m:mo>=</m:mo>
                <m:mn>10</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
         
        </solution>
      </exercise>
      <exercise id="ea0b7e59-c525-423d-9535-2e709157024e" class="multiple-choice">
        <problem id="prob-00011">
          <para id="para-00043">d. What is the exact perimeter, in feet, when the side length is 6.3
            feet? </para>
        </problem>
        <solution id="sol-00011">
          <para id="para-00044">The perimeter is 18.6 feet when the side length is <m:math display="inline">
              <m:mrow>
                <m:mn>6.3cm</m:mn>
              </m:mrow>
            </m:math> <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>6.3</m:mn>
                <m:mo>+</m:mo>
                <m:mn>3</m:mn>
                <m:mo>+</m:mo>
                <m:mn>6.3</m:mn>
                <m:mo>+</m:mo>
                <m:mn>3</m:mn>
                <m:mo>=</m:mo>
                <m:mn>18.6</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
         
        </solution>
      </exercise>
      <exercise id="eccf0aa0-7098-4211-a69a-d04113c0103d" class="multiple-choice">
        <problem id="prob-00012">
          <para id="para-00046">e. What is the perimeter, to the nearest whole foot,when the side
            length is 11 feet? </para>
        </problem>
        <solution id="sol-00012">
          <para id="para-00047">The perimeter is 28 feet when the side length is <m:math display="inline">
              <m:mrow>
                <m:mn>11cm</m:mn>
              </m:mrow>
            </m:math> <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>11</m:mn>
                <m:mo>+</m:mo>
                <m:mn>3</m:mn>
                <m:mo>+</m:mo>
                <m:mn>11</m:mn>
                <m:mo>+</m:mo>
                <m:mn>3</m:mn>
                <m:mo>=</m:mo>
                <m:mn>28</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>. </para>
        
        </solution>
      </exercise>

      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00013">
          <para id="para-00049">f. Write a rule for a function, P, that gives the perimeter of the
            paper in feet when the side length in feet is <emphasis>l</emphasis>.</para>
        </problem>
        <solution id="sol-00013">

          <para id="para-00050">Compare your answer: </para>
          <para id="para-00051"><m:math>
              <m:mrow>
                <m:mi>P</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>l</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mn>6</m:mn>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
                <m:mi>l</m:mi>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00005">
        <problem id="prob-00014">
          <para id="para-00052">g. What does P(11) represent in this situation? What is its value?</para>
        </problem>
        <solution id="sol-00014">

          <para id="para-00053">Compare your answer: </para>
          <para id="para-00054"><m:math display="inline">
              <m:mrow>
                <m:mi>P</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>11</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math> is the
            perimeter of the paper in feet when the paper is cut at a length of 11 feet. Its value
            is 28.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <media alt="insert alt text">
        <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
      </media>
      <exercise id="exer-00006">
        <problem id="prob-00015">      <para id="para-00064">h. Sketch a graph of this function. Use the desmos graphing tool or technology outside
          the course. </para>
       
        </problem>
        <solution id="sol-00015">
          <para id="para-00056">Compare your answer: </para>
          <para id="para-00057">
            <media alt="A line graph showing the relationship between side length (feet) on the x-axis and perimeter (feet) on the y-axis. The line passes through (1, 8), (2, 10), and (6.3, 18.6), indicating a linear increase.">
              <image mime-type="image/svg+xml" src="../../media/Algebra-1_04_07_06_03.svg"/>
            </media>

          </para>
        </solution>
      </exercise>
    </section>
    <section id="sect-00005">
      <title>Video: Writing Function Rules</title>
      <para id="para-00058">Watch the following video to learn more about writing rules with
        function notation.</para>
