<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.4.3: Using Tables to Find Function Rules</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00903</md:content-id>
    <md:title>4.4.3: Using Tables to Find Function Rules</md:title>
    <md:uuid>e5c3befd-f368-4238-981b-e54ef7ca53b0</md:uuid>
  </metadata>
  <content>
  <section><title>Activity</title>
<list class="os-raise-noindent" type="enumerated">
  <item>A square that has a side length of 9 cm has an area of 81 \(cm^2\). The relationship between the side length and the area of the square is a function.
    
    
    For questions a-e use the table by answering each question.
  </item>
</list>
<table class="os-raise-midsizetable">
  <thead>
    <row>
      <entry><emphasis>
        <para>Side Length \((cm)\)</para>
      </emphasis></entry><entry><emphasis>
        <para>Area \((cm^2)\)</para>
      </emphasis></entry></row>
  </thead>
  <tbody>
    <row>
      <entry>
        <para>1</para>
      </entry>
      <entry>a. _______</entry>
    </row>
    <row>
      <entry>
        <para>2</para>
      </entry>
      <entry>b. _______</entry>
    </row>
    <row>
      <entry>
        <para>4</para>
      </entry>
      <entry>c. _______</entry>
    </row>
    <row>
      <entry>
        <para>6</para>
      </entry>
      <entry>d. _______</entry>
    </row>
    <row>
      <entry>
        <para>\(s\)</para>
      </entry>
      <entry>
        e. _______
      </entry>
    </row>
  </tbody>
</table>

<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="3cd5594a-e3af-4409-84fe-d862db2dffdb" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1a-->
  <exercise data-content-id="60bc1e49-59df-48af-9cf1-c6f24dbad542" data-problem-comparator="integer" data-problem-type="input" data-solution="1">
    <problem>
      <para>What is the area in \(cm^2\) when the side length is \(1 cm\)?</para>
      </problem>
    <solution>
      <para>Correct! The area is 1 \(cm^2\) when the side length is \(1 cm\).</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  
  
  <!--Q1b-->
  <exercise data-content-id="d734b03b-2f68-4d9a-ac01-c45de8b9bd8e" data-problem-comparator="integer" data-problem-type="input" data-solution="4">
    <problem>
      <para>What is the area in \(cm^2\) when the side length is \(2 cm\)?</para>
      </problem>
    <solution>
      <para>Correct! The area is 4 \(cm^2\) when the side length is \(2 cm\).</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  
  
  <!--Q1c-->
  <exercise data-content-id="5ad92f96-7e7a-4767-824e-8d30915336d7" data-problem-comparator="integer" data-problem-type="input" data-solution="16">
    <problem>
      <para>What is the area in \(cm^2\) when the side length is \(4 cm\)?</para>
      </problem>
    <solution>
      <para>Correct! The area is \(16 cm^2\) when the side length is \(4 cm\).</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  
  
  <!--Q1d-->
  <exercise data-content-id="042e8ace-36ac-417f-b4a8-f3abc655352e" data-problem-comparator="integer" data-problem-type="input" data-solution="36">
    <problem>
      <para>What is the area in \(cm^2\) when the side length is \(6 cm\)?</para>
      </problem>
    <solution>
      <para>Correct! The area is \(36 cm^2\) when the side length is \(6 cm\).</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  
  
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Write a rule for a function, \(A\), that gives the area of the square in \(cm^2\) when the side length is \(s\) \(cm\).</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(A(s)= s^2\)</para>
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>What does \(A(2)\) represent in this situation? What is its value? Write your answers, then click <emphasis>solution</emphasis> to compare your answer.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(A(2)\) is the area of the square in cm2 when the side length is 2 cm. Its value is 4.</para>
  </solution></exercise>
<!--Interaction End -->

<list class="os-raise-noindent" start="7" type="enumerated">
  <item>Sketch a graph of this function.
    Use the desmos graphing tool or technology outside the course.
  </item>
</list>
<div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>
<example><exercise>
  <problem>
    <para>Select the <emphasis>Solution</emphasis> button to compare your answer: </para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para><figure><media alt=""><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/09ea7f96b3cf45cb99f26dcf599536e434d70294"/></media></figure></para>
</solution></exercise>
</example>


<list class="os-raise-noindent" start="2" type="enumerated">
  <item>A roll of paper that is 3 feet wide can be cut to any length.
  </item>
  <figure><media alt="Roll of paper, slightly unrolled. Its width is 3 feet."><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/add679acbffa6947a9d01c698c7e43b7c7bac3f7"/></media></figure></list>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="b12633d5-ab32-45e2-a42b-cd5852fbcc37" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q2a-->
  <exercise data-content-id="d950e5f9-6c9d-4634-914a-7b1c2e36f47b" data-problem-comparator="integer" data-problem-type="input" data-solution="11">
    <problem>
      <para>If we cut a length of 2.5 feet, what is the perimeter of the paper?
          
          
          Enter your answer in feet. <emphasis>Use integers only.</emphasis>
        </para>
      </problem>
    <solution>
      <para>Correct! The perimeter of the paper is 11 feet. </para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>


<para>For questions b-f, keep in mind that the roll of paper is 3 feet wide. Complete the table by answering each question.</para>

<table class="os-raise-midsizetable">
  <thead>
    <row>
      <entry><emphasis>
        side length (feet)
      </emphasis></entry><entry><emphasis>
        perimeter (feet)
      </emphasis></entry></row>
  </thead>
  <tbody>
    <row>
      <entry>
        <para>1</para>
      </entry>
      <entry>b. _______</entry>
    </row>
    <row>
      <entry>
        <para>2</para>
      </entry>
      <entry>c. _______</entry>
    </row>
    <row>
      <entry>
        <para>6.3</para>
      </entry>
      <entry>d. _______</entry>
    </row>
    <row>
      <entry>
        <para>11</para>
      </entry>
      <entry>f. _______</entry>
    </row>
  </tbody>
</table>


<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="e3787cc9-b342-4739-8e14-eef85a3baf28" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q2b-->
  <exercise data-content-id="911a1006-037e-4c7a-945c-912d511b8773" data-problem-comparator="integer" data-problem-type="input" data-solution="8">
    <problem>
      <para>If we cut a length of 1 foot, what is the perimeter of the paper to the nearest whole foot? 
          
          Enter your answer here:
        </para>
      </problem>
    <solution>
      <para>Correct! The perimeter is 8 feet when the side length is \(1 cm\) \((1+3+1+3=8)\). </para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  
  
  <!--Q2c-->
  <exercise data-content-id="60456465-1eca-4c06-ab98-33262f38a76c" data-problem-comparator="integer" data-problem-type="input" data-solution="10">
    <problem>
      <para>To the nearest whole foot, what is the perimeter when the side length is 2 feet?
          

          Enter your answer here:
        </para>
      </problem>
    <solution>
      <para>Correct! The perimeter is 10 feet when the side length is \(2 cm\) \((2+3+2+3=10)\). </para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  
  
  <!--Q2d-->
  <exercise data-content-id="ea0b7e59-c525-423d-9535-2e709157024e" data-problem-comparator="float" data-problem-type="input" data-solution="18.6">
    <problem>
      <para>What is the exact perimeter, in feet, when the side length is 6.3 feet?
          

          Enter your answer here:
        </para>
      </problem>
    <solution>
      <para>Correct! The perimeter is 18.6 feet when the side length is \(6.3 cm\) \((6.3+3+6.3+3=18.6)\). </para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  
  
  <!--Q2e-->
  <exercise data-content-id="eccf0aa0-7098-4211-a69a-d04113c0103d" data-problem-comparator="integer" data-problem-type="input" data-solution="28">
    <problem>
      <para>What is the perimeter, to the nearest whole foot,when the side length is 11 feet?
          

          Enter your answer here:
        </para>
      </problem>
    <solution>
      <para>Correct! The perimeter is 28 feet when the side length is \(11 cm\) \((11+3+11+3=28)\).
      </para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Write a rule for a function, P, that gives the perimeter of the paper in feet when the side length in feet is <emphasis>l</emphasis>.</para>
    </problem><solution>
    
    <para>Enter your answer here:
    </para>
  <para>Compare your answer:</para>
    <para>\(P(l)=6+2l\)</para>
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>What does P(11) represent in this situation? What is its value?</para>
    </problem><solution>
    
    <para>Enter your answer here:
    </para>
  <para>Compare your answer:</para>
    <para>\(P(11)\) is the perimeter of the paper in feet when the paper is cut at a length of 11 feet. Its value is 28.</para>
  </solution></exercise>
<!--Interaction End -->


