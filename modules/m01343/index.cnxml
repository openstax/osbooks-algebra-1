<exercise id="_008191ca-6f8e-4a92-9d5d-a47673938ec1" class="multiple-choice"><problem id="prob-00013"><para id="para-00086">What is <m:math display="inline"><m:mrow><m:mi>v</m:mi></m:mrow></m:math> when <m:math display="inline"><m:mrow><m:mi>d</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math>?</para>
          </problem><solution id="sol-00013"><para id="para-00087">Correct! <m:math display="inline"><m:mrow><m:mi>v</m:mi><m:mo>=</m:mo><m:mn>50</m:mn><m:mo>,</m:mo><m:mn>000</m:mn></m:mrow></m:math>
            <m:math display="inline"><m:mrow><m:mi>v</m:mi><m:mo>=</m:mo><m:mn>400</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mrow><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:msup></m:mrow></m:math>
            <m:math display="inline"><m:mrow><m:mi>v</m:mi><m:mo>=</m:mo><m:mn>400</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mrow><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:msup></m:mrow></m:math>
            <m:math display="inline"><m:mrow><m:mi>v</m:mi><m:mo>=</m:mo><m:mn>400</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mi>·</m:mi><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math>
            <m:math display="inline"><m:mrow><m:mi>v</m:mi><m:mo>=</m:mo><m:mn>400</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mi>·</m:mi><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math>
            <m:math display="inline"><m:mrow><m:mi>v</m:mi><m:mo>=</m:mo><m:mn>50</m:mn><m:mo>,</m:mo><m:mn>000</m:mn></m:mrow></m:math>
          <m:math display="inline"><m:mrow><m:mi>v</m:mi><m:mo>=</m:mo><m:mn>50</m:mn><m:mo>,</m:mo><m:mn>000</m:mn></m:mrow></m:math>
        </para><para id="para-00088">Nice try! The correct answer is: <m:math display="inline"><m:mrow><m:mi>v</m:mi><m:mo>=</m:mo><m:mn>50</m:mn><m:mo>,</m:mo><m:mn>000</m:mn></m:mrow></m:math>
            <m:math display="inline"><m:mrow><m:mi>v</m:mi><m:mo>=</m:mo><m:mn>400</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mrow><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:msup></m:mrow></m:math>
            <m:math display="inline"><m:mrow><m:mi>v</m:mi><m:mo>=</m:mo><m:mn>400</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mrow><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:msup></m:mrow></m:math>
            <m:math display="inline"><m:mrow><m:mi>v</m:mi><m:mo>=</m:mo><m:mn>400</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mi>·</m:mi><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math>
            <m:math display="inline"><m:mrow><m:mi>v</m:mi><m:mo>=</m:mo><m:mn>400</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mi>·</m:mi><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math>
            <m:math display="inline"><m:mrow><m:mi>v</m:mi><m:mo>=</m:mo><m:mn>50</m:mn><m:mo>,</m:mo><m:mn>000</m:mn></m:mrow></m:math>
