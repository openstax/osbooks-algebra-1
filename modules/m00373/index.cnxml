<exercise data-wait-for-event="RFM1">
  <problem>
    <title>Extending Your Thinking</title>
    <para> Make up an equation for \(x\) whose two lines that intersect at \((4,1)\). </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(x=4\)</para>
  </solution></exercise>
<!--End interaction-->

<!--Q2-->
<exercise data-wait-for-event="RFM1">
  <problem>
    <para> Make up an equation for \(y\) whose two lines that intersect at \((4,1)\). </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(y=1\)</para>
  </solution></exercise>
<!--End interaction-->

<!--Q3-->
<exercise data-wait-for-event="RFM1">
  <problem>
    <para> Make up equations for three lines whose intersection points form a triangle with vertices at \((−4,0)\)
        ,\((2,9)\), and \((6,5)\). </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>Your answer may vary, but here is a sample.</para>
    \(y=32x+6\), \(y=−x+11\), \(y=12x+2\)
  </solution></exercise>
