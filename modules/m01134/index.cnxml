  <content>
  <section><title>Self Check</title>
<para>Given the table below, what would be the next term in the sequence?</para>
<table class="os-raise-horizontaltable">
  <thead/>
  <tbody>
    <row>
      <entry scope="row" class="emphasis">
        \(x\)
      </entry>
      <entry>
        1
      </entry>
      <entry>
        2
      </entry>
      <entry>
        3
      </entry>
      <entry>
        4
      </entry>
      <entry>
        5
      </entry>
    </row>
    <row>
      <entry scope="row" class="emphasis">
        \(y\)
      </entry>
      <entry>
        270
      </entry>
      <entry>
        90
      </entry>
      <entry>
        30
      </entry>
      <entry>
        10
      </entry>
      <entry>
        \(\frac{10}3\)
      </entry>
    </row>
  </tbody>
</table></section>
</content>
</document>
