<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.3.1: Finding Connections between Graphs and Equations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00405</md:content-id>
    <md:title>2.3.1: Finding Connections between Graphs and Equations</md:title>
    <md:uuid>bebc0fd9-0fc6-4130-ac51-8f1a239cfbfd</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Warm Up Activity</title>
      <para id="para-00001">Use the following information to answer questions 1 – 8. Here are graphs of two
        equations in a system.</para>
      <quote id="quote-00001">
          <media alt="insert alt text">
            <image mime-type="svg" src="../../media/Algebra-1_02_03_01_01.svg"/>
          </media>
        </quote>
        <quote id="quote-00002">Determine if each of these systems could be represented by the graphs. Be
        prepared to explain how you know.</quote>
<!-- BEGIN ACTIVITY DROP DOWN 1 TRY -->

        <exercise id="eebf952f-4032-4e59-9cec-bc7ced7ea1b0" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00003"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></para></problem>
          <solution id="sol-00001">
            <para id="para-00004">Correct! No.</para>
            <para id="para-00005">The correct answer is No.</para>
          </solution>
        </exercise>
<!--END
      ACTIVITY DROP DOWN 1 TRY -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#2-->
      <exercise id="exer-00001">
        <problem id="prob-00002">
          <para id="para-00006">How do you know?</para>
        </problem>
        <solution id="sol-00002">


          <para id="para-00007">Compare your answer:</para>

          <para id="para-00008">Your answer may vary, but here is a sample. No, it cannot be represented by the
            graph. The graph for <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>5</m:mn></m:mrow></m:math> would be on the left side of the vertical axis, which is
            not what is shown.</para>

        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN ACTIVITY DROP DOWN 1 TRY -->
      <!--Q#3-->
        <exercise id="_2c74867e-69a9-444d-a4c6-e8b52bef40e4" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00009"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>13</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></para></problem>
          <solution id="sol-00003">
            <para id="para-00010">Correct! No.</para>
            <para id="para-00011">The correct answer is No.</para>
          </solution>
        </exercise>
<!--END
      ACTIVITY DROP DOWN 1 TRY -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#4-->
      <exercise id="exer-00002">
        <problem id="prob-00004">
          <para id="para-00012">How do you know?</para>
        </problem>
        <solution id="sol-00004">


          <para id="para-00013">Compare your answer:</para>

          <para id="para-00014">Your answer may vary, but here is a sample. No, it cannot be represented by the
            graph. The graph for <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>1</m:mn></m:mrow></m:math> would be a horizontal line, but no horizontal line is
            shown.</para>

        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN ACTIVITY DROP DOWN 1 TRY -->
          <!--Q#5-->
        <exercise id="ff1e2211-7397-429e-b55e-634c9a9f59c7" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00015"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>15</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></para></problem>
          <solution id="sol-00005">
            <para id="para-00016">Correct! Yes.</para>
            <para id="para-00017">The correct answer is Yes.</para>
          </solution>
        </exercise>
<!--END
      ACTIVITY DROP DOWN 1 TRY -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#6-->
      <exercise id="exer-00003">
        <problem id="prob-00006">
          <para id="para-00018">How do you know?</para>
        </problem>
        <solution id="sol-00006">


          <para id="para-00019">Compare your answer:</para>

          <para id="para-00020">Your answer may vary, but here is a sample. Yes. <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math> can be rearranged into
            <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>8</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math>. The graph for <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>8</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math> is a vertical line to the right of the
            vertical axis. <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>15</m:mn></m:mrow></m:math> can be rewritten as <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>15</m:mn></m:mrow></m:math>. Its graph has a
            negative slope and a positive <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-value for the vertical intercept.</para>

        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN ACTIVITY DROP DOWN 1 TRY -->
      <!--Q#7-->
        <exercise id="fc091107-08da-4173-b043-be60729cd590" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00021"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>7</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>4</m:mn><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>12</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:mrow></m:math></para></problem>
          <solution id="sol-00007">
            <para id="para-00022">Correct! No.</para>
            <para id="para-00023">The correct answer is No.</para>
          </solution>
        </exercise>
<!--END
      ACTIVITY DROP DOWN 1 TRY -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q#8-->
      <exercise id="exer-00004">
        <problem id="prob-00008">
          <para id="para-00024">How do you know?</para>
        </problem>
        <solution id="sol-00008">


          <para id="para-00025">Compare your answer:</para>

          <para id="para-00026">Your answer may vary, but here is a sample. No. The graph for <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math> would
            have a positive slope and a negative <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-value for the vertical intercept, neither of
            which matches the given graphs.</para>

        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!--Text
      Entry Interaction Start -->
    </section>
  </content>
