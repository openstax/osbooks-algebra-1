        1960
     </emphasis> </entry><entry><emphasis>
        1970
     </emphasis> </entry><entry><emphasis>
        1980
     </emphasis> </entry><entry><emphasis>
        1990
     </emphasis> </entry><entry><emphasis>
        2000
     </emphasis> </entry></row> <row>
      <entry>
        Paris
      </entry>
      <entry>
        6,300,000
      </entry>
      <entry>
