  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="56f0963a-31c5-4b99-a6dc-1e19eaabb484" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--q1-->
  <exercise data-content-id="530bd03b-738e-44f1-9f19-a6c02f63c76c" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x^2+11x +30\)" data-solution-options="[&quot;\\(x^2+10x −30\\)&quot;, &quot;\\(x^2+11x +30\\)&quot;, &quot;\\(x^2+30\\)&quot;, &quot;\\(x^2−11x +30\\)&quot;]">
    <problem>
      <para>Write \((x + 6)(x + 5)\) in standard form.</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.6.2.</para>
    </div>
    </exercise>
  <!--q2-->
  <exercise data-content-id="03e0a71b-2c3f-4d01-812e-4a9860b9a90b" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x^2−10x +21\)" data-solution-options="[&quot;\\(x^2+21\\)&quot;, &quot;\\(x^2+10x −21\\)&quot;, &quot;\\(x^2+10x +21\\)&quot;, &quot;\\(x^2−10x +21\\)&quot;]">
    <problem>
      <para>Write \((x − 3)(x − 7)\) in standard form.</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.6.2.</para>
    </div>
    </exercise>
  <!--q3-->
  <exercise data-content-id="c4bad6bf-cc55-40e9-9d7e-b7e546d038aa" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((x + 2)(x + 9)\)" data-solution-options="[&quot;\\((x − 2)(x − 9)\\)&quot;, &quot;\\((x + 2)(x + 9)\\)&quot;, &quot;\\((x + 2)(x − 9)\\)&quot;, &quot;\\(x(x + 18)\\)&quot;]">
    <problem>
      <para>An expression in standard form is shown. The diagram below shows it is equivalent to which expression in
          factored form?</para>
      <para>\(x^2+11x +18\)</para>
      
      <table class="os-raise-doubleheadertable os-raise-skinnytable">
        <thead>
          <row>
            <entry scope="col" class="emphasis"> </entry>
            <entry scope="col" class="emphasis">
              \(x\)

            </entry><entry scope="col" class="emphasis">
              2
            </entry>
            
          </row>
        </thead>
        <tbody>
          <row>
            <entry scope="row" class="emphasis">
              \(x\)
            </entry>
            <entry>
              \(x^2\)
            </entry>
            <entry>
              \(2x\)
            </entry>
          </row>
          <row>
            <entry scope="row" class="emphasis">
              9
            </entry>
            <entry>
              \(9x\)
            </entry>
            <entry>
              18
            </entry>
          </row>
        </tbody>
      </table>
    </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.6.2.</para>
    </div>
    </exercise>
  <!--q4-->
  <exercise data-content-id="8e243347-4ac1-4996-93ec-5f2699b7e538" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((x − 5)(x − 7)\)" data-solution-options="[&quot;\\((x − 5)(x − 7)\\)&quot;, &quot;\\((x − 5)(x + 7)\\)&quot;, &quot;\\(x(x − 35)\\)&quot;, &quot;\\((x + 5)(x + 7)\\)&quot;]">
    <problem>
      <para>An expression in standard form is shown. The diagram below shows it is equivalent to which expression in
          factored form?</para>
      <para>\(x^2− 12x + 35\)</para>
      
      <table class="os-raise-doubleheadertable os-raise-skinnytable">
        <thead>
          <row>
            <entry scope="col" class="emphasis"> </entry>
            <entry scope="col" class="emphasis">
              \(x\)
            </entry>
            <entry scope="col" class="emphasis">
              –5
            </entry>
          </row>
        </thead>
        <tbody>
          <row>
            <entry scope="row" class="emphasis">
              \(x\)
            </entry>
            <entry>
              \(x^2\)
            </entry>
            <entry>
              \(-5x\)
            </entry>
          </row>
          <row>
            <entry scope="row" class="emphasis">
              –7
            </entry>
            <entry>
              \(-7x\)
            </entry>
            <entry>
              35
            </entry>
          </row>
        </tbody>
      </table>
    </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.6.2.</para>
    </div>
    </exercise>
  <!--q5-->
  <exercise data-content-id="1f051cf4-ff3d-467f-b22d-54af248fb612" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((x + 9)(x + 4)\)" data-solution-options="[&quot;\\((x − 12)(x − 3)\\)&quot;, &quot;\\((x + 12)(x + 1)\\)&quot;, &quot;\\((x + 18)(x + 2)\\)&quot;, &quot;\\((x + 9)(x + 4)\\)&quot;]">
    <problem>
      <para>Find the factored form of \(x^2+13x +36\).</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.6.3.</para>
