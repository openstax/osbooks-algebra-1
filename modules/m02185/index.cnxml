<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.6.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02185</md:content-id>
    <md:title>8.6.5: Practice</md:title>
    <md:uuid>14ac0bcd-5a52-49cd-a2fc-62b333117ab7</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <exercise id="_530bd03b-738e-44f1-9f19-a6c02f63c76c" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00002">Write \((x + 6)(x + 5)\) in standard form.</para>
          <para id="para-00003">Multiple Choice:</para>
          <para id="para-00004">\(x^2+10x −30\)</para>
          <para id="para-00005">\(x^2+11x +30\)</para>
          <para id="para-00006">\(x^2+30\)</para>
          <para id="para-00007">\(x^2−11x +30\)</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00008">Try again. Revisit activity 8.6.2.</para>
          <para id="para-00009">The correct answer is \(x^2+11x +30\).</para>
        </solution>
      </exercise>
      <exercise id="_03e0a71b-2c3f-4d01-812e-4a9860b9a90b" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00010">Write \((x − 3)(x − 7)\) in standard form.</para>
          <para id="para-00011">Multiple Choice:</para>
          <para id="para-00012">\(x^2+21\)</para>
          <para id="para-00013">\(x^2+10x −21\)</para>
          <para id="para-00014">\(x^2+10x +21\)</para>
          <para id="para-00015">\(x^2−10x +21\)</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00016">Try again. Revisit activity 8.6.2.</para>
          <para id="para-00017">The correct answer is \(x^2−10x +21\).</para>
        </solution>
      </exercise>
      <exercise id="c4bad6bf-cc55-40e9-9d7e-b7e546d038aa" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00018">\(x^2+11x +18\)</para>
          <para id="para-00019">An expression in standard form is shown. The diagram below shows it is equivalent to which expression in factored form?</para>
          <table class="os-raise-doubleheadertable os-raise-skinnytable" id="table-00001">
            <tgroup cols="3">
              <tbody>
                <row>
                  <entry><emphasis> </emphasis></entry>
                  <entry><emphasis> \(x\) </emphasis>
                  </entry>
                  <entry><emphasis> 2 </emphasis>
                  </entry>
                </row>
                <row>
                  <entry><emphasis> \(x\) </emphasis>
                  </entry>
                  <entry> \(x^2\) </entry>
                  <entry> \(2x\) </entry>
                </row>
                <row>
                  <entry><emphasis> 9 </emphasis>
                  </entry>
                  <entry> \(9x\) </entry>
                  <entry> 18 </entry>
                </row>
              </tbody>
            </tgroup>
          </table>
          <para id="para-00020">Multiple Choice:</para>
          <para id="para-00021">\((x − 2)(x − 9)\)</para>
          <para id="para-00022">\((x + 2)(x + 9)\)</para>
          <para id="para-00023">\((x + 2)(x − 9)\)</para>
          <para id="para-00024">\(x(x + 18)\)</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00025">Try again. Revisit activity 8.6.2.</para>
          <para id="para-00026">The correct answer is \((x + 2)(x + 9)\).</para>
        </solution>
      </exercise>
      <exercise id="_8e243347-4ac1-4996-93ec-5f2699b7e538" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00027">\(x^2− 12x + 35\)</para>
          <para id="para-00028">An expression in standard form is shown. The diagram below shows it is equivalent to which expression in factored form?</para>
          <table class="os-raise-doubleheadertable os-raise-skinnytable" id="table-00002">
            <tgroup cols="3">
              <tbody>
                <row>
                  <entry><emphasis> </emphasis></entry>
                  <entry><emphasis> \(x\) </emphasis>
                  </entry>
                  <entry><emphasis> –5 </emphasis>
                  </entry>
                </row>
                <row>
                  <entry><emphasis> \(x\) </emphasis>
                  </entry>
                  <entry> \(x^2\) </entry>
                  <entry> \(-5x\) </entry>
                </row>
                <row>
                  <entry><emphasis> –7 </emphasis>
                  </entry>
                  <entry> \(-7x\) </entry>
                  <entry> 35 </entry>
                </row>
              </tbody>
            </tgroup>
          </table>
          <para id="para-00029">Multiple Choice:</para>
          <para id="para-00030">\((x − 5)(x − 7)\)</para>
          <para id="para-00031">\((x − 5)(x + 7)\)</para>
          <para id="para-00032">\(x(x − 35)\)</para>
          <para id="para-00033">\((x + 5)(x + 7)\)</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00034">Try again. Revisit activity 8.6.2.</para>
          <para id="para-00035">The correct answer is \((x − 5)(x − 7)\).</para>
        </solution>
      </exercise>
      <exercise id="_1f051cf4-ff3d-467f-b22d-54af248fb612" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00036">Find the factored form of \(x^2+13x +36\).</para>
          <para id="para-00037">Multiple Choice:</para>
          <para id="para-00038">\((x − 12)(x − 3)\)</para>
          <para id="para-00039">\((x + 12)(x + 1)\)</para>
          <para id="para-00040">\((x + 18)(x + 2)\)</para>
          <para id="para-00041">\((x + 9)(x + 4)\)</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00042">Try again. Revisit activity 8.6.3.</para>
          <para id="para-00043">The correct answer is \((x + 9)(x + 4)\).</para>
        </solution>
      </exercise>
      <exercise id="eb89d4ed-a618-402f-86c3-dea7cf411cf8" class="multiple-choice">
        <problem id="prob-00006">
          <para id="para-00044">Find the factored form of \(x^2−14x +48\).</para>
          <para id="para-00045">Multiple Choice:</para>
          <para id="para-00046">\((x − 10)(x − 4)\)</para>
          <para id="para-00047">\((x − 12)(x − 4)\)</para>
          <para id="para-00048">\((x − 7)(x − 7)\)</para>
          <para id="para-00049">\((x − 6)(x − 8)\)</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00050">Try again. Revisit activity 8.6.3.</para>
          <para id="para-00051">The correct answer is \((x − 6)(x − 8)\).</para>
        </solution>
      </exercise>
      <exercise id="_92f42697-a268-43c6-81d2-1c37fb2574ae" class="multiple-choice">
        <problem id="prob-00007">
          <para id="para-00052">Find the factored form of \(x^2+13x +30\).</para>
          <para id="para-00053">Multiple Choice:</para>
          <para id="para-00054">\((x + 15)(x + 2)\)</para>
          <para id="para-00055">\((x + 6)(x + 5)\)</para>
          <para id="para-00056">\((x + 3)(x + 10)\)</para>
          <para id="para-00057">\((x + 6)(x + 7)\)</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00058">Try again. Revisit activity 8.6.3.</para>
          <para id="para-00059">The correct answer is \((x + 3)(x + 10)\).</para>
        </solution>
      </exercise>
      <exercise id="_17108c3a-65a7-45f8-8a41-b84f45e95ade" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00060">Find the factored form of \(x^2−12x +27\).</para>
          <para id="para-00061">Multiple Choice:</para>
          <para id="para-00062">\((x − 9)(x − 3)\)</para>
          <para id="para-00063">\((x − 7)(x − 5)\)</para>
          <para id="para-00064">\((x − 27)(x − 1)\)</para>
          <para id="para-00065">\((x − 6)(x − 6)\)</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00066">Try again. Revisit activity 8.6.3.</para>
          <para id="para-00067">The correct answer is \((x − 9)(x − 3)\).</para>
        </solution>
      </exercise>
      <exercise id="_69fc2356-8184-45bb-a5d1-5fd047dad8da" class="multiple-choice">
        <problem id="prob-00009">
          <para id="para-00068">Find the factored form of \(x^2−13x +22\).</para>
          <para id="para-00069">Multiple Choice:</para>
          <para id="para-00070">\((x − 11)(x − 2)\)</para>
          <para id="para-00071">\((x − 12)(x − 1)\)</para>
          <para id="para-00072">\((x − 22)(x − 1)\)</para>
          <para id="para-00073">\((x − 6)(x − 7)\)</para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00074">Try again. Revisit activity 8.6.3.</para>
          <para id="para-00075">The correct answer is \((x − 11)(x − 2)\).</para>
        </solution>
      </exercise>
      <exercise id="feaa0e9a-0558-4790-8237-b74c0a708ff0" class="multiple-choice">
        <problem id="prob-00010">
          <para id="para-00076">\(x^2+20x +96\) and \((x\; +\) __\()(x\; +\) __\()\)</para>
          <para id="para-00077">Here are pairs of equivalent expressions: one in standard form and the other in factored form. Find the missing numbers.</para>
          <para id="para-00078">Multiple Choice:</para>
          <para id="para-00079">10, 10</para>
          <para id="para-00080">12, 8</para>
          <para id="para-00081">24, 4</para>
          <para id="para-00082">14, 6</para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00083">Try again. Revisit activity 8.6.4.</para>
          <para id="para-00084">The correct answer is 12, 8.</para>
        </solution>
      </exercise>
    </section>
  </content>
