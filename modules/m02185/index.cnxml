  <!--q10-->
  <exercise data-content-id="feaa0e9a-0558-4790-8237-b74c0a708ff0" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="12, 8" data-solution-options="[&quot;10, 10&quot;, &quot;12, 8&quot;, &quot;24, 4&quot;, &quot;14, 6&quot;]">
    <problem>
      <para>Here are pairs of equivalent expressions: one in standard form and the other in factored form. Find the
          missing numbers.</para>
      <para>\(x^2+20x +96\) and \((x\; +\) __\()(x\; +\) __\()\)</para>
    </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.6.4.</para>
    </div>
    </exercise>
