    </exercise>
  <!--q8-->
  <exercise data-content-id="17108c3a-65a7-45f8-8a41-b84f45e95ade" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((x − 9)(x − 3)\)" data-solution-options="[&quot;\\((x − 9)(x − 3)\\)&quot;, &quot;\\((x − 7)(x − 5)\\)&quot;, &quot;\\((x − 27)(x − 1)\\)&quot;, &quot;\\((x − 6)(x − 6)\\)&quot;]">
