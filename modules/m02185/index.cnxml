    </exercise>
  <!--q9-->
  <exercise data-content-id="69fc2356-8184-45bb-a5d1-5fd047dad8da" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((x − 11)(x − 2)\)" data-solution-options="[&quot;\\((x − 11)(x − 2)\\)&quot;, &quot;\\((x − 12)(x − 1)\\)&quot;, &quot;\\((x − 22)(x − 1)\\)&quot;, &quot;\\((x − 6)(x − 7)\\)&quot;]">
    <problem>
      <para>Find the factored form of \(x^2−13x +22\).</para>
