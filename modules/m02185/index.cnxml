    </exercise>
  <!--q7-->
  <exercise data-content-id="92f42697-a268-43c6-81d2-1c37fb2574ae" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((x + 3)(x + 10)\)" data-solution-options="[&quot;\\((x + 15)(x + 2)\\)&quot;, &quot;\\((x + 6)(x + 5)\\)&quot;, &quot;\\((x + 3)(x + 10)\\)&quot;, &quot;\\((x + 6)(x + 7)\\)&quot;]">
