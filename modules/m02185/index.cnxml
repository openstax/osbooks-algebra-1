    </exercise>
  <!--q6-->
  <exercise data-content-id="eb89d4ed-a618-402f-86c3-dea7cf411cf8" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((x − 6)(x − 8)\)" data-solution-options="[&quot;\\((x − 10)(x − 4)\\)&quot;, &quot;\\((x − 12)(x − 4)\\)&quot;, &quot;\\((x − 7)(x − 7)\\)&quot;, &quot;\\((x − 6)(x − 8)\\)&quot;]">
