<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.4.4: Writing a Rule Using Function Notation</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00906</md:content-id>
    <md:title>4.4.4: Writing a Rule Using Function Notation</md:title>
    <md:uuid>83f121de-9035-4b05-9254-a0ddd281ebbf</md:uuid>
  </metadata>
  <content>
  <section><title>Cool Down Activity</title>
<list class="os-raise-noindent" type="enumerated">
  <item>Complete the table with the perimeter of a square for each given side length.</item>
</list>
<table class="os-raise-midsizetable">
 
  <thead>
    <row>
      <entry scope="col" class="emphasis">
       side length (inches)
      </entry>
      <entry scope="col" class="emphasis">
        perimeter (inches)
      </entry>
	  </row></thead><tbody>
    <row>
      <entry>
        <para>0.5</para>
      </entry>
      <entry>a. ______</entry>
    </row>
    <row>
      <entry>
        <para>7</para>
      </entry>
      <entry>b. ______</entry>
    </row>
    <row>
      <entry>
        <para>20</para>
      </entry>
      <entry>c. ______</entry>
    </row>
  </tbody>
</table>
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>a. ______</para>
  </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>2</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>b. ______</para>
  </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>28</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>c. ______</para>
  </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>80</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Write a rule for a function, \(P\), that gives the perimeter of a square in inches when the side length is \(x\) inches.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(P(x)=4x\)</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>What is the value of \(P(9.1)\)? What does it tell us about the side length and perimeter of the square?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answers:</para>
    <para>\(P(9.1)=36.4\). It tells us that when the side length of the square is 9.1 inches, the perimeter of the square is 36.4 inches.</para>
  </solution></exercise>
<!--Interaction End --></section>
</content>
