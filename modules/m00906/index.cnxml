<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.4.4: Writing a Rule Using Function Notation</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00906</md:content-id>
    <md:title>4.4.4: Writing a Rule Using Function Notation</md:title>
    <md:uuid>8f718d52-1ab8-4894-b3b9-8ea1cfdc785f</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
<list class="os-raise-noindent" list-type="enumerated" id="list-00001">
  <item>Complete the table with the perimeter of a square for each given side length.</item>
</list>
<table class="unnumbered os-raise-midsizetable" id="table-00001">
 
  <tgroup cols="2"><tbody align="center"><row>
      <entry><emphasis>
       side length (inches)
     </emphasis> </entry><entry><emphasis>
        perimeter (inches)
     </emphasis> </entry></row><row>
      <entry>
        <para id="para-00001">0.5</para>
      </entry>
      <entry>a. ______</entry>
    </row>
    <row>
      <entry>
        <para id="para-00002">7</para>
      </entry>
      <entry>b. ______</entry>
    </row>
    <row>
      <entry>
        <para id="para-00003">20</para>
      </entry>
      <entry>c. ______</entry>
    </row>
  </tbody></tgroup></table>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00004">a. ______</para>
  
  </problem><solution id="sol-00001">
    
    
  
  <para id="para-00005">Compare your answer:</para>
    
    <para id="para-00006">2</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00007">b. ______</para>
  
  </problem><solution id="sol-00002">
    
    
  
  <para id="para-00008">Compare your answer:</para>
    
    <para id="para-00009">28</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00010">c. ______</para>
  
  </problem><solution id="sol-00003">
    
    
  
  <para id="para-00011">Compare your answer:</para>
    
    <para id="para-00012">80</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00013">Write a rule for a function, <m:math display="inline"><m:mrow><m:mi>P</m:mi></m:mrow></m:math>, that gives the perimeter of a square in inches when the side length is <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> inches.</para>
    </problem><solution id="sol-00004">
    
    
  
  <para id="para-00014">Compare your answer:</para>
    
    <para id="para-00015"><m:math><m:mrow><m:mi>P</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi></m:mrow></m:math></para></solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00005">
  <problem id="prob-00005">
    <para id="para-00016">What is the value of <m:math display="inline"><m:mrow><m:mi>P</m:mi><m:mo stretchy="false">(</m:mo><m:mn>9.1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>? What does it tell us about the side length and perimeter of the square?</para>
    </problem><solution id="sol-00005">
    
    
  
  <para id="para-00017">Compare your answers:</para>
    
    <para id="para-00018"><m:math display="inline"><m:mrow><m:mi>P</m:mi><m:mo stretchy="false">(</m:mo><m:mn>9.1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>36.4</m:mn></m:mrow></m:math>. It tells us that when the side length of the square is 9.1 inches, the perimeter of the square is 36.4 inches.</para>
  
  </solution></exercise>
<!--Interaction End --></section>
</content></document>