              </para>
              <para id="para-00130" xmlns="http://cnx.rice.edu/cnxml">2. <m:math display="inline">
                    <m:mrow>
                      <m:msup>
                        <m:mi>x</m:mi>
                        <m:mn>3</m:mn>
                      </m:msup>
                      <m:mo>−</m:mo>
                      <m:mn>3</m:mn>
                      <m:msup>
                        <m:mi>x</m:mi>
                        <m:mn>2</m:mn>
                      </m:msup>
                      <m:mo>+</m:mo>
                      <m:mn>2</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>1</m:mn>
                      <m:mo>+</m:mo>
                      <m:mfrac>
                        <m:mrow>
