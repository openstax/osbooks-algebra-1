                          <mrow>
                            <mo>)</mo>
                            <mrow class="MJX-TeXAtom-ORD">
                              <mrow class="MJX-TeXAtom-ORD">
                                <mphantom>
                                  <mpadded width="0">
                                    <mn>1</mn>
                                    <mrow class="MJX-TeXAtom-ORD">
                                      <mn>125</mn>
                                      <mrow class="MJX-TeXAtom-ORD">
                                        <msup>
                                          <mi>y</mi>
                                          <mn>5</mn>
                                        </msup>
                                      </mrow>
                                      <mo>−<!-- − --></mo>
                                      <mn>80</mn>
                                      <mrow class="MJX-TeXAtom-ORD">
                                        <msup>
                                          <mi>y</mi>
                                          <mn>4</mn>
                                        </msup>
                                      </mrow>
                                      <mo>−<!-- − --></mo>
                                      <mn>31</mn>
                                      <mrow class="MJX-TeXAtom-ORD">
                                        <msup>
                                          <mi>y</mi>
                                          <mn>3</mn>
                                        </msup>
                                      </mrow>
                                      <mo>+</mo>
                                      <mn>37</mn>
                                      <mrow class="MJX-TeXAtom-ORD">
                                        <msup>
                                          <mi>y</mi>
                                          <mn>2</mn>
                                        </msup>
                                      </mrow>
                                      <mo>+</mo>
                                      <mn>10</mn>
                                      <mi>y</mi>
                                      <mo>−<!-- − --></mo>
                                      <mn>24</mn>
                                    </mrow>
                                  </mpadded>
                                </mphantom>
                              </mrow>
                            </mrow>
                            <mo fence="true" stretchy="true" symmetric="true"/>
                          </mrow>
                          <mspace width="negativethinmathspace"/>
                          <mspace width="negativethinmathspace"/>
                          <mspace width="negativethinmathspace"/>
                          <mspace width="negativethinmathspace"/>
                          <mover>
                            <mrow>
                              <mspace width="thinmathspace"/>
                              <mspace width="thinmathspace"/>
                              <mspace width="thinmathspace"/>
                              <mrow class="MJX-TeXAtom-ORD">
                                <mphantom>
                                  <mpadded width="0">
                                    <mn>1</mn>
                                  </mpadded>
                                </mphantom>
                              </mrow>
                              <mrow class="MJX-TeXAtom-ORD">
                                <mrow class="MJX-TeXAtom-ORD">
                                  <mn>125</mn>
                                  <mrow class="MJX-TeXAtom-ORD">
                                    <msup>
                                      <mi>y</mi>
                                      <mn>5</mn>
                                    </msup>
                                  </mrow>
