        <para id="para-00021">In this next problem, you will need to add two placeholders to divide.</para></note>

      <!--Text Entry Interaction Start -->
      <exercise id="exer-00005">
        <problem id="prob-00005">

          <para id="para-00022">5. Find the quotient using long division.</para>
          <para id="para-00128"><m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>125</m:mn>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>3</m:mn>
                </m:msup>
                <m:mo>−</m:mo>
                <m:mn>8</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mi>÷</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>5</m:mn>
                <m:mi>x</m:mi>
                <m:mo>−</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>
          </para>
          <para id="para-00023"/>

        </problem>
        <solution id="sol-00005">
          <para id="para-00024">Compare your answer: </para>

          <para id="para-00025"><m:math display="inline">
              <m:mrow>
                <m:mn>25</m:mn>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>10</m:mn>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>4</m:mn>
              </m:mrow>
            </m:math></para>
          <para id="para-00026">
            <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
              <mtable columnalign="left" rowspacing="4pt" columnspacing="1em">
                <mtr>
                  <mtd>
                    <mn>5</mn>
                    <mi>x</mi>
                    <mo>−<!-- − --></mo>
                    <mn>2</mn>
                    <mspace width="thinmathspace"/>
                    <mspace width="thinmathspace"/>
                    <mover>
                      <mrow class="MJX-TeXAtom-OP MJX-fixedlimits">
                        <mrow>
                          <mo>)</mo>
                          <mrow class="MJX-TeXAtom-ORD">
                            <mrow class="MJX-TeXAtom-ORD">
                              <mphantom>
                                <mpadded width="0">
                                  <mn>1</mn>
                                  <mrow class="MJX-TeXAtom-ORD">
                                    <mn>125</mn>
                                    <mrow class="MJX-TeXAtom-ORD">
                                      <msup>
                                        <mi>x</mi>
                                        <mn>3</mn>
                                      </msup>
                                    </mrow>
                                    <mo>+</mo>
                                    <mn>0</mn>
                                    <mrow class="MJX-TeXAtom-ORD">
                                      <msup>
                                        <mi>x</mi>
                                        <mn>2</mn>
                                      </msup>
                                    </mrow>
                                    <mo>+</mo>
                                    <mn>0</mn>
                                    <mi>x</mi>
                                    <mo>−<!-- − --></mo>
                                    <mn>8</mn>
                                  </mrow>
                                </mpadded>
                              </mphantom>
                            </mrow>
                          </mrow>
                          <mo fence="true" stretchy="true" symmetric="true"/>
                        </mrow>
                        <mspace width="negativethinmathspace"/>
                        <mspace width="negativethinmathspace"/>
                        <mspace width="negativethinmathspace"/>
                        <mspace width="negativethinmathspace"/>
