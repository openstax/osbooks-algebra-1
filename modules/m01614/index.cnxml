                        </m:mrow>
                        <m:mrow>
                          <m:mi>x</m:mi>
                          <m:mo>+</m:mo>
                          <m:mn>3</m:mn>
                        </m:mrow>
                      </m:mfrac>
                    </m:mrow>
                  </m:math>;</para>
              <para id="para-00124">
                <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
