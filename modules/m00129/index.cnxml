<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.5.2 Graphing Linear Functions in Two Variables</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00129</md:content-id>
    <md:title>1.5.2 Graphing Linear Functions in Two Variables</md:title>
    <md:uuid>da007796-980b-4c69-be33-61a6712720cf</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">      <title>Activity</title>
      <para id="para-00001">For questions 1 - 7, use the equation <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>12</m:mn></m:mrow></m:math></para>
      <exercise id="_33ba9218-21e3-44a6-b162-ab42818b7db4" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00002">Find the value of <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> when <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math>.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Correct! 3</para>
          <para id="para-00004">Nice try! The correct answer is 3.</para>
        </solution>
      </exercise>
      <exercise id="bdfae59e-ac64-4001-8c66-2ef317efcd04" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00005">Find the value of <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> when <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math>.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00006">Correct! 4</para>
          <para id="para-00007">Nice try! The correct answer is 4.</para>
        </solution>
      </exercise>
      <!--Q#3-->
      <exercise id="exer-00001">
        <problem id="prob-00003">
          <para id="para-00008">Plot both of those points on a coordinate grid and use a ruler to draw a line.</para>
          <para id="para-00009"></para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00010">Compare your answer: </para>
          
            <media alt="A plot of the x and y coordiantes of the equation 3x + 4y =12.">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_01_07_03_01.jpg"/>
            </media>
          
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#4-->
      <exercise id="exer-00002">
        <problem id="prob-00004">
          <para id="para-00011">What is the coordinate of the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercept?</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00012">Compare your answer: </para>
          <para id="para-00013"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#5-->
      <exercise id="exer-00003">
        <problem id="prob-00005">
          <para id="para-00014">What is the coordinate of the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercept?</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00015">Compare your answer: </para>
          <para id="para-00016"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#6-->
      <exercise id="exer-00004">
        <problem id="prob-00006">
          <para id="para-00017">What are two other names for the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercept?</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00018">Compare your answer: </para>
          <para id="para-00019">zero, solution</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <exercise id="_1d3b286b-14fe-4dc7-adb6-c892ead56130" class="multiple-choice">
        <problem id="prob-00007">
          <para id="para-00020">What is the slope of the line?</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00021">Correct! <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
          <para id="para-00022">Nice try! The correct answer is <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math>.</para>
        </solution>
      </exercise>
    </section>
    <section id="sect-00002">
      <note class="self-check" id="note-00001">
        <para id="para-00023">Graph the equation <m:math display="inline"><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math>. Which of the following describes the intercepts and slope of the graph?</para>
        <list number-style="lower-alpha" id="list-00001">
          <item><m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercept: <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>–</m:mo><m:mn>5</m:mn></m:mrow></m:math>; <m:math><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercept: <m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math>; Slope: <m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></item>
          <item><m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercept: <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math>; <m:math><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercept: <m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>–</m:mo><m:mn>5</m:mn></m:mrow></m:math>; Slope: <m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></item>
          <item><m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercept: <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>–</m:mo><m:mn>2</m:mn></m:mrow></m:math>; <m:math><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercept: <m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math>; Slope: <m:math><m:mrow><m:mo>–</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></item>
          <item><m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercept: <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math>; <m:math><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercept: <m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>–</m:mo><m:mn>5</m:mn></m:mrow></m:math>; Slope: <m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></item>
        </list>
      </note>
    </section>
    <section id="sect-00003">
      <title>Additional Resources</title>
      <section id="sect-00004">
        <title>Graphing a Line and Describing Characteristics</title>
        <para id="para-00024">There are many ways to graph an equation of a line. One way is to use the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts and <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercepts as two points on the line.</para>
        <section id="sect-00005">
          <para id="para-00043"><emphasis>Example</emphasis></para>
          <para id="para-00025">Graph <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>18</m:mn></m:mrow></m:math> using the intercepts, then identify key characteristics.</para>
          <para id="para-00026"><emphasis>Step 1</emphasis> - Find the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercept.<newline/> To find the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercept, let <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math>.</para>
          <para id="para-00027"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>18</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>18</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn><m:mi>x</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>18</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>6</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00028"><m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> is the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercept<newline/> The <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercept is also called a solution or zero.</para>
          <para id="para-00029"><emphasis>Step 2</emphasis> -Find the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercept.<newline/> To find the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercept, let <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math>.</para>
          <para id="para-00030"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>18</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>18</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>18</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>3</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00031"><m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> is the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercept</para>
          <para id="para-00032"><emphasis>Step 3</emphasis> -Graph the line by connecting the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercepts.</para>
          
            <media alt="A plot of y intercepts of the equation 3x - 6y =18.">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_01_07_05_01.jpg" width="400"/>
            </media>
          
          <para id="para-00033"><emphasis>Step 4</emphasis> - Find the slope of the line.</para>
          <para id="para-00034"><m:math><m:mrow><m:mrow><m:mi mathvariant="normal">s</m:mi><m:mi mathvariant="normal">l</m:mi><m:mi mathvariant="normal">o</m:mi><m:mi mathvariant="normal">p</m:mi><m:mi mathvariant="normal">e</m:mi></m:mrow><m:mo>=</m:mo><m:mfrac><m:mrow><m:mrow><m:mi mathvariant="normal">r</m:mi><m:mi mathvariant="normal">i</m:mi><m:mi mathvariant="normal">s</m:mi><m:mi mathvariant="normal">e</m:mi></m:mrow></m:mrow><m:mrow><m:mrow><m:mi mathvariant="normal">r</m:mi><m:mi mathvariant="normal">u</m:mi><m:mi mathvariant="normal">n</m:mi></m:mrow></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para></section>
        <note class="try numbered-exercises" id="note-00002">
          <title>Try It: Graphing a Line and Describing Characteristics</title>
        <para id="para-00035">For 1 - 2, use the equation <m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>21</m:mn></m:mrow></m:math>.</para>
          <!--Q#1-->

          <exercise id="exer-00005">
            <problem id="prob-00008">
              <para id="para-00036">Graph the equation using the intercepts.</para>
              <para id="para-00037"></para>
            </problem>
            <solution id="sol-00008">
              <para id="para-00038">Compare your answer: </para>
              <para id="para-00039">
                <emphasis>Answer:</emphasis>
             </para>
              
                <media alt="Graph of the equation 7x - 3y = 21.">
                  <image mime-type="image/jpeg" src="../../media/Algebra-1_01_07_05_02.jpg"/>
                </media>
              
            </solution>
          </exercise>
          <!--Interaction End -->

          <exercise id="_1ff5a0d5-9bb2-4cb3-af25-2a9d40b8fde3" class="multiple-choice">
            <problem id="prob-00009">
              <para id="para-00040">What is the slope of the line?</para>
            </problem>
            <solution id="sol-00009">
              <para id="para-00041">Correct! <m:math display="inline"><m:mrow><m:mfrac><m:mn>7</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
              <para id="para-00042">Nice try! The correct answer is <m:math display="inline"><m:mrow><m:mfrac><m:mn>7</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math>.</para>
            </solution>
          </exercise>
        </note>
      </section>
    </section>
  </content>
</document>