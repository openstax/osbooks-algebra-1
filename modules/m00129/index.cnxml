<!--Q#3-->
<example><exercise>
  <problem>
    
    <para> Plot both of those points on a coordinate grid and use a ruler to draw a line. </para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <figure><media alt="A plot of the x and y coordiantes of the equation 3x + 4y =12."><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/964b7422a6bddf9a6da3d460b9aebccd439aec35"/></media></figure></solution></exercise>
</example><!--Interaction End -->
<!--Q#4-->
<exercise>
  <problem>
    <para> What is the coordinate of the \(x\)-intercept? </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\((4,0)\)</para>
  </solution></exercise>
<!--Interaction End -->
<!--Q#5-->
<exercise>
  <problem>
    <para> What is the coordinate of the \(y\)-intercept? </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\((0,3)\)</para>
  </solution></exercise>
<!--Interaction End -->
<!--Q#6-->
<exercise>
  <problem>
    <para> What are two other names for the \(x\)-intercept? </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>zero, solution</para>
  </solution></exercise>
<!--Interaction End -->
