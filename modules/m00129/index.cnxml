  <content>
  <section><para>For questions 1 - 7, use the equation \(3x + 4y =12\)</para>
<section class="check-understanding"><title>Activity</title><exercise data-content-id="33ba9218-21e3-44a6-b162-ab42818b7db4" class="multiple-choice"><problem><para>Enter your answer here:</para><para> Find the value of \(y\) when \(x = 0\). </para>
      </problem><solution><para>Correct! 3</para><para>Nice try! The correct answer is 3.</para></solution></exercise><exercise data-content-id="bdfae59e-ac64-4001-8c66-2ef317efcd04" class="multiple-choice"><problem><para>Enter your answer here:</para><para> Find the value of \(x\) when \(y = 0\). </para>
      </problem><solution><para>Correct! 4</para><para>Nice try! The correct answer is 4.</para></solution></exercise></section>
<!--Q#3-->
<example><exercise>
  <problem>
    
    <para> Plot both of those points on a coordinate grid and use a ruler to draw a line. </para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <figure><media alt="A plot of the x and y coordiantes of the equation 3x + 4y =12."><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/964b7422a6bddf9a6da3d460b9aebccd439aec35"/></media></figure></solution></exercise>
</example><!--Interaction End -->


<!--Q#4-->
<exercise>
  <problem>
    <para> What is the coordinate of the \(x\)-intercept? </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\((4,0)\)</para>
  </solution></exercise>
<!--Interaction End -->


<!--Q#5-->
<exercise>
  <problem>
    <para> What is the coordinate of the \(y\)-intercept? </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\((0,3)\)</para>
  </solution></exercise>
<!--Interaction End -->


<!--Q#6-->
<exercise>
  <problem>
    <para> What are two other names for the \(x\)-intercept? </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>zero, solution</para>
  </solution></exercise>
<!--Interaction End -->

<section class="check-understanding"><exercise data-content-id="1d3b286b-14fe-4dc7-adb6-c892ead56130" class="multiple-choice"><problem><para>Enter your answer here:</para><para> What is the slope of the line? </para>
      </problem><solution><para>Correct! \(-\frac34\)</para><para>Nice try! The correct answer is \(-\frac34\).</para></solution></exercise></section></section>
