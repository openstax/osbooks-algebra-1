  <content>
  <section><title>Activity</title>
<para>For questions 1 - 7, use the equation \(3x + 4y =12\)</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="5f8c83d2-5d96-4385-afe6-c9218e305f69" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0"><!--Q#1-->
  <exercise data-content-id="33ba9218-21e3-44a6-b162-ab42818b7db4" data-problem-comparator="integer" data-problem-type="input" data-solution="3">
    <problem>
      <para> Find the value of \(y\) when \(x = 0\). </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! 3</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#2-->
  <exercise data-content-id="bdfae59e-ac64-4001-8c66-2ef317efcd04" data-problem-comparator="integer" data-problem-type="input" data-solution="4">
    <problem>
      <para> Find the value of \(x\) when \(y = 0\). </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! 4</para>
    </solution>
    </exercise>
