<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.4.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00431</md:content-id>
    <md:title>2.4.5: Practice</md:title>
    <md:uuid>916fa776-de43-4ec6-b675-c61bb8c12ced</md:uuid>
