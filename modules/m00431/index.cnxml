  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<para>For questions 1 – 8, solve the systems of equations using the elimination method.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="c858dd5f-30a9-44a0-808d-5b65c2053e76" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--Q1-->
  <exercise data-content-id="de4b55db-3c3d-4fbf-802a-2fdb361502fa" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((–2,6)\)" data-solution-options="[&quot;\\((–3,9)\\)&quot;, &quot;\\((0,1)\\)&quot;, &quot;\\((2,–4)\\)&quot;, &quot;\\((–2,6)\\)&quot;]">
    <problem>
      <para> \(\begin{array}{c}\left\{\begin{array}{l}5x\;+\;2y\;=\;2\\-6x\;-\;2y\;=\;0\end{array}\right.\\\\\end{array}\)</para>
      </problem>
    <solution>
      <para>Correct! (–2,6)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.4.2.</para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q2-->
  <exercise data-content-id="1ef45c95-a2ca-4d74-9d47-59d60e215782" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((6,1)\)" data-solution-options="[&quot;\\((7,4)\\)&quot;, &quot;\\((5,−2)\\)&quot;, &quot;\\((6,1)\\)&quot;, &quot;\\((−4,−3)\\)&quot;]">
    <problem>
      <para>\(\begin{array}{c}\left\{\begin{array}{l}2x\;-\;5y\;=\;7\\-15x\;+\;5y\;=\;-85\end{array}\right.\\\\\end{array}\)</para>
      </problem>
    <solution>
      <para>Correct! (6,1)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.4.2.</para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q3-->
  <exercise data-content-id="4abaa7ae-ee8d-4cee-80da-26363cb2a64e" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((2,3)\)" data-solution-options="[&quot;\\((2,3)\\)&quot;, &quot;\\((7,6)\\)&quot;, &quot;\\((0,8)\\)&quot;, &quot;\\((4,−2)\\)&quot;]">
    <problem>
      <para> \(\begin{array}{c}\left\{\begin{array}{l}6x\;-\;10y\;=\;-18\\25x\;+\;10y\;=\;80\end{array}\right.\\\\\end{array}\)</para>
      </problem>
    <solution>
      <para>Correct! (2,3)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.4.2.</para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q4-->
  <exercise data-content-id="75fa3632-dadc-489a-9eff-d203695279a5" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((–9,3)\)" data-solution-options="[&quot;\\((–14,5)\\)&quot;, &quot;\\((–9,3)\\)&quot;, &quot;\\((1,–1)\\)&quot;, &quot;\\((7,–2)\\)&quot;]">
    <problem>
      <para> \(\begin{array}{c}\left\{\begin{array}{l}-6x\;-\;16y\;=\;6\\6x\;+\;15y\;=\;-9\end{array}\right.\\\\\end{array}\)</para>
      </problem>
    <solution>
      <para>Correct! (–9,3)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.4.2. </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q5-->
  <exercise data-content-id="1606a163-8ce5-4423-b192-a7a80db1b8df" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((9,5)\)" data-solution-options="[&quot;\\((12,0)\\)&quot;, &quot;\\((9,5)\\)&quot;, &quot;\\((17,2)\\)&quot;, &quot;\\((6,10)\\)&quot;]">
    <problem>
      <para>\(\begin{array}{c}\left\{\begin{array}{l}-15x\;-\;40y\;=\;-335\\15x\;+\;9y\;=\;180\end{array}\right.\\\\\end{array}\)</para>
      </problem>
    <solution>
      <para>Correct! (9,5)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.4.2. </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q6-->
  <exercise data-content-id="7f62f6bc-0927-4701-ad87-7bd26075d331" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((–3,2)\)" data-solution-options="[&quot;\\((–3,2)\\)&quot;, &quot;\\((0,3)\\)&quot;, &quot;\\((2,0)\\)&quot;, &quot;\\((–9,0)\\)&quot;]">
    <problem>
      <para> \(\begin{array}{c}\left\{\begin{array}{l}x\;-\;3y\;=\;-9\\x\;+\;\frac52y\;=\;2\end{array}\right.\\\\\end{array}\)</para>
      </problem>
    <solution>
      <para>Correct! (–3,2)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.4.2. </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q7-->
  <exercise data-content-id="76adac7b-2ac7-4495-939d-f3d72bf39cbc" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((2,3)\)" data-solution-options="[&quot;\\((3,0)\\)&quot;, &quot;\\((0,9)\\)&quot;, &quot;\\((0,15)\\)&quot;, &quot;\\((2,3)\\)&quot;]">
    <problem>
      <para> \(\begin{array}{c}\left\{\begin{array}{l}x\;+\;\frac13y\;=\;3\\2x\;+\;\frac13y\;=\;5\end{array}\right.\\\\\end{array}\)</para>
      </problem>
    <solution>
      <para>Correct! (2,3)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.4.2. </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q8-->
  <exercise data-content-id="fe2806c3-3036-44ac-a849-e20f06597ff8" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((–5,2.5)\)" data-solution-options="[&quot;\\((–9,0)\\)&quot;, &quot;\\((7,7)\\)&quot;, &quot;\\((–5,2.5)\\)&quot;, &quot;\\((–1,4)\\)&quot;]">
    <problem>
      <para> \(\begin{array}{c}\left\{\begin{array}{l}3x\;-\;8y\;=\;-35\\-5x\;+\;8y\;=\;45\end{array}\right.\\\\\end{array}\)</para>
      </problem>
    <solution>
      <para>Correct! (–5,2.5)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.4.2. </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
