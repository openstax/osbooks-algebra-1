  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <para id="para-00002">For questions 1 – 8, solve the systems of equations using the elimination method.</para>

        <exercise id="de4b55db-3c3d-4fbf-802a-2fdb361502fa" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00003"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="center"><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>5</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>2</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>2</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>0</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"/></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00004">Multiple Choice:</para>
            <para id="para-00005"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00006"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00007"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00008"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00001">
            <para id="para-00009">Correct! (–2,6)</para>
            <para id="para-00010">Try again. Revisit activity 2.4.2.</para>
            <para id="para-00011">The correct answer is (–2,6).</para>
          </solution>
        </exercise>

        <exercise id="_1ef45c95-a2ca-4d74-9d47-59d60e215782" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00012"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="center"><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>2</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>5</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>7</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>15</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>5</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>85</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"/></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00013">Multiple Choice:</para>
            <para id="para-00014"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo>,</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00015"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00016"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00017"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>4</m:mn><m:mo>,</m:mo><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00002">
            <para id="para-00018">Correct! (6,1)</para>
            <para id="para-00019">Try again. Revisit activity 2.4.2.</para>
            <para id="para-00020">The correct answer is (6,1).</para>
          </solution>
        </exercise>

        <exercise id="_4abaa7ae-ee8d-4cee-80da-26363cb2a64e" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00021"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="center"><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>6</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>10</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>18</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>25</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>10</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>80</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"/></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00022">Multiple Choice:</para>
            <para id="para-00023"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00024"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo>,</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00025"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00026"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00003">
            <para id="para-00027">Correct! (2,3)</para>
            <para id="para-00028">Try again. Revisit activity 2.4.2.</para>
            <para id="para-00029">The correct answer is (2,3).</para>
          </solution>
        </exercise>

        <exercise id="_75fa3632-dadc-489a-9eff-d203695279a5" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00030"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="center"><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>16</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>6</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>15</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>9</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"/></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00031">Multiple Choice:</para>
            <para id="para-00032"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>14</m:mn><m:mo>,</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00033"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>9</m:mn><m:mo>,</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00034"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00035"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00004">
            <para id="para-00036">Correct! (–9,3)</para>
            <para id="para-00037">Try again. Revisit activity 2.4.2.</para>
            <para id="para-00038">The correct answer is (–9,3).</para>
          </solution>
        </exercise>

        <exercise id="_1606a163-8ce5-4423-b192-a7a80db1b8df" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00039"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="center"><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>15</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>40</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>335</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>15</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>9</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>180</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"/></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00040">Multiple Choice:</para>
            <para id="para-00041"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00042"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo>,</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00043"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>17</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00044"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00005">
            <para id="para-00045">Correct! (9,5)</para>
            <para id="para-00046">Try again. Revisit activity 2.4.2.</para>
            <para id="para-00047">The correct answer is (9,5).</para>
          </solution>
        </exercise>

        <exercise id="_7f62f6bc-0927-4701-ad87-7bd26075d331" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00048"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="center"><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>3</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>9</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>2</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"/></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00049">Multiple Choice:</para>
            <para id="para-00050"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00051"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00052"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00053"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>9</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00006">
            <para id="para-00054">Correct! (–3,2)</para>
            <para id="para-00055">Try again. Revisit activity 2.4.2.</para>
            <para id="para-00056">The correct answer is (–3,2).</para>
          </solution>
        </exercise>

        <exercise id="_76adac7b-2ac7-4495-939d-f3d72bf39cbc" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00057"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="center"><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>3</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>2</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>5</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"/></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00058">Multiple Choice:</para>
            <para id="para-00059"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00060"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00061"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>15</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00062"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00007">
            <para id="para-00063">Correct! (2,3)</para>
            <para id="para-00064">Try again. Revisit activity 2.4.2.</para>
            <para id="para-00065">The correct answer is (2,3).</para>
          </solution>
        </exercise>

        <exercise id="fe2806c3-3036-44ac-a849-e20f06597ff8" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00066"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="center"><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>3</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>8</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>35</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>8</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>45</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"/></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00067">Multiple Choice:</para>
            <para id="para-00068"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>9</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00069"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo>,</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00070"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>2.5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00071"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00008">
            <para id="para-00072">Correct! (–5,2.5)</para>
            <para id="para-00073">Try again. Revisit activity 2.4.2.</para>
            <para id="para-00074">The correct answer is (–5,2.5).</para>
          </solution>
        </exercise>

      <para id="para-00075">For questions 9 – 10, add the equations in the following systems of equations. What is
        the resulting new equation?</para>

        <exercise id="_15b8e870-9833-4088-8cc6-2900e1100eaf" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00076"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="center"><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>4</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>6</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>14</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>19</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"/></m:mtr></m:mtable></m:mrow></m:math></para></problem>
          <solution id="sol-00009">
            <para id="para-00077">Correct! <m:math display="inline"><m:mrow><m:mi>–</m:mi><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>5</m:mn></m:mrow></m:math></para>
            <para id="para-00078">Try again. Revisit activity 2.4.3.</para>
            <para id="para-00079">The correct answer is <m:math display="inline"><m:mrow><m:mi>–</m:mi><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>5</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>

        <exercise id="_74aafc2f-8f98-44df-871e-38f772a35e51" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00080"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="center"><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>3</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mspace width="0.278em"/><m:mn>5</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>18</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>7</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>5</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>8</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"/></m:mtr></m:mtable></m:mrow></m:math></para></problem>
          <solution id="sol-00010">
            <para id="para-00081">Correct! <m:math display="inline"><m:mrow><m:mn>10</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math></para>
            <para id="para-00082">Try again. Revisit activity 2.4.3.</para>
            <para id="para-00083">The correct answer is <m:math display="inline"><m:mrow><m:mn>10</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
    </section>
