<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.4.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00431</md:content-id>
    <md:title>2.4.5: Practice</md:title>
    <md:uuid>916fa776-de43-4ec6-b675-c61bb8c12ced</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <para id="para-00002">For questions 1 – 8, solve the systems of equations using the elimination method.</para>

        <exercise id="de4b55db-3c3d-4fbf-802a-2fdb361502fa" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00003">
              \(\begin{array}{c}\left\{\begin{array}{l}5x\;+\;2y\;=\;2\\-6x\;-\;2y\;=\;0\end{array}\right.\\\\\end{array}\)</para>
            <para id="para-00004">Multiple Choice:</para>
            <para id="para-00005">\((–3,9)\)</para>
            <para id="para-00006">\((0,1)\)</para>
            <para id="para-00007">\((2,–4)\)</para>
            <para id="para-00008">\((–2,6)\)</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00009">Correct! (–2,6)</para>
            <para id="para-00010">Try again. Revisit activity 2.4.2.</para>
            <para id="para-00011">The correct answer is (–2,6).</para>
          </solution>
        </exercise>

        <exercise id="_1ef45c95-a2ca-4d74-9d47-59d60e215782" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00012">
              \(\begin{array}{c}\left\{\begin{array}{l}2x\;-\;5y\;=\;7\\-15x\;+\;5y\;=\;-85\end{array}\right.\\\\\end{array}\)</para>
            <para id="para-00013">Multiple Choice:</para>
            <para id="para-00014">\((7,4)\)</para>
            <para id="para-00015">\((5,−2)\)</para>
            <para id="para-00016">\((6,1)\)</para>
            <para id="para-00017">\((−4,−3)\)</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00018">Correct! (6,1)</para>
            <para id="para-00019">Try again. Revisit activity 2.4.2.</para>
            <para id="para-00020">The correct answer is (6,1).</para>
          </solution>
        </exercise>

        <exercise id="_4abaa7ae-ee8d-4cee-80da-26363cb2a64e" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00021">
              \(\begin{array}{c}\left\{\begin{array}{l}6x\;-\;10y\;=\;-18\\25x\;+\;10y\;=\;80\end{array}\right.\\\\\end{array}\)</para>
            <para id="para-00022">Multiple Choice:</para>
            <para id="para-00023">\((2,3)\)</para>
            <para id="para-00024">\((7,6)\)</para>
            <para id="para-00025">\((0,8)\)</para>
            <para id="para-00026">\((4,−2)\)</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00027">Correct! (2,3)</para>
            <para id="para-00028">Try again. Revisit activity 2.4.2.</para>
            <para id="para-00029">The correct answer is (2,3).</para>
          </solution>
        </exercise>

        <exercise id="_75fa3632-dadc-489a-9eff-d203695279a5" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00030">
              \(\begin{array}{c}\left\{\begin{array}{l}-6x\;-\;16y\;=\;6\\6x\;+\;15y\;=\;-9\end{array}\right.\\\\\end{array}\)</para>
            <para id="para-00031">Multiple Choice:</para>
            <para id="para-00032">\((–14,5)\)</para>
            <para id="para-00033">\((–9,3)\)</para>
            <para id="para-00034">\((1,–1)\)</para>
            <para id="para-00035">\((7,–2)\)</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00036">Correct! (–9,3)</para>
            <para id="para-00037">Try again. Revisit activity 2.4.2.</para>
            <para id="para-00038">The correct answer is (–9,3).</para>
          </solution>
        </exercise>

        <exercise id="_1606a163-8ce5-4423-b192-a7a80db1b8df" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00039">
              \(\begin{array}{c}\left\{\begin{array}{l}-15x\;-\;40y\;=\;-335\\15x\;+\;9y\;=\;180\end{array}\right.\\\\\end{array}\)</para>
            <para id="para-00040">Multiple Choice:</para>
            <para id="para-00041">\((12,0)\)</para>
            <para id="para-00042">\((9,5)\)</para>
            <para id="para-00043">\((17,2)\)</para>
            <para id="para-00044">\((6,10)\)</para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00045">Correct! (9,5)</para>
            <para id="para-00046">Try again. Revisit activity 2.4.2.</para>
            <para id="para-00047">The correct answer is (9,5).</para>
          </solution>
        </exercise>

        <exercise id="_7f62f6bc-0927-4701-ad87-7bd26075d331" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00048">
              \(\begin{array}{c}\left\{\begin{array}{l}x\;-\;3y\;=\;-9\\x\;+\;\frac52y\;=\;2\end{array}\right.\\\\\end{array}\)</para>
            <para id="para-00049">Multiple Choice:</para>
            <para id="para-00050">\((–3,2)\)</para>
            <para id="para-00051">\((0,3)\)</para>
            <para id="para-00052">\((2,0)\)</para>
            <para id="para-00053">\((–9,0)\)</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00054">Correct! (–3,2)</para>
            <para id="para-00055">Try again. Revisit activity 2.4.2.</para>
            <para id="para-00056">The correct answer is (–3,2).</para>
          </solution>
        </exercise>

        <exercise id="_76adac7b-2ac7-4495-939d-f3d72bf39cbc" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00057">
              \(\begin{array}{c}\left\{\begin{array}{l}x\;+\;\frac13y\;=\;3\\2x\;+\;\frac13y\;=\;5\end{array}\right.\\\\\end{array}\)</para>
            <para id="para-00058">Multiple Choice:</para>
            <para id="para-00059">\((3,0)\)</para>
            <para id="para-00060">\((0,9)\)</para>
            <para id="para-00061">\((0,15)\)</para>
            <para id="para-00062">\((2,3)\)</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00063">Correct! (2,3)</para>
            <para id="para-00064">Try again. Revisit activity 2.4.2.</para>
            <para id="para-00065">The correct answer is (2,3).</para>
          </solution>
        </exercise>

        <exercise id="fe2806c3-3036-44ac-a849-e20f06597ff8" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00066">
              \(\begin{array}{c}\left\{\begin{array}{l}3x\;-\;8y\;=\;-35\\-5x\;+\;8y\;=\;45\end{array}\right.\\\\\end{array}\)</para>
            <para id="para-00067">Multiple Choice:</para>
            <para id="para-00068">\((–9,0)\)</para>
            <para id="para-00069">\((7,7)\)</para>
            <para id="para-00070">\((–5,2.5)\)</para>
            <para id="para-00071">\((–1,4)\)</para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00072">Correct! (–5,2.5)</para>
            <para id="para-00073">Try again. Revisit activity 2.4.2.</para>
            <para id="para-00074">The correct answer is (–5,2.5).</para>
          </solution>
        </exercise>

      <para id="para-00075">For questions 9 – 10, add the equations in the following systems of equations. What is
        the resulting new equation?</para>

        <exercise id="_15b8e870-9833-4088-8cc6-2900e1100eaf" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00076">
              \(\begin{array}{c}\left\{\begin{array}{l}4x\;-\;6y\;=\;14\\-4x\;+\;y\;=\;-19\end{array}\right.\\\\\end{array}\)</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00077">Correct! \(–5y = –5\)</para>
            <para id="para-00078">Try again. Revisit activity 2.4.3.</para>
            <para id="para-00079">The correct answer is \(–5y = –5\).</para>
          </solution>
        </exercise>

        <exercise id="_74aafc2f-8f98-44df-871e-38f772a35e51" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00080">
              \(\begin{array}{c}\left\{\begin{array}{l}3x\;-\;5y\;=\;18\\7x\;+\;5y\;=\;-8\end{array}\right.\\\\\end{array}\)</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00081">Correct! \(10x = 10\)</para>
            <para id="para-00082">Try again. Revisit activity 2.4.3.</para>
            <para id="para-00083">The correct answer is \(10 x = 10\).</para>
          </solution>
        </exercise>
    </section>
  </content>
