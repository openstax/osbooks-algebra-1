</div>

<para>For questions 9 – 10, add the equations in the following systems of equations. What is the resulting new equation?</para>

<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="1c4e75d6-4f29-4fe7-aa12-d0265467cb2a" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--Q9-->
  <exercise data-content-id="15b8e870-9833-4088-8cc6-2900e1100eaf" data-problem-comparator="math" data-problem-type="input" data-solution="-5y = -5">
    <problem>
      <para> \(\begin{array}{c}\left\{\begin{array}{l}4x\;-\;6y\;=\;14\\-4x\;+\;y\;=\;-19\end{array}\right.\\\\\end{array}\)</para>
      </problem>
    <solution>
      <para>Correct! \(–5y = –5\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.4.3.</para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q10-->
  <exercise data-content-id="74aafc2f-8f98-44df-871e-38f772a35e51" data-problem-comparator="math" data-problem-type="input" data-solution="10x = 10">
    <problem>
      <para> \(\begin{array}{c}\left\{\begin{array}{l}3x\;-\;5y\;=\;18\\7x\;+\;5y\;=\;-8\end{array}\right.\\\\\end{array}\)</para>
      </problem>
    <solution>
      <para>Correct! \(10x = 10\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.4.3. </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
