<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Finding Solutions to Inequalities on the Coordinate Plane</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00566</md:content-id>
    <md:title>Finding Solutions to Inequalities on the Coordinate Plane</md:title>
    <md:uuid>aaa75b98-5b39-43d7-887a-57837c4052fd</md:uuid>
