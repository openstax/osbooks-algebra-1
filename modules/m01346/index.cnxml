<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.6.3: Interpreting Negative Exponents in Exponential Decay</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01346</md:content-id>
    <md:title>5.6.3: Interpreting Negative Exponents in Exponential Decay</md:title>
    <md:uuid>7e26d98d-8cc2-4f2e-8bd5-e041f868c355</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <title>Activity</title>

      <para id="para-00001">A person took some medicine but does not remember how much. Concerned
        that she took too much, she has a blood test every hour for several hours.</para>
      <table class="unnumbered os-raise-midsizetable" id="table-00001">
        <tgroup cols="2">
          <tbody>
            <row>
              <entry>
                <emphasis><m:math display="inline">
                    <m:mrow>
                      <m:mi>t</m:mi>
                    </m:mrow>
                  </m:math>, time
                (hours)</emphasis>
              </entry>
              <entry>
                <emphasis><m:math display="inline">
                    <m:mrow>
                      <m:mi>m</m:mi>
                    </m:mrow>
                  </m:math>,
                medicine (mg)</emphasis>
              </entry>
            </row>
            <row>
              <entry> –3 </entry>
              <entry> </entry>
            </row>
            <row>
              <entry> –1 </entry>
              <entry> </entry>
            </row>
            <row>
              <entry> 0 </entry>
              <entry> 100 </entry>
            </row>
            <row>
              <entry> 1 </entry>
              <entry> 50 </entry>
            </row>
            <row>
              <entry> 2 </entry>
              <entry> 25 </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
      <para id="para-00002">Answer the following questions. Double click on mathematical
        expressions/equations to enlarge. </para>
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00003">Time <m:math display="inline">
              <m:mrow>
                <m:mi>t</m:mi>
              </m:mrow>
            </m:math> is measured in hours
            since the blood test, and amount of medicine in her body, <m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
              </m:mrow>
            </m:math>, is measured in
            milligrams. What is the decay factor? That is, what is <m:math display="inline">
              <m:mrow>
                <m:mi>b</m:mi>
              </m:mrow>
            </m:math> in an equation of the
            form <m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mi>a</m:mi>
                <m:mi>·</m:mi>
                <m:msup>
                  <m:mi>b</m:mi>
                  <m:mi>t</m:mi>
                </m:msup>
              </m:mrow>
            </m:math>
            ?</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00005">Compare your answer:</para>
          <para id="para-00004"><m:math display="inline">
              <m:mrow>
                <m:mi>b</m:mi>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mn>1</m:mn>
                  <m:mn>2</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00007"> What is <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
              </m:mrow>
            </m:math>?</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00009">Compare your answer:</para>
          <para id="para-00006"><m:math>
              <m:mrow>
                <m:mi>a</m:mi>
                <m:mo>=</m:mo>
                <m:mn>100</m:mn>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00011">Find the amounts of medicine in the patient’s body when <m:math
              display="inline">
              <m:mrow>
                <m:mi>t</m:mi>
              </m:mrow>
            </m:math> is –1.</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00013">Compare your answer:</para>
          <para id="para-00014">When <m:math display="inline">
              <m:mrow>
                <m:mi>t</m:mi>
              </m:mrow>
            </m:math> is –1, <m:math
              display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
              </m:mrow>
            </m:math> is 200.</para>
        </solution>
      </exercise>
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00015">Find the amounts of medicine in the patient’s body when <m:math
              display="inline">
              <m:mrow>
                <m:mi>t</m:mi>
              </m:mrow>
            </m:math> is –3.</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00017">Compare your answer:</para>
          <para id="para-00018">When <m:math display="inline">
              <m:mrow>
                <m:mi>t</m:mi>
              </m:mrow>
            </m:math> is –3, <m:math
              display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
              </m:mrow>
            </m:math> is 800.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Interaction
      End -->
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00005">
        <problem id="prob-00005">
          <para id="para-00019">What does <m:math display="inline">
              <m:mrow>
                <m:mi>t</m:mi>
                <m:mo>=</m:mo>
                <m:mn>0</m:mn>
              </m:mrow>
            </m:math> mean in this context?</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00021">Compare your answer:</para>
          <para id="para-00022">
            <m:math display="inline">
              <m:mrow>
                <m:mi>t</m:mi>
                <m:mo>=</m:mo>
                <m:mn>0</m:mn>
              </m:mrow>
            </m:math> means the time the doctor
            did the first blood test.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <exercise id="exer-00006">
        <problem id="prob-00006">
          <para id="para-00023">What does <m:math display="inline">
              <m:mrow>
                <m:mi>t</m:mi>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>3</m:mn>
              </m:mrow>
            </m:math> mean in this context?</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00025">Compare your answer:</para>
          <para id="para-00026">
            <m:math display="inline">
              <m:mrow>
                <m:mi>t</m:mi>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>3</m:mn>
              </m:mrow>
            </m:math> means 3 hours before the
            doctor did the first test.</para>
        </solution>
      </exercise>
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00007">
        <problem id="prob-00007">
          <para id="para-00027">The medicine was taken when <m:math display="inline">
              <m:mrow>
                <m:mi>t</m:mi>
              </m:mrow>
            </m:math> is –5. Assuming the
            person did not have any of the medication in her body beforehand, how much medicine did
            the patient take?</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00029">Compare your answer:</para>
          <para id="para-00030">3,200 mg. Each hour, this is cut in half. After being halved 5
            times, it leaves 100 mg, the amount of medicine in the person’s body when <m:math
              display="inline">
              <m:mrow>
                <m:mi>t</m:mi>
                <m:mo>=</m:mo>
                <m:mn>0</m:mn>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <exercise id="exer-00008">
        <problem id="prob-00008">
          <para id="para-00031">Create a graph by plotting the points whose coordinates are in the
            table from question 1 above. Make sure to draw and label tick marks on the axes.</para>
          <para id="para-00032">

            <media alt="Insert Alt Text">
              <image mime-type="image/svg+xml" src="../../media/Algebra-1_05_08_06_01.svg" />
            </media>

          </para>
          <para id="para-00033">Write down your answer, then select the <emphasis>solution</emphasis>
            button to compare your work. </para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00034">Compare your answer:</para>
          <para id="para-00035">

            <media alt="">
              <image mime-type="image/svg+xml" src="../../media/Algebra-1_05_08_06_02.svg" />
            </media>

          </para>
        </solution>
      </exercise>

      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00009">
        <problem id="prob-00009">
          <para id="para-00036">Based on your graph, when do you think the patient will have: 500 mg
            of medicine remaining in her body</para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00038">Compare your answer:</para>
          <para id="para-00039">Between 2 and 3 hours before the patient first had her blood tested</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00010">
        <problem id="prob-00010">
          <para id="para-00040">Based on your graph, when do you think the patient will have: No
            medicine remaining in her body</para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00042">Compare your answer: Your answer may vary, but here are some
            samples: </para>
          <list id="list-00001">
            <item>Sometime after 10 hours. The amount of medicine falls below 0.1 mg after about 10
              hours and might be too small to be detectable after that point.</item>
            <item>Eventually, all of the medicine will be out of the patient’s body (but the
              mathematical model for the amount of medicine does not reach 0).</item>
          </list>
        </solution>
      </exercise></section>
      <!--Interaction End -->
      <!-- "Start "Are you Ready for More? click to reveal.  If you have more than one on a page, you will need to change the Data-fire/data-wait-for-events for each set.-->
      
      <section id="sect-00002">
        <title>Are you ready for more?</title>
          <section class="practice" id="sect-00003"><title>Extending Your Thinking</title>
      
      <!--Start interaction.  If multiple interactions appear under "are you ready for more?, they should all have matching "data-wait-for-event", which should also match the "data-fire-event" for the button. Note in this sample, they are all RFM1-->
      <section id="sect-00004">
        <exercise id="a1f54a9b-cea1-45c5-ac43-2ac7329663a6" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00043">Without evaluating them, describe each of the following quantities as close to 0, close to 1, or much larger
        than 1.</para>
            <para id="para-00008"><m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>1</m:mn><m:mo>−</m:mo><m:msup><m:mn>2</m:mn><m:mrow><m:mo>−</m:mo><m:mn>10</m:mn></m:mrow></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para></problem>
          <solution id="sol-00011">
            <para id="para-00045">Correct! The answer is: close to 1</para>
            <para id="para-00046">The correct answer is: close to 1</para>
          </solution>
        </exercise>
        <exercise id="_5ca31138-9e4f-4b4d-ad63-509dbdb6a8ef" class="multiple-choice">
          <problem id="prob-00012">
            <para id="para-00047">Without evaluating them, describe each of the following quantities as close to 0, close to 1, or much larger
        than 1.</para>
            <para id="para-00010"><m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:msup><m:mn>2</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:msup></m:mrow><m:mrow><m:msup><m:mn>2</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:msup><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para></problem>
          <solution id="sol-00012">
            <para id="para-00049">Correct! The answer is: close to 1</para>
            <para id="para-00050">The correct answer is: close to 1</para>
          </solution>
        </exercise>
        <exercise id="edc064ea-76ed-49fe-aa30-d41afe493426" class="multiple-choice">
          <problem id="prob-00013">
            <para id="para-00051">Without evaluating them, describe each of the following quantities as close to 0, close to 1, or much larger
        than 1.</para>
            <para id="para-00012"><m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:msup><m:mn>2</m:mn><m:mrow><m:mo>−</m:mo><m:mn>10</m:mn></m:mrow></m:msup></m:mrow><m:mrow><m:msup><m:mn>2</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:msup><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para></problem>
          <solution id="sol-00013">
            <para id="para-00053">Correct! The answer is: close to 0</para>
            <para id="para-00054">The correct answer is: close to 0</para>
          </solution>
        </exercise>
        <exercise id="a715a50b-aebc-4bb7-9e97-346d824a0243" class="multiple-choice">
          <problem id="prob-00014">
            <para id="para-00055">Without evaluating them, describe each of the following quantities as close to 0, close to 1, or much larger
        than 1.</para>
            <para id="para-00016"><m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn><m:mo>−</m:mo><m:msup><m:mn>2</m:mn><m:mrow><m:mo>−</m:mo><m:mn>10</m:mn></m:mrow></m:msup></m:mrow><m:mrow><m:msup><m:mn>2</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para></problem>
          <solution id="sol-00014">
            <para id="para-00057">Correct! The answer is: close to 0</para>
            <para id="para-00058">The correct answer is: close to 0</para>
          </solution>
        </exercise>
        <exercise id="fff56ade-4ac8-4bb1-95e8-015e427ddb17" class="multiple-choice">
          <problem id="prob-00015">
            <para id="para-00059">Without evaluating them, describe each of the following quantities as close to 0, close to 1, or much larger
        than 1.</para>
            <para id="para-00020"><m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn><m:mo>+</m:mo><m:msup><m:mn>2</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:msup></m:mrow><m:mrow><m:msup><m:mn>2</m:mn><m:mrow><m:mo>−</m:mo><m:mn>10</m:mn></m:mrow></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para></problem>
          <solution id="sol-00015">
            <para id="para-00061">Correct! The answer is: much larger than 1</para>
            <para id="para-00062">The correct answer is: much larger than 1</para>
          </solution>
        </exercise>
      </section>
      <!--End interaction-->
    </section>
  </section>
  <note class="self-check" id="note-00001">
    <exercise id="exer-00012">
      <problem id="prob-00017">
      <para id="para-00024"><link class="os-embed" url="#exercise/Alg1_5_6_3_SC"/></para>
      </problem>
      </exercise>
    </note>

    <section id="sect-00005">
      <title>Additional Resources</title>

      <section id="sect-00006">
        <title>Interpreting Negative Exponents in Exponential Decay</title>
        <para id="para-00064">Let’s look at a problem involving an exponential decay equation and
          negative exponents.</para>
        <para id="para-00065">A scientist records the population of a bacterial population in a
          petri dish. The data are shown in the table.</para>

        <table class="unnumbered os-raise-midsizetable" id="table-00003">
          <tgroup cols="2">
            <tbody>
              <row>
                <entry><emphasis><m:math display="inline">
                      <m:mrow>
                        <m:mi>d</m:mi>
                      </m:mrow>
                    </m:math>,
                  days since first test</emphasis></entry>
                <entry><emphasis><m:math display="inline">
                      <m:mrow>
                        <m:mi>b</m:mi>
                      </m:mrow>
                    </m:math>,
                  number of bacteria</emphasis></entry>
              </row>
              <row>
                <entry> –3 </entry>
                <entry> </entry>
              </row>
              <row>
                <entry> –1 </entry>
                <entry> </entry>
              </row>
              <row>
                <entry> 0 </entry>
                <entry> 40,000 </entry>
              </row>
              <row>
                <entry> 1 </entry>
                <entry> 20,000 </entry>
              </row>
              <row>
                <entry> 3 </entry>
                <entry> 5,000 </entry>
              </row>
            </tbody>
          </tgroup>
        </table>

        <para id="para-00066">The number of days <m:math display="inline">
            <m:mrow>
              <m:mi>d</m:mi>
            </m:mrow>
          </m:math> since the first test
          corresponds with the number of bacteria, <m:math display="inline">
            <m:mrow>
              <m:mi>b</m:mi>
            </m:mrow>
          </m:math>, estimated to be alive in the
          petri dish.</para>
        <list class="os-raise-noindent" list-type="enumerated" id="list-00002">
          <item><para>What is the decay factor? That is, what is <m:math display="inline">
              <m:mrow>
                <m:mi>f</m:mi>
              </m:mrow>
            </m:math> in an equation of the
            form <m:math display="inline">
              <m:mrow>
                <m:mi>b</m:mi>
                <m:mo>=</m:mo>
                <m:mi>n</m:mi>
                <m:mi>·</m:mi>
                <m:msup>
                  <m:mi>f</m:mi>
                  <m:mi>d</m:mi>
                </m:msup>
              </m:mrow>
            </m:math>?
            What is the starting population, <m:math display="inline">
              <m:mrow>
                <m:mi>n</m:mi>
              </m:mrow>
            </m:math>, on the first day of
            testing?</para><para>Since the number of bacteria found on day 0 is 40,000, then <m:math
              display="inline">
              <m:mrow>
                <m:mi>n</m:mi>
                <m:mo>=</m:mo>
                <m:mn>40</m:mn>
                <m:mo>,</m:mo>
                <m:mn>000</m:mn>
              </m:mrow>
            </m:math>. Since after each day,
            the number of bacteria is cut in half, then the decay factor, <m:math display="inline">
              <m:mrow>
                <m:mi>f</m:mi>
              </m:mrow>
            </m:math>, is <m:math
              display="inline">
              <m:mrow>
                <m:mfrac>
                  <m:mn>1</m:mn>
                  <m:mn>2</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math>.</para>
            <para>The equation to represent this situation is <m:math display="inline">
              <m:mrow>
                <m:mi>b</m:mi>
                <m:mo>=</m:mo>
                <m:mn>40</m:mn>
                <m:mo>,</m:mo>
                <m:mn>000</m:mn>
                <m:mi>·</m:mi>
                <m:msup>
                  <m:mrow>
                    <m:mo stretchy="true" fence="true" form="prefix">(</m:mo>
                    <m:mfrac>
                      <m:mn>1</m:mn>
                      <m:mn>2</m:mn>
                    </m:mfrac>
                    <m:mo stretchy="true" fence="true" form="postfix">)</m:mo>
                  </m:mrow>
                  <m:mi>d</m:mi>
                </m:msup>
              </m:mrow>
            </m:math>
            .</para>
     </item>

          <item><para>What do <m:math display="inline">
              <m:mrow>
                <m:mi>d</m:mi>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>1</m:mn>
              </m:mrow>
            </m:math> and <m:math
              display="inline">
              <m:mrow>
                <m:mi>d</m:mi>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>3</m:mn>
              </m:mrow>
            </m:math> mean in this context?</para>
            <para>Since the day the first test is taken is defined as <m:math display="inline">
              <m:mrow>
                <m:mi>d</m:mi>
                <m:mo>=</m:mo>
                <m:mn>0</m:mn>
              </m:mrow>
            </m:math>, then days with a
            negative value occured before the first test. <m:math display="inline">
              <m:mrow>
                <m:mi>d</m:mi>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>1</m:mn>
              </m:mrow>
            </m:math> means 1 day before the
            scientist did the first test. <m:math display="inline">
              <m:mrow>
                <m:mi>d</m:mi>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>3</m:mn>
              </m:mrow>
            </m:math> means 3 days before the
            scientist did the first test.</para></item>

          <item><para>How many bacteria were present 1 day before the first test?</para>
            <para>Substitute –1 for <m:math
              display="inline">
              <m:mrow>
                <m:mi>d</m:mi>
              </m:mrow>
            </m:math> in the equation <m:math
              display="inline">
              <m:mrow>
                <m:mi>b</m:mi>
                <m:mo>=</m:mo>
                <m:mn>40</m:mn>
                <m:mo>,</m:mo>
                <m:mn>000</m:mn>
                <m:mi>·</m:mi>
                <m:msup>
                  <m:mrow>
                    <m:mo stretchy="true" fence="true" form="prefix">(</m:mo>
                    <m:mfrac>
                      <m:mn>1</m:mn>
                      <m:mn>2</m:mn>
                    </m:mfrac>
                    <m:mo stretchy="true" fence="true" form="postfix">)</m:mo>
                  </m:mrow>
                  <m:mi>d</m:mi>
                </m:msup>
              </m:mrow>
            </m:math>
            .</para>
    
        <para><m:math display="inline">
              <m:mrow>
                <m:mi>b</m:mi>
                <m:mo>=</m:mo>
                <m:mn>40</m:mn>
                <m:mo>,</m:mo>
                <m:mn>000</m:mn>
                <m:mi>·</m:mi>
                <m:msup>
                  <m:mrow>
                    <m:mo stretchy="true" fence="true" form="prefix">(</m:mo>
                    <m:mfrac>
                      <m:mn>1</m:mn>
                      <m:mn>2</m:mn>
                    </m:mfrac>
                    <m:mo stretchy="true" fence="true" form="postfix">)</m:mo>
                  </m:mrow>
                  <m:mi>d</m:mi>
                </m:msup>
              </m:mrow>
            </m:math></para>
        <para><m:math
              display="inline">
              <m:mrow>
                <m:mi>b</m:mi>
                <m:mo>=</m:mo>
                <m:mn>40</m:mn>
                <m:mo>,</m:mo>
                <m:mn>000</m:mn>
                <m:mi>·</m:mi>
                <m:msup>
                  <m:mrow>
                    <m:mo stretchy="true" fence="true" form="prefix">(</m:mo>
                    <m:mfrac>
                      <m:mn>1</m:mn>
                      <m:mn>2</m:mn>
                    </m:mfrac>
                    <m:mo stretchy="true" fence="true" form="postfix">)</m:mo>
                  </m:mrow>
                  <m:mrow>
                    <m:mo>−</m:mo>
                    <m:mn>1</m:mn>
                  </m:mrow>
                </m:msup>
              </m:mrow>
            </m:math></para><para>
        <m:math
              display="inline">
              <m:mrow>
                <m:mi>b</m:mi>
                <m:mo>=</m:mo>
                <m:mn>40</m:mn>
                <m:mo>,</m:mo>
                <m:mn>000</m:mn>
                <m:mi>·</m:mi>
                <m:mn>2</m:mn>
              </m:mrow>
            </m:math></para><para>
        <m:math display="inline">
              <m:mrow>
                <m:mi>b</m:mi>
                <m:mo>=</m:mo>
                <m:mn>80</m:mn>
                <m:mo>,</m:mo>
                <m:mn>000</m:mn>
              </m:mrow>
            </m:math></para>
            <para>There were 80,000
            bacteria in the petri dish 1 day before the test.</para></item>

          <item><para>Assume the peak of the bacterial population was 3 days before the first test. How
            many bacteria were present at the peak of the population?</para>
            <para>Substitute –3 for <m:math
              display="inline">
              <m:mrow>
                <m:mi>d</m:mi>
              </m:mrow>
            </m:math> in the equation <m:math
              display="inline">
              <m:mrow>
                <m:mi>b</m:mi>
                <m:mo>=</m:mo>
                <m:mn>40</m:mn>
                <m:mo>,</m:mo>
                <m:mn>000</m:mn>
                <m:mi>·</m:mi>
                <m:msup>
                  <m:mrow>
                    <m:mo stretchy="true" fence="true" form="prefix">(</m:mo>
                    <m:mfrac>
                      <m:mn>1</m:mn>
                      <m:mn>2</m:mn>
                    </m:mfrac>
                    <m:mo stretchy="true" fence="true" form="postfix">)</m:mo>
                  </m:mrow>
                  <m:mi>d</m:mi>
                </m:msup>
              </m:mrow>
            </m:math>
            .</para><para>
        
        <m:math display="inline">
              <m:mrow>
                <m:mi>b</m:mi>
                <m:mo>=</m:mo>
                <m:mn>40</m:mn>
                <m:mo>,</m:mo>
                <m:mn>000</m:mn>
                <m:mi>·</m:mi>
                <m:msup>
                  <m:mrow>
                    <m:mo stretchy="true" fence="true" form="prefix">(</m:mo>
                    <m:mfrac>
                      <m:mn>1</m:mn>
                      <m:mn>2</m:mn>
                    </m:mfrac>
                    <m:mo stretchy="true" fence="true" form="postfix">)</m:mo>
                  </m:mrow>
                  <m:mi>d</m:mi>
                </m:msup>
              </m:mrow>
            </m:math></para><para>
        <m:math
              display="inline">
              <m:mrow>
                <m:mi>b</m:mi>
                <m:mo>=</m:mo>
                <m:mn>40</m:mn>
                <m:mo>,</m:mo>
                <m:mn>000</m:mn>
                <m:mi>·</m:mi>
                <m:msup>
                  <m:mrow>
                    <m:mo stretchy="true" fence="true" form="prefix">(</m:mo>
                    <m:mfrac>
                      <m:mn>1</m:mn>
                      <m:mn>2</m:mn>
                    </m:mfrac>
                    <m:mo stretchy="true" fence="true" form="postfix">)</m:mo>
                  </m:mrow>
                  <m:mrow>
                    <m:mo>−</m:mo>
                    <m:mn>3</m:mn>
                  </m:mrow>
                </m:msup>
              </m:mrow>
            </m:math></para><para> 
        <m:math
              display="inline">
              <m:mrow>
                <m:mi>b</m:mi>
                <m:mo>=</m:mo>
                <m:mn>40</m:mn>
                <m:mo>,</m:mo>
                <m:mn>000</m:mn>
                <m:mi>·</m:mi>
                <m:mn>8</m:mn>
              </m:mrow>
            </m:math></para><para> 
        <m:math display="inline">
              <m:mrow>
                <m:mi>b</m:mi>
                <m:mo>=</m:mo>
                <m:mn>320</m:mn>
                <m:mo>,</m:mo>
                <m:mn>000</m:mn>
              </m:mrow>
            </m:math></para>
            <para>There were 320,000
            bacteria in the petri dish 3 days before the test at the peak of the population.</para></item>
        </list>
        <note class="try" id="note-00002">
          <title>Try It: Interpreting Negative Exponents in Exponential Decay</title>
    <exercise
            id="exer-00011">
            <problem id="prob-00016">

              <para id="para-00067">An investor has tracked the value of a particular investment
          since 2016 that has depreciated over time. The data are shown in the table.</para>


              <table class="unnumbered os-raise-midsizetable" id="table-00004">
                <tgroup cols="2">
                  <tbody>
                    <row>
                      <entry><emphasis><m:math display="inline">
                            <m:mrow>
                              <m:mi>y</m:mi>
                            </m:mrow>
                          </m:math>,
          years since 2016</emphasis></entry>
                      <entry><emphasis><m:math display="inline">
                            <m:mrow>
                              <m:mi>v</m:mi>
                            </m:mrow>
                          </m:math>,
          value of investment ($)</emphasis></entry>
                    </row>
                    <row>
                      <entry> –2 </entry>
                      <entry> </entry>
                    </row>
                    <row>
                      <entry> –1 </entry>
                      <entry> </entry>
                    </row>
                    <row>
                      <entry> 0 </entry>
                      <entry> 36,000 </entry>
                    </row>
                    <row>
                      <entry> 1 </entry>
                      <entry> 12,000 </entry>
                    </row>
                    <row>
                      <entry> 2 </entry>
                      <entry> 4,000 </entry>
                    </row>
                  </tbody>
                </tgroup>
              </table>


              <para id="para-00068"> What is the equation that represents this situation? </para>
              <para id="para-00069"> What do <m:math display="inline">
                  <m:mrow>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mo>−</m:mo>
                    <m:mn>1</m:mn>
                  </m:mrow>
                </m:math> and <m:math
                  display="inline">
                  <m:mrow>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mo>−</m:mo>
                    <m:mn>2</m:mn>
                  </m:mrow>
                </m:math> mean in this
          context? </para>
              <para id="para-00070"> If the value of the investment was at its highest in 2014, what
          was the maximum value of the investment? </para>
              <para id="para-00071">Write down your answer, then select the <emphasis>solution</emphasis>
          button to compare your work. </para>

            </problem>
            <solution id="sol-00016">
              <para id="para-00072">Compare your answers:</para>

              <para id="para-00073">Here is how to solve this exponential growth problem using
          negative exponents:</para>

              <list class="os-raise-noindent" list-type="enumerated" id="list-00003">
                <item> The equation that represents this situation is <m:math display="inline">
                    <m:mrow>
                      <m:mi>v</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>36</m:mn>
                      <m:mo>,</m:mo>
                      <m:mn>000</m:mn>
                      <m:mi>·</m:mi>
                      <m:msup>
                        <m:mrow>
                          <m:mo stretchy="true" fence="true" form="prefix">(</m:mo>
                          <m:mfrac>
                            <m:mn>1</m:mn>
                            <m:mn>3</m:mn>
                          </m:mfrac>
                          <m:mo stretchy="true" fence="true" form="postfix">)</m:mo>
                        </m:mrow>
                        <m:mi>y</m:mi>
                      </m:msup>
                    </m:mrow>
                  </m:math>.
          The value of the investment in year 0 is $36,000, and the decay factor is <m:math
                    display="inline">
                    <m:mrow>
                      <m:mfrac>
                        <m:mn>1</m:mn>
                        <m:mn>3</m:mn>
                      </m:mfrac>
                    </m:mrow>
                  </m:math>
          .
       </item>
              </list>

              <list class="os-raise-noindent" list-type="enumerated" id="list-00004">
                <item>
                  <m:math display="inline">
                    <m:mrow>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                    </m:mrow>
                  </m:math> means 1
          year before 2016, which is 2015. <m:math display="inline">
                    <m:mrow>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>2</m:mn>
                    </m:mrow>
                  </m:math> means 2
          years before 2016, which is 2014. </item>
              </list>

              <list class="os-raise-noindent" list-type="enumerated" id="list-00005">
                <item> The maximum value of the investment was $324,000. <m:math display="inline">
                    <m:mrow>
                      <m:mi>v</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>36</m:mn>
                      <m:mo>,</m:mo>
                      <m:mn>000</m:mn>
                      <m:mi>·</m:mi>
                      <m:msup>
                        <m:mrow>
                          <m:mo stretchy="true" fence="true" form="prefix">(</m:mo>
                          <m:mfrac>
                            <m:mn>1</m:mn>
                            <m:mn>3</m:mn>
                          </m:mfrac>
                          <m:mo stretchy="true" fence="true" form="postfix">)</m:mo>
                        </m:mrow>
                        <m:mi>y</m:mi>
                      </m:msup>
                    </m:mrow>
                  </m:math> 
          <m:math
                    display="inline">
                    <m:mrow>
                      <m:mi>v</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>36</m:mn>
                      <m:mo>,</m:mo>
                      <m:mn>000</m:mn>
                      <m:mi>·</m:mi>
                      <m:msup>
                        <m:mrow>
                          <m:mo stretchy="true" fence="true" form="prefix">(</m:mo>
                          <m:mfrac>
                            <m:mn>1</m:mn>
                            <m:mn>3</m:mn>
                          </m:mfrac>
                          <m:mo stretchy="true" fence="true" form="postfix">)</m:mo>
                        </m:mrow>
                        <m:mrow>
                          <m:mo>−</m:mo>
                          <m:mn>2</m:mn>
                        </m:mrow>
                      </m:msup>
                    </m:mrow>
                  </m:math> 
          <m:math
                    display="inline">
                    <m:mrow>
                      <m:mi>v</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>36</m:mn>
                      <m:mo>,</m:mo>
                      <m:mn>000</m:mn>
                      <m:mi>·</m:mi>
                      <m:mn>9</m:mn>
                    </m:mrow>
                  </m:math> 
          <m:math
                    display="inline">
                    <m:mrow>
                      <m:mi>v</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>324</m:mn>
                      <m:mo>,</m:mo>
                      <m:mn>000</m:mn>
                    </m:mrow>
                  </m:math>

                </item>
              </list>

            </solution>
          </exercise></note>
      </section>
    </section>

  </content>
</document>