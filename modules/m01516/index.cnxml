<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.15.1: Writing Equivalent Expressions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01516</md:content-id>
    <md:title>5.15.1: Writing Equivalent Expressions</md:title>
