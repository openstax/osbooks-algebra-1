  </metadata>
  <content>
  <section id="sect-00001"><title> Warm Up Activity</title>
<para id="para-00001">For each given expression, write an equivalent expression with as few terms as possible. Double click on mathematical expressions/equations to enlarge. If needed, use the “^” symbol to enter an exponent.</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002">\(
        7p−3+2(p+1)\)</para>
    </problem>
    <solution id="sol-00001">
  <para id="para-00003">Compare your answer:</para>
    
    <para id="para-00004">\(9p−1\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00005">\(\lbrack 4(n+1)+10 \rbrack−4(n+1)\)</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00006">Compare your answer:</para>
    
    <para id="para-00007">\(
      10\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00008">\(9^5 \cdot 9^2 \cdot 9^x\)</para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00009">Compare your answer:</para>
    
    <para id="para-00010">\(9^{7+x}
      \)
  </para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00011">\(\frac{
        2^{4n}}{2^n}\)</para>
    </problem><solution id="sol-00004">
    
    
  
  <para id="para-00012">Compare your answer:</para>
    
    <para id="para-00013">\(2^{3n}\) 
  </para>
  
  </solution></exercise>
<!--Interaction End -->
</section>
