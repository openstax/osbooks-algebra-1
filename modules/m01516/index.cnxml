<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.15.1: Writing Equivalent Expressions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01516</md:content-id>
    <md:title>5.15.1: Writing Equivalent Expressions</md:title>
    <md:uuid>40e2e5e5-6e09-487d-a0a0-8ff145031a7b</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title> Warm Up Activity</title>
<para id="para-00001">For each given expression, write an equivalent expression with as few terms as possible. Double click on mathematical expressions/equations to enlarge. If needed, use the “^” symbol to enter an exponent.</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002"><m:math><m:mrow><m:mn>7</m:mn><m:mi>p</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mi>p</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
    </problem>
    <solution id="sol-00001">
  <para id="para-00003">Compare your answer:</para>
    
    <para id="para-00004"><m:math><m:mrow><m:mn>9</m:mn><m:mi>p</m:mi><m:mi>−</m:mi><m:mn>1</m:mn></m:mrow></m:math></para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00005"><m:math><m:mrow><m:mi>[</m:mi><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>10</m:mn><m:mi>]</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00006">Compare your answer:</para>
    
    <para id="para-00007"><m:math><m:mrow><m:mn>10</m:mn></m:mrow></m:math></para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00008"><m:math><m:mrow><m:msup><m:mn>9</m:mn><m:mn>5</m:mn></m:msup><m:mi>·</m:mi><m:msup><m:mn>9</m:mn><m:mn>2</m:mn></m:msup><m:mi>·</m:mi><m:msup><m:mn>9</m:mn><m:mi>x</m:mi></m:msup></m:mrow></m:math></para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00009">Compare your answer:</para>
    
    <para id="para-00010"><m:math display="inline"><m:mrow><m:msup><m:mn>9</m:mn><m:mrow><m:mn>7</m:mn><m:mo>+</m:mo><m:mi>x</m:mi></m:mrow></m:msup></m:mrow></m:math>
  </para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00011"><m:math><m:mrow><m:mfrac><m:mrow><m:msup><m:mn>2</m:mn><m:mrow><m:mn>4</m:mn><m:mi>n</m:mi></m:mrow></m:msup></m:mrow><m:mrow><m:msup><m:mn>2</m:mn><m:mi>n</m:mi></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para>
    </problem><solution id="sol-00004">
    
    
  
  <para id="para-00012">Compare your answer:</para>
    
    <para id="para-00013"><m:math display="inline"><m:mrow><m:msup><m:mn>2</m:mn><m:mrow><m:mn>3</m:mn><m:mi>n</m:mi></m:mrow></m:msup></m:mrow></m:math> 
  </para>
  
  </solution></exercise>
<!--Interaction End -->
</section>
</content>
</document>
