  <section id="sect-00001"><title>Warm Up Activity </title>
<!--Text Entry Interaction Start -->
<exercise>
  <problem id="prob-00001">
    <para id="para-00001">Write some solutions to the inequality \( y ≤ 9.2 \). Be prepared to explain what makes a value a solution to this inequality.</para>
    </problem><solution id="sol-00001">
    
    <para id="para-00002">Enter your answer here:</para>
  
