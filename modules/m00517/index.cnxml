  <content>
    <section>
      <title>Warm Up Activity </title>
      <!--Text
      Entry Interaction Start -->
      <exercise>
        <problem>
          <para>Write some solutions to the inequality \( y ≤ 9.2 \). Be prepared to explain what
            makes a value a solution to this inequality.</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>

          <para>Your answer may vary, but here are some samples.</para>

          <para>\(9.2\), \(8\), \(4.5\), \(-7\)</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!--Text
      Entry Interaction Start -->
      <exercise>
        <problem>
          <para>Write one solution to the inequality \(7(3 − x) > 14\). Be prepared to explain your
            reasoning.</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>

          <para>Your answer may vary, but here are some samples.</para>

          <para>\(0.5\), \(0\), \(-1\), \(-6\)</para>


        </solution>
      </exercise>
      <!--Interaction
      End -->
    </section>
