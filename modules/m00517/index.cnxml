<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Writing Solutions to Inequalities</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00517</md:content-id>
    <md:title>Writing Solutions to Inequalities</md:title>
    <md:uuid>41dc5bf8-bb6b-4401-898d-3b7a952392f3</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00001">Write some solutions to the inequality <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>9.2</m:mn></m:mrow></m:math>. Be prepared to explain what
            makes a value a solution to this inequality.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00002">Compare your answer: </para>

          <para id="para-00003">Your answer may vary, but here are some samples.</para>

          <para id="para-00004"><m:math display="inline"><m:mrow><m:mn>9.2</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mn>8</m:mn></m:mrow></m:math></para><para id="para-00008"><m:math display="inline"><m:mrow><m:mn>4.5</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mo>–</m:mo><m:mn>7</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->

      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00005">Write one solution to the inequality <m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>–</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>&gt;</m:mo><m:mn>14</m:mn></m:mrow></m:math>. Be prepared to explain your
            reasoning.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00006">Compare your answer: </para>

          <para id="para-00007">Your answer may vary, but here are some samples.</para>

          <para id="para-00009"><m:math display="inline"><m:mrow><m:mn>0.5</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mn>0</m:mn></m:mrow></m:math></para><para id="para-00010"><m:math display="inline"><m:mrow><m:mo>–</m:mo><m:mn>1</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mo>–</m:mo><m:mn>6</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
    </section>
  </content>
