<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.7.4: Writing Consistent and Inconsistent Systems of Equations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00484</md:content-id>
    <md:title>2.7.4: Writing Consistent and Inconsistent Systems of Equations</md:title>
    <md:uuid>10fbe297-7ece-4081-9cae-59db68ef6370</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
      <para id="para-00001">Here is an equation: <m:math display="inline"><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math>.</para>
      <para id="para-00002">Create a second equation that would make a system of equations with:</para>

      <!--Q#1-->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00003">One solution</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00004">Compare your answer: </para>

          <para id="para-00005">Your answer may vary, but here are some samples.</para>

          <para id="para-00006"><m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para><para id="para-00010"><m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->


      <!--Q#2-->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00007">No solutions</para>
        </problem>
        <solution id="sol-00002">


          <para id="para-00008">Compare your answer: </para>

          <para id="para-00009">Your answer may vary, but here are some samples.</para>

          <para id="para-00014"><m:math display="inline"><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>20</m:mn></m:mrow></m:math></para><para id="para-00015"><m:math display="inline"><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->


      <!--Q#3-->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00011">Infinitely many solutions</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00012">Compare your answer: </para>

          <para id="para-00013">Your answer may vary, but here are some samples.</para>

          <para id="para-00016"><m:math display="inline"><m:mrow><m:mn>15</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>30</m:mn></m:mrow></m:math></para><para id="para-00017"><m:math display="inline"><m:mrow><m:mn>150</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>20</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>100</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
    </section>
  </content>
