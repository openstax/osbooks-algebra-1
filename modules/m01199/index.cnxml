  <content>
  <section id="sect-00001"><title>Cool Down Activity</title>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00001">
        A sequence is defined by \(f_1=-3\), \(f_n=f_{n-1}+0.5\) for \(n\geq2\). Diego writes an equation for the nth term of the sequence as \(a_n=-3+(n-1)(0.5)\). Is he correct? Explain how you know.
    </para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00002">Compare your answer:</para>
    
    <para id="para-00003">Yes. For example: Both definitions create a sequence that starts at –3 and increases by 0.5 each term.</para>
  
  </solution></exercise>
<!--Interaction End -->



<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002"><list class="os-raise-noindent" list-type="enumerated" id="list-00001">
  <item>
    How would you describe the representation \(f_1=-3\), \(f_n=f_{n-1}+0.5\) for \(n\geq2\) for Diego’s sequence?
 </item>
</list>
  </problem><solution id="sol-00002">
    
    
  
  <para id="para-00004">Compare your answer:</para>
    
    <para id="para-00005">It is the recursive definition of the sequence.</para>
  
  </solution></exercise>
<!--Interaction End -->



<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003"><list class="os-raise-noindent" list-type="enumerated" id="list-00002">
  <item>
    How would you describe the representation of Diego’s sequence, \(a_n=-3+(n-1)(0.5)\)?
 </item>
</list>
  </problem><solution id="sol-00003">
    
    
  
  <para id="para-00006">Compare your answer:</para>
    
    <para id="para-00007">This is the nth term of the sequence.</para>
  
  </solution></exercise>
<!--Interaction End -->
</section>
