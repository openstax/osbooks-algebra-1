  <content>
  <section><title>Cool Down Activity</title>

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>
        A sequence is defined by \(f_1=-3\), \(f_n=f_{n-1}+0.5\) for \(n\geq2\). Diego writes an equation for the nth term of the sequence as \(a_n=-3+(n-1)(0.5)\). Is he correct? Explain how you know.
    </para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>Yes. For example: Both definitions create a sequence that starts at –3 and increases by 0.5 each term.</para>
  
  </solution></exercise>
<!--Interaction End -->

<list class="os-raise-noindent" list-type="enumerated">
  <item>
    How would you describe the representation \(f_1=-3\), \(f_n=f_{n-1}+0.5\) for \(n\geq2\) for Diego’s sequence?
 </item>
</list>

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
  </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>It is the recursive definition of the sequence.</para>
  
  </solution></exercise>
<!--Interaction End -->

