  <content>
  <section class="practice" id="sect-00001"><title>Cool Down Activity</title>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00001">
        A sequence is defined by <m:math display="inline"><m:mrow><m:msub><m:mi>f</m:mi><m:mn>1</m:mn></m:msub><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:msub><m:mi>f</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:msub><m:mi>f</m:mi><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msub><m:mo>+</m:mo><m:mn>0.5</m:mn></m:mrow></m:math> for <m:math display="inline"><m:mrow><m:mi>n</m:mi><m:mo>≥</m:mo><m:mn>2</m:mn></m:mrow></m:math>. Diego writes an equation for the nth term of the sequence as <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>0.5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>. Is he correct? Explain how you know.
    </para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00002">Compare your answer:</para>
    
    <para id="para-00003">Yes. For example: Both definitions create a sequence that starts at –3 and increases by 0.5 each term.</para>
  
  </solution></exercise>
<!--Interaction End -->



<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002"><list class="os-raise-noindent" list-type="enumerated" id="list-00001">
  <item>
    How would you describe the representation <m:math display="inline"><m:mrow><m:msub><m:mi>f</m:mi><m:mn>1</m:mn></m:msub><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:msub><m:mi>f</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:msub><m:mi>f</m:mi><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msub><m:mo>+</m:mo><m:mn>0.5</m:mn></m:mrow></m:math> for <m:math display="inline"><m:mrow><m:mi>n</m:mi><m:mo>≥</m:mo><m:mn>2</m:mn></m:mrow></m:math> for Diego’s sequence?
 </item>
</list>
  </problem><solution id="sol-00002">
    
    
  
  <para id="para-00004">Compare your answer:</para>
    
    <para id="para-00005">It is the recursive definition of the sequence.</para>
  
  </solution></exercise>
<!--Interaction End -->



<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003"><list class="os-raise-noindent" list-type="enumerated" id="list-00002">
  <item>
    How would you describe the representation of Diego’s sequence, <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>0.5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>?
 </item>
</list>
  </problem><solution id="sol-00003">
    
    
  
  <para id="para-00006">Compare your answer:</para>
    
    <para id="para-00007">This is the nth term of the sequence.</para>
  
  </solution></exercise>
<!--Interaction End -->
</section>
