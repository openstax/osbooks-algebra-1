<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.10.5: Solving Quadratic Equations by Any Method</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02260</md:content-id>
    <md:title>8.10.5: Solving Quadratic Equations by Any Method</md:title>
    <md:uuid>58986a92-3a33-4c26-be1c-91e6bd6138b6</md:uuid>
