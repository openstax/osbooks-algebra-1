<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.3.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00889</md:content-id>
    <md:title>4.3.5: Practice</md:title>
    <md:uuid>37d9d69b-b331-4d77-810f-4b34f6976c08</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <!--Do not edit this div tag.  It must surround the interaction block-->
      <section id="sect-00002">
        <exercise id="c4f6daa0-50bc-428c-8cf5-7a097e999cc1" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00002">1. Function <m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math> gives the temperature, in degrees Celsius, <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> hours after midnight.</para>
            <para id="para-00003">Choose which equation or expression represents the statement in function notation.</para>
            <para id="para-00004">The temperature was the same at 9 a.m. and at 4 p.m.</para>
            <para id="para-00005">Multiple Choice:</para>
            <para id="para-00006"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00007"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>16</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00008">Correct! <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>16</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00009">Try again. Revisit activity 4.3.3.</para>
            <para id="para-00010">The correct answer is <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>16</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="b4bd3db2-dbdc-421d-b42e-bb285b895f47" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00011">It was warmer at 9 a.m. than at 6 a.m.</para>
            <para id="para-00012">Multiple Choice:</para>
            <para id="para-00013"><m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> &gt; <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00014"><m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>&lt;<m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00015">Correct! <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>&gt;</m:mo><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00016">Try again. Revisit activity 4.3.3.</para>
            <para id="para-00017">The correct answer is <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>&gt;</m:mo><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_98400bad-9f27-4e0d-8430-f67c0ae26c26" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00018">Some time after midnight, the temperature was 24 degrees Celsius.</para>
            <para id="para-00019">Multiple Choice:</para>
            <para id="para-00020"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>24</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>t</m:mi></m:mrow></m:math></para>
            <para id="para-00021"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>&lt;</m:mo><m:mn>24</m:mn></m:mrow></m:math></para>
            <para id="para-00022"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>24</m:mn></m:mrow></m:math></para>
            <para id="para-00023"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>24</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00024">Correct! <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>24</m:mn></m:mrow></m:math></para>
            <para id="para-00025">Try again. Revisit activity 4.3.3.</para>
            <para id="para-00026">The correct answer is <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>24</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_2b429285-9e48-4744-8816-9fc39d073d9a" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00027">Select the <emphasis>two</emphasis> points that are on the graph of <m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math> if we know that <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>3.4</m:mn></m:mrow></m:math>.</para>
          </problem>
          <solution id="sol-00004">
            
            <para id="para-00028">Try again. Revisit activity 4.3.3.</para>
            <para id="para-00029">The correct answers are <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>3.4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_8a768d37-c781-46a7-b425-c2bc929041e4" class="multiple-choice">
          <problem id="prob-00005">

            <para id="para-00030">Looking at the graph of the function <m:math display="inline"><m:mrow><m:mi>g</m:mi></m:mrow></m:math>, below, which is greater, <m:math display="inline"><m:mrow><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>?</para>
            <para id="para-00031">Multiple Choice:</para>
            <para id="para-00032"><m:math><m:mrow><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00033"><m:math><m:mrow><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00034">Correct! <m:math display="inline"><m:mrow><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00035">Try again. Revisit activity 4.3.1.</para>
            <para id="para-00036">The correct answer is <m:math display="inline"><m:mrow><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_1237bb5b-2130-4f17-8364-9a5468a6d902" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00037">The function <m:math display="inline"><m:mrow><m:mi>T</m:mi></m:mrow></m:math> tells how many people are living on floor <m:math display="inline"><m:mrow><m:mi>n</m:mi></m:mrow></m:math> of an apartment building. What does <m:math display="inline"><m:mrow><m:mi>T</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>82</m:mn></m:mrow></m:math> mean?</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00038">Correct! There are 82 people living on floor 4.</para>
            <para id="para-00039">Try again. Revisit activities 4.2.1-4.2.2.</para>
            <para id="para-00040">The correct answer is: There are 82 people living on floor 4.
    </para>
          </solution>
        </exercise>
        <exercise id="_2dc2c733-5dfb-4762-81ad-c238a622c7b0" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00041">The function, <m:math display="inline"><m:mrow><m:mi>T</m:mi></m:mrow></m:math>, gives the temperature of a house, in degrees Fahrenheit, <m:math display="inline"><m:mrow><m:mi>h</m:mi></m:mrow></m:math> hours after midnight. Choose which function notation represents the temperature at 6 a.m. was 70 degrees.</para>
            <para id="para-00042">Multiple Choice:</para>
            <para id="para-00043"><m:math><m:mrow><m:mi>T</m:mi><m:mo stretchy="false">(</m:mo><m:mn>70</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
            <para id="para-00044"><m:math><m:mrow><m:mi>T</m:mi><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>70</m:mn></m:mrow></m:math></para>
            <para id="para-00045"><m:math><m:mrow><m:mn>6</m:mn><m:mo stretchy="false">(</m:mo><m:mi>T</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>70</m:mn></m:mrow></m:math></para>
            <para id="para-00046"><m:math><m:mrow><m:mn>70</m:mn><m:mo stretchy="false">(</m:mo><m:mi>T</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00047">Correct! <m:math display="inline"><m:mrow><m:mi>T</m:mi><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>70</m:mn></m:mrow></m:math></para>
            <para id="para-00048">Try again. Revisit activity 4.3.4.</para>
            <para id="para-00049">The correct answer is <m:math display="inline"><m:mrow><m:mi>T</m:mi><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>70</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="b1d1f02d-f133-416a-a9a6-4be309380f15" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00050">The graph below represents a function, <m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math>, which gives the height of a drone, in meters, <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> seconds after it leaves the ground. Which statement describes the point <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math>?</para>
                  <media alt="Graph. Horizontal axis, 0 to 8, time, seconds. Vertical axis, height, meters. Starting at 0 comma 0, the graph increases linearly. From 2 to 6, it’s horizontal. Then decreases linearly to 7 comma 0.">
                <image mime-type="image/svg+xml" src="../../media/Algebra-1_04_06_10_01.svg"/>
              </media>
            
          </problem>
          <solution id="sol-00008">
            <para id="para-00051">Correct! The height of the drone after 2 seconds is 4 meters off the ground.</para>
            <para id="para-00052">Try again. Revisit activity 4.3.3.</para>
            <para id="para-00053">The correct answer is: The height of the drone after 2 seconds is 4 meters off the ground.</para>
          </solution>
        </exercise>
      </section>
    </section>
  </content></document>
