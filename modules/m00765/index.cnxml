  <content>
  <section><para dir="ltr">Complete the following questions to practice the skills you have learned in this lesson.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="b6d841b9-8348-4b36-b9f4-39fbf5b9283d" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--Q1-->
  <exercise data-content-id="2aeff761-3d80-478a-9dda-33e3b35ba77f" data-problem-type="multiselect" data-solution="[&quot;1&quot;, &quot;0.5&quot;, &quot;0.8&quot;]" data-solution-options="[&quot;1&quot;, &quot;-1&quot;, &quot;0.5&quot;,&quot;-0.5&quot;, &quot;0&quot;, &quot;0.8&quot;, &quot;-0.8&quot;]">
    <problem>
      <para>Select <emphasis>three</emphasis> values for \(r\) that indicate a positive slope for the line of best fit.</para>
      </problem>
    <solution>
      <para>Correct! 1, 0.5, 0.8</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 3.4.2.</para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  
  <!--Q2-->
  <exercise data-content-id="c15c992a-d18b-44e3-8338-3fc5472a48a6" data-problem-type="multiselect" data-solution="[&quot;-1&quot;, &quot;-0.87&quot;, &quot;-0.24&quot;]" data-solution-options="[&quot;0&quot;, &quot;1&quot;, &quot;-1&quot;,&quot;-0.87&quot;, &quot;0.32&quot;, &quot;-0.24&quot;, &quot;0.24&quot;]">
    <problem>
      <para>Select <emphasis>three</emphasis> values for \(r\) that indicate a negative slope for the line of best fit.</para>
      </problem>
    <solution>
      <para>Correct! –1, –0.87, –0.24</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 3.4.2.</para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  
  <!--Q#3-->
  <exercise data-content-id="650178de-47e1-422c-ae0e-8df9073ec516" data-problem-type="multiplechoice" data-solution="\(-0.85, 0.72, 0.4, -0.31\)" data-solution-options="[&quot;\\(0.72, 0.4, -0.31, –0.85\\)&quot;, &quot;\\(–0.85, -0.31, 0.4, 0.72\\)&quot;, &quot;\\(-0.31, 0.4, 0.72, –0.85, 0.72\\)&quot;, &quot;\\(–0.85, 0.72, 0.4, -0.31\\)&quot;]">
    <problem>
      <para>The correlation coefficient, \(r\), is given for several different linear models. Order the correlation coefficients as follows: start with the \(r\)-value indicating the strongest linear relationship and end with the \(r\)-value indicating the weakest linear relationship.</para>
      <para>0.4, –0.85, 0.72, –0.31</para>
    </problem>
    <solution>
      <para>Correct! -0.85, 0.72, 0.4, -0.31 </para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 3.4.2.</para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  
  <!--Q#4-->
  <exercise data-content-id="08c73988-623d-42d1-bda5-b243c118c63b" data-problem-type="multiplechoice" data-solution="\(-1, 0.89, -0.65, 0.47\)" data-solution-options="[&quot;\\(–1, 0.89, –0.65, 0.47\\)&quot;, &quot;\\(0.47, -0.65, 0.89, -1\\)&quot;, &quot;\\(–1, –0.65, 0.47, 0.89 \\)&quot;, &quot;\\(0.89, 0.47, –1, –0.65, -1\\)&quot;]">
    <problem>
      <para>The correlation coefficient, \(r\), is given for several different linear models. Order the correlation coefficients as follows: start with the \(r\)-value indicating the strongest linear relationship and end with the \(r\)-value indicating the weakest linear relationship</para>
      <para> –0.65, 0.47, –1, 0.89</para>
    </problem>
    <solution>
      <para>Correct! –1, 0.89, –0.65, 0.47 </para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 3.4.2.</para>
    </div>
    </exercise>
  
  
  <!--Q5-->
  <exercise data-content-id="4bfb3f6f-a2a2-4a15-bf4d-96cb432567cd" data-problem-type="dropdown" data-retry-limit="3" data-solution="r=0.88" data-solution-options="[&quot;r=0.67&quot;, &quot;r=-0.33&quot;, &quot;r=0.88&quot;, &quot;r=-0.79&quot;]">
    <problem>
      <para>5. Match the following scatter plots to the correct correlation coefficient from the following:</para>
      <para dir="ltr">\(r=0.67\)</para>
      <para dir="ltr">\(r=-0.33\)</para>
      <para dir="ltr">\(r=0.88\)</para>
      <para dir="ltr">\(r= -0.79\)</para>
      <para><figure><media alt=""><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/5c3073c9737f0a0cf23f4ceb082a4905b7924dd6"/></media></figure></para>
      <para>Scatter Plot A</para>
    </problem>
    <solution>
      <para>Correct! \( r=0.88\) </para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 3.4.4 – 3.4.5.</para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  
