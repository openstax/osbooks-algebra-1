  <!--END QUESTION.-->
  <!--Q8-->
  <exercise data-content-id="e5ab9a38-a3da-4a5a-9ea2-ea0c48d44a0d" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="0.62" data-solution-options="[&quot;-0.62&quot;, &quot;0.94&quot;, &quot;-0.94&quot;, &quot;0.62&quot;]">
    <problem>
      <para>8. Which of the following correlation coefficients would best describe this scatter plot?</para>
      <para><figure><media alt="SCATTER PLOT THAT SHOWS THE RELATIONSHIP BETWEEN BODY MASS IN POUNDS AND BITE FORCE IN POUNDS. THE SCATTER PLOT SHOWS A STRONG POSITIVE CORRELATION."><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/9a74b1315b2ca91f0badced5dc3cc085f8b912e1"/></media></figure></para>
    </problem>
    <solution>
      <para>Correct! 0.62</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
