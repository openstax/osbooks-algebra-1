  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>

        <exercise id="_2aeff761-3d80-478a-9dda-33e3b35ba77f" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00002">Select <emphasis>three</emphasis> values for <m:math display="inline"><m:mrow><m:mi>r</m:mi></m:mrow></m:math> that indicate a positive slope
              for the line of best fit.</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00003">Correct! 1, 0.5, 0.8</para>
            <para id="para-00004">Try again. Revisit activity 3.4.2.</para>
            <para id="para-00005">The correct answers are 1, 0.5, 0.8.</para>
          </solution>
        </exercise>
        <exercise id="c15c992a-d18b-44e3-8338-3fc5472a48a6" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00006">Select <emphasis>three</emphasis> values for <m:math display="inline"><m:mrow><m:mi>r</m:mi></m:mrow></m:math> that indicate a negative slope
              for the line of best fit.</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00007">Correct! –1, –0.87, –0.24</para>
            <para id="para-00008">Try again. Revisit activity 3.4.2.</para>
            <para id="para-00009">The correct answers are –1, –0.87, –0.24.</para>
          </solution>
        </exercise>
        <exercise id="_650178de-47e1-422c-ae0e-8df9073ec516" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00010">0.4, –0.85, 0.72, –0.31</para>
            <para id="para-00011">The correlation coefficient, <m:math display="inline"><m:mrow><m:mi>r</m:mi></m:mrow></m:math>, is given for several different linear models.
              Order the correlation coefficients as follows: start with the <m:math display="inline"><m:mrow><m:mi>r</m:mi></m:mrow></m:math>-value indicating
              the strongest linear relationship and end with the <m:math display="inline"><m:mrow><m:mi>r</m:mi></m:mrow></m:math>-value indicating the weakest
              linear relationship.</para>
            <para id="para-00012">Multiple Choice:</para>
            <para id="para-00013"><m:math><m:mrow><m:mn>0.72</m:mn><m:mo>,</m:mo><m:mn>0.4</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>0.31</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>0.85</m:mn></m:mrow></m:math></para>
            <para id="para-00014"><m:math><m:mrow><m:mi>–</m:mi><m:mn>0.85</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>0.31</m:mn><m:mo>,</m:mo><m:mn>0.4</m:mn><m:mo>,</m:mo><m:mn>0.72</m:mn></m:mrow></m:math></para>
            <para id="para-00015"><m:math><m:mrow><m:mo>−</m:mo><m:mn>0.31</m:mn><m:mo>,</m:mo><m:mn>0.4</m:mn><m:mo>,</m:mo><m:mn>0.72</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>0.85</m:mn><m:mo>,</m:mo><m:mn>0.72</m:mn></m:mrow></m:math></para>
            <para id="para-00016"><m:math><m:mrow><m:mi>–</m:mi><m:mn>0.85</m:mn><m:mo>,</m:mo><m:mn>0.72</m:mn><m:mo>,</m:mo><m:mn>0.4</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>0.31</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00017">Correct! -0.85, 0.72, 0.4, -0.31 Correct! -0.85, 0.72, 0.4, -0.31</para>
            <para id="para-00018">Try again. Revisit activity 3.4.2.</para>
            <para id="para-00019">The correct answer is -0.85, 0.72, 0.4, -0.31.</para>
          </solution>
        </exercise>
        <exercise id="_08c73988-623d-42d1-bda5-b243c118c63b" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00020">–0.65, 0.47, –1, 0.89</para>
            <para id="para-00021">The correlation coefficient, <m:math display="inline"><m:mrow><m:mi>r</m:mi></m:mrow></m:math>, is given for several different linear models.
              Order the correlation coefficients as follows: start with the <m:math display="inline"><m:mrow><m:mi>r</m:mi></m:mrow></m:math>-value indicating
              the strongest linear relationship and end with the <m:math display="inline"><m:mrow><m:mi>r</m:mi></m:mrow></m:math>-value indicating the weakest
              linear relationship</para>
            <para id="para-00022">Multiple Choice:</para>
            <para id="para-00023"><m:math><m:mrow><m:mi>–</m:mi><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>0.89</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>0.65</m:mn><m:mo>,</m:mo><m:mn>0.47</m:mn></m:mrow></m:math></para>
            <para id="para-00024"><m:math><m:mrow><m:mn>0.47</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>0.65</m:mn><m:mo>,</m:mo><m:mn>0.89</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
            <para id="para-00025"><m:math><m:mrow><m:mi>–</m:mi><m:mn>1</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>0.65</m:mn><m:mo>,</m:mo><m:mn>0.47</m:mn><m:mo>,</m:mo><m:mn>0.89</m:mn></m:mrow></m:math></para>
            <para id="para-00026"><m:math><m:mrow><m:mn>0.89</m:mn><m:mo>,</m:mo><m:mn>0.47</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>1</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>0.65</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00027">Correct! –1, 0.89, –0.65, 0.47 Correct! –1, 0.89, –0.65, 0.47</para>
            <para id="para-00028">Try again. Revisit activity 3.4.2.</para>
            <para id="para-00029">The correct answer is –1, 0.89, –0.65, 0.47.</para>
          </solution>
        </exercise>
        <exercise id="_4bfb3f6f-a2a2-4a15-bf4d-96cb432567cd" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00030">5. Match the following scatter plots to the correct correlation coefficient from
              the following:</para>
            <para id="para-00031"><m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>0.67</m:mn></m:mrow></m:math></para>
            <para id="para-00032"><m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.33</m:mn></m:mrow></m:math></para>
            <para id="para-00033"><m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>0.88</m:mn></m:mrow></m:math></para>
            <para id="para-00034"><m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.79</m:mn></m:mrow></m:math></para>
            <para id="para-00035">
              <media alt="">
                <image mime-type="image/jpeg" src="../../media/Algebra-1_03_06_13_01.jpg"/>
              </media>

            </para>
            <para id="para-00036">Scatter Plot A</para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00037">Correct! <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>0.88</m:mn></m:mrow></m:math></para>
            <para id="para-00038">Try again. Revisit activities 3.4.4 – 3.4.5.</para>
            <para id="para-00039">The correct answer is <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>0.88</m:mn></m:mrow></m:math>. </para>
          </solution>
        </exercise>
        <exercise id="_38c1f1c2-30c8-4993-b195-0abf7718e8af" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00040">Scatter Plot B</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00041">Correct! <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.79</m:mn></m:mrow></m:math></para>
            <para id="para-00042">Try again. Revisit activities 3.4.4 – 3.4.5.</para>
            <para id="para-00043">The correct answer is <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.79</m:mn></m:mrow></m:math>. </para>
          </solution>
        </exercise>
        <exercise id="_1c8527d3-b1d6-4715-b044-0c29659d0e23" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00044">Scatter Plot C</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00045">Correct! <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.33</m:mn></m:mrow></m:math></para>
            <para id="para-00046">Try again. Revisit activities 3.4.4 – 3.4.5.</para>
            <para id="para-00047">The correct answer is <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.33</m:mn></m:mrow></m:math>. </para>
          </solution>
        </exercise>
        <exercise id="_8227ba2a-6275-45ef-a11a-4615f2355b91" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00048">Scatter Plot D</para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00049">Correct! <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>0.67</m:mn></m:mrow></m:math></para>
            <para id="para-00050">Try again. Revisit activities 3.4.4 – 3.4.5.</para>
            <para id="para-00051">The correct answer is <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>0.67</m:mn></m:mrow></m:math>. </para>
          </solution>
        </exercise>
        <exercise id="_0e4d4f01-4909-40fc-a549-977860084877" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00052">6. Match the following scatter plots to the correct correlation coefficient from
              the following:</para>
            <para id="para-00053"><m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>0.37</m:mn></m:mrow></m:math></para>
            <para id="para-00054"><m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>0.83</m:mn></m:mrow></m:math></para>
            <para id="para-00055"><m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.67</m:mn></m:mrow></m:math></para>
            <para id="para-00056"><m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.85</m:mn></m:mrow></m:math></para>
            <para id="para-00057">
              <media alt="">
                <image mime-type="image/jpeg" src="../../media/Algebra-1_03_06_13_02.jpg"/>
              </media>

            </para>
            <para id="para-00058">Scatter Plot A</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00059">Correct! <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.67</m:mn></m:mrow></m:math></para>
            <para id="para-00060">Try again. Revisit activities 3.4.4 – 3.4.5.</para>
            <para id="para-00061">The correct answer is <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.67</m:mn></m:mrow></m:math>. </para>
          </solution>
        </exercise>
        <exercise id="_6a8ac0a2-22f6-451f-99c3-8ddd2944851c" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00062">Scatter Plot B</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00063">Correct! <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>0.83</m:mn></m:mrow></m:math></para>
            <para id="para-00064">Try again. Revisit activities 3.4.4 – 3.4.5.</para>
            <para id="para-00065">The correct answer is <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>0.83</m:mn></m:mrow></m:math>. </para>
          </solution>
        </exercise>
        <exercise id="b3adcc1c-131b-421e-998d-86bd214426c5" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00066">Scatter Plot C</para>
          </problem>
          <solution id="sol-00011">
            <para id="para-00067">Correct! <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>0.37</m:mn></m:mrow></m:math></para>
            <para id="para-00068">Try again. Revisit activities 3.4.4 – 3.4.5.</para>
            <para id="para-00069">The correct answer is <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>0.37</m:mn></m:mrow></m:math>. </para>
          </solution>
        </exercise>
        <exercise id="_52a5ff65-f2e3-4bec-ba9a-822600f8b2fd" class="multiple-choice">
          <problem id="prob-00012">
            <para id="para-00070">Scatter Plot D</para>
          </problem>
          <solution id="sol-00012">
            <para id="para-00071">Correct! <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.85</m:mn></m:mrow></m:math></para>
            <para id="para-00072">Try again. Revisit activities 3.4.4 – 3.4.5.</para>
            <para id="para-00073">The correct answer is <m:math display="inline"><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.85</m:mn></m:mrow></m:math>. </para>
          </solution>
        </exercise>
        <exercise id="_0c572bab-4c76-49cd-b643-d03e1d90bfd4" class="multiple-choice">
          <problem id="prob-00013">
            <para id="para-00074">7. Which of the following correlation coefficients would best describe this
              scatter plot?</para>
            <para id="para-00075">
              <media alt="SCATTER PLOT THAT SHOWS THE RELATIONSHIP BETWEEN AGE IN YEARS AND PRICE IN DOLLARS. THE SCATTER PLOT SHOWS A VERY STRONG NEGATIVE CORRELATION.">
                <image mime-type="image/jpeg" src="../../media/Algebra-1_03_06_13_03.jpg"/>
              </media>

            </para>
            <para id="para-00076">Multiple Choice:</para>
            <para id="para-00077">-0.32</para>
            <para id="para-00078">0.87</para>
            <para id="para-00079">-0.87</para>
            <para id="para-00080">0.32</para>
          </problem>
          <solution id="sol-00013">
            <para id="para-00081">Correct! <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>0.87</m:mn></m:mrow></m:math></para>
            <para id="para-00082">Try again. Revisit activities 3.4.2 – 3.4.5. </para>
            <para id="para-00083">The correct answer is <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>0.87</m:mn></m:mrow></m:math>. </para>
          </solution>
        </exercise>
        <exercise id="e5ab9a38-a3da-4a5a-9ea2-ea0c48d44a0d" class="multiple-choice">
          <problem id="prob-00014">
            <para id="para-00084">8. Which of the following correlation coefficients would best describe this
              scatter plot?</para>
            <para id="para-00085">
              <media alt="SCATTER PLOT THAT SHOWS THE RELATIONSHIP BETWEEN BODY MASS IN POUNDS AND BITE FORCE IN POUNDS. THE SCATTER PLOT SHOWS A STRONG POSITIVE CORRELATION.">
                <image mime-type="image/jpeg" src="../../media/Algebra-1_03_06_13_04.jpg"/>
              </media>

            </para>
            <para id="para-00086">Multiple Choice:</para>
            <para id="para-00087">-0.62</para>
            <para id="para-00088">0.94</para>
            <para id="para-00089">-0.94</para>
            <para id="para-00090">0.62</para>
          </problem>
          <solution id="sol-00014">
            <para id="para-00091">Correct! 0.62</para>
            <para id="para-00092">Try again. Revisit activities 3.4.2 – 3.4.5. </para>
            <para id="para-00093">The correct answer is 0.62. </para>
          </solution>
        </exercise>
        <exercise id="f1067638-02fd-4a21-a383-8692cafdae54" class="multiple-choice">
          <problem id="prob-00015">
            <para id="para-00094">9. Which of the following has the stronger linear relationship? Explain.</para>
            <para id="para-00095">Scatter Plot A:</para>
            <para id="para-00096">
              <media alt="SCATTER PLOT THAT SHOWS A MODERATE POSITIVE CORRELATION.">
                <image mime-type="image/jpeg" src="../../media/Algebra-1_03_06_13_05.jpg"/>
              </media>

            </para>
            <para id="para-00097">Scatter Plot B:</para>
            <para id="para-00098">
              <media alt="SCATTER PLOT THAT SHOWS A STRONG POSITIVE CORRELATION.">
                <image mime-type="image/jpeg" src="../../media/Algebra-1_03_06_13_06.jpg"/>
              </media>

            </para>
          </problem>
          <solution id="sol-00015">
            <para id="para-00099">Correct! Scatter plot B because the points in the scatter plot are closer to
              forming a linear relationship.</para>
            <para id="para-00100">Try again. Revisit activity 3.4.2. </para>
            <para id="para-00101">The correct answer is scatter plot B because the points in the scatter plot are
              closer to forming a linear relationship. </para>
          </solution>
        </exercise>
        <exercise id="a9404ec6-8710-4e20-9345-d00023ddc075" class="multiple-choice">
          <problem id="prob-00016">
            <para id="para-00102">10. Which of the following correlation coefficients would best describe the
              scatter plot?</para>
            <para id="para-00103">
              <media alt="SCATTER PLOT THAT SHOWS THE RELATIONSHIP BETWEEN FAT IN GRAMS AND CALORIES. THE SCATTER PLOT SHOWS A MODERATE POSITIVE CORRELATION.">
                <image mime-type="image/jpeg" src="../../media/Algebra-1_03_06_13_07.jpg"/>
              </media>

            </para>
            <para id="para-00104">Multiple Choice:</para>
            <para id="para-00105">-0.89</para>
            <para id="para-00106">0.89</para>
            <para id="para-00107">0.43</para>
            <para id="para-00108">-0.43</para>
          </problem>
          <solution id="sol-00016">
            <para id="para-00109">Correct! 0.43</para>
            <para id="para-00110">Try again. Revisit activities 3.4.4 – 3.4.5.</para>
            <para id="para-00111">The correct answer is 0.43.</para>
          </solution>
        </exercise>
    </section>
