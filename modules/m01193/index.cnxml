                  <entry> </entry>
                </row>
                <row>
                  <entry>2021</entry>
                  <entry>6</entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry>2022</entry>
                  <entry>7</entry>
                  <entry> </entry>
                </row>
              </tbody></tgroup></table>
            <para id="para-00008">When you have completed the table, then select the <emphasis>solution</emphasis> button to compare your work.</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00009">Compare your answer:</para>
            <table class="os-raise-wideequaltable" id="table-00002">
              <tgroup cols="3"><tbody><row>
                  <entry>
