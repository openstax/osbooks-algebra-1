                </row>
                <row>
                  <entry>2016</entry>
                  <entry>1</entry>
                  <entry>\(W_n = 284(1.04)^1 = 295\)</entry>
                </row>
                <row>
                  <entry>2017</entry>
                  <entry>2</entry>
                  <entry>\(W_n = 284(1.04)^2 = \)</entry>
                </row>
                <row>
                  <entry>2018</entry>
                  <entry>3</entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry>2019</entry>
                  <entry>4</entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry>2020</entry>
