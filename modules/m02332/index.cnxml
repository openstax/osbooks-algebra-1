<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.1.1: Equations with Quadratic Expressions on Both Sides of the Equal Sign</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02332</md:content-id>
    <md:title>9.1.1: Equations with Quadratic Expressions on Both Sides of the Equal Sign</md:title>
    <md:uuid>65dba652-85a6-49e5-86e1-dc1b2778e9e2</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <title>Warm Up Activity</title>
      <para id="para-00001">In each equation, what expression could be substituted for \(a\) so the equation is true for all values of \(x\)?</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002">\(x^2=a^2\)</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Enter the expression that could be substituted for \(a\).</para>
          <para id="para-00004">Compare your answer:</para>
          <para id="para-00005">The correct answer is \(a=x\).</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00006">\((3x)^2=a^2\)</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00007">Enter the expression that could be substituted for \(a\).</para>
          <para id="para-00008">Compare your answer:</para>
          <para id="para-00009">The correct answer is \(a=3x\).</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010">\(a^2=7x\cdot7x\)</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00011">Enter the expression that could be substituted for \(a\).</para>
          <para id="para-00012">Compare your answer:</para>
          <para id="para-00013">The correct answer is \(a=7x\).</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00014">\(25x^2=a^2\)</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00015">Enter the expression that could be substituted for \(a\).</para>
          <para id="para-00016">Compare your answer:</para>
          <para id="para-00017">The correct answer is \(a=5x\).</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00005">
        <problem id="prob-00005">
          <para id="para-00018">\(a^2= \frac {1}{4}x^2\)</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00019">Enter the expression that could be substituted for \(a\).</para>
          <para id="para-00020">Compare your answer:</para>
          <para id="para-00021">The correct answer is \(a=\frac {1}{2}x\).</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00006">
        <problem id="prob-00006">
          <para id="para-00022">\(a^2=(x+1)^2\)</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00023">Enter the expression that could be substituted for \(a\).</para>
          <para id="para-00024">Compare your answer:</para>
          <para id="para-00025">The correct answer is \(a=x+1\).</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00007">
        <problem id="prob-00007">
          <para id="para-00026">\((2x−9)(2x−9)=a^2\)</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00027">Enter the expression that could be substituted for \(a\).</para>
          <para id="para-00028">Compare your answer:</para>
          <para id="para-00029">The correct answer is \(a=2x-9\).</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>