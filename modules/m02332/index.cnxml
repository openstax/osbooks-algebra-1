<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.1.1: Equations with Quadratic Expressions on Both Sides of the Equal Sign</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02332</md:content-id>
    <md:title>9.1.1: Equations with Quadratic Expressions on Both Sides of the Equal Sign</md:title>
    <md:uuid>46643b34-70f2-4cdb-9298-ede3ffb6e712</md:uuid>
  </metadata>
  <content>
  <section><title>Warm Up Activity</title>
<para>In each equation, what expression could be substituted for \(a\) so the equation is true for all values of \(x\)?</para>
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(x^2=a^2\)</para>
    </problem><solution>
    
    <para>Enter the expression that could be substituted for \(a\). </para>
  <para>Compare your answer:</para>
    <para>The correct answer is \(a=x\).</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\((3x)^2=a^2\)</para>
    </problem><solution>
    
    <para>Enter the expression that could be substituted for \(a\). </para>
  <para>Compare your answer:</para>
    <para>The correct answer is \(a=3x\).</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(a^2=7x\cdot7x\)</para>
    </problem><solution>
    
    <para>Enter the expression that could be substituted for \(a\). </para>
  <para>Compare your answer:</para>
    <para>The correct answer is \(a=7x\).</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(25x^2=a^2\)</para>
    </problem><solution>
    
    <para>Enter the expression that could be substituted for \(a\). </para>
  <para>Compare your answer:</para>
    <para>The correct answer is \(a=5x\).</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(a^2= \frac {1}{4}x^2\)</para>
    </problem><solution>
    
    <para>Enter the expression that could be substituted for \(a\). </para>
  <para>Compare your answer:</para>
    <para>The correct answer is \(a=\frac {1}{2}x\).</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(a^2=(x+1)^2\)</para>
    </problem><solution>
    
    <para>Enter the expression that could be substituted for \(a\). </para>
  <para>Compare your answer:</para>
    <para>The correct answer is \(a=x+1\).</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\((2x−9)(2x−9)=a^2\)</para>
    </problem><solution>
    
    <para>Enter the expression that could be substituted for \(a\). </para>
  <para>Compare your answer:</para>
    <para>The correct answer is \(a=2x-9\).</para>
  </solution></exercise>
<!--Interaction End --></section>
</content>
</document>
