<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.1.1: Equations with Quadratic Expressions on Both Sides of the Equal Sign</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02332</md:content-id>
    <md:title>9.1.1: Equations with Quadratic Expressions on Both Sides of the Equal Sign</md:title>
    <md:uuid>65dba652-85a6-49e5-86e1-dc1b2778e9e2</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <title>Warm Up</title>
      <para id="para-00001">In each equation, what expression could be substituted for <m:math display="inline">
          <m:mrow>
            <m:mi>a</m:mi>
          </m:mrow>
        </m:math> so the equation is true for all values of <m:math display="inline">
          <m:mrow>
            <m:mi>x</m:mi>
          </m:mrow>
        </m:math>?</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002"><m:math>
              <m:mrow>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>=</m:mo>
                <m:msup>
                  <m:mi>a</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Enter the expression that could be substituted for <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00004">Compare your answer: </para>
          <para id="para-00005">The correct answer is <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
                <m:mo>=</m:mo>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00006"><m:math>
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>3</m:mn>
                <m:mi>x</m:mi>
                <m:msup>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>=</m:mo>
                <m:msup>
                  <m:mi>a</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00007">Enter the expression that could be substituted for <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00008">Compare your answer: </para>
          <para id="para-00009">The correct answer is <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
                <m:mo>=</m:mo>
                <m:mn>3</m:mn>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010"><m:math>
              <m:mrow>
                <m:msup>
                  <m:mi>a</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>=</m:mo>
                <m:mn>7</m:mn>
                <m:mi>x</m:mi>
                <m:mi>·</m:mi>
                <m:mn>7</m:mn>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00011">Enter the expression that could be substituted for <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00012">Compare your answer: </para>
          <para id="para-00013">The correct answer is <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
                <m:mo>=</m:mo>
                <m:mn>7</m:mn>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00014"><m:math>
              <m:mrow>
                <m:mn>25</m:mn>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>=</m:mo>
                <m:msup>
                  <m:mi>a</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00015">Enter the expression that could be substituted for <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00016">Compare your answer: </para>
          <para id="para-00017">The correct answer is <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
                <m:mo>=</m:mo>
                <m:mn>5</m:mn>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00005">
        <problem id="prob-00005">
          <para id="para-00018"><m:math>
              <m:mrow>
                <m:msup>
                  <m:mi>a</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>1</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:mn>4</m:mn>
                  </m:mrow>
                </m:mfrac>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00019">Enter the expression that could be substituted for <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00020">Compare your answer: </para>
          <para id="para-00021">The correct answer is <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>1</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:mn>2</m:mn>
                  </m:mrow>
                </m:mfrac>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00006">
        <problem id="prob-00006">
          <para id="para-00022"><m:math>
              <m:mrow>
                <m:msup>
                  <m:mi>a</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>1</m:mn>
                <m:msup>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00023">Enter the expression that could be substituted for <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00024">Compare your answer: </para>
          <para id="para-00025">The correct answer is <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
                <m:mo>=</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>1</m:mn>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00007">
        <problem id="prob-00007">
          <para id="para-00026"><m:math>
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>2</m:mn>
                <m:mi>x</m:mi>
                <m:mi>−</m:mi>
                <m:mn>9</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>2</m:mn>
                <m:mi>x</m:mi>
                <m:mi>−</m:mi>
                <m:mn>9</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:msup>
                  <m:mi>a</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00027">Enter the expression that could be substituted for <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00028">Compare your answer: </para>
          <para id="para-00029">The correct answer is <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
                <m:mo>=</m:mo>
                <m:mn>2</m:mn>
                <m:mi>x</m:mi>
                <m:mo>−</m:mo>
                <m:mn>9</m:mn>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>