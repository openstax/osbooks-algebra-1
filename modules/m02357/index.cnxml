<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Making a Perfect Square</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02357</md:content-id>
    <md:title>Making a Perfect Square</md:title>
    <md:uuid>c2834b44-2284-4795-b01a-7dce24c66b81</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
      <para id="para-00001">For questions 1 – 3, what could be added to each expression to make it a perfect square?</para>

        <exercise id="_543b9b67-dd3b-4a76-ade2-553feaddce4c" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00002">Enter what could be added to make the expression a perfect square.</para>
            <para id="para-00003"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>x</m:mi></m:mrow></m:math></para></problem>
          <solution id="sol-00001">
            <para id="para-00004">The constant term <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mn>36</m:mn></m:mrow></m:math> can be added to make the perfect square <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>36</m:mn></m:mrow></m:math>.</para>
          
          </solution>
        </exercise>
        <exercise id="b90d8ac3-5961-4630-8cd0-4f4dca82c72c" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00006">Enter what could be added to make the expression a perfect square.</para>
            <para id="para-00007"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00002">
            <para id="para-00008">8 can be added to the constant term <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math> to make the perfect square <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math>.</para>
           
          </solution>
        </exercise>
        <exercise id="_5eeca6f7-4863-4592-ae57-aafccf5fa58c" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00010">Enter what could be added to make the expression a perfect square.</para>
            <para id="para-00011"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>14</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>10</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00003">
            <para id="para-00012">59 can be added to the constant term <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>10</m:mn></m:mrow></m:math> to make the perfect square <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>14</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>49</m:mn></m:mrow></m:math>.</para>
            
          </solution>
        </exercise>

        <exercise id="exer-00001">
          <problem id="prob-00004">
            <para id="para-00014">Solve the equation <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>16</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>60</m:mn></m:mrow></m:math> by <term class="glossary-tooltip" id="term-00001">completing the square</term>. Show your reasoning.</para>
            <para id="para-00015"></para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00016">Compare your answer: </para>
            <para id="para-00017"><m:math><m:mrow><m:mrow><m:msup><m:mi>x</m:mi><m:mrow><m:mn>2</m:mn></m:mrow></m:msup><m:mo>−</m:mo><m:mn>16</m:mn><m:mi>x</m:mi><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>60</m:mn><m:mspace linebreak="newline"/><m:msup><m:mi>x</m:mi><m:mrow><m:mn>2</m:mn></m:mrow></m:msup><m:mo>−</m:mo><m:mn>16</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>64</m:mn><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>60</m:mn><m:mo>+</m:mo><m:mn>64</m:mn><m:mspace linebreak="newline"/><m:msup><m:mi>x</m:mi><m:mrow><m:mn>2</m:mn></m:mrow></m:msup><m:mo>−</m:mo><m:mn>16</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>64</m:mn><m:mi/><m:mo>=</m:mo><m:mn>4</m:mn><m:mspace linebreak="newline"/><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>8</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mn>2</m:mn></m:mrow></m:msup><m:mi/><m:mo>=</m:mo><m:mn>4</m:mn><m:mspace linebreak="newline"/><m:msqrt><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>8</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mn>2</m:mn></m:mrow></m:msup></m:mrow></m:msqrt><m:mi/><m:mo>=</m:mo><m:msqrt><m:mrow><m:mn>4</m:mn></m:mrow></m:msqrt><m:mspace linebreak="newline"/><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>8</m:mn><m:mi/><m:mo>=</m:mo><m:mi>±</m:mi><m:mn>2</m:mn><m:mspace linebreak="newline"/><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>8</m:mn><m:mi/><m:mo>=</m:mo><m:mn>2</m:mn><m:mspace linebreak="newline"/><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>8</m:mn><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mspace linebreak="newline"/><m:mspace linebreak="newline"/><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn><m:mi/><m:mtext> or </m:mtext><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:mrow></m:math></para></solution>
        </exercise>
    </section>
  </content>
</document>