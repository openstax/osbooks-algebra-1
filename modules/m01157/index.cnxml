<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.16.4: Identify and Generate Sequences</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01157</md:content-id>
    <md:title>4.16.4: Identify and Generate Sequences</md:title>
    <md:uuid>4c933a0d-7cfa-4a51-8e65-c265d65a0a65</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Cool Down Activity</title>
<para id="para-00001">Many sequences start with the terms 2 and 8.</para>


<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002">Find the next two terms of the arithmetic sequence 2, 8, ____, ____.</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00003">Compare your answers:</para>
    
    <para id="para-00004">14, 20</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00005">Find the next two terms of the geometric sequence 2, 8, ____, ____.</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00006">Compare your answers:</para>
    
    <para id="para-00007">32, 128</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00008">Find two possible next terms of a sequence 2, 8, ____, ____ that is neither geometric nor arithmetic.</para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00009">Compare your answers:</para>
    
    <para id="para-00010">9, 16</para>
  
  </solution></exercise>
<!--Interaction End --></section>
</content></document>