  <title>4.16.4: Identify and Generate Sequences</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01157</md:content-id>
    <md:title>4.16.4: Identify and Generate Sequences</md:title>
    <md:uuid>9546a5d8-c31d-46c3-8ab4-8adb7f5504cb</md:uuid>
  </metadata>
  <content>
  <section><title>Cool Down Activity</title>
<para>Many sequences start with the terms 2 and 8.</para>


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Find the next two terms of the arithmetic sequence 2, 8, ____, ____.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answers:</para>
    <para>14, 20</para>
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Find the next two terms of the geometric sequence 2, 8, ____, ____.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answers:</para>
    <para>32, 128</para>
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Find two possible next terms of a sequence 2, 8, ____, ____ that is neither geometric nor arithmetic.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answers:</para>
    <para>9, 16</para>
  </solution></exercise>
<!--Interaction End --></section>
</content>
</document>
