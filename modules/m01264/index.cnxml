  <content>
  <section>
    <div class="os-raise-ib-pset" data-button-text="Check" data-content-id="b147f5d9-b0a7-41f6-a726-265ef2518f52" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <para>Complete the following questions to practice the skills you have learned in this lesson.</para>
  <!--Q1-->
  <exercise data-content-id="7b294637-4116-4521-8f36-19acc0b541f1" data-problem-comparator="integer" data-problem-type="input" data-solution="3">
    <problem>
      <para>Simplify \(\sqrt[4]{81}\). </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.2.2.
      </para>
    </div>
    </exercise>
  <!--Q2-->
  <exercise data-content-id="23470c41-fa61-4971-9d7c-0073637a54b2" data-problem-comparator="integer" data-problem-type="input" data-solution="-2">
    <problem>
      <para>Simplify \(\sqrt[5]{-32}\). </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.2.2.</para>
    </div>
    </exercise>
  <!--Q3-->
  <exercise data-content-id="b1faaa52-5909-4d5e-9eb8-b043c84f2ebf" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x^\frac34\)" data-solution-options="[&quot;\\(x^\\frac34\\)&quot;, &quot;\\(x^\\frac43\\)&quot;, &quot;\\(4x^3\\)&quot;, &quot;\\(\\frac34x\\)&quot;]">
    <problem>
      <para>Which of the following is equivalent to \(\sqrt[4]{x^3}\)?</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.2.3.
      </para>
    </div>
    </exercise>
  <!--Q4-->
  <exercise data-content-id="2fc21da6-2cb8-4955-954d-e1426c564ce9" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(2^\frac49\)" data-solution-options="[&quot;\\(2^\\frac94\\)&quot;, &quot;\\(\\frac49(2)\\)&quot;, &quot;\\(\\frac{2^4}9\\)&quot;, &quot;\\(2^\\frac49\\)&quot;]">
    <problem>
      <para>Which of the following is equivalent to \(\sqrt[9]{2^4}\)?</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.2.3.
      </para>
    </div>
    </exercise>
  <!--q5-->
  <exercise data-content-id="5c69ff8a-3b0c-4725-841a-c61596f545f4" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(k^\frac{10}3\)" data-solution-options="[&quot;\\(k\\)&quot;, &quot;\\(\\frac13k^3\\)&quot;, &quot;\\(3k^\\frac13\\)&quot;, &quot;\\(k^\\frac{10}3\\)&quot;]">
    <problem>
      <para>Simplify \(k^3\;\cdot\;k^\frac13\).</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.2.4.
      </para>
    </div>
    </exercise>
  <!--Q6-->
  <exercise data-content-id="03d5de9f-8225-48e0-b91a-77c08243ae42" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(\frac1{m^\frac32}\)" data-solution-options="[&quot;\\(m^\\frac68\\)&quot;, &quot;\\(\\frac1{m^\\frac32}\\)&quot;, &quot;\\(m^\\frac32\\)&quot;, &quot;\\(-2m^\\frac34\\)&quot;]">
    <problem>
      <para>Simplify \({(m^\frac34)}^{-2}\).</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.2.4.
      </para>
    </div>
    </exercise>
  <!--Q7-->
  <exercise data-content-id="acb98e69-f260-41df-bcc3-6fb665287260" data-problem-type="dropdown" data-retry-limit="1" data-solution="False" data-solution-options="[&quot;True&quot;, &quot;False&quot;]">
    <problem>
      <para>True or false:
          <para>\(\sqrt[4]{-16}\;=\;-2\)</para>
        </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.2.2.
      </para>
    </div>
    </exercise>
  <!--Q8-->
  <exercise data-content-id="a3499c56-1365-444b-9ce8-3f68f558ef7f" data-problem-type="dropdown" data-retry-limit="1" data-solution="True" data-solution-options="[&quot;True&quot;, &quot;False&quot;]">
    <problem>
      <para>True or false:
          <para>\(\sqrt[3]{-64}\;=\;-4\)</para>
        </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.2.2.</para>
    </div>
    </exercise>
  <!--Q9-->
  <exercise data-content-id="bacf4c60-a706-4321-b22d-e2c39bcc9825" data-problem-type="multiselect" data-solution="[&quot;25&quot;, &quot;\\(\\sqrt{16}\\)&quot;, &quot;\\(\\sqrt[5]{9^5}\\)&quot;]" data-solution-options="[&quot;25&quot;, &quot;\\(\\sqrt{16}\\)&quot;, &quot;\\(3+3\\)&quot;, &quot;\\(\\sqrt[5]{9^5}\\)&quot;, &quot;\\(3\\;\\cdot\\;2\\)&quot;]">
    <problem>
      <para>Which of the following expressions are equivalent to perfect squares? <emphasis>Select the three</emphasis> that apply.</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.2.1.
      </para>
    </div>
    </exercise>
  <!--Q10-->
  <exercise data-content-id="bb894585-82dd-45af-8a85-3fd285acc40a" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x^\frac45\)" data-solution-options="[&quot;\\(x^4\\)&quot;, &quot;\\(x^\\frac45\\)&quot;, &quot;\\(x^\\frac4{20}\\)&quot;, &quot;\\(x^{20}\\)&quot;]">
    <problem>
      <para>Which of the following is equivalent to \({(x^\frac15)}^4\)?</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.2.4.
      </para>
    </div>
    </exercise>
