<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.2.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01264</md:content-id>
    <md:title>5.2.5: Practice</md:title>
    <md:uuid>2651c5b1-75ed-41ad-b9a8-910134ec83e3</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001">
    <section class="check-understanding" id="sect-00002">
      <exercise id="_7b294637-4116-4521-8f36-19acc0b541f1" class="multiple-choice">
        <problem id="prob-00001"><para id="para-00001">Simplify \(\sqrt[4]{81}\).</para>
      </problem>
        <solution id="sol-00001">
          
          <para id="para-00002">Try again. Revisit activity 5.2.2.
    </para>
          <para id="para-00003">The correct answer is 3.
    </para>
        </solution>
      </exercise>
      <exercise id="_23470c41-fa61-4971-9d7c-0073637a54b2" class="multiple-choice">
        <problem id="prob-00002"><para id="para-00004">Simplify \(\sqrt[5]{-32}\).</para>
      </problem>
        <solution id="sol-00002">
          
          <para id="para-00005">Try again. Revisit activity 5.2.2.</para>
          <para id="para-00006">The correct answer is –2.</para>
        </solution>
      </exercise>
      <exercise id="b1faaa52-5909-4d5e-9eb8-b043c84f2ebf" class="multiple-choice">
        <problem id="prob-00003"><para id="para-00007">Which of the following is equivalent to \(\sqrt[4]{x^3}\)?</para>
      <para id="para-00008">Multiple Choice:</para><para id="para-00009">\(x^\frac34\)</para><para id="para-00010">\(x^\frac43\)</para><para id="para-00011">\(4x^3\)</para><para id="para-00012">\(\frac34x\)</para></problem>
        <solution id="sol-00003">
          
          <para id="para-00013">Try again. Revisit activity 5.2.3.
    </para>
          <para id="para-00014">The correct answer is \(x^\frac34\).
    </para>
        </solution>
      </exercise>
      <exercise id="_2fc21da6-2cb8-4955-954d-e1426c564ce9" class="multiple-choice">
        <problem id="prob-00004"><para id="para-00015">Which of the following is equivalent to \(\sqrt[9]{2^4}\)?</para>
      <para id="para-00016">Multiple Choice:</para><para id="para-00017">\(2^\frac94\)</para><para id="para-00018">\(\frac49(2)\)</para><para id="para-00019">\(\frac{2^4}9\)</para><para id="para-00020">\(2^\frac49\)</para></problem>
        <solution id="sol-00004">
          
          <para id="para-00021">Try again. Revisit activity 5.2.3.
    </para>
          <para id="para-00022">The correct answer is \(2^\frac49\).
    </para>
        </solution>
      </exercise>
      <exercise id="_5c69ff8a-3b0c-4725-841a-c61596f545f4" class="multiple-choice">
        <problem id="prob-00005"><para id="para-00023">Simplify \(k^3\;\cdot\;k^\frac13\).</para>
      <para id="para-00024">Multiple Choice:</para><para id="para-00025">\(k\)</para><para id="para-00026">\(\frac13k^3\)</para><para id="para-00027">\(3k^\frac13\)</para><para id="para-00028">\(k^\frac{10}3\)</para></problem>
        <solution id="sol-00005">
          
          <para id="para-00029">Try again. Revisit activity 5.2.4.
    </para>
          <para id="para-00030">The correct answer is \(k^\frac{10}3\). \(k^3\cdot k^\frac13=k^{3+\frac13}=k^{\frac93+\frac13}\).
    </para>
        </solution>
      </exercise>
      <exercise id="_03d5de9f-8225-48e0-b91a-77c08243ae42" class="multiple-choice">
        <problem id="prob-00006"><para id="para-00031">Simplify \({(m^\frac34)}^{-2}\).</para>
      <para id="para-00032">Multiple Choice:</para><para id="para-00033">\(m^\frac68\)</para><para id="para-00034">\(\frac1{m^\frac32}\)</para><para id="para-00035">\(m^\frac32\)</para><para id="para-00036">\(-2m^\frac34\)</para></problem>
        <solution id="sol-00006">
          
          <para id="para-00037">Try again. Revisit activity 5.2.4.
    </para>
          <para id="para-00038">The correct answer is \(\frac1{m^\frac32}\). Multiply the exponents, and then get rid of the negative exponent.

    </para>
        </solution>
      </exercise>
      <exercise id="acb98e69-f260-41df-bcc3-6fb665287260" class="multiple-choice">
        <problem id="prob-00007"><para id="para-00039">True or false:      </para>
          <para id="para-00040">\(\sqrt[4]{-16}\;=\;-2\)</para>

      </problem>
        <solution id="sol-00007">
          
          <para id="para-00041">Try again. Revisit activity 5.2.2.
    </para>
          <para id="para-00042">The correct answer is false. You cannot take the even root of a negative number and have a real answer.</para>
        </solution>
      </exercise>
      <exercise id="a3499c56-1365-444b-9ce8-3f68f558ef7f" class="multiple-choice">
        <problem id="prob-00008"><para id="para-00043">True or false:      </para>

          <para id="para-00044">\(\sqrt[3]{-64}\;=\;-4\)</para>
      </problem>
        <solution id="sol-00008">
          
          <para id="para-00045">Try again. Revisit activity 5.2.2.</para>
          <para id="para-00046">The correct answer is true. The cubed root of 64 is 4, and it is possible to have an odd root of a negative number.
    </para>
        </solution>
      </exercise>
      <exercise id="bacf4c60-a706-4321-b22d-e2c39bcc9825" class="multiple-choice">
        <problem id="prob-00009"><para id="para-00047">Which of the following expressions are equivalent to perfect squares?<emphasis>Select the three</emphasis> that apply.</para>
      </problem>
        <solution id="sol-00009">
          
          <para id="para-00048">Try again. Revisit activity 5.2.1.
    </para>
          <para id="para-00049">The correct answer is 25, \(\sqrt{16}\), \(\sqrt[5]{9^5}\).
    </para>
        </solution>
      </exercise>
      <exercise id="bb894585-82dd-45af-8a85-3fd285acc40a" class="multiple-choice">
        <problem id="prob-00010"><para id="para-00050">Which of the following is equivalent to \({(x^\frac15)}^4\)?</para>
      <para id="para-00051">Multiple Choice:</para><para id="para-00052">\(x^4\)</para><para id="para-00053">\(x^\frac45\)</para><para id="para-00054">\(x^\frac4{20}\)</para><para id="para-00055">\(x^{20}\)</para></problem>
        <solution id="sol-00010">
          
          <para id="para-00056">Try again. Revisit activity 5.2.4.
    </para>
          <para id="para-00057">The correct answer is \(x^\frac45\).
    </para>
        </solution>
      </exercise>
    </section>
  </section>
</content>
</document>