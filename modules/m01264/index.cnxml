<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.2.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01264</md:content-id>
    <md:title>5.2.5: Practice</md:title>
    <md:uuid>2651c5b1-75ed-41ad-b9a8-910134ec83e3</md:uuid>
  </metadata>
  <content>
  <section class="practice" id="sect-00001">
    <section id="sect-00002">
      <exercise id="_7b294637-4116-4521-8f36-19acc0b541f1" class="multiple-choice">
        <problem id="prob-00001"><para id="para-00001">Simplify <m:math display="inline"><m:mrow><m:mroot><m:mrow><m:mn>81</m:mn></m:mrow><m:mn>4</m:mn></m:mroot></m:mrow></m:math>.</para>
      </problem>
        <solution id="sol-00001">
          
          <para id="para-00002">Try again. Revisit activity 5.2.2.
    </para>
          <para id="para-00003">The correct answer is 3.
    </para>
        </solution>
      </exercise>
      <exercise id="_23470c41-fa61-4971-9d7c-0073637a54b2" class="multiple-choice">
        <problem id="prob-00002"><para id="para-00004">Simplify <m:math display="inline"><m:mrow><m:mroot><m:mrow><m:mo>−</m:mo><m:mn>32</m:mn></m:mrow><m:mn>5</m:mn></m:mroot></m:mrow></m:math>.</para>
      </problem>
        <solution id="sol-00002">
          
          <para id="para-00005">Try again. Revisit activity 5.2.2.</para>
          <para id="para-00006">The correct answer is –2.</para>
        </solution>
      </exercise>
      <exercise id="b1faaa52-5909-4d5e-9eb8-b043c84f2ebf" class="multiple-choice">
        <problem id="prob-00003"><para id="para-00007">Which of the following is equivalent to <m:math display="inline"><m:mrow><m:mroot><m:mrow><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup></m:mrow><m:mn>4</m:mn></m:mroot></m:mrow></m:math>?</para>
      <para id="para-00008">Multiple Choice:</para><para id="para-00009"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:msup></m:mrow></m:math></para><para id="para-00010"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mfrac><m:mn>4</m:mn><m:mn>3</m:mn></m:mfrac></m:msup></m:mrow></m:math></para><para id="para-00011"><m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para><para id="para-00012"><m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mi>x</m:mi></m:mrow></m:math></para></problem>
        <solution id="sol-00003">
          
          <para id="para-00013">Try again. Revisit activity 5.2.3.
    </para>
          <para id="para-00014">The correct answer is <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:msup></m:mrow></m:math>.
    </para>
        </solution>
      </exercise>
      <exercise id="_2fc21da6-2cb8-4955-954d-e1426c564ce9" class="multiple-choice">
        <problem id="prob-00004"><para id="para-00015">Which of the following is equivalent to <m:math display="inline"><m:mrow><m:mroot><m:mrow><m:msup><m:mn>2</m:mn><m:mn>4</m:mn></m:msup></m:mrow><m:mn>9</m:mn></m:mroot></m:mrow></m:math>?</para>
      <para id="para-00016">Multiple Choice:</para><para id="para-00017"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mfrac><m:mn>9</m:mn><m:mn>4</m:mn></m:mfrac></m:msup></m:mrow></m:math></para><para id="para-00018"><m:math><m:mrow><m:mfrac><m:mn>4</m:mn><m:mn>9</m:mn></m:mfrac><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00019"><m:math><m:mrow><m:mfrac><m:mrow><m:msup><m:mn>2</m:mn><m:mn>4</m:mn></m:msup></m:mrow><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para><para id="para-00020"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mfrac><m:mn>4</m:mn><m:mn>9</m:mn></m:mfrac></m:msup></m:mrow></m:math></para></problem>
        <solution id="sol-00004">
          
          <para id="para-00021">Try again. Revisit activity 5.2.3.
    </para>
          <para id="para-00022">The correct answer is <m:math display="inline"><m:mrow><m:msup><m:mn>2</m:mn><m:mfrac><m:mn>4</m:mn><m:mn>9</m:mn></m:mfrac></m:msup></m:mrow></m:math>.
    </para>
        </solution>
      </exercise>
      <exercise id="_5c69ff8a-3b0c-4725-841a-c61596f545f4" class="multiple-choice">
        <problem id="prob-00005"><para id="para-00023">Simplify <m:math display="inline"><m:mrow><m:msup><m:mi>k</m:mi><m:mn>3</m:mn></m:msup><m:mspace width="0.278em"/><m:mi>·</m:mi><m:mspace width="0.278em"/><m:msup><m:mi>k</m:mi><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:msup></m:mrow></m:math>.</para>
      <para id="para-00024">Multiple Choice:</para><para id="para-00025"><m:math><m:mrow><m:mi>k</m:mi></m:mrow></m:math></para><para id="para-00026"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:msup><m:mi>k</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para><para id="para-00027"><m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>k</m:mi><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:msup></m:mrow></m:math></para><para id="para-00028"><m:math><m:mrow><m:msup><m:mi>k</m:mi><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mn>3</m:mn></m:mfrac></m:msup></m:mrow></m:math></para></problem>
        <solution id="sol-00005">
          
          <para id="para-00029">Try again. Revisit activity 5.2.4.
    </para>
          <para id="para-00030">The correct answer is <m:math display="inline"><m:mrow><m:msup><m:mi>k</m:mi><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mn>3</m:mn></m:mfrac></m:msup></m:mrow></m:math>. <m:math display="inline"><m:mrow><m:msup><m:mi>k</m:mi><m:mn>3</m:mn></m:msup><m:mi>·</m:mi><m:msup><m:mi>k</m:mi><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:msup><m:mo>=</m:mo><m:msup><m:mi>k</m:mi><m:mrow><m:mn>3</m:mn><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:msup><m:mo>=</m:mo><m:msup><m:mi>k</m:mi><m:mrow><m:mfrac><m:mn>9</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:msup></m:mrow></m:math>.
    </para>
        </solution>
      </exercise>
      <exercise id="_03d5de9f-8225-48e0-b91a-77c08243ae42" class="multiple-choice">
        <problem id="prob-00006"><para id="para-00031">Simplify <m:math display="inline"><m:mrow><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:msup><m:mi>m</m:mi><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:msup><m:mo stretchy="false">)</m:mo></m:mrow><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:msup></m:mrow></m:math>.</para>
      <para id="para-00032">Multiple Choice:</para><para id="para-00033"><m:math><m:mrow><m:msup><m:mi>m</m:mi><m:mfrac><m:mn>6</m:mn><m:mn>8</m:mn></m:mfrac></m:msup></m:mrow></m:math></para><para id="para-00034"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mrow><m:msup><m:mi>m</m:mi><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00035"><m:math><m:mrow><m:msup><m:mi>m</m:mi><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac></m:msup></m:mrow></m:math></para><para id="para-00036"><m:math><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn><m:msup><m:mi>m</m:mi><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:msup></m:mrow></m:math></para></problem>
        <solution id="sol-00006">
          
          <para id="para-00037">Try again. Revisit activity 5.2.4.
    </para>
          <para id="para-00038">The correct answer is <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mrow><m:msup><m:mi>m</m:mi><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac></m:msup></m:mrow></m:mfrac></m:mrow></m:math>. Multiply the exponents, and then get rid of the negative exponent.

    </para>
        </solution>
      </exercise>
      <exercise id="acb98e69-f260-41df-bcc3-6fb665287260" class="multiple-choice">
        <problem id="prob-00007"><para id="para-00039">True or false:      </para>
          <para id="para-00040"><m:math><m:mrow><m:mroot><m:mrow><m:mo>−</m:mo><m:mn>16</m:mn></m:mrow><m:mn>4</m:mn></m:mroot><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>

      </problem>
        <solution id="sol-00007">
          
          <para id="para-00041">Try again. Revisit activity 5.2.2.
    </para>
          <para id="para-00042">The correct answer is false. You cannot take the even root of a negative number and have a real answer.</para>
        </solution>
      </exercise>
      <exercise id="a3499c56-1365-444b-9ce8-3f68f558ef7f" class="multiple-choice">
        <problem id="prob-00008"><para id="para-00043">True or false:      </para>

          <para id="para-00044"><m:math><m:mrow><m:mroot><m:mrow><m:mo>−</m:mo><m:mn>64</m:mn></m:mrow><m:mn>3</m:mn></m:mroot><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
      </problem>
        <solution id="sol-00008">
          
          <para id="para-00045">Try again. Revisit activity 5.2.2.</para>
          <para id="para-00046">The correct answer is true. The cubed root of 64 is 4, and it is possible to have an odd root of a negative number.
    </para>
        </solution>
      </exercise>
      <exercise id="bacf4c60-a706-4321-b22d-e2c39bcc9825" class="multiple-choice">
        <problem id="prob-00009"><para id="para-00047">Which of the following expressions are equivalent to perfect squares?<emphasis>Select the three</emphasis> that apply.</para>
      </problem>
        <solution id="sol-00009">
          
          <para id="para-00048">Try again. Revisit activity 5.2.1.
    </para>
          <para id="para-00049">The correct answer is 25, <m:math display="inline"><m:mrow><m:msqrt><m:mrow><m:mn>16</m:mn></m:mrow></m:msqrt></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mroot><m:mrow><m:msup><m:mn>9</m:mn><m:mn>5</m:mn></m:msup></m:mrow><m:mn>5</m:mn></m:mroot></m:mrow></m:math>.
    </para>
        </solution>
      </exercise>
      <exercise id="bb894585-82dd-45af-8a85-3fd285acc40a" class="multiple-choice">
        <problem id="prob-00010"><para id="para-00050">Which of the following is equivalent to <m:math display="inline"><m:mrow><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:msup><m:mi>x</m:mi><m:mfrac><m:mn>1</m:mn><m:mn>5</m:mn></m:mfrac></m:msup><m:mo stretchy="false">)</m:mo></m:mrow><m:mn>4</m:mn></m:msup></m:mrow></m:math>?</para>
      <para id="para-00051">Multiple Choice:</para><para id="para-00052"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:math></para><para id="para-00053"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac></m:msup></m:mrow></m:math></para><para id="para-00054"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mfrac><m:mn>4</m:mn><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:msup></m:mrow></m:math></para><para id="para-00055"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mrow><m:mn>20</m:mn></m:mrow></m:msup></m:mrow></m:math></para></problem>
        <solution id="sol-00010">
          
          <para id="para-00056">Try again. Revisit activity 5.2.4.
    </para>
          <para id="para-00057">The correct answer is <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac></m:msup></m:mrow></m:math>.
    </para>
        </solution>
      </exercise>
    </section>
  </section>
</content>
</document>
