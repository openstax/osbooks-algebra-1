      </entry>
      <entry scope="col" class="emphasis">
        Factor 2
      </entry>
      <entry scope="col" class="emphasis">
        \(b\) (negative)
      </entry>
    </row>
  </thead>
  <tbody>
    <row>
      <entry>
        <para>1</para>
      </entry>
      <entry>
        <para>-60</para>
      </entry>
      <entry>
        <para>-59</para>
      </entry>
    </row>
    <row>
      <entry>
        <para>2</para>
      </entry>
      <entry>
        <para>-30</para>
      </entry>
      <entry>
        <para>-28</para>
      </entry>
    </row>
    <row>
      <entry>
        <para>3</para>
      </entry>
      <entry>
        <para>-20</para>
      </entry>
      <entry>
        <para>-17</para>
      </entry>
    </row>
    <row>
      <entry>
        <para>4</para>
      </entry>
      <entry>
        <para>-15</para>
      </entry>
      <entry>
        <para>-11</para>
      </entry>
    </row>
    <row>
