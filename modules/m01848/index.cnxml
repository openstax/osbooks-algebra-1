<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>7.7.1: Comparing Graphs of Functions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01848</md:content-id>
    <md:title>7.7.1: Comparing Graphs of Functions</md:title>
    <md:uuid>de1086c3-a18e-4663-8024-93eed1f2033b</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Warm Up Activity</title>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00001">Which one doesn’t belong?</para>
   
              <para id="para-00002">Graph A</para>
              <para id="para-00003">
                
                  <media alt="Graph of a horizontal line that passes through the point (0, 2).">
                    <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_09_02_01.svg" height="200"/>
                  </media>
                
            </para>
            
              <para id="para-00004">Graph B</para>
              <para id="para-00005">
                
                  <media alt="Graph of a line that passes through the point (0, 2) with a slope of 2.">
                    <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_09_02_02.svg" height="200"/>
                  </media>
                
            </para>
            
          
              <para id="para-00006">Graph C</para>
              <para id="para-00007">
                
                  <media alt="Graph of discrete data that includes the point (0, 2) in its set and seems to grow exponentially.">
                    <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_09_02_03.svg"/>
                  </media>
                
            </para>
            
            
              <para id="para-00008">Graph D</para>
              <para id="para-00009">
                
                  <media alt="Graph of a curve that passes through the point (-1, 2).">
                    <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_09_02_04.svg" height="200"/>
                  </media>
                
            </para>
            
          
        </problem>
        <solution id="sol-00001">
          <para id="para-00011">Compare your answer:</para>
          <para id="para-00012">Graph A is the only graph where the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-values don’t change.</para>
          <para id="para-00013">Graph B is the only graph where the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-value increases by a constant rate.</para>
          <para id="para-00014">Graph C is the only graph that is not continuous.</para>
          <para id="para-00015">Graph D is the only graph that does not intersect the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-axis at <m:math display="inline"><m:mrow><m:mn>2</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>
