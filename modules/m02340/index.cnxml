<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.1.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02340</md:content-id>
    <md:title>9.1.5: Practice</md:title>
    <md:uuid>a0f997ad-4919-42b8-af6e-d8945e194982</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
        <exercise id="_11dde5e5-278b-4d9f-8b08-b197c7eef718" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00002"><emphasis>Select three</emphasis> expressions that are perfect squares.</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00003">Correct! <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>9</m:mn><m:mo>+</m:mo><m:mi>c</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>c</m:mi><m:mi>−</m:mi><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo>+</m:mo><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>b</m:mi><m:mo>+</m:mo><m:mi>a</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00004">Try again. Revisit activity 9.1.2.</para>
            <para id="para-00005">The correct answers are: <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>9</m:mn><m:mo>+</m:mo><m:mi>c</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>c</m:mi><m:mi>−</m:mi><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo>+</m:mo><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>b</m:mi><m:mo>+</m:mo><m:mi>a</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="dff1a48a-a417-4d5b-b96b-4cd06de06be8" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00006">Each diagram represents the square of an expression or a perfect square. Complete the cells in the last table by answering questions a–d.</para>
            <table class="unnumbered" summary="..." id="table-00001">
              <tgroup cols="3">
                <tbody>
                  <row>
                    <entry><para id="para-00007">
                        <emphasis>Diagram 1</emphasis>
                                     <media alt="">
                            <image mime-type="image/png" src="../../media/Algebra-1_10_03_10_01.png"/>
                          </media>
                        
                     </para></entry>
                    <entry><para id="para-00008">
                        <emphasis>Diagram 2</emphasis>
                                     <media alt="">
                            <image mime-type="image/png" src="../../media/Algebra-1_10_03_10_02.png"/>
                          </media>
                        
                     </para></entry>
                    <entry><para id="para-00009">
                        <emphasis>Diagram 3</emphasis>
                                     <media alt="">
                            <image mime-type="image/png" src="../../media/Algebra-1_10_03_10_03.png"/>
                          </media>
                        
                     </para></entry>
                  </row>
                </tbody>
              </tgroup>
            </table>
            <para id="para-00010">What is the answer for Cell a in Diagram 3?</para>
            <para id="para-00011">Multiple Choice:</para>
            <para id="para-00012"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi></m:mrow></m:math></para><para id="para-00013"><m:math><m:mrow><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00014"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00015"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para></problem>
          <solution id="sol-00002">
            <para id="para-00016">Correct! <m:math display="inline"><m:mrow><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
            <para id="para-00017">Try again. Revisit activities 9.1.1 and 9.1.2.</para>
            <para id="para-00018">The correct answer is: <m:math display="inline"><m:mrow><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_6412a13a-0dea-4f98-9b00-c31709c028af" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00019">What is the answer for Cell b in Diagram 3?</para>
            <para id="para-00020">Multiple Choice:</para>
            <para id="para-00021"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi></m:mrow></m:math></para><para id="para-00022"><m:math><m:mrow><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00023"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00024"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para></problem>
          <solution id="sol-00003">
            <para id="para-00025">Correct! <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi></m:mrow></m:math></para>
            <para id="para-00026">Try again. Revisit activities 9.1.1 and 9.1.2.</para>
            <para id="para-00027">The correct answer is: <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_8b672410-80a0-4ac7-8e1b-13019f612e3a" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00028">What is the answer for Cell c in Diagram 3?</para>
            <para id="para-00029">Multiple Choice:</para>
            <para id="para-00030"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi></m:mrow></m:math></para><para id="para-00031"><m:math><m:mrow><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00032"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00033"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para></problem>
          <solution id="sol-00004">
            <para id="para-00034">Correct! <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi></m:mrow></m:math></para>
            <para id="para-00035">Try again. Revisit activities 9.1.1 and 9.1.2.</para>
            <para id="para-00036">The correct answer is: <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_1d8ec1dd-d88f-4ec8-805a-7ba25f5b233b" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00037">What is the answer for Cell d in Diagram 3?</para>
            <para id="para-00038">Multiple Choice:</para>
            <para id="para-00039"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi></m:mrow></m:math></para><para id="para-00040"><m:math><m:mrow><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00041"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00042"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para></problem>
          <solution id="sol-00005">
            <para id="para-00043">Correct! <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
            <para id="para-00044">Try again. Revisit activities 9.1.1 and 9.1.2.</para>
            <para id="para-00045">The correct answer is: <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_279c810f-24f4-4b34-9f36-8e0ff8d22822" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00046">Rewrite the perfect-square expression <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math> in standard form <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>b</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi></m:mrow></m:math>.</para>
            <para id="para-00047">Multiple Choice:</para>
            <para id="para-00048"><m:math><m:mrow><m:mn>16</m:mn><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>49</m:mn></m:mrow></m:math></para><para id="para-00049"><m:math><m:mrow><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>14</m:mn><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>14</m:mn></m:mrow></m:math></para><para id="para-00050"><m:math><m:mrow><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>49</m:mn><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>14</m:mn></m:mrow></m:math></para><para id="para-00051"><m:math><m:mrow><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>14</m:mn><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>49</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00006">
            <para id="para-00052">Correct! <m:math display="inline"><m:mrow><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>14</m:mn><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>49</m:mn></m:mrow></m:math></para>
            <para id="para-00053">Try again. Revisit activity 9.1.2.</para>
            <para id="para-00054">The correct answer is: <m:math display="inline"><m:mrow><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>14</m:mn><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>49</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_7a1a31dd-80d8-429b-9301-5b935d836307" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00055">Rewrite the perfect-square expression <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo>−</m:mo><m:mi>m</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math> in standard form <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>b</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi></m:mrow></m:math>.</para>
            <para id="para-00056">Multiple Choice:</para>
            <para id="para-00057"><m:math><m:mrow><m:mo>−</m:mo><m:mn>12</m:mn><m:mi>m</m:mi><m:mo>+</m:mo><m:mn>10</m:mn></m:mrow></m:math></para><para id="para-00058"><m:math><m:mrow><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>10</m:mn><m:mi>m</m:mi><m:mo>−</m:mo><m:mn>25</m:mn></m:mrow></m:math></para><para id="para-00059"><m:math><m:mrow><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>10</m:mn><m:mi>m</m:mi><m:mo>+</m:mo><m:mn>25</m:mn></m:mrow></m:math></para><para id="para-00060"><m:math><m:mrow><m:mn>25</m:mn><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>10</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00007">
            <para id="para-00061">Correct! <m:math display="inline"><m:mrow><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>10</m:mn><m:mi>m</m:mi><m:mo>+</m:mo><m:mn>25</m:mn></m:mrow></m:math></para>
            <para id="para-00062">Try again. Revisit activity 9.1.2.</para>
            <para id="para-00063">The correct answer is: <m:math display="inline"><m:mrow><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>10</m:mn><m:mi>m</m:mi><m:mo>+</m:mo><m:mn>25</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="c040b6fe-8f55-4422-aee3-7456368c9695" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00064">Rewrite the perfect-square expression <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math> in standard form <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>b</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi></m:mrow></m:math>.</para>
            <para id="para-00065">Multiple Choice:</para>
            <para id="para-00066"><m:math><m:mrow><m:mn>2</m:mn><m:mi>h</m:mi><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>9</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00067"><m:math><m:mrow><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>9</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00068"><m:math><m:mrow><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>6</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>6</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00069"><m:math><m:mrow><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>9</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para></problem>
          <solution id="sol-00008">
            <para id="para-00070">Correct! <m:math display="inline"><m:mrow><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>9</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
            <para id="para-00071">Try again. Revisit activity 9.1.2.</para>
            <para id="para-00072">The correct answer is: <m:math display="inline"><m:mrow><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>h</m:mi><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>9</m:mn></m:mrow></m:mfrac></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_4146a061-87e1-445b-ad35-fb5087f2951e" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00073">For 6 - 9, solve each equation, then choose the two solutions.</para>
            <para id="para-00074"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00009">
            <para id="para-00075">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
            <para id="para-00076">Try again. Revisit activities 9.1.3 and 9.1.4.</para>
            <para id="para-00077">The correct answers are: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_62f827e1-bb1b-4c3d-9e9d-6c8c2e41b099" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00078"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>81</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00010">
            <para id="para-00079">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>14</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
            <para id="para-00080">Try again. Revisit activities 9.1.3 and 9.1.4.</para>
            <para id="para-00081">The correct answers are: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>14</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="bb8157da-6f70-4865-a18d-8db84196c875" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00082"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>11</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>121</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00011">
            <para id="para-00083">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>22</m:mn></m:mrow></m:math></para>
            <para id="para-00084">Try again. Revisit activities 9.1.3 and 9.1.4.</para>
            <para id="para-00085">The correct answers are: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>22</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="b2332ac2-a21f-4d65-8dce-81608a0ceb25" class="multiple-choice">
          <problem id="prob-00012">
            <para id="para-00086"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>7</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>64</m:mn></m:mrow><m:mrow><m:mn>49</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para></problem>
          <solution id="sol-00012">
            <para id="para-00087">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>41</m:mn></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>57</m:mn></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
            <para id="para-00088">Try again. Revisit activities 9.1.3 and 9.1.4.</para>
            <para id="para-00089">The correct answers are: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>41</m:mn></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>57</m:mn></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="d5e71b8c-454e-4279-aef9-5790bb864ab5" class="multiple-choice">
          <problem id="prob-00013">
            <para id="para-00090">Enter the solution to the equation.</para>
            <para id="para-00091">Solve the equation <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math>.</para>
          </problem>
          <solution id="sol-00013">
            <para id="para-00092">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
            <para id="para-00093">Try again. Revisit activities 9.1.3 and 9.1.4.</para>
            <para id="para-00094">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
    </section>
  </content>
