<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.1.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02340</md:content-id>
    <md:title>9.1.5: Practice</md:title>
    <md:uuid>46177699-a94c-4731-989e-9f08b43854e6</md:uuid>
  </metadata>
  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="8167bde5-7905-4783-beb1-accd58c86f17" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--1-->
  <exercise data-content-id="11dde5e5-278b-4d9f-8b08-b197c7eef718" data-problem-type="multiselect" data-solution="[&quot;\\((x+5)(x+5)\\)&quot;, &quot;\\((-9+c)(c-9)\\)&quot;, &quot;\\((a+b)(b+a)\\)&quot;]" data-solution-options="[&quot;\\((x+5)(x+5)\\)&quot;, &quot;\\((-9+c)(c-9)\\)&quot;, &quot;\\((y-10)(10-y)\\)&quot;, &quot;\\((2x-1)(2x+1)\\)&quot;, &quot;\\((4-3x)(3-4x)\\)&quot;, &quot;\\((a+b)(b+a)\\)&quot;]">
    <problem>
      <para><emphasis>Select three</emphasis> expressions that are perfect squares.</para>
      </problem>
    <solution>
      <para>Correct! \((x+5)(x+5), (-9+c)(c−9), (a+b)(b+a)\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.1.2.</para>
    </div>
    </exercise>
  <!--2a-->
  <exercise data-content-id="dff1a48a-a417-4d5b-b96b-4cd06de06be8" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(h^2\)" data-solution-options="[&quot;\\(\\frac {1}{3}h\\)&quot;, &quot;\\(h^2\\)&quot;, &quot;\\((\\frac {1}{3}h)^2\\)&quot;, &quot;\\((\\frac {1}{3})^2\\)&quot;]">
    <problem>
      <para>Each diagram represents the square of an expression or a perfect square. Complete the cells in the last
          table by answering questions a–d.</para>
      <div class="os-raise-d-flex os-raise-justify-content-between">
        <para class="os-raise-text-center"><emphasis>Diagram 1</emphasis><image alt="" height="213" role="presentation" src="https://k12.openstax.org/contents/raise/resources/2259d051936f1271547bf944c3af61764012fc1b"/>
        </para>
        <para class="os-raise-text-center"><emphasis>Diagram 2</emphasis><image alt="" height="213" role="presentation" src="https://k12.openstax.org/contents/raise/resources/bc6b5acb2e2e95c69fe1de6cca7a0b4184fdccd9"/>
        </para>
        <para class="os-raise-text-center"><emphasis>Diagram 3</emphasis><image alt="" height="214" role="presentation" src="https://k12.openstax.org/contents/raise/resources/6a71f86eade1ae48e7c211562e3823e1f5e4c409"/>
        </para>
      </div>
      <para>What is the answer for Cell a in Diagram 3?</para>
      </problem>
    <solution>
      <para>Correct! \(h^2\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 9.1.1 and 9.1.2.</para>
    </div>
    </exercise>
  <!--2b-->
  <exercise data-content-id="6412a13a-0dea-4f98-9b00-c31709c028af" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(\frac {1}{3}h\)" data-solution-options="[&quot;\\(\\frac {1}{3}h\\)&quot;, &quot;\\(h^2\\) &quot;, &quot;\\((\\frac {1}{3}h)^2\\)&quot;, &quot;\\((\\frac {1}{3})^2\\)&quot;]">
    <problem>
      <para>What is the answer for Cell b in Diagram 3?</para>
      </problem>
    <solution>
      <para>Correct! \(\frac {1}{3}h\)</para>
    </solution>

    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 9.1.1 and 9.1.2.</para>
    </div>
    </exercise>
  <!--2c-->
  <exercise data-content-id="8b672410-80a0-4ac7-8e1b-13019f612e3a" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(\frac {1}{3}h\)" data-solution-options="[&quot;\\(\\frac {1}{3}h\\)&quot;, &quot;\\(h^2\\)&quot;, &quot;\\((\\frac {1}{3}h)^2\\)&quot;, &quot;\\((\\frac {1}{3})^2\\)&quot;]">
    <problem>
      <para>What is the answer for Cell c in Diagram 3?</para>
      </problem>
    <solution>
      <para>Correct! \(\frac {1}{3}h\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 9.1.1 and 9.1.2.</para>
    </div>
    </exercise>
  <!--2d-->
  <exercise data-content-id="1d8ec1dd-d88f-4ec8-805a-7ba25f5b233b" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((\frac {1}{3})^2\)" data-solution-options="[&quot;\\(\\frac {1}{3}h\\)&quot;, &quot;\\(h^2\\)&quot;, &quot;\\((\\frac {1}{3}h)^2\\)&quot;, &quot;\\((\\frac {1}{3})^2\\)&quot;]">
    <problem>
      <para>What is the answer for Cell d in Diagram 3?</para>
      </problem>
    <solution>
      <para>Correct! \((\frac {1}{3})^2\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 9.1.1 and 9.1.2.</para>
    </div>
    </exercise>
  <!--5a-->
  <exercise data-content-id="279c810f-24f4-4b34-9f36-8e0ff8d22822" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(n^2+14n+49\)" data-solution-options="[&quot;\\(16n+49\\)&quot;, &quot;\\(n^2+14n+14\\)&quot;, &quot;\\(n^2+49n+14\\)&quot;, &quot;\\(n^2+14n+49\\)&quot;]">
    <problem>
      <para>Rewrite the perfect-square expression \((n+7)^2\) in standard form \(ax^2+bx+c\).</para>
      </problem>
    <solution>
      <para>Correct! \(n^2+14n+49\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.1.2.</para>
    </div>
    </exercise>
  <!--5b-->
  <exercise data-content-id="7a1a31dd-80d8-429b-9301-5b935d836307" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\( m^2-10m+25\)" data-solution-options="[&quot;\\(-12m+10\\)&quot;, &quot;\\(m^2+10m-25\\)&quot;, &quot;\\( m^2-10m+25\\)&quot;, &quot;\\(25m^2-10\\)&quot;]">
    <problem>
      <para>Rewrite the perfect-square expression \((5-m)^2\) in standard form \(ax^2+bx+c\).</para>
      </problem>
    <solution>
      <para>Correct! \( m^2-10m+25\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.1.2.</para>
    </div>
    </exercise>
  <!--5c-->
  <exercise data-content-id="c040b6fe-8f55-4422-aee3-7456368c9695" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(h^2+\frac {2}{3}h+\frac {1}{9}\)" data-solution-options="[&quot;\\(2h+\\frac {2}{3}h+\\frac {1}{9}\\)&quot;, &quot;\\(h^2+\\frac {2}{3}h+\\frac {1}{9}\\)&quot;, &quot;\\(h^2+\\frac {2}{6}h+\\frac {2}{6}\\)&quot;, &quot;\\(h^2+\\frac {1}{9}h+\\frac {2}{3}\\)&quot;]">
    <problem>
      <para>Rewrite the perfect-square expression \((h+ \frac {1}{3})^2\) in standard form \(ax^2+bx+c\).</para>
      </problem>
    <solution>
      <para>Correct! \(h^2+\frac {2}{3}h+\frac {1}{9}\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 9.1.2.</para>
    </div>
    </exercise>
  <!--6a-->
  <exercise data-content-id="4146a061-87e1-445b-ad35-fb5087f2951e" data-problem-type="multiselect" data-solution="[&quot;\\(x = -1\\)&quot;, &quot;\\(x = 3\\)&quot;]" data-solution-options="[&quot;\\(x = -1\\)&quot;, &quot;\\(x = 5\\)&quot;, &quot;\\(x = 2\\)&quot;, &quot;\\(x = 3\\)&quot;, &quot;\\(x = 6\\)&quot;]">
    <problem>
      <para> For questions 6-9, solve each equation, then choose the <emphasis>two </emphasis>solutions.</para>
      <para>\((x-1)^2=4\)</para>
      </problem>
    <solution>
      <para>Correct! \(x= -1\) and \(x=3\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 9.1.3 and 9.1.4.</para>
    </div>
    </exercise>
  <!--6b-->
  <exercise data-content-id="62f827e1-bb1b-4c3d-9e9d-6c8c2e41b099" data-problem-type="multiselect" data-solution="[&quot;\\(x = -14\\)&quot;, &quot;\\(x = 4\\)&quot;]" data-solution-options="[&quot;\\( x = 76\\)&quot;, &quot;\\(x = -14\\)&quot;, &quot;\\(x = 86\\)&quot;, &quot;\\(x = 3\\)&quot;, &quot;\\(x = 4\\)&quot;]">
    <problem>
      <para>\((x+5)^2=81\)</para>
      </problem>
    <solution>
      <para>Correct! \(x= -14\) and \(x=4\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 9.1.3 and 9.1.4.</para>
    </div>
    </exercise>
  <!--6c-->
  <exercise data-content-id="bb8157da-6f70-4865-a18d-8db84196c875" data-problem-type="multiselect" data-solution="[&quot;\\(x = 0\\)&quot;, &quot;\\(x = -22\\)&quot;]" data-solution-options="[&quot;\\(x = 132\\) &quot;, &quot;\\(x = 110\\)&quot;, &quot;\\(x = 0\\)&quot;, &quot;\\(x = -22\\)&quot;, &quot;\\(x = 4\\)&quot;]">
    <problem>
      <para>\((x+11)^2=121\)</para>
      </problem>
    <solution>
      <para> Correct! \(x=0\) and \(x = -22\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 9.1.3 and 9.1.4.</para>
    </div>
    </exercise>
  <!--6d-->
  <exercise data-content-id="b2332ac2-a21f-4d65-8dce-81608a0ceb25" data-problem-type="multiselect" data-solution="[&quot;\\(x= \\frac {41}{7}\\)&quot;, &quot;\\(x = \\frac {57}{7}\\)&quot;]" data-solution-options="[&quot;\\(x = 2\\)&quot;, &quot;\\(x=- \\frac {279}{79}\\)&quot;, &quot;\\(x= \\frac {41}{7}\\)&quot;, &quot;\\(x= \\frac {407}{49}\\)&quot;, &quot;\\(x = \\frac {57}{7}\\)&quot;]">
    <problem>
      <para>\((x-7)^2=\frac {64}{49}\)</para>
      </problem>
    <solution>
      <para>Correct! \(x= \frac {41}{7}\) and \(x = \frac {57}{7}\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 9.1.3 and 9.1.4.</para>
    </div>
    </exercise>
  <!--7-->
  <exercise data-content-id="d5e71b8c-454e-4279-aef9-5790bb864ab5" data-problem-comparator="integer" data-problem-type="input" data-solution="2">
    <problem>
      <para>Solve the equation \((x-2)^2=0\).</para>
      <para>Enter the solution to the equation. </para>
    </problem>
    <solution>
      <para>Correct! \(x=2\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 9.1.3 and 9.1.4.</para>
    </div>
    </exercise>
  <!--Do not edit below this line-->
  <solution> </solution>
  <div class="os-raise-ib-pset-encourage-response"> </div>
</div></section>
</content>
