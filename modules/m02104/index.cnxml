<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Interpreting Equations in Context</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02104</md:content-id>
    <md:title>Interpreting Equations in Context</md:title>
    <md:uuid>a9076baf-0e65-41dd-824d-dc460da14a36</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>
      <para id="para-00001">
          <media alt="A close-up of a roll of vintage-style raffle or event tickets with TICKET and KEEP THIS COUPON printed on them, illuminated by soft, warm light.">
            <image mime-type="image/jpeg" src="../../media/Algebra-1_09_04_02_01.jpg" width="388"/>
          </media>
        
     </para>
      <para id="para-00002">Tickets to a play cost $12, and for each purchase there is a $2.50 fee. The expression <m:math display="inline"><m:mrow><m:mn>12</m:mn><m:mi>t</m:mi><m:mo>+</m:mo><m:mn>2.50</m:mn></m:mrow></m:math> represents the cost to purchase tickets for the play, where <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> is the number of tickets. Be prepared to explain your response to each question.</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00003">A family paid $62.50 for tickets. How many tickets were bought?</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00004">Enter the number of tickets.</para>
          <para id="para-00005">Compare your answer: </para>
          <para id="para-00006">Five tickets were bought. Subtracting 2.50 from 62.50 gives 60. If <m:math display="inline"><m:mrow><m:mn>12</m:mn><m:mi>t</m:mi></m:mrow></m:math> is 60, then <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> is 5.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00007">A teacher paid $278.50 for tickets for her students. How many tickets were bought?</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00008">Enter the number of tickets.</para>
          <para id="para-00009">Compare your answer: </para>
          <para id="para-00010">Twenty-three tickets were bought. Subtracting 2.50 from 278.50 gives 276. If <m:math display="inline"><m:mrow><m:mn>12</m:mn><m:mi>t</m:mi></m:mrow></m:math> is 276, then <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> is 23.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>
