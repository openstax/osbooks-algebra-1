<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Define a Sequence</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01168</md:content-id>
    <md:title>Define a Sequence</md:title>
    <md:uuid>3c65fbac-3a76-4126-aea8-0624d7778c27</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Warm Up</title>
<para id="para-00001">Recall that:</para>
<para id="para-00002">An <term class="glossary-tooltip" id="term-00001">arithmetic sequence</term> is a sequence in which each term is the previous term plus a constant.</para>
<para id="para-00003">A <term class="glossary-tooltip" id="term-00002">geometric sequence</term> is a sequence in which each term is a constant times the previous term.</para>
<para id="para-00004">Use the first 5 terms of each sequence to state if the sequence is arithmetic, geometric, or neither.</para>
<list class="os-raise-noindent" list-type="enumerated" number-style="upper-alpha" id="list-00001">
  <item>
    30, 40, 50, 60, 70, . . .
 </item>
  <item>
    80, 40, 20, 10, 5, 2.5, . . .
 </item>
  <item>
    1, 2, 4, 8, 16, 32, . . .
 </item>
  <item>
    1, <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac></m:mrow></m:math>, . . .
 </item>
  <item>
    20, 13, 6, –1, –8, . . .
 </item>
  <item>
    1, 3, 7, 15, 31, . . .
 </item>
</list>


<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00005">A. 30, 40, 50, 60, 70, . . .</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00006">Compare your answer: </para>
    
    <para id="para-00007">Arithmetic</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00008">B. 80, 40, 20, 10, 5, 2.5, . . .</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00009">Compare your answer: </para>
    
    <para id="para-00010">Geometric</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00011">C. 1, 2, 4, 8, 16, 32, . . .</para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00012">Compare your answer: </para>
    
    <para id="para-00013">Geometric</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00014">D. 1, <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac></m:mrow></m:math>, . . .</para>
    </problem><solution id="sol-00004">
    
    
  
  <para id="para-00015">Compare your answer: </para>
    
    <para id="para-00016">Geometric</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00005">
  <problem id="prob-00005">
    <para id="para-00017">E. 20, 13, 6, –1, –8, . . .</para>
    </problem><solution id="sol-00005">
    
    
  
  <para id="para-00018">Compare your answer: </para>
    
    <para id="para-00019">Arithmetic</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00006">
  <problem id="prob-00006">
    <para id="para-00020">F. 1, 3, 7, 15, 31, . . .</para>
    </problem><solution id="sol-00006">
    
    
  
  <para id="para-00021">Compare your answer: </para>
    
    <para id="para-00022">Neither</para>
  
  </solution></exercise>
<!--Interaction End --></section>
