<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.17.1: Define a Sequence</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01168</md:content-id>
    <md:title>4.17.1: Define a Sequence</md:title>
    <md:uuid>3c65fbac-3a76-4126-aea8-0624d7778c27</md:uuid>
  </metadata>
  <content>
  <section><title>Warm Up Activity</title>
<para>Recall that:</para>
<para>An <term class="glossary-tooltip">arithmetic sequence</term> is a sequence in which each term is the previous term plus a constant.</para>
<para>A <term class="glossary-tooltip">geometric sequence</term> is a sequence in which each term is a constant times the previous term.</para>
<para>Use the first 5 terms of each sequence to state if the sequence is arithmetic, geometric, or neither.</para>
<list class="os-raise-noindent" list-type="enumerated">
  <item>
    30, 40, 50, 60, 70, . . .
 </item>
  <item>
    80, 40, 20, 10, 5, 2.5, . . .
 </item>
  <item>
    1, 2, 4, 8, 16, 32, . . .
 </item>
  <item>
    1, \(\frac12\), \(\frac14\), \(\frac18\), \(\frac{1}{16}\), . . .
 </item>
  <item>
    20, 13, 6, –1, –8, . . .
 </item>
  <item>
    1, 3, 7, 15, 31, . . .
 </item>
</list>


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>30, 40, 50, 60, 70, . . .</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>Arithmetic</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>80, 40, 20, 10, 5, 2.5, . . .</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>Geometric</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>1, 2, 4, 8, 16, 32, . . .</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>Geometric</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>1, \(\frac12\), \(\frac14\), \(\frac18\), \(\frac{1}{16}\), . . .</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>Geometric</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>20, 13, 6, –1, –8, . . .</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>Arithmetic</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>1, 3, 7, 15, 31, . . .</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>Neither</para>
  
  </solution></exercise>
<!--Interaction End --></section>
</content>
