<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.10.7: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00554</md:content-id>
    <md:title>2.10.7: Practice</md:title>
    <md:uuid>4e6ffbc6-e111-46dd-aa1b-26edd3ab6f3e</md:uuid>
  </metadata>
  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson. <emphasis> </emphasis></para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="e12459cb-8557-411e-9745-3baa28c16c41" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0" explain="" or="" reasoning.="" show="" your="">
  <!--Q1-->
  <exercise data-content-id="15b7b257-480b-4055-a9e9-6ce79260cafc" data-problem-comparator="integer" data-problem-type="input" data-solution="20" explain="" or="" reasoning.="" show="" your="">
    <problem>
      <para>1. Xander is loading a pallet with boxes that each weighs 45 pounds. The pallet can safely support no more than 900 pounds. How many boxes can he safely load onto the pallet?____ boxes or less</para>
    </problem>
    <solution>
      <para>Correct! 20</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.10.2. </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q2-->
  <exercise data-content-id="2fa05935-8dc2-4217-8896-72f9156be9f1" data-problem-comparator="integer" data-problem-type="input" data-solution="14" explain="" or="" reasoning.="" show="" your="">
    <problem>
      <para>2. The elevator in Yehire’s apartment building has a sign that says the maximum weight is 2100 pounds. If the average weight of one person is 150 pounds, how many people can safely ride the elevator?
        a maximum of ___ people
      </para>
    </problem>
    <solution>
      <para>Correct! 14</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.10.2. </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q3-->
  <exercise data-content-id="48ad04c3-a04c-4f81-b9f5-5e7b0acdff38" data-problem-comparator="integer" data-problem-type="input" data-solution="590">
    <problem>
      <para>3. Jaden is looking at apartments with three of his friends. They want the monthly rent to be no more than $2360. If the roommates split the rent evenly among the four of them, what is the maximum rent each will pay?
        $____
      </para>
    </problem>
    <solution>
      <para>Correct! 590</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.10.2. </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q4-->
  <exercise data-content-id="7d241ae8-5bad-435e-8aef-eb5e84781416" data-problem-comparator="integer" data-problem-type="input" data-solution="5">
    <problem>
      <para>4. Melody got a $20 gift card for the coffee shop. Her favorite iced drink costs $3.79. What is the maximum number of drinks she can buy with the gift card?
        ____ drinks
      </para>
    </problem>
    <solution>
      <para>Correct! 5</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.10.2. </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q5-->
  <exercise data-content-id="39730d15-37e4-4f6b-90f3-cd46b7260741" data-problem-comparator="integer" data-problem-type="input" data-solution="5">
    <problem>
      <para>5. Teegan likes to play golf. He has budgeted $60 next month for the driving range. It costs him $10.55 for a bucket of balls each time he goes. What is the maximum number of times he can go to the driving range next month?
        ____ times
      </para>
    </problem>
    <solution>
      <para>Correct! 5</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.10.2. </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q6-->
  <exercise data-content-id="55b9d39b-3707-4035-b44f-34aee7584723" data-problem-comparator="integer" data-problem-type="input" data-solution="86">
    <problem>
      <para>6. Ryan charges his neighbors $17.50 to wash their car. How many cars must he wash next summer if his goal is to earn at least $1500?

        ____ cars
      </para>
    </problem>
    <solution>
      <para>Correct! 86</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.10.2. </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q7-->
  <exercise data-content-id="3973a4a2-3e42-4e3e-9bdb-7902568e1d43" data-problem-comparator="integer" data-problem-type="input" data-solution="16">
    <problem>
      <para>7. Alejandro’s water bill is $24.80 per month plus $2.20 per ccf (hundred cubic feet) of water. What is the maximum number of ccf Alejandro can use if he wants his bill to be no more than $60?

        ____ ccf
      </para>
    </problem>
    <solution>
      <para>Correct! 16</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.10.2. </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q8-->
  <exercise data-content-id="5b8372d5-500a-451c-8414-3a6ed0920e4c" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="If \(m\) is a negative number, then \(14 − 2m\) will always be negative." data-solution-options="[&quot;If \\(m\\) is a negative number, then \\(5m + 6\\) could be a positive or negative number.&quot;, &quot;If \\(m\\) is a negative number, then \\(14 − 2m\\) will always be positive.&quot;, &quot;If \\(m\\) is a positive number, then \\(5m + 6\\) will always be positive.&quot;, &quot;If \\(m\\) is a negative number, then \\(14 − 2m\\) will always be negative.&quot;]">
    <problem>
      <para>8. Look at the inequality \(5m + 6 &lt; 14 − 2m\). Which of the following is NOT true?</para>
    </problem>
    <solution>
      <para>Correct! If m is a negative number, then \(14 − 2m\) will always be negative
      </para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.10.3
      </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q9-->
  <exercise data-content-id="4a39ec82-5ca4-4e83-98c4-ce7e20d81106" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x &gt; -20\)" data-solution-options="[&quot;\\(x &gt; -20\\)&quot;, &quot;\\(x &gt; 20\\)&quot;, &quot;\\(x &gt; -4\\)&quot;, &quot;\\(x &gt; 4\\)&quot;]">
    <problem>
      <para>9. Solve the inequality: \(x + 8 &gt; –12\)</para>
    </problem>
    <solution>
      <para>Correct! x &gt; -20</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.10.5. </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q10-->
  <exercise data-content-id="151484b4-33c9-47f1-bba8-a13ea0c06711" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x &lt; 12\)" data-solution-options="[&quot;\\(x &lt; 18\\)&quot;, &quot;\\(x &lt; –12\\)&quot;, &quot;\\(x &lt; 12\\)&quot;, &quot;\\(x &lt; –18\\)&quot;]">
    <problem>
      <para>10. Solve the inequality: \(x – 15 &lt;–3\)</para>
    </problem>
    <solution>
      <para>Correct! \(x &lt; 12\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.10.5. </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q11-->
  <exercise data-content-id="25e20b7e-f2e0-4d27-a5f8-83e5897771b6" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x\;\leq\;4\)" data-solution-options="[&quot;\\(x\\;\\geq\\;4\\)&quot;, &quot;\\(x\\;\\leq\\;-4\\)&quot;, &quot;\\(x\\;\\leq\\;42\\)&quot;, &quot;\\(x\\;\\leq\\;4\\)&quot;]">
    <problem>
      <para>11. Solve the inequality: \(x\;+\;19\;\leq\;23\)</para>
    </problem>
    <solution>
      <para>Correct! \(x\;\leq\;4\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.10.5. </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q12-->
  <exercise data-content-id="0792ba8c-1bf4-4a75-8a9d-8685b9f5df6e" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x &lt; -8\)" data-solution-options="[&quot;\\(x &gt; -8\\)&quot;, &quot;\\(x &lt; -8\\)&quot;, &quot;\\(x &lt; -63\\)&quot;, &quot;\\(x &lt; -49\\)&quot;]">
    <problem>
      <para>12. Solve the inequality: \(7x &lt; –56\)</para>
    </problem>
    <solution>
      <para>Correct! \(x &lt; -8\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.10.5 </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q13-->
  <exercise data-content-id="35a543cc-10ae-41fc-b50a-53ab41301600" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x\;\leq\;5\)" data-solution-options="[&quot;\\(x\\;\\leq\\;\\frac52\\)&quot;, &quot;\\(x\\;\\leq\\;5\\)&quot;, &quot;\\(x\\;\\leq\\;2\\)&quot;, &quot;\\(x\\;\\geq\\;5\\)&quot;]">
    <problem>
      <para>13. Solve the inequality: \(\frac x2\;\;\leq\;\frac52\)</para>
    </problem>
    <solution>
      <para>Correct! \(x\;\;\leq\;5\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.10.5 </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q14-->
  <exercise data-content-id="a721f6ea-12af-448e-9c3e-c8116641b0e6" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x &lt; -7\)" data-solution-options="[&quot;\\(x &lt; 18\\)&quot;, &quot;\\(x &lt; -24\\)&quot;, &quot;\\(x &gt; -7\\)&quot;, &quot;\\(x &lt; -7\\)&quot;]">
    <problem>
      <para>14. Solve the inequality: \(-3x &gt; 21\)</para>
    </problem>
    <solution>
      <para>Correct! \(x &lt; -7\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.10.5 </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
