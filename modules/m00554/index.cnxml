                  <para id="para-00076">Try again. Revisit activity 2.10.5</para>
                  <para id="para-00077">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>&lt;</m:mo><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow></m:math>. <m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>&lt;</m:mo><m:mi>–</m:mi><m:mn>56</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>&lt;</m:mo><m:mi>–</m:mi><m:mn>56</m:mn></m:mrow></m:math>
                     <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>7</m:mn><m:mi>x</m:mi></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac><m:mo>&lt;</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>56</m:mn></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>7</m:mn><m:mi>x</m:mi></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac><m:mo>&lt;</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>56</m:mn></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac></m:mrow></m:math>
                     <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mo>&lt;</m:mo><m:mn>8</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mo>&lt;</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
               </solution>
            </exercise>
            <exercise id="_35a543cc-10ae-41fc-b50a-53ab41301600" class="multiple-choice">
               <problem id="prob-00013">
                  <para id="para-00078">Solve the inequality: <m:math display="inline"><m:mrow><m:mfrac><m:mi>x</m:mi><m:mn>2</m:mn></m:mfrac><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
