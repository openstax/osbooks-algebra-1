            <exercise id="_25e20b7e-f2e0-4d27-a5f8-83e5897771b6" class="multiple-choice">
               <problem id="prob-00011">
                  <para id="para-00060">Solve the inequality: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>19</m:mn><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>23</m:mn></m:mrow></m:math></para>
                  <para id="para-00061">Multiple Choice:</para>
                  <para id="para-00062"><m:math><m:mrow><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>≥</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00063"><m:math><m:mrow><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00064"><m:math><m:mrow><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>42</m:mn></m:mrow></m:math></para><para id="para-00065"><m:math><m:mrow><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn></m:mrow></m:math></para></problem>
               <solution id="sol-00011">
                  <para id="para-00066">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn></m:mrow></m:math></para>
                  <para id="para-00067">Try again. Revisit activity 2.10.5.</para>
                  <para id="para-00068">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn></m:mrow></m:math>. <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>19</m:mn><m:mo>≤</m:mo><m:mn>23</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>19</m:mn><m:mo>≤</m:mo><m:mn>23</m:mn></m:mrow></m:math>
                     <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>19</m:mn><m:mo>−</m:mo><m:mn>19</m:mn><m:mo>≤</m:mo><m:mn>23</m:mn><m:mo>−</m:mo><m:mn>19</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>19</m:mn><m:mo>−</m:mo><m:mn>19</m:mn><m:mo>≤</m:mo><m:mn>23</m:mn><m:mo>−</m:mo><m:mn>19</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>24</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>24</m:mn></m:mrow></m:math></para>
               </solution>
            </exercise>
