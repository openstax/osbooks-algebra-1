<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.1.3: Using Zero Exponent Property and Negative Exponents</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01239</md:content-id>
    <md:title>5.1.3: Using Zero Exponent Property and Negative Exponents</md:title>
    <md:uuid>35d88fe6-361c-4a0f-8512-38e964310716</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <title>Activity</title>

      <note id="note-00003">
        <para id="para-00001"><emphasis>Zero Exponent Property</emphasis></para>
  
  <para
          id="para-00002">If <m:math display="inline">
            <m:mrow>
              <m:mi>a</m:mi>
            </m:mrow>
          </m:math> is a non-zero number, then <m:math
            display="inline">
            <m:mrow>
              <m:msup>
                <m:mi>a</m:mi>
                <m:mn>0</m:mn>
              </m:msup>
              <m:mo>=</m:mo>
              <m:mn>1</m:mn>
            </m:mrow>
          </m:math>.</para>
  <para id="para-00003">If <m:math
            display="inline">
            <m:mrow>
              <m:mi>a</m:mi>
            </m:mrow>
          </m:math> is a non-zero number, then <m:math
            display="inline">
            <m:mrow>
              <m:mi>a</m:mi>
            </m:mrow>
          </m:math> to the power of zero equals 1.</para>
  <para
          id="para-00004">Any non-zero number raised to the zero power is 1.</para>
      </note>

      <para id="para-00005">Complete problems 1 - 6 using the product property for exponents. Double
        click on mathematical expressions/equations to enlarge.</para>
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00006"><m:math>
              <m:mrow>
                <m:msup>
                  <m:mi>d</m:mi>
                  <m:mn>0</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00001">


          <para id="para-00007">Compare your answer:</para>

          <para id="para-00008"><m:math>
              <m:mrow>
                <m:mn>1</m:mn>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00009"><m:math>
              <m:mrow>
                <m:msup>
                  <m:mn>7</m:mn>
                  <m:mn>0</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00002">


          <para id="para-00010">Compare your answer:</para>

          <para id="para-00011"><m:math>
              <m:mrow>
                <m:mn>1</m:mn>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00012"><m:math>
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>−</m:mo>
                <m:mn>8</m:mn>
                <m:msup>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mn>0</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00003">


          <para id="para-00013">Compare your answer:</para>

          <para id="para-00014"><m:math>
              <m:mrow>
                <m:mn>1</m:mn>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00015"><m:math>
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>−</m:mo>
                <m:mi>v</m:mi>
                <m:msup>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mn>0</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00004">


          <para id="para-00016">Compare your answer:</para>

          <para id="para-00017"><m:math>
              <m:mrow>
                <m:mn>1</m:mn>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <exercise id="exer-00005">
        <problem id="prob-00005">
          <para id="para-00018"><m:math>
              <m:mrow>
                <m:msup>
                  <m:mi>r</m:mi>
                  <m:mn>0</m:mn>
                </m:msup>
                <m:mi>·</m:mi>
                <m:msup>
                  <m:mi>r</m:mi>
                  <m:mn>0</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00005">


          <para id="para-00019">Compare your answer:</para>

          <para id="para-00020"><m:math>
              <m:mrow>
                <m:mn>1</m:mn>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <note id="note-00004">
        <para id="para-00021"><emphasis>Definition of a Negative Exponent</emphasis></para>
  
  <para
          id="para-00022">If <m:math display="inline">
            <m:mrow>
              <m:mi>n</m:mi>
            </m:mrow>
          </m:math> is an integer and <m:math
            display="inline">
            <m:mrow>
              <m:mi>a</m:mi>
              <m:mo>≠</m:mo>
              <m:mn>0</m:mn>
            </m:mrow>
          </m:math>, then <m:math display="inline">
            <m:mrow>
              <m:msup>
                <m:mi>a</m:mi>
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mi>n</m:mi>
                </m:mrow>
              </m:msup>
              <m:mo>=</m:mo>
              <m:mfrac>
                <m:mrow>
                  <m:mn>1</m:mn>
                </m:mrow>
                <m:mrow>
                  <m:msup>
                    <m:mi>a</m:mi>
                    <m:mi>n</m:mi>
                  </m:msup>
                </m:mrow>
              </m:mfrac>
            </m:mrow>
          </m:math>
        .</para>
      </note>

      <para id="para-00023">Complete problems 6 - 10 using the product property for exponents.
        Double click on mathematical expressions/equations to enlarge.</para>
      <exercise id="exer-00006">
        <problem id="prob-00006">
          <para id="para-00024"><m:math>
              <m:mrow>
                <m:msup>
                  <m:mi>g</m:mi>
                  <m:mrow>
                    <m:mo>−</m:mo>
                    <m:mn>4</m:mn>
                  </m:mrow>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00006">


          <para id="para-00025">Compare your answer:</para>

          <para id="para-00026"><m:math>
              <m:mrow>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>1</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:msup>
                      <m:mi>g</m:mi>
                      <m:mn>4</m:mn>
                    </m:msup>
                  </m:mrow>
                </m:mfrac>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <exercise id="exer-00007">
        <problem id="prob-00007">
          <para id="para-00027"><m:math>
              <m:mrow>
                <m:msup>
                  <m:mn>2</m:mn>
                  <m:mrow>
                    <m:mo>−</m:mo>
                    <m:mn>3</m:mn>
                  </m:mrow>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00007">


          <para id="para-00028">Compare your answer:</para>

          <para id="para-00029"><m:math display="inline">
              <m:mrow>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>1</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:msup>
                      <m:mn>2</m:mn>
                      <m:mn>3</m:mn>
                    </m:msup>
                  </m:mrow>
                </m:mfrac>
              </m:mrow>
            </m:math>
            or <m:math display="inline">
              <m:mrow>
                <m:mfrac>
                  <m:mn>1</m:mn>
                  <m:mn>8</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math></para>

        </solution>
      </exercise>
      <exercise id="exer-00008">
        <problem id="prob-00008">
          <para id="para-00030"><m:math>
              <m:mrow>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>1</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:msup>
                      <m:mi>c</m:mi>
                      <m:mrow>
                        <m:mo>−</m:mo>
                        <m:mn>2</m:mn>
                      </m:mrow>
                    </m:msup>
                  </m:mrow>
                </m:mfrac>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00008">


          <para id="para-00031">Compare your answer:</para>

          <para id="para-00032"><m:math>
              <m:mrow>
                <m:msup>
                  <m:mi>c</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <exercise id="exer-00009">
        <problem id="prob-00009">
          <para id="para-00033"><m:math>
              <m:mrow>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>1</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mo>−</m:mo>
                    <m:mi>h</m:mi>
                    <m:msup>
                      <m:mo stretchy="false">)</m:mo>
                      <m:mrow>
                        <m:mo>−</m:mo>
                        <m:mn>6</m:mn>
                      </m:mrow>
                    </m:msup>
                  </m:mrow>
                </m:mfrac>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00009">


          <para id="para-00034">Compare your answer:</para>

          <para id="para-00035"><m:math>
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>−</m:mo>
                <m:mi>h</m:mi>
                <m:msup>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mn>6</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <exercise id="exer-00010">
        <problem id="prob-00010">
          <para id="para-00036"><m:math>
              <m:mrow>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>1</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:msup>
                      <m:mn>4</m:mn>
                      <m:mrow>
                        <m:mo>−</m:mo>
                        <m:mn>3</m:mn>
                      </m:mrow>
                    </m:msup>
                  </m:mrow>
                </m:mfrac>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00010">


          <para id="para-00037">Compare your answer:</para>

          <para id="para-00038"><m:math display="inline">
              <m:mrow>
                <m:msup>
                  <m:mn>4</m:mn>
                  <m:mn>3</m:mn>
                </m:msup>
              </m:mrow>
            </m:math>
            or <m:math display="inline">
              <m:mrow>
                <m:mn>64</m:mn>
              </m:mrow>
            </m:math></para>

        </solution>
      </exercise>
    </section>
    <note class="self-check" id="note-00005">
      <exercise id="exer-00012">
        <problem id="prob-00012">
          <para id="para-00039"><link class="os-embed" url="#exercise/Alg1_5_1_3_SC" /></para>
        </problem>
      </exercise>
    </note>

    <section id="sect-00002">
      <title>Additional Resources</title>

      <section id="sect-00003">
        <title>Using the Zero Exponent Property</title>
        <para id="para-00040">A special case of the Quotient Property is when the exponents of the
          numerator and denominator are equal, such as an expression like <m:math display="inline">
            <m:mrow>
              <m:mfrac>
                <m:mrow>
                  <m:msup>
                    <m:mi>a</m:mi>
                    <m:mi>m</m:mi>
                  </m:msup>
                </m:mrow>
                <m:mrow>
                  <m:msup>
                    <m:mi>a</m:mi>
                    <m:mi>m</m:mi>
                  </m:msup>
                </m:mrow>
              </m:mfrac>
            </m:mrow>
          </m:math>.
          We know <m:math display="inline">
            <m:mrow>
              <m:mfrac>
                <m:mrow>
                  <m:mi>x</m:mi>
                </m:mrow>
                <m:mrow>
                  <m:mi>x</m:mi>
                </m:mrow>
              </m:mfrac>
              <m:mo>=</m:mo>
              <m:mn>1</m:mn>
            </m:mrow>
          </m:math> for any <m:math
            display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
            </m:mrow>
          </m:math> (<m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
              <m:mo>≠</m:mo>
              <m:mn>0</m:mn>
            </m:mrow>
          </m:math>) since any number divided by
          itself is 1. The Quotient Property for Exponents shows us how to simplify <m:math
            display="inline">
            <m:mrow>
              <m:mfrac>
                <m:mrow>
                  <m:msup>
                    <m:mi>a</m:mi>
                    <m:mi>m</m:mi>
                  </m:msup>
                </m:mrow>
                <m:mrow>
                  <m:msup>
                    <m:mi>a</m:mi>
                    <m:mi>m</m:mi>
                  </m:msup>
                </m:mrow>
              </m:mfrac>
            </m:mrow>
          </m:math>
           when <m:math display="inline">
            <m:mrow>
              <m:mi>m</m:mi>
              <m:mo>></m:mo>
              <m:mi>n</m:mi>
            </m:mrow>
          </m:math> and when <m:math
            display="inline">
            <m:mrow>
              <m:mi>n</m:mi>
              <m:mo>&lt;</m:mo>
              <m:mi>m</m:mi>
            </m:mrow>
          </m:math> by subtracting exponents. What
          if <m:math display="inline">
            <m:mrow>
              <m:mi>m</m:mi>
              <m:mo>=</m:mo>
              <m:mi>n</m:mi>
            </m:mrow>
          </m:math>? We will simplify <m:math
            display="inline">
            <m:mrow>
              <m:mfrac>
                <m:mrow>
                  <m:msup>
                    <m:mi>a</m:mi>
                    <m:mi>m</m:mi>
                  </m:msup>
                </m:mrow>
                <m:mrow>
                  <m:msup>
                    <m:mi>a</m:mi>
                    <m:mi>m</m:mi>
                  </m:msup>
                </m:mrow>
              </m:mfrac>
            </m:mrow>
          </m:math>
          in two ways to lead us to the definition of the <term class="glossary-tooltip"
            id="term-00001">Zero Exponent Property</term>. In general, for <m:math display="inline">
            <m:mrow>
              <m:mi>a</m:mi>
              <m:mo>≠</m:mo>
              <m:mn>0</m:mn>
            </m:mrow>
          </m:math>:</para>
        <para id="para-00041">

          <media alt="">
            <image mime-type="image/jpeg" src="../../media/Algebra-1_05_03_08_01.jpg" width="300" />
          </media>

        </para>
        <note id="note-00001">
          <para id="para-00042"><emphasis>Zero Exponent Property</emphasis></para>
      
      <para
            id="para-00043">If <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
              </m:mrow>
            </m:math> is a non-zero number,
          then <m:math display="inline">
              <m:mrow>
                <m:msup>
                  <m:mi>a</m:mi>
                  <m:mn>0</m:mn>
                </m:msup>
                <m:mo>=</m:mo>
                <m:mn>1</m:mn>
              </m:mrow>
            </m:math>.</para>
      <para
            id="para-00044">If <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
              </m:mrow>
            </m:math> is a non-zero number,
          then <m:math display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
              </m:mrow>
            </m:math> to the power of zero
          equals 1.</para>
      <para id="para-00045">Any non-zero number raised to the zero power is 1.</para>
        </note>
      </section>
      <section id="sect-00004">
        <title>Using the Definition of a Negative Exponent</title>
        <para id="para-00046">We saw that the Quotient Property for Exponents has two forms
          depending on whether the exponent is larger in the numerator or the denominator. What if
          we just subtract exponents regardless of which is larger?</para>
        <para id="para-00047">Let’s consider <m:math display="inline">
            <m:mrow>
              <m:mfrac>
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                </m:mrow>
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>5</m:mn>
                  </m:msup>
                </m:mrow>
              </m:mfrac>
            </m:mrow>
          </m:math>.
          We subtract the exponent in the denominator from the exponent in the numerator. We see <m:math
            display="inline">
            <m:mrow>
              <m:mfrac>
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                </m:mrow>
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>5</m:mn>
                  </m:msup>
                </m:mrow>
              </m:mfrac>
            </m:mrow>
          </m:math>
          is <m:math display="inline">
            <m:mrow>
              <m:msup>
                <m:mi>x</m:mi>
                <m:mrow>
                  <m:mn>2</m:mn>
                  <m:mo>−</m:mo>
                  <m:mn>5</m:mn>
                </m:mrow>
              </m:msup>
            </m:mrow>
          </m:math>
          or <m:math display="inline">
            <m:mrow>
              <m:msup>
                <m:mi>x</m:mi>
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:msup>
            </m:mrow>
          </m:math>
          .</para>
        <para id="para-00048">We can also simplify <m:math display="inline">
            <m:mrow>
              <m:mfrac>
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                </m:mrow>
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>5</m:mn>
                  </m:msup>
                </m:mrow>
              </m:mfrac>
            </m:mrow>
          </m:math>
          by dividing out common factors:</para>
        <para id="para-00049"><m:math>
            <m:mrow>
              <m:mfrac>
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                </m:mrow>
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>5</m:mn>
                  </m:msup>
                </m:mrow>
              </m:mfrac>
            </m:mrow>
          </m:math></para>
        <para id="para-00050"><m:math>
            <m:mfrac>
              <m:mrow>
                <m:menclose notation="updiagonalstrike">
                  <m:mi>x</m:mi>
                </m:menclose>
                <m:mo> </m:mo>
                <m:mo>·</m:mo>
                <m:mo> </m:mo>
                <m:menclose notation="updiagonalstrike">
                  <m:mi>x</m:mi>
                </m:menclose>
              </m:mrow>
              <m:mrow>
                <m:menclose notation="updiagonalstrike">
                  <m:mi>x</m:mi>
                </m:menclose>
                <m:mo>·</m:mo>
                <m:menclose notation="updiagonalstrike">
                  <m:mi>x</m:mi>
                </m:menclose>
                <m:mo>·</m:mo>
                <m:mi>x</m:mi>
                <m:mo>·</m:mo>
                <m:mi>x</m:mi>
                <m:mo>·</m:mo>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:mfrac>
          </m:math></para>
        <para id="para-00051"><m:math>
            <m:mrow>
              <m:mfrac>
                <m:mrow>
                  <m:mn>1</m:mn>
                </m:mrow>
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>3</m:mn>
                  </m:msup>
                </m:mrow>
              </m:mfrac>
            </m:mrow>
          </m:math></para>
        <para id="para-00052">This implies that <m:math display="inline">
            <m:mrow>
              <m:msup>
                <m:mi>x</m:mi>
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:msup>
              <m:mo>=</m:mo>
              <m:mfrac>
                <m:mrow>
                  <m:mn>1</m:mn>
                </m:mrow>
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>3</m:mn>
                  </m:msup>
                </m:mrow>
              </m:mfrac>
            </m:mrow>
          </m:math>,
          and it leads us to the definition of a <emphasis>negative exponent</emphasis>. If <m:math
            display="inline">
            <m:mrow>
              <m:mi>n</m:mi>
            </m:mrow>
          </m:math> is an integer and <m:math
            display="inline">
            <m:mrow>
              <m:mi>a</m:mi>
              <m:mo>≠</m:mo>
              <m:mn>0</m:mn>
            </m:mrow>
          </m:math>, then <m:math display="inline">
            <m:mrow>
              <m:msup>
                <m:mi>a</m:mi>
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mi>n</m:mi>
                </m:mrow>
              </m:msup>
              <m:mo>=</m:mo>
              <m:mfrac>
                <m:mrow>
                  <m:mn>1</m:mn>
                </m:mrow>
                <m:mrow>
                  <m:msup>
                    <m:mi>a</m:mi>
                    <m:mi>n</m:mi>
                  </m:msup>
                </m:mrow>
              </m:mfrac>
            </m:mrow>
          </m:math>
          .</para>
        <para id="para-00053">Let’s now look at what happens to a fraction whose numerator is one
          and whose denominator is an integer raised to a negative exponent.</para>
        <para id="para-00054"><m:math>
            <m:mrow>
              <m:mfrac>
                <m:mrow>
                  <m:mn>1</m:mn>
                </m:mrow>
                <m:mrow>
                  <m:msup>
                    <m:mi>a</m:mi>
                    <m:mrow>
                      <m:mi>−</m:mi>
                      <m:mi>n</m:mi>
                    </m:mrow>
                  </m:msup>
                </m:mrow>
              </m:mfrac>
            </m:mrow>
          </m:math></para>
        <para id="para-00055"><emphasis>Step 1 -</emphasis> Use the definition of a negative
          exponent, <m:math display="inline">
            <m:mrow>
              <m:msup>
                <m:mi>a</m:mi>
                <m:mrow>
                  <m:mi>−</m:mi>
                  <m:mi>n</m:mi>
                </m:mrow>
              </m:msup>
              <m:mo>=</m:mo>
              <m:mfrac>
                <m:mrow>
                  <m:mn>1</m:mn>
                </m:mrow>
                <m:mrow>
                  <m:msup>
                    <m:mi>a</m:mi>
                    <m:mi>n</m:mi>
                  </m:msup>
                </m:mrow>
              </m:mfrac>
            </m:mrow>
          </m:math>
          .
<m:math display="inline">
            <m:mrow>
              <m:mfrac>
                <m:mrow>
                  <m:mn>1</m:mn>
                </m:mrow>
                <m:mrow>
                  <m:mfrac>
                    <m:mrow>
                      <m:mn>1</m:mn>
                    </m:mrow>
                    <m:mrow>
                      <m:msup>
                        <m:mi>a</m:mi>
                        <m:mi>n</m:mi>
                      </m:msup>
                    </m:mrow>
                  </m:mfrac>
                </m:mrow>
              </m:mfrac>
            </m:mrow>
          </m:math></para>
        <para id="para-00056"><emphasis>Step 2 -</emphasis> Simplify the complex fraction.</para> 
        <para><m:math
            display="inline">
            <m:mrow>
              <m:mn>1</m:mn>
              <m:mi>·</m:mi>
              <m:mfrac>
                <m:mrow>
                  <m:msup>
                    <m:mi>a</m:mi>
                    <m:mi>n</m:mi>
                  </m:msup>
                </m:mrow>
                <m:mrow>
                  <m:mn>1</m:mn>
                </m:mrow>
              </m:mfrac>
            </m:mrow>
          </m:math>
        </para>
        <para id="para-00057"><emphasis>Step 3 -</emphasis> Multiply.</para> 
        <para><m:math display="inline">
            <m:mrow>
              <m:msup>
                <m:mi>a</m:mi>
                <m:mi>n</m:mi>
              </m:msup>
            </m:mrow>
          </m:math></para>
        <para id="para-00058">This implies <m:math display="inline">
            <m:mrow>
              <m:mfrac>
                <m:mrow>
                  <m:mn>1</m:mn>
                </m:mrow>
                <m:mrow>
                  <m:msup>
                    <m:mi>a</m:mi>
                    <m:mrow>
                      <m:mo>−</m:mo>
                      <m:mi>n</m:mi>
                    </m:mrow>
                  </m:msup>
                </m:mrow>
              </m:mfrac>
              <m:mo>=</m:mo>
              <m:msup>
                <m:mi>a</m:mi>
                <m:mi>n</m:mi>
              </m:msup>
            </m:mrow>
          </m:math> and is
          another form of the definition of <term class="glossary-tooltip" id="term-00002">Properties
          of Negative Exponents</term>.</para>
        <note id="note-00002">
          <para id="para-00059"><emphasis>Properties of Negative Exponents</emphasis></para>
      
      <para id="para-00060">If <m:math
              display="inline">
              <m:mrow>
                <m:mi>n</m:mi>
              </m:mrow>
            </m:math> is an integer and <m:math
              display="inline">
              <m:mrow>
                <m:mi>a</m:mi>
                <m:mo>≠</m:mo>
                <m:mn>0</m:mn>
              </m:mrow>
            </m:math>, then <m:math
              display="inline">
              <m:mrow>
                <m:msup>
                  <m:mi>a</m:mi>
                  <m:mrow>
                    <m:mi>−</m:mi>
                    <m:mi>n</m:mi>
                  </m:mrow>
                </m:msup>
                <m:mo>=</m:mo>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>1</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:msup>
                      <m:mi>a</m:mi>
                      <m:mi>n</m:mi>
                    </m:msup>
                  </m:mrow>
                </m:mfrac>
              </m:mrow>
            </m:math>
          or <m:math display="inline">
              <m:mrow>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>1</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:msup>
                      <m:mi>a</m:mi>
                      <m:mrow>
                        <m:mi>−</m:mi>
                        <m:mi>n</m:mi>
                      </m:mrow>
                    </m:msup>
                  </m:mrow>
                </m:mfrac>
                <m:mo>=</m:mo>
                <m:msup>
                  <m:mi>a</m:mi>
                  <m:mi>n</m:mi>
                </m:msup>
              </m:mrow>
            </m:math>
          .</para>
        </note>
        <para id="para-00061">The negative exponent tells us we can rewrite the expression by taking
          the reciprocal of the base and then changing the sign of the exponent.</para>
        <para id="para-00062">Any expression that has negative exponents is not considered to be in
          simplest form. We will use the definition of a negative exponent and other properties for
          exponents to write the expression with only positive exponents.</para>
        <para id="para-00063">For example, if after simplifying an expression we end up with the
          expression <m:math display="inline">
            <m:mrow>
              <m:msup>
                <m:mi>x</m:mi>
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:msup>
            </m:mrow>
          </m:math>,
          we will take one more step and write <m:math display="inline">
            <m:mrow>
              <m:mfrac>
                <m:mrow>
                  <m:mn>1</m:mn>
                </m:mrow>
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>3</m:mn>
                  </m:msup>
                </m:mrow>
              </m:mfrac>
            </m:mrow>
          </m:math>.
          The answer is considered to be in simplest form when it has only positive exponents.</para>
        <note class="try" id="note-00006">
          <title>Try It: Using the Zero Exponent Property and Negative Exponents</title>
    <para
            id="para-00064">Simplify each expression.</para>
    
      <exercise id="exer-00011">
            <problem id="prob-00011">
              <para id="para-00065"><m:math>
                  <m:mrow>
                    <m:msup>
                      <m:mi>h</m:mi>
                      <m:mn>0</m:mn>
                    </m:msup>
                  </m:mrow>
                </m:math></para>
              <para id="para-00066"><m:math display="inline">
                  <m:mrow>
                    <m:msup>
                      <m:mn>7</m:mn>
                      <m:mn>0</m:mn>
                    </m:msup>
                  </m:mrow>
                </m:math></para>
              <para id="para-00067"><m:math>
                  <m:mrow>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mo>−</m:mo>
                    <m:mi>g</m:mi>
                    <m:msup>
                      <m:mo stretchy="false">)</m:mo>
                      <m:mn>0</m:mn>
                    </m:msup>
                  </m:mrow>
                </m:math></para>
              <para id="para-00068"><m:math display="inline">
                  <m:mrow>
                    <m:msup>
                      <m:mi>a</m:mi>
                      <m:mrow>
                        <m:mo>−</m:mo>
                        <m:mn>4</m:mn>
                      </m:mrow>
                    </m:msup>
                  </m:mrow>
                </m:math></para>
              <para id="para-00069"><m:math>
                  <m:mrow>
                    <m:msup>
                      <m:mn>9</m:mn>
                      <m:mrow>
                        <m:mo>−</m:mo>
                        <m:mn>3</m:mn>
                      </m:mrow>
                    </m:msup>
                  </m:mrow>
                </m:math></para>
              <para id="para-00070"><m:math display="inline">
                  <m:mrow>
                    <m:mfrac>
                      <m:mrow>
                        <m:mn>1</m:mn>
                      </m:mrow>
                      <m:mrow>
                        <m:msup>
                          <m:mi>n</m:mi>
                          <m:mrow>
                            <m:mo>−</m:mo>
                            <m:mn>5</m:mn>
                          </m:mrow>
                        </m:msup>
                      </m:mrow>
                    </m:mfrac>
                  </m:mrow>
                </m:math></para>
              <para id="para-00071">Write down your answers. Then select the <emphasis>solution</emphasis>
          button to compare your work.</para>
            </problem>
            <solution id="sol-00011">
              <para id="para-00072">Compare your answers:</para>
              <para id="para-00073">Here is how to simplify the expressions:</para>
              <list class="os-raise-noindent" list-type="enumerated" id="list-00001">
                <item>1</item>
                <item>1</item>
                <item>1</item>
                <item><m:math>
                    <m:mrow>
                      <m:mfrac>
                        <m:mrow>
                          <m:mn>1</m:mn>
                        </m:mrow>
                        <m:mrow>
                          <m:msup>
                            <m:mi>a</m:mi>
                            <m:mn>4</m:mn>
                          </m:msup>
                        </m:mrow>
                      </m:mfrac>
                    </m:mrow>
                  </m:math></item>
                <item><m:math>
                    <m:mrow>
                      <m:mfrac>
                        <m:mrow>
                          <m:mn>1</m:mn>
                        </m:mrow>
                        <m:mrow>
                          <m:msup>
                            <m:mn>9</m:mn>
                            <m:mn>3</m:mn>
                          </m:msup>
                        </m:mrow>
                      </m:mfrac>
                      <m:mo>=</m:mo>
                      <m:mfrac>
                        <m:mrow>
                          <m:mn>1</m:mn>
                        </m:mrow>
                        <m:mrow>
                          <m:mn>729</m:mn>
                        </m:mrow>
                      </m:mfrac>
                    </m:mrow>
                  </m:math></item>
                <item><m:math>
                    <m:mrow>
                      <m:msup>
                        <m:mi>n</m:mi>
                        <m:mn>5</m:mn>
                      </m:msup>
                    </m:mrow>
                  </m:math></item>
              </list>
            </solution>
          </exercise>
        </note>
      </section>
    </section>

  </content>
</document>