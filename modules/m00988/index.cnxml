      <!--Interaction End -->
            <exercise id="exer-00010">
        <problem id="prob-00010"><list class="os-raise-noindent" list-type="enumerated" id="list-00004">
        <item>Which statements are true?
    <list class="os-raise-noindent" list-type="enumerated" type="lower-alpha" id="list-00005"><item>All three functions are linear functions.</item><item>All three functions have the same rate of change.</item><item>All three functions have a constant rate of change.</item></list>
 </item>
      </list>
      <!--Text Entry Interaction Start -->

  </problem>
        <solution id="sol-00010">
          
          <para id="para-00030">Compare your answer:</para>
          <para id="para-00031">a, c</para>
        </solution>
      </exercise>
      <!--Interaction End -->
           <exercise id="exer-00011">
        <problem id="prob-00011"> 
        <para id="para-00032">Who has the most money after 30 days? Explain how you know.</para>
      <!--Text Entry Interaction Start -->

  </problem>
        <solution id="sol-00011">
          
          <para id="para-00033">Compare your answers:</para>
          <para id="para-00034">Adam; Adam’s function is \(A(30)=3(30)+3=93\); Bianca’s function is \(B(30)=3(30)+2=92\); Carmen’s function is \(C(30)=2(30)+30=90\).</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>

  <note class="self-check" id="note-00001"><para id="para-00035">What is the average rate of change for the linear function?</para> 
