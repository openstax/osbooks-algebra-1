      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00009">
        <problem id="prob-00009">
          <para id="para-00027">between 1 and 4 days</para>
          
        </problem>
        <solution id="sol-00009">
          <para id="para-00028">Compare your answer:</para>
