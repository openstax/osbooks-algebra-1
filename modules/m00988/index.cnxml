      <list class="os-raise-noindent" list-type="enumerated">
        <item>Who has the most money after 30 days? Explain how you know.</item>
      </list>
      <!--Text Entry Interaction Start -->
      <exercise>
        <problem>
  </problem>
        <solution>
          
          <para>Compare your answers:</para>
          <para>Adam; Adam’s function is \(A(30)=3(30)+3=93\); Bianca’s function is \(B(30)=3(30)+2=92\); Carmen’s function is \(C(30)=2(30)+30=90\).</para>
        </solution>
      </exercise>
