        <solution id="sol-00006">
          <para id="para-00019">Compare your answer:</para>
          <para id="para-00020">3 dollars per day</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <list class="os-raise-noindent" list-type="enumerated" id="list-00003">
        <item>Use the equation to find the average rate of change for the function that represents Carmen’s savings for the following intervals:</item>
      </list>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00007">
        <problem id="prob-00007">
          <para id="para-00021">between 1 and 2 days</para>
          
        </problem>
        <solution id="sol-00007">
          <para id="para-00022">Compare your answer:</para>
