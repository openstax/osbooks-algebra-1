<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.12.7: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00275</md:content-id>
    <md:title>1.12.7: Practice</md:title>
    <md:uuid>44de000a-51c3-44ec-9b8c-9dcab516cdf7</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <para id="para-00002">In 1 - 2, find the equation of a line with given slope and \( y \)-intercept. Write the equation in slope-intercept form.</para>
      <section id="sect-00002">
        <exercise id="_8ef284c1-00ab-48a5-88e3-a507f9d890c1" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00003">slope 3 and \( y \)-intercept \( ( 0,5) \)</para>
            <para id="para-00004">Multiple Choice:</para>
            <para id="para-00005">\(y=5x+3\)</para>
            <para id="para-00006">\(y=3x+0\)</para>
            <para id="para-00007">\(y=3x+5\)</para>
            <para id="para-00008">\(y=0x+3\)</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00009">Correct! \( y=3x+5 \) \(\begin{array}{rcl}y-y_1&amp;=&amp;m(x-x_1)\\y-(5)&amp;=&amp;3(x-(0))\\y-5&amp;=&amp;3(x)\\y-5&amp;=&amp;3x\\y&amp;=&amp;3x+5\\&amp;&amp;\end{array}\) \(\begin{array}{rcl}y-y_1&amp;=&amp;m(x-x_1)\\y-(5)&amp;=&amp;3(x-(0))\\y-5&amp;=&amp;3(x)\\y-5&amp;=&amp;3x\\y&amp;=&amp;3x+5\\&amp;&amp;\end{array}\)</para>
            <para id="para-00010">Try again. Revisit activity 1.12.2.</para>
            <para id="para-00011">The correct answer is \(y=3x+5\).</para>
            <para id="para-00012">\(\begin{array}{rcl}y-y_1&amp;=&amp;m(x-x_1)\\y-(5)&amp;=&amp;3(x-(0))\\y-5&amp;=&amp;3(x)\\y-5&amp;=&amp;3x\\y&amp;=&amp;3x+5\\&amp;&amp;\end{array}\)</para>
          </solution>
        </exercise>
        <exercise id="d44ab61a-84e5-4c4c-822b-3016c0730bf5" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00013">slope \(−3 \) and \( y \)-intercept \( (0,−1)\)</para>
            <para id="para-00014">Multiple Choice:</para>
            <para id="para-00015">\(y=-x-3\)</para>
            <para id="para-00016">\(y=-3x-1\)</para>
            <para id="para-00017">\(y=-x+0\)</para>
            <para id="para-00018">\(y=0x-3\)</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00019">Correct! \( y=-3x-1 \)</para>
            <para id="para-00020">\(\begin{array}{rcl}y-y_1&amp;=&amp;m(x-x_1)\\y-(-1)&amp;=&amp;-3(x-(0))\\y+1&amp;=&amp;-3(x)\\y+1&amp;=&amp;-3x\\y&amp;=&amp;-3x-1\end{array}\)</para>
            <para id="para-00021">Try again. Revisit activity 1.12.2.</para>
            <para id="para-00022">The correct answer is \(y=-3x-1\).</para>
            <para id="para-00023">\(\begin{array}{rcl}y-y_1&amp;=&amp;m(x-x_1)\\y-(-1)&amp;=&amp;-3(x-(0))\\y+1&amp;=&amp;-3(x)\\y+1&amp;=&amp;-3x\\y&amp;=&amp;-3x-1\end{array}\)</para>
          </solution>
        </exercise>
        <para id="para-00024">In 3 - 4, Choose the slope-intercept form of the equation of the line, shown in each graph.</para>
        <exercise id="_22534ea5-e0df-44bb-82b5-d457a01de3a3" class="multiple-choice">
          <problem id="prob-00003">
                  <media alt="">
                <image mime-type="image/png" src="../../media/Algebra-1_01_14_16_01.png"/>
              </media>
            
            <para id="para-00025">Multiple Choice:</para>
            <para id="para-00026">\(y=-3x+5\)</para>
            <para id="para-00027">\(y=5x-3\)</para>
            <para id="para-00028">\(y=-5x+3\)</para>
            <para id="para-00029">\(y=3x-5\)</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00030">Correct! \( y=3x-5 \)</para>
            <para id="para-00031">\(\begin{array}{rcl}m&amp;=&amp;\frac{y_2-y_1}{x_2-x_1}\\m&amp;=&amp;\frac{(1)-(-2)}{(2)-(1)}\\m&amp;=&amp;\frac{1+2}{2-1}\\m&amp;=&amp;\frac{3}{1}=3\end{array}\)</para>
            <para id="para-00032">\(\begin{array}{rcl}y−y_1&amp;=&amp;m(x−x_1)\\y−(−2)&amp;=&amp;3(x−(1))\\y+2&amp;=&amp;3(x−1)\\y+2&amp;=&amp;3x−3\\y&amp;=&amp;3x−5\end{array}\)</para>
            <para id="para-00033">Try again. Revisit activity 1.12.2.</para>
            <para id="para-00034">The correct answer is \(y=3x-5\).</para>
            <para id="para-00035">\(\begin{array}{rcl}m&amp;=&amp;\frac{y_2-y_1}{x_2-x_1}\\m&amp;=&amp;\frac{(1)-(-2)}{(2)-(1)}\\m&amp;=&amp;\frac{1+2}{2-1}\\m&amp;=&amp;\frac{3}{1}=3\end{array}\)</para>
            <para id="para-00036">\(\begin{array}{rcl}y−y_1&amp;=&amp;m(x−x_1)\\y−(−2)&amp;=&amp;3(x−(1))\\y+2&amp;=&amp;3(x−1)\\y+2&amp;=&amp;3x−3\\y&amp;=&amp;3x−5\end{array}\)</para>
          </solution>
        </exercise>
        <exercise id="b4b0e8cb-bca8-4efe-860f-165f82fd0d0f" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00037">
                      <media alt="">
                  <image mime-type="image/png" src="../../media/Algebra-1_01_14_16_02.png"/>
                </media>
              
           </para>
            <para id="para-00038">Multiple Choice:</para>
            <para id="para-00039">\(y=-2x+4\)</para>
            <para id="para-00040">\(y=2x+4\)</para>
            <para id="para-00041">\(y=\frac12x -4\)</para>
            <para id="para-00042">\(y=\frac12 x+2\)</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00043">Correct! \( y=-2x+4 \)</para>
            <para id="para-00044">\(\begin{array}{rcl}m&amp;=&amp;\frac{y_2-y_1}{x_2-x_1}\\m&amp;=&amp;\frac{(4)-(0)}{(0)-(2)}\\m&amp;=&amp;\frac{4-0}{0-2}\\m&amp;=&amp;\frac{4}{-2}&amp;=&amp;-2\end{array}\)</para>
            <para id="para-00045">\(\begin{array}{rcl}y − y_1 &amp;=&amp; m(x − x_1)\\y − (0) &amp;=&amp; −2(x − (2))\\y &amp;=&amp; −2(x − 2)\\y &amp;=&amp; −2x + 4\end{array}\)</para>
            <para id="para-00046">Try again. Revisit activity 1.12.2.</para>
            <para id="para-00047">The correct answer is \(y=-2x+4\).</para>
            <para id="para-00048">\(\begin{array}{rcl}m&amp;=&amp;\frac{y_2-y_1}{x_2-x_1}\\m&amp;=&amp;\frac{(4)-(0)}{(0)-(2)}\\m&amp;=&amp;\frac{4-0}{0-2}\\m&amp;=&amp;\frac{4}{-2}&amp;=&amp;-2\end{array}\)</para>
            <para id="para-00049">\(\begin{array}{rcl}y − y_1 &amp;=&amp; m(x − x_1)\\y − (0) &amp;=&amp; −2(x − (2))\\y &amp;=&amp; −2(x − 2)\\y &amp;=&amp; −2x + 4\end{array}\)</para>
          </solution>
        </exercise>
        <exercise id="a0d8a289-e8c3-4a6f-b6aa-febc913fcfa0" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00050">\(m=−7\), point \((−1,−3)\)</para>
            <para id="para-00051">Choose the equation of a line with the given slope and containing the given point that best represents the line in slope-intercept form.</para>
            <para id="para-00052">Multiple Choice:</para>
            <para id="para-00053">\(y=-7x-1\)</para>
            <para id="para-00054">\(y=-7x-3\)</para>
            <para id="para-00055">\(y=-3x+10\)</para>
            <para id="para-00056">\(y=-7x-10\)</para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00057">Correct! \( y=-7x-10 \)</para>
            <para id="para-00058">\(\begin{array}{rcl}y − y_1 &amp;=&amp; m(x − x_1)\\y − (−3) &amp;=&amp; −7(x − (−1))\\y + 3 &amp;=&amp; −7(x + 1)\\y + 3 &amp;=&amp; −7x − 7\\y &amp;=&amp; −7x − 10\end{array}\)</para>
            <para id="para-00059">Try again. Revisit activity 1.12.2.</para>
            <para id="para-00060">The correct answer is \(y=-7x-10\).</para>
            <para id="para-00061">\(\begin{array}{rcl}y − y_1 &amp;=&amp; m(x − x_1)\\y − (−3) &amp;=&amp; −7(x − (−1))\\y + 3 &amp;=&amp; −7(x + 1)\\y + 3 &amp;=&amp; −7x − 7\\y &amp;=&amp; −7x − 10\end{array}\)</para>
          </solution>
        </exercise>
        <exercise id="_988663d2-d0e1-4007-a583-801276ebffbe" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00062">\((0,4)\) and \((2,−3)\)</para>
            <para id="para-00063">Choose the equation of a line containing the given points that best represents the line in slope-intercept form.</para>
            <para id="para-00064">Multiple Choice:</para>
            <para id="para-00065">\(y=-\frac72x-3\)</para>
            <para id="para-00066">\(y=\frac72x+4\)</para>
            <para id="para-00067">\(y=-\frac27x+4\)</para>
            <para id="para-00068">\(y=-\frac72x+4\)</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00069">Correct! \(y=-\frac72x+4\)</para>
            <para id="para-00070">\(\begin{array}{rcl}m&amp;=&amp;\frac{y_2-y_1}{x_2-x_1}\\m&amp;=&amp;\frac{(-3)-(4)}{(2)-(0)}\\m&amp;=&amp;\frac{-3-4}{2-0}\\m&amp;=&amp;\frac{-7}{2}\end{array}\)</para>
            <para id="para-00071">\(\begin{array}{rcl}y − y_1 &amp;=&amp; m(x − x_1)\\y − (4) &amp;=&amp; -\frac{7}{2}(x − (0))\\y − 4 &amp;=&amp; -\frac{7}{2}(x)\\y &amp;=&amp; -\frac{7}{2}x + 4\end{array}\)</para>
            <para id="para-00072">Try again. Revisit activity 1.12.4.</para>
            <para id="para-00073">The correct answer is \(y=-\frac72x+4\).</para>
            <para id="para-00074">\(\begin{array}{rcl}m&amp;=&amp;\frac{y_2-y_1}{x_2-x_1}\\m&amp;=&amp;\frac{(-3)-(4)}{(2)-(0)}\\m&amp;=&amp;\frac{-3-4}{2-0}\\m&amp;=&amp;\frac{-7}{2}\end{array}\)</para>
            <para id="para-00075">\(\begin{array}{rcl}y − y_1 &amp;=&amp; m(x − x_1)\\y − (4) &amp;=&amp; -\frac{7}{2}(x − (0))\\y − 4 &amp;=&amp; -\frac{7}{2}(x)\\y &amp;=&amp; -\frac{7}{2}x + 4\end{array}\)</para>
          </solution>
        </exercise>
        <exercise id="_1ddea227-6cfa-401e-9c34-d66382305700" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00076">\((3,−4)\) and \((5,−4)\)</para>
            <para id="para-00077">Choose the equation of a line containing the given points that best represents the line in slope-intercept form.</para>
            <para id="para-00078">Multiple Choice:</para>
            <para id="para-00079">\(y=-4\)</para>
            <para id="para-00080">\(y=0\)</para>
            <para id="para-00081">\(x=2\)</para>
            <para id="para-00082">\(x=-2\)</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00083">Correct! \(y=-4\)</para>
            <para id="para-00084">\(\begin{array}{rcl}m&amp;=&amp;\frac{y_2-y_1}{x_2-x_1}\\m&amp;=&amp;\frac{(-4)-(-4)}{(5)-(3)}\\m&amp;=&amp;\frac{-4+4}{5-3}\\m&amp;=&amp;\frac{0}{2}=0\end{array}\)</para>
            <para id="para-00085">\(\begin{array}{rcl}y − y_1 &amp;=&amp; m(x − x_1)\\y − (−4) &amp;=&amp; 0(x − (3))\\y + 4 &amp;=&amp; 0(x − 3)\\y &amp;=&amp; −4\end{array}\)</para>
            <para id="para-00086">Try again. Revisit activity 1.12.4.</para>
            <para id="para-00087">The correct answer is \(y=-4\).</para>
            <para id="para-00088">\(\begin{array}{rcl}m&amp;=&amp;\frac{y_2-y_1}{x_2-x_1}\\m&amp;=&amp;\frac{(-4)-(-4)}{(5)-(3)}\\m&amp;=&amp;\frac{-4+4}{5-3}\\m&amp;=&amp;\frac{0}{2}=0\end{array}\)</para>
            <para id="para-00089">\(\begin{array}{rcl}y − y_1 &amp;=&amp; m(x − x_1)\\y − (−4) &amp;=&amp; 0(x − (3))\\y + 4 &amp;=&amp; 0(x − 3)\\y &amp;=&amp; −4\end{array}\)</para>
          </solution>
        </exercise>
        <exercise id="_0d4df168-9815-422a-b8fe-790cdafe44fc" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00090">Which of the following equations is  \(y-5=3(x-2)\) written in standard form?</para>
            <para id="para-00091">Multiple Choice:</para>
            <para id="para-00092">\(y=3x-1\)</para>
            <para id="para-00093">\(-3x+y = -1 \)</para>
            <para id="para-00094">\(3x - y =1\)</para>
            <para id="para-00095">\(y=3x -11\)</para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00096">\(\begin{array}{rcl}y-5&amp;=&amp;3(x-2)\\y-5&amp;=&amp;3x-6\\y-5+5&amp;=&amp;3x-6+5\\y&amp;=&amp;3x-1\\y-3x&amp;=&amp;3x-3x-1\\-3x +y&amp;=&amp;-1\\\frac{-3x}{ -1}+\frac{y}{-1}&amp;=&amp;{-1}{-1}\\3x - y &amp;=&amp;1\end{array}\)</para>
            <para id="para-00097">Try again. Revisit activity 1.12.4.</para>
            <para id="para-00098">The correct answer is \(3x - y =1\).</para>
          </solution>
        </exercise>
        <exercise id="c345c099-f334-4829-a6f2-07a7c7ebcf82" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00099">Write the equation of a line that contains the points \((–3,–1)\) and \((2,–2)\). Write the equation in point-slope form.</para>
            <para id="para-00100">Multiple Choice:</para>
            <para id="para-00101">\(y-2=3(x-4)\)</para>
            <para id="para-00102">\(y-4=-3(x+2)\)</para>
            <para id="para-00103">\(y+2=\frac13(x-4)\)</para>
            <para id="para-00104">\(y-4=3(x-2)\)</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00105">Try again.</para>
            <para id="para-00106">The correct answer is \(y-2=3(x-4)\)</para>
          </solution>
        </exercise>
        <exercise id="_1793fb44-9898-4e66-9783-3eb4a0f4b282" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00107">Write the equation of a line that contains the point (2, -3) with a slope of 8. Write the equation in standard form.</para>
            <para id="para-00108">Multiple Choice:</para>
            <para id="para-00109">\(8x - y = -19 \)</para>
            <para id="para-00110">\(8x + y = 19\)</para>
            <para id="para-00111">\(8x-y=19\)</para>
            <para id="para-00112">\( 19x + y = 8\)</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00113">Try again.</para>
            <para id="para-00114">The correct answer is \(8x-y=19\)</para>
          </solution>
        </exercise>
        <exercise id="_545e7634-a60f-48dc-aa3e-fc69ccc363d6" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00115">Write the equation of a line that contains the points (3, 1) and (-1, 5). Write the equation in standard form.</para>
            <para id="para-00116">Multiple Choice:</para>
            <para id="para-00117">\(x - y = 4 \)</para>
            <para id="para-00118">\(x+y=4\)</para>
            <para id="para-00119">\(-x+y = 4\)</para>
            <para id="para-00120">\(x + y = -4\)</para>
          </problem>
          <solution id="sol-00011">
            <para id="para-00121">Try again.</para>
            <para id="para-00122">The correct answer is \(x+y=4\)</para>
          </solution>
        </exercise>
      </section>
    </section>
  </content>
