<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Equations of Graph Translations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02053</md:content-id>
    <md:title>Equations of Graph Translations</md:title>
    <md:uuid>7c09d1c0-e1ca-4ed3-82cd-1866371d49c7</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">
      <title>Cool Down</title>
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00001">Here is a graph that represents <m:math display="inline">
              <m:mrow>
                <m:mi>f</m:mi>
              <m:mo stretchy="false">(</m:mo>
              <m:mi>x</m:mi>
              <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math>
            .</para>

          <media alt="A graph of the parent quadratic function is given in blue on the coordinate plane. The x-axis extends from negative 6 to 6 with a scale of 2. The y-axis extends from negative 30 to 30 with a scale of 10.">
            <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_19_10_01.svg"/>
          </media>
          <para id="para-00003">Use the graphing tool or technology outside the course. On the same
            coordinate plane, sketch a graph that represents <m:math display="inline">
              <m:mrow>
                <m:mi>f</m:mi>
              <m:mo stretchy="false">(</m:mo>
              <m:mi>x</m:mi>
              <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>&#8722;</m:mo>
                <m:mn>6</m:mn>
                <m:msup>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>10</m:mn>
              </m:mrow>
            </m:math>.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00005">Compare your answer: </para>

          <media alt="A graph of the parent quadratic function is given in blue on the coordinate plane. The graph of a second parabola is given and labeled with a vertex at the point (6, 10).">
            <image mime-type="image/jpeg" src="../../media/Algebra-1_08_19_10_02.jpg"/>
          </media>

          <para id="para-00007">A graph the same shape as <m:math display="inline">
              <m:mrow>
                <m:mi>f</m:mi>
              <m:mo stretchy="false">(</m:mo>
              <m:mi>x</m:mi>
              <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math>
            but shifted 6 units to the right and 10 units upward. Its vertex is at <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>6</m:mn>
                <m:mo>,</m:mo>
                <m:mn>10</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </solution>
      </exercise>

      <exercise id="fb53cb18-831e-4ec9-99db-988b82b6b351" class="multiple-choice">
        <problem id="prob-00002">

          <para id="para-00008">The graph representing <m:math display="inline">
              <m:mrow>
                <m:mi>f</m:mi>
              <m:mo stretchy="false">(</m:mo>
              <m:mi>x</m:mi>
              <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math>
            is shifted 2 units to the left, 10 units down, and flipped so that it opens downward, as
            shown.</para>
            <media alt="A coordinate plane displays a graph of the parent quadratic function in blue. Another parabola, graphed in black, was transformed using the parameters in the question. The x-axis extends from negative 6 to positive 6 with a scale of 2 while the y-axis extends from negative 30 to positive 30 with a scale of 10.">
            <image mime-type="image/jpeg" src="../../media/Algebra-1_08_19_10_03.svg"/>
          </media>
          <para id="para-00009">Which equation defines this curve?</para>
          <para id="para-00011">a. <m:math>
              <m:mrow>
                <m:mi>f</m:mi>
              <m:mo stretchy="false">(</m:mo>
              <m:mi>x</m:mi>
              <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo>&#8722;</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
                <m:msup>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>&#8722;</m:mo>
                <m:mn>10</m:mn>
              </m:mrow>
            </m:math></para>
          <para id="para-00012">b. <m:math>
              <m:mrow>
                <m:mi>f</m:mi>
              <m:mo stretchy="false">(</m:mo>
              <m:mi>x</m:mi>
              <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
                <m:msup>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>&#8722;</m:mo>
                <m:mn>10</m:mn>
              </m:mrow>
            </m:math></para>
          <para id="para-00013">c. <m:math>
              <m:mrow>
                <m:mi>f</m:mi>
              <m:mo stretchy="false">(</m:mo>
              <m:mi>x</m:mi>
              <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo>&#8722;</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
                <m:msup>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>10</m:mn>
              </m:mrow>
            </m:math></para>
          <para id="para-00014">d. <m:math>
              <m:mrow>
                <m:mi>f</m:mi>
              <m:mo stretchy="false">(</m:mo>
              <m:mi>x</m:mi>
              <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
                <m:msup>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>10</m:mn>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00015"><m:math display="inline">
              <m:mrow>
                <m:mi>f</m:mi>
              <m:mo stretchy="false">(</m:mo>
              <m:mi>x</m:mi>
              <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo>&#8722;</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
                <m:msup>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>&#8722;</m:mo>
                <m:mn>10</m:mn>
              </m:mrow>
            </m:math></para>

        </solution>
      </exercise>

    </section>
  </content>
</document>