  <content>
  <section><para>The tables listed below are modeling four different functions, all showing growth. Which one does not have the same
  growth pattern as the others?</para>
<div class="os-raise-d-flex os-raise-justify-content-between">
  <table class="os-raise-skinnytable">
    <caption>Table A</caption>
    <thead>
      <row>
        <entry><emphasis>\(x\)</emphasis></entry><entry><emphasis>\(y\)</emphasis></entry></row>
    </thead>
    <tbody>
      <row>
        <entry>
          1
        </entry>
        <entry>
          8
        </entry>
      </row>
      <row>
        <entry>
          2
        </entry>
        <entry>
          16
        </entry>
      </row>
      <row>
        <entry>
          3
        </entry>
        <entry>
          24
        </entry>
      </row>
      <row>
        <entry>
          4
        </entry>
        <entry>
          32
        </entry>
      </row>
      <row>
        <entry>
          8
        </entry>
        <entry>
          64
        </entry>
      </row>
    </tbody>
  </table>
  <table class="os-raise-skinnytable">
    <caption>Table B</caption>
    <thead>
      <row>
        <entry><emphasis>\(x\)</emphasis></entry><entry><emphasis>\(y\)</emphasis></entry></row>
    </thead>
    <tbody>
      <row>
        <entry>
          0
        </entry>
        <entry>
          0
        </entry>
      </row>
      <row>
        <entry>
          2
        </entry>
        <entry>
          16
        </entry>
      </row>
      <row>
        <entry>
          4
        </entry>
        <entry>
          32
        </entry>
      </row>
      <row>
        <entry>
          6
        </entry>
        <entry>
          48
        </entry>
      </row>
      <row>
        <entry>
          8
        </entry>
        <entry>
          64
        </entry>
      </row>
    </tbody>
  </table>
</div>
<div class="os-raise-d-flex os-raise-justify-content-between">
  <table class="os-raise-skinnytable">
    <caption>Table C</caption>
    <thead>
      <row>
        <entry><emphasis>\(x\)</emphasis></entry><entry><emphasis>\(y\)</emphasis></entry></row>
    </thead>
    <tbody>
      <row>
        <entry>
          0
        </entry>
        <entry>
          1
        </entry>
      </row>
      <row>
        <entry>
          1
        </entry>
        <entry>
          4
        </entry>
      </row>
      <row>
        <entry>
          2
        </entry>
        <entry>
          16
        </entry>
      </row>
      <row>
        <entry>

          3
        </entry>
        <entry>
          64
        </entry>
      </row>
      <row>
        <entry>
          4
        </entry>
        <entry>
          256
        </entry>
      </row>
    </tbody>
  </table>
  <table class="os-raise-skinnytable">
    <caption>Table D</caption>
    <thead>
      <row>
        <entry><emphasis>\(x\)</emphasis></entry><entry><emphasis>\(y\)</emphasis></entry></row>
    </thead>
    <tbody>
      <row>
        <entry>
          0
        </entry>
        <entry>
