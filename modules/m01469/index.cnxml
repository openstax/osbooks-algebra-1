<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.12.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01469</md:content-id>
    <md:title>5.12.5: Practice</md:title>
    <md:uuid>07b89a99-3049-459d-95d8-61a35ca24388</md:uuid>
