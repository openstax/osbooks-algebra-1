  <section>
    <div class="os-raise-ib-pset" data-button-text="Check" data-content-id="6ed51ae0-68ac-48f5-84e9-bcafc9315ced" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--q1-->
  <exercise data-content-id="fc849925-6fe7-4a85-8c37-8e6a82941051" data-problem-type="dropdown" data-retry-limit="2" data-solution="f(x)" data-solution-options="[&quot;f(x)&quot;, &quot;g(x)&quot;, &quot;h(x)&quot;]">
    <problem>
      <para>
        For questions 1 - 5, use the the three exponential functions defined below:
      </para>
      <para>\(f(x)=100 \cdot 3^x\)</para>
        <para>\(g(x)=100 \cdot (3.5)^x\)</para>
        <para>\(h(x)=100 \cdot 4^x\)</para>
      <para> Which of these functions grows the least quickly?  </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.12.2.  </para>
    </div>
    </exercise>
  <!--q1b-->
  <exercise data-content-id="68b4e6eb-d822-4062-8daa-2bb942ca1943" data-problem-type="dropdown" data-retry-limit="2" data-solution="h(x)" data-solution-options="[&quot;f(x)&quot;, &quot;g(x)&quot;, &quot;h(x)&quot;]">
    <problem>
      <para> Which function grows the most quickly? </para>
        </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.12.2.  </para>
