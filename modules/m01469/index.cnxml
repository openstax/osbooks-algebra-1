  <content>
    <section id="sect-00001">
        <exercise id="fc849925-6fe7-4a85-8c37-8e6a82941051" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00001">For questions 1 - 5, use the the three exponential functions defined below:</para>
            <para id="para-00002">\(f(x)=100 \cdot 3^x\)</para>
            <para id="para-00003">\(g(x)=100 \cdot (3.5)^x\)</para>
            <para id="para-00004">\(h(x)=100 \cdot 4^x\)</para>
            <para id="para-00005">Which of these functions grows the least quickly?</para>
          </problem>
          <solution id="sol-00001">
            
            <para id="para-00006">Try again. Revisit activity 5.12.2.</para>
            <para id="para-00007">The correct answer is \(f(x)\). The value of \(f\) triples each time \(x\) increases by 1 because the growth factor (or the base) is 3.</para>
          </solution>
        </exercise>
        <exercise id="_68b4e6eb-d822-4062-8daa-2bb942ca1943" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00008">Which function grows the most quickly?</para>
          </problem>
          <solution id="sol-00002">
            
            <para id="para-00009">Try again. Revisit activity 5.12.2.</para>
            <para id="para-00010">The correct answer is \(h(x)\). The value of \(h\) quadruples each time \(x\) increases by 1 because the growth factor (or the base) is 4.</para>
          </solution>
        </exercise>
        <exercise id="fefa6cad-3510-4b34-bb22-a3c8f83ab3f6" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00011">The three given graphs represent the functions \(f\), \(g\), and \(h\) defined above.</para>
            <para id="para-00012">
                      <media alt="">
                  <image mime-type="image/jpeg" src="../../media/Algebra-1_05_14_10_01.jpg"/>
                </media>
              
          </para>
            <para id="para-00013">Which graph corresponds to \(f(x)\)?</para>
          </problem>
          <solution id="sol-00003">
            
            <para id="para-00014">Try again. Revisit activity 5.12.2.</para>
            <para id="para-00015">The correct answer is Graph C.</para>
          </solution>
        </exercise>
        <exercise id="_26ae9706-ccab-4825-92a7-7fd4c05d0223" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00016">Which graph corresponds to \(g(x)\)?</para>
          </problem>
          <solution id="sol-00004">
            
            <para id="para-00017">Try again. Revisit activity 5.12.2.</para>
            <para id="para-00018">The correct answer is Graph B.</para>
          </solution>
        </exercise>
        <exercise id="_7fdbee7a-0aea-460f-ae0d-ff8702853a51" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00019">Which graph corresponds to \(h(x)\)?</para>
          </problem>
          <solution id="sol-00005">
            
            <para id="para-00020">Try again. Revisit activity 5.12.2.</para>
            <para id="para-00021">The correct answer is Graph A.</para>
          </solution>
        </exercise>
        <exercise id="_65995a95-e6ea-40fa-a207-2ec65cb4d679" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00022">For questions 6 - 8, use the given graphs of three exponential equations.</para>
            <para id="para-00023">
                      <media alt="">
                  <image mime-type="image/jpeg" src="../../media/Algebra-1_05_14_10_02.jpg"/>
                </media>
              
          </para>
            <para id="para-00024">Match each equation with its graph.</para>
            <para id="para-00025">Which graph matches the equation \(y=20 \cdot 3^x\)</para>
          </problem>
          <solution id="sol-00006">
            
            <para id="para-00026">Try again. Revisit activities 5.12.2.</para>
            <para id="para-00027">The correct answer is Graph M.</para>
          </solution>
        </exercise>
        <exercise id="_7f927dd8-8ee6-46c0-8e0c-419eb84279ad" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00028">Which graph matches the equation \(y=50 \cdot 3^x\)</para>
          </problem>
          <solution id="sol-00007">
            
            <para id="para-00029">Try again. Revisit activities 5.12.2.</para>
            <para id="para-00030">The correct answer is Graph L.</para>
          </solution>
        </exercise>
        <exercise id="_93bf12cc-1d12-42da-95a4-6bec93e2bd2e" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00031">Which graph matches the equation \(y=100 \cdot 3^x\)</para>
          </problem>
          <solution id="sol-00008">
            
            <para id="para-00032">Try again. Revisit activities 5.12.2.</para>
