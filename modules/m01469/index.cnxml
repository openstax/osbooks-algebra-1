  <content>
    <section class="practice" id="sect-00001">
        <exercise id="fc849925-6fe7-4a85-8c37-8e6a82941051" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00001">For questions 1 - 5, use the the three exponential functions defined below:</para>
            <para id="para-00002"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>100</m:mn><m:mi>·</m:mi><m:msup><m:mn>3</m:mn><m:mi>x</m:mi></m:msup></m:mrow></m:math></para><para id="para-00003"><m:math><m:mrow><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>100</m:mn><m:mi>·</m:mi><m:mo stretchy="false">(</m:mo><m:mn>3.5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mi>x</m:mi></m:msup></m:mrow></m:math></para><para id="para-00004"><m:math><m:mrow><m:mi>h</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>100</m:mn><m:mi>·</m:mi><m:msup><m:mn>4</m:mn><m:mi>x</m:mi></m:msup></m:mrow></m:math></para><para id="para-00005">Which of these functions grows the least quickly?</para>
          </problem>
          <solution id="sol-00001">
            
            <para id="para-00006">Try again. Revisit activity 5.12.2.</para>
            <para id="para-00007">The correct answer is <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>. The value of <m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math> triples each time <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> increases by 1 because the growth factor (or the base) is 3.</para>
          </solution>
        </exercise>
        <exercise id="_68b4e6eb-d822-4062-8daa-2bb942ca1943" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00008">Which function grows the most quickly?</para>
          </problem>
          <solution id="sol-00002">
            
            <para id="para-00009">Try again. Revisit activity 5.12.2.</para>
            <para id="para-00010">The correct answer is <m:math display="inline"><m:mrow><m:mi>h</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>. The value of <m:math display="inline"><m:mrow><m:mi>h</m:mi></m:mrow></m:math> quadruples each time <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> increases by 1 because the growth factor (or the base) is 4.</para>
          </solution>
        </exercise>
        <exercise id="fefa6cad-3510-4b34-bb22-a3c8f83ab3f6" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00011">The three given graphs represent the functions <m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>g</m:mi></m:mrow></m:math>, and <m:math display="inline"><m:mrow><m:mi>h</m:mi></m:mrow></m:math> defined above.</para>
            <para id="para-00012">
                      <media alt="">
                  <image mime-type="image/jpeg" src="../../media/Algebra-1_05_14_10_01.jpg"/>
                </media>
              
          </para>
            <para id="para-00013">Which graph corresponds to <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>?</para>
          </problem>
          <solution id="sol-00003">
            
            <para id="para-00014">Try again. Revisit activity 5.12.2.</para>
            <para id="para-00015">The correct answer is Graph C.</para>
          </solution>
        </exercise>
        <exercise id="_26ae9706-ccab-4825-92a7-7fd4c05d0223" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00016">Which graph corresponds to <m:math display="inline"><m:mrow><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>?</para>
          </problem>
          <solution id="sol-00004">
            
            <para id="para-00017">Try again. Revisit activity 5.12.2.</para>
            <para id="para-00018">The correct answer is Graph B.</para>
          </solution>
        </exercise>
        <exercise id="_7fdbee7a-0aea-460f-ae0d-ff8702853a51" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00019">Which graph corresponds to <m:math display="inline"><m:mrow><m:mi>h</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>?</para>
          </problem>
          <solution id="sol-00005">
            
            <para id="para-00020">Try again. Revisit activity 5.12.2.</para>
            <para id="para-00021">The correct answer is Graph A.</para>
          </solution>
        </exercise>
        <exercise id="_65995a95-e6ea-40fa-a207-2ec65cb4d679" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00022">For questions 6 - 8, use the given graphs of three exponential equations.</para>
            <para id="para-00023">
                      <media alt="">
                  <image mime-type="image/jpeg" src="../../media/Algebra-1_05_14_10_02.jpg"/>
                </media>
              
          </para>
            <para id="para-00024">Match each equation with its graph.</para>
            <para id="para-00025">Which graph matches the equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>20</m:mn><m:mi>·</m:mi><m:msup><m:mn>3</m:mn><m:mi>x</m:mi></m:msup></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00006">
            
            <para id="para-00026">Try again. Revisit activities 5.12.2.</para>
            <para id="para-00027">The correct answer is Graph M.</para>
          </solution>
        </exercise>
        <exercise id="_7f927dd8-8ee6-46c0-8e0c-419eb84279ad" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00028">Which graph matches the equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>50</m:mn><m:mi>·</m:mi><m:msup><m:mn>3</m:mn><m:mi>x</m:mi></m:msup></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00007">
            
            <para id="para-00029">Try again. Revisit activities 5.12.2.</para>
            <para id="para-00030">The correct answer is Graph L.</para>
          </solution>
        </exercise>
        <exercise id="_93bf12cc-1d12-42da-95a4-6bec93e2bd2e" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00031">Which graph matches the equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>100</m:mn><m:mi>·</m:mi><m:msup><m:mn>3</m:mn><m:mi>x</m:mi></m:msup></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00008">
            
            <para id="para-00032">Try again. Revisit activities 5.12.2.</para>
            <para id="para-00033">The correct answer is Graph K.</para>
          </solution>
        </exercise>
        <exercise id="_69c014bc-c939-4181-9282-4f5f66d0e9e5" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00034">For questions 9 - 10, use the graph below.</para>
            <para id="para-00035">
                      <media alt="">
                  <image mime-type="image/jpeg" src="../../media/Algebra-1_05_14_10_03.jpg"/>
                </media>
              
          </para>
            <para id="para-00036">Written in the form <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>a</m:mi><m:mi>·</m:mi><m:msup><m:mi>b</m:mi><m:mi>x</m:mi></m:msup></m:mrow></m:math>, what is the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math><emphasis> </emphasis>for each function?</para>
          </problem>
          <solution id="sol-00009">
            
            <para id="para-00037">Try again. Revisit activity 5.12.3. 
    </para>
            <para id="para-00038">The correct answer is 160.
    </para>
          </solution>
        </exercise>
        <exercise id="_3781b9cd-ca4c-4fe0-81eb-5dffa0788c7c" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00039">Which graph decreases the most quickly?</para>
          </problem>
          <solution id="sol-00010">
            
            <para id="para-00040">Try again. Revisit activity 5.12.3.</para>
            <para id="para-00041">The correct answer is Graph C.</para>
          </solution>
        </exercise>
        <exercise id="_899336df-b768-443d-b6de-9feb1fd0e752" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00042">The graphs of <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>50</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mi>x</m:mi></m:msup></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>200</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mi>x</m:mi></m:msup></m:mrow></m:math>, and <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>100</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mi>x</m:mi></m:msup></m:mrow></m:math> are shown.</para>
            <para id="para-00043">Which is the graph of <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>100</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mi>x</m:mi></m:msup></m:mrow></m:math>?</para>
          </problem>
          <solution id="sol-00011">
            
            <para id="para-00044">Try again. Revisit activities 5.12.4.</para>
            <para id="para-00045">The correct answer is Graph B.</para>
          </solution>
        </exercise>
        <exercise id="d6125db6-2ebc-469e-a89d-2be4e6a30b80" class="multiple-choice">
          <problem id="prob-00012">
            <para id="para-00046">For questions 12 – 14, use the graph below:</para>
            <para id="para-00047">
                      <media alt="Graph of six exponential functions.">
                  <image mime-type="image/jpeg" src="../../media/Algebra-1_05_14_10_04.jpg"/>
                </media>
              
          </para>
            <para id="para-00048">Which of the functions graphed, <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>a</m:mi><m:mi>·</m:mi><m:msup><m:mi>b</m:mi><m:mi>x</m:mi></m:msup></m:mrow></m:math>, has the smallest value for <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>?</para>
          </problem>
          <solution id="sol-00012">
            
            <para id="para-00049">Try again. Revisit activities 5.12.3 – 5.12.4.</para>
            <para id="para-00050">The correct answer is F. Since F has the lowest <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercept, it has the smallest value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>.

    </para>
          </solution>
        </exercise>
        <exercise id="_47391196-f897-4c2a-af5f-a545678afce2" class="multiple-choice">
          <problem id="prob-00013">
            <para id="para-00051">Which of the functions graphed, <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>a</m:mi><m:mi>·</m:mi><m:msup><m:mi>b</m:mi><m:mi>x</m:mi></m:msup></m:mrow></m:math>, has the lowest value for <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>?</para>
          </problem>
          <solution id="sol-00013">
            
            <para id="para-00052">Try again. Revisit activity 5.12.2. 
    </para>
            <para id="para-00053">The correct answer is C. Since C is decaying the fastest, it has the lowest value for <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="af7ac488-3fd7-429e-aafc-f9a4fdf1d9ca" class="multiple-choice">
          <problem id="prob-00014">
            <para id="para-00054">What is the equation of the horizontal asymptote for <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>5</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mi>x</m:mi></m:msup><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math>?</para>
            <para id="para-00055">Multiple Choice:</para>
            <para id="para-00056"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para><para id="para-00057"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math></para><para id="para-00058"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></para><para id="para-00059"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00014">
            
            <para id="para-00060">Try again. Revisit activity 5.12.2. 
    </para>
            <para id="para-00061">The correct answer is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math>. The –3 in the function shifts the exponential down 3.
    </para>
          </solution>
        </exercise>
    </section>
  </content></document>