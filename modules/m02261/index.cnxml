  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="d6a656b9-aa14-47d6-970f-28d15e0d356c" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--1-->
  <exercise data-content-id="5f65cc8d-fbf0-4264-985d-80ccbb2ee4f4" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((3x + 1)(x + 5)\)" data-solution-options="[&quot;\\((3x − 5)(x − 1)\\)&quot;, &quot;\\((3x + 1)(x - 5)\\)&quot;, &quot;\\((3x − 1)(x − 5)\\)&quot;, &quot;\\((3x + 1)(x + 5)\\)&quot;]">
    <problem>
      <para>For questions 1 – 4, find the factored form of the quadratic expression.</para>
      <para>\(3x^2+ 16x + 5\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.10.2. </para>
    </div>
    </exercise>
  <!--2-->
  <exercise data-content-id="885451ea-6a0d-43bb-a2e2-66dcec6ebf4d" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((2x − 1)(x + 6)\)" data-solution-options="[&quot;\\((2x + 6)(x − 1)\\)&quot;, &quot;\\((2x − 6)(x + 1)\\)&quot;, &quot;\\((2x − 1)(x + 6)\\)&quot;, &quot;\\((2x + 1)(x − 6)\\)&quot;]">
    <problem>
      <para>\(2x^2+ 11x − 6\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.10.2.</para>
    </div>
    </exercise>
  <!--3-->
  <exercise data-content-id="71fed853-ac3a-4c2b-acca-01fd838d8b32" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((4x − 1)(x − 3)\)" data-solution-options="[&quot;\\((4x − 1)(x − 3)\\)&quot;, &quot;\\((4x + 3)(x + 1)\\)&quot;, &quot;\\((4x − 3)(x − 1)\\)&quot;, &quot;\\((4x + 1)(x + 3)\\)&quot;]">
    <problem>
      <para>\(4x^2− 13x + 3\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.10.2. </para>
    </div>
    </exercise>
  <!--4-->
  <exercise data-content-id="7bd97612-9bcd-4e35-b7a2-71ad543b985b" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((2x + 1)(x − 2)\)" data-solution-options="[&quot;\\((2x + 1)(x − 2)\\)&quot;, &quot;\\((2x + 2)(x − 1)\\)&quot;, &quot;\\((2x − 2)(x + 1)\\)&quot;, &quot;\\((2x − 1)(x + 2)\\)&quot;]">
    <problem>
      <para>\(2x^2−3x −2\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.10.2. </para>
    </div>
    </exercise>
  <!--5-->
  <exercise data-content-id="0a46316d-2d16-4e78-a061-e7272eae6ee9" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="6.24 seconds" data-solution-options="[&quot;4.38 seconds&quot;, &quot;6.24 seconds&quot;, &quot;7.26 seconds&quot;, &quot;7.56 seconds&quot;]">
    <problem>
      <para>The height, in meters, of a baseball being hit is modeled by the function \(h(x) = -2x^2+ 12x + 3\) where \(x\) is the number of seconds since being hit.</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.10.3. </para>
    </div>
    </exercise>
  <!--6-->
  <exercise data-content-id="06fd0036-d5b6-4199-96e0-4ecf8c671b62" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="10.244 seconds" data-solution-options="[&quot;5.221 seconds&quot;, &quot;7.963 seconds&quot;, &quot;8.365 seconds&quot;, &quot;10.244 seconds&quot;]">
    <problem>
      <para>The height, in meters, of a roller coaster is modeled by the function \(h(x) = -2x^2 + 20x + 5\) where \(x\) is the number of seconds after starting.</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.10.3.</para>
    </div>
    </exercise>
  <!--7-->
  <exercise data-content-id="b796bb7a-1f2a-422c-995b-d498e03b9a34" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((3x + 5)(x − 1)\)" data-solution-options="[&quot;\\((3x + 5)(x + 1)\\)&quot;, &quot;\\((x + 5)(3x − 1)\\)&quot;, &quot;\\((3x + 5)(x − 1)\\)&quot;, &quot;\\((3x − 5)(x + 1)\\)&quot;]">
    <problem>
      <para>For questions 7 – 10, find the factored form of the quadratic expression.</para>
      <para>\(3x^2 + 2x − 5\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 8.10.2 and 8.10.5.</para>
    </div>
    </exercise>
  <!--8-->
  <exercise data-content-id="c7c95a68-b05d-4b64-84d7-e872ef7f7687" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((2x − 3)(2x + 5)\)" data-solution-options="[&quot;\\((4x − 3)(x + 5)\\)&quot;, &quot;\\((2x − 3)(2x + 5)\\)&quot;, &quot;\\((4x + 3)(x − 5)\\)&quot;, &quot;\\((2x + 3)(2x − 5)\\)&quot;]">
    <problem>
      <para>\(4x^2+ 4x − 15\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 8.10.2 and 8.10.5.</para>
    </div>
    </exercise>
  <!--9-->
  <exercise data-content-id="9523d2c9-fddb-4b93-bb3e-1e5f0ad6a8df" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((5x + 1)(x − 8)\)" data-solution-options="[&quot;\\((5x − 1)(x + 8)\\)&quot;, &quot;\\((5x + 8)(x − 1)\\)&quot;, &quot;\\((5x − 8)(x + 1)\\)&quot;, &quot;\\((5x + 1)(x − 8)\\)&quot;]">
    <problem>
      <para>\(5x^2− 39x − 8\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 8.10.2 and 8.10.5. </para>
    </div>
    </exercise>
  <!--10-->
  <exercise data-content-id="d36f22e4-b400-4555-8a81-111a108f6e0b" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((6x − 1)(x + 9)\)" data-solution-options="[&quot;\\((6x − 1)(x + 9)\\)&quot;, &quot;\\((3x − 1)(2x + 9)\\)&quot;, &quot;\\((2x − 1)(3x + 9)\\)&quot;, &quot;\\((6x + 1)(x − 9)\\)&quot;]">
    <problem>
      <para>\(6x^2+ 53x − 9\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 8.10.2 and 8.10.5.</para>
    </div>
    </exercise>
