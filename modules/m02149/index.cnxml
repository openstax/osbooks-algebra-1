<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.4.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02149</md:content-id>
    <md:title>8.4.5: Practice</md:title>
    <md:uuid>bd872df5-81b5-4136-a33b-7bb00d9111a3</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <exercise id="_9f267c0a-5506-4688-afc5-8a285b18a1fb" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00002">For questions 1 – 4, solve each equation. Identify every correct answer.</para>
          <para id="para-00003">\(x(3x+12)=0\)</para>
          <para id="para-00004">Multiple Choice:</para>
          <para id="para-00005">\(x=0\) and \(x=-12\)</para>
          <para id="para-00006">\(x=0\) and \(x=-3\)</para>
          <para id="para-00007">\(x = 4\) and \(x=-4\)</para>
          <para id="para-00008">\(x=0\) and \(x=-4\)</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00009">Try again. Revisit activity 8.4.2.</para>
          <para id="para-00010">The correct answer is \(x = 0\) and \(x=-4\).</para>
        </solution>
      </exercise>
      <exercise id="a739e8a6-3ae2-4425-9e0c-663b4b1324f5" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00011">\((x−7)(x+9)=0\)</para>
          <para id="para-00012">Multiple Choice:</para>
          <para id="para-00013">\(x=7\) and \(x=-7\)</para>
          <para id="para-00014">\(x=0\), \(x=7\), and \(x=-9\)</para>
          <para id="para-00015">\(x=7\) and \(x=-9\)</para>
          <para id="para-00016">\(x=-7\) and \(x=9\)</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00017">Try again. Revisit activity 8.4.2.</para>
          <para id="para-00018">The correct answer is \(x=7\) and \(x=-9\).</para>
        </solution>
      </exercise>
      <exercise id="ef8fa011-307b-4c52-b32a-4f2d044c0a1c" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00019">\((x−8)(4x+15)=0\)</para>
          <para id="para-00020">Multiple Choice:</para>
          <para id="para-00021">\(x=8\) and \(x=- \frac {15}{4}\)</para>
          <para id="para-00022">\(x=8\) and \(x=-\frac {4}{15}\)</para>
          <para id="para-00023">\(x=8\) and \(x=\frac {4}{15}\)</para>
          <para id="para-00024">\(x=8\) and \(x=\frac {15}{4}\)</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00025">Try again. Revisit activity 8.4.2.</para>
          <para id="para-00026">The correct answer is \(x=8\) and \(x=- \frac {15}{4}\).</para>
        </solution>
      </exercise>
      <exercise id="_97f4516a-00a5-43d5-9b90-d9555144c05a" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00027">\(x(x−6)(5x−20)=0\)</para>
          <para id="para-00028">Multiple Choice:</para>
          <para id="para-00029">\(x=0\), \(x=-4\), and \(x=6\)</para>
          <para id="para-00030">\(x=0\), \(x=4\), and \(x=6\)</para>
          <para id="para-00031">\(x=4\) and \(x=6\)</para>
          <para id="para-00032">\(x=0\) and \(x=6\)</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00033">Try again. Revisit activity 8.4.2.</para>
          <para id="para-00034">The correct answer is \(x=0\), \(x=4\), and \(x=6\).</para>
        </solution>
      </exercise>
      <exercise id="c4705cf3-d0ff-4c1e-bb3e-eb5a56150f20" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00035">For questions 5 - 6, use the following.</para>
          <para id="para-00036">The functions below model the height of a projectile in feet, \(t\) seconds after launch.</para>
          <para id="para-00037">\(h(t) = -7t^2 + 34t + 48\)</para>
          <para id="para-00038">\(h(t) = (-7t − 8)(t − 6)\)</para>
          <para id="para-00039">Without graphing, determine at what time the height of the object is 0 feet.</para>
          <para id="para-00040">Multiple Choice:</para>
          <para id="para-00041">\(\frac {8}{7}\) seconds</para>
          <para id="para-00042">6 seconds</para>
          <para id="para-00043">\(-\frac {8}{7}\) seconds</para>
          <para id="para-00044">0 seconds</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00045">Try again. Revisit activity 8.4.3.</para>
          <para id="para-00046">The correct answer is 6 seconds.</para>
        </solution>
      </exercise>
      <exercise id="_90bb26d6-7954-40ce-93b3-499af29a14fb" class="multiple-choice">
        <problem id="prob-00006">
          <para id="para-00047">Determine the height of the object before it is launched.</para>
          <para id="para-00048">Multiple Choice:</para>
          <para id="para-00049">0 feet</para>
          <para id="para-00050">\(\frac {8}{7}\) feet</para>
          <para id="para-00051">6 feet</para>
          <para id="para-00052">48 feet</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00053">Try again. Revisit activity 8.4.3.</para>
          <para id="para-00054">The correct answer is 48 feet.</para>
        </solution>
      </exercise>
      <exercise id="fd09059e-854c-4f79-b588-548abc15c284" class="multiple-choice">
        <problem id="prob-00007">
          <para id="para-00055">For questions 7 – 10, solve each equation. Identify every correct answer.</para>
          <para id="para-00056">\(x(6x−18)=0\)</para>
          <para id="para-00057">Multiple Choice:</para>
          <para id="para-00058">\(x=0\) and \(x=-3\)</para>
          <para id="para-00059">\(x=3\)</para>
          <para id="para-00060">\(x=0\) and \(x=3\)</para>
          <para id="para-00061">\(x=-3\)</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00062">Try again. Revisit activity 8.4.4.</para>
          <para id="para-00063">The correct answer is \(x=0\) and \(x=3\).</para>
        </solution>
      </exercise>
      <exercise id="f636ce5b-8327-4d44-a3d3-0e33d5cf2171" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00064">\((x+13)(x−9)=0\)</para>
          <para id="para-00065">Multiple Choice:</para>
          <para id="para-00066">\(x=-9\) and \(x=-13\)</para>
          <para id="para-00067">\(x=-13\), \(x=0\), and \(x=-9\)</para>
          <para id="para-00068">\(x=-9\) and \(x=13\)</para>
          <para id="para-00069">\(x=-13\) and \(x=9\)</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00070">Try again. Revisit activity 8.4.4.</para>
          <para id="para-00071">The correct answer is \(x=-13\) and \(x=9\).</para>
        </solution>
      </exercise>
      <exercise id="_2b2041ff-517d-4740-9b92-5f20e01adeb7" class="multiple-choice">
        <problem id="prob-00009">
          <para id="para-00072">\((x−7)(x−7)=0\)</para>
          <para id="para-00073">Multiple Choice:</para>
          <para id="para-00074">\(x=7\)</para>
          <para id="para-00075">\(x=-7\) and \(x=7\)</para>
          <para id="para-00076">\(x=0\) and \(x=7\)</para>
          <para id="para-00077">\(x=-7\)</para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00078">Try again. Revisit activity 8.4.4.</para>
          <para id="para-00079">The correct answer is \(x=7\).</para>
        </solution>
      </exercise>
      <exercise id="_8193fd72-2eb5-46ed-93e0-53680d7352a3" class="multiple-choice">
        <problem id="prob-00010">
          <para id="para-00080">\((x− \frac {5}{6})(6x+30)=0\)</para>
          <para id="para-00081">Multiple Choice:</para>
          <para id="para-00082">\(x=5\) and \(x=-\frac {5}{6}\)</para>
          <para id="para-00083">\(x=5\) and \(x=\frac {5}{6}\)</para>
          <para id="para-00084">\(x = -5\) and \(x=\frac {5}{6}\)</para>
          <para id="para-00085">\(x = -6\) and \(x=\frac {5}{6}\)</para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00086">Try again. Revisit activity 8.4.4.</para>
          <para id="para-00087">The correct answer is \(x = -5\) and \(x=56\).</para>
        </solution>
      </exercise>
    </section>
  </content>
</document>