  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="1d5502a8-4a69-47c5-9456-0fa5d50d974d" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--q1-->
  <exercise data-content-id="9f267c0a-5506-4688-afc5-8a285b18a1fb" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x=0\) and \(x=-4\)" data-solution-options="[&quot;\\(x=0\\) and \\(x=-12\\)&quot;, &quot;\\(x=0\\) and \\(x=-3\\)&quot;, &quot;\\(x = 4\\) and \\(x=-4\\)&quot;, &quot;\\(x=0\\) and \\(x=-4\\)&quot;]">
    <problem>
      <para>For questions 1 – 4, solve each equation. Identify every correct answer.</para>
      <para>\(x(3x+12)=0\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.4.2. </para>
    </div>
    </exercise>
  <!--q2-->
  <exercise data-content-id="a739e8a6-3ae2-4425-9e0c-663b4b1324f5" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x=7\) and \(x=-9\)" data-solution-options="[&quot;\\(x=7\\) and \\(x=-7\\)&quot;, &quot;\\(x=0\\), \\(x=7\\), and \\(x=-9\\)&quot;, &quot;\\(x=7\\) and \\(x=-9\\)&quot;, &quot;\\(x=-7\\) and \\(x=9\\)&quot;]">
    <problem>
      <para>\((x−7)(x+9)=0\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.4.2.</para>
    </div>
    </exercise>
  <!--q3-->
  <exercise data-content-id="ef8fa011-307b-4c52-b32a-4f2d044c0a1c" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x=8\) and \(x=- \frac {15}{4}\)" data-solution-options="[&quot;\\(x=8\\) and \\(x=- \\frac {15}{4}\\)&quot;, &quot;\\(x=8\\) and \\(x=-\\frac {4}{15}\\)&quot;, &quot;\\(x=8\\) and \\(x=\\frac {4}{15}\\)&quot;, &quot;\\(x=8\\) and \\(x=\\frac {15}{4}\\)&quot;]">
    <problem>
      <para>\((x−8)(4x+15)=0\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.4.2.  </para>
    </div>
    </exercise>
  <!--q4-->
  <exercise data-content-id="97f4516a-00a5-43d5-9b90-d9555144c05a" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x=0\), \(x=4\), and \(x=6\)" data-solution-options="[&quot;\\(x=0\\), \\(x=-4\\), and \\(x=6\\)&quot;, &quot;\\(x=0\\), \\(x=4\\), and \\(x=6\\)&quot;, &quot;\\(x=4\\) and \\(x=6\\)&quot;, &quot;\\(x=0\\) and \\(x=6\\)&quot;]">
    <problem>
      <para>\(x(x−6)(5x−20)=0\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.4.2.</para>
    </div>
    </exercise>
  <!--q5-->
  <exercise data-content-id="c4705cf3-d0ff-4c1e-bb3e-eb5a56150f20" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="6 seconds" data-solution-options="[&quot;\\(\\frac {8}{7}\\) seconds&quot;, &quot;6 seconds&quot;, &quot;\\(-\\frac {8}{7}\\) seconds&quot;, &quot;0 seconds&quot;]">
    <problem>
      <para>For questions 5 - 6, use the following.</para>
      <para>The functions below model the height of a projectile in feet, \(t\) seconds after launch.</para>
      <para>\(h(t) = -7t^2 + 34t + 48\)</para>
        <para>\(h(t) = (-7t − 8)(t − 6)\)</para>
        <para>Without graphing, determine at what time the height of the object is 0 feet.</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.4.3. </para>
    </div>
    </exercise>
  <!--q6-->
  <exercise data-content-id="90bb26d6-7954-40ce-93b3-499af29a14fb" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="48 feet" data-solution-options="[&quot;0 feet&quot;, &quot;\\(\\frac {8}{7}\\) feet&quot;, &quot;6 feet&quot;, &quot;48 feet&quot;]">
    <problem>
      <para>Determine the height of the object before it is launched.</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.4.3. </para>
    </div>
    </exercise>
  <!--q7-->
  <exercise data-content-id="fd09059e-854c-4f79-b588-548abc15c284" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x=0\) and \(x=3\)" data-solution-options="[&quot;\\(x=0\\) and \\(x=-3\\)&quot;, &quot;\\(x=3\\)&quot;, &quot;\\(x=0\\) and \\(x=3\\)&quot;, &quot;\\(x=-3\\)&quot;]">
    <problem>
      <para>For questions 7 – 10, solve each equation. Identify every correct answer.</para>
      <para>\(x(6x−18)=0\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.4.4.  </para>
    </div>
    </exercise>
  <!--q8-->
  <exercise data-content-id="f636ce5b-8327-4d44-a3d3-0e33d5cf2171" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x=-13\) and \(x=9\)" data-solution-options="[&quot;\\(x=-9\\) and \\(x=-13\\)&quot;, &quot;\\(x=-13\\), \\(x=0\\), and \\(x=-9\\)&quot;, &quot;\\(x=-9\\) and \\(x=13\\)&quot;, &quot;\\(x=-13\\) and \\(x=9\\)&quot;]">
    <problem>
      <para>\((x+13)(x−9)=0\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.4.4.</para>
    </div>
    </exercise>
  <!--q9-->
  <exercise data-content-id="2b2041ff-517d-4740-9b92-5f20e01adeb7" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x=7\)" data-solution-options="[&quot;\\(x=7\\)&quot;, &quot;\\(x=-7\\) and \\(x=7\\)&quot;, &quot;\\(x=0\\) and \\(x=7\\)&quot;, &quot;\\(x=-7\\)&quot;]">
    <problem>
      <para>\((x−7)(x−7)=0\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.4.4. </para>
    </div>
    </exercise>
  <!--q10-->
  <exercise data-content-id="8193fd72-2eb5-46ed-93e0-53680d7352a3" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x = -5\) and \(x=\frac {5}{6}\)" data-solution-options="[&quot;\\(x=5\\) and \\(x=-\\frac {5}{6}\\)&quot;, &quot;\\(x=5\\) and \\(x=\\frac {5}{6}\\)&quot;, &quot;\\(x = -5\\) and \\(x=\\frac {5}{6}\\)&quot;, &quot;\\(x = -6\\) and \\(x=\\frac {5}{6}\\)&quot;]">
    <problem>
      <para>\((x− \frac {5}{6})(6x+30)=0\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.4.4.</para>
    </div>
    </exercise>
