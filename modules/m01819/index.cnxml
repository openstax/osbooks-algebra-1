<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>7.5.4: A Quadratic Expression that Represents the Relationship between Distance and Time</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01819</md:content-id>
    <md:title>7.5.4: A Quadratic Expression that Represents the Relationship between Distance and Time</md:title>
    <md:uuid>2a5f241b-cf65-472a-be56-b023f27c2748</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Cool Down Activity</title>
      <para id="para-00001">The expression <m:math display="inline"><m:mrow><m:mn>16</m:mn><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> represents the distance in feet an object falls after <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> seconds. Assume an object is dropped from a height of 906 feet.</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002">What is the height of the object in feet 2 seconds after it is dropped?</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Compare your answer:</para>
          <para id="para-00004">The object is at 842 feet 2 seconds after it’s dropped. <m:math display="inline"><m:mrow><m:mn>906</m:mn><m:mo>−</m:mo><m:mn>16</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>906</m:mn><m:mo>−</m:mo><m:mn>16</m:mn><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>906</m:mn><m:mo>−</m:mo><m:mn>64</m:mn><m:mo>=</m:mo><m:mn>842</m:mn></m:mrow></m:math></para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00005">Write an expression representing the height of the object in feet <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> seconds after it is dropped.</para>
          <para id="para-00006">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00007">Compare your answer:</para>
          <para id="para-00008"><m:math><m:mrow><m:mn>906</m:mn><m:mo>−</m:mo><m:mn>16</m:mn><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para></solution>
      </exercise>
    </section>
  </content>
</document>