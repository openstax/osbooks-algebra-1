<exercise>
  <problem>
    <para>
        <figure><media alt="Graph of an inequality line."><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/e83a9c58216aac2edb0c6b1c10302484b8d133e9"/></media></figure></para>
