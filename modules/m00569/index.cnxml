      <!--Interaction
      End -->
      <para id="para-00021">For each graph in questions 5 – 8, write an inequality whose solutions are represented
        by the shaded part of the graph.</para>
      <!--Q5-->
      <exercise id="exer-00005">
        <problem id="prob-00005">
          <para id="para-00022">
            
              <media alt="Graph of an inequality.">
                <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_13_06_06.svg"/>
              </media>
            
         </para>

        </problem>
        <solution id="sol-00005">
          <para id="para-00023">Compare your answer:</para>
          <para id="para-00024">\(x>3\)</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q6-->
      <exercise id="exer-00006">
        <problem id="prob-00006">
          <para id="para-00025">
            
              <media alt="Graph of an inequality.">
                <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_13_06_07.svg"/>
              </media>
            
         </para>

        </problem>
        <solution id="sol-00006">
          <para id="para-00026">Compare your answer:</para>
          <para id="para-00027">\(y \leq -2\)</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q7-->
      <exercise id="exer-00007">
        <problem id="prob-00007">
          <para id="para-00028">
            
              <media alt="Graph of an inequality line.">
                <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_13_06_08.svg"/>
              </media>
            
