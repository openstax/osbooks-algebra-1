              <media alt="Graph of an inequality.">
                <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_13_06_04.svg"/>
              </media>
            
         </para>
        </solution>
      </exercise>

      <!--Interaction
      End -->
      <!--Q4-->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00017">\(x−y \geq 5\)</para>
          <media alt="">
            <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
              </media>
          <para id="para-00018">When you have finished graphing, then select the <emphasis>solution</emphasis>
