<para>For each graph in questions 5 – 8, write an inequality whose solutions are represented by the shaded part of the graph.</para>

<!--Q5-->
<exercise>
  <problem>
    <para>
        <figure><media alt="Graph of an inequality."><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/76ba111941b315884d41c435ceaae3d8cd125c24"/></media></figure></para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(x&gt;3\)</para>
  </solution></exercise>
<!--Interaction End -->

<!--Q6-->
<exercise>
  <problem>
    <para>
        <figure><media alt="Graph of an inequality."><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/726100264cf0edd07c1d362b1347edccef9f3a1f"/></media></figure></para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(y \leq -2\)</para>
  </solution></exercise>
<!--Interaction End -->

<!--Q7-->
<exercise>
  <problem>
    <para><figure><media alt="Graph of an inequality line."><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/31cbbaa26b5c9560ee25ff05cd0de19b3b171eab"/></media></figure></para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(y&gt;x\)</para>
  </solution></exercise>
<!--Interaction End -->

