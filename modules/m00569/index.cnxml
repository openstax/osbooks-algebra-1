      <!--Interaction
      End -->
      <para>For each graph in questions 5 – 8, write an inequality whose solutions are represented
        by the shaded part of the graph.</para>
      <!--Q5-->
      <exercise>
        <problem>
          <para>
            <figure class="unnumbered">
              <media alt="Graph of an inequality.">
                <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_13_06_06.svg" />
              </media>
            </figure>
          </para>

        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(x&gt;3\)</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q6-->
      <exercise>
        <problem>
          <para>
            <figure class="unnumbered">
              <media alt="Graph of an inequality.">
                <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_13_06_07.svg" />
              </media>
            </figure>
          </para>

        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y \leq -2\)</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q7-->
      <exercise>
        <problem>
          <para>
            <figure class="unnumbered">
              <media alt="Graph of an inequality line.">
                <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_13_06_08.svg" />
              </media>
