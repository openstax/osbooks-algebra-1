          </para>

        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y&gt;x\)</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q8-->
      <exercise>
        <problem>
          <para>
            <figure class="unnumbered">
              <media alt="Graph of an inequality line.">
                <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_13_06_09.svg" />
              </media>
            </figure>
          </para>

        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y \leq x\) or \(x \geq y\)</para>
        </solution>
      </exercise>
