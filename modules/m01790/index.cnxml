  <title>7.4.4: Comparing Exponential and Quadratic Expressions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01790</md:content-id>
    <md:title>7.4.4: Comparing Exponential and Quadratic Expressions</md:title>
    <md:uuid>4454e7f6-9b5a-45b7-ad99-1ca1b4eafb7f</md:uuid>
