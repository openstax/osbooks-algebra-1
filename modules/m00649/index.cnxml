<exercise data-wait-for-event="RFM1">
  <problem>
    <title>Extending Your Thinking</title>
    <para>Find a system of inequalities with this triangle as its set of solutions:</para>
    <para><figure><media alt="Insert Alt Text"><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/58774892f20e984e35f56f0128ea5d45a7a93cb1"/></media></figure></para>
  </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>\(x+y\geq2\), \(x+4y\leq14\), \(4x+y\leq11\) or equivalent</para>
  </solution></exercise>
