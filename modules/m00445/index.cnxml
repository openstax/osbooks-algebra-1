    <section id="sect-00004">
      <note class="self-check" id="note-00001">
        <exercise id="exer-00013">
          <problem id="prob-00021">
            <para id="para-00089"><link class="os-embed" url="#exercise/Alg1_2_5_3_SC"/></para>
