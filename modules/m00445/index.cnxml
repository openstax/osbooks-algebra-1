</div>
</div>
<!--Q#6-->
<exercise>
  <problem>
    <para> Show your reasoning and check the solution. </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(\begin{array}{l}\underline{\begin{array}{rcl}2x+3y&amp;=&amp;7\\+\;\;\;\;\;3x-3y&amp;=&amp;3\end{array}}\\\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;5x=10\\\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;x=2\end{array}\)</para>
    
    <para>\(\begin{array}{rcl}2x+3y&amp;=&amp;7\\2(2)+3y&amp;=&amp;7\\4+3y&amp;=&amp;7\\3y&amp;=&amp;3\\y&amp;=&amp;1\end{array}\)</para>
    
    <para> \(\begin{array}{rcl}3x-3y&amp;=&amp;3\\3(2)-3(1)&amp;=&amp;3\\6-3&amp;=&amp;3\\3&amp;=&amp;3\checkmark\end{array}\)</para>
    
    <para>\(\begin{array}{rcl}2x+3y&amp;=&amp;7\\2(2)+3(1)&amp;=&amp;7\\4+3&amp;=&amp;7\\7&amp;=&amp;7\checkmark\end{array}\)</para>
  </solution></exercise>
<!--Interaction End -->

<para>System C</para>
<para>\(\left\{\begin{array}{c}2x+3y=5\\2x+4y=9\end{array}\right.\)</para>
<para>Use System C to answer questions 7 – 9.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="a8f72abe-fafe-4bc2-9bff-d6adb97a1ffa" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
