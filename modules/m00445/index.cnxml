  <title>2.5.3: Solving Systems of Linear Equations in Two Variables</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00445</md:content-id>
    <md:title>2.5.3: Solving Systems of Linear Equations in Two Variables</md:title>
