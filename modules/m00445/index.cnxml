  <content>
  <section><title>Activity
</title>
<para>Solve each system of equations without graphing, show your reasoning, and check your solutions.</para>
<para>System A</para>
<para>\(\left\{\begin{array}{c}2x+3y=7\\−2x+4y=14\end{array}\right.\)</para>
<para>Use System A to answer questions 1 – 3.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="457f1d33-d559-44b8-b66a-7eaa40fc25dd" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0"><!--Q#1-->
  <exercise data-content-id="7d48562a-3735-44df-9bcc-465bc371c8cb" data-problem-comparator="float" data-problem-type="input" data-solution="-1">
    <problem>
      <para> What is the value of \(x\)? </para>
      <para>Enter your answer here.</para>
    </problem>
    <solution>
      <para>Correct! -1</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#2-->
  <exercise data-content-id="6547e405-e041-419c-8f86-b77e2538434c" data-problem-comparator="integer" data-problem-type="input" data-solution="3">
    <problem>
      <para> What is the value of \(y\)? </para>
      <para>Enter your answer here.</para>
    </problem>
    <solution>
      <para>Correct! 3</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>
<!--Q#3-->
<exercise>
  <problem>
    <para> Show your reasoning and check the solution. </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para> \(\begin{array}{l}\underline{\begin{array}{rcl}2x+3y&amp;=&amp;7\\+\;\;\;\;\;\;-2x+4y&amp;=&amp;14\end{array}}\\\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;7y=21\\\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;y=3\end{array}\)</para>
    
    <para> \(\begin{array}{rcl}2x+3y&amp;=&amp;7\\2x+3(3)&amp;=&amp;7\\2x+9&amp;=&amp;7\\2x&amp;=&amp;-2\\x&amp;=&amp;-1\end{array}\)</para>
    
    <para> \(\begin{array}{rcl}2x+3y&amp;=&amp;7\\2(-1)+3(3)&amp;=&amp;7\\-2+9&amp;=&amp;7\\7&amp;=&amp;7\checkmark\end{array}\)</para>
    
    <para> \(\begin{array}{rcl}-2x+4y&amp;=&amp;14\\-2(-1)+4(3)&amp;=&amp;14\\2+12&amp;=&amp;14\\14&amp;=&amp;14\checkmark\end{array}\)</para>
  </solution></exercise>
<!--Interaction End -->

<para>System B</para>
<para>\(\left\{\begin{array}{c}2x+3y=7\\3x−3y=3\end{array}\right.\)</para>
<para>Use System B to answer questions 4 – 6.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="1076439a-3238-4df9-bbdb-43294d130a6a" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q#4-->
  <exercise data-content-id="9371dd7f-287f-4dce-a0ab-f2fa4973f004" data-problem-comparator="integer" data-problem-type="input" data-solution="2">
    <problem>
      <para> What is the value of \(x\)? </para>
      <para>Enter your answer here.</para>
    </problem>
    <solution>
      <para>Correct! 2</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#5-->
  <exercise data-content-id="4ba901ba-785b-4668-a022-9bfd7cb9b71a" data-problem-comparator="integer" data-problem-type="input" data-solution="1">
    <problem>
      <para> What is the value of \(y\)? </para>
      <para>Enter your answer here.</para>
    </problem>
    <solution>
      <para>Correct! 1</para>
    </solution>
    </exercise>
  <!--END QUESTION.--> <!--Do not edit below line.-->
