<!--Q#12-->
<exercise>
  <problem>
    <para> Show your reasoning and check the solution. </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(\begin{array}{rcl}-1(6x+9y&amp;=&amp;48)\\-6x-9y&amp;=&amp;-48\end{array}\)</para>
    
    <para>\(\begin{array}{l}\underline{\begin{array}{rcl}-6x-9y&amp;=&amp;-48\\+\;\;\;\;\;\;\;\;\;\;\;\;6x-5y&amp;=&amp;20\end{array}}\\\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;-14y=-28\\\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;y=2\end{array}\)</para>
    
    <para> \(\begin{array}{rcl}6x-5y&amp;=&amp;20\\6x-5(2)&amp;=&amp;20\\6x-10&amp;=&amp;20\\6x&amp;=&amp;30\\x&amp;=&amp;5\end{array}\)</para>
    
    <para> \(\begin{array}{rcl}6x+9y&amp;=&amp;48\\6(5)+9(2)&amp;=&amp;48\\30+18&amp;=&amp;48\\48&amp;=&amp;48\checkmark\end{array}\)</para>
    
    <para> \(\begin{array}{rcl}6x-5y&amp;=&amp;20\\6(5)-5(2)&amp;=&amp;20\\30-10&amp;=&amp;20\\20&amp;=&amp;20\checkmark\end{array}\)</para>
  </solution></exercise>
<!--Interaction End -->


