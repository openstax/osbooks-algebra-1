<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Solving Systems of Linear Equations in Two Variables</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00445</md:content-id>
    <md:title>Solving Systems of Linear Equations in Two Variables</md:title>
    <md:uuid>ba7f6a8e-f682-4952-987a-91e897677366</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">
      <title>Activity</title>
      <para id="para-00001">Solve each system of equations without graphing, show your reasoning,
        and check your solutions.</para>
      <para id="para-00002">System A</para>
      <para id="para-00003"><m:math>
          <m:mrow>
            <m:mrow>
              <m:mo stretchy="true" fence="true" form="prefix">{</m:mo>
              <m:mtable>
                <m:mtr>
                  <m:mtd columnalign="center">
                    <m:mn>2</m:mn>
                    <m:mi>x</m:mi>
                    <m:mo>+</m:mo>
                    <m:mn>3</m:mn>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>7</m:mn>
                  </m:mtd>
                </m:mtr>
                <m:mtr>
                  <m:mtd columnalign="center">
                    <m:mi>−</m:mi>
                    <m:mn>2</m:mn>
                    <m:mi>x</m:mi>
                    <m:mo>+</m:mo>
                    <m:mn>4</m:mn>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>14</m:mn>
                  </m:mtd>
                </m:mtr>
              </m:mtable>
              <m:mo stretchy="true" fence="true" form="postfix"/>
            </m:mrow>
          </m:mrow>
        </m:math></para>
      <para id="para-00004">Use System A to answer questions 1 – 3.</para>

      <exercise id="_7d48562a-3735-44df-9bcc-465bc371c8cb" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00005">What is the value of <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>?</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00006">-1</para>
        </solution>
      </exercise>
      <exercise id="_6547e405-e041-419c-8f86-b77e2538434c" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00008">What is the value of <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>?</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00009">3</para>
        </solution>
      </exercise>
      <!--Q#3-->
      <exercise id="exer-00001">
        <problem id="prob-00003">
          <para id="para-00011">Show your reasoning and check the solution.</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00012">Compare your answer: </para>

          <para id="para-00013"><m:math display="inline">
              <m:mrow>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="left">
                      <m:munder>
                        <m:mrow>
                          <m:mtable>
                            <m:mtr>
                              <m:mtd columnalign="right">
                                <m:mn>2</m:mn>
                                <m:mi>x</m:mi>
                                <m:mo>+</m:mo>
                                <m:mn>3</m:mn>
                                <m:mi>y</m:mi>
                              </m:mtd>
                              <m:mtd columnalign="center">
                                <m:mo>=</m:mo>
                              </m:mtd>
                              <m:mtd columnalign="left">
                                <m:mn>7</m:mn>
                              </m:mtd>
                            </m:mtr>
                            <m:mtr>
                              <m:mtd columnalign="right">
                                <m:mo>+</m:mo>
                                <m:mspace width="0.278em"/>
                                <m:mspace width="0.278em"/>
                                <m:mspace width="0.278em"/>
                                <m:mspace width="0.278em"/>
                                <m:mspace width="0.278em"/>
                                <m:mspace width="0.278em"/>
                                <m:mo>−</m:mo>
                                <m:mn>2</m:mn>
                                <m:mi>x</m:mi>
                                <m:mo>+</m:mo>
                                <m:mn>4</m:mn>
                                <m:mi>y</m:mi>
                              </m:mtd>
                              <m:mtd columnalign="center">
                                <m:mo>=</m:mo>
                              </m:mtd>
                              <m:mtd columnalign="left">
                                <m:mn>14</m:mn>
                              </m:mtd>
                            </m:mtr>
                          </m:mtable>
                        </m:mrow>
                        <m:mo accent="true">―</m:mo>
                      </m:munder>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="left">
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mn>7</m:mn>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>21</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="left">
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>3</m:mn>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
              </m:mrow>
            </m:math><newline/><newline/></para>
          <para id="para-00014"><m:math display="inline">
              <m:mrow>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>2</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>3</m:mn>
                      <m:mi>y</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>7</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>2</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>3</m:mn>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mn>3</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>7</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>2</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>9</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>7</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>2</m:mn>
                      <m:mi>x</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mo>−</m:mo>
                      <m:mn>2</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mi>x</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
              </m:mrow>
            </m:math><newline/><newline/></para>
          <para id="para-00015"><m:math display="inline">
              <m:mrow>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>2</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>3</m:mn>
                      <m:mi>y</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>7</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>2</m:mn>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                      <m:mo>+</m:mo>
                      <m:mn>3</m:mn>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mn>3</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>7</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mn>2</m:mn>
                      <m:mo>+</m:mo>
                      <m:mn>9</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>7</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>7</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>7</m:mn>
                      <m:mi>✓</m:mi>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
              </m:mrow>
            </m:math><newline/><newline/></para>
          <para id="para-00016"><m:math display="inline">
              <m:mrow>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mn>2</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>4</m:mn>
                      <m:mi>y</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>14</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mn>2</m:mn>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                      <m:mo>+</m:mo>
                      <m:mn>4</m:mn>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mn>3</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>14</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>2</m:mn>
                      <m:mo>+</m:mo>
                      <m:mn>12</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>14</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>14</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>14</m:mn>
                      <m:mi>✓</m:mi>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <para id="para-00017">System B</para>
      <para id="para-00018"><m:math>
          <m:mrow>
            <m:mrow>
              <m:mo stretchy="true" fence="true" form="prefix">{</m:mo>
              <m:mtable>
                <m:mtr>
                  <m:mtd columnalign="center">
                    <m:mn>2</m:mn>
                    <m:mi>x</m:mi>
                    <m:mo>+</m:mo>
                    <m:mn>3</m:mn>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>7</m:mn>
                  </m:mtd>
                </m:mtr>
                <m:mtr>
                  <m:mtd columnalign="center">
                    <m:mn>3</m:mn>
                    <m:mi>x</m:mi>
                    <m:mi>−</m:mi>
                    <m:mn>3</m:mn>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>3</m:mn>
                  </m:mtd>
                </m:mtr>
              </m:mtable>
              <m:mo stretchy="true" fence="true" form="postfix"/>
            </m:mrow>
          </m:mrow>
        </m:math></para>
      <para id="para-00019">Use System B to answer questions 4 – 6.</para>

      <exercise id="_9371dd7f-287f-4dce-a0ab-f2fa4973f004" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00020">What is the value of <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>?</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00021">2</para>
        </solution>
      </exercise>
      <exercise id="_4ba901ba-785b-4668-a022-9bfd7cb9b71a" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00023">What is the value of <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math>?</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00024">1</para>
        </solution>
      </exercise>
      <!--Q#6-->
      <exercise id="exer-00002">
        <problem id="prob-00006">
          <para id="para-00026">Show your reasoning and check the solution.</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00027">Compare your answer: </para>

          <para id="para-00028"><m:math display="inline">
              <m:mrow>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="left">
                      <m:munder>
                        <m:mrow>
                          <m:mtable>
                            <m:mtr>
                              <m:mtd columnalign="right">
                                <m:mn>2</m:mn>
                                <m:mi>x</m:mi>
                                <m:mo>+</m:mo>
                                <m:mn>3</m:mn>
                                <m:mi>y</m:mi>
                              </m:mtd>
                              <m:mtd columnalign="center">
                                <m:mo>=</m:mo>
                              </m:mtd>
                              <m:mtd columnalign="left">
                                <m:mn>7</m:mn>
                              </m:mtd>
                            </m:mtr>
                            <m:mtr>
                              <m:mtd columnalign="right">
                                <m:mo>+</m:mo>
                                <m:mspace width="0.278em"/>
                                <m:mspace width="0.278em"/>
                                <m:mspace width="0.278em"/>
                                <m:mspace width="0.278em"/>
                                <m:mspace width="0.278em"/>
                                <m:mn>3</m:mn>
                                <m:mi>x</m:mi>
                                <m:mo>−</m:mo>
                                <m:mn>3</m:mn>
                                <m:mi>y</m:mi>
                              </m:mtd>
                              <m:mtd columnalign="center">
                                <m:mo>=</m:mo>
                              </m:mtd>
                              <m:mtd columnalign="left">
                                <m:mn>3</m:mn>
                              </m:mtd>
                            </m:mtr>
                          </m:mtable>
                        </m:mrow>
                        <m:mo accent="true">―</m:mo>
                      </m:munder>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="left">
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mn>5</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>10</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="left">
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mi>x</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>2</m:mn>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
              </m:mrow>
            </m:math><newline/><newline/></para>
          <para id="para-00029"><m:math display="inline">
              <m:mrow>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>2</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>3</m:mn>
                      <m:mi>y</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>7</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>2</m:mn>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mn>2</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                      <m:mo>+</m:mo>
                      <m:mn>3</m:mn>
                      <m:mi>y</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>7</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>4</m:mn>
                      <m:mo>+</m:mo>
                      <m:mn>3</m:mn>
                      <m:mi>y</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>7</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>3</m:mn>
