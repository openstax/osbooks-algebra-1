<exercise class="RFM1">
  <problem>
    <title>Extending Your Thinking</title>
    
    <para>This system has three equations:</para>
    
    <para>\(\left\{\begin{array}{c}3x+2y-z=7 \\-3x+5y+2z=-14\\3x+y-z=10\end{array}\right.\)</para>
    
    <para> Add the first two equations to get a new equation.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
  <para>Compare your answer:</para>
    
    <para>\(7y+z=-7\)</para>
  
  </solution></exercise>
<!--End interaction-->

<!--Q#2-->
<exercise class="RFM1">
  <problem>
    <para> Add the second two equations to get a new equation.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
  <para>Compare your answer:</para>
    
    <para>\(6y+z=-4\)</para>
    
    <para>Solve the system of your two new equations, then answer questions 3 and 4.</para>
  
  </solution></exercise>
<!--End interaction-->

<!--Q#3-->
<exercise class="RFM1">
  <problem>
    <para> What is the value of \(y\)?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
  <para>Compare your answer:</para>
    
    <para>-3</para>
  
  </solution></exercise>
<!--End interaction-->

<!--Q#4-->
<exercise class="RFM1">
  <problem>
    <para> What is the value of \(z\)?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
  <para>Compare your answer:</para>
    
    <para>14</para>
  
  </solution></exercise>
<!--End interaction-->

<!--Q#5-->
<exercise class="RFM1">
  <problem>
    <para>Solve the original system of equations, then answer questions 5 – 7.</para>
    
    <para> What is the value of \(x\)?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
  <para>Compare your answer:</para>
    
    <para>9</para>
  
  </solution></exercise>
<!--End interaction-->

<!--Q#6-->
<exercise class="RFM1">
  <problem>
    <para> What is the value of \(y\)?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
  <para>Compare your answer:</para>
    
    <para>-3</para>
  
  </solution></exercise>
<!--End interaction-->

<!--Q#7-->
<exercise class="RFM1">
  <problem>
    <para> What is the value of \(z\)?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
