    <md:title>2.5.3: Solving Systems of Linear Equations in Two Variables</md:title>
    <md:uuid>ba7f6a8e-f682-4952-987a-91e897677366</md:uuid>
  </metadata>
  <content>
    <section>
      <title>Activity</title>
      <para>Solve each system of equations without graphing, show your reasoning, and check your
        solutions.</para>
      <para>System A</para>
      <para>\(\left\{\begin{array}{c}2x+3y=7\\−2x+4y=14\end{array}\right.\)</para>
      <para>Use System A to answer questions 1 – 3.</para>

        <exercise id="_7d48562a-3735-44df-9bcc-465bc371c8cb" class="multiple-choice">
          <problem>
            <para>What is the value of \(x\)?</para>
          </problem>
          <solution>
            <para>Correct! -1</para>
            <para>The correct answer is -1.</para>
          </solution>
        </exercise>
        <exercise id="_6547e405-e041-419c-8f86-b77e2538434c" class="multiple-choice">
          <problem>
            <para>What is the value of \(y\)?</para>
          </problem>
          <solution>
            <para>Correct! 3</para>
            <para>The correct answer is 3.</para>
          </solution>
        </exercise>
<!--Q#3-->
      <exercise>
        <problem>
          <para>Show your reasoning and check the solution.</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>

          <para>
            \(\begin{array}{l}\underline{\begin{array}{rcl}2x+3y&amp;=&amp;7\\+\;\;\;\;\;\;-2x+4y&amp;=&amp;14\end{array}}\\\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;7y=21\\\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;y=3\end{array}\)</para>


          <para>
            \(\begin{array}{rcl}2x+3y&amp;=&amp;7\\2x+3(3)&amp;=&amp;7\\2x+9&amp;=&amp;7\\2x&amp;=&amp;-2\\x&amp;=&amp;-1\end{array}\)</para>


          <para>
            \(\begin{array}{rcl}2x+3y&amp;=&amp;7\\2(-1)+3(3)&amp;=&amp;7\\-2+9&amp;=&amp;7\\7&amp;=&amp;7\checkmark\end{array}\)</para>


          <para>
            \(\begin{array}{rcl}-2x+4y&amp;=&amp;14\\-2(-1)+4(3)&amp;=&amp;14\\2+12&amp;=&amp;14\\14&amp;=&amp;14\checkmark\end{array}\)</para>

        </solution>
      </exercise>
      <!--Interaction
      End -->

      <para>System B</para>
      <para>\(\left\{\begin{array}{c}2x+3y=7\\3x−3y=3\end{array}\right.\)</para>
      <para>Use System B to answer questions 4 – 6.</para>

        <exercise id="_9371dd7f-287f-4dce-a0ab-f2fa4973f004" class="multiple-choice">
          <problem>
            <para>What is the value of \(x\)?</para>
          </problem>
          <solution>
            <para>Correct! 2</para>
            <para>he correct answer is 2.</para>
          </solution>
        </exercise>
        <exercise id="_4ba901ba-785b-4668-a022-9bfd7cb9b71a" class="multiple-choice">
          <problem>
            <para>What is the value of \(y\)?</para>
          </problem>
          <solution>
            <para>Correct! 1</para>
            <para>The correct answer is 1.</para>
          </solution>
        </exercise>
<!--Q#6-->
      <exercise>
        <problem>
          <para>Show your reasoning and check the solution.</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>

          <para>
            \(\begin{array}{l}\underline{\begin{array}{rcl}2x+3y&amp;=&amp;7\\+\;\;\;\;\;3x-3y&amp;=&amp;3\end{array}}\\\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;5x=10\\\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;x=2\end{array}\)</para>


          <para>
            \(\begin{array}{rcl}2x+3y&amp;=&amp;7\\2(2)+3y&amp;=&amp;7\\4+3y&amp;=&amp;7\\3y&amp;=&amp;3\\y&amp;=&amp;1\end{array}\)</para>


          <para>
            \(\begin{array}{rcl}3x-3y&amp;=&amp;3\\3(2)-3(1)&amp;=&amp;3\\6-3&amp;=&amp;3\\3&amp;=&amp;3\checkmark\end{array}\)</para>


          <para>
            \(\begin{array}{rcl}2x+3y&amp;=&amp;7\\2(2)+3(1)&amp;=&amp;7\\4+3&amp;=&amp;7\\7&amp;=&amp;7\checkmark\end{array}\)</para>

        </solution>
      </exercise>
      <!--Interaction
      End -->

      <para>System C</para>
      <para>\(\left\{\begin{array}{c}2x+3y=5\\2x+4y=9\end{array}\right.\)</para>
      <para>Use System C to answer questions 7 – 9.</para>

        <exercise id="_4b98d858-50cc-469a-9314-0f58acc43018" class="multiple-choice">
          <problem>
            <para>What is the value of \(x\)?</para>
          </problem>
          <solution>
            <para>Correct! -3.5</para>
            <para>The correct answer is -3.5.</para>
          </solution>
        </exercise>
        <exercise id="ecb11637-feee-4e86-ab42-f24b8ade2458" class="multiple-choice">
          <problem>
            <para>What is the value of \(y\)?</para>
          </problem>
          <solution>
            <para>Correct! 4</para>
            <para>The correct answer is 4.</para>
          </solution>
        </exercise>

      <!--Q#9-->
      <exercise>
        <problem>
          <para>Show your reasoning and check the solution.</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>

          <para>\(\begin{array}{rcl}-1(2x+3y&amp;=&amp;5)\\-2x-3y&amp;=&amp;-5)\end{array}\)</para>


          <para>
            \(\begin{array}{l}\underline{\begin{array}{rcl}-2x-3y&amp;=&amp;-5\\+\;\;\;\;\;\;\;\;2x+4y&amp;=&amp;9\;\end{array}}\\\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;y=4\end{array}\)</para>


          <para>
            \(\begin{array}{rcl}2x+4y&amp;=&amp;9\\2x+4(4)&amp;=&amp;9\\2x+16&amp;=&amp;9\\2x&amp;=&amp;-7\\x&amp;=&amp;-\frac72\\&amp;=&amp;-3.5\end{array}\)</para>


          <para>
            \(\begin{array}{rcl}2x+3y&amp;=&amp;5\\2(-3.5)+3(4)&amp;=&amp;5\\-7+12&amp;=&amp;5\\5&amp;=&amp;5\checkmark\end{array}\)</para>


          <para>
            \(\begin{array}{rcl}2x+4y&amp;=&amp;9\\2(-3.5)+4(4)&amp;=&amp;9\\-7+16&amp;=&amp;9\\9&amp;=&amp;9\checkmark\end{array}\)</para>

        </solution>
      </exercise>
      <!--Interaction
      End -->

      <para>System D</para>
      <para>\(\left\{\begin{array}{c}6x+9y=48\\6x-5y=20\end{array}\right.\)</para>
      <para>Use System D to answer questions 10 – 12.</para>

        <exercise id="a47e0f0c-32ca-4955-9a85-015d3ea9610a" class="multiple-choice">
          <problem>
            <para>What is the value of \(x\)?</para>
          </problem>
          <solution>
            <para>Correct! 5</para>
            <para>The correct answer is 5.</para>
          </solution>
        </exercise>
        <exercise id="_8aae8ecb-1fd2-4d77-8697-2593aa423012" class="multiple-choice">
          <problem>
            <para>What is the value of \(y\)?</para>
          </problem>
          <solution>
            <para>Correct! 2</para>
            <para>The correct answer is 2.</para>
          </solution>
        </exercise>
<!--Q#12-->
      <exercise>
        <problem>
          <para>Show your reasoning and check the solution.</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>

          <para>\(\begin{array}{rcl}-1(6x+9y&amp;=&amp;48)\\-6x-9y&amp;=&amp;-48\end{array}\)</para>


          <para>
            \(\begin{array}{l}\underline{\begin{array}{rcl}-6x-9y&amp;=&amp;-48\\+\;\;\;\;\;\;\;\;\;\;\;\;6x-5y&amp;=&amp;20\end{array}}\\\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;-14y=-28\\\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;y=2\end{array}\)</para>


          <para>
            \(\begin{array}{rcl}6x-5y&amp;=&amp;20\\6x-5(2)&amp;=&amp;20\\6x-10&amp;=&amp;20\\6x&amp;=&amp;30\\x&amp;=&amp;5\end{array}\)</para>


          <para>
            \(\begin{array}{rcl}6x+9y&amp;=&amp;48\\6(5)+9(2)&amp;=&amp;48\\30+18&amp;=&amp;48\\48&amp;=&amp;48\checkmark\end{array}\)</para>


          <para>
            \(\begin{array}{rcl}6x-5y&amp;=&amp;20\\6(5)-5(2)&amp;=&amp;20\\30-10&amp;=&amp;20\\20&amp;=&amp;20\checkmark\end{array}\)</para>
        </solution>
      </exercise>
    </section>
