      <section id="sect-00002">
        <title>Are you ready for more?</title>
        <section class="numbered-exercises" id="sect-00003">
          <title>Extending Your Thinking</title>
          <para id="para-00064">This system has three equations:</para>

          <para id="para-00065"><m:math>
              <m:mrow>
                <m:mrow>
                  <m:mo stretchy="true" fence="true" form="prefix">{</m:mo>
                  <m:mtable>
                    <m:mtr>
                      <m:mtd columnalign="center">
                        <m:mn>3</m:mn>
                        <m:mi>x</m:mi>
                        <m:mo>+</m:mo>
                        <m:mn>2</m:mn>
                        <m:mi>y</m:mi>
                        <m:mo>−</m:mo>
                        <m:mi>z</m:mi>
                        <m:mo>=</m:mo>
                        <m:mn>7</m:mn>
                      </m:mtd>
                    </m:mtr>
                    <m:mtr>
                      <m:mtd columnalign="center">
                        <m:mo>−</m:mo>
                        <m:mn>3</m:mn>
                        <m:mi>x</m:mi>
                        <m:mo>+</m:mo>
                        <m:mn>5</m:mn>
                        <m:mi>y</m:mi>
                        <m:mo>+</m:mo>
                        <m:mn>2</m:mn>
                        <m:mi>z</m:mi>
                        <m:mo>=</m:mo>
                        <m:mo>−</m:mo>
                        <m:mn>14</m:mn>
                      </m:mtd>
                    </m:mtr>
                    <m:mtr>
                      <m:mtd columnalign="center">
                        <m:mn>3</m:mn>
                        <m:mi>x</m:mi>
                        <m:mo>+</m:mo>
                        <m:mi>y</m:mi>
                        <m:mo>−</m:mo>
                        <m:mi>z</m:mi>
                        <m:mo>=</m:mo>
                        <m:mn>10</m:mn>
                      </m:mtd>
                    </m:mtr>
                  </m:mtable>
                  <m:mo stretchy="true" fence="true" form="postfix"/>
                </m:mrow>
              </m:mrow>
            </m:math></para>
          <exercise class="RFM1" id="exer-00005">
            <problem id="prob-00013">
              <para id="para-00066">Add the first two equations to get a new equation.</para>
            </problem>
            <solution id="sol-00013">
              <para id="para-00067">Compare your answer: </para>

              <para id="para-00068"><m:math>
                  <m:mrow>
                    <m:mn>7</m:mn>
                    <m:mi>y</m:mi>
                    <m:mo>+</m:mo>
                    <m:mi>z</m:mi>
                    <m:mo>=</m:mo>
                    <m:mo>−</m:mo>
                    <m:mn>7</m:mn>
                  </m:mrow>
                </m:math></para>
            </solution>
          </exercise>
          <!--End
        interaction-->

          <!--Q#2-->
          <exercise class="RFM1" id="exer-00006">
            <problem id="prob-00014">
              <para id="para-00069">Add the second two equations to get a new equation.</para>
            </problem>
            <solution id="sol-00014">
              <para id="para-00070">Compare your answer: </para>

              <para id="para-00071"><m:math>
                  <m:mrow>
                    <m:mn>6</m:mn>
                    <m:mi>y</m:mi>
                    <m:mo>+</m:mo>
                    <m:mi>z</m:mi>
                    <m:mo>=</m:mo>
                    <m:mo>−</m:mo>
                    <m:mn>4</m:mn>
                  </m:mrow>
                </m:math></para>
              <para id="para-00072">Solve the system of your two new equations, then answer questions
                3 and 4.</para>
            </solution>
          </exercise>
          <!--End
        interaction-->

          <!--Q#3-->
          <exercise class="RFM1" id="exer-00007">
