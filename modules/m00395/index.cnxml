<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.2.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00395</md:content-id>
    <md:title>2.2.5: Practice</md:title>
    <md:uuid>a7d36700-2a38-46f8-ab3d-4d10d0927999</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>

        <exercise id="_1f209805-d7b2-47b1-8d9f-e26f07909497" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00002">Which of the following points is the solution to the system of equations that is
              graphed? 
                <media alt="Insert Alt Text">
                  <image mime-type="image/jpeg" src="../../media/Algebra-1_02_04_10_01.jpg"/>
                </media>
             </para>
            <para id="para-00003">Multiple Choice:</para>
            <para id="para-00004"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>20</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00005"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>20</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00006"><m:math><m:mrow><m:mn>45</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00007"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>15</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00001">
            <para id="para-00008">Correct! The two points intersect at the point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>15</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> so that is the solution
              of the system.</para>
            <para id="para-00009">Try again. Revisit activity 2.2.3.</para>
            <para id="para-00010">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>15</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_7b734813-1789-4f31-8e93-148a0efa37d1" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00011">Which of the following points is the solution to the system of equations that is
              graphed? 
                <media alt="Insert Alt Text">
                  <image mime-type="image/jpeg" src="../../media/Algebra-1_02_04_10_02.jpg"/>
                </media>
             </para>
            <para id="para-00012">Multiple Choice:</para>
            <para id="para-00013"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00014"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00015"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00016"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5.2</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00002">
            <para id="para-00017">Correct! The two points intersect at the point <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> so that is the solution
              of the system.</para>
            <para id="para-00018">Try again. Revisit activity 2.2.3.</para>
            <para id="para-00019">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_4ce91135-8284-4df5-b5c7-bd005f637908" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00020">What two equations are represented by the graph? Select <emphasis>two</emphasis>. 
                <media alt="Insert Alt Text">
                  <image mime-type="image/jpeg" src="../../media/Algebra-1_02_04_10_03.jpg"/>
                </media>
             </para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00021">Correct! The system of equations includes <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
            <para id="para-00022">Try again. Revisit activity 2.2.1.</para>
            <para id="para-00023">The correct answer is the system of equations includes <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math> and
              <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_357cb642-ec02-46bd-8cfd-1e9a42dc417a" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00024">What two equations are represented by the graph? Select <emphasis>two</emphasis>. 
                <media alt="Insert Alt Text">
                  <image mime-type="image/jpeg" src="../../media/Algebra-1_02_04_10_04.jpg"/>
                </media>
             </para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00025">Correct! The system of equations includes <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
            <para id="para-00026">Try again. Revisit activity 2.2.1.</para>
            <para id="para-00027">The correct answer is the system of equations includes <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>

      <para id="para-00028">For questions 5 – 8, use the following scenario and matching table.</para>
      <para id="para-00029">
        <quote id="quote-00001">A streaming service has two different membership plans. Option A charges $10 per
        month plus $5 for each movie. Option B charges $20 a month then $2 a movie.</quote>
     </para>
      <table class="unnumbered os-raise-doubleheadertable unnumbered" id="table-00001">
        <tgroup cols="6">
          <tbody>
            <row>
              <entry>
                <emphasis>
                  Number of movies in a month, <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>.
                </emphasis>
              </entry>
              <entry>
                <emphasis>0</emphasis>
              </entry>
              <entry>
                <emphasis>1</emphasis>
              </entry>
              <entry>
                <emphasis>2</emphasis>
              </entry>
              <entry>
                <emphasis>3</emphasis>
              </entry>
              <entry>
                <emphasis>4</emphasis>
              </entry>
            </row>
            <row>
              <entry>
                <emphasis>Option A</emphasis>
              </entry>
              <entry>10</entry>
              <entry>15</entry>
              <entry>20</entry>
              <entry>25</entry>
              <entry>30</entry>
            </row>
            <row>
              <entry>
                <emphasis>Option B</emphasis>
              </entry>
              <entry>20</entry>
              <entry>22</entry>
              <entry>24</entry>
              <entry>26</entry>
              <entry>28</entry>
            </row>
          </tbody>
        </tgroup>
      </table>


        <exercise id="a77aa2bc-c28c-4a82-bce2-f92d629bcdf3" class="multiple-choice">
          <problem id="prob-00005">

            <para id="para-00030">What is the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercept for Option A and Option B?</para>
            <para id="para-00031">Multiple Choice:</para>
            <para id="para-00032"><m:math><m:mrow><m:mi>O</m:mi><m:mi>p</m:mi><m:mi>t</m:mi><m:mi>i</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>A</m:mi><m:mi>:</m:mi><m:mn>10</m:mn><m:mspace linebreak="newline"/><m:mi>O</m:mi><m:mi>p</m:mi><m:mi>t</m:mi><m:mi>i</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>B</m:mi><m:mi>:</m:mi><m:mn>20</m:mn></m:mrow></m:math></para><para id="para-00033"><m:math><m:mrow><m:mi>O</m:mi><m:mi>p</m:mi><m:mi>t</m:mi><m:mi>i</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>A</m:mi><m:mi>:</m:mi><m:mn>20</m:mn><m:mspace linebreak="newline"/><m:mi>O</m:mi><m:mi>p</m:mi><m:mi>t</m:mi><m:mi>i</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>B</m:mi><m:mi>:</m:mi><m:mn>10</m:mn></m:mrow></m:math></para><para id="para-00034"><m:math><m:mrow><m:mi>O</m:mi><m:mi>p</m:mi><m:mi>t</m:mi><m:mi>i</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>A</m:mi><m:mi>:</m:mi><m:mn>5</m:mn><m:mspace linebreak="newline"/><m:mi>O</m:mi><m:mi>p</m:mi><m:mi>t</m:mi><m:mi>i</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>B</m:mi><m:mi>:</m:mi><m:mn>2</m:mn></m:mrow></m:math></para><para id="para-00035"><m:math><m:mrow><m:mi>O</m:mi><m:mi>p</m:mi><m:mi>t</m:mi><m:mi>i</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>A</m:mi><m:mi>:</m:mi><m:mn>2</m:mn><m:mspace linebreak="newline"/><m:mi>O</m:mi><m:mi>p</m:mi><m:mi>t</m:mi><m:mi>i</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>B</m:mi><m:mi>:</m:mi><m:mn>5</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00005">
            <para id="para-00036">Correct! The <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercepts are Option A = 10 and Option B = 20.</para>
            <para id="para-00037">Try again. Revisit activity 2.2.2.</para>
            <para id="para-00038">The correct answer is the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercepts are Option A = 10 and Option B = 20.</para>
          </solution>
        </exercise>
        <exercise id="d22fc5ee-0e88-4a81-a45f-ed0a3765594e" class="multiple-choice">
          <problem id="prob-00006">

            <para id="para-00039">What is the slope of Option A and Option B?</para>
            <para id="para-00040">Multiple Choice:</para>
            <para id="para-00041"><m:math><m:mrow><m:mi>O</m:mi><m:mi>p</m:mi><m:mi>t</m:mi><m:mi>i</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>A</m:mi><m:mi>:</m:mi><m:mfrac><m:mrow><m:mn>52</m:mn></m:mrow><m:mi>x</m:mi></m:mfrac><m:mo>=</m:mo><m:mn>9</m:mn><m:mspace linebreak="newline"/><m:mi>O</m:mi><m:mi>p</m:mi><m:mi>t</m:mi><m:mi>i</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>B</m:mi><m:mi>:</m:mi><m:mi>m</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para><para id="para-00042"><m:math><m:mrow><m:mi>O</m:mi><m:mi>p</m:mi><m:mi>t</m:mi><m:mi>i</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>A</m:mi><m:mi>:</m:mi><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mspace linebreak="newline"/><m:mi>O</m:mi><m:mi>p</m:mi><m:mi>t</m:mi><m:mi>i</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>B</m:mi><m:mi>:</m:mi><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math></para><para id="para-00043"><m:math><m:mrow><m:mi>O</m:mi><m:mi>p</m:mi><m:mi>t</m:mi><m:mi>i</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>A</m:mi><m:mi>:</m:mi><m:mi>m</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mspace linebreak="newline"/><m:mi>O</m:mi><m:mi>p</m:mi><m:mi>t</m:mi><m:mi>i</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>B</m:mi><m:mi>:</m:mi><m:mi>m</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para><para id="para-00044"><m:math><m:mrow><m:mi>O</m:mi><m:mi>p</m:mi><m:mi>t</m:mi><m:mi>i</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>A</m:mi><m:mi>:</m:mi><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>5</m:mn><m:mspace linebreak="newline"/><m:mi>O</m:mi><m:mi>p</m:mi><m:mi>t</m:mi><m:mi>i</m:mi><m:mi>o</m:mi><m:mi>n</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>B</m:mi><m:mi>:</m:mi><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00006">
            <para id="para-00045">Correct! The slopes are Option A = 5 and Option B = 2.</para>
            <para id="para-00046">Try again. Revisit activity 2.2.2.</para>
            <para id="para-00047">The correct answer is the slopes are Option A = 5 and Option B = 2..</para>
          </solution>
        </exercise>
        <exercise id="f1b30519-391e-4428-9902-f50ed11086aa" class="multiple-choice">
          <problem id="prob-00007">

            <para id="para-00048">What is the equation of Option A?</para>
            <para id="para-00049">Multiple Choice:</para>
            <para id="para-00050"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>10</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para><para id="para-00051"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>10</m:mn></m:mrow></m:math></para><para id="para-00052"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn></m:mrow></m:math></para><para id="para-00053"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>10</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00007">
            <para id="para-00054">Correct! The equation of the line for Option A is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn></m:mrow></m:math>.</para>
            <para id="para-00055">Try again. Revisit activity 2.2.2.</para>
            <para id="para-00056">The correct answer is the equation of the line for Option A is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_79950d77-b1c9-45cf-aa22-18aa372b6184" class="multiple-choice">
          <problem id="prob-00008">

            <para id="para-00057">What is the equation of Option B?</para>
            <para id="para-00058">Multiple Choice:</para>
            <para id="para-00059"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>20</m:mn></m:mrow></m:math></para><para id="para-00060"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>20</m:mn></m:mrow></m:math></para><para id="para-00061"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn></m:mrow></m:math></para><para id="para-00062"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00008">
            <para id="para-00063">Correct! The equation of the line for Option A is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn></m:mrow></m:math>.</para>
            <para id="para-00064">Try again. Revisit activity 2.2.2.</para>
            <para id="para-00065">The correct answer is the equation of the line for Option A is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>

      <para id="para-00066">For questions 9 - 12, use the following situation and graph.</para>
      <para id="para-00067">
        <quote id="quote-00002">A family buys a total of 32 tickets at a carnival. Ride tickets cost $1.50 each and
        food tickets cost $3.25 each. The family pays a total of $90 for the tickets. The situation
        is graphed below.</quote>
        <quote id="quote-00003">
          
            <media alt="Insert Alt Text">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_02_04_10_05.jpg"/>
            </media>
          
        </quote>
        <quote id="quote-00004">The
        <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-axis represents the number of ride tickets and the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-axis represents the number of
        food tickets.</quote>
     </para>

        <exercise id="e7633643-d341-4b95-9151-a83dc6c45559" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00068">Which line depicts the equation that represents the statement “A family buys a
              total of 32 tickets at a carnival”?</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00069">The orange, solid line</para>
          </solution>
        </exercise>

        <exercise id="d676f4bf-d5af-4c8f-865e-448984b5155a" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00070">The remaining line represents the statements “Ride tickets cost $1.50 each and
              food tickets cost $3.25 each. The family pays a total of $90 for the tickets.” Which
              equation corresponds to these statements and the remaining line?</para>
            <para id="para-00071">Multiple Choice:</para>
            <para id="para-00072">1.50x + 3.25y = 90</para>
            <para id="para-00073">3.25x + 1.50y = 90</para>
            <para id="para-00074">(1.50 + 3.25)x = 90y</para>
            <para id="para-00075">(1.50 + 3.25)y = 90x</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00076">Answer</para>
          </solution>
        </exercise>
        <exercise id="_7984860e-cdd8-4802-aa9d-f49cb162dbc9" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00077">What is the approximate number of ride tickets the family purchased?</para>
            <para id="para-00078">Multiple Choice:</para>
            <para id="para-00079">32</para>
            <para id="para-00080">60</para>
            <para id="para-00081">7</para>
            <para id="para-00082">24</para>
          </problem>
          <solution id="sol-00011">
            <para id="para-00083">Correct! The two lines intersect at approximately <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mo>,</m:mo><m:mn>24</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> and the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-value
              represents the number of ride tickets which is 8.</para>
            <para id="para-00084">Try again. Revisit activity 2.2.4.</para>
            <para id="para-00085">The correct answer is 8.</para>
          </solution>
        </exercise>

        <exercise id="_63f44116-78d4-4a5c-93fb-b8834627837e" class="multiple-choice">
          <problem id="prob-00012">
            <para id="para-00086">What is the approximate number of food tickets the family purchased?</para>
            <para id="para-00087">Multiple Choice:</para>
            <para id="para-00088">32</para>
            <para id="para-00089">60</para>
            <para id="para-00090">7</para>
            <para id="para-00091">24</para>
          </problem>
          <solution id="sol-00012">
            <para id="para-00092">Correct! The two lines intersect at (8,24) and the <emphasis effect="italics">y</emphasis>-value represents the number
              of food tickets which is 24.</para>
            <para id="para-00093">Try again. Revisit activity 2.2.4.</para>
            <para id="para-00094">The correct answer is 24.</para>
          </solution>
        </exercise>
    </section>
  </content>
</document>