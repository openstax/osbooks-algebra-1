    </exercise>
  <!--7-->
  <exercise data-content-id="04fe1149-392c-4842-b320-5e6b70b1efcb" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((x − 5)(x + 12)\)" data-solution-options="[&quot;\\((x − 5)(x + 12)\\)&quot;, &quot;\\((x − 20)(x + 3)\\)&quot;, &quot;\\((x − 10)(x + 3)\\)&quot;, &quot;\\((x − 4)(x + 15)\\)&quot;]">
    <problem>
      <para>\(x^2+7x −60\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.7.2.</para>
    </div>
    </exercise>
  <!--8-->
  <exercise data-content-id="f5493c4f-1803-422b-ae3a-97fcb91ff14c" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="80 and –1,  40 and –2, 20 and –4, 16 and –5, 10 and -8" data-solution-options="[&quot;80 and 1, 40 and 2, 20 and 4, 16 and 5, 10 and 8&quot;, &quot;–80 and 1,  –40 and 2,  –20 and 4, –16 and 5, –10 and 8 &quot;, &quot;–80 and –1, –40 and –2, –20 and –4, –16 and –5, –10 and –8 &quot;, &quot;80 and –1,  40 and –2, 20 and –4, 16 and –5, 10 and -8&quot;]">
    <problem>
      <para>Consider the expression \(x^2+bx - 80\), where the leading coefficient equals 1. Identify all the pairs of factors of –80 that would result in positive values of \(b\).</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.7.3.
      </para>
    </div>
    </exercise>
  <!--9-->
  <exercise data-content-id="6bd4b83c-e264-4c0f-8a69-dad59273eff7" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="–80 and 1, –40 and 2, –20 and 4, –16 and 5, –10 and 8" data-solution-options="[&quot;80 and 1, 40 and 2, 20 and 4, 16 and 5, 10 and 8&quot;, &quot;–80 and 1, –40 and 2, –20 and 4, –16 and 5, –10 and 8&quot;, &quot;–80 and –1, –40 and –2, –20 and –4, –16 and –5, –10 and –8&quot;, &quot;80 and –1, 40 and –2, 20 and –4, 16 and –5, 10 and –8&quot;]">
    <problem>
      <para>Consider the expression \(x^2+ bx - 80\), where the leading coefficient equals 1. Identify all the pairs of factors of –80 that would result in negative values of \(b\).</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.7.3.</para>
    </div>
    </exercise>
  <!--10-->
  <exercise data-content-id="700e7afa-248a-463e-95a9-e0cd18635916" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="– and – " data-solution-options="[&quot;– and – &quot;, &quot;+ and –&quot;, &quot;+ and +&quot;, &quot;– and +&quot;]">
    <problem>
      <para>Here are pairs of equivalent expressions: one in standard form and the other in factored form. Identify the missing symbols:</para>
      <para>\(x^2\; \square \; 15x \;\square\; 34\) and \((x + 2)(x − 17)\)</para>
    </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.7.4.</para>
    </div>
    </exercise>
