<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.7.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02203</md:content-id>
    <md:title>8.7.5: Practice</md:title>
    <md:uuid>bcb25926-f6fb-4732-9b57-62e61c88e311</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <exercise id="effa51f0-de35-4b1e-baca-468e423abcd4" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00002">For questions 1 – 7, find the factored form of the quadratic expression.</para>
          <para><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>12</m:mn></m:mrow></m:math></para><para id="para-00004">Multiple Choice:</para>
          <para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
        <solution id="sol-00001">
          <para id="para-00009">Try again. Revisit activity 8.7.2.</para>
          <para id="para-00010">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_541f6352-18b0-4797-8c08-9ab7db738202" class="multiple-choice">
        <problem id="prob-00002">
          <para><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>3</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>18</m:mn></m:mrow></m:math></para><para id="para-00012">Multiple Choice:</para>
          <para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>18</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
        <solution id="sol-00002">
          <para id="para-00017">Try again. Revisit activity 8.7.2.</para>
          <para id="para-00018">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_4fe26458-f975-4deb-ad0b-d7c70c4c76b7" class="multiple-choice">
        <problem id="prob-00003">
          <para><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>12</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>45</m:mn></m:mrow></m:math></para><para id="para-00020">Multiple Choice:</para>
          <para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>45</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>15</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
        <solution id="sol-00003">
          <para id="para-00025">Try again. Revisit activity 8.7.2.</para>
          <para id="para-00026">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>15</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="c2b8d400-0602-4f65-8025-e9164acf0ba1" class="multiple-choice">
        <problem id="prob-00004">
          <para><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>20</m:mn></m:mrow></m:math></para><para id="para-00028">Multiple Choice:</para>
          <para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>20</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
        <solution id="sol-00004">
          <para id="para-00033">Try again. Revisit activity 8.7.2.</para>
          <para id="para-00034">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_1f16b2c8-b765-4722-b7c2-c51b6c9597be" class="multiple-choice">
        <problem id="prob-00005">
          <para><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>35</m:mn></m:mrow></m:math></para><para id="para-00036">Multiple Choice:</para>
          <para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
        <solution id="sol-00005">
          <para id="para-00041">Try again. Revisit activity 8.7.2.</para>
          <para id="para-00042">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_2e2b5660-6a28-47b3-a87b-41b819da8420" class="multiple-choice">
        <problem id="prob-00006">
          <para><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>23</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>50</m:mn></m:mrow></m:math></para><para id="para-00044">Multiple Choice:</para>
          <para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>50</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>25</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>13</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
        <solution id="sol-00006">
          <para id="para-00049">Try again. Revisit activity 8.7.2.</para>
          <para id="para-00050">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>25</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_04fe1149-392c-4842-b320-5e6b70b1efcb" class="multiple-choice">
        <problem id="prob-00007">
          <para><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>60</m:mn></m:mrow></m:math></para><para id="para-00052">Multiple Choice:</para>
          <para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>12</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>20</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>15</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
        <solution id="sol-00007">
          <para id="para-00057">Try again. Revisit activity 8.7.2.</para>
          <para id="para-00058">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>12</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="f5493c4f-1803-422b-ae3a-97fcb91ff14c" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00059">Consider the expression <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>b</m:mi><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>80</m:mn></m:mrow></m:math>, where the leading coefficient equals 1. Identify all the pairs of factors of –80 that would result in positive values of <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>.</para>
          <para id="para-00060">Multiple Choice:</para>
          <para id="para-00061">80 and 1, 40 and 2, 20 and 4, 16 and 5, 10 and 8</para>
          <para id="para-00062">–80 and 1, –40 and 2, –20 and 4, –16 and 5, –10 and 8</para>
          <para id="para-00063">–80 and –1, –40 and –2, –20 and –4, –16 and –5, –10 and –8</para>
          <para id="para-00064">80 and –1, 40 and –2, 20 and –4, 16 and –5, 10 and -8</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00065">Try again. Revisit activity 8.7.3.</para>
          <para id="para-00066">The correct answer is 80 and –1, 40 and –2, 20 and –4, 16 and –5, 10 and -8.</para>
        </solution>
      </exercise>
      <exercise id="_6bd4b83c-e264-4c0f-8a69-dad59273eff7" class="multiple-choice">
        <problem id="prob-00009">
          <para id="para-00067">Consider the expression <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>b</m:mi><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>80</m:mn></m:mrow></m:math>, where the leading coefficient equals 1. Identify all the pairs of factors of –80 that would result in negative values of <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>.</para>
          <para id="para-00068">Multiple Choice:</para>
          <para id="para-00069">80 and 1, 40 and 2, 20 and 4, 16 and 5, 10 and 8</para>
          <para id="para-00070">–80 and 1, –40 and 2, –20 and 4, –16 and 5, –10 and 8</para>
          <para id="para-00071">–80 and –1, –40 and –2, –20 and –4, –16 and –5, –10 and –8</para>
          <para id="para-00072">80 and –1, 40 and –2, 20 and –4, 16 and –5, 10 and –8</para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00073">Try again. Revisit activity 8.7.3.</para>
          <para id="para-00074">The correct answer is –80 and 1, –40 and 2, –20 and 4, –16 and 5, –10 and 8.</para>
        </solution>
      </exercise>
      <exercise id="_700e7afa-248a-463e-95a9-e0cd18635916" class="multiple-choice">
        <problem id="prob-00010">
          <para id="para-00075"><m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mspace width="0.278em"/><m:mi>◻</m:mi><m:mspace width="0.278em"/><m:mn>15</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mi>◻</m:mi><m:mspace width="0.278em"/><m:mn>34</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>17</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00076">Here are pairs of equivalent expressions: one in standard form and the other in factored form. Identify the missing symbols:</para>
          <para id="para-00077">Multiple Choice:</para>
          <para id="para-00078">– and –</para>
          <para id="para-00079">+ and –</para>
          <para id="para-00080">+ and +</para>
          <para id="para-00081">– and +</para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00082">Try again. Revisit activity 8.7.4.</para>
          <para id="para-00083">The correct answer is − and −.</para>
        </solution>
      </exercise>
    </section>
  </content>
