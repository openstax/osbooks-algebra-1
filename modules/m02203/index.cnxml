  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="c7c3407a-17e8-4268-b175-4d24af8cfd5e" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--1-->
  <exercise data-content-id="effa51f0-de35-4b1e-baca-468e423abcd4" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((x − 2)(x + 6)\)" data-solution-options="[&quot;\\((x − 2)(x − 6)\\)&quot;, &quot;\\((x + 3)(x − 4)\\)&quot;, &quot;\\((x + 2)(x − 6)\\)&quot;, &quot;\\((x − 2)(x + 6)\\)&quot;]">
    <problem>
      <para>For questions 1 – 7, find the factored form of the quadratic expression.</para>
      <para>\(x^2+4x − 12\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.7.2.</para>
    </div>
    </exercise>
  <!--2-->
  <exercise data-content-id="541f6352-18b0-4797-8c08-9ab7db738202" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((x − 6)(x + 3)\)" data-solution-options="[&quot;\\((x − 9)(x + 2)\\)&quot;, &quot;\\((x − 6)(x + 3)\\)&quot;, &quot;\\((x − 18)(x + 1)\\)&quot;, &quot;\\((x − 7)(x + 3)\\)&quot;]">
    <problem>
      <para>\(x^2−3x −18\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.7.2.</para>
    </div>
    </exercise>
  <!--3-->
  <exercise data-content-id="4fe26458-f975-4deb-ad0b-d7c70c4c76b7" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((x − 15)(x + 3)\)" data-solution-options="[&quot;\\((x − 45)(x + 1)\\)&quot;, &quot;\\((x − 8)(x − 4)\\)&quot;, &quot;\\((x − 9)(x + 5)\\)&quot;, &quot;\\((x − 15)(x + 3)\\)&quot;]">
    <problem>
      <para>\(x^2− 12x − 45\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.7.2.</para>
    </div>
    </exercise>
  <!--4-->
  <exercise data-content-id="c2b8d400-0602-4f65-8025-e9164acf0ba1" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((x − 5)(x + 4)\)" data-solution-options="[&quot;\\((x − 10)(x + 2)\\)&quot;, &quot;\\((x − 5)(x + 4)\\)&quot;, &quot;\\((x − 20)(x + 1)\\)&quot;, &quot;\\((x + 5)(x − 4)\\)&quot;]">
    <problem>
      <para>\(x^2−x −20\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.7.2.</para>
    </div>
    </exercise>
  <!--5-->
  <exercise data-content-id="1f16b2c8-b765-4722-b7c2-c51b6c9597be" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((x − 5)(x + 7)\)" data-solution-options="[&quot;\\((x − 5)(x + 7)\\)&quot;, &quot;\\((x + 5)(x + 7)\\)&quot;, &quot;\\((x + 5)(x − 7)\\)&quot;, &quot;\\((x − 5)(x − 7)\\)&quot;]">
    <problem>
      <para>\(x^2+2x −35\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.7.2.</para>
    </div>
    </exercise>
  <!--6-->
  <exercise data-content-id="2e2b5660-6a28-47b3-a87b-41b819da8420" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((x − 25)(x + 2)\)" data-solution-options="[&quot;\\((x − 10)(x + 5)\\)&quot;, &quot;\\((x − 50)(x + 1)\\)&quot;, &quot;\\((x − 25)(x + 2)\\)&quot;, &quot;\\((x − 10)(x − 13)\\)&quot;]">
    <problem>
      <para>\(x^2−23x −50\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
