<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.6.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00952</md:content-id>
    <md:title>4.6.6: Practice</md:title>
    <md:uuid>25cefbb4-21e5-4134-9622-778cd6f10f7d</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>

        <exercise id="_2edfb5a6-2a2d-4b15-aba3-7fcdc835192b" class="multiple-choice">
          <problem id="prob-00001">

            <para id="para-00002">This graph represents Andre’s distance from his bicycle as he walks in a park.</para>
            <para id="para-00003">Decide whether the following statements are true or false.</para>
            <para id="para-00004">The graph has multiple horizontal intercepts.</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00005">Correct! True</para>
            <para id="para-00006">Try again. Take a moment to think about what you learned in activit ies 4.6.2-4.6.4.</para>
            <para id="para-00007">The correct answer is True.</para>
          </solution>
        </exercise>
        <exercise id="_7bfa27ce-1a34-45fc-ae81-c6b62d2c7364" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00008">A horizontal intercept of the graph represents the time when Andre was with his bike.</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00009">Correct! True</para>
            <para id="para-00010">Try again. Revisit activities 4.6.2-4.6.4.</para>
            <para id="para-00011">The correct answer is True.</para>
          </solution>
        </exercise>
        <exercise id="_36e11728-cc0e-4542-928c-89aa46d9aaa6" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00012">A maximum of the graph is the point (17,1)</para>
          </problem>
          <solution id="sol-00003">
            
            <para id="para-00013">Try again. Revisit activities 4.6.2-4.6.4.</para>
            <para id="para-00014">The correct answer is false.</para>
          </solution>
        </exercise>
        <exercise id="a404b2e6-3119-433d-a9a3-4392b006b4bb" class="multiple-choice">
          <problem id="prob-00004">

            <para id="para-00015">The graph represents the temperature, in degrees Fahrenheit, as a function of time.</para>
            <para id="para-00016">At what hour in the afternoon does the maximum of the graph occur? Hint: Do not enter commas or spaces in your answer.</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00017">Correct! 3 p.m.</para>
            <para id="para-00018">Try again. Revisit activities 4.6.4.</para>
            <para id="para-00019">The correct answer is 3 p.m.</para>
          </solution>
        </exercise>
        <exercise id="_50cd62ca-0eb7-4cb5-b9b1-1e205ac79cec" class="multiple-choice">
          <problem id="prob-00005">

            <para id="para-00020">Match each feature of the situation with a corresponding statement in function notation.</para>
            <para id="para-00021"><m:math><m:mrow><m:mi>h</m:mi><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00005">
            <para id="para-00022">Correct! Starting height</para>
            <para id="para-00023">Try again. Revisit activity 4.6.3.</para>
            <para id="para-00024">The correct answer is Starting height.</para>
          </solution>
        </exercise>
        <exercise id="_4321f5b0-5277-42cb-8710-3a193370112f" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00025"><m:math><m:mrow><m:mi>h</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1.5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00006">
            <para id="para-00026">Correct! Minimum height</para>
            <para id="para-00027">Try again. Revisit activity 4.6.3.</para>
            <para id="para-00028">The correct answer is Minimum height.</para>
          </solution>
        </exercise>
        <exercise id="f8827eaa-9c81-457c-90b0-04d36a637ab7" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00029"><m:math><m:mrow><m:mi>h</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00007">
            <para id="para-00030">Correct! Maximum height</para>
            <para id="para-00031">Try again. Revisit activity 4.6.3.</para>
            <para id="para-00032">The correct answer is Maximum height.</para>
          </solution>
        </exercise>
        <exercise id="_2d581c61-654a-4e65-b025-52d8746edc03" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00033"><m:math display="inline"><m:mrow><m:mi>h</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math> for <m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mi>≤</m:mi><m:mi>t</m:mi><m:mi>≤</m:mi><m:mn>8</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00034">Correct! Height staying the same</para>
            <para id="para-00035">Try again. Revisit activity 4.6.3.</para>
            <para id="para-00036">The correct answer is Height staying the same.</para>
          </solution>
        </exercise>
        <exercise id="c322ec48-07c3-4c29-8e66-2583a3cf0c54" class="multiple-choice">
          <problem id="prob-00009">

            <para id="para-00037">The graph of <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> is provided.</para>
            <para id="para-00038">What is <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>?

        </para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00039">Correct!  The value of <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math> when <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> is 2 or <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
            <para id="para-00040">Try again. Revisit activities 4.6.2-4.6.4.</para>
            <para id="para-00041">The correct answer is the value of <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math> when <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> is 2 or <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_6b79e68e-ba10-4f57-bb67-d3dfe1fadd9f" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00042">What is the value of <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>?

        </para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00043">Correct! <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
            <para id="para-00044">Try again. Revisit activities 4.6.2-4.6.4.</para>
            <para id="para-00045">The correct answer is <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_871059dc-c8af-4dff-af07-3b73008398b5" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00046">Shannon is running on a flat, rocky trail that eventually rises up a steep mountain. The graph below represents the total distance she covers with respect to time. 
          
          <media alt="Insert Alt Text"><image mime-type="image/jpeg" src="../../media/Algebra-1_04_09_13_01.jpg"/></media></para>
            <para id="para-00047">How many miles does Shannon run in 60 minutes?</para>
          </problem>
          <solution id="sol-00011">
            <para id="para-00048">Correct! 3 miles</para>
            <para id="para-00049">Try again. Revisit activities 4.6.2-4.6.4.</para>
            <para id="para-00050">The correct answer is 3 miles.</para>
          </solution>
        </exercise>

    </section>
  </content></document>