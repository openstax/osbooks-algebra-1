            </exercise>

            <!--Interaction
        End -->

          <exercise id="_1fd4bad7-932b-4253-85d8-cb8048e5005b" class="multiple-choice">
              <problem id="prob-00025">
                <para id="para-00112">Identify the <m:math display="inline">
                    <m:mrow>
                      <m:mi>x</m:mi>
                    </m:mrow>
                  </m:math>
            coordinate of the solution.</para>
              </problem>
              <solution id="sol-00025">
                <para id="para-00113">4.</para>
              </solution>
            </exercise>

          <exercise id="_1bf21b85-50fb-45c0-8750-77d5b5cf4e0e" class="multiple-choice">
              <problem id="prob-00026">
                <para id="para-00115">Identify the <m:math display="inline">
                    <m:mrow>
                      <m:mi>y</m:mi>
                    </m:mrow>
                  </m:math>
            coordinate of the solution.</para>
              </problem>
              <solution id="sol-00026">
