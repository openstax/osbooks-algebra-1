<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Adding and Subtracting Systems of Equations and Using Their Graphs</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00427</md:content-id>
    <md:title>Adding and Subtracting Systems of Equations and Using Their Graphs</md:title>
    <md:uuid>5a63070c-106c-40ba-a9a0-9e50be342d17</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">
      <title>Activity</title>
      <note id="note-00001">
        <para id="para-00001">Access the <link url="https://openstax.org/r/desmos-guide">Desmos
        guide PDF</link> for tips on solving problems with the Desmos graphing calculator.</para>
      </note>

      <para id="para-00002">Below are three systems of equations you saw earlier.</para>
      <para id="para-00003">Use System A to answer questions 1 – 6.</para>
      <para id="para-00004">System A</para>
      <para id="para-00005"><m:math>
          <m:mrow>
            <m:mrow>
              <m:mo stretchy="true" fence="true" form="prefix">{</m:mo>
              <m:mtable>
                <m:mtr>
                  <m:mtd columnalign="center">
                    <m:mn>4</m:mn>
                    <m:mi>x</m:mi>
                    <m:mo>+</m:mo>
                    <m:mn>3</m:mn>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>10</m:mn>
                    <m:mspace width="0.278em"/>
                  </m:mtd>
                </m:mtr>
                <m:mtr>
                  <m:mtd columnalign="center">
                    <m:mo>−</m:mo>
                    <m:mn>4</m:mn>
                    <m:mi>x</m:mi>
                    <m:mo>+</m:mo>
                    <m:mn>5</m:mn>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>6</m:mn>
                  </m:mtd>
                </m:mtr>
              </m:mtable>
              <m:mo stretchy="true" fence="true" form="postfix"/>
            </m:mrow>
          </m:mrow>
        </m:math></para><!--Q#1-->


      <exercise id="exer-00001">
        <problem id="prob-00001">
          <!--QUESTION
          IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
          <para id="para-00006">Use the graphing tool or technology outside the course. Graph the
            equations for System A that represent this scenario using the Desmos tool below.</para>
          <media alt="insert alt text">
            <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
          </media>

        </problem>
        <solution id="sol-00001">
          <para id="para-00008">Compare your answer: </para>

          <media alt="Graph showing two intersecting lines: a red line with positive slope and a blue line with negative slope, on an x-y coordinate plane with axes labeled x and y.">
            <image mime-type="image/png" src="../../media/Algebra-1_02_06_06_01.png" width="300px"/>
          </media>

        </solution>
      </exercise>

      <!--Interaction
      End -->

      <exercise id="_4da44566-324d-4927-8c3f-81dbeb4e1863" class="multiple-choice">
        <problem id="prob-00002">

          <para id="para-00009">Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math> coordinate of the
            solution.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00011">1.</para>
        </solution>
      </exercise>

      <exercise id="efc3fc12-dbd8-4bf8-9e76-6c35c06b71c5" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00012">Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math> coordinate of the
            solution.</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00014">1.</para>
        </solution>
      </exercise>


      <!--Q#4-->
      <exercise id="exer-00002">
        <problem id="prob-00004">
          <para id="para-00015">Find the sum or difference of the two original equations that would
            enable the system to be solved.</para>

        </problem>
        <solution id="sol-00004">
          <para id="para-00016">Compare your answer: </para>
          <para id="para-00017">Your answer may vary, but here are some samples.</para>
          <list id="list-00001">
            <item>Sample Answer 1: <m:math display="inline">
                <m:mrow>
                  <m:mn>8</m:mn>
                  <m:mi>y</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>16</m:mn>
                </m:mrow>
              </m:math></item>
            <item>Sample Answer 2: <m:math display="inline">
                <m:mrow>
                  <m:mi>y</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>2</m:mn>
                </m:mrow>
              </m:math></item>
            <item>Sample Answer 3: <m:math display="inline">
                <m:mrow>
                  <m:mn>8</m:mn>
                  <m:mi>x</m:mi>
                  <m:mi>−</m:mi>
                  <m:mn>2</m:mn>
                  <m:mi>y</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>4</m:mn>
                </m:mrow>
              </m:math></item>
          </list>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#5-->

      <exercise id="exer-00003">
        <problem id="prob-00005">
          <!--QUESTION
          IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
          <para id="para-00018">Use the graphing tool or technology outside the course. Graph your
            third equation and the System A equations using the Desmos tool below.</para>
          <media alt="insert alt text">
            <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
          </media>
          <para id="para-00019"/>
        </problem>
        <solution id="sol-00005">
          <para id="para-00020">Compare your answer: </para>
          <para id="para-00021">

            <media alt="Graph of a system of three linear equations. The third graphed equation is the result of adding the first two equations together.">
              <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_06_06_02.svg"/>
            </media>

          </para>
        </solution>
      </exercise>

      <!--Interaction
      End -->
      <!--Q#6-->
      <exercise id="exer-00004">
        <problem id="prob-00006">
          <para id="para-00022">Make an observation about the graph.</para>

        </problem>
        <solution id="sol-00006">
          <para id="para-00023">Compare your answer: </para>
          <para id="para-00024">Your answer may vary, but here is a sample.</para>
          <para id="para-00025">All three lines intersect at <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>1</m:mn>
                <m:mo>,</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>. If
            students graph <m:math display="inline">
              <m:mrow>
                <m:mn>8</m:mn>
                <m:mi>y</m:mi>
                <m:mo>=</m:mo>
                <m:mn>16</m:mn>
              </m:mrow>
            </m:math>, the graph of the new
            equation is a horizontal line. If students graph <m:math display="inline">
              <m:mrow>
                <m:mn>8</m:mn>
                <m:mi>x</m:mi>
                <m:mi>−</m:mi>
                <m:mn>2</m:mn>
                <m:mi>y</m:mi>
                <m:mo>=</m:mo>
                <m:mn>4</m:mn>
              </m:mrow>
            </m:math>, the graph of the new
            equation is a new line between the two original lines.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <para id="para-00026">Use System B to answer questions 7 – 12.</para>
      <para id="para-00027">System B</para>
      <para id="para-00028"><m:math>
          <m:mrow>
            <m:mrow>
              <m:mo stretchy="true" fence="true" form="prefix">{</m:mo>
              <m:mtable>
                <m:mtr>
                  <m:mtd columnalign="center">
                    <m:mn>2</m:mn>
                    <m:mi>x</m:mi>
                    <m:mo>+</m:mo>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>4</m:mn>
                  </m:mtd>
                </m:mtr>
                <m:mtr>
                  <m:mtd columnalign="center">
                    <m:mi>x</m:mi>
                    <m:mo>−</m:mo>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>11</m:mn>
                  </m:mtd>
                </m:mtr>
              </m:mtable>
              <m:mo stretchy="true" fence="true" form="postfix"/>
            </m:mrow>
          </m:mrow>
        </m:math></para><!--Q#7-->

      <exercise id="exer-00005">
        <problem id="prob-00007">
          <!--QUESTION
          IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
          <para id="para-00029">Use the graphing tool or technology outside the course. Graph the
            equations for System B that represent this scenario using the Desmos tool below.</para>
          <media alt="insert alt text">
            <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
          </media>
          <para id="para-00030"/>
        </problem>
        <solution id="sol-00007">
          <para id="para-00031">Compare your answer: </para>
          <para id="para-00032">

            <media alt="Graph of a system of two linear equations. The orange line has a negative slope and the green line has a positive slope. The equations intersect in the fourth quadrant.">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_02_06_06_03.jpg" width="300px"/>
            </media>

          </para>
        </solution>
      </exercise>

      <!--Interaction
      End -->

      <exercise id="_7931bfa9-6a91-45e6-9178-17c48e4825a5" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00033">Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math> coordinate of the
            solution.</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00035">5.</para>
        </solution>
      </exercise>

      <exercise id="a3dfa06c-07eb-4022-9ead-e3e1ead6d268" class="multiple-choice">
        <problem id="prob-00009">

          <para id="para-00036">Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math> coordinate of the
            solution.</para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00038">-6.</para>
        </solution>
      </exercise>

      <!--Q#10-->
      <exercise id="exer-00006">
        <problem id="prob-00010">
          <para id="para-00039">Find the sum or difference of the two original equations that would
            enable the system to be solved.</para>

        </problem>
        <solution id="sol-00010">
          <para id="para-00040">Compare your answer: </para>
          <para id="para-00041">Your answer may vary, but here are some samples.</para>
          <list id="list-00002">
            <item>Sample Answer 1: <m:math display="inline">
                <m:mrow>
                  <m:mn>3</m:mn>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>15</m:mn>
                </m:mrow>
              </m:math></item>
            <item>Sample Answer 2: <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>5</m:mn>
                </m:mrow>
              </m:math></item>
          </list>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#11-->

      <exercise id="exer-00007">
        <problem id="prob-00011">
          <!--QUESTION
          IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
          <para id="para-00042">Use the graphing tool or technology outside the course. Graph your
            third equation and the System B equations using the Desmos tool below.</para>
          <media alt="insert alt text">
            <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
          </media>
          <para id="para-00043"/>
        </problem>
        <solution id="sol-00011">
          <para id="para-00044">Compare your answer: </para>
          <para id="para-00045">

            <media alt="Graph of a system of three linear equations. The third graphed equation is the result of adding the first two equations together.">
              <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_06_06_04.svg"/>
            </media>

          </para>
        </solution>
      </exercise>

      <!--Interaction
      End -->
      <!--Q#12-->
      <exercise id="exer-00008">
        <problem id="prob-00012">
          <para id="para-00046">Make an observation about the graph.</para>
        </problem>
        <solution id="sol-00012">
          <para id="para-00047">Compare your answer: </para>
          <para id="para-00048">Your answer may vary, but here is a sample. All three lines
            intersect at <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>5</m:mn>
                <m:mo>,</m:mo>
                <m:mo>−</m:mo>
                <m:mn>6</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>. If
            students graph <m:math display="inline">
              <m:mrow>
                <m:mn>3</m:mn>
                <m:mi>x</m:mi>
                <m:mo>=</m:mo>
                <m:mn>15</m:mn>
              </m:mrow>
            </m:math>, the graph of the new
            equation is a vertical line.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <para id="para-00049">Use System C to answer questions 13–18.</para>
      <para id="para-00050">System C</para>
      <para id="para-00051"><m:math>
          <m:mrow>
            <m:mrow>
              <m:mo stretchy="true" fence="true" form="prefix">{</m:mo>
              <m:mtable>
                <m:mtr>
                  <m:mtd columnalign="center">
                    <m:mn>8</m:mn>
                    <m:mi>x</m:mi>
                    <m:mo>+</m:mo>
                    <m:mn>11</m:mn>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>37</m:mn>
                  </m:mtd>
                </m:mtr>
                <m:mtr>
                  <m:mtd columnalign="center">
                    <m:mn>8</m:mn>
                    <m:mi>x</m:mi>
                    <m:mo>+</m:mo>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>7</m:mn>
                  </m:mtd>
                </m:mtr>
              </m:mtable>
              <m:mo stretchy="true" fence="true" form="postfix"/>
            </m:mrow>
          </m:mrow>
        </m:math></para><!--Q13-->

      <exercise id="exer-00009">
        <problem id="prob-00013">
          <!--QUESTION
          IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
          <para id="para-00052">Use the graphing tool or technology outside the course. Graph the
            equations for System C that represent this scenario using the Desmos tool below.</para>
          <media alt="insert alt text">
            <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
          </media>
          <para id="para-00053"/>
        </problem>
        <solution id="sol-00013">
          <para id="para-00054">Compare your answer: </para>
          <para id="para-00055">

            <media alt="Graph of a system of two linear equations. The orange line has a negative slope and the green line has a steeper, negative slope. The equations intersect in the first quadrant.">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_02_06_06_05.jpg" width="300px"/>
            </media>

          </para>
        </solution>
      </exercise>

      <!--Interaction
      End -->
      <!--Q#14-->
      <exercise id="exer-00010">
        <problem id="prob-00014">
          <para id="para-00056">Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math> coordinate of the
            solution.</para>

        </problem>
        <solution id="sol-00014">
          <para id="para-00057">Compare your answer: </para>
          <para id="para-00058"><m:math>
              <m:mrow>
                <m:mfrac>
                  <m:mn>1</m:mn>
                  <m:mn>2</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <exercise id="f55ee52c-860b-453e-bf06-d178b89a8990" class="multiple-choice">
        <problem id="prob-00015">

          <para id="para-00059">Identify the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math> coordinate of the
            solution.</para>
        </problem>
        <solution id="sol-00015">
          <para id="para-00061">3.</para>
        </solution>
      </exercise>

      <!--Q#16-->
      <exercise id="exer-00011">
        <problem id="prob-00016">
          <para id="para-00062">Find the sum or difference of the two original equations that would
            enable the system to be solved.</para>

        </problem>
        <solution id="sol-00016">
          <para id="para-00063">Compare your answer: </para>
          <para id="para-00064">Your answer may vary, but here are some samples.</para>
          <list id="list-00003">
            <item>Sample Answer 1: <m:math display="inline">
                <m:mrow>
                  <m:mn>10</m:mn>
                  <m:mi>y</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>30</m:mn>
                </m:mrow>
              </m:math></item>
            <item>Sample Answer 2: <m:math display="inline">
                <m:mrow>
                  <m:mi>−</m:mi>
                  <m:mn>10</m:mn>
                  <m:mi>y</m:mi>
                  <m:mo>=</m:mo>
                  <m:mi>−</m:mi>
                  <m:mn>30</m:mn>
                </m:mrow>
              </m:math></item>
            <item>Sample Answer 3: <m:math display="inline">
                <m:mrow>
                  <m:mi>y</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:math></item>
            <item>Sample Answer 4: (If the equations are added) <m:math display="inline">
                <m:mrow>
                  <m:mn>16</m:mn>
                  <m:mi>x</m:mi>
                  <m:mo>+</m:mo>
                  <m:mn>12</m:mn>
                  <m:mi>y</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>44</m:mn>
                </m:mrow>
              </m:math></item>
          </list>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#17-->

      <exercise id="exer-00012">
        <problem id="prob-00017">
          <!--QUESTION
          IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
          <para id="para-00065">Use the graphing tool or technology outside the course. Graph your
            third equation and the System C equations using the Desmos tool below.</para>
          <media alt=".">
            <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
          </media>
          <para id="para-00066"/>
        </problem>
        <solution id="sol-00017">
          <para id="para-00067">Compare your answer: </para>
          <para id="para-00068">

            <media alt="Graph of a system of three linear equations. The third graphed equation is the result of adding the first two equations together.">
              <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_06_06_06.svg"/>
            </media>

          </para>
        </solution>
      </exercise>

      <!--Interaction
      End -->
      <!--Q#18-->
      <exercise id="exer-00013">
        <problem id="prob-00018">
          <para id="para-00069">Make an observation about the graph.</para>

        </problem>
        <solution id="sol-00018">
          <para id="para-00070">Compare your answer: </para>
          <para id="para-00071">Your answer may vary, but here is a sample. All three lines
            intersect at <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mfrac>
                  <m:mn>1</m:mn>
                  <m:mn>2</m:mn>
                </m:mfrac>
                <m:mo>,</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>. If
            students graph <m:math display="inline">
              <m:mrow>
                <m:mn>10</m:mn>
                <m:mi>y</m:mi>
                <m:mo>=</m:mo>
                <m:mn>30</m:mn>
              </m:mrow>
            </m:math>, the graph of the new
            equation is a horizontal line.</para>
        </solution>
      </exercise>
    </section>
    <!--Interaction
      End -->
    <!-- "Start "Are you Ready for More? click to reveal.  If you have more than one on a page, you
      will need to change the Data-fire/data-wait-for-events for each set.-->
    <section id="sect-00002">
      <title>Are you ready for more?</title>

      <section class="numbered-exercises" id="sect-00003">
        <title>Extending Your Thinking</title>
        <para id="para-00072">Mai wonders what would happen if we multiply equations. That is, we
          multiply the expressions on the left side of the two equations and set them equal to the
          expressions on the right side of the two equations.</para>
        <para id="para-00073">Use System B to answer questions 1 – 4.</para>
        <para id="para-00074">System B</para>
        <para id="para-00075"><m:math>
            <m:mrow>
              <m:mrow>
                <m:mo stretchy="true" fence="true" form="prefix">{</m:mo>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="center">
                      <m:mn>2</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>4</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="center">
                      <m:mi>x</m:mi>
                      <m:mo>−</m:mo>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>11</m:mn>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
                <m:mo stretchy="true" fence="true" form="postfix"/>
              </m:mrow>
            </m:mrow>
          </m:math></para><!--Start
      interaction.  If multiple interactions appear under "are you ready for more?, they should all
      have matching "data-wait-for-event", which should also match the "data-fire-event" for the
      button. Note in this sample, they are all RFM1-->
        <exercise class="RFM1" id="exer-00014">
          <problem id="prob-00019">

            <para id="para-00076">Write out an equation that you would get if you multiply the two
              equations in this manner.</para>

          </problem>
          <solution id="sol-00019">
            <para id="para-00077">Compare your answer: </para>
            <para id="para-00078">Your answer may vary, but here is a sample. <m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mn>2</m:mn>
                  <m:mi>x</m:mi>
                  <m:mo>+</m:mo>
                  <m:mi>y</m:mi>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mi>x</m:mi>
                  <m:mi>−</m:mi>
                  <m:mi>y</m:mi>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mo>=</m:mo>
                  <m:mn>44</m:mn>
                </m:mrow>
              </m:math></para>
          </solution>
        </exercise>


        <!--Q#2-->
        <exercise class="RFM1" id="exer-00015">
          <problem id="prob-00020">
            <para id="para-00079">Does your original solution still work in this new equation?</para>
          </problem>
          <solution id="sol-00020">
            <para id="para-00080">Compare your answer: </para>
            <para id="para-00081">Yes</para>
          </solution>
        </exercise>
        <!--End
      interaction-->

        <!--Q#3-->
        <exercise class="RFM1" id="exer-00016">
          <problem id="prob-00021">
            <para id="para-00082">Use the graphing tool or technology outside the course. Graph your
              third equation and the System B equations using the Desmos tool below.</para>
            <media alt="insert alt text">
              <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
            </media>
            <para id="para-00083"/>
          </problem>
          <solution id="sol-00021">
            <para id="para-00084">Compare your answer: </para>
            <para id="para-00085">

              <media alt="Graph of a system of four equations. The blue line has a positive slope, the black line has a negative slope, the red line is vertical, and the green curve represents a non-linear equation. All of the equations intersect at the point (5, 6).">
                <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_06_06_07.svg"/>
              </media>

            </para>
          </solution>
        </exercise>
        <!--End
      interaction-->
        <!--Q#4-->
        <exercise class="RFM1" id="exer-00017">
          <problem id="prob-00022">
            <para id="para-00086">Explain if the approach of graphing the new equation is or is not
              particularly helpful.</para>
          </problem>
          <solution id="sol-00022">
            <para id="para-00087">Compare your answer: </para>
            <para id="para-00088">This approach is not helpful because the new equation is not a
              line and therefore not so easy to work with.</para>
          </solution>
        </exercise>
        <!--End
      interaction-->
      </section>
    </section>


    <section id="sect-00004">
      <note class="self-check" id="note-00002">
        <exercise id="exer-00020">
          <problem id="prob-00027">
            <para id="para-00089"><link class="os-embed" url="#exercise/Alg1_2_4_3_SC"/></para>
          </problem>
        </exercise>
      </note>
    </section>

    <section id="sect-00005">
      <title>Additional Resources</title>
      <section id="sect-00006">
        <title>Adding Systems of Equations and Using Their Graphs</title>
        <para id="para-00091">Look at the system of equations shown here:</para>
        <para id="para-00092"><m:math display="inline">
            <m:mrow>
              <m:mtable>
                <m:mtr>
                  <m:mtd columnalign="right"/>
                  <m:mtd columnalign="center"/>
                  <m:mtd columnalign="left">
                    <m:mrow>
                      <m:mo stretchy="true" fence="true" form="prefix">{</m:mo>
                      <m:mtable>
                        <m:mtr>
                          <m:mtd columnalign="left">
                            <m:mi>–</m:mi>
                            <m:mn>3</m:mn>
                            <m:mi>x</m:mi>
                            <m:mspace width="0.278em"/>
                            <m:mo>+</m:mo>
                            <m:mspace width="0.278em"/>
                            <m:mn>4</m:mn>
                            <m:mi>y</m:mi>
                            <m:mspace width="0.278em"/>
                            <m:mo>=</m:mo>
                            <m:mspace width="0.278em"/>
                            <m:mn>7</m:mn>
                          </m:mtd>
                        </m:mtr>
                        <m:mtr>
                          <m:mtd columnalign="left">
                            <m:mn>3</m:mn>
                            <m:mi>x</m:mi>
                            <m:mspace width="0.278em"/>
                            <m:mo>+</m:mo>
                            <m:mspace width="0.278em"/>
                            <m:mn>2</m:mn>
                            <m:mi>y</m:mi>
                            <m:mspace width="0.278em"/>
                            <m:mo>=</m:mo>
                            <m:mspace width="0.278em"/>
                            <m:mn>17</m:mn>
                          </m:mtd>
                        </m:mtr>
                      </m:mtable>
                      <m:mo stretchy="true" fence="true" form="postfix"/>
                    </m:mrow>
                  </m:mtd>
                </m:mtr>
              </m:mtable>
            </m:mrow>
          </m:math></para>
        <para id="para-00093">Let’s graph each equation on the coordinate plane. Identify the point
          of intersection.</para>

        <media alt="Graph of two lines intersecting at the point (3, 4).">
          <image mime-type="image/jpeg" src="../../media/Algebra-1_02_06_08_01.jpg" width="300px"/>
        </media>


        <para id="para-00094">The lines intersect at <m:math display="inline">
            <m:mrow>
              <m:mo stretchy="false">(</m:mo>
              <m:mn>3</m:mn>
              <m:mo>,</m:mo>
              <m:mn>4</m:mn>
              <m:mo stretchy="false">)</m:mo>
            </m:mrow>
          </m:math>.</para>
        <para id="para-00095">Add the two equations together. Simplify the resulting equation.</para>
        <para id="para-00096"><m:math>
            <m:mrow>
              <m:mtable rowlines="none solid none">
                <m:mtr>
                  <m:mtd columnalign="right">
                    <m:mo>−</m:mo>
                    <m:mn>3</m:mn>
                    <m:mi>x</m:mi>
                    <m:mo>+</m:mo>
                    <m:mn>4</m:mn>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>7</m:mn>
                  </m:mtd>
                </m:mtr>
                <m:mtr>
                  <m:mtd columnalign="right">
                    <m:mn>3</m:mn>
                    <m:mi>x</m:mi>
                    <m:mo>+</m:mo>
                    <m:mn>2</m:mn>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>17</m:mn>
                  </m:mtd>
                </m:mtr>
                <m:mtr>
                  <m:mtd columnalign="right">
                    <m:mn>6</m:mn>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>24</m:mn>
                  </m:mtd>
                </m:mtr>
                <m:mtr>
                  <m:mtd columnalign="right">
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>4</m:mn>
                  </m:mtd>
                </m:mtr>
              </m:mtable>
            </m:mrow>
          </m:math></para>
        <para id="para-00097">Graph the resulting equation on the same coordinate plane.</para>

        <media alt="Graph of three lines intersecting at the point (3,4).">
          <image mime-type="image/jpeg" src="../../media/Algebra-1_02_06_08_02.jpg" width="300px"/>
        </media>


        <para id="para-00098">All three lines intersect at <m:math display="inline">
            <m:mrow>
              <m:mo stretchy="false">(</m:mo>
              <m:mn>3</m:mn>
              <m:mo>,</m:mo>
              <m:mn>4</m:mn>
              <m:mo stretchy="false">)</m:mo>
            </m:mrow>
          </m:math>.</para>
        <para id="para-00099">You verified that by adding the two equations in the system, you
          created a third equation that is also true.</para>
        <para id="para-00100">The solution to the system is <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
              <m:mo>=</m:mo>
              <m:mn>3</m:mn>
            </m:mrow>
          </m:math>, <m:math display="inline">
            <m:mrow>
              <m:mi>y</m:mi>
              <m:mo>=</m:mo>
              <m:mn>4</m:mn>
            </m:mrow>
          </m:math>.</para>
        <section class="numbered-exercises" id="sect-00007">
          <note class="try" id="note-00003">
            <title>Adding Systems of Equations and Using Their Graphs</title>
        <para id="para-00101">Add
            the equations to find the resulting equation. Then graph all three equations to find the
            ordered pair where they intersect.</para>
        <para id="para-00102">Use this system of
            equations to answer questions 1 – 4.</para>
        <para id="para-00103"><m:math>
                <m:mrow>
                  <m:mrow>
                    <m:mo stretchy="true" fence="true" form="prefix">{</m:mo>
                    <m:mtable>
                      <m:mtr>
                        <m:mtd columnalign="center">
                          <m:mo>−</m:mo>
                          <m:mn>2</m:mn>
                          <m:mi>x</m:mi>
                          <m:mo>−</m:mo>
                          <m:mn>3</m:mn>
                          <m:mi>y</m:mi>
                          <m:mo>=</m:mo>
                          <m:mn>7</m:mn>
                        </m:mtd>
                      </m:mtr>
                      <m:mtr>
                        <m:mtd columnalign="center">
                          <m:mn>2</m:mn>
                          <m:mi>x</m:mi>
                          <m:mo>+</m:mo>
                          <m:mi>y</m:mi>
                          <m:mo>=</m:mo>
                          <m:mn>3</m:mn>
                        </m:mtd>
                      </m:mtr>
                    </m:mtable>
                    <m:mo stretchy="true" fence="true" form="postfix"/>
                  </m:mrow>
                </m:mrow>
              </m:math></para><!--Q#1-->
        <exercise id="exer-00018">
              <problem id="prob-00023">
                <para id="para-00104">Add the equations to find the resulting equation.</para>

              </problem>
              <solution id="sol-00023">
                <para id="para-00105">Compare your answer: </para>
                <para id="para-00106"><m:math display="inline">
                    <m:mrow>
                      <m:munder>
                        <m:mrow>
                          <m:mspace width="0.278em"/>
                          <m:mspace width="0.278em"/>
                          <m:mspace width="0.278em"/>
                          <m:mspace width="0.278em"/>
                          <m:mspace width="0.278em"/>
                          <m:mo>−</m:mo>
                          <m:mn>2</m:mn>
                          <m:mi>x</m:mi>
                          <m:mo>−</m:mo>
                          <m:mn>3</m:mn>
                          <m:mi>y</m:mi>
                          <m:mo>=</m:mo>
                          <m:mn>7</m:mn>
                          <m:mspace linebreak="newline"/>
                          <m:mo>+</m:mo>
                          <m:mspace width="0.278em"/>
                          <m:mspace width="0.278em"/>
                          <m:mspace width="0.278em"/>
                          <m:mspace width="0.278em"/>
                          <m:mspace width="0.278em"/>
                          <m:mspace width="0.278em"/>
                          <m:mspace width="0.278em"/>
                          <m:mn>2</m:mn>
                          <m:mi>x</m:mi>
                          <m:mo>+</m:mo>
                          <m:mi>y</m:mi>
                          <m:mo>=</m:mo>
                          <m:mn>3</m:mn>
                        </m:mrow>
                        <m:mo accent="true">―</m:mo>
                      </m:munder>
                      <m:mspace linebreak="newline"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mo>−</m:mo>
                      <m:mn>2</m:mn>
                      <m:mi>y</m:mi>
                      <m:mspace width="0.278em"/>
                      <m:mo>=</m:mo>
                      <m:mn>10</m:mn>
                      <m:mspace linebreak="newline"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mspace width="0.278em"/>
                      <m:mi>y</m:mi>
                      <m:mspace width="0.278em"/>
                      <m:mo>=</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>5</m:mn>
                      <m:mspace linebreak="newline"/>
                    </m:mrow>
                  </m:math></para>
                <para id="para-00107"><m:math display="inline">
                    <m:mrow>
                      <m:mtable>
                        <m:mtr>
                          <m:mtd columnalign="right">
                            <m:mn>2</m:mn>
                            <m:mi>x</m:mi>
                            <m:mo>+</m:mo>
                            <m:mspace width="0.278em"/>
                            <m:mi>y</m:mi>
                          </m:mtd>
                          <m:mtd columnalign="center">
                            <m:mo>=</m:mo>
                          </m:mtd>
                          <m:mtd columnalign="left">
                            <m:mn>3</m:mn>
                            <m:mspace width="0.278em"/>
                          </m:mtd>
                        </m:mtr>
                        <m:mtr>
                          <m:mtd columnalign="right">
                            <m:mn>2</m:mn>
                            <m:mi>x</m:mi>
                            <m:mo>+</m:mo>
                            <m:mspace width="0.278em"/>
                            <m:mo stretchy="false">(</m:mo>
                            <m:mo>−</m:mo>
                            <m:mn>5</m:mn>
                            <m:mo stretchy="false">)</m:mo>
                          </m:mtd>
                          <m:mtd columnalign="center">
                            <m:mo>=</m:mo>
                          </m:mtd>
                          <m:mtd columnalign="left">
                            <m:mn>3</m:mn>
                          </m:mtd>
                        </m:mtr>
                        <m:mtr>
                          <m:mtd columnalign="right">
                            <m:mn>2</m:mn>
                            <m:mi>x</m:mi>
                          </m:mtd>
                          <m:mtd columnalign="center">
                            <m:mo>=</m:mo>
                          </m:mtd>
                          <m:mtd columnalign="left">
                            <m:mn>8</m:mn>
                          </m:mtd>
                        </m:mtr>
                        <m:mtr>
                          <m:mtd columnalign="right">
                            <m:mi>x</m:mi>
                          </m:mtd>
                          <m:mtd columnalign="center">
                            <m:mo>=</m:mo>
                          </m:mtd>
                          <m:mtd columnalign="left">
                            <m:mn>4</m:mn>
                          </m:mtd>
                        </m:mtr>
                      </m:mtable>
                    </m:mrow>
                  </m:math></para>
              </solution>
            </exercise>
            <!--Interaction
        End -->

            <!--Q#2-->
        <exercise id="exer-00019">
              <problem id="prob-00024">
                <!--QUESTION
            IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
