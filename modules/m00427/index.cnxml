            height="400" />
          </media>
            <para>When you have finished graphing, then select the <emphasis>solution</emphasis>
              button to compare your work.</para>
          </problem>
          <solution>
            <para>Compare your answer:</para>
            <para>
              <figure class="unnumbered">
                <media alt="GRAPH OF THREE LINES THAT INTERSECT AT THE POINT (4,-5).">
                  <image mime-type="image/jpeg" src="../../media/Algebra-1_02_06_08_03.jpg" />
                </media>
              
           </para>
          </solution>
        </exercise>

        <!--Interaction
        End -->

          <exercise id="_1fd4bad7-932b-4253-85d8-cb8048e5005b" class="multiple-choice">
