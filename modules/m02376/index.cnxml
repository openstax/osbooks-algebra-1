<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.3.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02376</md:content-id>
    <md:title>9.3.5: Practice</md:title>
    <md:uuid>c42f5daf-8504-42b6-970c-01930936d003</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
        <exercise id="ce344af3-e2fc-47e5-89a0-723db7a50b6f" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00002">For the expressions in questions 1 – 4, choose which number would make the expression a perfect square. Then, choose an equivalent expression in factored form.</para>
            <para id="para-00003"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00004">What number can be added to make <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math> a perfect square?</para>
            <para id="para-00005">Multiple Choice:</para>
            <para id="para-00006"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para><para id="para-00007"><m:math><m:mrow><m:mfrac><m:mn>4</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para><para id="para-00008"><m:math><m:mrow><m:mfrac><m:mn>9</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para><para id="para-00009"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para></problem>
          <solution id="sol-00001">
            <para id="para-00010">Correct! <m:math display="inline"><m:mrow><m:mfrac><m:mn>9</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
            <para id="para-00011">Try again. Revisit activities 9.3.2 and 9.3.3.</para>
            <para id="para-00012">The correct answer is: <m:math display="inline"><m:mrow><m:mfrac><m:mn>9</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_7824a5c3-ccf6-4a27-a7c5-40d1d790cff9" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00013">Which expression is equivalent to <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math>?</para>
            <para id="para-00014">Multiple Choice:</para>
            <para id="para-00015"><m:math><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00016"><m:math><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00017"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00018"><m:math><m:mrow><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00002">
            <para id="para-00019">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00020">Try again. Revisit activities 9.3.2 and 9.3.3.</para>
            <para id="para-00021">The correct answer is: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_997a5371-4e56-4e04-ba7f-782c4c875a94" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00022"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>0.6</m:mn><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00023">What number can be added to make <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>0.6</m:mn><m:mi>x</m:mi></m:mrow></m:math> a perfect square?</para>
            <para id="para-00024">Multiple Choice:</para>
            <para id="para-00025">0.09</para>
            <para id="para-00026">0.81</para>
            <para id="para-00027">0.36</para>
            <para id="para-00028">0.03</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00029">Correct! 0.09</para>
            <para id="para-00030">Try again. Revisit activities 9.3.2 and 9.3.3.</para>
            <para id="para-00031">The correct answer is: 0.09.</para>
          </solution>
        </exercise>
        <exercise id="c6f1b4c5-0f89-4180-af96-32c5f02c5af2" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00032">Which expression is equivalent to <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>0.6</m:mn><m:mi>x</m:mi></m:mrow></m:math>?</para>
            <para id="para-00033">Multiple Choice:</para>
            <para id="para-00034"><m:math><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>0.6</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00035"><m:math><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>0.6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00036"><m:math><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mn>0.6</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00037"><m:math><m:mrow><m:mn>0.6</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00004">
            <para id="para-00038">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>0.6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00039">Try again. Revisit activities 9.3.2 and 9.3.3.</para>
            <para id="para-00040">The correct answer is: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>0.6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_844310e2-1516-4923-98b9-0f1c94bbd63a" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00041"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>11</m:mn><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00042">What number can be added to make <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>11</m:mn><m:mi>x</m:mi></m:mrow></m:math> a perfect square?</para>
            <para id="para-00043">Multiple Choice:</para>
            <para id="para-00044"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00045"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>25</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00046"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para><para id="para-00047"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>121</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para></problem>
          <solution id="sol-00005">
            <para id="para-00048">Correct! <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>121</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
            <para id="para-00049">Try again. Revisit activities 9.3.2 and 9.3.3.</para>
            <para id="para-00050">The correct answer is: <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>121</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_25442b64-c58b-4126-9f4b-9d092761dc32" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00051">Which expression is equivalent to <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>11</m:mn><m:mi>x</m:mi></m:mrow></m:math>?</para>
            <para id="para-00052">Multiple Choice:</para>
            <para id="para-00053"><m:math><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>11</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00054"><m:math><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00055"><m:math><m:mrow><m:mn>11</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00056"><m:math><m:mrow><m:mn>11</m:mn><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00006">
            <para id="para-00057">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00058">Try again. Revisit activities 9.3.2 and 9.3.3.</para>
            <para id="para-00059">The correct answer is: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_8cca33a0-b21b-4a19-8aa6-b42f50a7644c" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00060"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00061">What number can be added to make <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi></m:mrow></m:math> a perfect square?</para>
            <para id="para-00062">Multiple Choice:</para>
            <para id="para-00063"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>25</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00064"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>25</m:mn></m:mrow><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00065"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para><para id="para-00066"><m:math><m:mrow><m:mfrac><m:mn>6</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para></problem>
          <solution id="sol-00007">
            <para id="para-00067">Correct! <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>25</m:mn></m:mrow><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
            <para id="para-00068">Try again. Revisit activities 9.3.2 and 9.3.3.</para>
            <para id="para-00069">The correct answer is: <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>25</m:mn></m:mrow><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="d10954da-8650-4ab4-9d0c-a6a6f2383aa1" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00070">Which expression is equivalent to <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi></m:mrow></m:math>?</para>
            <para id="para-00071">Multiple Choice:</para>
            <para id="para-00072"><m:math><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00073"><m:math><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00074"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00075"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
          <solution id="sol-00008">
            <para id="para-00076">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00077">Try again. Revisit activities 9.2.2 and 9.2.3.</para>
            <para id="para-00078">The correct answer is: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="feefda53-6a1a-4443-95d3-5229cbb484a1" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00079">What number can be added to make <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>x</m:mi></m:mrow></m:math> a perfect square?</para>
            <para id="para-00080">Multiple Choice:</para>
            <para id="para-00081"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para><para id="para-00082"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para><para id="para-00083">1</para>
            <para id="para-00084">0</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00085">Correct! <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
            <para id="para-00086">Try again. Revisit activities 9.2.2 and 9.2.3.</para>
            <para id="para-00087">The correct answer is: <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="c4829eed-28cd-415d-b5d2-48483676a0b1" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00088">What number can be added to make <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi></m:mrow></m:math> a perfect square?</para>
            <para id="para-00089">Multiple Choice:</para>
            <para id="para-00090"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para><para id="para-00091"><m:math><m:mrow><m:mfrac><m:mn>4</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para><para id="para-00092"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>9</m:mn></m:mrow><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00093"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para></problem>
          <solution id="sol-00010">
            <para id="para-00094">Correct! <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>9</m:mn></m:mrow><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
            <para id="para-00095">Try again. Revisit activities 9.2.2 and 9.2.3.</para>
            <para id="para-00096">The correct answer is: <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>9</m:mn></m:mrow><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="e3c26867-40b6-4860-8b80-1204ffe62885" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00097">Noah is solving the equation <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>15</m:mn><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math>. He begins by rewriting the expression on the left in factored form and writes <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math>. He does not know what to do next.</para>
            <para id="para-00098">Do you think using the factored form is the best way for Noah to solve this equation?</para>
          </problem>
          <solution id="sol-00011">
            <para id="para-00099">Correct! No. Noah should use completing the square.</para>
            <para id="para-00100">Try again. Revisit activity 9.3.2.</para>
            <para id="para-00101">The correct answer is No. Noah should use completing the square.</para>
          </solution>
        </exercise>
        <exercise id="b310b720-bf24-4fbd-9217-83fe38560355" class="multiple-choice">
          <problem id="prob-00012">
            <para id="para-00102">Solve the original equation, then choose the <emphasis>two</emphasis> roots.</para>
          </problem>
          <solution id="sol-00012">
            <para id="para-00103">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
            <para id="para-00104">Try again. Revisit activities 9.2.2 and 9.2.3.</para>
            <para id="para-00105">The correct answers are: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="e1a27da5-2ce6-41c4-a658-1abd528f4ea3" class="multiple-choice">
          <problem id="prob-00013">
            <para id="para-00106">An equation and its solutions are given. Solve the equation by completing the square, then choose whether you agree or disagree with the given solutions.</para>
            <para id="para-00107"><m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>20</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>50</m:mn><m:mo>=</m:mo><m:mn>14</m:mn></m:mrow></m:math>. The solutions are <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>18</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
          </problem>
          <solution id="sol-00013">
            <para id="para-00108">Correct! Agree. The correct solutions are <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>18</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
            <para id="para-00109">Try again. Revisit activities 9.3.3 and 9.3.4.</para>
            <para id="para-00110">The correct answer is Disagree. The correct solutions are <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>18</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_8d585fd8-2607-4e8f-af9d-0fb10aeea7a4" class="multiple-choice">
          <problem id="prob-00014">
            <para id="para-00111"><m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>1.6</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0.36</m:mn></m:mrow></m:math>. The solutions are <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1.8</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0.2</m:mn></m:mrow></m:math>.</para>
          </problem>
          <solution id="sol-00014">
            <para id="para-00112">Correct! Agree. <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1.8</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0.2</m:mn></m:mrow></m:math></para>
            <para id="para-00113">Try again. Revisit activities 9.3.3 and 9.3.4.</para>
            <para id="para-00114">The correct answer is Agree. <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1.8</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0.2</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_3993561c-b0a9-4e42-af8b-5827ff6f7933" class="multiple-choice">
          <problem id="prob-00015">
            <para id="para-00115"><m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math>. The solutions are <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>12</m:mn></m:mrow></m:math>.</para>
          </problem>
          <solution id="sol-00015">
            <para id="para-00116">Correct! Disagree. The correct solutions are <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math>.</para>
            <para id="para-00117">Try again. Revisit activities 9.3.3 and 9.3.4.</para>
            <para id="para-00118">The correct answer is Disagree. The correct solutions are <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="e510a689-c1be-4c61-b360-d98732756763" class="multiple-choice">
          <problem id="prob-00016">
            <para id="para-00119">Solve each equation, then choose the <emphasis>two</emphasis> roots.</para>
            <para id="para-00120"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>0.5</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0.5</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00016">
            <para id="para-00121">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.5</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
            <para id="para-00122">Try again. Revisit activities 9.3.2 – 9.3.4.</para>
            <para id="para-00123">The correct answers are: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.5</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_27b99384-bd9f-47a5-aed0-2d1cbeafe84d" class="multiple-choice">
          <problem id="prob-00017">
            <para id="para-00124"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>0.8</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0.09</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00017">
            <para id="para-00125">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.9</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0.1</m:mn></m:mrow></m:math></para>
            <para id="para-00126">Try again. Revisit activities 9.3.2 – 9.3.4.</para>
            <para id="para-00127">The correct answers are: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.9</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0.1</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_6c1881a7-7b81-4541-ba80-46f685e9b9ba" class="multiple-choice">
          <problem id="prob-00018">
            <para id="para-00128"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>56</m:mn></m:mrow><m:mrow><m:mn>36</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para></problem>
          <solution id="sol-00018">
            <para id="para-00129">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>14</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
            <para id="para-00130">Try again. Revisit activities 9.3.2 – 9.3.4.</para>
            <para id="para-00131">The correct answers are: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>14</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac></m:mrow></m:math>.</para>
          </solution>
        </exercise>
    </section>
  </content>
</document>