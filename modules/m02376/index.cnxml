<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.3.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02376</md:content-id>
    <md:title>9.3.5: Practice</md:title>
    <md:uuid>c42f5daf-8504-42b6-970c-01930936d003</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
        <exercise id="ce344af3-e2fc-47e5-89a0-723db7a50b6f" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00002">For the expressions in questions 1 – 4, choose which number would make the expression a perfect square. Then, choose an equivalent expression in factored form.</para>
            <para id="para-00003">\(x^2+3x\)</para>
            <para id="para-00004">What number can be added to make \(x^2+3x\) a perfect square?</para>
            <para id="para-00005">Multiple Choice:</para>
            <para id="para-00006">\(\frac23\)</para>
            <para id="para-00007">\(\frac49\)</para>
            <para id="para-00008">\(\frac94\)</para>
            <para id="para-00009">\(-\frac23\)</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00010">Correct! \(\frac94\)</para>
            <para id="para-00011">Try again. Revisit activities 9.3.2 and 9.3.3.</para>
            <para id="para-00012">The correct answer is: \(\frac94\).</para>
          </solution>
        </exercise>
        <exercise id="_7824a5c3-ccf6-4a27-a7c5-40d1d790cff9" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00013">Which expression is equivalent to \(x^2+3x\)?</para>
            <para id="para-00014">Multiple Choice:</para>
            <para id="para-00015">\(x(x + 3)\)</para>
            <para id="para-00016">\(x(3x)\)</para>
            <para id="para-00017">\((x + 3)(x + 3)\)</para>
            <para id="para-00018">\(3(x + 1)\)</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00019">Correct! \(x(x + 3)\)</para>
            <para id="para-00020">Try again. Revisit activities 9.3.2 and 9.3.3.</para>
            <para id="para-00021">The correct answer is: \(x(x + 3)\).</para>
          </solution>
        </exercise>
        <exercise id="_997a5371-4e56-4e04-ba7f-782c4c875a94" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00022">\(x^2+0.6x\)</para>
            <para id="para-00023">What number can be added to make \(x^2+0.6x\) a perfect square?</para>
            <para id="para-00024">Multiple Choice:</para>
            <para id="para-00025">0.09</para>
            <para id="para-00026">0.81</para>
            <para id="para-00027">0.36</para>
            <para id="para-00028">0.03</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00029">Correct! 0.09</para>
            <para id="para-00030">Try again. Revisit activities 9.3.2 and 9.3.3.</para>
            <para id="para-00031">The correct answer is: 0.09.</para>
          </solution>
        </exercise>
        <exercise id="c6f1b4c5-0f89-4180-af96-32c5f02c5af2" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00032">Which expression is equivalent to \(x^2+0.6x\)?</para>
            <para id="para-00033">Multiple Choice:</para>
            <para id="para-00034">\(x(x+0.6x)\)</para>
            <para id="para-00035">\(x(x+0.6)\)</para>
            <para id="para-00036">\(x(0.6x)\)</para>
            <para id="para-00037">\(0.6(x+1)\)</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00038">Correct! \(x(x+0.6)\)</para>
            <para id="para-00039">Try again. Revisit activities 9.3.2 and 9.3.3.</para>
            <para id="para-00040">The correct answer is: \(x(x+0.6)\).</para>
          </solution>
        </exercise>
        <exercise id="_844310e2-1516-4923-98b9-0f1c94bbd63a" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00041">\(x^2-11x\)</para>
            <para id="para-00042">What number can be added to make \(x^2-11x\) a perfect square?</para>
            <para id="para-00043">Multiple Choice:</para>
            <para id="para-00044">\(\frac{11}{2}\)</para>
            <para id="para-00045">\(\frac{25}{2}\)</para>
            <para id="para-00046">\(\frac52\)</para>
            <para id="para-00047">\(\frac{121}{4}\)</para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00048">Correct! \(\frac{121}{4}\)</para>
            <para id="para-00049">Try again. Revisit activities 9.3.2 and 9.3.3.</para>
            <para id="para-00050">The correct answer is: \(\frac{121}{4}\).</para>
          </solution>
        </exercise>
        <exercise id="_25442b64-c58b-4126-9f4b-9d092761dc32" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00051">Which expression is equivalent to \(x^2-11x\)?</para>
            <para id="para-00052">Multiple Choice:</para>
            <para id="para-00053">\(x(x-11x)\)</para>
            <para id="para-00054">\(x(x-11)\)</para>
            <para id="para-00055">\(11(x-1)\)</para>
            <para id="para-00056">\(11x(x-1)\)</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00057">Correct! \(x(x-11)\)</para>
            <para id="para-00058">Try again. Revisit activities 9.3.2 and 9.3.3.</para>
            <para id="para-00059">The correct answer is: \(x(x-11)\).</para>
          </solution>
        </exercise>
        <exercise id="_8cca33a0-b21b-4a19-8aa6-b42f50a7644c" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00060">\(x^2-\frac{5}{2}x\)</para>
            <para id="para-00061">What number can be added to make \(x^2-\frac{5}{2}x\) a perfect square?</para>
            <para id="para-00062">Multiple Choice:</para>
            <para id="para-00063">\(\frac{25}{4}\)</para>
            <para id="para-00064">\(\frac{25}{16}\)</para>
            <para id="para-00065">\(\frac58\)</para>
            <para id="para-00066">\(\frac68\)</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00067">Correct! \(\frac{25}{16}\)</para>
            <para id="para-00068">Try again. Revisit activities 9.3.2 and 9.3.3.</para>
            <para id="para-00069">The correct answer is: \(\frac{25}{16}\).</para>
          </solution>
        </exercise>
        <exercise id="d10954da-8650-4ab4-9d0c-a6a6f2383aa1" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00070">Which expression is equivalent to \(x^2-\frac{5}{2}x\)?</para>
            <para id="para-00071">Multiple Choice:</para>
            <para id="para-00072">\(x(x-\frac52)\)</para>
            <para id="para-00073">\(x(x-\frac{5}{2}x)\)</para>
            <para id="para-00074">\(\frac{5}{2}x(x-1)\)</para>
            <para id="para-00075">\(\frac{5}{2}(x-1)\)</para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00076">Correct! \(x(x-\frac52)\)</para>
            <para id="para-00077">Try again. Revisit activities 9.2.2 and 9.2.3.</para>
            <para id="para-00078">The correct answer is: \(x(x-\frac52)\).</para>
          </solution>
        </exercise>
        <exercise id="feefda53-6a1a-4443-95d3-5229cbb484a1" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00079">What number can be added to make \(x^2+x\) a perfect square?</para>
            <para id="para-00080">Multiple Choice:</para>
            <para id="para-00081">\(\frac14\)</para>
            <para id="para-00082">\(\frac12\)</para>
            <para id="para-00083">1</para>
            <para id="para-00084">0</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00085">Correct! \(\frac14\)</para>
            <para id="para-00086">Try again. Revisit activities 9.2.2 and 9.2.3.</para>
            <para id="para-00087">The correct answer is: \(\frac14\).</para>
          </solution>
        </exercise>
        <exercise id="c4829eed-28cd-415d-b5d2-48483676a0b1" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00088">What number can be added to make \(x^2-\frac{3}{2}x\) a perfect square?</para>
            <para id="para-00089">Multiple Choice:</para>
            <para id="para-00090">\(\frac23\)</para>
            <para id="para-00091">\(\frac49\)</para>
            <para id="para-00092">\(\frac{9}{16}\)</para>
            <para id="para-00093">\(-\frac23\)</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00094">Correct! \(\frac{9}{16}\)</para>
            <para id="para-00095">Try again. Revisit activities 9.2.2 and 9.2.3.</para>
            <para id="para-00096">The correct answer is: \(\frac{9}{16}\).</para>
          </solution>
        </exercise>
        <exercise id="e3c26867-40b6-4860-8b80-1204ffe62885" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00097">Noah is solving the equation \(x^2+8x+15=3\). He begins by rewriting the expression on the left in factored form and writes \((x+3)(x+5)=3\). He does not know what to do next.</para>
            <para id="para-00098">Do you think using the factored form is the best way for Noah to solve this equation?</para>
          </problem>
          <solution id="sol-00011">
            <para id="para-00099">Correct! No. Noah should use completing the square.</para>
            <para id="para-00100">Try again. Revisit activity 9.3.2.</para>
            <para id="para-00101">The correct answer is No. Noah should use completing the square.</para>
          </solution>
        </exercise>
        <exercise id="b310b720-bf24-4fbd-9217-83fe38560355" class="multiple-choice">
          <problem id="prob-00012">
            <para id="para-00102">Solve the original equation, then choose the <emphasis>two</emphasis> roots.</para>
          </problem>
          <solution id="sol-00012">
            <para id="para-00103">Correct! \(x=-2\) and \(x=-6\)</para>
            <para id="para-00104">Try again. Revisit activities 9.2.2 and 9.2.3.</para>
            <para id="para-00105">The correct answers are: \(x=-2\) and \(x=-6\).</para>
          </solution>
        </exercise>
        <exercise id="e1a27da5-2ce6-41c4-a658-1abd528f4ea3" class="multiple-choice">
          <problem id="prob-00013">
            <para id="para-00106">An equation and its solutions are given. Solve the equation by completing the square, then choose whether you agree or disagree with the given solutions.</para>
            <para id="para-00107">\(x^2+20x+50=14\). The solutions are \(x=-18\) and \(x=-2\).</para>
          </problem>
          <solution id="sol-00013">
            <para id="para-00108">Correct! Agree. The correct solutions are \(x=-18\) and \(x=-2\).</para>
            <para id="para-00109">Try again. Revisit activities 9.3.3 and 9.3.4.</para>
            <para id="para-00110">The correct answer is Disagree. The correct solutions are \(x=-18\) and \(x=-2\).</para>
          </solution>
        </exercise>
        <exercise id="_8d585fd8-2607-4e8f-af9d-0fb10aeea7a4" class="multiple-choice">
          <problem id="prob-00014">
            <para id="para-00111">\(x^2+1.6x=0.36\). The solutions are \(x=-1.8\) and \(x=0.2\).</para>
          </problem>
          <solution id="sol-00014">
            <para id="para-00112">Correct! Agree. \(x=-1.8\) and \(x=0.2\)</para>
            <para id="para-00113">Try again. Revisit activities 9.3.3 and 9.3.4.</para>
            <para id="para-00114">The correct answer is Agree. \(x=-1.8\) and \(x=0.2\).</para>
          </solution>
        </exercise>
        <exercise id="_3993561c-b0a9-4e42-af8b-5827ff6f7933" class="multiple-choice">
          <problem id="prob-00015">
            <para id="para-00115">\(x^2-5x=\frac{11}{4}\). The solutions are \(x=\frac{11}{4}\) and \(x=-12\).</para>
          </problem>
          <solution id="sol-00015">
            <para id="para-00116">Correct! Disagree. The correct solutions are \(x=\frac{11}{2}\) and \(x=-\frac12\).</para>
            <para id="para-00117">Try again. Revisit activities 9.3.3 and 9.3.4.</para>
            <para id="para-00118">The correct answer is Disagree. The correct solutions are \(x=\frac{11}{2}\) and \(x=-\frac12\).</para>
          </solution>
        </exercise>
        <exercise id="e510a689-c1be-4c61-b360-d98732756763" class="multiple-choice">
          <problem id="prob-00016">
            <para id="para-00119">Solve each equation, then choose the <emphasis>two</emphasis> roots.</para>
            <para id="para-00120">\(x^2-0.5x=0.5\)</para>
          </problem>
          <solution id="sol-00016">
            <para id="para-00121">Correct! \(x=-0.5\) and \(x=1\)</para>
            <para id="para-00122">Try again. Revisit activities 9.3.2 – 9.3.4.</para>
            <para id="para-00123">The correct answers are: \(x=-0.5\) and \(x=1\).</para>
          </solution>
        </exercise>
        <exercise id="_27b99384-bd9f-47a5-aed0-2d1cbeafe84d" class="multiple-choice">
          <problem id="prob-00017">
            <para id="para-00124">\(x^2+0.8x=0.09\)</para>
          </problem>
          <solution id="sol-00017">
            <para id="para-00125">Correct! \(x=-0.9\) and \(x=0.1\)</para>
            <para id="para-00126">Try again. Revisit activities 9.3.2 – 9.3.4.</para>
            <para id="para-00127">The correct answers are: \(x=-0.9\) and \(x=0.1\).</para>
          </solution>
        </exercise>
        <exercise id="_6c1881a7-7b81-4541-ba80-46f685e9b9ba" class="multiple-choice">
          <problem id="prob-00018">
            <para id="para-00128">\(x^2+\frac{13}{3}x=\frac{56}{36}\)</para>
          </problem>
          <solution id="sol-00018">
            <para id="para-00129">Correct! \(x=-\frac{14}{3}\) and \(x = \frac{1}{3}\)</para>
            <para id="para-00130">Try again. Revisit activities 9.3.2 – 9.3.4.</para>
            <para id="para-00131">The correct answers are: \(x=-\frac{14}{3}\) and \(x = \frac{1}{3}\).</para>
          </solution>
        </exercise>
    </section>
  </content>
