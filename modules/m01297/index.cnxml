<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.4.1: Exponent Rules</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01297</md:content-id>
    <md:title>5.4.1: Exponent Rules</md:title>
    <md:uuid>541734af-55f8-4085-8049-94c09148f6f3</md:uuid>
  </metadata>
  <content>
  <section><title>Warm Up Activity</title>
<list class="os-raise-noindent" type="enumerated">
  <para>Find the value of \(x\) that makes the equation true. </para>
</list>
<para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="045e21c4-38b5-497e-a06e-698980ebe8f7" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <exercise data-content-id="bce4fcf6-8203-4fce-826f-388d9a3e712a" data-problem-comparator="integer" data-problem-type="input" data-solution="7">
    <problem>
      <para>\(2^3\cdot 2^4=2^x\) </para>
      <para> Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! The answer is 7.</para>
    </solution>
    </exercise>
  <exercise data-content-id="d8c2ac02-4b93-4a46-8952-d7fceb46ebfd" data-problem-comparator="integer" data-problem-type="input" data-solution="6">
    <problem>
      <para>\(2^5\cdot 2=2^x\)</para>
      <para> Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! The answer is 6.</para>
    </solution>
    </exercise>
  <exercise data-content-id="abf28cef-62e8-4025-b358-1e0f5aacfbdd" data-problem-comparator="integer" data-problem-type="input" data-solution="3">
    <problem>
      <para>\(2^{10}\div 2^7=2^x\)</para>
      <para> Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! The answer is 3.</para>
    </solution>
    </exercise>
  <exercise data-content-id="63ed77a7-3fbe-4b8f-8127-de0820813702" data-problem-comparator="integer" data-problem-type="input" data-solution="8">
    <problem>
      <para>\(2^9\div 2=2^x\)</para>
      <para> Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! The answer is 8.</para>
    </solution>
    </exercise>
  <!--Do not edit below this line-->
  <solution> </solution>
  </div></section>
