<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.4.1: Exponent Rules</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01297</md:content-id>
    <md:title>5.4.1: Exponent Rules</md:title>
    <md:uuid>55a3b4f0-bbbb-4f23-a164-d2e34e894ecf</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001"><title>Warm Up Activity</title>
      <list class="os-raise-noindent" list-type="enumerated" id="list-00001">
        <item>Find the value of <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
            </m:mrow>
          </m:math> that makes the equation true.</item>
      </list>
      <para id="para-00001">Complete the following questions to practice the skills you have learned
        in this lesson.</para>

        <exercise id="bce4fcf6-8203-4fce-826f-388d9a3e712a" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00002"><m:math>
                <m:mrow>
                  <m:msup>
                    <m:mn>2</m:mn>
                    <m:mn>3</m:mn>
                  </m:msup>
                  <m:mi>·</m:mi>
                  <m:msup>
                    <m:mn>2</m:mn>
                    <m:mn>4</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:msup>
                    <m:mn>2</m:mn>
                    <m:mi>x</m:mi>
                  </m:msup>
                </m:mrow>
              </m:math></para></problem>
          <solution id="sol-00001">
            <para id="para-00003">Correct! The answer is 7.</para>
            <para id="para-00004">Nice try! The correct answer is: 7</para>
          </solution>
        </exercise>

        <exercise id="d8c2ac02-4b93-4a46-8952-d7fceb46ebfd" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00005"><m:math>
                <m:mrow>
                  <m:msup>
                    <m:mn>2</m:mn>
                    <m:mn>5</m:mn>
                  </m:msup>
                  <m:mi>·</m:mi>
                  <m:mn>2</m:mn>
                  <m:mo>=</m:mo>
                  <m:msup>
                    <m:mn>2</m:mn>
                    <m:mi>x</m:mi>
                  </m:msup>
                </m:mrow>
              </m:math></para></problem>
          <solution id="sol-00002">
            <para id="para-00006">Correct! The answer is 6.</para>
            <para id="para-00007">Nice try! The correct answer is: 6</para>
          </solution>
        </exercise>

        <exercise id="abf28cef-62e8-4025-b358-1e0f5aacfbdd" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00008"><m:math>
                <m:mrow>
                  <m:msup>
                    <m:mn>2</m:mn>
                    <m:mrow>
                      <m:mn>10</m:mn>
                    </m:mrow>
                  </m:msup>
                  <m:mi>÷</m:mi>
                  <m:msup>
                    <m:mn>2</m:mn>
                    <m:mn>7</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:msup>
                    <m:mn>2</m:mn>
                    <m:mi>x</m:mi>
                  </m:msup>
                </m:mrow>
              </m:math></para></problem>
          <solution id="sol-00003">
            <para id="para-00009">Correct! The answer is 3.</para>
            <para id="para-00010">Nice try! The correct answer is: 3</para>
          </solution>
        </exercise>

        <exercise id="_63ed77a7-3fbe-4b8f-8127-de0820813702" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00011"><m:math>
                <m:mrow>
                  <m:msup>
                    <m:mn>2</m:mn>
                    <m:mn>9</m:mn>
                  </m:msup>
                  <m:mi>÷</m:mi>
                  <m:mn>2</m:mn>
                  <m:mo>=</m:mo>
                  <m:msup>
                    <m:mn>2</m:mn>
                    <m:mi>x</m:mi>
                  </m:msup>
                </m:mrow>
              </m:math></para></problem>
          <solution id="sol-00004">
            <para id="para-00012">Correct! The answer is 8.</para>
            <para id="para-00013">Nice try! The correct answer is: 8</para>
          </solution>
        </exercise>
    </section>
  </content>
</document>