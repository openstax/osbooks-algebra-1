  </metadata>
  <content>
  <section id="sect-00001"><title>Warm Up Activity</title>


<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001"><para id="para-00001">Which one doesn’t belong?</para>
<para id="para-00002">A. \(5+2+2+2+2+2+2\)</para>
<para id="para-00003">B. \(5+6 \cdot 2\)</para>
<para id="para-00004">C. \(5 \cdot 2^6\)</para>
<para id="para-00005">D. \(5 \cdot 2 \cdot 2 \cdot 2 \cdot 2 \cdot 2 \cdot 2\)</para>
  </problem><solution id="sol-00001">
    
    
  
  <para id="para-00006">Compare your answers:</para>

<para id="para-00007">
      Your answer may vary, but here are some samples.</para>
          
          <para id="para-00008">A doesn’t belong because:</para>
    
    <list id="list-00001">
      <item>
        It is the only expression with repeated addition.
     </item>
      <item>
        It is the only expression that only has addition.
     </item>
    </list>
    
    <para id="para-00009">B doesn’t belong because:</para>
    
    <list id="list-00002">
      <item>
        It is the only expression with both addition and multiplication.
     </item>
    </list>
    
    <para id="para-00010">C doesn’t belong because:</para>
    
    <list id="list-00003">
      <item>
        It is the only expression with an exponent.
     </item>
    </list>
    
    <para id="para-00011">D doesn’t belong because:</para>
    
    <list id="list-00004">
      <item>
        It is the only expression with repeated multiplication.
     </item>
      <item>
        It is the only expression that only has multiplication.
     </item>
    </list>
  
  </solution></exercise>
<!--Interaction End --></section>
</content>
