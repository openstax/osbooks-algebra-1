<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.7.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00176</md:content-id>
    <md:title>1.7.5: Practice</md:title>
    <md:uuid>dfbe91a7-480b-452b-ae56-85c1c0d66eb0</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <para id="para-00002">For questions 1 – 3, choose an equivalent equation.</para>
      <exercise id="b52a52a3-95d8-4b74-8c07-2cb024e1c0f1" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00003">Which equation is equivalent to <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math>?</para>
          <para id="para-00004">Multiple Choice:</para>
          <para><m:math><m:mrow><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>18</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>3</m:mn><m:mi>𝑥</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>𝑥</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00001">
          <para id="para-00010">Correct! <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi></m:mrow></m:math></para>
          <para id="para-00011">Try again. Revisit activity 1.7.2.</para>
          <para id="para-00012">The correct answer is <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_942bfea6-ff71-4594-9ff9-fe0e6d190ec5" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00013">Which equation is equivalent to <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math>?</para>
          <para id="para-00014">Multiple Choice:</para>
          <para><m:math><m:mrow><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>18</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>3</m:mn><m:mi>𝑥</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>𝑥</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00002">
          <para id="para-00020">Correct! <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>18</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
          <para id="para-00021">Try again. Revisit activity 1.7.2.</para>
          <para id="para-00022">The correct answer is <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>18</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="fd402ad6-ad05-4fe4-ac10-b4a4ad5a6585" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00023">Which equation is equivalent to <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math>?</para>
          <para id="para-00024">Multiple Choice:</para>
          <para><m:math><m:mrow><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>18</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>3</m:mn><m:mi>𝑥</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>𝑥</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00003">
          <para id="para-00030">Correct! <m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
          <para id="para-00031">Try again. Revisit activity 1.7.2.</para>
          <para id="para-00032">The correct answer is <m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_64df16ad-469d-4280-8bcc-52d29d144939" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00033">Select three equations that have 0 as a solution.</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00034">Correct! <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>9</m:mn><m:mi>x</m:mi></m:mrow></m:math>, and <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
          <para id="para-00035">Try again. Revisit activity 1.7.1.</para>
          <para id="para-00036">The correct answers are <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>9</m:mn><m:mi>x</m:mi></m:mrow></m:math>, and <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="a05374c2-76ac-4ff2-99f4-8ddb1069cabc" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00037">Which equation is equivalent to <m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>24</m:mn></m:mrow></m:math>?</para>
          <para id="para-00038">Multiple Choice:</para>
          <para><m:math><m:mrow><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>24</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>21</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>27</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00005">
          <para id="para-00043">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
          <para id="para-00044">Try again. Revisit activity 1.7.2.</para>
          <para id="para-00045">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_5764b7ed-1940-478d-8431-e5ca9c6ba19a" class="multiple-choice">
        <problem id="prob-00006">
          <para id="para-00046">Which of the following sets of equations are equivalent to each other?</para>
          <para id="para-00047">Multiple Choice:</para>
          <para id="para-00048"><m:math display="inline"><m:mrow><m:mn>10</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>50</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math></para>
          <para id="para-00049"><m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>21</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>21</m:mn></m:mrow></m:math></para>
          <para id="para-00050"><m:math display="inline"><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
          <para id="para-00051"><m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>11</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00052">Correct! <m:math display="inline"><m:mrow><m:mn>10</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>50</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math>. Each side of the equation was divided by 5. So the equations are equivalent.</para>
          <para id="para-00053">Try again. Revisit activity 1.7.2.</para>
          <para id="para-00054">The correct answer is <m:math display="inline"><m:mrow><m:mn>10</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>50</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math>. Each side of the equation was divided by 5. So the equations are equivalent.</para>
        </solution>
      </exercise>
      <exercise id="_2fdde9ea-4d45-43f3-9578-2d046e7b548d" class="multiple-choice">
        <problem id="prob-00007">
          <para id="para-00055">Using the distributive property, choose which equation would be an equivalent equation to <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math>.</para>
          <para id="para-00056">Multiple Choice:</para>
          <para><m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00007">
          <para id="para-00061">Correct! <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
          <para id="para-00062">Try again. Revisit activity 1.7.2.</para>
          <para id="para-00063">The correct answer is <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math>. It is one of the solutions that could be equivalent to <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
    </section>
  </content>
</document>