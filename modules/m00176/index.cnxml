<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.7.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00176</md:content-id>
    <md:title>1.7.5: Practice</md:title>
    <md:uuid>3a890da8-8f93-4eda-8c78-3d6c307d76f5</md:uuid>
  </metadata>
  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<para>For questions 1 – 3, choose an equivalent equation.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="26b6c558-85ca-49b4-9927-a17ddfb5409a" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--Enter Questions Below this line-->
  <!--Q1-->
  <exercise data-content-id="b52a52a3-95d8-4b74-8c07-2cb024e1c0f1" data-problem-type="multiplechoice" data-retry-limit="4" data-solution="\(3x-1=4x\)" data-solution-options="[&quot;\\(7x=1\\)&quot;, &quot;\\(3x+18=4x+7\\)&quot;,&quot;\\(9x=4x+7\\)&quot;, &quot;\\(3x-1=4x\\)&quot;, &quot;\\(3𝑥=4𝑥+7\\)&quot;]">
    <problem>
      <para>1. Which equation is equivalent to \(3x + 6 = 4x + 7\)?</para>
    </problem>
    <solution>
      <para>Correct! \(3x-1=4x\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.7.2.</para>
    </div>
    </exercise>
  
  <!--END QUESTION.-->
  <!--Q2-->
  <exercise data-content-id="942bfea6-ff71-4594-9ff9-fe0e6d190ec5" data-problem-type="multiplechoice" data-retry-limit="4" data-solution="\(3x+18=4x+7\)" data-solution-options="[&quot;\\(7x=1\\)&quot;, &quot;\\(3x+18=4x+7\\)&quot;,&quot;\\(9x=4x+7\\)&quot;, &quot;\\(3x-1=4x\\)&quot;, &quot;\\(3𝑥=4𝑥+7\\)&quot;]">
    <problem>
      <para>2. Which equation is equivalent to \(3(x + 6) = 4x + 7\)?</para>
    </problem>
    <solution>
      <para>Correct! \(3x+18=4x+7\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.7.2.</para>
    </div>
    </exercise>
  
  <!--END QUESTION.-->
  <!--Q3-->
  <exercise data-content-id="fd402ad6-ad05-4fe4-ac10-b4a4ad5a6585" data-problem-type="multiplechoice" data-retry-limit="4" data-solution="\(7x=1\)" data-solution-options="[&quot;\\(7x=1\\)&quot;, &quot;\\(3x+18=4x+7\\)&quot;,&quot;\\(9x=4x+7\\)&quot;, &quot;\\(3x-1=4x\\)&quot;, &quot;\\(3𝑥=4𝑥+7\\)&quot;]">
    <problem>
      <para>3. Which equation is equivalent to \(4x + 3x = 7-6\)?</para>
    </problem>
    <solution>
      <para>Correct! \(7x=1\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.7.2.</para>
    </div>
    </exercise>
  
  <!--END QUESTION.-->
  <!--Q4-->
  <exercise data-content-id="64df16ad-469d-4280-8bcc-52d29d144939" data-problem-type="multiselect" data-solution="[&quot;\\(2x+10=4x+10\\)&quot;, &quot;\\(4x=9x\\)&quot;, &quot;\\(2x-3+4x=4-7\\)&quot;]" data-solution-options="[&quot;\\(2x+10=4x+10\\)&quot;, &quot;\\(4x=9x\\)&quot;, &quot;\\(2x-3+4x=4-7\\)&quot;,&quot;\\(5x+7=0\\)&quot;,&quot;\\(3(x-2)=9\\)&quot;]">
    <problem>
      <para>4. <emphasis>Select three </emphasis>equations that have 0 as a solution.</para>
    </problem>
    <solution>
      <para>Correct! \(2x+10=4x+10\), \(4x=9x\), and \(2x-3+4x=4-7\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.7.1.</para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q5-->
  <exercise data-content-id="a05374c2-76ac-4ff2-99f4-8ddb1069cabc" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x-3=4\)" data-solution-options="[&quot;\\(6x-3=24\\)&quot;, &quot;\\(x-3=4\\)&quot;, &quot;\\(6x=21\\)&quot;, &quot;\\(6x=27\\)&quot;]">
    <problem>
      <para>5. Which equation is equivalent to \(6(x-3)=24\)?</para>
    </problem>
    <solution>
      <para>Correct! \(x-3=4\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.7.2.</para>
    </div>
    </exercise>
  
  <!--Q6-->
  <exercise data-content-id="5764b7ed-1940-478d-8431-e5ca9c6ba19a" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(10(x+9) = 50\) and \(2(x+9)=10\)" data-solution-options="[&quot;\\(10(x+9) = 50\\) and \\(2(x+9)=10\\)&quot;, &quot;\\(7(x+2)=21\\) and \\(7x +2=21\\)&quot;, &quot;\\(5x - 2 = 7x +4\\) and \\(12x -2 =4\\)&quot;, &quot;\\(6x-4=11\\) and \\(6x =7\\)&quot;]">
    <problem>
      <para>6. Which of the following sets of equations are equivalent to each other?</para>
    </problem>
    <solution>
      <para>Correct! \(10(x+9) = 50\) and \(2(x+9)=10\). Each side of the equation was divided by 5. So the equations are equivalent.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.7.2.</para>
    </div>
    </exercise>
  
  <!--Q7-->
  <exercise data-content-id="2fdde9ea-4d45-43f3-9578-2d046e7b548d" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(3x-6=7\)" data-solution-options="[&quot;\\(3x-2=7\\)&quot;, &quot;\\(3x-6=7\\)&quot;, &quot;\\(x-2=4\\)&quot;, &quot;\\(3x=9\\)&quot;]">
    <problem>
      <para>7. Using the distributive property, choose which equation would be an equivalent equation to \(3(x-2) =7\).</para>
    </problem>
    <solution>
      <para>Correct! \(3x - 6 =7\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 1.7.2.</para>
    </div>
    </exercise>
  
  <!--Do not edit below line.-->
  <solution>
