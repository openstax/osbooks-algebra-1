<!--Question 9 -->
<exercise id="exer-00009">
  <problem id="prob-00009">
    <para id="para-00027">What is the value of \(x\) if \(B(x) = 42.1\)?</para>
    </problem><solution id="sol-00009">
    
    
  
  <para id="para-00028">Compare your answer:</para>
    
