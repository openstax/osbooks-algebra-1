  <para id="para-00016">Compare your answer:</para>
    
    <para id="para-00017">\(B(1.482) = 39.8\)</para>
  
  </solution></exercise>

<!--Question 6 -->
<exercise id="exer-00006">
  <problem id="prob-00006">
    <para id="para-00018">What is the value of \(x\) if \(B(x) = 93\)?</para>
    </problem><solution id="sol-00006">
    
    
  
  <para id="para-00019">Compare your answer:</para>
    
    <para id="para-00020">\(x = 6.8\)</para>
  
  </solution></exercise>

<!--Question 7 -->
<exercise id="exer-00007">
  <problem id="prob-00007">
    <para id="para-00021">What were the window values you used for the \(x\)-axis? (Write the values as an inequality.)</para>
    </problem><solution id="sol-00007">
    
    
  
  <para id="para-00022">Compare your answer:</para>
    
