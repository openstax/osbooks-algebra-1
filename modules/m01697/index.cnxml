<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Factoring Strategies for Polynomials</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01697</md:content-id>
    <md:title>Factoring Strategies for Polynomials</md:title>
    <md:uuid>5c2874d2-a09c-4db4-ab60-41a75ece8ba3</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>

<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002">Working with a partner, list as many strategies as you can for factoring polynomials.</para>
    </problem><solution id="sol-00001">
    
  
  <para id="para-00004">Your answers may vary, but here are some examples:</para>
    
    <list id="list-00001">
      <item>Factoring by finding the GCF of an expression and using reverse distribution</item>
      <item>Factoring using grouping</item>
      <item>Factoring trinomials of the form <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>b</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi></m:mrow></m:math> (undo FOIL)</item>
      <item>Factoring trinomials of the form <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>b</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi></m:mrow></m:math> using trial and error</item>
      <item>Factoring trinomials using the “<m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mi>c</m:mi></m:mrow></m:math>” method</item>
      <item>Factoring using substitution</item>
      <item>Factoring the difference of squares</item>
      <item>Factoring perfect square trinomials</item>
    </list>
  
  </solution></exercise>
<!--Interaction End -->


<exercise id="exer-00002">
  <problem id="prob-00002">
    
    <para id="para-00005">Work with your partner to write a sample polynomial that would be fitting for each strategy listed.</para>
    <para id="para-00006"></para>
  
  </problem><solution id="sol-00002">
  <para id="para-00007">Compare your answers:</para>
  
  <table class="unnumbered os-raise-midsizetable" id="table-00001">
    <tgroup cols="2"><tbody><row>
        <entry><emphasis>
          Factoring Strategy
       </emphasis> </entry><entry><emphasis>
          Sample Polynomial
       </emphasis> </entry></row>
    <row>
        <entry>
          Factoring by finding the GCF of an expression and using reverse distribution
        </entry>
        <entry>
          <m:math display="inline"><m:mrow><m:mn>14</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>a</m:mi><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>12</m:mn></m:mrow></m:math>
        </entry>
      </row>
      <row>
        <entry>
          Factoring using grouping
        </entry>
        <entry>
          <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>10</m:mn></m:mrow></m:math>
        </entry>
      </row>
      <row>
        <entry>
          Factoring trinomials of the form <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>b</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi></m:mrow></m:math> (undo FOIL)
        </entry>
        <entry>
          <m:math display="inline"><m:mrow><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>14</m:mn><m:mi>t</m:mi><m:mo>+</m:mo><m:mn>24</m:mn></m:mrow></m:math>
        </entry>
      </row>
      <row>
        <entry>
          Factoring trinomials of the form <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>b</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi></m:mrow></m:math> using trial and error
        </entry>
        <entry>
          <m:math display="inline"><m:mrow><m:mn>18</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>3</m:mn><m:mi>x</m:mi><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>10</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>
        </entry>
      </row>
      <row>
        <entry>
          Factoring trinomials using the “<m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mi>c</m:mi></m:mrow></m:math>” method
        </entry>
        <entry>
          <m:math display="inline"><m:mrow><m:mn>16</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>32</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>12</m:mn></m:mrow></m:math>
        </entry>
      </row>
      <row>
        <entry>
          Factoring using substitution
        </entry>
        <entry>
          <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>7</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>12</m:mn></m:mrow></m:math>
        </entry>
      </row>
      <row>
        <entry>
          Factoring the difference of squares
        </entry>
        <entry>
          <m:math display="inline"><m:mrow><m:mn>81</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>1</m:mn></m:mrow></m:math>
        </entry>
      </row>
      <row>
        <entry>
          Factoring perfect square trinomials
        </entry>
        <entry>
          <m:math display="inline"><m:mrow><m:mn>25</m:mn><m:msup><m:mi>v</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>20</m:mn><m:mi>v</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math>
        </entry>
      </row>
    </tbody></tgroup></table>
  
</solution></exercise>
</section>
</content>
</document>
