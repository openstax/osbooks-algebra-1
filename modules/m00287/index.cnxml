  <content>
  <section><para>Which of the following equations could be represented by this table of values?
</para>

<table class="os-raise-horizontaltable">
  <thead/>
  <tbody>
    <row>
      <entry scope="row" class="emphasis">\(x\)</entry>
      <entry>0</entry>
      <entry>1</entry>
      <entry>2</entry>
      <entry>3</entry>
    </row>
    <row>
      <entry scope="row" class="emphasis">\(y\)</entry>
      <entry>20</entry>
      <entry>23</entry>
      <entry>26</entry>
      <entry>29</entry>
    </row>
  </tbody>
</table></section>
</content>
</document>
