<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Numerical Patterns</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01812</md:content-id>
    <md:title>Numerical Patterns</md:title>
    <md:uuid>7c7c442f-a781-4d92-84f8-ece735015f41</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00001">Study the table. What do you notice? What do you wonder?</para>
          <table class="unnumbered os-raise-horizontaltable" id="table-00001" summary="Corresponding values for x and y, where y = 16x^2.">
            <tgroup cols="7">
<tbody>
                <row>
                  <entry><emphasis> <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> </emphasis>
                  </entry>
                  <entry> 0 </entry>
                  <entry> 1 </entry>
                  <entry> 2 </entry>
                  <entry> 3 </entry>
                  <entry> 4 </entry>
                  <entry> 5 </entry>
                </row>
                <row>
                  <entry><emphasis> <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> </emphasis>
                  </entry>
                  <entry> 0 </entry>
                  <entry> 16 </entry>
                  <entry> 64 </entry>
                  <entry> 144 </entry>
                  <entry> 256 </entry>
                  <entry> 400 </entry>
                </row>
              </tbody>
            </tgroup>
          </table>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Compare your answer: </para>
          <para id="para-00004">Things you may notice:</para>
          <list id="list-00001">
            <item>The <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-values increment by 1 as you move across the table.</item>
            <item>The <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-values increase.</item>
            <item>All <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-values are even and divisible by 4, 8, and 16.</item>
            <item>The <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-values are all perfect squares.</item>
            <item>The successive differences between the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-values are growing.</item>
          </list>
          <para id="para-00005">Things you may wonder:</para>
          <list id="list-00002">
            <item>Is there a rule for these numbers?</item>
            <item>Do the numbers represent the growth of a geometric pattern?</item>
            <item>Do the numbers represent a quadratic relationship?</item>
            <item>What is the next number in the table?</item>
          </list>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>
