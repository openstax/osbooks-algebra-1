  <!--3a-->
  <exercise data-content-id="5d5f3bfa-28bc-4f5d-950e-44488d9c37b9" data-problem-type="dropdown" data-retry-limit="1" data-solution="No" data-solution-options="[&quot;Yes&quot;, &quot;No&quot;]">
    <problem>
      <para>3. \(y&gt;\frac23x-5\)</para>
      <para>    \(x+\frac12y\leq4\) </para>
      <para>  a. (6, −4) </para>
    </problem>
    <solution>
      <para>Correct! (6, -4) is not a solution to the system.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.14.2. </para>
    </div>
    </exercise>
  <!--Q3b-->
  <exercise data-content-id="c3c6b95d-4630-45b9-a90e-ddaec70fec49" data-problem-type="dropdown" data-retry-limit="1" data-solution="Yes" data-solution-options="[&quot;Yes&quot;, &quot;No&quot;]">
