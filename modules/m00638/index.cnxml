  <!--Q6-->
  <exercise data-content-id="152c9fb4-de7f-403b-8f8e-a2bee36f959d" data-problem-type="multiplechoice" data-retry-limit="1" data-solution="Region D" data-solution-options="[&quot;Region A&quot;, &quot;Region B&quot;, &quot;Region C&quot;, &quot;Region D&quot;]">
    <problem>
      <para>6. Two inequalities are graphed on the same coordinate plane. Which region represents the solution to the system of the two inequalities?</para>
      <para dir="ltr"><figure><media alt="Two intersecting inequalities."><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/7cb503fc3f5524052d06f4af2d1ad8835c95afcf"/></media></figure></para>
    </problem>
    <solution>
      <para>Correct! Region D </para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 2.14.3 and 2.14.4.</para>
    </div>
    </exercise>
  
