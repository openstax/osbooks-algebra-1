  <exercise data-content-id="62942071-43a9-444f-acdd-aa759746db45" data-problem-type="dropdown" data-retry-limit="1" data-solution="No" data-solution-options="[&quot;Yes&quot;, &quot;No&quot;]">
    <problem>
      <para>5. \(6x − 5y &lt; 20\)</para>
      <para>    \(−2x + 7y &gt; −8\) </para>
      <para>  a. (1, −3) </para>
    </problem>
    <solution>
