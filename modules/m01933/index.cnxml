<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>7.11.5: Graphs of Quadratic Functions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01933</md:content-id>
    <md:title>7.11.5: Graphs of Quadratic Functions</md:title>
    <md:uuid>97fdc1ee-23c5-4300-8067-340b1cd76f15</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <para id="para-00001">The function \(f\) is given by \(f(x)=(x-2)(x+4)\). </para>
      <para id="para-00002">Without using graphing technology, answer questions 1 – 4.</para>
      <!--Text Entry Interaction Start -->
      <exercise>
        <problem id="prob-00001">
          <para id="para-00003">What are the \(x\)-intercepts of the graph representing \(f\)? </para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00004">Enter your answer here:</para>
          <para id="para-00005">Compare your answer:</para>
          <para id="para-00006"> \(x\)-intercepts for function \(f\): \((2,0)\) and \((-4,0)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <section class="check-understanding" id="sect-00002">
        <title>Cool Down Activity</title>
        <exercise id="_3ef6b782-dbe3-4cae-a77c-9770e9a31299" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00007">Enter your answer here:</para>
            <para id="para-00008">What is the \(x\)-coordinate of the vertex of the graph?</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00009">Correct! -1</para>
            <para id="para-00010">The correct answer is -1.</para>
          </solution>
        </exercise>
        <exercise id="_9aa23552-aece-4c85-9209-34ffe324d66e" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00011">Enter your answer here:</para>
            <para id="para-00012">What is the \(y\)-coordinate of the vertex of the graph?</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00013">Correct! -9</para>
            <para id="para-00014">The correct answer is -9.</para>
          </solution>
        </exercise>
      </section>
      <!--Text Entry Interaction Start -->
      <exercise>
        <problem id="prob-00004">
          <para id="para-00015">What is the \(y\)-intercept?</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00016">Enter your answer here:</para>
          <para id="para-00017">Compare your answer:</para>
          <para id="para-00018"> The \(y\)-intercept is \((0,-8)\), because \((0-2)(0+4)=(-2)(4)=-8\).</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>
      <example id="exam-00001">
        <exercise>
          <problem id="prob-00005">
            <para id="para-00019">Use the graphing tool or technology outside the course. Sketch a graph that represents \(f\).</para>
            <para id="para-00020">Select the <emphasis>solution</emphasis> button to compare your work. </para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00021">Compare your answer:</para>
            <para id="para-00022">The graph opens upward with vertex at \((-1,-9)\) and \(x\)-intercepts at \((2,0)\) and \((-4, 0)\).</para>
            <para id="para-00023">
              <figure id="fig-00001">
                <media alt="Graph on coordinate plane.">
                  <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_13_12_01.svg"/>
                </media>
              </figure>
            </para>
          </solution>
        </exercise>
      </example>
    </section>
  </content>
