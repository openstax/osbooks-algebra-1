<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>7.11.5: Graphs of Quadratic Functions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01933</md:content-id>
    <md:title>7.11.5: Graphs of Quadratic Functions</md:title>
    <md:uuid>97fdc1ee-23c5-4300-8067-340b1cd76f15</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
      <para id="para-00001">The function <m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math> is given by <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
      <para id="para-00002">Without using graphing technology, answer questions 1 – 4.</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00003">What are the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts of the graph representing <m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math>?</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00005">Compare your answer: </para>
          <para id="para-00006"> <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts for function <m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math>: <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
        </solution>
      </exercise>
      <!--Interaction End -->

        <exercise id="_3ef6b782-dbe3-4cae-a77c-9770e9a31299" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00008">What is the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-coordinate of the vertex of the graph?</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00009">Correct! -1</para>
            <para id="para-00010">The correct answer is -1.</para>
          </solution>
        </exercise>
        <exercise id="_9aa23552-aece-4c85-9209-34ffe324d66e" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00012">What is the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-coordinate of the vertex of the graph?</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00013">Correct! -9</para>
            <para id="para-00014">The correct answer is -9.</para>
          </solution>
        </exercise>

      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00004">
          <para id="para-00015">What is the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercept?</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00017">Compare your answer: </para>
          <para id="para-00018"> The <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercept is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>, because <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <media alt="insert alt text"><iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/></media>
        <exercise id="exer-00003">
          <problem id="prob-00005">
            <para id="para-00019">Use the graphing tool or technology outside the course. Sketch a graph that represents <m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math>.</para>
            <para id="para-00020">Select the <emphasis>solution</emphasis> button to compare your work.</para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00021">Compare your answer: </para>
            <para id="para-00022">The graph opens upward with vertex at <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts at <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
            <para id="para-00023">
              
                <media alt="A parabola on a coordinate grid. The x-axis scale is 1 and extends from negative 6 to 6. The y-axis scale is 2 and extends from negative 12 to 12.">
                  <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_13_12_01.svg"/>
                </media>
              
          </para>
          </solution>
        </exercise>
      
    </section>
  </content>
