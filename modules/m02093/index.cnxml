<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.1.4: Interpreting a Solution</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02093</md:content-id>
    <md:title>8.1.4: Interpreting a Solution</md:title>
    <md:uuid>b7f1423b-d8e7-44df-92f5-0e24ddb90ac0</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Cool Down Activity</title>
      <para id="para-00001">A framed picture has a total area \(y\), in square inches. The thickness of the frame is represented by \(x\), in inches. The equation \(y = (2x + 8)(2x + 10)\) relates these two variables.</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002">What is the width, or shorter side, of the picture without the frame?</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Enter the width.</para>
          <para id="para-00004">Compare your answer:</para>
          <para id="para-00005">8 inches</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00006">What is the length, or longer side, of the picture without the frame?</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00007">Enter the length.</para>
          <para id="para-00008">Compare your answer:</para>
          <para id="para-00009">10 inches</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010">What would a solution to the equation \(100 = (2x + 8)(2x + 10)\) mean in this situation?</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00011">Enter your explanation.</para>
          <para id="para-00012">Compare your answer:</para>
          <para id="para-00013">The solution would represent the thickness of a frame that results in a total area of 100 square inches.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>