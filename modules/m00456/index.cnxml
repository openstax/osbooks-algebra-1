<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.6.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00456</md:content-id>
    <md:title>2.6.5: Practice</md:title>
    <md:uuid>163770e4-922f-4b99-9e41-a1deb28703b4</md:uuid>
  </metadata>
  <content>
  <section><para><emphasis><emphasis> Students will complete the following questions to practice the skills they have learned in this lesson.</emphasis></emphasis></para>
<para>1. Solve</para>
<para>\( \left\{ \begin{array}{c l} –2x + 5y = –42\\ 7x + 2y = 30 \end{array}\right. \)</para>
<list>
  <item>\((0,15)\)</item>
  <item>\((11,−4)\)</item>
  <item>\((1,−8)\)</item>
  <item>\((6,−6)\)</item>
</list>
<para><emphasis>Answer: </emphasis>\( (6,-6)\)</para>
<!-- BEGIN WORKED SOLUTION 1-->  
<para>\(- 2( –2x+5y=–42)=4x-10y=84 \)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
\(\begin{array}{r}4x-10y&amp;=&amp;84
\\35x+10y&amp;=&amp;150
\\ \hline
 39x&amp;=&amp;234
\\x&amp;=&amp;6
\end{array}\)<!--BEGIN ALIGN TO EQUALS WITH LINE-->

<!--BEGIN ALIGN TO EQUALS -->
\(\begin{array}{rcl}7(6)+2y&amp;=&amp;30
\\42+2y&amp;=&amp;30
\\2y&amp;=&amp;-12
\\y&amp;=&amp;-6
\\\end{array}\)<!--END ALIGN TO EQUALS -->
The solution is \((6,-6)\).</para>
<!-- ENd WORKED SOLUTION 1--> 


<para>2. Solve</para>
<para>\( \left\{ \begin{array}{c l} 6x – 5y = –34\\ 2x + 6y = 4 \end{array}\right. \)</para>
<list>
  <item>\((2,0)\)</item>
  <item>\((1,8)\)</item>
  <item>\((−4,2)\)</item>
  <item>\((−9,−4)\)</item>
</list>
<para><emphasis>Answer: </emphasis>\( (-4,2)\)</para>
<!-- BEGIN WORKED SOLUTION 2-->  
<para>\(- 3( 2x+6y=4)=-6x-18y=-12  \)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
  \(\begin{array}{r}6x–5y&amp;=&amp;34
  \\-6x-18y&amp;=&amp;12
  \\ \hline
  -23y&amp;=&amp;-46
  \\y&amp;=&amp;2
  \end{array}\)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
  
  <!--BEGIN ALIGN TO EQUALS -->
  \(\begin{array}{rcl}2x+6(2)&amp;=&amp;4
  \\2x+12&amp;=&amp;4
  \\2x&amp;=&amp;-8
  \\x&amp;=&amp;-4
  \\\end{array}\)<!--END ALIGN TO EQUALS -->
  The solution is \((-4,2)\).</para>
  <!-- ENd WORKED SOLUTION 2--> 


<para>3. Solve</para>
<para>\( \left\{ \begin{array}{c l} 5x – y = –2.6\\ −4x − 6y = 1.4 \end{array}\right. \)</para>
<list>
  <item>\((7,–4.9)\)</item>
  <item>\((0.5,0.1)\)</item>
  <item>\((−3,−12)\)</item>
  <item>\((−0.5,0.1)\)</item>
</list>
<para><emphasis>Answer: </emphasis>\( (0.5,0.1)\)</para>
<!-- BEGIN WORKED SOLUTION 3-->  
<para>\(- 6( 5x–y=–2.6)=-30x+6y=15.6  \)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
  \(\begin{array}{r}-30x+6y&amp;=&amp;15.6
  \\−4x−6y&amp;=&amp;1.4
  \\ \hline
   -34x&amp;=&amp;17
  \\x&amp;=&amp;-0.5
  \end{array}\)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
  
  <!--BEGIN ALIGN TO EQUALS -->
  \(\begin{array}{rcl}−4(-0.5)−6y&amp;=&amp;1.4
  \\2-6y&amp;=&amp;1.4
   \\-6y&amp;=&amp;-0.6
  \\y&amp;=&amp;0.1
  \\\end{array}\)<!--END ALIGN TO EQUALS -->
  The solution is \((-0.5,0.1)\).</para>
  <!-- ENd WORKED SOLUTION 3--> 

<para>4. Solve</para>
<para>\( \left\{ \begin{array}{c l} 7x – 2y = 3\\ 4x + 5y = 3.25 \end{array}\right. \)</para>
<list>
  <item>\((1,2)\)</item>
  <item>\((0.5,0.25)\)</item>
  <item>\((–1,–5)\)</item>
  <item>\((3,9)\)</item>
</list>
<para><emphasis>Answer: </emphasis>\( (0.5,0.25)\)</para>
<!-- BEGIN WORKED SOLUTION 4-->  
<para>\(5( 7x–2y=3)=35x-10y=15  \)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
  \(\begin{array}{r}35x-10y&amp;=&amp;15
  \\8x+10y&amp;=&amp;6.5
  \\ \hline
   43x&amp;=&amp;21.5
  \\x&amp;=&amp;0.5
  \end{array}\)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
  
  <!--BEGIN ALIGN TO EQUALS -->
  \(\begin{array}{rcl}4(0.5)+5y&amp;=&amp;3.25
  \\2+5y&amp;=&amp;3.25
   \\5y&amp;=&amp;1.25
  \\y&amp;=&amp;0.25
  \\\end{array}\)<!--END ALIGN TO EQUALS -->
  The solution is \((0.5,0.25)\).</para>
  <!-- ENd WORKED SOLUTION 4--> 

<para>5. Solve</para>
<para>\(\left\{\begin{array}{l}5x\;+\;9y\;=\;16\\x\;+\;2y\;=\;4\end{array}\right.\)</para>
<list>
  <item>\((−4,4)\)</item>
  <item>\((3.2,0)\)</item>
  <item>\((−8,6)\)</item>
  <item>\((8,−2)\)</item>
</list>
<para><emphasis>Answer: </emphasis>\( (-4,4)\)</para>
<!-- BEGIN WORKED SOLUTION 5-->  
<para>\(-5(x + 2y=4)=-5x-10y=-20  \)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
  \(\begin{array}{r}5x+9y&amp;=&amp;16
  \\-5x-10y&amp;=&amp;-20
  \\ \hline
   -y&amp;=&amp;-4
  \\y&amp;=&amp;4
  \end{array}\)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
  
  <!--BEGIN ALIGN TO EQUALS -->
  \(\begin{array}{rcl}x+2(4)&amp;=&amp;4
   \\x+8&amp;=&amp;4
  \\x&amp;=&amp;-4
  \\\end{array}\)<!--END ALIGN TO EQUALS -->
  The solution is \((-4,4)\).</para>
  <!-- ENd WORKED SOLUTION 5--> 




<para>6. Solve</para> 
<para>\( \left\{ \begin{array}{c l} \frac{3}{2}x - \frac{1}{4}y = 5\\ \frac{1}{3}x + \frac{1}{6}y = 2 \end{array}\right. \)</para>
<list>
  <item>\((4,4)\)</item>
  <item>\((1,-5)\)</item>
  <item>\( (-\frac{1}{5}, \frac{2}{3})\)</item>
  <item>\((-4,-5)\)</item>
</list>
<para><b>Answer:</b> (4,4)</para>
<!-- BEGIN WORKED SOLUTION 6-->  
<para>\( 4( \frac32 x-\frac14 y=5)=6x-y=20\)</para><para>\(6( \frac13 x+\frac16 y=2)=2x+y=12\)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
  \(\begin{array}{r} 6x-y&amp;=&amp;20
  \\ 2x+y&amp;=&amp;12
  \\ \hline
  8x&amp;=&amp;32
  \\x&amp;=&amp;4
    \end{array}\)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
  
  <!--BEGIN ALIGN TO EQUALS -->
  </para><para>
    \(\begin{align*}
    2(4) + y &amp;= 12 \\
    8 + y &amp;= 12 \\
    y &amp;= 4 \\
    \end{align*}\)
    </para>
    <!--END ALIGN TO EQUALS -->
  
<para>The solution is \((4,4)\).</para>
  <!-- ENd WORKED SOLUTION 6--> 

 <para>7.  Solve  
  </para>
<para>\(\left\{\begin{array}{l}\frac13x\;+\;\frac19y\;=\;2\\–\;\frac12x\;+\;\frac45y\;=\;–3\end{array}\right.\)</para>
<list>
  <item>\((6,0)\)</item>
  <item>\((7,−3)\)</item>
  <item>\((8,−5)\)</item>
  <item>\((−2,−5)\)</item>
</list>
<para><b>Answer:</b>\( (6,0)\)</para>


<!-- BEGIN WORKED SOLUTION 7-->  

  <para>\(9( \frac13 x+ \frac19 y=2)=3x+y=18 \)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
  \(\begin{align*}-5x+8y&amp;=-30
  \\-24x-8y&amp;=-144
  \\ \hline
   -29x&amp;=-174
  \\x&amp;=6
  \\\end{align*}\)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
  
  <!--BEGIN ALIGN TO EQUALS -->
  
  \(\begin{align*}3x+y&amp;=18
  \\3(6)+y&amp;=18
  \\18+y&amp;=18
  \\y&amp;=0
  \\\end{align*}\)<!--END ALIGN TO EQUALS -->
  The solution is \((6,0)\).</para>
  <!-- ENd WORKED SOLUTION 7--> 
<para>8. Solve</para>
<para>  \(\left\{\begin{array}{l}6x\;–\;8y\;=\;\frac{16}5\\3x\;+\;2y\;=\;\frac{14}5\end{array}\right.\)</para>
<list>
  <item>\((4,−4.6)\)</item>
  <item>\((0,−0.4)\)</item>
  <item>\((0.8,0.2)\)</item>
  <item>\((2,1.1)\)</item>
</list>
<para><b>Answer:</b> \((0.8,0.2)\)</para>

<!-- BEGIN WORKED SOLUTION 8-->  
<para>\( 4( 3x+2y=\frac{14}{5})=12x+8y=\frac{56}{5}   \)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
  \(\begin{align*}6x-8y&amp;=\frac{16}{5}
  \\12x+8y&amp;=\frac{56}{5}
  \\ \hline
  18x&amp;=\frac{72}{5}
  \\90x&amp;=72
  \\x&amp;=\frac{72}{90}
  \\x&amp;=\frac{4}{5}
  \\x&amp;=0.8
  \\\end{align*}\)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
  


  <!--BEGIN ALIGN TO EQUALS -->
  
      \(\begin{align*}3(\frac45)+2y&amp;=\frac{14}{5}
      \\\frac{12}{5}+2y&amp;=\frac{14}{5}
      \\5(\frac{12}{5}+2y&amp;=\frac{14}{5})
      \\12+10y&amp;=14
      \\10y&amp;=2
      \\y&amp;=\frac{2}{10}
      \\y&amp;=\frac15
      \\y&amp;=0.2
      \\\end{align*}\)<!--END ALIGN TO EQUALS -->
  The solution is \((0.8,0.2)\).</para>
  <!-- ENd WORKED SOLUTION 8--> 

  <para>9.  Solve</para>
<para>\(\left\{\begin{array}{l}5x\;–\;2y\;=\;2\\7x\;–\;4y\;=\;2.5\end{array}\right.\)</para>
<list>
  <item>\((2.4,5)\)</item>
  <item>\((2,4)\)</item>
  <item>\((0,−1)\)</item>
  <item>\((0.5,0.25)\)</item>
</list>
<para><b>Answer: </b>(0.5,0.25)</para>
<!-- BEGIN WORKED SOLUTION 9-->  
<para>\(-2(5x-2y=2)=-10x+4y=-4\)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
    \(\begin{align*}-10x+4y&amp;=-4
    \\7x-4y&amp;=2.5
    \\ \hline
    -3x&amp;=-1.5
    \\x&amp;=0.5
    \end{align*}\)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
    
    <!--BEGIN ALIGN TO EQUALS -->
    
        \(\begin{align*}5(0.5)-2y&amp;=2
        \\2.5-2y&amp;=2
        \\-2y&amp;=-0.5
        \\y&amp;=0.25
        \\\end{align*}\)<!--END ALIGN TO EQUALS -->
    The solution is \((0.5,0.25)\).</para>
    <!-- ENd WORKED SOLUTION 9--> 





<para>10.  Solve</para>
<para>\(\left\{\begin{array}{l}\frac12x\;+\;\frac13y\;=\;\frac13\\\frac13x\;+\;\frac14y\;=\;-\frac18\end{array}\right.\)</para>
<list>
  <item>\((9,–12.5)\)</item>
  <item>\((0,1)\)</item>
  <item>\((6,–8)\)</item>
  <item>\((12,–17)\)</item>
</list>
<para><b>Answer: </b>\((9,–12.5) \)</para>

<!-- BEGIN WORKED SOLUTION -->  
<para>\(6( \frac12 x+\frac13 y=\frac13)=3x+2y=2 \)<!--BEGIN ALIGN TO EQUALS WITH LINE-->
  \(\begin{align*}-9x-6y&amp;=-6
  \\8x+6y&amp;=-3
  \\ \hline
  -x&amp;=-9
  \\x&amp;=9
  \\\end{align*}\)<!--BEGIN ALIGN TO EQUALS WITH LINE-->

 
  <!--BEGIN ALIGN TO EQUALS -->
  
      \(\begin{align*}3(9)+2y&amp;=2
      \\27+2y&amp;=2
      \\2y&amp;=-25
      \\y=&amp;-12.5
      \\\end{align*}\)<!--END ALIGN TO EQUALS -->
  The solution is \((9,-12.5)\).</para>
  <!-- ENd WORKED SOLUTION --> </section>
</content>
