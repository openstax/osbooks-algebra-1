  <content>
  <section>
    <section class="check-understanding">
      <exercise data-content-id="c35a4cc7-b899-4f3e-96f6-3425cf6e20d2">
        <problem>
          <para>
      <para>A store receives 2,000 decks of popular trading cards. The number of decks of cards is a function, \(d\), of the number of days, \(t\)<emphasis>,</emphasis> since the shipment arrived. Here is a table showing some values of \(d\)<emphasis>.</emphasis>
          
          <table class="os-raise-skinnytable">
            <thead>
              <row>
                <entry><emphasis>\(t\)</emphasis></entry><entry><emphasis>\(d(t)\)</emphasis></entry></row>
            </thead>
            <tbody>
              <row>
                <entry>
                  0
                </entry>
                <entry>
                  2,000
                </entry>
              </row>
              <row>
                <entry>
                  5
                </entry>
                <entry>
                  1,283
                </entry>
              </row>
              <row>
                <entry>
                  10
                </entry>
                <entry>
                  823
                </entry>
              </row>
              <row>
                <entry>
                  15
                </entry>
                <entry>
                  528
                </entry>
              </row>
              <row>
                <entry>
                  20
                </entry>
                <entry>
                  338
                </entry>
              </row>
            </tbody>
          </table>
          
          Calculate the average rate of change for the following intervals:
          
          
        </para>
        <para>day 0 to day 5</para>
        </para>
        </problem>
        <solution>
          <para>-143.4</para>
          <para>
      <para>The correct answer is –143.4 decks per day. </para>
    </para>
        </solution>
      </exercise>
    </section>
  </section>
</content>
