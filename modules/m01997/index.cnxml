  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="40aeeeef-9fc5-4816-ba5d-dc78df1f9699" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1a-->
  <exercise data-content-id="61432b7b-2103-4e11-9c7b-a2a0c07e1009" data-problem-comparator="integer" data-problem-type="input" data-solution="1">
    <problem>
      <para> Find one of the zeros of the functions using \((t−1)\). </para>
        <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! 1. From the factored form, we can tell that the graph intersects the horizontal axis at t=1. The zero of the function is the same value.</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
