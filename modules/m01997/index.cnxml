<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>What do the zeros tell us in this situation?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para> The zeros mean the time in seconds when the ball is on the ground.</para>
  </solution></exercise>
<!--Interaction End -->
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="623afb28-c479-4bcf-8be9-83e06b179782" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q#-->
  <exercise data-content-id="0c87020e-f0c2-47f7-b473-acf8830dad35" data-problem-type="dropdown" data-solution="No" data-solution-options="[&quot;Yes&quot;, &quot;No&quot;]">
    <problem>
      <para>Are both zeros meaningful?</para>
      </problem>
    <solution>
      <para>Correct! No. Only one of them is meaningful. The negative zero doesn't mean anything here. </para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
