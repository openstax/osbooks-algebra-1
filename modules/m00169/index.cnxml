<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.7.2: Explaining Acceptable Moves to Solve an Equation</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00169</md:content-id>
    <md:title>1.7.2: Explaining Acceptable Moves to Solve an Equation</md:title>
    <md:uuid>fbe66b1c-8d96-4528-b3fa-5d1786b49482</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">      <title>Activity</title>
      <exercise id="exer-00001">
