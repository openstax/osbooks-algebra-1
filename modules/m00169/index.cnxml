        <para id="para-00001"><link class="os-embed" url="#exercise/Alg1_1_7_2_PLA_295"/></para>
        </problem>
        </exercise>
       
    </section>
    <section id="sect-00002">
      <note class="self-check" id="note-00001">
        <exercise id="exer-00006">
          <problem id="prob-00006">
          <para id="para-00013"><link class="os-embed" url="#exercise/Alg1_1_7_2_SC"/></para>
