  <content>
  <section id="sect-00001">
    <title>Warm Up Activity</title>
    
    <para id="para-00001">Your teacher will assign you one of these expressions:</para>
<para id="para-00002">\( \dfrac {n^2 - 9}{2(4-3)}\qquad \text{or} \qquad (n+3)\cdot \dfrac {n-3}{8-3\cdot2} \)</para>
<para id="para-00003">For numbers 1 - 4, evaluate your expression when \(n\) is the given value.</para>

<exercise id="_79719b29-e056-4e5a-85b9-40c373225c3c" class="multiple-choice">
  <problem id="prob-00001">
    <para id="para-00005">\(n = 5\)</para>
    <para id="para-00004">Enter your answer here:</para>
      </problem>
      <solution id="sol-00001"><para id="para-00006">Correct! 8</para><para id="para-00007">Nice try! The correct answer is 8.</para>
      </solution>
    </exercise>
    
    <exercise id="ea06284b-5685-43df-a933-60c09cb7865d" class="multiple-choice">
      <problem id="prob-00002">
        <para id="para-00009">\(n = 7\)</para>
        <para id="para-00008">Enter your answer here:</para>
      </problem>
      <solution id="sol-00002">
        <para id="para-00010">Correct! 20</para><para id="para-00011">Nice try! The correct answer is 20.</para>
      </solution>
      </exercise>
      
      <exercise id="_4ca2009d-6925-4174-ac0d-833f66282099" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00013">\(n = 13\)</para>
          <para id="para-00012">Enter your answer here:</para>
      </problem>
      <solution id="sol-00003"><para id="para-00014">Correct! 80</para><para id="para-00015">Nice try! The correct answer is 80.</para></solution></exercise>
      
      <exercise id="da392198-4dae-45eb-a9d6-5b9e93f9f546" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00017">\(n = -1\)</para>
          <para id="para-00016">Enter your answer here:</para>
      </problem>
      <solution id="sol-00004"><para id="para-00018">Correct! -4</para><para id="para-00019">Nice try! The correct answer is -4.</para>
      </solution>
    </exercise>
    
<!--Q#5-->
<exercise id="exer-00005">
  <problem id="prob-00005">
    <para id="para-00020">What did you discover when you compared your answers? Explain your rationale.</para>
    <para id="para-00021">Enter your answer here:</para>
    </problem>
    <solution id="sol-00005">
  <para id="para-00022">Compare your answer:</para>
    
    <para id="para-00023">Your answer may vary, but here is a sample. 
      Even though our questions were different, the answers were the same because the expressions were equivalent.
    </para>
  
  </solution>
</exercise>
