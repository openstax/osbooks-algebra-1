  <content>
  <section><title>Warm Up Activity</title>
<para>Your teacher will assign you one of these expressions:</para>
<para>\( \dfrac {n^2 - 9}{2(4-3)}\qquad \text{or} \qquad (n+3)\cdot \dfrac {n-3}{8-3\cdot2} \)</para>
<para>For numbers 1 - 4, evaluate your expression when \(n\) is the given value.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="a10cb250-3e96-4b2b-ae81-24d955b171b3" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1-->
  <exercise data-content-id="79719b29-e056-4e5a-85b9-40c373225c3c" data-problem-comparator="integer" data-problem-type="input" data-solution="8">
    <problem>
      <para>\(n = 5\)</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! 8</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q2-->
  <exercise data-content-id="ea06284b-5685-43df-a933-60c09cb7865d" data-problem-comparator="integer" data-problem-type="input" data-solution="20">
    <problem>
      <para>\(n = 7\)</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! 20</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q3-->
  <exercise data-content-id="4ca2009d-6925-4174-ac0d-833f66282099" data-problem-comparator="integer" data-problem-type="input" data-solution="80">
    <problem>
      <para>\(n = 13\)</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! 80</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q4-->
  <exercise data-content-id="da392198-4dae-45eb-a9d6-5b9e93f9f546" data-problem-comparator="integer" data-problem-type="input" data-solution="-4">
    <problem>
      <para>\(n = -1\)</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! -4</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
