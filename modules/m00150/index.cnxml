<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.6.1: Exploring Equivalent Expressions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00150</md:content-id>
    <md:title>1.6.1: Exploring Equivalent Expressions</md:title>
    <md:uuid>d3f3cfa2-e912-493d-be0c-7b6dbec58a82</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Warm Up Activity</title>
      <para id="para-00001">Your teacher will assign you one of these expressions:</para>
      <para id="para-00002"><m:math><m:mrow><m:mstyle displaystyle="true" scriptlevel="0"><m:mfrac><m:mrow><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow><m:mrow><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:mfrac></m:mstyle><m:mspace width="2em"/><m:mtext>or</m:mtext><m:mspace width="2em"/><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mi>·</m:mi><m:mstyle displaystyle="true" scriptlevel="0"><m:mfrac><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>·</m:mi><m:mn>2</m:mn></m:mrow></m:mfrac></m:mstyle></m:mrow></m:math></para><para id="para-00003">For numbers 1 - 4, evaluate your expression when <m:math display="inline"><m:mrow><m:mi>n</m:mi></m:mrow></m:math> is the given value.</para>
      <exercise id="_79719b29-e056-4e5a-85b9-40c373225c3c" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00004"><m:math><m:mrow><m:mi>n</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00001">
          <para id="para-00006">Correct! 8</para>
          <para id="para-00007">Nice try! The correct answer is 8.</para>
        </solution>
      </exercise>
      <exercise id="ea06284b-5685-43df-a933-60c09cb7865d" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00005"><m:math><m:mrow><m:mi>n</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00002">
          <para id="para-00010">Correct! 20</para>
          <para id="para-00011">Nice try! The correct answer is 20.</para>
        </solution>
      </exercise>
      <exercise id="_4ca2009d-6925-4174-ac0d-833f66282099" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00008"><m:math><m:mrow><m:mi>n</m:mi><m:mo>=</m:mo><m:mn>13</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00003">
          <para id="para-00014">Correct! 80</para>
          <para id="para-00015">Nice try! The correct answer is 80.</para>
        </solution>
      </exercise>
      <exercise id="da392198-4dae-45eb-a9d6-5b9e93f9f546" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00009"><m:math><m:mrow><m:mi>n</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00004">
          <para id="para-00018">Correct! -4</para>
          <para id="para-00019">Nice try! The correct answer is -4.</para>
        </solution>
      </exercise>
      <!--Q#5-->
      <exercise id="exer-00001">
        <problem id="prob-00005">
          <para id="para-00020">What did you discover when you compared your answers? Explain your rationale.</para>
          </problem>
        <solution id="sol-00005">
          <para id="para-00022">Compare your answer: </para>
          <para id="para-00023">Your answer may vary, but here is a sample. Even though our questions were different, the answers were the same because the expressions were equivalent.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>