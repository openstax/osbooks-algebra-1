<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Finding Solutions of Equations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00918</md:content-id>
    <md:title>Finding Solutions of Equations</md:title>
    <md:uuid>817871a6-38f2-4f33-abde-91b591dd3342</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>
<para id="para-00001">Consider the equation <m:math display="inline"><m:mrow><m:mi>q</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>0.8</m:mn><m:mi>p</m:mi></m:mrow></m:math>.</para>
<!--Question 1a -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002">What value of <m:math display="inline"><m:mrow><m:mi>q</m:mi></m:mrow></m:math> would make the equation true when <m:math display="inline"><m:mrow><m:mi>p</m:mi></m:mrow></m:math> is 7?</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00003">Compare your answer: </para>
    
    <para id="para-00004"><m:math><m:mrow><m:mi>q</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>0.8</m:mn><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00005"><m:math><m:mrow><m:mi>q</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>5.6</m:mn></m:mrow></m:math></para><para id="para-00006"><m:math><m:mrow><m:mi>q</m:mi><m:mo>=</m:mo><m:mn>9.6</m:mn></m:mrow></m:math></para></solution></exercise>

<!--Question 1b -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00007">What value of <m:math display="inline"><m:mrow><m:mi>q</m:mi></m:mrow></m:math> would make the equation true when <m:math display="inline"><m:mrow><m:mi>p</m:mi></m:mrow></m:math> is 100?</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00008">Compare your answer: </para>
    
    <para id="para-00009"><m:math><m:mrow><m:mi>q</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>0.8</m:mn><m:mo stretchy="false">(</m:mo><m:mn>100</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00010"><m:math><m:mrow><m:mi>q</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>80</m:mn></m:mrow></m:math></para><para id="para-00011"><m:math><m:mrow><m:mi>q</m:mi><m:mo>=</m:mo><m:mn>84</m:mn></m:mrow></m:math></para></solution></exercise>

<!--Question 2a -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00012">What value of <m:math display="inline"><m:mrow><m:mi>p</m:mi></m:mrow></m:math> would make the equation true when <m:math display="inline"><m:mrow><m:mi>q</m:mi></m:mrow></m:math> is 12?</para>

    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00013">Compare your answer: </para>
    
    <para id="para-00014"><m:math><m:mrow><m:mn>12</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>0.8</m:mn><m:mi>p</m:mi></m:mrow></m:math></para><para id="para-00015"><m:math><m:mrow><m:mn>12</m:mn><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>0.8</m:mn><m:mi>p</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00016"><m:math><m:mrow><m:mn>8</m:mn><m:mo>=</m:mo><m:mn>0.8</m:mn><m:mi>p</m:mi></m:mrow></m:math></para><para id="para-00017"><m:math><m:mrow><m:mn>8</m:mn><m:mn>0.8</m:mn><m:mo>=</m:mo><m:mn>0.8</m:mn><m:mi>p</m:mi><m:mn>0.8</m:mn></m:mrow></m:math></para><para id="para-00018"><m:math><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math></para></solution></exercise>

<!--Question 2b -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00019">What value of <m:math display="inline"><m:mrow><m:mi>p</m:mi></m:mrow></m:math> would make the equation true when <m:math display="inline"><m:mrow><m:mi>q</m:mi></m:mrow></m:math> is 60?</para></problem><solution id="sol-00004">
    
    
  
  <para id="para-00020">Compare your answer: </para>
    
    <para id="para-00021"><m:math><m:mrow><m:mn>60</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>0.8</m:mn><m:mi>p</m:mi></m:mrow></m:math></para><para id="para-00022"><m:math><m:mrow><m:mn>60</m:mn><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>0.8</m:mn><m:mi>p</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00023"><m:math><m:mrow><m:mn>56</m:mn><m:mo>=</m:mo><m:mn>0.8</m:mn><m:mi>p</m:mi></m:mrow></m:math></para><para id="para-00024"><m:math><m:mrow><m:mn>56</m:mn><m:mn>0.8</m:mn><m:mo>=</m:mo><m:mn>0.8</m:mn><m:mi>p</m:mi><m:mn>0.8</m:mn></m:mrow></m:math></para><para id="para-00025"><m:math><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>70</m:mn></m:mrow></m:math></para></solution></exercise></section>
</content></document>