<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.5.1: Finding Solutions of Equations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00918</md:content-id>
    <md:title>4.5.1: Finding Solutions of Equations</md:title>
    <md:uuid>a1c2f63b-3566-413e-abe0-579b26f404ab</md:uuid>
  </metadata>
  <content>
  <section><title>Warm Up Activity</title>
<para>Consider the equation \(q = 4 + 0.8p\).</para>
<!--Question 1a -->
<exercise>
  <problem>
    <para>What value of \(q\) would make the equation true when \(p\) is 7? </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(q = 4 + 0.8(7)\)</para>
    <para>\(q = 4 + 5.6\)</para>
    <para>\(q=9.6\)</para>
  </solution></exercise>

<!--Question 1b -->
<exercise>
  <problem>
    <para>What value of \(q\) would make the equation true when \(p\) is 100?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(q = 4 + 0.8(100)\)</para>
    <para>\(q = 4 + 80\)</para>  
    <para>\(q=84\)</para>
  </solution></exercise>

<!--Question 2a -->
<exercise>
  <problem>
    <para>What value of \(p\) would make the equation true when \(q\) is 12?</para>

    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(12 = 4 + 0.8p\)</para>
    <para>\(12 - 4 = 4 + 0.8p - 4\)</para>
    <para>\(8 = 0.8p\)</para>
   <para>\( 8  0.8 = 0.8p 0.8\)</para>
    <para>\(p=10\)</para>
  </solution></exercise>

<!--Question 2b -->
<exercise>
  <problem>
    <para> What value of \(p\) would make the equation true when \(q\) is 60?</para></problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(60 = 4 + 0.8p\)</para>
    <para>\(60 - 4 = 4 + 0.8p - 4\)</para>
    <para>\(56 = 0.8p\)</para>
    <para>\(56  0.8 = 0.8p 0.8\)</para>
    <para>\(p=70\)</para>
  </solution></exercise></section>
</content>
