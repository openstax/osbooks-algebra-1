<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.5.1: Finding Solutions of Equations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00918</md:content-id>
    <md:title>4.5.1: Finding Solutions of Equations</md:title>
    <md:uuid>817871a6-38f2-4f33-abde-91b591dd3342</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Warm Up Activity</title>
<para id="para-00001">Consider the equation \(q = 4 + 0.8p\).</para>
<!--Question 1a -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002">What value of \(q\) would make the equation true when \(p\) is 7?</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00003">Compare your answer:</para>
    
    <para id="para-00004">\(q = 4 + 0.8(7)\)</para>
    
    <para id="para-00005">\(q = 4 + 5.6\)</para>
    
    <para id="para-00006">\(q=9.6\)</para>
  
  </solution></exercise>

<!--Question 1b -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00007">What value of \(q\) would make the equation true when \(p\) is 100?</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00008">Compare your answer:</para>
    
    <para id="para-00009">\(q = 4 + 0.8(100)\)</para>
    
    <para id="para-00010">\(q = 4 + 80\)</para>  
      
    <para id="para-00011">\(q=84\)</para>
  
  </solution></exercise>

<!--Question 2a -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00012">What value of \(p\) would make the equation true when \(q\) is 12?</para>

    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00013">Compare your answer:</para>
    
    <para id="para-00014">\(12 = 4 + 0.8p\)</para>
    
    <para id="para-00015">\(12 - 4 = 4 + 0.8p - 4\)</para>
    
    <para id="para-00016">\(8 = 0.8p\)</para>
   
   <para id="para-00017">\( 8  0.8 = 0.8p 0.8\)</para>
    
    <para id="para-00018">\(p=10\)</para>
  
  </solution></exercise>

<!--Question 2b -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00019">What value of \(p\) would make the equation true when \(q\) is 60?</para></problem><solution id="sol-00004">
    
    
  
  <para id="para-00020">Compare your answer:</para>
    
    <para id="para-00021">\(60 = 4 + 0.8p\)</para>
    
    <para id="para-00022">\(60 - 4 = 4 + 0.8p - 4\)</para>
    
    <para id="para-00023">\(56 = 0.8p\)</para>
    
    <para id="para-00024">\(56  0.8 = 0.8p 0.8\)</para>
    
    <para id="para-00025">\(p=70\)</para>
  
  </solution></exercise></section>
</content></document>