  <!--Q#3-->
  <exercise data-content-id="7ab20181-2576-4245-91a9-4db512aeb97f" data-problem-type="dropdown" data-solution="Orchard A" data-solution-options="[&quot;Orchard A&quot;, &quot;Orchard B&quot;]">
    <problem>
      <para>Which orchard would be cheaper to visit if the class has 30 students?</para>
      </problem>
    <solution>
      <para>Correct! Orchard A.</para>
    </solution>
