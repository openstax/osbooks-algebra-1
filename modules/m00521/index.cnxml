  <!--Q#2-->
  <exercise data-content-id="5810148a-d726-4ca6-bd3f-1a616d5b2134" data-problem-type="dropdown" data-solution="Orchard B" data-solution-options="[&quot;Orchard A&quot;, &quot;Orchard B&quot;]">
    <problem>
      <para>Which orchard would be cheaper to visit if the class has 12 students?</para>
      </problem>
    <solution>
      <para>Correct! Orchard B.</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
