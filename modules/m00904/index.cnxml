  <content>
  <section><para>Which function rule can describe the table below?</para>
<table class="os-raise-skinnytable">
 
  <thead>
    <row>
      <entry scope="col" class="emphasis">
       \(x\)
      </entry>
      <entry scope="col" class="emphasis">
        \(y\)
      </entry>
    </row>
  </thead>
  <tbody>
    <row>
      <entry>
        <para>1</para>
      </entry>
      <entry>
        <para>3</para>
      </entry>
    </row>
    <row>
      <entry>
        <para>2</para>
      </entry>
      <entry>
        <para>5</para>
      </entry>
    </row>
    <row>
      <entry>
        <para>5</para>
      </entry>
      <entry>
        <para>11</para>
      </entry>
    </row>
  </tbody>
</table>
</section>
</content>
