<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>3.2.5: Working with Fitted Lines</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00723</md:content-id>
    <md:title>3.2.5: Working with Fitted Lines</md:title>
    <md:uuid>bb8cbbf7-79f0-4513-84c2-a6c100712cc7</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Cool Down Activity</title>
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00001">Which of these scatter plots shows data that would best be modeled with a linear
            function? Be prepared to show your reasoning.</para>
          <para id="para-00002">Graph A <media alt="Scatterplot.">
              <image mime-type="image/svg+xml" src="../../media/Algebra-1_03_04_12_01.svg"/>
            </media>
            </para>
          <para id="para-00003">Graph B <media alt="Scatter plot.">
              <image mime-type="image/svg+xml" src="../../media/Algebra-1_03_04_12_02.svg"/>
            </media>
            </para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00004">Compare your answer:</para>
          <para id="para-00005">Graph B. Your answer may vary, but here is a sample. The points in scatter plot B
            seem to follow the shape of a line of best fit. The points in scatter plot in A are very
            spread out.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00006">Which of the following lines is most likely the line of best fit for the data
            provided?</para>
          <para id="para-00007"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.51</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>225.12</m:mn></m:mrow></m:math></para>
          <para id="para-00008"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>0.34</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>34.05</m:mn></m:mrow></m:math></para>
          <para id="para-00009"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>0.13</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>0.19</m:mn></m:mrow></m:math></para>
          <para id="para-00010"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>0.98</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>21.13</m:mn></m:mrow></m:math></para>
          <media alt="A scatterplot.">
            <image mime-type="image/svg+xml" src="../../media/Algebra-1_03_04_12_03.svg"/>
          </media>


          <table class="os-raise-midsizetable unnumbered" id="table-00001">
            <tgroup cols="2">
              <thead>
                <row>
                  <entry>
                    <emphasis> number of trees in a forest</emphasis>
                  </entry>
                  <entry>
                    <emphasis> tons of oxygen produced by the forest</emphasis>
                  </entry>
                </row>
              </thead>
              <tbody>
                <row>
                  <entry> 148 </entry>
                  <entry> 16.43 </entry>
                </row>
                <row>
                  <entry> 175 </entry>
                  <entry> 25.64 </entry>
                </row>
                <row>
                  <entry> 190 </entry>
                  <entry> 23.28 </entry>
                </row>
                <row>
                  <entry> 200 </entry>
                  <entry> 29.2 </entry>
                </row>
                <row>
                  <entry> 202 </entry>
                  <entry> 21.41 </entry>
                </row>
                <row>
                  <entry> 425 </entry>
                  <entry> 60.56 </entry>
                </row>
                <row>
                  <entry> 505 </entry>
                  <entry> 50.75 </entry>
                </row>
                <row>
                  <entry> 528 </entry>
                  <entry> 74.45 </entry>
                </row>
                <row>
                  <entry> 562 </entry>
                  <entry> 62.66 </entry>
                </row>
                <row>
                  <entry> 585 </entry>
                  <entry> 84.24 </entry>
                </row>
              </tbody>
            </tgroup>
          </table>
        </problem>
        <solution id="sol-00002">
          <para id="para-00011">Compare your answer:</para>
          <para id="para-00012"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>0.13</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>0.19</m:mn></m:mrow></m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
    </section>
