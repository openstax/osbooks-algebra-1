<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.12.4: Finding the Missing Data in the Set</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02297</md:content-id>
    <md:title>8.12.4: Finding the Missing Data in the Set</md:title>
    <md:uuid>db418611-be59-4ab0-9b85-6dd3b7bf3ed8</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Cool Down Activity</title>
<para id="para-00001">Thomasina used a quadratic data set to create a curve of best fit for her data. Then she accidentally spilled paint on her paper and lost some of the entries in the table.</para>
<media alt="...">
<iframe src="../../media/desmos/751571f87aa30ca23d0f4263103fc4da5ca1ec7a.html" width="500" height="400"/>
</media>
<para id="para-00002">She needs to work backward to fill in the missing entries in her data set. Use the curve of best fit she created to complete the table.</para>
<exercise id="exer-00001">
  <problem id="prob-00001">
    <table class="unnumbered os-raise-skinnytable" id="table-00001">
      <tgroup cols="2"><tbody><row>
            <entry><emphasis>
              <m:math display="inline"><m:mrow><m:msub><m:mi>x</m:mi><m:mn>1</m:mn></m:msub></m:mrow></m:math>
           </emphasis> </entry><entry><emphasis>
              <m:math display="inline"><m:mrow><m:msub><m:mi>y</m:mi><m:mn>1</m:mn></m:msub></m:mrow></m:math>
           </emphasis> </entry></row>
          <row>
            <entry>
              6
            </entry>
            <entry/>
          </row>
          <row>
            <entry/>
            <entry>
              452.06
            </entry>
          </row>
          <row>
            <entry/>
            <entry>
              632.24
            </entry>
          </row>
          <row>
            <entry>
              58.2
            </entry>
            <entry/>
          </row>
          <row>
            <entry/>
            <entry>
              176.12
            </entry>
          </row>
        </tbody></tgroup></table>
    
    
  
  <para id="para-00003">Write down your answers, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00001">
  <para id="para-00004">Compare your answers:</para>
  
  <table class="unnumbered os-raise-skinnytable" id="table-00002">
    <tgroup cols="2"><tbody><row>
          <entry><emphasis>
            <m:math display="inline"><m:mrow><m:msub><m:mi>x</m:mi><m:mn>1</m:mn></m:msub></m:mrow></m:math>
         </emphasis> </entry><entry><emphasis>
            <m:math display="inline"><m:mrow><m:msub><m:mi>y</m:mi><m:mn>1</m:mn></m:msub></m:mrow></m:math>
         </emphasis> </entry></row>
        <row>
          <entry>
            6
          </entry>
          <entry>
            188.07
          </entry>
        </row>
        <row>
          <entry>
            17.9
          </entry>
          <entry>
            452.06
          </entry>
        </row>
        <row>
          <entry>
            31.1
          </entry>
          <entry>
            632.24
          </entry>
        </row>
        <row>
          <entry>
            58.2
          </entry>
          <entry>
            630.83
          </entry>
        </row>
        <row>
          <entry>
            83.6
          </entry>
          <entry>
            176.12
          </entry>
        </row>
      </tbody></tgroup></table>

</solution></exercise>
</section>
