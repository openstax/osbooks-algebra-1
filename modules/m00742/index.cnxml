<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>3.3.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00742</md:content-id>
    <md:title>3.3.5: Practice</md:title>
    <md:uuid>bd9b19b4-56a8-48d2-a705-7495dab132e0</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <para id="para-00002">Using the following information, find the residual for each of the coordinate
        pairs, <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>,</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math> in 1 - 6.</para>
      <para id="para-00003">
        <quote id="quote-00001">A line of best fit for a data set is \(y=1.1x+3.4\). </quote>
      </para>

        <exercise id="_9196cbfd-6686-44e7-b947-f95b2d634560" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00004"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>8.8</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00005">Correct! <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>0.1</m:mn></m:mrow></m:math></para>
            <para id="para-00006">Try again. Revisit activity 3.3.2.</para>
            <para id="para-00007">The correct answer is <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>0.1</m:mn></m:mrow></m:math>.</para>
            <para id="para-00008"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1.1</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3.4</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1.1</m:mn><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>3.4</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>8.9</m:mn><m:mspace linebreak="newline"/><m:mn>8.8</m:mn><m:mi>−</m:mi><m:mn>8.9</m:mn><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>0.1</m:mn></m:mrow></m:math></para>
          </solution>
        </exercise>
        <exercise id="_41ea8366-511c-46f1-9248-bcdf9d8ae799" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00009"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2.5</m:mn><m:mo>,</m:mo><m:mn>5.95</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00010">Correct! <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>0.2</m:mn></m:mrow></m:math></para>
            <para id="para-00011">Try again. Revisit activity 3.3.2.</para>
            <para id="para-00012">The correct answer is <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>0.2</m:mn></m:mrow></m:math>. </para>
            <para id="para-00013"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1.1</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3.4</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1.1</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2.5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>3.4</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>6.15</m:mn><m:mspace linebreak="newline"/><m:mn>5.95</m:mn><m:mi>−</m:mi><m:mn>6.15</m:mn><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>0.2</m:mn></m:mrow></m:math></para>
          </solution>
        </exercise>
        <exercise id="_796342e5-4c65-41f0-81ad-1a55e4a44250" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00014"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>3.72</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00015">Correct! 0.32</para>
            <para id="para-00016">Try again. Revisit activity 3.3.2.</para>
            <para id="para-00017">The correct answer is 0.32. </para>
            <para id="para-00018"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1.1</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3.4</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1.1</m:mn><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>3.4</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>3.4</m:mn><m:mspace linebreak="newline"/><m:mn>3.72</m:mn><m:mi>−</m:mi><m:mn>3.4</m:mn><m:mo>=</m:mo><m:mn>0.32</m:mn></m:mrow></m:math></para>
          </solution>
        </exercise>
        <exercise id="_43d436cf-1bfb-4538-8998-9e2746249a2a" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00019"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1.5</m:mn><m:mo>,</m:mo><m:mn>5.05</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00020">Correct!  0</para>
            <para id="para-00021">Try again. Revisit activity 3.3.2.</para>
            <para id="para-00022">The correct answer is 0. </para>
            <para id="para-00023"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1.1</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3.4</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1.1</m:mn><m:mo stretchy="false">(</m:mo><m:mn>1.5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>3.4</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5.05</m:mn><m:mspace linebreak="newline"/><m:mn>5.05</m:mn><m:mi>−</m:mi><m:mn>5.05</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para>
          </solution>
        </exercise>
        <exercise id="_7e052619-fa5c-4e8e-86a9-4b2d4a6147fe" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00024"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00025">Correct! <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>0.1</m:mn></m:mrow></m:math></para>
            <para id="para-00026">Try again. Revisit activity 3.3.2.</para>
            <para id="para-00027">The correct answer is <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>0.1</m:mn></m:mrow></m:math>. </para>
            <para id="para-00028"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1.1</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3.4</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1.1</m:mn><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>3.4</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>0.1</m:mn><m:mspace linebreak="newline"/><m:mn>0</m:mn><m:mi>−</m:mi><m:mn>0.1</m:mn><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>0.1</m:mn></m:mrow></m:math></para>
          </solution>
        </exercise>
        <exercise id="_6c00c18c-7142-4177-8446-3f86054d3eb9" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00029"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>4.86</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00030">Correct! <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>2.76</m:mn></m:mrow></m:math></para>
            <para id="para-00031">Try again. Revisit activity 3.3.2.</para>
            <para id="para-00032">The correct answer is <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>2.76</m:mn></m:mrow></m:math>. </para>
            <para id="para-00033"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1.1</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3.4</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1.1</m:mn><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>3.4</m:mn><m:mspace linebreak="newline"/><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>2.1</m:mn><m:mspace linebreak="newline"/><m:mi>−</m:mi><m:mn>4.86</m:mn><m:mi>−</m:mi><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>2.1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>2.76</m:mn></m:mrow></m:math></para>
          </solution>
        </exercise>

        <exercise id="eb973c60-4a19-4cee-8d55-46c103eaa674" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00034">In the scatter plot below, the length of fish and the age of the fish are
              shown. The residual for the fish that is 2 years old and 100 mm long is 8.06 mm.</para>
            <para id="para-00035">
              <media alt="A SCATTER PLOT THAT SHOWS AGE OF FISH IN YEARS ON THE X-AXIS AND LENGTH OF FISH IN MILLIMETERS ON THE Y-AXIS. A LINE OF BEST FIT IS DRAWN, AND THE POINT (2, 100) IS LABELED.">
                <image mime-type="image/svg+xml" src="../../media/Algebra-1_03_05_10_01.svg"/>
              </media>

            </para>
            <para id="para-00036">What does this residual mean?</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00037">Correct! The actual fish at 2 years old is about 8 mm longer than the linear model
              estimates. </para>
            <para id="para-00038">Try again. Revisit activities 3.3.2 – 3.3.3.</para>
            <para id="para-00039">Compare your answer: The actual fish at 2 years old is about 8 mm longer than the
              linear model estimates. </para>
          </solution>
        </exercise>

        <para id="para-00040">Use the following information to answer 8 - 11.</para>
        <para id="para-00041">
          <quote id="quote-00002">Four athletes on a track team are comparing their personal bests in the
          100-meter and 200-meter events. A table of their best times is shown below. </quote>
          <quote id="quote-00003">
            <table class="unnumbered" id="table-00001">
              <tgroup cols="3">
                <thead>
                  <row>
                    <entry>Athlete</entry>
                    <entry>100 m time (seconds)</entry>
                    <entry>200 m time (seconds)</entry>
                  </row>
                </thead>
                <tbody>
                  <row>
                    <entry>1</entry>
                    <entry>12.95</entry>
                    <entry>26.68</entry>
                  </row>
                  <row>
                    <entry>2</entry>
                    <entry>13.81</entry>
                    <entry>29.48</entry>
                  </row>
                  <row>
                    <entry>3</entry>
                    <entry>14.66</entry>
                    <entry>28.11</entry>
                  </row>
                  <row>
                    <entry>4</entry>
                    <entry>14.88</entry>
                    <entry>30.93</entry>
                  </row>
                </tbody>
              </tgroup>
            </table>
          </quote>
          <quote id="quote-00004">The
          line of best fit has an equation of \(y= 1.5115x + 7.526\), where \(x\) represents the
          100-meter time and \(y\) represents the 200-meter time. </quote>
        </para>

        <exercise id="cdacea9f-490b-4fbe-97b6-0cea60ee4cbc" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00042">What is the residual for athlete number 1?</para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00043">Correct! <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>0.42</m:mn></m:mrow></m:math></para>
            <para id="para-00044">Try again. Revisit activity 3.3.2.</para>
            <para id="para-00045">Compare your answer: <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>0.42</m:mn></m:mrow></m:math>.</para>
            <para id="para-00046">\(y = 1.5115x + 7.526\\ y = 1.5115(12.95) + 7.526\\ y = 27.10\\ 26.68 − 27.10 =
              −0.42\)</para>
          </solution>
        </exercise>
        <exercise id="_3ba4d02e-7eba-4bfd-bf53-83fddd611ca9" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00047">What is the residual for athlete number 2?</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00048">Correct! 1.08</para>
            <para id="para-00049">Try again. Revisit activity 3.3.2.</para>
            <para id="para-00050">Compare your answer: 1.08.</para>
            <para id="para-00051">\(y = 1.5115x + 7.526\\ y = 1.5115(13.81) + 7.526\\ y = 28.40\\ 29.48 − 28.40 =
              1.08\)</para>
          </solution>
        </exercise>
        <exercise id="b418d045-c6ee-4f99-b053-064adabb94ca" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00052">What is the residual for athlete number 3?</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00053">Correct! <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>1.57</m:mn></m:mrow></m:math></para>
            <para id="para-00054">Try again. Revisit activity 3.3.2.</para>
            <para id="para-00055">Compare your answer: <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>1.57</m:mn></m:mrow></m:math>.</para>
            <para id="para-00056">\(y = 1.5115x + 7.526\\ y = 1.5115(14.66) + 7.526\\ y = 29.68\\ 28.11 − 29.68 =
              −1.57\)</para>
          </solution>
        </exercise>
        <exercise id="_0068eba3-1a1b-49b0-ad19-acc695d72437" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00057">What is the residual for athlete number 4?</para>
          </problem>
          <solution id="sol-00011">
            <para id="para-00058">Correct! 0.91</para>
            <para id="para-00059">Try again. Revisit activity 3.3.2.</para>
            <para id="para-00060">Compare your answer: 0.91.</para>
            <para id="para-00061">\(y = 1.5115x + 7.526\\ y = 1.5115(14.88) + 7.526\\ y = 30.02\\ 30.93 − 30.02 =
              0.91\)</para>
          </solution>
        </exercise>

        <exercise id="d8d7b36d-05a3-466c-883b-73fecef80ce2" class="multiple-choice">
          <problem id="prob-00012">
            <para id="para-00062">The curb weight of a car is the weight of the car without luggage or
              passengers. The scatter plot below shows the curb weight, in pounds, of 5 cars and
              their fuel efficiency, in miles per gallon.</para>

            <para id="para-00063">Will the residual for 25.33 be a positive or negative value?</para>

            <para id="para-00064">
              <media alt="A SCATTER PLOT WITH CURB WEIGHT IN HUNDREDS OF POUNDS ON THE X-AXIS AND FUEL EFFICIENCY IN MILES PER GALLON ON THE Y-AXIS. A LINE OF BEST FIT IS DRAWN. FOUR POINTS ARE ABOVE THE LINE AND ONE POINT IS BELOW.">
                <image mime-type="image/jpeg" src="../../media/Algebra-1_03_05_10_02.jpg"/>
              </media>

            </para>
          </problem>
          <solution id="sol-00012">
            <para id="para-00065">Correct! The residual is positive because it is above the line.</para>
            <para id="para-00066">Try again. Revisit activities 3.3.3 – 3.3.4.</para>
            <para id="para-00067">Compare your answer: the residual is positive because it is above the line.</para>
          </solution>
        </exercise>
    </section>
  </content>
