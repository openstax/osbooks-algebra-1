  <content>
  <section><para dir="ltr">Complete the following questions to practice the skills you have learned in this lesson.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="4743a5f5-87da-4624-a6a3-3f973e2820a1" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--Q1-->
  <exercise data-content-id="9196cbfd-6686-44e7-b947-f95b2d634560" data-problem-type="dropdown" data-retry-limit="4" data-solution="-0.1" data-solution-options="[&quot;-0.1&quot;, &quot;-0.2&quot;, &quot;0.32&quot;, &quot;0&quot;, &quot;-2.76&quot;]">
    <problem>
      <para>Using the following information, find the residual for each of the coordinate pairs, \((x,y)\) in 1 - 6. </para>
      <blockquote>
        <para>A line of best fit for a data set is \(y=1.1x+3.4\). </para>
      </blockquote>
      <para>\((5,8.8)\)</para>
      </problem>
    <solution>
      <para>Correct! \(-0.1\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 3.3.2.</para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1b-->
  <exercise data-content-id="41ea8366-511c-46f1-9248-bcdf9d8ae799" data-problem-type="dropdown" data-retry-limit="4" data-solution="-0.2" data-solution-options="[&quot;-0.1&quot;, &quot;-0.2&quot;, &quot;0.32&quot;, &quot;0&quot;, &quot;-2.76&quot;]">
    <problem>
      <para>\((2.5,5.95)\)</para>
      </problem>
    <solution>
      <para>Correct! \(-0.2\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 3.3.2.</para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1c-->
  <exercise data-content-id="796342e5-4c65-41f0-81ad-1a55e4a44250" data-problem-type="dropdown" data-retry-limit="4" data-solution="0.32" data-solution-options="[&quot;-0.1&quot;, &quot;-0.2&quot;, &quot;0.32&quot;, &quot;0&quot;, &quot;-2.76&quot;]">
