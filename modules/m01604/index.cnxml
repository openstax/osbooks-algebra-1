          <item> binomial </item>
          <item> trinomial </item>
          <item> polynomial </item>
          <item> polynomial function</item>
          <item>dividend in polynomials</item>
          <item>divisor in polynomials</item>
          <item>quotient in polynomials</item>
        </list>
      </entry>
