<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.5.3: Choosing an Effective Strategy to Solve Quadratic Equations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02163</md:content-id>
    <md:title>8.5.3: Choosing an Effective Strategy to Solve Quadratic Equations</md:title>
    <md:uuid>880b5a41-241b-47bf-9a3b-637e012d0639</md:uuid>
  </metadata>
  <content>
  <section><title>Activity</title>
<para> Solve each equation. Be prepared to explain or show your reasoning.</para>
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(x^2=121\)</para>
    </problem><solution>
    
    <para>Enter the solution(s) to the equation.</para>
  
  <para>Compare your answer:</para>
    
    <para> \(x=11\) and \(x=-11\)</para>
  
  </solution></exercise>
<!--Interaction End -->

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(x^2−31=5\)</para>
    </problem><solution>
    
    <para>Enter the solution(s) to the equation.</para>
  
  <para>Compare your answer:</para>
    
    <para> \(x=6\) and \(x=-6\)</para>
  
  </solution></exercise>
<!--Interaction End -->

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\((x−4)(x−4)=0\)</para>
    </problem><solution>
    
    <para>Enter the solution(s) to the equation.</para>
  
  <para>Compare your answer:</para>
    
    <para>\(x=4\)</para>
  
  </solution></exercise>
<!--Interaction End -->

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\((x+3)(x−1)=5\)</para>
    </problem><solution>
    
    <para>Enter the solution(s) to the equation.</para>
  
  <para>Compare your answer:</para>
    
    <para> \(x=-4\) and \(x=2\)</para>
  
  </solution></exercise>
<!--Interaction End -->

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\((x+1)^2=-4\)</para>
    </problem><solution>
    
    <para>Enter the solution(s) to the equation.</para>
  
  <para>Compare your answer:</para>
    
    <para>No solution</para>
  
  </solution></exercise>
<!--Interaction End -->

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\((x−4)(x−1)=990\)</para>
    </problem><solution>
    
    <para>Enter the solution(s) to the equation.</para>
  
  <para>Compare your answer:</para>
    
    <para>\(x=34\) and \(x=-29\)</para>
  
  </solution></exercise>
<!--Interaction End -->


