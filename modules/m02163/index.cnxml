  <title>8.5.3: Choosing an Effective Strategy to Solve Quadratic Equations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02163</md:content-id>
    <md:title>8.5.3: Choosing an Effective Strategy to Solve Quadratic Equations</md:title>
    <md:uuid>880b5a41-241b-47bf-9a3b-637e012d0639</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Activity</title>
      <para id="para-00001">Solve each equation. Be prepared to explain or show your reasoning.</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>121</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00001">
          <para id="para-00003">Enter the solution(s) to the equation.</para>
          <para id="para-00004">Compare your answer:</para>
          <para id="para-00005"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>11</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>11</m:mn></m:mrow></m:math></para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00006"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>31</m:mn><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00002">
          <para id="para-00007">Enter the solution(s) to the equation.</para>
          <para id="para-00008">Compare your answer:</para>
          <para id="para-00009"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00003">
          <para id="para-00011">Enter the solution(s) to the equation.</para>
          <para id="para-00012">Compare your answer:</para>
          <para id="para-00013"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00014"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00004">
          <para id="para-00015">Enter the solution(s) to the equation.</para>
          <para id="para-00016">Compare your answer:</para>
          <para id="para-00017"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00005">
        <problem id="prob-00005">
          <para id="para-00018"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00005">
          <para id="para-00019">Enter the solution(s) to the equation.</para>
          <para id="para-00020">Compare your answer:</para>
          <para id="para-00021">No solution</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00006">
        <problem id="prob-00006">
          <para id="para-00022"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>990</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00006">
          <para id="para-00023">Enter the solution(s) to the equation.</para>
          <para id="para-00024">Compare your answer:</para>
          <para id="para-00025"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>34</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>29</m:mn></m:mrow></m:math></para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <section id="sect-00002">
        <title>Video: Choosing an Effective Strategy to Solve Quadratic Equations</title>
        <para id="para-00026">Watch the following video to learn more about choosing an effective strategy to solve quadratic equations.</para>
        <media alt="Placeholder for Alt Text">
          <iframe width="660" height="371.4" src="https://k12.openstax.org/contents/raise/resources/84d199f48e88269b0d50c3dc76afa178bc452da3"/>
        </media>
      </section>
    </section>
    <note class="self-check" id="note-00001"><para id="para-00027">Solve the equation using any method covered in the lesson.</para>
  <para id="para-00028"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>30.25</m:mn></m:mrow></m:math></para></note>
    <section id="sect-00003">
      <title>Additional Resources</title>
      <section id="sect-00004">
        <title>Choosing an Effective Strategy to Solve Quadratic Equations</title>
        <para id="para-00029">You have learned various strategies to solve quadratic equations in different forms. If possible, try to use reasoning before graphing an equation.</para>
        <para id="para-00030">Let's look at some examples.</para>
        <para id="para-00031">
          <emphasis>Using Reasoning and the Square Root Property</emphasis>
       </para>
        <para id="para-00032">Equations such as these can be solved by reasoning and using the <term class="glossary-tooltip" id="term-00001">square root property</term>.</para>
        <para id="para-00033"><emphasis>Example 1</emphasis></para>
        <para id="para-00034"> <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>81</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
        <para id="para-00035"><emphasis>Example 2</emphasis></para>
        <para id="para-00036"> <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>7</m:mn><m:mo>=</m:mo><m:mn>56</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>49</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
        <para id="para-00037"><emphasis>Example 3</emphasis></para>
        <para id="para-00038"> <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
        <para id="para-00039">Each equation above is different in some way, but they all can be solved using the same process.</para>
        <para id="para-00040">
          <emphasis>Using Reasoning and the Zero Product Property</emphasis>
       </para>
        <para id="para-00041">Equations such as these can be solved by reasoning and using the <term class="glossary-tooltip" id="term-00002">zero product property</term>.</para>
        <para id="para-00042"><emphasis>Example 1</emphasis></para>
        <para id="para-00043"> <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
        <para id="para-00044"><emphasis>Example 2</emphasis></para>
        <para id="para-00045"> <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>7</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
        <para id="para-00046">
          <emphasis>Using Graphing to Solve</emphasis>
       </para>
        <para id="para-00047">Some equations might require graphing to be solved. One method is to rearrange the equation such that it is in the form of <emphasis>expression</emphasis> <m:math display="inline"><m:mrow><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math>. Then graph <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> =<emphasis>expression</emphasis>, and find the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts to identify the solutions.</para>
        <para id="para-00048">Given: <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
        <para id="para-00049"><emphasis>Step 1 -</emphasis> Rewrite the equation to set it equal to 0.</para>
        <para id="para-00050"><m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mi>−</m:mi><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para><para id="para-00051"><emphasis>Step 2 -</emphasis> Graph the equation with <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> = the expression that equals zero.</para>
        <para id="para-00052"> Graph <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mi>−</m:mi><m:mn>4</m:mn></m:mrow></m:math>.</para>
        <para id="para-00053">
              <media alt="GRAPH OF A PARABOLA THAT OPENS UP AND PASSES THROUGH THE POINTS (NEGATIVE 3, 0) AND (2, 0).">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_09_07_08_01.jpg"/>
            </media>
          
       </para>
        <para id="para-00054"><emphasis>Step 3 -</emphasis> Identify the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts from the graph.</para>
        <para id="para-00055"> This graph has two <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts at <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        <para id="para-00056">The original equation <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math> has two solutions at <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
        <note class="try" id="note-00002">
          <title>Try It: Choosing an Effective Strategy to Solve Quadratic Equations</title>
      <para id="para-00057">Solve each equation using any method.</para>
      <exercise id="exer-00007">
            <problem id="prob-00007">
              <para id="para-00058"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>22</m:mn></m:mrow></m:math></para><para id="para-00059">Write down your answers, then select the <emphasis>solution</emphasis> button to compare your work.</para>
            </problem>
            <solution id="sol-00007">
              <para id="para-00060">Here is how to choose an effective strategy and use it to solve quadratic equations:</para>
              <para id="para-00061"><m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>22</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>16</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
            </solution>
          </exercise>
      <exercise id="exer-00008">
            <problem id="prob-00008">
              <para id="para-00062"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para><para id="para-00063">Write down your answers, then select the <emphasis>solution</emphasis> button to compare your work.</para>
            </problem>
            <solution id="sol-00008">
              <para id="para-00064">Here is how to choose an effective strategy and use it to solve quadratic equations:</para>
              <para id="para-00065"><m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
            </solution>
          </exercise>
        </note>
      </section>
    </section>
  </content>
