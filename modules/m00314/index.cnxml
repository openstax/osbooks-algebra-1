<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.14.4: Additional Resources</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00314</md:content-id>
    <md:title>1.14.4: Additional Resources</md:title>
    <md:uuid>0a25cec4-a411-4f93-b878-8ec3ffc49e36</md:uuid>
