<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.10.3: Explore Average Rates of Change in an Exponential Decay Context</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01427</md:content-id>
    <md:title>5.10.3: Explore Average Rates of Change in an Exponential Decay Context</md:title>
    <md:uuid>d3be6b21-1575-4b05-8609-25e359dbe07c</md:uuid>
