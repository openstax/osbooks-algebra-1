<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.8.5: Interpreting Average Rates of Change with Real-World Examples</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00991</md:content-id>
    <md:title>4.8.5: Interpreting Average Rates of Change with Real-World Examples</md:title>
    <md:uuid>ce2f19f7-2809-4d9e-9bc1-c8d7261c0d58</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001"><title>Cool Down Activity</title>
      <para id="para-00001">
        
          <media alt="A graph. ">
            <image mime-type="image/svg+xml" src="../../media/Algebra-1_04_11_12_01.svg"/>
          </media>
        
    </para>
      <para id="para-00002"> The graph above shows the population of a city from 1900 to 2000. Use the graph to answer questions 1 - 5.</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00003">What is the average rate of change of the population between 1930 and 1950? Be prepared to show your reasoning.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00005">Compare your answers:</para>
          <para id="para-00006">About 250 people per year. The population was 40,000 in 1930 and about 45,000 in 1950, an increase of 5,000 people over 20 years, which equals 250 people per year.</para>
        </solution>
      </exercise>
      <!--Interaction End -->

        <exercise id="a1675ebf-57d7-458b-b883-2c2253f7debe" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00007">Decide if the average rate of change is positive or negative for the time period from 1930 to 1940.</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00008">Correct! The correct answer is: positive.</para>
            <para id="para-00009">Try again. Work smarter, not harder! Take a moment to think about what you learned in the activity.</para>
          </solution>
        </exercise>
        <exercise id="_86593013-6bb2-4b6c-b285-5c2d26f37ba4" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00010">Decide if the average rate of change is positive or negative for the time period from 1950 to 1970.</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00011">Correct! The correct answer is: negative.</para>
            <para id="para-00012">Try again. Work smarter, not harder! Take a moment to think about what you learned in the activity.</para>
          </solution>
        </exercise>
        <exercise id="f5929df6-160f-4721-a943-5da6064a7541" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00013">Decide if the average rate of change is positive or negative for the time period from 1930 to 1970.</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00014">Correct! The correct answer is: negative.</para>
            <para id="para-00015">Try again. Work smarter, not harder! Take a moment to think about what you learned in the activity.</para>
          </solution>
        </exercise>

      <exercise id="exer-00002">
        <problem id="prob-00005">
          <para id="para-00016">In which decade (10-year interval) did the population grow the fastest? Explain how you know.</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00018">Compare your answers:</para>
          <para id="para-00019">From 1910 to 1920. For example: The graph has the steepest slope between the two points on the graph <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1910</m:mn><m:mo>,</m:mo><m:mn>22</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1920</m:mn><m:mo>,</m:mo><m:mn>32</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
    </section>
