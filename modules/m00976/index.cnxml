  <title>4.8.4: Rate of Change of Linear Functions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00976</md:content-id>
    <md:title>4.8.4: Rate of Change of Linear Functions</md:title>
    <md:uuid>3f8d8a04-6cf9-4fc3-a280-cd12723f41b8</md:uuid>
