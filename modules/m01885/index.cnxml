<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>7.9.1: Solving Equations Using Opposite Operations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01885</md:content-id>
    <md:title>7.9.1: Solving Equations Using Opposite Operations</md:title>
    <md:uuid>cf6c3b33-879a-4452-9681-c89114594036</md:uuid>
  </metadata>
  <content>
  <section><title>Warm Up Activity</title>
<para>Solve each equation mentally. Then, enter your answer to check it.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="f87dde67-3b5b-4099-87a0-e076de69efe1" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1a-->
  <exercise data-content-id="859dc981-9328-4243-9d12-9fe5fdf40386" data-problem-comparator="integer" data-problem-type="input" data-solution="-8">
    <problem>
      <para>\(40-8=40+n\)</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(– 8\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1b-->
  <exercise data-content-id="ebd32831-f7ba-4c60-b2a7-d3e10b068b33" data-problem-comparator="integer" data-problem-type="input" data-solution="100">
    <problem>
      <para>\(25+-100=25-n\)</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(100\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1c-->
  <exercise data-content-id="b0f099ec-cdea-44ac-a2da-68bb983f3215" data-problem-comparator="integer" data-problem-type="input" data-solution="-13">
    <problem>
      <para>\(-3- \frac {1}{2}=3+ \frac {1}{2}n\)</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(– 13\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1d-->
  <exercise data-content-id="ef778c92-62b0-4cae-9b82-28fc485f40db" data-problem-comparator="integer" data-problem-type="input" data-solution="-6">
    <problem>
      <para>\(72-n=72+6\)</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(– 6\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
