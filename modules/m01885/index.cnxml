<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>7.9.1: Solving Equations Using Opposite Operations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01885</md:content-id>
    <md:title>7.9.1: Solving Equations Using Opposite Operations</md:title>
    <md:uuid>97168160-51ba-4208-96bf-6134c1a490ef</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Warm Up Activity</title>
      <para id="para-00001">Solve each equation mentally. Then, enter your answer to check it.</para>

        <exercise id="_859dc981-9328-4243-9d12-9fe5fdf40386" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00002"><m:math>
                <m:mrow>
                  <m:mn>40</m:mn>
                  <m:mo>−</m:mo>
                  <m:mn>8</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>40</m:mn>
                  <m:mo>+</m:mo>
                  <m:mi>n</m:mi>
                </m:mrow>
              </m:math></para></problem>
          <solution id="sol-00001">
            <para id="para-00003">Correct! <m:math display="inline">
                <m:mrow>
                  <m:mi>–</m:mi>
                  <m:mn>8</m:mn>
                </m:mrow>
              </m:math></para>
            <para id="para-00004">The correct answer is <m:math display="inline">
                <m:mrow>
                  <m:mi>–</m:mi>
                  <m:mn>8</m:mn>
                </m:mrow>
              </m:math>.</para>
          </solution>
        </exercise>

        <exercise id="ebd32831-f7ba-4c60-b2a7-d3e10b068b33" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00005"><m:math>
                <m:mrow>
                  <m:mn>25</m:mn>
                  <m:mo>+</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>100</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>25</m:mn>
                  <m:mo>−</m:mo>
                  <m:mi>n</m:mi>
                </m:mrow>
              </m:math></para></problem>
          <solution id="sol-00002">
            <para id="para-00006">Correct! <m:math display="inline">
                <m:mrow>
                  <m:mn>100</m:mn>
                </m:mrow>
              </m:math></para>
            <para id="para-00007">The correct answer is <m:math display="inline">
                <m:mrow>
                  <m:mn>100</m:mn>
                </m:mrow>
              </m:math>.</para>
          </solution>
        </exercise>

        <exercise id="b0f099ec-cdea-44ac-a2da-68bb983f3215" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00008"><m:math>
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo>−</m:mo>
                  <m:mfrac>
                    <m:mrow>
                      <m:mn>1</m:mn>
                    </m:mrow>
                    <m:mrow>
                      <m:mn>2</m:mn>
                    </m:mrow>
                  </m:mfrac>
                  <m:mo>=</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo>+</m:mo>
                  <m:mfrac>
                    <m:mrow>
                      <m:mn>1</m:mn>
                    </m:mrow>
                    <m:mrow>
                      <m:mn>2</m:mn>
                    </m:mrow>
                  </m:mfrac>
                  <m:mi>n</m:mi>
                </m:mrow>
              </m:math></para></problem>
          <solution id="sol-00003">
            <para id="para-00009">Correct! <m:math display="inline">
                <m:mrow>
                  <m:mi>–</m:mi>
                  <m:mn>13</m:mn>
                </m:mrow>
              </m:math></para>
            <para id="para-00010">The correct answer is <m:math display="inline">
                <m:mrow>
                  <m:mi>–</m:mi>
                  <m:mn>13</m:mn>
                </m:mrow>
              </m:math>.</para>
          </solution>
        </exercise>

        <exercise id="ef778c92-62b0-4cae-9b82-28fc485f40db" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00011"><m:math>
                <m:mrow>
                  <m:mn>72</m:mn>
                  <m:mo>−</m:mo>
                  <m:mi>n</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>72</m:mn>
                  <m:mo>+</m:mo>
                  <m:mn>6</m:mn>
                </m:mrow>
              </m:math></para></problem>
          <solution id="sol-00004">
            <para id="para-00012">Correct! <m:math display="inline">
                <m:mrow>
                  <m:mi>–</m:mi>
                  <m:mn>6</m:mn>
                </m:mrow>
              </m:math></para>
            <para id="para-00013">The correct answer is <m:math display="inline">
                <m:mrow>
                  <m:mi>–</m:mi>
                  <m:mn>6</m:mn>
                </m:mrow>
              </m:math>.</para>
          </solution>
        </exercise>

    </section>
  </content>
</document>