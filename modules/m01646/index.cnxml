<exercise>
  <problem>
    <para>\(cd + 6c + 4d + 24\)</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\((d + 6)(c + 4)\)</para>
  </solution></exercise>
