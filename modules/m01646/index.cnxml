<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.4.5: Can You Factor the Polynomial?</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01646</md:content-id>
    <md:title>6.4.5: Can You Factor the Polynomial?</md:title>
