  <section><title>Cool Down Activity</title>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="bd84e02d-7bb8-4212-9665-e6da0282305d" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q#-->
  <exercise data-content-id="650e2f67-e71c-4963-8f3e-5322c96c2458" data-problem-type="multiplechoice" data-solution="\(12x^3y − 7g^8h^3 + 11s^2\)" data-solution-options="[&quot;\\(10q^2 + 14q + 20\\)&quot;, &quot;\\(12x^3 − 2x\\)&quot;, &quot;\\(12x^3y − 7g^8h^3 + 11s^2\\)&quot;, &quot;\\(-2x-4\\)&quot;]">
    <problem>
      <para>1. Which of these polynomials has a greatest common factor of 1?</para>
    </problem>
    <solution>
      <para>Correct! \(12x^3y − 7g^8h^3 + 11s^2\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
