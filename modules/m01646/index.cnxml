<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.4.5: Can You Factor the Polynomial?</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01646</md:content-id>
    <md:title>6.4.5: Can You Factor the Polynomial?</md:title>
    <md:uuid>eeb97e66-1b8c-42a2-985f-49a95aa66006</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Cool Down Activity</title><exercise id="_650e2f67-e71c-4963-8f3e-5322c96c2458" class="multiple-choice"><problem id="prob-00001"><para id="para-00001">1. Which of these polynomials has a greatest common factor of 1?</para><para id="para-00002">Multiple Choice:</para><para id="para-00003"><m:math><m:mrow><m:mn>10</m:mn><m:msup><m:mi>q</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>14</m:mn><m:mi>q</m:mi><m:mo>+</m:mo><m:mn>20</m:mn></m:mrow></m:math></para><para id="para-00004"><m:math><m:mrow><m:mn>12</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mi>−</m:mi><m:mn>2</m:mn><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00005"><m:math><m:mrow><m:mn>12</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>7</m:mn><m:msup><m:mi>g</m:mi><m:mn>8</m:mn></m:msup><m:msup><m:mi>h</m:mi><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:mn>11</m:mn><m:msup><m:mi>s</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00006"><m:math><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para></problem><solution id="sol-00001"><para id="para-00007">Correct! <m:math display="inline"><m:mrow><m:mn>12</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>7</m:mn><m:msup><m:mi>g</m:mi><m:mn>8</m:mn></m:msup><m:msup><m:mi>h</m:mi><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:mn>11</m:mn><m:msup><m:mi>s</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00008">Try again. Check to see if <m:math display="inline"><m:mrow><m:mn>2</m:mn></m:mrow></m:math> is a factor in each term in the expression.</para></solution></exercise><para id="para-00009">Determine if the expression can be factored by grouping. If it can, factor the expression. If not, answer “prime.”</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00002">
    <para id="para-00010"><m:math><m:mrow><m:mi>c</m:mi><m:mi>d</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>d</m:mi><m:mo>+</m:mo><m:mn>24</m:mn></m:mrow></m:math></para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00011">Compare your answer:</para>
    
    <para id="para-00012"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>d</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00003">
    <para id="para-00013"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>w</m:mi><m:mi>−</m:mi><m:mn>3</m:mn></m:mrow></m:math></para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00014">Compare your answer:</para>
    
    <para id="para-00015">prime</para>
  
  </solution></exercise>
<!--Interaction End --></section>
</content>
