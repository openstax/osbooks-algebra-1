<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.8.3: Factoring Quadratic Equations without a Linear Term</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02217</md:content-id>
    <md:title>8.8.3: Factoring Quadratic Equations without a Linear Term</md:title>
    <md:uuid>51b0259e-b9d6-4c99-91b1-0185916145b5</md:uuid>
  </metadata>
