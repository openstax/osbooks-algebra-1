<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>3.3.1: Subtracting an Estimated Value from an Actual Value</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00734</md:content-id>
    <md:title>3.3.1: Subtracting an Estimated Value from an Actual Value</md:title>
    <md:uuid>3f37ad75-5fa2-495d-90d8-072b14e20c9f</md:uuid>
  </metadata>
  <content>
  <section><title>Warm Up Activity</title>
<!--Text Entry Interaction Start -->
<para>Use the following information to answer 1 - 4</para>
<blockquote>
  <para>Mentally calculate how close the estimate is to the actual value using the difference: </para>
  <para><emphasis>actual value − estimated value.</emphasis></para>
</blockquote>
<exercise>
  <problem>
    <para>Actual value: 24.8 grams. Estimated value: 19.6 grams</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>5.2 grams</para>
    
  </solution></exercise>
<!--Interaction End -->

<exercise>
  <problem>
    <para>Actual value: $112.11. Estimated value: $109.30</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>$2.81</para>
    
  </solution></exercise>
<!--Interaction End -->

<exercise>
  <problem>
    <para>Actual value: 41.5 centimeters. Estimated value: 45.90 centimeters</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(-4.4\) centimeters</para>
    
  </solution></exercise>
<!--Interaction End -->

<exercise>
  <problem>
    <para>Actual value: \(-1.34\) degrees Celsius. Estimated value: \(-2.45\) degrees Celsius</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>1.11 degrees Celsius</para>
    
  </solution></exercise>
<!--Interaction End -->
</section>
</content>
</document>
