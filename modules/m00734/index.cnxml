<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>3.3.1: Subtracting an Estimated Value from an Actual Value</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00734</md:content-id>
    <md:title>3.3.1: Subtracting an Estimated Value from an Actual Value</md:title>
    <md:uuid>83a08c14-c80a-4170-a626-3c237f921629</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>
      <!--Text
      Entry Interaction Start -->
      <para id="para-00001">Use the following information to answer 1 - 4</para>
      <quote id="quote-00001">Mentally calculate how close the estimate is to the actual value using the
        difference: </quote>
        <quote id="quote-00002"><emphasis>actual value − estimated value.</emphasis></quote>
      
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00003">Actual value: 24.8 grams. Estimated value: 19.6 grams</para>
        </problem>
        <solution id="sol-00001">


          <para id="para-00004">Compare your answer: </para>

          <para id="para-00005">5.2 grams</para>


        </solution>
      </exercise>
      <!--Interaction
      End -->

      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00006">Actual value: $112.11. Estimated value: $109.30</para>
        </problem>
        <solution id="sol-00002">


          <para id="para-00007">Compare your answer: </para>

          <para id="para-00008">$2.81</para>


        </solution>
      </exercise>
      <!--Interaction
      End -->

      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00009">Actual value: 41.5 centimeters. Estimated value: 45.90 centimeters</para>
        </problem>
        <solution id="sol-00003">


          <para id="para-00010">Compare your answer: </para>

          <para id="para-00011"><m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>4.4</m:mn></m:mrow></m:math> centimeters</para>


        </solution>
      </exercise>
      <!--Interaction
      End -->

      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00012">Actual value: <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>1.34</m:mn></m:mrow></m:math> degrees Celsius. Estimated value: <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>2.45</m:mn></m:mrow></m:math> degrees Celsius</para>
        </problem>
        <solution id="sol-00004">


          <para id="para-00013">Compare your answer: </para>

          <para id="para-00014">1.11 degrees Celsius</para>


        </solution>
      </exercise>
      <!--Interaction
      End -->
    </section>
  </content>
