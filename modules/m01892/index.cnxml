<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>7.9.4: Expressions in Standard Form</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01892</md:content-id>
    <md:title>7.9.4: Expressions in Standard Form</md:title>
    <md:uuid>21760d1c-1f08-4076-9fa2-c2d0d3e196c1</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Cool Down Activity</title>
<para id="para-00001">For each expression, write an equivalent expression in <term class="glossary-tooltip" id="term-00001">standard form</term>. Show your reasoning.</para>
<example id="exam-00001"><exercise>
  <problem id="prob-00001">
    
    <para id="para-00002">\((2x+5)(x+1)\)</para>
    <para id="para-00003">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00001">
  <para id="para-00004">Compare your answer:</para>
  
  <para id="para-00005"> \(2x^2+7x+5\). The diagram shows that\((2x+5)(x+1)=2x \cdot x+2x \cdot 1+5 \cdot x+5 \cdot 1\). Adding this
    together gives \(2x^2+7x+5\) in standard form.</para>
  
  
  
  <table class="os-raise-doubleheadertable" id="table-00001">
    <tgroup cols="3"><tbody><row>
        <entry><emphasis/></entry><entry><emphasis>\(2x\)</emphasis></entry><entry><emphasis>\(5\)</emphasis></entry></row>
    <row>
        <entry><emphasis>\(x\)</emphasis></entry><entry>\(2x^2\)</entry>
        <entry>\(5x\)</entry>
      </row>
      <row>
        <entry><emphasis>\(1\)</emphasis></entry><entry>\(2x\)</entry>
        <entry>\(5\)</entry>
      </row>
    </tbody></tgroup></table>
  
  
  
  </solution></exercise>
</example><example id="exam-00002"><exercise>
    <problem id="prob-00002">
      
      <para id="para-00006">\((x-2)(x+2)\)</para>
      <para id="para-00007">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
    
    </problem><solution id="sol-00002">
    <para id="para-00008">Compare your answer:</para>
    
    <para id="para-00009">\(x^2-4\). \((x+2)(x-2)=x^2+(-2x)+2x+(-4)=x^2-4\).The diagram also shows that \((x+2)(x-2)=x^2-4\).</para>
    
    
    
    <table class="os-raise-doubleheadertable" id="table-00002">
      <tgroup cols="3"><tbody><row>
          <entry><emphasis/></entry><entry><emphasis>\(x\)</emphasis></entry><entry><emphasis>\(2\)</emphasis></entry></row>
      <row>
          <entry><emphasis>\(x\)</emphasis></entry><entry>\(x^2\)</entry>
          <entry>\(2x\)</entry>
        </row>
        <row>
          <entry><emphasis>\(-2\)</emphasis></entry><entry>\(-2x\)</entry>
          <entry>\(-4\)</entry>
        </row>
      </tbody></tgroup></table></solution></exercise>
  </example></section>
</content>
</document>