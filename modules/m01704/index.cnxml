<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.7.4: Is the Polynomial Completely Factored?</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01704</md:content-id>
    <md:title>6.7.4: Is the Polynomial Completely Factored?</md:title>
    <md:uuid>684f9c99-c57a-463c-95e6-e2790fc728c2</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Cool Down Activity</title>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00001">Explain what it means to factor a polynomial completely.</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00002">Compare your answer:</para>
    
    <para id="para-00003">To factor a polynomial completely means that every factor you have found, or the polynomial itself, is prime.</para>
  
  </solution></exercise>
<!--Interaction End -->

<para id="para-00004">For questions 2 - 7, determine if each polynomial is completely factored. If the answer is no, write the completely factored form.</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00005">\(3x(8x^2 − 9x − 3)\)</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00006">Compare your answer:</para>
    
    <para id="para-00007">yes</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00008">\(60x^2y − 75xy + 30y\)</para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00009">Compare your answer:</para>
    
    <para id="para-00010">no;
      \(15y(4x^2 − 5x + 2)\)</para>
  
  </solution></exercise>
<!--Interaction End -->

<!--Text Entry Interaction Start -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00011">\(2c(4c^2 + 20cd + 81d^2)\)</para>
    </problem><solution id="sol-00004">
    
    
  
  <para id="para-00012">Compare your answer:</para>
    
    <para id="para-00013">yes</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00005">
  <problem id="prob-00005">
    <para id="para-00014">\(5n^2 + 5n + 12\)</para>
    </problem><solution id="sol-00005">
    
    
  
  <para id="para-00015">Compare your answer:</para>
    
    <para id="para-00016">yes</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00006">
  <problem id="prob-00006">
    <para id="para-00017">\(5q^2 − 15q − 90\)</para>
    </problem><solution id="sol-00006">
    
    
  
  <para id="para-00018">Compare your answer:</para>
    
    <para id="para-00019">no;
      \(5(q + 3)(q − 6)\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00007">
  <problem id="prob-00007">
    <para id="para-00020">\(64x^2 + 16xy + y^2\)</para>
    </problem><solution id="sol-00007">
    
    
  
  <para id="para-00021">Compare your answer:</para>
    
    <para id="para-00022">no;
      \((8x + y)^2\)</para>
  
  </solution></exercise>
<!--Interaction End --></section>
