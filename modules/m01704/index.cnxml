<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Is the Polynomial Completely Factored?</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01704</md:content-id>
    <md:title>Is the Polynomial Completely Factored?</md:title>
    <md:uuid>684f9c99-c57a-463c-95e6-e2790fc728c2</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00001">Explain what it means to factor a polynomial completely.</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00002">Compare your answer: </para>
    
    <para id="para-00003">To factor a polynomial completely means that every factor you have found, or the polynomial itself, is prime.</para>
  
  </solution></exercise>
<!--Interaction End -->

<para id="para-00004">For questions 2 - 7, determine if each polynomial is completely factored. If no, write the completely factored form.</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00005"><m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>9</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00002">
    
    
  
  <para id="para-00006">Compare your answer: </para>
    
    <para id="para-00007">yes</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00008"><m:math><m:mrow><m:mn>60</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>75</m:mn><m:mi>x</m:mi><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>30</m:mn><m:mi>y</m:mi></m:mrow></m:math></para></problem><solution id="sol-00003">
    
    
  
  <para id="para-00009">Compare your answer: </para>
    
    <para id="para-00010">no;
      <m:math display="inline"><m:mrow><m:mn>15</m:mn><m:mi>y</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
  
  </solution></exercise>
<!--Interaction End -->

<!--Text Entry Interaction Start -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00011"><m:math><m:mrow><m:mn>2</m:mn><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:msup><m:mi>c</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>20</m:mn><m:mi>c</m:mi><m:mi>d</m:mi><m:mo>+</m:mo><m:mn>81</m:mn><m:msup><m:mi>d</m:mi><m:mn>2</m:mn></m:msup><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00004">
    
    
  
  <para id="para-00012">Compare your answer: </para>
    
    <para id="para-00013">yes</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00005">
  <problem id="prob-00005">
    <para id="para-00014"><m:math><m:mrow><m:mn>5</m:mn><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>12</m:mn></m:mrow></m:math></para></problem><solution id="sol-00005">
    
    
  
  <para id="para-00015">Compare your answer: </para>
    
    <para id="para-00016">yes</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00006">
  <problem id="prob-00006">
    <para id="para-00017"><m:math><m:mrow><m:mn>5</m:mn><m:msup><m:mi>q</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>15</m:mn><m:mi>q</m:mi><m:mi>−</m:mi><m:mn>90</m:mn></m:mrow></m:math></para></problem><solution id="sol-00006">
    
    
  
  <para id="para-00018">Compare your answer: </para>
    
    <para id="para-00019">no;
      <m:math display="inline"><m:mrow><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mi>q</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>q</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00007">
  <problem id="prob-00007">
    <para id="para-00020"><m:math><m:mrow><m:mn>64</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>16</m:mn><m:mi>x</m:mi><m:mi>y</m:mi><m:mo>+</m:mo><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para></problem><solution id="sol-00007">
    
    
  
  <para id="para-00021">Compare your answer: </para>
    
    <para id="para-00022">no;
      <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
  
  </solution></exercise>
<!--Interaction End --></section>
</content>
