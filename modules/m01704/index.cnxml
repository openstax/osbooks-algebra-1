  <content>
  <section><title>Cool Down Activity</title>
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Explain what it means to factor a polynomial completely. </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>To factor a polynomial completely means that every factor you have found, or the polynomial itself, is prime.</para>
  </solution></exercise>
<!--Interaction End -->
<para>For questions 2 - 7, determine if each polynomial is completely factored. If the answer is no, write the completely factored form.</para>
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(3x(8x^2 − 9x − 3)\)</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>yes</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(60x^2y − 75xy + 30y\)</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>no;</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(2c(4c^2 + 20cd + 81d^2)\)</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>yes</para>
  </solution></exercise>
<!--Interaction End -->
