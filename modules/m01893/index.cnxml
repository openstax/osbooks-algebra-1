<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>7.9.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01893</md:content-id>
    <md:title>7.9.5: Practice</md:title>
    <md:uuid>be9e7279-162a-42be-9cb1-28004955d73e</md:uuid>
  </metadata>
  <content>
  <section class="practice" id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
<section id="sect-00002"><exercise id="_93136e8c-aab9-46b5-809e-92dca8685ecf" class="multiple-choice"><problem id="prob-00001"><para id="para-00002">Choose the standard form of the quadratic expression.</para>
        <para id="para-00003"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00004">Multiple Choice:</para><para id="para-00005"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00006"><m:math><m:mrow><m:mo>−</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00007"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00008"><m:math><m:mrow><m:mo>−</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para></problem><solution id="sol-00001"><para id="para-00009">Correct! <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00010">Try again. Revisit activities 7.9.3 and 7.9.4.</para><para id="para-00011">The correct answer is <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_3dc098a3-f2cf-4a46-99c0-6e4ab2f5b443" class="multiple-choice"><problem id="prob-00002"><para id="para-00012"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
        <para id="para-00013">Multiple Choice:</para><para id="para-00014"><m:math><m:mrow><m:mn>6</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math></para><para id="para-00015"><m:math><m:mrow><m:mn>6</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math></para><para id="para-00016"><m:math><m:mrow><m:mo>−</m:mo><m:mn>6</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math></para><para id="para-00017"><m:math><m:mrow><m:mo>−</m:mo><m:mn>6</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math></para></problem><solution id="sol-00002"><para id="para-00018">Correct! <m:math display="inline"><m:mrow><m:mn>6</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math></para><para id="para-00019">Try again. Revisit activities 7.9.3 and 7.9.4.</para><para id="para-00020">The correct answer is <m:math display="inline"><m:mrow><m:mn>6</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="af11d46b-2aed-4e89-b6cc-5632958fb11a" class="multiple-choice"><problem id="prob-00003"><para id="para-00021">Consider the expression <m:math display="inline"><m:mrow><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para>
      <para id="para-00022">Is the expression in standard form?</para>
        </problem><solution id="sol-00003"><para id="para-00023">Correct! No. Even though it has <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> term, it does not start with the <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> term.</para><para id="para-00024">Try again. Revisit activities 7.9.3 and 7.9.4.</para><para id="para-00025">The correct answer is No. Even though it starts with a number and ends with an <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>, it is not of the form <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>b</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="d5826ad8-8703-41aa-96ee-3c02dd045b4a" class="multiple-choice"><problem id="prob-00004"><para id="para-00026">Is the expression equivalent to <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>?</para>
        </problem><solution id="sol-00004"><para id="para-00027">Correct! Yes. Applying the distributive property gives <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math>, which is equivalent to <m:math display="inline"><m:mrow><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para><para id="para-00028">Try again. Revisit activity 7.9.2.</para><para id="para-00029">The correct answer is Yes. Applying the distributive property gives <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math>, which is equivalent to <m:math display="inline"><m:mrow><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="b4acb530-d810-4f25-95f7-c2739c0fe041" class="multiple-choice"><problem id="prob-00005"><para id="para-00030">Find the standard form of the quadratic expression <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>. Use the standard form to answer questions a, b, and c. </para>
          
          <para id="para-00031">What is the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math> in this expression <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>b</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi></m:mrow></m:math>?</para>
        
      </problem><solution id="sol-00005"><para id="para-00032">Correct! <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>=1</para><para id="para-00033">Try again. Revisit activity 7.9.2.</para><para id="para-00034">The correct answer is <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>=1.</para></solution></exercise>
      
      <exercise id="_6aee0d16-970b-4113-9c10-b99d81df4403" class="multiple-choice"><problem id="prob-00006"><para id="para-00035">What is the value of <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math> in this expression <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>b</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi></m:mrow></m:math>?</para>
        </problem><solution id="sol-00006"><para id="para-00036">Correct! <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>=6</para><para id="para-00037">Try again. Revisit activity 7.9.2.</para><para id="para-00038">The correct answer is <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>=6.</para></solution></exercise>
      
      <exercise id="cabf4259-4429-448e-b6af-9c1bbdb4f4be" class="multiple-choice"><problem id="prob-00007"><para id="para-00039">What is the value of <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math> in this expression <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>b</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi></m:mrow></m:math>?</para>
        </problem><solution id="sol-00007"><para id="para-00040">Correct! <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>16</m:mn></m:mrow></m:math></para><para id="para-00041">Try again. Revisit activity 7.9.2.</para><para id="para-00042">The correct answer is <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>16</m:mn></m:mrow></m:math>.</para></solution></exercise></section></section>
</content>
</document>
