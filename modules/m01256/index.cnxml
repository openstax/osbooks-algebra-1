<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.2.1: Perfect Squares Revisited</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01256</md:content-id>
    <md:title>5.2.1: Perfect Squares Revisited</md:title>
    <md:uuid>a0bc440d-343e-40bd-863a-25de8db32a35</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Warm Up Activity</title>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00001">What is the value of \(4\;\times\;4\)?</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00002">Compare your answer:</para>
    
    <para id="para-00003">16</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00004">What is the value of \(4^2\)?</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00005">Compare your answer:</para>
    
    <para id="para-00006">16</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00007">Using what you know about roots, what is the value of \(\sqrt{16}\)?</para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00008">Compare your answer:</para>
    
    <para id="para-00009">4</para>
  
  </solution></exercise>
<!--Interaction End -->

<exercise id="exer-00004">
  <problem id="prob-00004">
    
    <para id="para-00010">Talk to a partner. How can you prove \(\sqrt[2]{4^2}\;=\;4\)?</para>
    <para id="para-00011">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00004">
  <para id="para-00012">Your answers may vary, but here is an example:</para>
  
  <para id="para-00013">Since \(4^2\;=\;4\;\cdot\;4\;=\;16\) and \(\sqrt{16}\;=4\), \(\sqrt[2]{4^2}\;=\;4\).</para>
  
  <para id="para-00014">Notice that the root and exponents are the same and simplify to leave the integer only.</para>

</solution></exercise>

<exercise id="exer-00005">
  <problem id="prob-00005">
    
    <para id="para-00015">Talk to a partner. What do you think the answer to \(\sqrt[5]{4^5}\) would be?</para>
    <para id="para-00016">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00005">
  <para id="para-00017">Your answers may vary, but here is an example:</para>
  
  <para id="para-00018">\(\sqrt[5]{4^5}\;=\;4\)</para>

</solution></exercise>
</section>
