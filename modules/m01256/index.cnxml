<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Perfect Squares Revisited</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01256</md:content-id>
    <md:title>Perfect Squares Revisited</md:title>
    <md:uuid>a0bc440d-343e-40bd-863a-25de8db32a35</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00001">What is the value of <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mspace width="0.278em"/><m:mi>×</m:mi><m:mspace width="0.278em"/><m:mn>4</m:mn></m:mrow></m:math>?</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00002">Compare your answer: </para>
    
    <para id="para-00003">16</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00004">What is the value of <m:math display="inline"><m:mrow><m:msup><m:mn>4</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math>?</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00005">Compare your answer: </para>
    
    <para id="para-00006">16</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00007">Using what you know about roots, what is the value of <m:math display="inline"><m:mrow><m:msqrt><m:mrow><m:mn>16</m:mn></m:mrow></m:msqrt></m:mrow></m:math>?</para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00008">Compare your answer: </para>
    
    <para id="para-00009">4</para>
  
  </solution></exercise>
<!--Interaction End -->

<exercise id="exer-00004">
  <problem id="prob-00004">
    
    <para id="para-00010">Talk to a partner. How can you prove <m:math display="inline"><m:mrow><m:mroot><m:mrow><m:msup><m:mn>4</m:mn><m:mn>2</m:mn></m:msup></m:mrow><m:mn>2</m:mn></m:mroot><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn></m:mrow></m:math>?</para>
    <para id="para-00011"></para>
  
  </problem><solution id="sol-00004">
  <para id="para-00012">Your answers may vary, but here is an example:</para>
  
  <para id="para-00013">Since <m:math display="inline"><m:mrow><m:msup><m:mn>4</m:mn><m:mn>2</m:mn></m:msup><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mspace width="0.278em"/><m:mi>·</m:mi><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>16</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:msqrt><m:mrow><m:mn>16</m:mn></m:mrow></m:msqrt><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mroot><m:mrow><m:msup><m:mn>4</m:mn><m:mn>2</m:mn></m:msup></m:mrow><m:mn>2</m:mn></m:mroot><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn></m:mrow></m:math>.</para>
  
  <para id="para-00014">Notice that the root and exponents are the same and simplify to leave the integer only.</para>

</solution></exercise>

<exercise id="exer-00005">
  <problem id="prob-00005">
    
    <para id="para-00015">Talk to a partner. What do you think the answer to <m:math display="inline"><m:mrow><m:mroot><m:mrow><m:msup><m:mn>4</m:mn><m:mn>5</m:mn></m:msup></m:mrow><m:mn>5</m:mn></m:mroot></m:mrow></m:math> would be?</para>
    <para id="para-00016"></para>
  
  </problem><solution id="sol-00005">
  <para id="para-00017">Your answers may vary, but here is an example:</para>
  
  <para id="para-00018"><m:math><m:mrow><m:mroot><m:mrow><m:msup><m:mn>4</m:mn><m:mn>5</m:mn></m:msup></m:mrow><m:mn>5</m:mn></m:mroot><m:mspace width="0.278em"/><m:mo>=</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn></m:mrow></m:math></para></solution></exercise>
</section>
</content>
</document>