  <title>5.2.1: Perfect Squares Revisited</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01256</md:content-id>
    <md:title>5.2.1: Perfect Squares Revisited</md:title>
    <md:uuid>a0bc440d-343e-40bd-863a-25de8db32a35</md:uuid>
  </metadata>
  <content>
  <section><title>Warm Up Activity</title>

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> What is the value of \(4\;\times\;4\)?</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>16</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> What is the value of \(4^2\)?</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>16</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> Using what you know about roots, what is the value of \(\sqrt{16}\)?</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>4</para>
  
  </solution></exercise>
<!--Interaction End -->

<example><exercise>
  <problem>
    
    <para> Talk to a partner. How can you prove \(\sqrt[2]{4^2}\;=\;4\)?</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution>
  <para>Your answers may vary, but here is an example:</para>
  
  <para>Since \(4^2\;=\;4\;\cdot\;4\;=\;16\) and \(\sqrt{16}\;=4\), \(\sqrt[2]{4^2}\;=\;4\).</para>
  
  <para>Notice that the root and exponents are the same and simplify to leave the integer only.</para>

</solution></exercise>
</example>
<example><exercise>
  <problem>
    
    <para> Talk to a partner. What do you think the answer to \(\sqrt[5]{4^5}\) would be?</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution>
  <para>Your answers may vary, but here is an example:</para>
  
  <para>\(\sqrt[5]{4^5}\;=\;4\)</para>

</solution></exercise>
</example></section>
</content>
