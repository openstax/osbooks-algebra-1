</div>
<!--END MULTISELECT -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Write an inequality to represent the cost constraint.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer: Your answer may vary, but here is a sample.</para>
    <para>\(9x+13y\leq110\)  </para>
  </solution></exercise>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="842e7e06-224b-475c-8363-682df20d3541" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q#-->
  <exercise data-content-id="30eb6fbd-3d3e-4d80-b648-6d59163b5920" data-problem-type="multiselect" data-solution="[&quot;\\((1,1)\\)&quot;,&quot;\\((4,5)\\)&quot; ,&quot;\\((10,1)\\)&quot;]" data-solution-options="[&quot;\\((4,5)\\)&quot;, &quot;\\((10,1)\\)&quot;, &quot;\\((8,3)\\)&quot;,&quot;\\((1,1)\\)&quot;]">
    <problem>
      <para>Select <emphasis>three</emphasis> the pairs that satisfy the cost constraint.</para>
      </problem>
    <solution>
      <para>Correct! </para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
