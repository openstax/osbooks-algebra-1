<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Undoing FOIL</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01658</md:content-id>
    <md:title>Undoing FOIL</md:title>
    <md:uuid>69700cfc-cf88-43f4-8e91-e0425f39f186</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">
      <title>Warm Up</title>
      <para id="para-00002">We are going to factor the trinomial <m:math display="inline">
          <m:mrow>
            <m:msup>
              <m:mi>q</m:mi>
              <m:mn>2</m:mn>
            </m:msup>
            <m:mo>+</m:mo>
            <m:mn>10</m:mn>
            <m:mi>q</m:mi>
            <m:mo>+</m:mo>
            <m:mn>24</m:mn>
          </m:mrow>
        </m:math> by reversing the process of FOIL.</para>
      <exercise id="exer-00001">
        <problem id="prob-00001">

          <para id="para-00003">Find all the different combinations of factors of <m:math display="inline">
              <m:mrow>
                <m:mn>24</m:mn>
              </m:mrow>
            </m:math>. One example is provided in the table.</para>
          <table class="unnumbered os-raise-midsizetable" id="table-00001">
            <tgroup cols="2">
              <thead><row>
                  <entry><emphasis>Factors of 24</emphasis></entry>
                  <entry><emphasis>Sum of factors</emphasis></entry>
                </row>
                </thead><tbody>
                <row>
                  <entry><para id="para-00004"><m:math>
                        <m:mrow>
                          <m:mn>1</m:mn>
                          <m:mo>,</m:mo>
                          <m:mn>24</m:mn>
                        </m:mrow>
                      </m:math></para></entry>
                  <entry><para id="para-00005"><m:math>
                        <m:mrow>
                          <m:mn>1</m:mn>
                          <m:mo>+</m:mo>
                          <m:mn>24</m:mn>
                          <m:mo>=</m:mo>
                          <m:mn>25</m:mn>
                        </m:mrow>
                      </m:math></para></entry>
                </row>
                <row>
                  <entry> </entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry> </entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry> </entry>
                  <entry> </entry>
                </row>
              </tbody>
            </tgroup>
          </table>


          <para id="para-00006"/>

        </problem>
        <solution id="sol-00001">
          <para id="para-00007">Compare your answers:</para>

          <table class="unnumbered os-raise-midsizetable" id="table-00002">
            <tgroup cols="2">
              <thead><row>
                  <entry><emphasis>Factors of 24</emphasis></entry>
                  <entry><emphasis>Sum of factors</emphasis></entry>
                </row>
                </thead><tbody>
                <row>
                  <entry><para id="para-00008"><m:math display="inline">
                        <m:mrow>
                          <m:mn>1</m:mn>
                        </m:mrow>
                      </m:math>, <m:math display="inline">
                        <m:mrow>
                          <m:mn>24</m:mn>
                        </m:mrow>
                      </m:math></para></entry>
                  <entry><para id="para-00009"><m:math>
                        <m:mrow>
                          <m:mn>1</m:mn>
                          <m:mo>+</m:mo>
                          <m:mn>24</m:mn>
                          <m:mo>=</m:mo>
                          <m:mn>25</m:mn>
                        </m:mrow>
                      </m:math></para></entry>
                </row>
                <row>
                  <entry><para id="para-00010"><m:math display="inline">
                        <m:mrow>
                          <m:mn>2</m:mn>
                        </m:mrow>
                      </m:math>, <m:math display="inline">
                        <m:mrow>
                          <m:mn>12</m:mn>
                        </m:mrow>
                      </m:math></para></entry>
                  <entry><para id="para-00011"><m:math>
                        <m:mrow>
                          <m:mn>2</m:mn>
                          <m:mo>+</m:mo>
                          <m:mn>12</m:mn>
                          <m:mo>=</m:mo>
                          <m:mn>14</m:mn>
                        </m:mrow>
                      </m:math></para></entry>
                </row>
                <row>
                  <entry><para id="para-00012"><m:math display="inline">
                        <m:mrow>
                          <m:mn>3</m:mn>
                        </m:mrow>
                      </m:math>, <m:math display="inline">
                        <m:mrow>
                          <m:mn>8</m:mn>
                        </m:mrow>
                      </m:math></para></entry>
                  <entry><para id="para-00013"><m:math>
                        <m:mrow>
                          <m:mn>3</m:mn>
                          <m:mo>+</m:mo>
                          <m:mn>8</m:mn>
                          <m:mo>=</m:mo>
                          <m:mn>11</m:mn>
                        </m:mrow>
                      </m:math></para></entry>
                </row>
                <row>
                  <entry><para id="para-00014"><m:math display="inline">
                        <m:mrow>
                          <m:mn>4</m:mn>
                        </m:mrow>
                      </m:math>, <m:math display="inline">
                        <m:mrow>
                          <m:mn>6</m:mn>
                        </m:mrow>
                      </m:math></para></entry>
                  <entry><para id="para-00015"><m:math>
                        <m:mrow>
                          <m:mn>4</m:mn>
                          <m:mo>+</m:mo>
                          <m:mn>6</m:mn>
                          <m:mo>=</m:mo>
                          <m:mn>10</m:mn>
                        </m:mrow>
                      </m:math></para></entry>
                </row>
              </tbody>
            </tgroup>
          </table>


        </solution>
      </exercise>

      <para id="para-00016">We’re going to look at these factors to see which of them would fit in the boxes and multiply to make the trinomial <m:math display="inline">
          <m:mrow>
            <m:msup>
              <m:mi>q</m:mi>
              <m:mn>2</m:mn>
            </m:msup>
            <m:mo>+</m:mo>
            <m:mn>10</m:mn>
            <m:mi>q</m:mi>
            <m:mo>+</m:mo>
            <m:mn>24</m:mn>
          </m:mrow>
        </m:math> that we started with in the beginning.</para>
      <para id="para-00017"><m:math>
          <m:mrow>
            <m:mo stretchy="false">(</m:mo>
            <m:mi>q</m:mi>
            <m:mo>+</m:mo>
            <m:mi>◻</m:mi>
            <m:mo stretchy="false">)</m:mo>
            <m:mo stretchy="false">(</m:mo>
            <m:mi>q</m:mi>
            <m:mo>+</m:mo>
            <m:mi>◻</m:mi>
            <m:mo stretchy="false">)</m:mo>
          </m:mrow>
        </m:math></para><!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00018">Which pair of factors fits the situation? What is the factored expression?</para>
        </problem>
        <solution id="sol-00002">


          <para id="para-00019">Compare your answer: </para>

          <para id="para-00020"><m:math display="inline">
              <m:mrow>
                <m:mn>4</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mn>6</m:mn>
              </m:mrow>
            </m:math></para>
          <para id="para-00022"><m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>q</m:mi>
                <m:mo>+</m:mo>
                <m:mn>4</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>q</m:mi>
                <m:mo>+</m:mo>
                <m:mn>6</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
          <para id="para-00021">So, by undoing FOIL, we found that the trinomial <m:math display="inline">
              <m:mrow>
                <m:msup>
                  <m:mi>q</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>10</m:mn>
                <m:mi>q</m:mi>
                <m:mo>+</m:mo>
                <m:mn>24</m:mn>
              </m:mrow>
            </m:math> factors to the expression <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>q</m:mi>
                <m:mo>+</m:mo>
                <m:mn>4</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>q</m:mi>
                <m:mo>+</m:mo>
                <m:mn>6</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>

        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>