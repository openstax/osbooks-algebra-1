  <content>
  <section><title>Activity</title>
<para>Rule G takes a person's name as its input and gives their high school graduation date as the output.</para>
<table class="os-raise-midsizetable">
  <tgroup cols="2"><tbody><row>
      <entry><emphasis>
        Input
     </emphasis> </entry><entry><emphasis>
        Output
     </emphasis> </entry></row>
  <row>
      <entry>
        <para>Taylor Swift</para>
      </entry>
      <entry>
        <para>2008</para>
      </entry>
    </row>
    <row>
      <entry>
        <para>Zendaya</para>
      </entry>
      <entry>2015</entry>
    </row>
    <row>
      <entry>
        <para>Storm Reid</para>
      </entry>
      <entry>2020</entry>
    </row>
    <row>
      <entry>
        <para>Johnny Orlando</para>
      </entry>
      <entry>2021</entry>
    </row>
    <row>
      <entry/>
      <entry/>
    </row>
    <row>
      <entry/>
      <entry/>
    </row>
    <row>
      <entry/>
      <entry/>
    </row>
    <row>
      <entry/>
      <entry/>
    </row>
  </tbody></tgroup></table>

<para>Rule P takes a high school graduation date and gives a person with that graduation date as the output.</para>
<table class="os-raise-midsizetable">
  <tgroup cols="2"><tbody><row>
      <entry><emphasis>
        Input
     </emphasis> </entry><entry><emphasis>
        Output
     </emphasis> </entry></row>
  <row>
      <entry>
        <para>2020</para>
      </entry>
      <entry>
        <para>Lil Tecca</para>
      </entry>
    </row>
    <row>
      <entry>
        <para>2021</para>
      </entry>
      <entry>
        <para>Olivia Rodrigo</para>
      </entry>
    </row>
    <row>
      <entry>
        <para>2022</para>
      </entry>
      <entry>
        <para>Forrest Wheeler</para>
      </entry>
    </row>
    <row>
      <entry>
        <para>2023</para>
      </entry>
      <entry>
        <para>Miles Brown</para>
      </entry>
    </row>
    <row>
