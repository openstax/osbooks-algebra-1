  <content>
    <section class="numbered-exercises" id="sect-00001">      <title>Activity</title>
      <para id="para-00001">Rule G takes a person's name as its input and gives their high school graduation date as the output.</para>
      <table class="unnumbered os-raise-midsizetable" id="table-00001">
        <tgroup cols="2">
          <tbody>
            <row>
              <entry><emphasis> Input </emphasis>
              </entry>
              <entry><emphasis> Output </emphasis>
              </entry>
            </row>
            <row>
              <entry>
                <para id="para-00002">Taylor Swift</para>
              </entry>
              <entry>
                <para id="para-00003">2008</para>
              </entry>
            </row>
            <row>
              <entry>
                <para id="para-00004">Zendaya</para>
              </entry>
              <entry>2015</entry>
            </row>
            <row>
              <entry>
                <para id="para-00005">Storm Reid</para>
              </entry>
              <entry>2020</entry>
            </row>
            <row>
              <entry>
                <para id="para-00006">Johnny Orlando</para>
              </entry>
              <entry>2021</entry>
            </row>
            <row>
              <entry/>
              <entry/>
            </row>
            <row>
              <entry/>
              <entry/>
            </row>
            <row>
              <entry/>
              <entry/>
            </row>
            <row>
              <entry/>
              <entry/>
            </row>
          </tbody>
        </tgroup>
      </table>

      <para id="para-00007">Rule P takes a high school graduation date and gives a person with that graduation date as the output.</para>
      <table class="unnumbered os-raise-midsizetable" id="table-00002">
        <tgroup cols="2">
          <tbody>
            <row>
              <entry><emphasis> Input </emphasis>
              </entry>
              <entry><emphasis> Output </emphasis>
              </entry>
            </row>
            <row>
              <entry>
                <para id="para-00008">2020</para>
              </entry>
              <entry>
                <para id="para-00009">Lil Tecca</para>
              </entry>
            </row>
            <row>
              <entry>
                <para id="para-00010">2021</para>
              </entry>
              <entry>
                <para id="para-00011">Olivia Rodrigo</para>
              </entry>
            </row>
            <row>
              <entry>
                <para id="para-00012">2022</para>
              </entry>
              <entry>
                <para id="para-00013">Forrest Wheeler</para>
              </entry>
            </row>
            <row>
              <entry>
                <para id="para-00014">2023</para>
              </entry>
              <entry>
                <para id="para-00015">Miles Brown</para>
              </entry>
            </row>
            <row>
              <entry/>
              <entry/>
            </row>
            <row>
              <entry/>
              <entry/>
            </row>
            <row>
              <entry/>
              <entry/>
            </row>
          </tbody>
        </tgroup>
      </table>


      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00016">Complete the table for Rule G with three more examples of input-output pairs.</para>
        </problem>
        <solution id="sol-00001">

          <para id="para-00017">Enter your first input-output pair example here:</para>

          <para id="para-00018">Compare your answers:</para>

          <para id="para-00019">Your answer may vary, but here are some samples. Input: Skai Jackson; Output: 2020 Input: Keke Palmer; Output: 2010 </para>

        </solution>
      </exercise>
      <!--Interaction End -->


