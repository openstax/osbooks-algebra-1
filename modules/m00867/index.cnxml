<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.2.3: Finding a Unique Output for Each Input</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00867</md:content-id>
    <md:title>4.2.3: Finding a Unique Output for Each Input</md:title>
    <md:uuid>3a8d4e69-6cf1-4611-809c-6fe09c217928</md:uuid>
  </metadata>
  <content>
  <section><title>Activity</title>
<para>Rule G takes a person's name as its input and gives their high school graduation date as the output.</para>
<table class="os-raise-midsizetable">
  <tgroup cols="2"><tbody><row>
      <entry><emphasis>
        Input
     </emphasis></entry><entry><emphasis>
        Output
     </emphasis></entry></row>
  <row>
      <entry>
        <para>Taylor Swift</para>
      </entry>
      <entry>
        <para>2008</para>
      </entry>
    </row>
    <row>
      <entry>
        <para>Zendaya</para>
      </entry>
      <entry>2015</entry>
    </row>
    <row>
      <entry>
        <para>Storm Reid</para>
      </entry>
      <entry>2020</entry>
    </row>
    <row>
      <entry>
        <para>Johnny Orlando</para>
      </entry>
      <entry>2021</entry>
    </row>
    <row>
      <entry/>
      <entry/>
    </row>
    <row>
      <entry/>
      <entry/>
    </row>
    <row>
      <entry/>
      <entry/>
    </row>
    <row>
      <entry/>
      <entry/>
    </row>
  </tbody></tgroup></table>

<para>Rule P takes a high school graduation date and gives a person with that graduation date as the output.</para>
<table class="os-raise-midsizetable">
  <tgroup cols="2"><tbody><row>
      <entry><emphasis>
        Input
     </emphasis></entry><entry><emphasis>
        Output
     </emphasis></entry></row>
  <row>
      <entry>
        <para>2020</para>
      </entry>
      <entry>
        <para>Lil Tecca</para>
      </entry>
    </row>
    <row>
      <entry>
        <para>2021</para>
      </entry>
      <entry>
        <para>Olivia Rodrigo</para>
      </entry>
    </row>
    <row>
      <entry>
        <para>2022</para>
      </entry>
      <entry>
        <para>Forrest Wheeler</para>
      </entry>
    </row>
    <row>
      <entry>
        <para>2023</para>
      </entry>
      <entry>
        <para>Miles Brown</para>
      </entry>
    </row>
    <row>
      <entry/>
      <entry/>
    </row>
    <row>
      <entry/>
      <entry/>
    </row>
    <row>
      <entry/>
      <entry/>
    </row>
  </tbody></tgroup></table>


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Complete the table for Rule G with three more examples of input-output pairs.</para>
    </problem><solution>
    
    <para>Enter your first input-output pair example here:</para>
  
  <para>Compare your answers:</para>
    
    <para>Your answer may vary, but here are some samples.
      Input: Skai Jackson; Output: 2020
      Input: Keke Palmer; Output: 2010

   </para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Enter your second input-output pair example here:</para>
  
  </problem><solution>
    
    
  
  <para>Compare your answers:</para>
    
    <para>Your answer may vary, but here are some samples.
      Input: Jeremy Pena; Output: 2015
      Input: Mike Trout; 
      Output: 2009
   </para>
  
  </solution></exercise>
<!--Interaction End -->


<exercise>
  <problem>
    <para>Enter your third input-output pair example here:</para>
  
  </problem><solution>
    
    
  
  <para>Compare your answers:</para>
    
    <para>Your answer may vary, but here are some samples.
      Input: Bryce Young; Output: 2020
      Input: Patrick Mahomes; Output: 2014
   </para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Complete the table for Rule P with three more examples of input-output pairs</para>
    </problem><solution>
    
    <para>Enter your first input-output pair example here:</para>
  
  <para>Compare your answer</para>
    
    <para>Your answer may vary, but here are some samples.
      Input: 2012; Output: Ariana Grande
      Input: 2012; 
      Output: Drake
   </para>
  
  </solution></exercise>
<!--Interaction End -->



<exercise>
  <problem>
    <para>Enter your second input-output pair example here:</para>
  
  </problem><solution>
    
    
  
  <para>Compare your answers:</para>
    
    <para>Your answer may vary, but here are some samples.
      Input: 2020; 
      Output: Will Anderson, Jr.
      Input: 2019; Output: Kenyon Green
      Input: 2015; Output: Marisa Viggiano
   </para>
  
  </solution></exercise>
<!--Interaction End -->


<exercise>
  <problem>
    <para>Enter your third input-output pair example here:</para>
  
  </problem><solution>
    
    
  
  <para>Compare your answers:</para>
    
    <para>Your answer may vary, but here are some samples.
      Input: 2018; Output: Naomi Girma
      Input: 2011; Output: Lynn Williams
      Input: 2018; Output: Sophia Smith

   </para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>If you use your own name as the input to G, explain how many outputs are possible and how you know.</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>Your answer may vary, but here is a sample.
      One possible output. I can only graduate from high school once.

   </para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>If you use your graduation date as the input to P, explain how many outputs are possible and how you know.</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>Your answer may vary, but here is a sample.
      Many possible outputs. There are other people who will share the same graduation date as mine - especially my classmates who graduate with me.
   </para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> Only one of these two relationships, G or P, is a function. The other is not a function. Which one is the function?</para>
    </problem><solution>
    
    
  
  <para>Compare your answers:</para>
    
    <para>Rule G is a function and Rule P is not.</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> How do you know the relationship you chose is a function?</para>
    </problem><solution>
    
    
  
  <para>Compare your answers:</para>
    
    <para>Your answer may vary, but here is a sample.
      G only assigns one output to the input value.</para>
  
  </solution></exercise>
<!--Interaction End -->


<list class="os-raise-noindent" type="enumerated">
  <item> For the relationship that is a function, write two input-output pairs from the table using function notation.</item>
</list>
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Enter your first input-output pair example here:</para>
    </problem><solution>
    
    
  
  <para>Compare your answers:</para>
    
    <para>Your answer may vary, but here are some samples.
      \(G(Taylor Swift)\) = 2008
      \(G(Storm Reid)\) = 2020

   </para>
  
  </solution></exercise>
<!--Interaction End -->

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Enter your second input-output pair example here:</para>
    </problem><solution>
    
    
  
