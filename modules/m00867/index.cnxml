      <exercise id="exer-00006">
        <problem id="prob-00006">
          <para id="para-00033">Enter your third input-output pair example here:</para>

        </problem>
        <solution id="sol-00006">


          <para id="para-00034">Compare your answers:</para>

          <para id="para-00035">Your answer may vary, but here are some samples. Input: 2018; Output: Naomi Girma Input: 2011; Output: Lynn Williams Input: 2018; Output: Sophia Smith </para>

        </solution>
