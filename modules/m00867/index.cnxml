      <!--Text Entry Interaction Start -->
      <exercise id="exer-00007">
        <problem id="prob-00007">
          <para id="para-00036">If you use your own name as the input to G, explain how many outputs are possible and how you know.</para>
        </problem>
        <solution id="sol-00007">


          <para id="para-00037">Compare your answer:</para>

          <para id="para-00038">Your answer may vary, but here is a sample. One possible output. I can only graduate from high school once. </para>

        </solution>
      </exercise>
      <!--Interaction End -->


      <!--Text Entry Interaction Start -->
      <exercise id="exer-00008">
        <problem id="prob-00008">
          <para id="para-00039">If you use your graduation date as the input to P, explain how many outputs are possible and how you know.</para>
        </problem>
        <solution id="sol-00008">


          <para id="para-00040">Compare your answer:</para>

          <para id="para-00041">Your answer may vary, but here is a sample. Many possible outputs. There are other people who will share the same graduation date as mine - especially my classmates who graduate with me. </para>

        </solution>
      </exercise>
      <!--Interaction End -->


      <!--Text Entry Interaction Start -->
      <exercise id="exer-00009">
        <problem id="prob-00009">
          <para id="para-00042">Only one of these two relationships, G or P, is a function. The other is not a function. Which one is the function?</para>
        </problem>
        <solution id="sol-00009">


          <para id="para-00043">Compare your answers:</para>

          <para id="para-00044">Rule G is a function and Rule P is not.</para>

        </solution>
      </exercise>
      <!--Interaction End -->


      <!--Text Entry Interaction Start -->
      <exercise id="exer-00010">
        <problem id="prob-00010">
          <para id="para-00045">How do you know the relationship you chose is a function?</para>
        </problem>
        <solution id="sol-00010">


          <para id="para-00046">Compare your answers:</para>

          <para id="para-00047">Your answer may vary, but here is a sample. G only assigns one output to the input value.</para>

        </solution>
      </exercise>
      <!--Interaction End -->


      <list class="os-raise-noindent" list-type="enumerated" id="list-00001">
        <item>For the relationship that is a function, write two input-output pairs from the table using function notation.</item>
      </list>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00011">
        <problem id="prob-00011">
          <para id="para-00048">Enter your first input-output pair example here:</para>
        </problem>
        <solution id="sol-00011">


          <para id="para-00049">Compare your answers:</para>

          <para id="para-00050">Your answer may vary, but here are some samples. <m:math display="inline"><m:mrow><m:mi>G</m:mi><m:mo stretchy="false">(</m:mo><m:mi>T</m:mi><m:mi>a</m:mi><m:mi>y</m:mi><m:mi>l</m:mi><m:mi>o</m:mi><m:mi>r</m:mi><m:mi>S</m:mi><m:mi>w</m:mi><m:mi>i</m:mi><m:mi>f</m:mi><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math> = 2008 <m:math display="inline"><m:mrow><m:mi>G</m:mi><m:mo stretchy="false">(</m:mo><m:mi>S</m:mi><m:mi>t</m:mi><m:mi>o</m:mi><m:mi>r</m:mi><m:mi>m</m:mi><m:mi>R</m:mi><m:mi>e</m:mi><m:mi>i</m:mi><m:mi>d</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math> = 2020 </para>

        </solution>
      </exercise>
      <!--Interaction End -->

      <!--Text Entry Interaction Start -->
      <exercise id="exer-00012">
        <problem id="prob-00012">
          <para id="para-00051">Enter your second input-output pair example here:</para>
        </problem>
        <solution id="sol-00012">


          <para id="para-00052">Compare your answers:</para>

          <para id="para-00053">Your answer may vary, but here are some samples. <m:math display="inline"><m:mrow><m:mi>G</m:mi><m:mo stretchy="false">(</m:mo><m:mi>Z</m:mi><m:mi>e</m:mi><m:mi>n</m:mi><m:mi>d</m:mi><m:mi>a</m:mi><m:mi>y</m:mi><m:mi>a</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math> = 2015 <m:math display="inline"><m:mrow><m:mi>G</m:mi><m:mo stretchy="false">(</m:mo><m:mi>J</m:mi><m:mi>o</m:mi><m:mi>h</m:mi><m:mi>n</m:mi><m:mi>n</m:mi><m:mi>y</m:mi><m:mi>O</m:mi><m:mi>r</m:mi><m:mi>l</m:mi><m:mi>a</m:mi><m:mi>n</m:mi><m:mi>d</m:mi><m:mi>o</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math> = 2021 </para>

        </solution>
      </exercise>
      <!--Interaction End -->


      <section id="sect-00002">
        <title>Are you ready for more?</title>
        <section class="practice" id="sect-00005"><title>Extending Your Thinking</title>

        <exercise class="RFM1" id="exer-00013">
          <problem id="prob-00013">

            <para id="para-00054"> Write a rule that describes these input-output pairs:<m:math display="inline"><m:mrow><m:mi>F</m:mi></m:mrow></m:math>(ONE) <m:math display="inline"><m:mrow><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math><m:math display="inline"><m:mrow><m:mi>F</m:mi></m:mrow></m:math>(TWO) <m:math display="inline"><m:mrow><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math><m:math display="inline"><m:mrow><m:mi>F</m:mi></m:mrow></m:math>(THREE) <m:math display="inline"><m:mrow><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math><m:math display="inline"><m:mrow><m:mi>F</m:mi></m:mrow></m:math>(FOUR) <m:math display="inline"><m:mrow><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math> What rule could define function <m:math display="inline"><m:mrow><m:mi>F</m:mi></m:mrow></m:math>? </para>
          </problem>
          <solution id="sol-00013">


            <para id="para-00055">Compare your answers:</para>

            <para id="para-00056">Function <m:math display="inline"><m:mrow><m:mi>F</m:mi></m:mrow></m:math> takes a word for its input and gives the number of letters in that word for its output.</para>

          </solution>
        </exercise>
        <!--End interaction-->

        <exercise class="RFM1" id="exer-00014">
          <problem id="prob-00014">
            <para id="para-00057"> Here are some input-output pairs with the same inputs but different outputs:<m:math display="inline"><m:mrow><m:mi>v</m:mi></m:mrow></m:math>(ONE) <m:math display="inline"><m:mrow><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>v</m:mi></m:mrow></m:math>(TWO) <m:math display="inline"><m:mrow><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>v</m:mi></m:mrow></m:math>(THREE) <m:math display="inline"><m:mrow><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mi>v</m:mi></m:mrow></m:math>(FOUR) <m:math display="inline"><m:mrow><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math> What rule could define function <m:math display="inline"><m:mrow><m:mi>v</m:mi></m:mrow></m:math>? </para>
          </problem>
          <solution id="sol-00014">


            <para id="para-00058">Compare your answers:</para>

            <para id="para-00059">Function <m:math display="inline"><m:mrow><m:mi>v</m:mi></m:mrow></m:math> takes a word for its input and gives the number of vowels in that word as its output.</para>

          </solution>
        </exercise>
        <!--End interaction-->
      </section>
    </section>
    <note class="self-check" id="note-00001">
  <para id="para-00060">The price for pizzas, in dollars, is a function of the number of pizzas bought, <m:math display="inline"><m:mrow><m:mi>n</m:mi></m:mrow></m:math>. Identify the input, output, and meaning of the statement: <m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mo stretchy="false">(</m:mo><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>55</m:mn></m:mrow></m:math></para></note>
    <section id="sect-00003">
      <title>Additional Resources</title>

      <section id="sect-00004">
        <title>Meanings in Functions </title>
        <para id="para-00061">Review the following examples to help you gain a better understanding of meanings in functions.</para>
        <exercise id="exer-00015">
          <problem id="prob-00015">

            <para id="para-00062"><emphasis>Example 1</emphasis></para>

            <para id="para-00063">The number of cubic yards of dirt, <m:math display="inline"><m:mrow><m:mi>D</m:mi></m:mrow></m:math>, needed to cover a garden with an area of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math> square feet is given by <m:math display="inline"><m:mrow><m:mi>D</m:mi><m:mo>=</m:mo><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>. </para>
            <para id="para-00064">A garden with area 5000 <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> requires 50 <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:msup><m:mi>d</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math> of dirt. Express this information in terms of the function <m:math display="inline"><m:mrow><m:mi>g</m:mi></m:mrow></m:math>.</para>
            <para id="para-00065">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>

          </problem>
          <solution id="sol-00015">
            <para id="para-00066">
              <emphasis>Solution</emphasis> <m:math display="inline"><m:mrow><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mn>5000</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>50</m:mn></m:mrow></m:math> </para>

          </solution>
        </exercise>
        <exercise id="exer-00016">
          <problem id="prob-00016">

            <para id="para-00067">Explain the meaning of the statement <m:math display="inline"><m:mrow><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mn>100</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math>.</para>
            <para id="para-00068">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>

          </problem>
          <solution id="sol-00016">
            <para id="para-00069">
              <emphasis>Solution</emphasis> The number of cubic yards of dirt required for a garden of 100 square feet is 1. </para>

          </solution>
        </exercise>
        <exercise id="exer-00017">
          <problem id="prob-00017">

            <para id="para-00070"><emphasis>Example 2</emphasis></para>

            <para id="para-00071">Let <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math> be the number of ducks in a lake <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> years after 1990. Explain the meaning of each statement:</para>

            <para id="para-00072"><m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>30</m:mn></m:mrow></m:math></para><para id="para-00073">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>

          </problem>
          <solution id="sol-00017">
            <para id="para-00074">
              <emphasis>Solution</emphasis> In 1995 (5 years after 1990), there were 30 ducks in the lake. </para>

          </solution>
        </exercise>
        <exercise id="exer-00018">
          <problem id="prob-00018">

            <para id="para-00075"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>40</m:mn></m:mrow></m:math></para><para id="para-00076">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>

          </problem>
          <solution id="sol-00018">
            <para id="para-00077">
              <emphasis>Solution</emphasis> In 2000 (10 years after 1990), there were 40 ducks in the lake. </para>

          </solution>
        </exercise>
        <note class="try" id="note-00002">
          <title>Try It: Meanings in Functions</title>
    <para id="para-00078">The amount of garbage, <m:math display="inline"><m:mrow><m:mi>G</m:mi></m:mrow></m:math>, produced by a city with population <m:math display="inline"><m:mrow><m:mi>p</m:mi></m:mrow></m:math> is given by <m:math display="inline"><m:mrow><m:mi>G</m:mi><m:mo>=</m:mo><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>p</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>. <m:math display="inline"><m:mrow><m:mi>G</m:mi></m:mrow></m:math> is measured in tons per week, and <m:math display="inline"><m:mrow><m:mi>p</m:mi></m:mrow></m:math> is measured in thousands of people.</para>
    <exercise id="exer-00019">
            <problem id="prob-00019">
              <para id="para-00079">The town of Tola has a population of 40,000 and produces 13 tons of garbage each week. Express this information in terms of the function <m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math>.</para>
              <para id="para-00080">Write down your answer. Then select the <emphasis>solution</emphasis> button to compare your work. </para>
            </problem>
            <solution id="sol-00019">


              <para id="para-00081">Compare your answer:</para>

              <para id="para-00082"><m:math><m:mrow><m:mn>13</m:mn><m:mo>=</m:mo><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>40</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
          </exercise>
    <exercise id="exer-00020">
            <problem id="prob-00020">
              <para id="para-00083">Explain the meaning of the statement <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
              <para id="para-00084">Write down your answer. Then select the <emphasis>solution</emphasis> button to compare your work. </para>
            </problem>
            <solution id="sol-00020">


              <para id="para-00085">Compare your answer:</para>

              <para id="para-00086">Five thousand people will produce 2 tons of garbage each week.</para>

            </solution>
          </exercise></note>
      </section>
    </section>

  
</section></content></document>