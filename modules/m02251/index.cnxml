<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.10.2: Working with Quadratic Factored Form with Leading Coefficient Other Than One</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02251</md:content-id>
    <md:title>8.10.2: Working with Quadratic Factored Form with Leading Coefficient Other Than One</md:title>
    <md:uuid>c6bb8857-f053-431d-ae57-759456f9659a</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">      <title>Activity</title>
      <exercise>
        <problem>
        <para><link class="os-embed" url="#exercise/Alg1_8_10_2_PLA_41"/></para>
        </problem>
        </exercise>
       </section>
      <section id="sect-00002">
        <title>Are you ready for more?</title>
        <section class="practice" id="sect-00005"><title>Extending Your Thinking</title>

          <exercise>
            <problem>
            <para><link class="os-embed" url="#exercise/Alg1_8_10_2_PLA_42"/></para>
