<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.10.5: Analyzing Functions Using Real-World Context</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01033</md:content-id>
    <md:title>4.10.5: Analyzing Functions Using Real-World Context</md:title>
    <md:uuid>90361e3a-fb12-4b4a-968a-8a7cbc371e97</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Cool Down Activity</title>
      <para id="para-00001"><term class="glossary-tooltip" id="term-00001"> Functions</term> \(R\) and \(D\) give the height, in feet, of a toy rocket and a drone, \(t\) seconds after they are released. Here are the graphs of \(R\) (for the rocket) and \(D\) (for the drone).</para>
      <para id="para-00002">
          <media alt="Two functions graphed on a cooridnate plane.">
            <image mime-type="image/svg+xml" src="../../media/Algebra-1_04_13_12_01.svg"/>
          </media>
        
    </para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00003">Which of the inequalities is true: \(R(2)>D(2)\) or \(D(2)> R(2)\)?</para>
          
        </problem>
        <solution id="sol-00001">
          <para id="para-00004">Compare your answer:</para>
          <para id="para-00005">\(R(2)>D(2)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00006">What was the height of the drone when the toy rocket hit the ground?</para>
          
        </problem>
        <solution id="sol-00002">
          <para id="para-00007">Compare your answer:</para>
          <para id="para-00008">20 feet</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00009">For what value of \(t\) is \(R(t)=D(t)\) true?</para>
          
        </problem>
        <solution id="sol-00003">
          <para id="para-00010">Compare your answer:</para>
          <para id="para-00011">About \(t=4.5\).</para>
        </solution>
      </exercise>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00012">What does this tell you about the drone and the toy rocket?</para>
          
        </problem>
        <solution id="sol-00004">
          <para id="para-00013">Compare your answer:</para>
          <para id="para-00014">After 4.5 seconds, the toy rocket and the drone are at the same height.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content></document>