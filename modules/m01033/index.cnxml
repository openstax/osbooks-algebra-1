<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Analyzing Functions Using Real-World Context</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01033</md:content-id>
    <md:title>Analyzing Functions Using Real-World Context</md:title>
    <md:uuid>90361e3a-fb12-4b4a-968a-8a7cbc371e97</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
      <para id="para-00001"><term class="glossary-tooltip" id="term-00001"> Functions</term> <m:math display="inline"><m:mrow><m:mi>R</m:mi></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>D</m:mi></m:mrow></m:math> give the height, in feet, of a toy rocket and a drone, <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> seconds after they are released. Here are the graphs of <m:math display="inline"><m:mrow><m:mi>R</m:mi></m:mrow></m:math> (for the rocket) and <m:math display="inline"><m:mrow><m:mi>D</m:mi></m:mrow></m:math> (for the drone).</para>
      <para id="para-00002">
          <media alt="A graph shows height in feet vs. time in seconds. Two curves, D (a flat-topped shape) and R (a parabola), both rise, but R peaks near 2 seconds and descends, while D stays flat from 2 to 5 seconds, then drops.">
            <image mime-type="image/svg+xml" src="../../media/Algebra-1_04_13_12_01.svg"/>
          </media>
        
    </para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00003">Which of the inequalities is true: <m:math display="inline"><m:mrow><m:mi>R</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>&gt;</m:mo><m:mi>D</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mi>D</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>&gt;</m:mo><m:mi>R</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>?</para>
          
        </problem>
        <solution id="sol-00001">
          <para id="para-00004">Compare your answer: </para>
          <para id="para-00005"><m:math><m:mrow><m:mi>R</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>&gt;</m:mo><m:mi>D</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00006">What was the height of the drone when the toy rocket hit the ground?</para>
          
        </problem>
        <solution id="sol-00002">
          <para id="para-00007">Compare your answer: </para>
          <para id="para-00008">20 feet</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00009">For what value of <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> is <m:math display="inline"><m:mrow><m:mi>R</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>D</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math> true?</para>
          
        </problem>
        <solution id="sol-00003">
          <para id="para-00010">Compare your answer: </para>
          <para id="para-00011">About <m:math display="inline"><m:mrow><m:mi>t</m:mi><m:mo>=</m:mo><m:mn>4.5</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00012">What does this tell you about the drone and the toy rocket?</para>
          
        </problem>
        <solution id="sol-00004">
          <para id="para-00013">Compare your answer: </para>
          <para id="para-00014">After 4.5 seconds, the toy rocket and the drone are at the same height.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content></document>
