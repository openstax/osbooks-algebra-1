<example><exercise>
  <problem>
  
    <para>When you have finished graphing, select the Solution button to compare your work. </para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para><figure><media alt="Discrete function. episode number and audience in millions."><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/b35a10eaec525d4dd236f3bb239c1da58d5a06a7"/></media></figure></para>
</solution></exercise>
</example><!--Interaction End -->

