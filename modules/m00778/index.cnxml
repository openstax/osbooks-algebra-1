      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->
      <!--Q#-->
      <example id="exam-00001">
        <exercise id="exer-00001">
          <problem id="prob-00001">
            <para id="para-00007">What is the correlation coefficient for this data and what does it tell us about the strength and type of relationship represented?</para>
            <para id="para-00008">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00009">Compare your answer: Your answer many vary, but here is a sample.</para>
            <para id="para-00010"> The correlation coefficient is \(r≈0.44\). By the table, this indicates a moderate, positive
    linear relationship between fat content and calories.</para>
          </solution>
        </exercise>
      </example>
      <!--Interaction End -->
