  <title>2.1.1: Understanding Constraints and Values</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00369</md:content-id>
    <md:title>2.1.1: Understanding Constraints and Values</md:title>
