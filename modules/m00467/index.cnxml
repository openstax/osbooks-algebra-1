   <content>
      <section class="practice" id="sect-00001">

         <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
         <para id="para-00002">Solve each system of equations to practice the skills you have learned in this lesson. Enter your answer as “(x,y)” in the space provided. If any coordinate is a non-integer, enter it in decimal format.</para>
         <exercise id="_9bc99444-8aaa-47fe-a206-b69c41414c38" class="multiple-choice">
            <problem id="prob-00001">
               <para id="para-00003">\( \left\{ \begin{array}{c l} –2x + 5y = –42\\ 7x + 2y = 30 \end{array}\right. \)</para>
               <para id="para-00004">Multiple Choice:</para>
               <para id="para-00005">\((0,15)\)</para>
               <para id="para-00006">\((11,−4)\)</para>
               <para id="para-00007">\((1,−8)\)</para>
               <para id="para-00008">\((6,−6)\)</para>
            </problem>
            <solution id="sol-00001">
               <para id="para-00009">Correct! (6,−6)</para>
               <para id="para-00010">Try again. Revisit activity 2.6.2. Revisit</para>
               <para id="para-00011">The correct answer is (6,−6). </para>
               <para id="para-00012">\(- 2( –2x+5y=–42)=4x-10y=84 \) \(5(7x+2y=30)=35x+10y=150\) \(5(7x+2y=30)=35x+10y=150\) </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->
               <para id="para-00013"> \(\begin{array}{r}4x-10y&amp;=&amp;84 \\35x+10y&amp;=&amp;150 \\ \hline 39x&amp;=&amp;234 \\x&amp;=&amp;6 \end{array}\) \(\begin{array}{r}4x-10y&amp;=&amp;84 \\35x+10y&amp;=&amp;150 \\ \hline 39x&amp;=&amp;234 \\x&amp;=&amp;6 \end{array}\) </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->

               <!--BEGIN ALIGN TO EQUALS -->
               <para id="para-00014"> \(\begin{array}{rcl}7x+8y&amp;=&amp;4 \\7(6)+2y&amp;=&amp;30 \\42+2y&amp;=&amp;30 \\2y&amp;=&amp;-12 \\y&amp;=&amp;-6 \\\end{array}\) \(\begin{array}{rcl}7x+8y&amp;=&amp;4 \\7(6)+2y&amp;=&amp;30 \\42+2y&amp;=&amp;30 \\2y&amp;=&amp;-12 \\y&amp;=&amp;-6 \\\end{array}\) </para>
               <!--END ALIGN TO EQUALS -->
               <para id="para-00015">The solution is \((6,-6)\).</para>
            </solution>
         </exercise>
         <exercise id="_2d665fcc-760f-4664-95f6-6652b9a78b16" class="multiple-choice">
            <problem id="prob-00002">
               <para id="para-00016">\( \left\{ \begin{array}{c l} 6x – 5y = –34\\ 2x + 6y = 4 \end{array}\right. \)</para>
               <para id="para-00017">Multiple Choice:</para>
               <para id="para-00018">\((2,0)\)</para>
               <para id="para-00019">\((1,8)\)</para>
               <para id="para-00020">\((−4,2)\)</para>
               <para id="para-00021">\((−9,−4)\)</para>
            </problem>
            <solution id="sol-00002">
               <para id="para-00022">Correct! (−4,2)</para>
               <para id="para-00023">Try again. Revisit activity 2.6.2.</para>
               <para id="para-00024">The correct answer is (−4,2).</para>
               <para id="para-00025">\(- 3( 2x+6y=4)=-6x-18y=-12 \)</para>

               <!--BEGIN ALIGN TO EQUALS WITH LINE-->
               <para id="para-00026"> \(\begin{array}{r}6x–5y&amp;=&amp;34 \\-6x-18y&amp;=&amp;12 \\ \hline -23y&amp;=&amp;-46 \\y&amp;=&amp;2 \end{array}\) \(\begin{array}{r}6x–5y&amp;=&amp;34 \\-6x-18y&amp;=&amp;12 \\ \hline -23y&amp;=&amp;-46 \\y&amp;=&amp;2 \end{array}\) </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->

               <!--BEGIN ALIGN TO EQUALS -->
               <para id="para-00027"> \(\begin{array}{rcl}7x+8y&amp;=&amp;4 \\2x+6(2)&amp;=&amp;4 \\2x+12&amp;=&amp;4 \\2x&amp;=&amp;-8 \\x&amp;=&amp;-4 \\\end{array}\) \(\begin{array}{rcl}7x+8y&amp;=&amp;4 \\2x+6(2)&amp;=&amp;4 \\2x+12&amp;=&amp;4 \\2x&amp;=&amp;-8 \\x&amp;=&amp;-4 \\\end{array}\) </para>
               <!--END ALIGN TO EQUALS -->
               <para id="para-00028">The solution is \((-4,2)\).</para>

               <para id="para-00029">The solution is \((-4,2)\).</para>
            </solution>
         </exercise>

         <exercise id="_34358845-9f4c-49dd-9744-40f69306892c" class="multiple-choice">
            <problem id="prob-00003">
               <para id="para-00030">\( \left\{ \begin{array}{c l} 5x – y = –2.6\\ −4x − 6y = 1.4 \end{array}\right. \)</para>
               <para id="para-00031">Multiple Choice:</para>
               <para id="para-00032">\((7,–4.9)\)</para>
               <para id="para-00033">\((0.5,0.1)\)</para>
               <para id="para-00034">\((−3,−12)\)</para>
               <para id="para-00035">\((−0.5,0.1)\)</para>
            </problem>
            <solution id="sol-00003">
               <para id="para-00036">Correct! (−0.5,0.1)</para>
               <para id="para-00037">Try again. Revisit activity 2.6.2. Revisit</para>
               <para id="para-00038">The correct answer is (−0.5,0.1).</para>
               <para id="para-00039">\(- 6( 5x–y=–2.6)=-30x+6y=15.6 \)</para>

               <!--BEGIN ALIGN TO EQUALS WITH LINE-->
               <para id="para-00040"> \(\begin{array}{r}-30x+6y&amp;=&amp;15.6 \\−4x−6y&amp;=&amp;1.4 \\ \hline -34x&amp;=&amp;17 \\x&amp;=&amp;-0.5 \end{array}\) \(\begin{array}{r}-30x+6y&amp;=&amp;15.6 \\−4x−6y&amp;=&amp;1.4 \\ \hline -34x&amp;=&amp;17 \\x&amp;=&amp;-0.5 \end{array}\) </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->

               <!--BEGIN ALIGN TO EQUALS -->
               <para id="para-00041"> \(\begin{array}{rcl}−4(-0.5)−6y&amp;=&amp;1.4 \\2-6y&amp;=&amp;1.4 \\-6y&amp;=&amp;-0.6 \\y&amp;=&amp;0.1 \\\end{array}\) \(\begin{array}{rcl}−4(-0.5)−6y&amp;=&amp;1.4 \\2-6y&amp;=&amp;1.4 \\-6y&amp;=&amp;-0.6 \\y&amp;=&amp;0.1 \\\end{array}\) </para>
               <!--END ALIGN TO EQUALS -->
               <para id="para-00042">The solution is \((-0.5,0.1)\).</para>

               <para id="para-00043">The solution is \((-0.5,0.1)\).</para>
            </solution>
         </exercise>
         <exercise id="d5da2e2a-5854-4af4-9134-d43fb40d9570" class="multiple-choice">
            <problem id="prob-00004">
               <para id="para-00044">\( \left\{ \begin{array}{c l} 7x – 2y = 3\\ 4x + 5y = 3.25 \end{array}\right. \)</para>
               <para id="para-00045">Multiple Choice:</para>
               <para id="para-00046">\((1,2)\)</para>
               <para id="para-00047">\((0.5,0.25)\)</para>
               <para id="para-00048">\((–1,–5)\)</para>
               <para id="para-00049">\((3,9)\)</para>
            </problem>
            <solution id="sol-00004">
               <para id="para-00050">Correct! (0.5,0.25)</para>
               <para id="para-00051">Try again. Revisit activity 2.6.2.</para>
               <para id="para-00052">The correct answer is (0.5,0.25).</para>
               <para id="para-00053"> \(5( 7x–2y=3)=35x-10y=15 \) \(2(4x+5y=3.25)=8x+10y=6.5 \) \(2(4x+5y=3.25)=8x+10y=6.5 \) </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->
               <para id="para-00054"> \(\begin{array}{r}35x-10y&amp;=&amp;15 \\8x+10y&amp;=&amp;6.5 \\ \hline 43x&amp;=&amp;21.5 \\x&amp;=&amp;0.5 \end{array}\) \(\begin{array}{r}35x-10y&amp;=&amp;15 \\8x+10y&amp;=&amp;6.5 \\ \hline 43x&amp;=&amp;21.5 \\x&amp;=&amp;0.5 \end{array}\) </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->

               <!--BEGIN ALIGN TO EQUALS -->
               <para id="para-00055"> \(\begin{array}{rcl}−4(0.5)+5y&amp;=&amp;3.25 \\2+5y&amp;=&amp;3.25 \\5y&amp;=&amp;1.25 \\y&amp;=&amp;0.25 \\\end{array}\) \(\begin{array}{rcl}−4(0.5)+5y&amp;=&amp;3.25 \\2+5y&amp;=&amp;3.25 \\5y&amp;=&amp;1.25 \\y&amp;=&amp;0.25 \\\end{array}\) </para>
               <!--END ALIGN TO EQUALS -->
               <para id="para-00056">The solution is \((0.5,0.25)\).</para>

               <para id="para-00057">The solution is \((0.5,0.25)\).</para>
            </solution>
         </exercise>
         <exercise id="_7d8cc503-792c-4f17-abd4-ca9cc3a74d71" class="multiple-choice">
            <problem id="prob-00005">
               <para id="para-00058">\( \left\{ \begin{array}{c l} 5x + 9y = 16\\ x + 2y = 4 \end{array}\right. \)</para>
               <para id="para-00059">Multiple Choice:</para>
               <para id="para-00060">\((−4,4)\)</para>
               <para id="para-00061">\((3.2,0)\)</para>
               <para id="para-00062">\((−8,6)\)</para>
               <para id="para-00063">\((8,−2)\)</para>
            </problem>
            <solution id="sol-00005">
               <para id="para-00064">Correct! (−4,4)</para>
               <para id="para-00065">Try again. Revisit activity 2.6.3.</para>
               <para id="para-00066">The correct answer is (−4,4).</para>
               <para id="para-00067">\(5( 7x–2y=3)=35x-10y=15 \)</para>

               <!--BEGIN ALIGN TO EQUALS WITH LINE-->
               <para id="para-00068"> \(\begin{array}{r}5x+9y&amp;=&amp;16 \\-5x-10y&amp;=&amp;-20 \\ \hline -y&amp;=&amp;-4 \\y&amp;=&amp;4 \end{array}\) \(\begin{array}{r}5x+9y&amp;=&amp;16 \\-5x-10y&amp;=&amp;-20 \\ \hline -y&amp;=&amp;-4 \\y&amp;=&amp;4 \end{array}\) </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->

               <!--BEGIN ALIGN TO EQUALS -->
               <para id="para-00069"> \(\begin{array}{rcl}x+2(4)&amp;=&amp;4 \\x+8&amp;=&amp;4 \\x&amp;=&amp;-4 \\\end{array}\) \(\begin{array}{rcl}x+2(4)&amp;=&amp;4 \\x+8&amp;=&amp;4 \\x&amp;=&amp;-4 \\\end{array}\) </para>
               <!--END ALIGN TO EQUALS -->
               <para id="para-00070">The solution is \((-4,4)\).</para>

               <para id="para-00071">The solution is \((-4,4)\).</para>
            </solution>
         </exercise>
         <exercise id="ffdacaf7-13f0-460e-8e9c-95b0d3445bd8" class="multiple-choice">
            <problem id="prob-00006">
               <para id="para-00072">\( \left\{ \begin{array}{c l} \frac{3}{2}x - \frac{1}{4}y = 5\\ \frac{1}{3}x + \frac{1}{6}y = 2 \end{array}\right. \)</para>
               <para id="para-00073">Multiple Choice:</para>
               <para id="para-00074">\((4,4)\)</para>
               <para id="para-00075">\((1,−5)\)</para>
               <para id="para-00076">\((−\frac15,\frac23)\)</para>
               <para id="para-00077">\((−4,−5)\)</para>
            </problem>
            <solution id="sol-00006">
               <para id="para-00078">Correct! \( (4,4) \)</para>
               <para id="para-00079">Try again. Revisit activity 2.6.3.</para>
               <para id="para-00080">The correct answer is \( (4,4) \).</para>
               <para id="para-00081">\( 4( \frac32 x-\frac14 y=5)=6x-y=20\)</para>
               <para id="para-00082">\(6( \frac13 x+\frac16 y=2)=2x+y=12\)</para>

               <!--BEGIN ALIGN TO EQUALS WITH LINE-->
               <para id="para-00083"> \(\begin{array}{r} 6x-y&amp;=&amp;5 \\ 2x+y&amp;=&amp;12 \\ \hline 8x&amp;=&amp;32 \\x&amp;=&amp;4 \end{array}\) \(\begin{array}{r} 6x-y&amp;=&amp;5 \\ 2x+y&amp;=&amp;12 \\ \hline 8x&amp;=&amp;32 \\x&amp;=&amp;4 \end{array}\) </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->

               <!--BEGIN ALIGN TO EQUALS -->

               <para id="para-00084"> \(\begin{align*} x + 2(4)y &amp;= 12 \\ 8 + y &amp;= 12 \\ y &amp;= 4 \\ \end{align*}\) </para>
               <para id="para-00085">The solution is \((4,4)\).</para>
            </solution>
         </exercise>
         <exercise id="acd91d7d-e4a8-45d6-b064-706857b5cc44" class="multiple-choice">
            <problem id="prob-00007">
               <para id="para-00086">\( \left\{ \begin{array}{c l} \frac{1}{3}x + \frac{1}{9}y = 2\\ -\frac{1}{2}x + \frac{4}{5}y = -3 \end{array}\right. \)</para>
               <para id="para-00087">Multiple Choice:</para>
               <para id="para-00088">\((6,0)\)</para>
               <para id="para-00089">\((7,−3)\)</para>
               <para id="para-00090">\((8,−5)\)</para>
               <para id="para-00091">\((−2,−5)\)</para>
            </problem>
            <solution id="sol-00007">
               <para id="para-00092">Correct! (6,0)</para>
               <para id="para-00093">Try again. Revisit activity 2.6.3.</para>
               <para id="para-00094">The correct answer is (6,0).</para>
               <para id="para-00095"> \(9( \frac13 x+ \frac19 y=2)=3x+y=18 \) \(10( –\frac12 x+ \frac45 y=–3)=-5x+8y=-30 \) \(10( –\frac12 x+ \frac45 y=–3)=-5x+8y=-30 \) \(-8( 3x+y=18)=-24x-8y=-144 \) \(-8( 3x+y=18)=-24x-8y=-144 \) </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->
               <para id="para-00096"> \(\begin{align*}-5x+8y&amp;=-30 \\-24x-8y&amp;=-144 \\ \hline -29x&amp;=-174 \\x&amp;=6 \\\end{align*}\) \(\begin{align*}-5x+8y&amp;=-30 \\-24x-8y&amp;=-144 \\ \hline -29x&amp;=-174 \\x&amp;=6 \\\end{align*}\) </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->

               <!--BEGIN ALIGN TO EQUALS -->
               <para id="para-00097"> \(\begin{align*}3x+y&amp;=18 \\(3(6)+y&amp;=18 \\18+y&amp;=18 \\y&amp;=0 \\\end{align*}\) </para>
               <para id="para-00098"> \(\begin{align*}3x+y&amp;=18 \\(3(6)+y&amp;=18 \\18+y&amp;=18 \\y&amp;=0 \\\end{align*}\) </para>
               <!--END ALIGN TO EQUALS -->
               <para id="para-00099">The solution is \((6,0)\).</para>

               <para id="para-00100">The solution is \((6,0)\).</para>
            </solution>
         </exercise>
         <exercise id="_786245a2-01a9-446a-9503-4d7bea9acdba" class="multiple-choice">
            <problem id="prob-00008">
               <para id="para-00101">\( \left\{ \begin{array}{c l} 6x - 8y = \frac{16}{5}\\ 3x + 2y = \frac{14}{5} \end{array}\right. \)</para>
               <para id="para-00102">Multiple Choice:</para>
               <para id="para-00103">\((4,−4.6)\)</para>
               <para id="para-00104">\((0,−0.4)\)</para>
               <para id="para-00105">\((0.8,0.2)\)</para>
               <para id="para-00106">\((2,1.1)\)</para>
            </problem>
            <solution id="sol-00008">
               <para id="para-00107">Correct! (0.8,0.2)</para>
               <para id="para-00108">Try again. Revisit activity 2.6.2.</para>
               <para id="para-00109">The correct answer is (0.8,0.2).</para>
               <para id="para-00110">\( 4( 3x+2y=\frac{14}{5})=12x+8y=\frac{56}{5} \)</para>

               <!--BEGIN ALIGN TO EQUALS WITH LINE-->
               <para id="para-00111"> \(\begin{align*}6x-8y&amp;=\frac{16}{5} \\12x+8y&amp;=\frac{56}{5} \\ \hline 18x&amp;=\frac{72}{5} \\90x&amp;=72 \\x&amp;=\frac{72}{90} \\x&amp;=\frac{4}{5} \\x&amp;=0.8 \\\end{align*}\) \(\begin{align*}6x-8y&amp;=\frac{16}{5} \\12x+8y&amp;=\frac{56}{5} \\ \hline 18x&amp;=\frac{72}{5} \\90x&amp;=72 \\x&amp;=\frac{72}{90} \\x&amp;=\frac{4}{5} \\x&amp;=0.8 \\\end{align*}\) </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->

               <!--BEGIN ALIGN TO EQUALS -->
               <para id="para-00112"> \(\begin{align*}3(\frac45)+2y&amp;=\frac{14}{5} \\\frac{12}{5}+2y&amp;=\frac{14}{5} \\5(\frac{12}{5}+2y&amp;=\frac{14}{5}) \\12+10y&amp;=14 \\10y&amp;=2 \\y&amp;=\frac{2}{10} \\y&amp;=\frac15 \\y&amp;=0.2 \\\end{align*}\) </para>
               <para id="para-00113"> \(\begin{align*}3(\frac45)+2y&amp;=\frac{14}{5} \\\frac{12}{5}+2y&amp;=\frac{14}{5} \\5(\frac{12}{5}+2y&amp;=\frac{14}{5}) \\12+10y&amp;=14 \\10y&amp;=2 \\y&amp;=\frac{2}{10} \\y&amp;=\frac15 \\y&amp;=0.2 \\\end{align*}\) </para>
               <!--END ALIGN TO EQUALS -->
               <para id="para-00114">The solution is \((0.8,0.2)\).</para>

               <para id="para-00115">The solution is \((0.8,0.2)\).</para>
            </solution>
         </exercise>
         <exercise id="b2357ec1-f9da-4c47-98f6-69f02e394cc1" class="multiple-choice">
            <problem id="prob-00009">
               <para id="para-00116">\( \left\{ \begin{array}{c l} 5x – 2y = 2 \\ 7x – 4y = 2.5 \end{array}\right. \)</para>
               <para id="para-00117">Multiple Choice:</para>
               <para id="para-00118">\((2.4,5)\)</para>
               <para id="para-00119">\((2,4)\)</para>
               <para id="para-00120">\((0,−1)\)</para>
               <para id="para-00121">\((0.5,0.25)\)</para>
            </problem>
            <solution id="sol-00009">
               <para id="para-00122">Correct! (0.5,0.25)</para>
               <para id="para-00123">Try again. Revisit activity 2.6.2.</para>
               <para id="para-00124">The correct answer is (0.5,0.25).</para>
               <para id="para-00125">\(-2(5x-2y=2)=-10x+4y=-4\)</para>

               <!--BEGIN ALIGN TO EQUALS WITH LINE-->
               <para id="para-00126"> \(\begin{align*}-10x+4y&amp;=-4 \\7x-4y&amp;=2.5 \\ \hline -3x&amp;=-1.5 \\x&amp;=0.5 \end{align*}\) \(\begin{align*}-10x+4y&amp;=-4 \\7x-4y&amp;=2.5 \\ \hline -3x&amp;=-1.5 \\x&amp;=0.5 \end{align*}\) </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->

               <!--BEGIN ALIGN TO EQUALS -->
               <para id="para-00127"> \(\begin{align*}5(0.5)-2y&amp;=2 \\2.5-2y&amp;=2 \\-2y&amp;=-0.5 \\y&amp;=0.25 \\\end{align*}\) </para>
               <para id="para-00128"> \(\begin{align*}5(0.5)-2y&amp;=2 \\2.5-2y&amp;=2 \\-2y&amp;=-0.5 \\y&amp;=0.25 \\\end{align*}\) </para>
               <!--END ALIGN TO EQUALS -->
               <para id="para-00129">The solution is \((0.5,0.25)\).</para>

               <para id="para-00130">The solution is \((0.5,0.25)\).</para>
            </solution>
         </exercise>
         <exercise id="_326adc26-1990-4c2e-93b2-252ca0784e1d" class="multiple-choice">
            <problem id="prob-00010">
               <para id="para-00131">\( \left\{ \begin{array}{c l} \frac{1}{2}x + \frac{1}{3}y = \frac{1}{3}\\ \frac{1}{3}x + \frac{1}{4}y = -\frac{1}{8} \end{array}\right. \)</para>
               <para id="para-00132">Multiple Choice:</para>
               <para id="para-00133">\((9,–12.5)\)</para>
               <para id="para-00134">\((0,1)\)</para>
               <para id="para-00135">\((6,–8)\)</para>
               <para id="para-00136">\((12,–17)\)</para>
            </problem>
            <solution id="sol-00010">
               <para id="para-00137">Correct! (9,–12.5)</para>
               <para id="para-00138">Try again. Revisit activity 2.6.3. </para>
               <para id="para-00139">The correct answer is (9,–12.5).</para>
               <para id="para-00140"> \(6( \frac12 x+\frac13 y=\frac13)=3x+2y=2 \) \(24( \frac13 x+\frac14 y=–\frac18)=8x+6y=-3 \) \(24( \frac13 x+\frac14 y=–\frac18)=8x+6y=-3 \) \(-3(3x+2y=2)=-9x-6y=-6\) \(-3(3x+2y=2)=-9x-6y=-6\) </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->
               <para id="para-00141"> \(\begin{align*}-9x-6y&amp;=-6 \\8x+6y&amp;=-3 \\ \hline -x&amp;=-9 \\x&amp;=9 \\\end{align*}\) \(\begin{align*}-9x-6y&amp;=-6 \\8x+6y&amp;=-3 \\ \hline -x&amp;=-9 \\x&amp;=9 \\\end{align*}\) </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->

               <!--BEGIN ALIGN TO EQUALS -->
               <para id="para-00142"> \(\begin{align*}3(9)+2y&amp;=2 \\27+2y&amp;=2 \\2y&amp;=-25 \\y=&amp;-12.5 \\\end{align*}\) </para>
               <para id="para-00143"> \(\begin{align*}3(9)+2y&amp;=2 \\27+2y&amp;=2 \\2y&amp;=-25 \\y=&amp;-12.5 \\\end{align*}\) </para>
               <!--END ALIGN TO EQUALS -->
               <para id="para-00144">The solution is \((9,-12.5)\).</para>

               <para id="para-00145">The solution is \((9,-12.5)\).</para>
            </solution>
         </exercise>
      </section>
   </content>
