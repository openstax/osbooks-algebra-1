  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<para>Solve each system of equations to practice the skills you have learned in this lesson. Enter your answer as “(x,y)” in the space provided. If any coordinate is a non-integer, enter it in decimal format.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="2244dfe1-81f1-49a0-ac96-3d6b4612b4b8" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--Q1-->
  <exercise data-content-id="9bc99444-8aaa-47fe-a206-b69c41414c38" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((6,−6)\)" data-solution-options="[&quot;\\((0,15)\\)&quot;, &quot;\\((11,−4)\\)&quot;, &quot;\\((1,−8)\\)&quot;, &quot;\\((6,−6)\\)&quot;]">
    <problem>
      <para>1. \( \left\{ \begin{array}{c l} –2x + 5y = –42\\ 7x + 2y = 30 \end{array}\right. \)</para>
    </problem>
    <solution>
      <para>Correct! (6,−6)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.6.2. Revisit</para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q2-->
  <exercise data-content-id="2d665fcc-760f-4664-95f6-6652b9a78b16" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((−4,2)\)" data-solution-options="[&quot;\\((2,0)\\)&quot;, &quot;\\((1,8)\\)&quot;, &quot;\\((−4,2)\\)&quot;, &quot;\\((−9,−4)\\)&quot;]">
    <problem>
      <para>2. \( \left\{ \begin{array}{c l} 6x – 5y = –34\\ 2x + 6y = 4 \end{array}\right. \)</para>
    </problem>
    <solution>
      <para>Correct! (−4,2)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.6.2.
      </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q3-->
  <exercise data-content-id="34358845-9f4c-49dd-9744-40f69306892c" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((−0.5,0.1)\)" data-solution-options="[&quot;\\((7,–4.9)\\)&quot;, &quot;\\((0.5,0.1)\\)&quot;, &quot;\\((−3,−12)\\)&quot;, &quot;\\((−0.5,0.1)\\)&quot;]">
    <problem>
      <para>3. \( \left\{ \begin{array}{c l} 5x – y = –2.6\\ −4x − 6y = 1.4 \end{array}\right. \)</para>
    </problem>
    <solution>
      <para>Correct! (−0.5,0.1)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.6.2. Revisit

      </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q4-->
  <exercise data-content-id="d5da2e2a-5854-4af4-9134-d43fb40d9570" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((0.5,0.25)\)" data-solution-options="[&quot;\\((1,2)\\)&quot;, &quot;\\((0.5,0.25)\\)&quot;, &quot;\\((–1,–5)\\)&quot;, &quot;\\((3,9)\\)&quot;]">
    <problem>
      <para>4. \( \left\{ \begin{array}{c l} 7x – 2y = 3\\ 4x + 5y = 3.25 \end{array}\right. \)</para>
    </problem>
    <solution>
      <para>Correct! (0.5,0.25)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.6.2.

      </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q5-->
  <exercise data-content-id="7d8cc503-792c-4f17-abd4-ca9cc3a74d71" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((−4,4)\)" data-solution-options="[&quot;\\((−4,4)\\)&quot;, &quot;\\((3.2,0)\\)&quot;, &quot;\\((−8,6)\\)&quot;, &quot;\\((8,−2)\\)&quot;]">
    <problem>
      <para>5. \( \left\{ \begin{array}{c l} 5x + 9y = 16\\ x + 2y = 4 \end{array}\right. \)</para>
    </problem>
    <solution>
      <para>Correct! (−4,4)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.6.3.


      </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q6-->
  <exercise data-content-id="ffdacaf7-13f0-460e-8e9c-95b0d3445bd8" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((4,4)\)" data-solution-options="[&quot;\\((4,4)\\)&quot;, &quot;\\((1,−5)\\)&quot;, &quot;\\((−\\frac15,\\frac23)\\)&quot;, &quot;\\((−4,−5)\\)&quot;]">
    <problem>
      <para>6. \( \left\{ \begin{array}{c l} \frac{3}{2}x - \frac{1}{4}y = 5\\ \frac{1}{3}x + \frac{1}{6}y = 2 \end{array}\right. \)</para>
    </problem>
    <solution>
      <para>Correct! \( (4,4) \)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.6.3.


      </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q7-->
  <exercise data-content-id="acd91d7d-e4a8-45d6-b064-706857b5cc44" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((6,0)\)" data-solution-options="[&quot;\\((6,0)\\)&quot;, &quot;\\((7,−3)\\)&quot;, &quot;\\((8,−5)\\)&quot;, &quot;\\((−2,−5)\\)&quot;]">
    <problem>
      <para>7. \( \left\{ \begin{array}{c l} \frac{1}{3}x + \frac{1}{9}y = 2\\ -\frac{1}{2}x + \frac{4}{5}y = -3 \end{array}\right. \)</para>
    </problem>
    <solution>
      <para>Correct! (6,0)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.6.3.


      </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q8-->
  <exercise data-content-id="786245a2-01a9-446a-9503-4d7bea9acdba" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((0.8,0.2)\)" data-solution-options="[&quot;\\((4,−4.6)\\)&quot;, &quot;\\((0,−0.4)\\)&quot;, &quot;\\((0.8,0.2)\\)&quot;, &quot;\\((2,1.1)\\)&quot;]">
    <problem>
      <para>8. \( \left\{ \begin{array}{c l} 6x - 8y = \frac{16}{5}\\ 3x + 2y = \frac{14}{5} \end{array}\right. \)</para>
    </problem>
    <solution>
      <para>Correct! (0.8,0.2)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.6.2.


      </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q9-->
  <exercise data-content-id="b2357ec1-f9da-4c47-98f6-69f02e394cc1" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((0.5,0.25)\)" data-solution-options="[&quot;\\((2.4,5)\\)&quot;, &quot;\\((2,4)\\)&quot;, &quot;\\((0,−1)\\)&quot;, &quot;\\((0.5,0.25)\\)&quot;]">
    <problem>
      <para>9. \( \left\{ \begin{array}{c l} 5x – 2y = 2 \\ 7x – 4y = 2.5 \end{array}\right. \)</para>
    </problem>
    <solution>
      <para>Correct! (0.5,0.25)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.6.2.
      </para>
    </div>
    </exercise>
  <!--END QUESTION.-->
  <!--Q10-->
  <exercise data-content-id="326adc26-1990-4c2e-93b2-252ca0784e1d" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((9,–12.5)\)" data-solution-options="[&quot;\\((9,–12.5)\\)&quot;, &quot;\\((0,1)\\)&quot;, &quot;\\((6,–8)\\)&quot;, &quot;\\((12,–17)\\)&quot;]">
    <problem>
      <para>10. \( \left\{ \begin{array}{c l} \frac{1}{2}x + \frac{1}{3}y = \frac{1}{3}\\ \frac{1}{3}x + \frac{1}{4}y = -\frac{1}{8} \end{array}\right. \)</para>
    </problem>
    <solution>
      <para>Correct! (9,–12.5)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 2.6.3.
      </para>
    </div>
    </exercise>
