         <exercise id="_7d8cc503-792c-4f17-abd4-ca9cc3a74d71" class="multiple-choice">
            <problem id="prob-00005">
               <para id="para-00058"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="center"><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>16</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
