<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
   <title>2.6.5: Practice</title>
   <metadata xmlns:md="http://cnx.rice.edu/mdml">
      <md:content-id>m00467</md:content-id>
      <md:title>2.6.5: Practice</md:title>
      <md:uuid>0644758b-5f74-48b7-a816-f673dae1f1b6</md:uuid>
   </metadata>
   <content>
      <section class="practice" id="sect-00001">

         <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
         <para id="para-00002">Solve each system of equations to practice the skills you have learned in this lesson. Enter your answer as “(x,y)” in the space provided. If any coordinate is a non-integer, enter it in decimal format.</para>
         <exercise id="_9bc99444-8aaa-47fe-a206-b69c41414c38" class="multiple-choice">
            <problem id="prob-00001">
               <para id="para-00003"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="center"><m:mi>–</m:mi><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>42</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>30</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
               <para id="para-00004">Multiple Choice:</para>
               <para id="para-00005"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>15</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
               <para id="para-00006"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>11</m:mn><m:mo>,</m:mo><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
               <para id="para-00007"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mi>−</m:mi><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
               <para id="para-00008"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            </problem>
            <solution id="sol-00001">
               <para id="para-00009">Correct! (6,−6)</para>
               <para id="para-00010">Try again. Revisit activity 2.6.2. Revisit</para>
               <para id="para-00011">The correct answer is (6,−6). </para>
               <para id="para-00012"><m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mi>–</m:mi><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>42</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>10</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>84</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>30</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>35</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>150</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>30</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>35</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>150</m:mn></m:mrow></m:math> </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->
               <para id="para-00013"> <m:math display="inline"><m:mrow><m:mtable rowlines="none solid none"><m:mtr><m:mtd columnalign="right"><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>10</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="right"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="right"><m:mn>84</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>35</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="right"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="right"><m:mn>150</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>39</m:mn><m:mi>x</m:mi></m:mtd><m:mtd columnalign="right"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="right"><m:mn>234</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi></m:mtd><m:mtd columnalign="right"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="right"><m:mn>6</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mtable rowlines="none solid none"><m:mtr><m:mtd columnalign="right"><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>10</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="right"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="right"><m:mn>84</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>35</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>10</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="right"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="right"><m:mn>150</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>39</m:mn><m:mi>x</m:mi></m:mtd><m:mtd columnalign="right"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="right"><m:mn>234</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi></m:mtd><m:mtd columnalign="right"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="right"><m:mn>6</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->

               <!--BEGIN ALIGN TO EQUALS -->
               <para id="para-00014"> <m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>7</m:mn><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>30</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>42</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>30</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>12</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>6</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>7</m:mn><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>30</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>42</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>30</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>12</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>6</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> </para>
               <!--END ALIGN TO EQUALS -->
               <para id="para-00015">The solution is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
            </solution>
         </exercise>
         <exercise id="_2d665fcc-760f-4664-95f6-6652b9a78b16" class="multiple-choice">
            <problem id="prob-00002">
               <para id="para-00016"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="center"><m:mn>6</m:mn><m:mi>x</m:mi><m:mi>–</m:mi><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>34</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
               <para id="para-00017">Multiple Choice:</para>
               <para id="para-00018"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
               <para id="para-00019"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
               <para id="para-00020"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
               <para id="para-00021"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>9</m:mn><m:mo>,</m:mo><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            </problem>
            <solution id="sol-00002">
               <para id="para-00022">Correct! (−4,2)</para>
               <para id="para-00023">Try again. Revisit activity 2.6.2.</para>
               <para id="para-00024">The correct answer is (−4,2).</para>
               <para id="para-00025"><m:math><m:mrow><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>18</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>12</m:mn></m:mrow></m:math></para>

               <!--BEGIN ALIGN TO EQUALS WITH LINE-->
               <para id="para-00026"> <m:math display="inline"><m:mrow><m:mtable rowlines="none solid none"><m:mtr><m:mtd columnalign="right"><m:mn>6</m:mn><m:mi>x</m:mi><m:mi>–</m:mi><m:mn>5</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="right"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="right"><m:mn>34</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>18</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="right"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="right"><m:mn>12</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>23</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="right"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>46</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="right"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="right"><m:mn>2</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mtable rowlines="none solid none"><m:mtr><m:mtd columnalign="right"><m:mn>6</m:mn><m:mi>x</m:mi><m:mi>–</m:mi><m:mn>5</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="right"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="right"><m:mn>34</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>18</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="right"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="right"><m:mn>12</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>23</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="right"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>46</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="right"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="right"><m:mn>2</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->

               <!--BEGIN ALIGN TO EQUALS -->
               <para id="para-00027"> <m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>12</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>x</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>4</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>12</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>x</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>4</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> </para>
               <!--END ALIGN TO EQUALS -->
               <para id="para-00028">The solution is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>

               <para id="para-00029">The solution is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
            </solution>
         </exercise>

         <exercise id="_34358845-9f4c-49dd-9744-40f69306892c" class="multiple-choice">
            <problem id="prob-00003">
               <para id="para-00030"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="center"><m:mn>5</m:mn><m:mi>x</m:mi><m:mi>–</m:mi><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mn>2.6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mi>−</m:mi><m:mn>4</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1.4</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
