         <exercise id="b2357ec1-f9da-4c47-98f6-69f02e394cc1" class="multiple-choice">
            <problem id="prob-00009">
               <para id="para-00116"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="center"><m:mn>5</m:mn><m:mi>x</m:mi><m:mi>–</m:mi><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mn>7</m:mn><m:mi>x</m:mi><m:mi>–</m:mi><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2.5</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
               <para id="para-00117">Multiple Choice:</para>
               <para id="para-00118"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2.4</m:mn><m:mo>,</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
               <para id="para-00119"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
               <para id="para-00120"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
               <para id="para-00121"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0.5</m:mn><m:mo>,</m:mo><m:mn>0.25</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            </problem>
            <solution id="sol-00009">
               <para id="para-00122">Correct! (0.5,0.25)</para>
               <para id="para-00123">Try again. Revisit activity 2.6.2.</para>
               <para id="para-00124">The correct answer is (0.5,0.25).</para>
               <para id="para-00125"><m:math><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>10</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>

               <!--BEGIN ALIGN TO EQUALS WITH LINE-->
               <para id="para-00126"> <m:math display="inline"><m:mrow><m:mtable displaystyle="true" rowspacing="3pt" rowlines="none solid none" columnspacing="0em 2em"><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>10</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>2.5</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1.5</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>0.5</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mtable displaystyle="true" rowspacing="3pt" rowlines="none solid none" columnspacing="0em 2em"><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>10</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>2.5</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1.5</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>0.5</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->

               <!--BEGIN ALIGN TO EQUALS -->
               <para id="para-00127"> <m:math display="inline"><m:mrow><m:mtable displaystyle="true" rowspacing="3pt" columnspacing="0em 2em"><m:mtr><m:mtd columnalign="right"><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mn>0.5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2.5</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.5</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>0.25</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> </para>
               <para id="para-00128"> <m:math display="inline"><m:mrow><m:mtable displaystyle="true" rowspacing="3pt" columnspacing="0em 2em"><m:mtr><m:mtd columnalign="right"><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mn>0.5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2.5</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>0.5</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>0.25</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> </para>
               <!--END ALIGN TO EQUALS -->
               <para id="para-00129">The solution is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0.5</m:mn><m:mo>,</m:mo><m:mn>0.25</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>

               <para id="para-00130">The solution is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0.5</m:mn><m:mo>,</m:mo><m:mn>0.25</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
            </solution>
         </exercise>
         <exercise id="_326adc26-1990-4c2e-93b2-252ca0784e1d" class="multiple-choice">
            <problem id="prob-00010">
               <para id="para-00131"><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="center"><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>8</m:mn></m:mrow></m:mfrac></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
               <para id="para-00132">Multiple Choice:</para>
               <para id="para-00133"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>12.5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
               <para id="para-00134"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
               <para id="para-00135"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
               <para id="para-00136"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mi>–</m:mi><m:mn>17</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            </problem>
            <solution id="sol-00010">
               <para id="para-00137">Correct! (9,–12.5)</para>
               <para id="para-00138">Try again. Revisit activity 2.6.3. </para>
               <para id="para-00139">The correct answer is (9,–12.5).</para>
               <para id="para-00140"> <m:math display="inline"><m:mrow><m:mn>6</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mn>24</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mn>24</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>–</m:mi><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math> </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->
               <para id="para-00141"> <m:math display="inline"><m:mrow><m:mtable displaystyle="true" rowspacing="3pt" rowlines="none solid none" columnspacing="0em 2em"><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mi>x</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>9</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mtable displaystyle="true" rowspacing="3pt" rowlines="none solid none" columnspacing="0em 2em"><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mi>x</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>9</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> </para>
               <!--BEGIN ALIGN TO EQUALS WITH LINE-->

               <!--BEGIN ALIGN TO EQUALS -->
               <para id="para-00142"> <m:math display="inline"><m:mrow><m:mtable displaystyle="true" rowspacing="3pt" columnspacing="0em 2em"><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>27</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>25</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>−</m:mo><m:mn>12.5</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> </para>
               <para id="para-00143"> <m:math display="inline"><m:mrow><m:mtable displaystyle="true" rowspacing="3pt" columnspacing="0em 2em"><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>27</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>25</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>−</m:mo><m:mn>12.5</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> </para>
               <!--END ALIGN TO EQUALS -->
               <para id="para-00144">The solution is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>12.5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>

               <para id="para-00145">The solution is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>12.5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
            </solution>
