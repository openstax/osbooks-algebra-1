               <!--BEGIN ALIGN TO EQUALS -->
               <para id="para-00097"> <m:math display="inline"><m:mrow><m:mtable displaystyle="true" rowspacing="3pt" columnspacing="0em 2em"><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>18</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>18</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>18</m:mn><m:mo>+</m:mo><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>18</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>0</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> </para>
               <para id="para-00098"> <m:math display="inline"><m:mrow><m:mtable displaystyle="true" rowspacing="3pt" columnspacing="0em 2em"><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>18</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>18</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>18</m:mn><m:mo>+</m:mo><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>18</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="left"><m:mi/><m:mo>=</m:mo><m:mn>0</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math> </para>
