               <para id="para-00061"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3.2</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
