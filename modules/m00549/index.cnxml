<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Matching Inequalities and Solutions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00549</md:content-id>
    <md:title>Matching Inequalities and Solutions</md:title>
    <md:uuid>571ccc1a-89b8-4eed-a81f-5e30a0df9016</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">      <title>Activity</title>
      <para id="para-00001">Match each inequality to a graph that represents its solutions. Be prepared to show your
        reasoning.</para>
      <list id="list-00001">
        <item><m:math><m:mrow><m:mn>6</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>≤</m:mo><m:mspace width="0.278em"/><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math></item>
        <item><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>&gt;</m:mo><m:mo>–</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></item>
        <item><m:math><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>≥</m:mo><m:mn>7</m:mn><m:mi>x</m:mi></m:mrow></m:math></item>
        <item><m:math><m:mrow><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>–</m:mo><m:mn>2</m:mn><m:mo>&lt;</m:mo><m:mo>–</m:mo><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>–</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></item>
        <item><m:math><m:mrow><m:mfrac><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>–</m:mo><m:mn>1</m:mn></m:mrow><m:mn>3</m:mn></m:mfrac><m:mo>&gt;</m:mo><m:mo>–</m:mo><m:mn>1</m:mn></m:mrow></m:math></item>
        <item><m:math><m:mrow><m:mfrac><m:mrow><m:mn>12</m:mn></m:mrow><m:mn>5</m:mn></m:mfrac><m:mo>–</m:mo><m:mfrac><m:mi>x</m:mi><m:mn>5</m:mn></m:mfrac><m:mo>≤</m:mo><m:mi>x</m:mi></m:mrow></m:math></item>
      </list>
      <para id="para-00002">Graph A</para>
      
        <media alt="A number line extends from negative 10 to 10. At negative one half an open circle is graphed with the number line extending to the right shaded.">
          <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_12_09_01.svg"/>
        </media>
      
      <para id="para-00003">Graph B</para>
      
        <media alt="A number line extends from negative 10 to 10. At two a closed circle is graphed with the number line extending to the left shaded.">
          <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_12_09_02.svg"/>
        </media>
      
      <para id="para-00004">Graph C</para>
      
        <media alt="A number line extends from negative 10 to 10. At two a closed circle is graphed with the number line extending to the right shaded.">
          <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_12_09_03.svg"/>
        </media>
      
      <para id="para-00005">Graph D</para>
      
        <media alt="A number line extends from negative 10 to 10. At one half an open circle is graphed with the number line extending to the left shaded.">
          <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_12_09_04.svg"/>
        </media>
      
      <para id="para-00006">Graph E</para>
      
        <media alt="A number line extends from negative 10 to 10. At negative two an open circle is graphed with the number line extending to the right shaded.">
          <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_12_09_05.svg"/>
        </media>
      
      <para id="para-00007">Graph F</para>
      
        <media alt="A number line extends from negative 10 to 10. At zero a closed circle is graphed with the number line extending to the left shaded.">
          <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_12_09_06.svg"/>
        </media>
      

      <para id="para-00008">Use this inequality for questions 1 - 2:</para>
      <quote id="quote-00001"><m:math><m:mrow><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math></quote>

      <!-- BEGIN ACTIVITY DROP DOWN 1 TRY -->

        <exercise id="_04f58b3f-9635-4c5e-b81d-558a3314c7bc" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00010">Match the graph to the equation.</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00011">Graph F.</para>
          </solution>
        </exercise>
  
      <!--END
      ACTIVITY DROP DOWN 1 TRY -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q2-->
      <exercise id="exer-00001">
        <problem id="prob-00002">
          <para id="para-00013">Explain or show your reasoning.</para>

        </problem>
        <solution id="sol-00002">
          <para id="para-00014">Compare your answer: </para>
          <para id="para-00015"><m:math><m:mrow><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>0</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <para id="para-00016">Use this inequality for questions 3 and 4:</para>
      <quote id="quote-00002"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>&gt;</m:mo><m:mo>–</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></quote>

      <!-- BEGIN ACTIVITY DROP DOWN 3 TRY -->

        <exercise id="e55ed44e-b598-44a4-a18e-5054b90c5f89" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00018">Match the graph to the equation.</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00019">Graph E.</para>
          </solution>
        </exercise>

      <!--END
      ACTIVITY DROP DOWN 3 TRY -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q4-->
      <exercise id="exer-00002">
        <problem id="prob-00004">
          <para id="para-00021">Explain or show your reasoning.</para>

        </problem>
        <solution id="sol-00004">
          <para id="para-00022">Compare your answer: </para>
          <para id="para-00023"><m:math><m:mrow><m:mi>x</m:mi><m:mo>&gt;</m:mo><m:mo>–</m:mo><m:mn>2</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <para id="para-00024">Use this inequality for questions 5 - 6:</para>
      <quote id="quote-00003"><m:math><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>≥</m:mo><m:mn>7</m:mn><m:mi>x</m:mi></m:mrow></m:math></quote>

      <!-- BEGIN ACTIVITY DROP DOWN 5 TRY -->

        <exercise id="b8a506e8-f322-416c-9572-2149073ac119" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00026">Match the graph to the equation.</para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00027">Graph B.</para>
          </solution>
        </exercise>

      <!--END
      ACTIVITY DROP DOWN 5 TRY -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q6-->
      <exercise id="exer-00003">
        <problem id="prob-00006">
          <para id="para-00029">Explain or show your reasoning.</para>

        </problem>
        <solution id="sol-00006">
          <para id="para-00030">Compare your answer: </para>
          <para id="para-00031"><m:math><m:mrow><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>2</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <para id="para-00032">Use this inequality for questions 7 and 8:</para>
      <quote id="quote-00004"><m:math><m:mrow><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>–</m:mo><m:mn>2</m:mn><m:mo>&lt;</m:mo><m:mo>–</m:mo><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>–</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></quote>

      <!-- BEGIN ACTIVITY DROP DOWN 5 TRY -->

        <exercise id="_75bdea6a-df38-4d60-acaf-2f46b49ba4d5" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00034">Match the graph to the equation.</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00035">Graph D.</para>
          </solution>
        </exercise>

      <!--END
      ACTIVITY DROP DOWN 5 TRY -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q8-->
      <exercise id="exer-00004">
        <problem id="prob-00008">
          <para id="para-00037">Explain or show your reasoning.</para>

        </problem>
        <solution id="sol-00008">
          <para id="para-00038">Compare your answer: </para>
          <para id="para-00039"><m:math><m:mrow><m:mi>x</m:mi><m:mo>&lt;</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <para id="para-00040">Use this inequality for 9 - 10:</para>
      <quote id="quote-00005"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>–</m:mo><m:mn>1</m:mn></m:mrow><m:mn>3</m:mn></m:mfrac><m:mo>&gt;</m:mo><m:mo>–</m:mo><m:mn>1</m:mn></m:mrow></m:math></quote>

      <!-- BEGIN ACTIVITY DROP DOWN 9 TRY -->

        <exercise id="_546b2336-9fc0-4484-b961-ed50a29fdd8d" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00042">Match the graph to the equation.</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00043">Graph A.</para>
          </solution>
        </exercise>

      <!--END
      ACTIVITY DROP DOWN 9 TRY -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q10-->
      <exercise id="exer-00005">
        <problem id="prob-00010">
          <para id="para-00045">Explain or show your reasoning.</para>

        </problem>
        <solution id="sol-00010">
          <para id="para-00046">Compare your answer: </para>
          <para id="para-00047"><m:math><m:mrow><m:mi>x</m:mi><m:mo>&gt;</m:mo><m:mo>–</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <para id="para-00048">Use this inequality for questions 11 and 12:</para>
      <quote id="quote-00006"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>12</m:mn></m:mrow><m:mn>5</m:mn></m:mfrac><m:mo>–</m:mo><m:mfrac><m:mi>x</m:mi><m:mn>5</m:mn></m:mfrac><m:mo>≤</m:mo><m:mi>x</m:mi></m:mrow></m:math></quote>

      <!-- BEGIN ACTIVITY DROP DOWN 11 TRY -->

        <exercise id="_0ba2c880-763b-4a31-a8af-42001535d3fb" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00050">Match the graph to the equation.</para>
          </problem>
          <solution id="sol-00011">
            <para id="para-00051">Graph C.</para>
          </solution>
        </exercise>

      <!--END
      ACTIVITY DROP DOWN 11 TRY -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q12-->
      <exercise id="exer-00006">
        <problem id="prob-00012">
          <para id="para-00053">Explain or show your reasoning.</para>

        </problem>
        <solution id="sol-00012">
          <para id="para-00054">Compare your answer: </para>
          <para id="para-00055"><m:math><m:mrow><m:mi>x</m:mi><m:mo>≥</m:mo><m:mn>2</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
    </section>
  </content>
</document>