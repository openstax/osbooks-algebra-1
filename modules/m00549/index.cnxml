<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.10.4: Matching Inequalities and Solutions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00549</md:content-id>
    <md:title>2.10.4: Matching Inequalities and Solutions</md:title>
    <md:uuid>571ccc1a-89b8-4eed-a81f-5e30a0df9016</md:uuid>
  </metadata>
  <content>
    <section>
      <title>Activity</title>
      <para>Match each inequality to a graph that represents its solutions. Be prepared to show your
        reasoning.</para>
      <list>
        <item>\(6x\;\leq\;3x\)</item>
        <item>\(\frac14x&gt;-\frac12\)</item>
        <item>\(5x+4\geq7x\)</item>
        <item>\(8x-2&lt;-4(x-1)\)</item>
        <item>\(\frac{4x-1}3&gt;-1\)</item>
        <item>\(\frac{12}5-\frac x5\leq x\)</item>
      </list>
      <para>Graph A</para>
      
        <media
          alt="Inequality graphed on a number line. Numbers from negative 10 to 10. At negative one half, open circle with line extending to the right.  ">
          <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_12_09_01.svg" />
        </media>
      
      <para>Graph B</para>
      
        <media
          alt="Inequality graphed on a number line. Numbers from negative 10 to 10. At two, closed circle with line extending to the left.  ">
          <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_12_09_02.svg" />
        </media>
      
      <para>Graph C</para>
      
        <media
          alt="Inequality graphed on a number line. Numbers from negative 10 to 10. At two, closed circle with line extending to the right.">
          <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_12_09_03.svg" />
        </media>
      
      <para>Graph D</para>
      
        <media
          alt="Inequality graphed on a number line. Numbers from negative 10 to 10. At  one half, open circle with line extending to the left.  ">
          <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_12_09_04.svg" />
        </media>
      
      <para>Graph E</para>
      
        <media
          alt="Inequality graphed on a number line. Numbers from negative 10 to 10. At negative 2, open circle with line extending to the right.">
          <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_12_09_05.svg" />
        </media>
      
      <para>Graph F</para>
      
        <media
          alt="Inequality graphed on a number line. Numbers from negative 10 to 10. At 0, closed circle with line extending to the left.">
          <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_12_09_06.svg" />
        </media>
      

      <para>Use this inequality for questions 1 - 2:</para>
      <para>
        <quote>\(6x\le3x\)</quote>
     </para>
      <!-- BEGIN ACTIVITY DROP DOWN 1 TRY -->

        <exercise id="_04f58b3f-9635-4c5e-b81d-558a3314c7bc" class="multiple-choice">
          <problem>
            <para>Match the graph to the equation.</para>
          </problem>
          <solution>
            <para>Correct! Graph F.</para>
            <para>Nice try! The correct answer is Graph F.</para>
          </solution>
        </exercise>
  
      <!--END
      ACTIVITY DROP DOWN 1 TRY -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q2-->
      <exercise>
        <problem>
          <para>Explain or show your reasoning.</para>

        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(x\leq0\)</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
