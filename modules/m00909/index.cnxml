      <entry>
        <list>
          <item>dependent variable </item>
          <item>function </item>
          <item>function notation </item>
          <item>independent variable </item>
        </list>
      </entry>
      <entry>
        <list>
          <item>linear function </item>
          <item>vertical line test</item>
        </list>
