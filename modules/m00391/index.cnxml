    <section id="sect-00005">
    <note class="self-check" id="note-00001">
      <exercise id="exer-00012">
        <problem id="prob-00016">
        <para id="para-00055"><link class="os-embed" url="#exercise/Alg1_2_2_3_SC"/></para>
        </problem>
        </exercise>
    </note>
