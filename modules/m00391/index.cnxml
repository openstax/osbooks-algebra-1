<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Graphs of Systems of Equations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00391</md:content-id>
    <md:title>Graphs of Systems of Equations</md:title>
    <md:uuid>0dc8b014-89a5-40be-967b-d6ebe00c396f</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001" class="numbered-exercises">
      <title>Activity</title>
      <para id="para-00001">Now that you have written equations from tables, it is time to write systems of
        equations from graphs.</para>
      <para id="para-00002">
        <emphasis>Part 1: Writing a System of Equations from a Given Graph </emphasis>
     </para>
      <para id="para-00003">For questions 1 – 8, use the given graph:</para>
      
        <media alt="A graph with two lines: a solid orange line rising steeply from left to right and a dashed green line falling from left to right. Both lines intersect near the center of the coordinate grid.">
          <image mime-type="image/jpeg" src="../../media/Algebra-1_02_04_06_01.jpg"/>
        </media>
      

        <exercise id="_0a49b738-8436-497d-8638-18fa613b6ced" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00004">For the green dashed line what is the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-value of the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercept?</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00005">9</para>
          </solution>
        </exercise>
        <exercise id="ec23dfc4-4e5e-4dfc-b5a8-854b9fbd123c" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00007">For the green dashed line what is the slope?</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00008">-1</para>
          </solution>
        </exercise>

      <!--Q#3-->
      <exercise id="exer-00001">
        <problem id="prob-00003">
          <para id="para-00010">What is the equation of the green dashed line in slope-intercept form?</para>

        </problem>
        <solution id="sol-00003">
          <para id="para-00011">Compare your answer: </para>
          <para id="para-00012"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->

        <exercise id="adafd334-fdb7-43a1-aa7d-69c9835cde5a" class="multiple-choice">
          <problem id="prob-00004">

            <para id="para-00013">For the orange solid line what is the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-value of the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercept?</para>
          </problem>
          <solution id="sol-00004">

            <para id="para-00014">5.</para>
          </solution>
        </exercise>
        <exercise id="e5b6a568-4cef-49f8-a35b-df8ac3233ff4" class="multiple-choice">
          <problem id="prob-00005">

            <para id="para-00015">For the orange solid line what is the slope?</para>
          </problem>
          <solution id="sol-00005">

            <para id="para-00016">3.</para>
          </solution>
        </exercise>

      <!--Q#6-->
      <exercise id="exer-00002">
        <problem id="prob-00006">
          <para id="para-00017">What is the equation of the orange solid line in slope-intercept form?</para>

        </problem>
        <solution id="sol-00006">
          <para id="para-00018">Compare your answer: </para>
          <para id="para-00019"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#7-->
      <exercise id="exer-00003">
        <problem id="prob-00007">
          <para id="para-00020">Write the two equations as a system of linear equations.</para>

        </problem>
        <solution id="sol-00007">
          <para id="para-00021">Compare your answer: </para>
          <para id="para-00022"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math></para><para id="para-00023"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#8-->
      <exercise id="exer-00004">
        <problem id="prob-00008">
          <para id="para-00024">What is the solution of the system of equations?</para>

        </problem>
        <solution id="sol-00008">
          <para id="para-00025">Compare your answer: </para>
          <para id="para-00026"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End --><section id="sect-00003">
      <title>Are you ready for more?</title>
      <section id="sect-00004"><title>Extending Your Thinking</title>
      <exercise class="RFM1 unnumbered" id="exer-00009">
        <problem id="prob-00013">
          <para id="para-00048">Graph the following system of equations on a coordinate plane:</para>
          <para id="para-00049"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para><para id="para-00050"><m:math><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math></para><para id="para-00051">Find the solution.</para>
          <para id="para-00052">(Hint: For the second equation, solve for <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> first.)</para>

        </problem>
        <solution id="sol-00013">
          <para id="para-00053">Compare your answer: </para>
          <para id="para-00054">Infinitely many solutions. When the second equation is solved for <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>, it becomes
            <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math> then <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math>. Both equations are the same. So, on the graph, one
            line is on top of the other and all solutions are possible.</para>
        </solution>
      </exercise>
      <!--End
      interaction-->
    </section>
  </section>

  </section>
      <section class="numbered-exercises" id="sect-00008">
      <para id="para-00027">
        <emphasis>Part 2: Use a Graph to Solve a Given System</emphasis>
     </para>
      <para id="para-00028">Now that you wrote a system of equations from a given graph, how can you work backward
        and graph a given system of equations by hand? Discuss this with a partner.</para>
      <para id="para-00029">For questions 1 - 2, use this system of equations:</para>
      <para id="para-00030"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00031"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math></para><!--Q#1-->

      <exercise id="exer-00005">
          <problem id="prob-00009">
            <!--QUESTION
            IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
            <para id="para-00032">On the same coordinate plane, graph <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math> by hand.</para>
            <para id="para-00033"/>
          </problem>
          <solution id="sol-00009">
            <para id="para-00034">Compare your answer: </para>
            
              <media alt="A graph with two lines: a solid orange line with positive slope and a dashed green line with negative slope, both crossing the y-axis near the origin. The grid shows labeled x and y axes.">
                <image mime-type="image/jpeg" src="../../media/Algebra-1_02_04_06_02.jpg"/>
              </media>
            
          </solution>
        </exercise>

      <!--Interaction
      End -->
      <!--Q#2-->
      <exercise id="exer-00006">
        <problem id="prob-00010">
          <para id="para-00035">What is the solution to the system of equations?</para>

        </problem>
        <solution id="sol-00010">
          <para id="para-00036">Compare your answer: </para>
          <para id="para-00037"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
      <para id="para-00038">For numbers 3 and 4, consider the system of equations:</para>
      <para id="para-00039"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para><para id="para-00040"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math></para><!--Q#3-->

        <exercise id="exer-00007">
          <problem id="prob-00011">
            <!--QUESTION
            IS OUTSIDE OF INTERACTION DUE TO DESMOS-->
            <para id="para-00041">On the same coordinate plane, graph the system of equations by hand.</para>
            <para id="para-00042"/>
          </problem>
          <solution id="sol-00011">
            <para id="para-00043">Compare your answer: </para>
            
              <media alt="A graph with a solid orange line increasing and a dashed blue line decreasing. The x- and y-axes are labeled, with a visible grid.">
                <image mime-type="image/jpeg" src="../../media/Algebra-1_02_04_06_03.jpg"/>
              </media>
            
          </solution>
        </exercise>

      <!--Interaction
      End -->
      <!--Q#3-->
      <exercise id="exer-00008">
        <problem id="prob-00012">
          <para id="para-00044">What is the solution to the system of equations?</para>

        </problem>
        <solution id="sol-00012">
          <para id="para-00045">Compare your answer: </para>
          <para id="para-00046"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
    </section>

    <section id="sect-00002">
      <title>Video: Graphing a System of Equations</title>
      <para id="para-00047">Watch the following video to learn more about writing systems of equations from graphs.</para>
