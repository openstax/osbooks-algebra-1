    <problem>
      <para> For the green dashed line what is the \(y\)-value of the \(y\)-intercept? </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! 9</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
