<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.2.5: Multiplying Polynomial Functions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01601</md:content-id>
    <md:title>6.2.5: Multiplying Polynomial Functions</md:title>
    <md:uuid>652b72c5-7fdc-4ec9-81e8-243e7264a076</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Cool Down Activity</title>
<para id="para-00001">For 1 - 4, use the following polynomial function to complete the multiplication. Use the "^" symbol to enter an exponent.</para>
<para id="para-00002"><quote id="quote-00001">\(f(x) = 3x + 2b\)
  \(g(x) = 3x - 2b\)
  \(h(x) = 7x + 2\)
  \(j(x) = 9x^2-12x+4\)</quote></para><!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00003">\(f(x) \cdot g(x) =\) _______</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00004">Compare your answer:</para>
    
    <para id="para-00005">\(9x^2-4b^2\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00006">\(f(x) \cdot f(x) = \) _______</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00007">Compare your answer:</para>
    
    <para id="para-00008">\(9x^2+12xb+4b^2\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00009">\(h(x) \cdot j(x) = \) _______</para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00010">Compare your answer:</para>
    
    <para id="para-00011">\(63x^3-66x^2+4x+8\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00012">\(h(x) \cdot h(x) =\) _______</para>
    </problem><solution id="sol-00004">
    
    
  
  <para id="para-00013">Compare your answer:</para>
    
    <para id="para-00014">\(49x^2+28x+4\)</para>
  
  </solution></exercise>
<!--Interaction End --></section>
</content>
