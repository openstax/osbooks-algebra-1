  <content>
  <section><title>Cool Down Activity</title>
<para>For 1 - 4, use the following polynomial function to complete the multiplication. Use the "^" symbol to enter an exponent.</para>
<para><quote>\(f(x) = 3x + 2b\)
  \(g(x) = 3x - 2b\)
  \(h(x) = 7x + 2\)
  \(j(x) = 9x^2-12x+4\)</quote></para><!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> \(f(x) \cdot g(x) =\) _______</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
  <para>Compare your answer:</para>
    
    <para> \(9x^2-4b^2\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> \(f(x) \cdot f(x) = \) _______</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
  <para>Compare your answer:</para>
    
    <para>\(9x^2+12xb+4b^2\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> \(h(x) \cdot j(x) = \) _______</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
  <para>Compare your answer:</para>
    
    <para> \(63x^3-66x^2+4x+8\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> \(h(x) \cdot h(x) =\) _______</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  
  <para>Compare your answer:</para>
    
    <para>\(49x^2+28x+4\)</para>
  
  </solution></exercise>
<!--Interaction End --></section>
