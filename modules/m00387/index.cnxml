    </problem>
    <solution>
      <para>Correct! 76</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#4-->
  <exercise data-content-id="06a7d7a7-7e8c-4da7-83bc-bc262305a054" data-problem-comparator="text" data-problem-type="input" data-solution="1/4">
    <problem>
      <para>What is the approximate slope of the green dashed line?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(-\frac14 \)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
