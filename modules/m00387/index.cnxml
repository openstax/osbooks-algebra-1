<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Interpreting Graphs of Systems of Equations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00387</md:content-id>
    <md:title>Interpreting Graphs of Systems of Equations</md:title>
    <md:uuid>766af223-a9ac-49c1-af47-88bab2959b18</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>
      <para id="para-00001">For questions 1 – 6, use the given graph and scenario:</para>
      <quote id="quote-00001">
            <media alt="Two graphed lines. Axes are labeled number of protein bars and number of oranges.">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_02_04_02_01.jpg" width="300px"/>
            </media>
          
        </quote>
        <quote id="quote-00002">A club is selling snacks at a track meet. Oranges cost $1 each and
        protein bars cost $4 each. They sell a total of 100 items, and collect $304.</quote>

      <!--Q#1-->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00003">What do you notice?</para>
        </problem>
        <solution id="sol-00001">
          
          <para id="para-00004">Compare your answer: </para>
          <para id="para-00005">Your answer may vary, but here is a sample.</para>
          <list id="list-00001">
            <item>There are two lines.</item>
            <item>It’s about snacks.</item>
            <item>The lines intersect.</item>
            <item>The point of intersection is labeled <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>32</m:mn><m:mo>,</m:mo><m:mn>68</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</item>
            <item>The sum of 32 and 68 is 100.</item>
          </list>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#2-->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00006">What do you wonder?</para>
        </problem>
        <solution id="sol-00002">
          
          <para id="para-00007">Compare your answer: </para>
          <para id="para-00008">Your answer may vary, but here is a sample.</para>
          <para id="para-00009">Things students may wonder:</para>
          <list id="list-00002">
            <item>What does each line mean?</item>
            <item>What does the point of intersection mean?</item>
            <item>Where can you see the information from the problem on the graph?</item>
          </list>
        </solution>
      </exercise>

      <exercise id="_0e4967e0-47aa-4365-a3a3-273c127972be" class="multiple-choice">
        <problem id="prob-00003">
          
          <para id="para-00010">What is the approximate <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>–intercept of the green dashed line?</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00011">76</para>
        </solution>
      </exercise>
      <exercise id="_06a7d7a7-7e8c-4da7-83bc-bc262305a054" class="multiple-choice">
        <problem id="prob-00004">
          
          <para id="para-00013">What is the approximate slope of the green dashed line?</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00014"><m:math display="inline"><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
        
        </solution>
      </exercise>
      <exercise id="_072f94e5-fbe6-4d9a-a082-1f5a8a31e472" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00016">What is the approximate <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math>-intercept of the orange solid line?</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00017">100</para>
          <para id="para-00018">the correct answer is 100.</para>
        </solution>
      </exercise>

      <!--Q#6-->
      <exercise id="exer-00003">
        <problem id="prob-00006">
          <para id="para-00019">What is the approximate slope of the orange solid line?</para>
        </problem>
        <solution id="sol-00006">
          
          <para id="para-00020">Compare your answer: </para>
          <para id="para-00021">Your answer may vary, but here is a sample. -1</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
    </section>
  </content>
</document>
