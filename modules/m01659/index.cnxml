<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.5.2: Factoring Trinomials with Leading Coefficients of 1</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01659</md:content-id>
    <md:title>6.5.2: Factoring Trinomials with Leading Coefficients of 1</md:title>
    <md:uuid>bd9e7a99-7a25-48a2-a992-d8a1efacd58f</md:uuid>
  </metadata>
  <content>
  <section><title>Activity </title>
<example><exercise>
  <problem>
    
    <para>Let’s factor this trinomial.</para>
    
    <para>\(t^2 + 14t + 24\)</para>
    
    <para>Think: 
      What are the factors of \(24\)?
      Which of these factors add to \(14\)?</para>
    
    <para>Here is the table we made in the previous activity:</para>
    
    <table class="os-raise-midsizetable">
      <tgroup cols="2"><tbody><row>
          <entry><emphasis>
            Factors of 24
         </emphasis> </entry><entry><emphasis>
            Sum of Factors
         </emphasis> </entry></row>
      <row>
          <entry>
            <para>1, 24</para>
          </entry>
          <entry>
            <para>\(1 + 24 = 25\)</para>
          </entry>
        </row>
        <row>
          <entry>
            <para>2, 12</para>
          </entry>
          <entry>
            <para>\(2 + 12 = 14\)</para>
          </entry>
        </row>
        <row>
          <entry>
            <para>3, 8</para>
          </entry>
          <entry>
            <para>\(3 + 8 = 11\)</para>
          </entry>
        </row>
        <row>
          <entry>
            <para>4, 6</para>
          </entry>
          <entry>
            <para>\(4 + 6 = 10\)</para>
          </entry>
        </row>
      </tbody></tgroup></table>
    
    
  
  <para>Write down your answers. Then select the <emphasis>solution</emphasis> button to compare your work.</para>
    
    <para>You can use the following video if you need some help</para>
    
    <media alt="Placeholder for Alt Text"><iframe width="660" height="371.4" src="https://k12.openstax.org/contents/raise/resources/4282f9c6585902ab44d89e3fa21ec7e9d5d984cd"/></media></problem><solution>
 
  <para>Compare your answers:</para>
  
  <para>\(2 \cdot 12 = 24\)
    \(2 + 12 = 14\)</para>
  
  <para>So, use \(2\) and \(12\) as the last terms of the binomials.</para>
  
  <para>\((t + 2)(t + 12)\)</para>

</solution></exercise> 

</example><para>Factor each trinomial. If the trinomial cannot be factored, write “prime.”</para>

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(9m + m^2 + 18\)</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>\((m + 3)(m + 6)\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(a^2 − 11ab + 10b^2\)</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>\((a - b)(a - 10b)\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(u^2 - 9uv - 12v^2\)</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>prime</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(5p − 6 + p^2\)</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>\((p − 1)(p + 6)\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(m^2 − 64mn − 65n^2\)</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>\((m + n)(m − 65n)\)</para>
  
  </solution></exercise>
<!--Interaction End -->

