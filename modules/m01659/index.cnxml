                      <m:mo>−</m:mo>
                      <m:mn>2</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>−</m:mo>
                      <m:mn>15</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd>
                      <m:mrow>
                        <m:mo>(</m:mo>
                        <m:mrow>
                          <m:mi>x</m:mi>
                          <m:mo>+</m:mo>
                          <m:mn>4</m:mn>
                        </m:mrow>
                        <m:mo>)</m:mo>
                      </m:mrow>
                      <m:mrow>
                        <m:mo>(</m:mo>
                        <m:mrow>
                          <m:mi>x</m:mi>
                          <m:mo>−</m:mo>
                          <m:mn>3</m:mn>
                        </m:mrow>
                        <m:mo>)</m:mo>
                      </m:mrow>
                      <m:mspace width="15em"/>
                      <m:mrow>
                        <m:mo>(</m:mo>
                        <m:mrow>
                          <m:mi>x</m:mi>
                          <m:mo>−</m:mo>
                          <m:mn>5</m:mn>
                        </m:mrow>
                        <m:mo>)</m:mo>
                      </m:mrow>
                      <m:mrow>
                        <m:mo>(</m:mo>
                        <m:mrow>
                          <m:mi>x</m:mi>
                          <m:mo>+</m:mo>
                          <m:mn>3</m:mn>
                        </m:mrow>
                        <m:mo>)</m:mo>
                      </m:mrow>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd>
                      <m:mtext>opposite signs</m:mtext>
                      <m:mspace width="15em"/>
                      <m:mtext>opposite signs</m:mtext>
                    </m:mtd>
