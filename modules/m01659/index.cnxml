                          <m:mo>+</m:mo>
                          <m:mn>3</m:mn>
                        </m:mrow>
                        <m:mo>)</m:mo>
                      </m:mrow>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd>
                      <m:mtext>opposite signs</m:mtext>
                      <m:mspace width="15em"/>
                      <m:mtext>opposite signs</m:mtext>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
              </m:mrow>
            </m:mrow>
            <m:annotation-xml encoding="MathML-Content">
              <m:mrow>
                <m:mtable>
                  <m:mtr>
                    <m:mtd>
                      <m:mtable>
                        <m:mtr>
                          <m:mtd>
                            <m:msup>
                              <m:mi>x</m:mi>
                              <m:mn>2</m:mn>
                            </m:msup>
                            <m:mo>+</m:mo>
                            <m:mi>b</m:mi>
                            <m:mi>x</m:mi>
                            <m:mo>+</m:mo>
                            <m:mi>c</m:mi>
                          </m:mtd>
                        </m:mtr>
                        <m:mtr>
                          <m:mtd>
                            <m:mrow>
                              <m:mo>(</m:mo>
                              <m:mrow>
                                <m:mi>x</m:mi>
                                <m:mo>+</m:mo>
                                <m:mi>m</m:mi>
                              </m:mrow>
                              <m:mo>)</m:mo>
                            </m:mrow>
                            <m:mrow>
                              <m:mo>(</m:mo>
