                          <m:mo>−</m:mo>
                          <m:mn>3</m:mn>
                        </m:mrow>
                        <m:mo>)</m:mo>
                      </m:mrow>
                      <m:mspace width="15em"/>
                      <m:mrow>
                        <m:mo>(</m:mo>
