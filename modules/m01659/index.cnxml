                      </m:mtable>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd>
                      <m:mtext mathvariant="bold">When</m:mtext>
                      <m:mspace width="0.2em"/>
                      <m:mtext mathvariant="bold-italic">c</m:mtext>
                      <m:mspace width="0.2em"/>
                      <m:mtext mathvariant="bold">is positive,</m:mtext>
                      <m:mspace width="0.2em"/>
                      <m:mtext mathvariant="bold-italic">m</m:mtext>
                      <m:mspace width="0.2em"/>
                      <m:mtext mathvariant="bold">and</m:mtext>
                      <m:mspace width="0.2em"/>
                      <m:mtext mathvariant="bold-italic">n</m:mtext>
                      <m:mspace width="0.2em"/>
                      <m:mtext mathvariant="bold">have the same sign.</m:mtext>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd>
                      <m:mi>b</m:mi>
                      <m:mspace width="0.2em"/>
                      <m:mtext>positive</m:mtext>
                      <m:mspace width="16.5em"/>
                      <m:mi>b</m:mi>
                      <m:mspace width="0.2em"/>
                      <m:mtext>negative</m:mtext>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd>
                      <m:mi>m</m:mi>
                      <m:mo>,</m:mo>
                      <m:mi>n</m:mi>
                      <m:mspace width="0.2em"/>
                      <m:mtext>positive</m:mtext>
                      <m:mspace width="15em"/>
                      <m:mi>m</m:mi>
                      <m:mo>,</m:mo>
                      <m:mi>n</m:mi>
                      <m:mspace width="0.2em"/>
                      <m:mtext>negative</m:mtext>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd>
                      <m:msup>
                        <m:mi>x</m:mi>
                        <m:mn>2</m:mn>
                      </m:msup>
                      <m:mo>+</m:mo>
                      <m:mn>5</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>6</m:mn>
                      <m:mspace width="16em"/>
                      <m:msup>
                        <m:mi>x</m:mi>
                        <m:mn>2</m:mn>
                      </m:msup>
                      <m:mo>−</m:mo>
                      <m:mn>6</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>8</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd>
                      <m:mrow>
                        <m:mo>(</m:mo>
                        <m:mrow>
                          <m:mi>x</m:mi>
                          <m:mo>+</m:mo>
                          <m:mn>2</m:mn>
                        </m:mrow>
                        <m:mo>)</m:mo>
                      </m:mrow>
                      <m:mrow>
                        <m:mo>(</m:mo>
                        <m:mrow>
                          <m:mi>x</m:mi>
                          <m:mo>+</m:mo>
                          <m:mn>3</m:mn>
                        </m:mrow>
                        <m:mo>)</m:mo>
                      </m:mrow>
                      <m:mspace width="15em"/>
                      <m:mrow>
                        <m:mo>(</m:mo>
                        <m:mrow>
                          <m:mi>x</m:mi>
                          <m:mo>−</m:mo>
                          <m:mn>4</m:mn>
                        </m:mrow>
                        <m:mo>)</m:mo>
                      </m:mrow>
                      <m:mrow>
                        <m:mo>(</m:mo>
                        <m:mrow>
                          <m:mi>x</m:mi>
                          <m:mo>−</m:mo>
                          <m:mn>2</m:mn>
                        </m:mrow>
                        <m:mo>)</m:mo>
                      </m:mrow>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd>
                      <m:mtext>same signs</m:mtext>
                      <m:mspace width="16em"/>
                      <m:mtext>same signs</m:mtext>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd>
                      <m:mtext mathvariant="bold">When</m:mtext>
                      <m:mspace width="0.2em"/>
                      <m:mtext mathvariant="bold-italic">c</m:mtext>
                      <m:mspace width="0.2em"/>
                      <m:mtext mathvariant="bold">is negative,</m:mtext>
                      <m:mspace width="0.2em"/>
                      <m:mtext mathvariant="bold-italic">m</m:mtext>
                      <m:mspace width="0.2em"/>
                      <m:mtext mathvariant="bold">and</m:mtext>
                      <m:mspace width="0.2em"/>
                      <m:mtext mathvariant="bold-italic">n</m:mtext>
                      <m:mspace width="0.2em"/>
                      <m:mtext mathvariant="bold">have opposite signs.</m:mtext>
                    </m:mtd>
