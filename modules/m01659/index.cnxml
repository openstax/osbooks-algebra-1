                      </m:mrow>
                      <m:mrow>
                        <m:mo>(</m:mo>
                        <m:mrow>
                          <m:mi>x</m:mi>
                          <m:mo>−</m:mo>
                          <m:mn>3</m:mn>
                        </m:mrow>
                        <m:mo>)</m:mo>
                      </m:mrow>
                      <m:mspace width="15em"/>
                      <m:mrow>
                        <m:mo>(</m:mo>
                        <m:mrow>
                          <m:mi>x</m:mi>
                          <m:mo>−</m:mo>
                          <m:mn>5</m:mn>
                        </m:mrow>
                        <m:mo>)</m:mo>
                      </m:mrow>
                      <m:mrow>
                        <m:mo>(</m:mo>
                        <m:mrow>
                          <m:mi>x</m:mi>
                          <m:mo>+</m:mo>
                          <m:mn>3</m:mn>
