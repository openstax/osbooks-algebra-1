                      <m:mo>−</m:mo>
                      <m:mn>2</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>−</m:mo>
                      <m:mn>15</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd>
                      <m:mrow>
                        <m:mo>(</m:mo>
                        <m:mrow>
                          <m:mi>x</m:mi>
                          <m:mo>+</m:mo>
                          <m:mn>4</m:mn>
