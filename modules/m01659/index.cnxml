                  <m:mtr>
                    <m:mtd>
                      <m:msup>
                        <m:mi>x</m:mi>
                        <m:mn>2</m:mn>
                      </m:msup>
                      <m:mo>+</m:mo>
                      <m:mi>x</m:mi>
                      <m:mo>−</m:mo>
                      <m:mn>12</m:mn>
