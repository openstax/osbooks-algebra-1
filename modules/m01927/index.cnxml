      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00004">Predict the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts for function <m:math display="inline">
              <m:mrow>
                <m:mi>f</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>−</m:mo>
                <m:mn>5</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>

        </problem>
        <solution id="sol-00001">
          <para id="para-00005">Compare your answer:</para>
          <para id="para-00006"><m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts for function <m:math display="inline">
              <m:mrow>
                <m:mi>f</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>−</m:mo>
                <m:mn>3</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math> and <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>5</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <exercise id="_1020c828-3a99-4b32-a725-cbb8169c6330" class="multiple-choice">
        <problem id="prob-00002">

          <para id="para-00007">Predict the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-coordinate of the vertex
            for function <m:math display="inline">
              <m:mrow>
                <m:mi>f</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>−</m:mo>
                <m:mn>5</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00008">Correct! 1</para>
          <para id="para-00009">The correct answer is 1.</para>
        </solution>
      </exercise>

      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00003">
          <para id="para-00010">Predict the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts for function <m:math display="inline">
              <m:mrow>
                <m:mi>g</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mn>2</m:mn>
                <m:mi>x</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>−</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>

        </problem>
        <solution id="sol-00003">
          <para id="para-00011">Compare your answer:</para>
          <para id="para-00012"><m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts for function <m:math display="inline">
              <m:mrow>
                <m:mi>g</m:mi>
              </m:mrow>
            </m:math>: <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math> and <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>3</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <exercise id="ab355961-3067-4cca-b16d-6f61ee366c09" class="multiple-choice">
        <problem id="prob-00004">

          <para id="para-00013">Predict the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-coordinate of the vertex
            for function <m:math display="inline">
              <m:mrow>
                <m:mi>g</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mn>2</m:mn>
                <m:mi>x</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>−</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>.</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00014">Correct! 1.5</para>
          <para id="para-00015">The correct answer is: 1.5.</para>
        </solution>
      </exercise>

      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00005">
