      <section class="check-understanding" id="sect-00004">
        <exercise id="_5ed59c41-67c2-4432-9ec0-aad03fc8a7ce" class="multiple-choice">
          <problem id="prob-00006">
            
            <para id="para-00019">Predict the \(x\)-coordinate of the vertex for function \(h(x)=(x+4)(4-x)\).</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00020">Correct! 0</para>
            <para id="para-00021">The correct answer is 0.</para>
