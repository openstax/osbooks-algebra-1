  <content>
    <section>
      <list class="os-raise-noindent" type="enumerated">
        <item>The functions \(f\), \(g\), and \(h\) are given. Refer to these functions to complete questions a–f.</item>
      </list>
      <table class="os-raise-wideequaltable">
        <thead>
          <row>
            <entry>
              <emphasis>Equation</emphasis>
            </entry>
            <entry>
              <emphasis>\(x\)-intercept</emphasis>
            </entry>
            <entry>
              <emphasis>\(x\)-coordinate of the vertex</emphasis>
            </entry>
          </row>
        </thead>
        <tbody>
          <row>
            <entry>
              <para>\(f(x)=(x+3)(x-5)\)</para>
            </entry>
            <entry>
              <list class="os-raise-noindent" type="enumerated">
                <item> _____ </item>
              </list>
            </entry>
            <entry>
              <list class="os-raise-noindent" start="2" type="enumerated">
                <item> _____ </item>
              </list>
            </entry>
          </row>
          <row>
            <entry>
              <para>\(g(x)=2x(x-3)\)</para>
            </entry>
            <entry>
              <list class="os-raise-noindent" start="3" type="enumerated">
                <item> _____ </item>
              </list>
            </entry>
            <entry>
              <list class="os-raise-noindent" start="4" type="enumerated">
                <item> _____ </item>
              </list>
            </entry>
          </row>
          <row>
            <entry>
              <para>\(h(x)=(x+4)(4-x)\)</para>
            </entry>
            <entry>
              <list class="os-raise-noindent" start="5" type="enumerated">
                <item> _____ </item>
              </list>
            </entry>
            <entry>
              <list class="os-raise-noindent" start="6" type="enumerated">
                <item> _____ </item>
              </list>
            </entry>
          </row>
        </tbody>
      </table>
      <!--Text Entry Interaction Start -->
      <exercise>
        <problem>
          <para> Predict the \(x\)-intercepts for function \(f(x)=(x+3)(x-5)\).</para>
        </problem>
        <solution>
          <para>Enter your answer here:</para>
          <para>Compare your answer:</para>
          <para>\(x\)-intercepts for function \(f\): \((-3,0)\) and \((5,0)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <section class="check-understanding">
        <title>Activity</title>
        <exercise id="1020c828-3a99-4b32-a725-cbb8169c6330" class="multiple-choice">
          <problem>
            <para>Enter your answer here:</para>
            <para> Predict the \(x\)-coordinate of the vertex for function \(f(x)=(x+3)(x-5)\).</para>
          </problem>
          <solution>
            <para>Correct! 1</para>
            <para>The correct answer is 1.</para>
          </solution>
        </exercise>
      </section>
      <!--Text Entry Interaction Start -->
      <exercise>
        <problem>
          <para> Predict the \(x\)-intercepts for function \(g(x)=2x(x-3)\).</para>
        </problem>
        <solution>
          <para>Enter your answer here:</para>
          <para>Compare your answer:</para>
          <para> \(x\)-intercepts for function \(g\): \((0,0)\) and \((3,0)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <section class="check-understanding">
        <exercise id="ab355961-3067-4cca-b16d-6f61ee366c09" class="multiple-choice">
          <problem>
            <para>Enter your answer here:</para>
            <para> Predict the \(x\)-coordinate of the vertex for function \(g(x)=2x(x-3)\).</para>
          </problem>
          <solution>
            <para>Correct! 1.5</para>
            <para>The correct answer is: 1.5.</para>
          </solution>
        </exercise>
      </section>
      <!--Text Entry Interaction Start -->
      <exercise>
        <problem>
          <para> Predict the \(x\)-intercepts for function \(h(x)=(x+4)(4-x)\).</para>
        </problem>
        <solution>
          <para>Enter your answer here:</para>
          <para>Compare your answer:</para>
          <para>\(x\)-intercepts for function \(h\): \((-4,0)\) and \((4,0)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <section class="check-understanding">
        <exercise id="5ed59c41-67c2-4432-9ec0-aad03fc8a7ce" class="multiple-choice">
          <problem>
            <para>Enter your answer here:</para>
            <para> Predict the \(x\)-coordinate of the vertex for function \(h(x)=(x+4)(4-x)\).</para>
          </problem>
          <solution>
            <para>Correct! 0</para>
            <para>The correct answer is 0.</para>
          </solution>
        </exercise>
      </section>
      <div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>
      <example>
        <exercise>
          <problem>
            <para>Use the graphing tool or technology outside the course. Graph the functions \(f\), \(g\), and \(h\): 
        
        \(f(x)=(x+3)(x-5)\)
        \(g(x)=2x(x-3)\)
        \(h(x)=(x+4)(4-x)\)
      </para>
            <para>Use the graphs to check your predictions. Then select the <emphasis>solution</emphasis> button to compare your work. </para>
          </problem>
          <solution>
            <para>Compare your answer:</para>
            <para>
              <figure>
                <media alt="3 graphs f, g, h shown on the same coordinate plane.">
                  <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_13_06_01.svg"/>
                </media>
              </figure>
            </para>
          </solution>
        </exercise>
      </example>
      <example>
        <exercise>
          <problem>
            <para>Without using technology, sketch a graph that represents the equation \(y=(x-7)(x+11)\) and that shows the \(x\)-intercepts and the vertex. Think about how to find the \(y\)-coordinate of the vertex. Be prepared to explain your reasoning.</para>
            <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work. </para>
          </problem>
          <solution>
            <para>Compare your answer:</para>
            <para>The \(x\)-intercepts for \((x-7)(x+11)\) are at \(x=7\) and \(x=-11\). The vertex for \((x-7)(x+11)\) is halfway between the \(x\)-intercepts, at \(x=-2\). If the \(x\)-coordinate of the vertex is -2, then the \(y\)-value is \((-2,-7)(-2+11)\) or -81. The vertex is at \((-2,81)\). The \(y\)-value when \(x=0\) is \((0-7)(0+11)\), which is -77. The \(y\)-intercept is \((0,-77)\).</para>
            <para>
              <figure>
                <media alt="Graph on coordinate plane.">
                  <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_13_06_02.svg"/>
                </media>
              </figure>
            </para>
          </solution>
        </exercise>
      </example>
