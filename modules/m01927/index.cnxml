      <exercise id="_5ed59c41-67c2-4432-9ec0-aad03fc8a7ce" class="multiple-choice">
        <problem id="prob-00006">

          <para id="para-00019">Predict the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-coordinate of the vertex
            for function <m:math display="inline">
              <m:mrow>
                <m:mi>h</m:mi>
