      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00004">Predict the \(x\)-intercepts for function \(f(x)=(x+3)(x-5)\).</para>
          
        </problem>
        <solution id="sol-00001">
          <para id="para-00005">Compare your answer:</para>
          <para id="para-00006">\(x\)-intercepts for function \(f\): \((-3,0)\) and \((5,0)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <section class="check-understanding" id="sect-00002">
        <title>Activity</title>
        <exercise id="_1020c828-3a99-4b32-a725-cbb8169c6330" class="multiple-choice">
          <problem id="prob-00002">
            
            <para id="para-00007">Predict the \(x\)-coordinate of the vertex for function \(f(x)=(x+3)(x-5)\).</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00008">Correct! 1</para>
            <para id="para-00009">The correct answer is 1.</para>
          </solution>
        </exercise>
      </section>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00003">
          <para id="para-00010">Predict the \(x\)-intercepts for function \(g(x)=2x(x-3)\).</para>
          
        </problem>
        <solution id="sol-00003">
          <para id="para-00011">Compare your answer:</para>
          <para id="para-00012">\(x\)-intercepts for function \(g\): \((0,0)\) and \((3,0)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <section class="check-understanding" id="sect-00003">
        <exercise id="ab355961-3067-4cca-b16d-6f61ee366c09" class="multiple-choice">
          <problem id="prob-00004">
            
            <para id="para-00013">Predict the \(x\)-coordinate of the vertex for function \(g(x)=2x(x-3)\).</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00014">Correct! 1.5</para>
            <para id="para-00015">The correct answer is: 1.5.</para>
          </solution>
        </exercise>
      </section>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00005">
          <para id="para-00016">Predict the \(x\)-intercepts for function \(h(x)=(x+4)(4-x)\).</para>
          
        </problem>
        <solution id="sol-00005">
          <para id="para-00017">Compare your answer:</para>
          <para id="para-00018">\(x\)-intercepts for function \(h\): \((-4,0)\) and \((4,0)\)</para>
        </solution>
