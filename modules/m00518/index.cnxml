          <problem>
            <para>Write the inequality on a number line.</para>
            <para>Write down your answer, then select the <emphasis>solution</emphasis> button to
              compare your work.</para>
          </problem>
          <solution>
            <para>Compare your answer:</para>
            
              <media
                alt="A number line is shown. There is an open circle on &#10;–3. The number line to the right of –3 is highlighted.&#10;">
                <image mime-type="image/jpeg" src="../../media/Algebra-1_02_11_05_04.jpg" />
              </media>
            
          </solution>
        </exercise>

        <!--Interaction
        End -->
        <!-- END CLICK TO REVEAL NO TEXTBOX -->
        <!--Text
        Entry Interaction Start -->
        <!--Q
        #2-->
        <exercise>
          <problem>
            <para>Write the inequality in interval notation.</para>
          </problem>
          <solution>
            <para>Write down your answer, then select the <emphasis>solution</emphasis> button to
              compare your work.</para>
            <para>Compare your answer: \((-3, ∞)\)</para>
          </solution>
        </exercise>
        <!--Interaction
        End -->

        <para>For questions 3 and 4 use the following inequality:</para>
        <para>
          <quote>\( x ≤ 5 \)</quote>
       </para>
        <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->
