  <content>
  <section><title>Activity</title>
<!--Text Entry Interaction Start -->
<para>Work with a partner to match each of the following inequalities to its correct number line.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="80a6eae9-01f2-4a2f-a1a5-190686f52e56" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1-->
  <exercise data-content-id="82b71fe3-ddfa-494d-adfd-b921d7eba72d" data-problem-type="multiplechoice" data-solution="x≥2" data-solution-options="[&quot;x&lt;2&quot;, &quot;x≥2&quot;, &quot;x&gt;2&quot;, &quot;x≤2&quot;]">
    <problem>
      <para> <figure><media alt="A number line is shown. There is a closed circle on 2. The number line to the right of 2 is highlighted."><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/54abcd7f180a4a231f0c56939b9b80cb59e7937c"/></media></figure></para>
      </problem>
    <solution>
      <para>Correct! \( x ≥ 2 \)</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Q2-->
  <exercise data-content-id="6a989b8b-f397-4c61-a70a-db4bb2a5eb49" data-problem-type="multiplechoice" data-solution="x&lt;2" data-solution-options="[&quot;x&lt;2&quot;, &quot;x≥2&quot;, &quot;x&gt;2&quot;, &quot;x≤2&quot;]">
    <problem>
      <para> <figure><media alt=" A number line is shown. There is an open circle on 2. The number line to the left of 2 is highlighted.&#10;          "><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/2f4fe0101da319082dafcc0d4270b658c7896b6c"/></media></figure></para>
      </problem>
    <solution>
      <para>Correct! \( x &lt; 2 \)</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Q3-->
  <exercise data-content-id="0a3fd630-41ba-4b06-930e-815bb5fd145e" data-problem-type="multiplechoice" data-solution="x&gt;2" data-solution-options="[&quot;x&lt;2&quot;, &quot;x≥2&quot;, &quot;x&gt;2&quot;, &quot;x≤2&quot;]">
    <problem>
      <para> <figure><media alt="A number line is shown. There is an open circle on 2. The number line to the right of 2 is highlighted."><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/eb89a6cc2c34dfae83f6532ba5c78296deda7a46"/></media></figure></para>
      </problem>
    <solution>
      <para>Correct! \( x &gt; 2 \)</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Q4-->
  <exercise data-content-id="08fc4001-c7f5-4f2c-a717-bb0201880022" data-problem-type="multiplechoice" data-solution="x≤2" data-solution-options="[&quot;x&lt;2&quot;, &quot;x≥2&quot;, &quot;x&gt;2&quot;, &quot;x≤2&quot;]">
    <problem>
      <para> <figure><media alt="A number line is shown. There is a closed circle on 2. The number line to the left of 2 is highlighted."><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/e0a6a95355863d5297d304b9ef6e7e16b7b75709"/></media></figure></para>
      </problem>
    <solution>
      <para>Correct! \( x ≤ 2 \)</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
