        <exercise>
          <problem>
            <para>Write the inequality in interval notation.</para>
          </problem>
          <solution>
            <para>Write down your answer, then select the <emphasis>solution</emphasis> button to
              compare your work.</para>
            <para>Compare your answer: \((∞, 5]\)</para>
          </solution>
        </exercise>
        <!--Interaction
        End -->

        <exercise>
          <problem>
            <para>Write the inequality on a number line.</para>
            <para>Write down your answer, then select the <emphasis>solution</emphasis> button to
              compare your work.</para>
          </problem>
