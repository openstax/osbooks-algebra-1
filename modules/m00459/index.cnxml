<!-- END ACTIVITY INPUT 1 TRY -->
<para>For 4 - 6, use the following equation:</para>
<blockquote>
  <para>Equation A: \( 4x+y=1\) </para>
</blockquote>
<!-- BEGIN TEXT ENTRY WITH REVEAL -->
<!--Q4-->
<exercise>
  <problem>
    <para>Multiply the equation by 2, show the resulting equivalent equation, and label it A1.</para>
    </problem><solution>
    
    <para>Enter your answer here: </para>
  <para>Compare your answer:</para>
    <para> \(2(4x+y=1)=8x+2y=2\)</para>
  </solution></exercise>
<!--Interaction End -->
<!-- END TEXT ENTRY WITH REVEAL -->
<!-- BEGIN TEXT ENTRY WITH REVEAL -->
<!--Q5-->
<exercise>
  <problem>
    <para>Multiply the equation by -5, show the resulting equivalent equation, and label it A2.</para>
    </problem><solution>
    
    <para>Enter your answer here: </para>
  <para>Compare your answer:</para>
    <para> \(-5(4x+y=1)=-20x-5y=-5\)</para>
  </solution></exercise>
<!--Interaction End -->
<!-- END TEXT ENTRY WITH REVEAL -->
<!-- BEGIN TEXT ENTRY WITH REVEAL -->
<!--Q6-->
<exercise>
  <problem>
    <para>Multiply the equation by \(\frac12,\) show the resulting equivalent equation, and label it A3.</para>
    </problem><solution>
    
    <para>Enter your answer here: </para>
  <para>Compare your answer:</para>
    <para> \(\frac12(4x+y=1)=2x+\frac12y=\frac12\)</para>
  </solution></exercise>
<!--Interaction End -->
<!-- END TEXT ENTRY WITH REVEAL -->
<para>For 7 - 9, use the following equations:</para>
<blockquote>
  <para>The new equations A1, A2, and A3 and Equation B:
    \(x+2y=9 \)</para>
</blockquote>
