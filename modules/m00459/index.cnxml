<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Multiplying Equations by a Number</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00459</md:content-id>
    <md:title>Multiplying Equations by a Number</md:title>
    <md:uuid>7d3e9474-1ba5-40cc-b9d1-63d09c900459</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>
      <note id="note-00001">
      <para id="para-00001">Access the <link url="https://openstax.org/r/desmos-guide">Desmos
        guide PDF</link> for tips on solving problems with the Desmos graphing calculator.</para>
        </note>

      <para id="para-00002">Consider two equations in a system:</para>

      <para id="para-00003">
        <m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo>
          <m:mtable>
            <m:mtr>
              <m:mtd columnalign="center"><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mtd><m:mtd><m:mtext>Equation A</m:mtext></m:mtd>
      </m:mtr>
      <m:mtr>
        <m:mtd columnalign="center"><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mtd><m:mtd><m:mtext>Equation B</m:mtext></m:mtd>
      </m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para>
      <para id="para-00004"/>

      <!--BEGIN
      ADD DESMOS INTERATIVE-->
      
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00005">Use the graphing tool or technology outside the course. Graph the system of equations
            using the Desmos tool below.</para>

        </problem>
        <solution id="sol-00001">
          <para id="para-00007">Compare your answer: </para>
          
            <media alt="Graph showing two intersecting lines: a blue line with a gentle, negative slope passing through (9, 0) and a black line with a steep, negative slope passing through (0, 1), on an x-y coordinate plane.">
              <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_08_02_01.svg"/>
            </media>
          
        </solution>
      </exercise>
    
      <media alt="insert alt text">
      <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
      </media>
        <!--END
      ADD DESMOS INTERATIVE-->

      <exercise id="b25bdea9-11a6-4084-ae63-c8f9083383e5" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00008">What is the <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> value?</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00009">-1</para>
          </solution>
        </exercise>

      <!-- END ACTIVITY INPUT 1 TRY -->
        <exercise id="d081b2d4-3b41-4079-b5aa-2cefb5eeea64" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00011">What is the <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> value?</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00012">5</para>
          </solution>
        </exercise>

      <!-- END ACTIVITY INPUT 1 TRY -->
      <para id="para-00014">For 4 - 6, use the following equation:</para>
      <quote id="quote-00001">Equation A: <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math> </quote>

      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q4-->
      <exercise id="exer-00002">
        <problem id="prob-00004">
          <para id="para-00016">Multiply the equation by 2, show the resulting equivalent equation, and label it A1.</para>
        </problem>
        <solution id="sol-00004">

          <para id="para-00017">Compare your answer: </para>
          <para id="para-00018"><m:math><m:mrow><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q5-->
      <exercise id="exer-00003">
        <problem id="prob-00005">
          <para id="para-00019">Multiply the equation by -5, show the resulting equivalent equation, and label it
            A2.</para>
        </problem>
        <solution id="sol-00005">

          <para id="para-00020">Compare your answer: </para>
          <para id="para-00021"><m:math><m:mrow><m:mo>–</m:mo><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo>–</m:mo><m:mn>20</m:mn><m:mi>x</m:mi><m:mo>–</m:mo><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>–</m:mo><m:mn>5</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q6-->
      <exercise id="exer-00004">
        <problem id="prob-00006">
          <para id="para-00022">Multiply the equation by <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>,</m:mo></m:mrow></m:math> show the resulting equivalent equation, and
            label it A3.</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00023">Compare your answer: </para>
          <para id="para-00024"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <para id="para-00025">For 7 - 9, use the following equations:</para>
      <quote id="quote-00002">The new equations A1, A2, and A3 and Equation B: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math></quote>

      <!--BEGIN
      ADD DESMOS INTERATIVE-->


      <exercise id="exer-00005">
        <problem id="prob-00007">
          <para id="para-00027">Use the graphing tool or technology outside the course. Graph the system of equations
            A1 and B using the Desmos tool below.</para>

        </problem>
        <solution id="sol-00007">
          <para id="para-00029">Compare your answer: </para>
          
            <media alt="Graph of a system of equations. The orange line represents an equation with a steeply negative slope. The green line also has a negative slope but is less steep. The lines intersect in the third quadrant.">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_02_08_02_02.jpg"/>
            </media>
          
        </solution>
      </exercise>


        <!--END
      ADD DESMOS INTERATIVE-->
      <!--BEGIN
      ADD DESMOS INTERATIVE-->

      <exercise id="exer-00006">
        <problem id="prob-00008">
          <para id="para-00030">Use the graphing tool or technology outside the course. Graph the system of equations
            A2 and B using the Desmos tool below.</para>
        <media alt="insert alt text">
        <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
        </media>

        </problem>
        <solution id="sol-00008">
          <para id="para-00032">Compare your answer: </para>
          
            <media alt="Graph of a system of equations. The orange line represents an equation with a steeply negative slope. The green line also has a negative slope but is less steep. The lines intersect in the third quadrant.">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_02_08_02_03.jpg" width="275px"/>
            </media>
          
        </solution>
      </exercise>

      <media alt="insert alt text">
      <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
      </media>
        <!--END
      ADD DESMOS INTERATIVE-->
      <!--BEGIN
      ADD DESMOS INTERATIVE-->

      <exercise id="exer-00007">
        <problem id="prob-00009">
          <para id="para-00033">Use the graphing tool or technology outside the course. Graph the system of equations
            A3 and B using the Desmos tool below.</para>

        </problem>
        <solution id="sol-00009">
          <para id="para-00035">Compare your answer: </para>
          
            <media alt="Graph of a system of equations. The orange line represents an equation with a steeply negative slope. The green line also has a negative slope but is less steep. The lines intersect in the third quadrant.">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_02_08_02_04.jpg" width="275px"/>
            </media>
          
        </solution>
      </exercise>

      <media alt="insert alt text">
      <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
      </media>
        <!--END
      ADD DESMOS INTERATIVE-->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q10-->
      <exercise id="exer-00008">
        <problem id="prob-00010">
          <para id="para-00036">Make a couple of observations about the graphs of Equations A1, A2, and A3.</para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00037">Compare your answer: </para>
          <para id="para-00038">Your answer may vary, but here is a sample. No new graphs appeared. The graphs of
            the equivalent equations are identical to that of Equation A. The graphs all intersect
            the graph of Equation B at <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>–</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
    </section>
  </content>
</document>