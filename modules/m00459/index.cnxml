  <content>
    <section>
      <div class="os-raise-familysupport">
        <para>Access the <link url="https://k12.openstax.org/contents/raise/resources/b62c9150250bf52d6cc37569213ab516e0090dca">Desmos guide PDF</link> for tips on solving problems with the Desmos graphing calculator.</para>
      </div>
      <para>Consider two equations in a system:</para>
      <div class="os-raise-d-flex os-raise-justify-content-between">
        <para>\( \left\{ \begin{array}{c l} 4x+ y=1\\ x+2y=9 \end{array}\right. \)</para>
        <para>Equation AEquation B</para>
      </div>
      <!--BEGIN ADD DESMOS INTERATIVE-->
      <list class="os-raise-noindent" type="enumerated">
        <item>Use the graphing tool or technology outside the course. Graph the system of equations using the Desmos tool below. </item>
      </list>
      <example>
        <exercise>
          <problem>
            <!-- INSERT ANY VALID HTML HERE -->
            <!-- INSERT ANY VALID HTML HERE -->
            <para>When you have finished graphing, select the <emphasis>solution</emphasis> button to compare your work. </para>
          </problem>
          <solution>
            <para>Compare your answer:</para>
            <figure>
              <media alt="">
                <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_08_02_01.svg"/>
              </media>
            </figure>
          </solution>
        </exercise>
      </example>
      <div class="os-raise-ib-desmos-gc" data-schema-version="1.0"/>
      <!--END ADD DESMOS INTERATIVE-->
      <section class="check-understanding">
        <title>Warm Up Activity</title>
        <exercise id="b25bdea9-11a6-4084-ae63-c8f9083383e5" class="multiple-choice">
          <problem>
            <para>Enter your answer here:</para>
            <para>What is the \(x\) value?</para>
          </problem>
          <solution>
            <para>Correct! -1</para>
            <para>Nice try! The correct answer is -1.</para>
          </solution>
        </exercise>
      </section>
      <!-- END ACTIVITY INPUT 1 TRY -->
      <section class="check-understanding">
        <exercise id="d081b2d4-3b41-4079-b5aa-2cefb5eeea64" class="multiple-choice">
          <problem>
            <para>Enter your answer here:</para>
            <para>What is the \(y\) value?</para>
          </problem>
          <solution>
            <para>Correct! 5</para>
            <para>Nice try! The correct answer is 5.</para>
          </solution>
        </exercise>
      </section>
      <!-- END ACTIVITY INPUT 1 TRY -->
      <para>For 4 - 6, use the following equation:</para>
      <para>
        <quote>Equation A: \( 4x+y=1\) </quote>
      </para>
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q4-->
      <exercise>
        <problem>
          <para>Multiply the equation by 2, show the resulting equivalent equation, and label it A1.</para>
        </problem>
        <solution>
          <para>Enter your answer here: </para>
          <para>Compare your answer:</para>
          <para> \(2(4x+y=1)=8x+2y=2\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q5-->
      <exercise>
        <problem>
          <para>Multiply the equation by -5, show the resulting equivalent equation, and label it A2.</para>
        </problem>
        <solution>
          <para>Enter your answer here: </para>
          <para>Compare your answer:</para>
          <para> \(-5(4x+y=1)=-20x-5y=-5\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q6-->
      <exercise>
        <problem>
          <para>Multiply the equation by \(\frac12,\) show the resulting equivalent equation, and label it A3.</para>
        </problem>
        <solution>
          <para>Enter your answer here: </para>
          <para>Compare your answer:</para>
          <para> \(\frac12(4x+y=1)=2x+\frac12y=\frac12\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <para>For 7 - 9, use the following equations:</para>
      <para>
        <quote>The new equations A1, A2, and A3 and Equation B:
    \(x+2y=9 \)</quote>
      </para>
      <!--BEGIN ADD DESMOS INTERATIVE-->
