<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.6.1: Multiplying Equations by a Number</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00459</md:content-id>
    <md:title>2.6.1: Multiplying Equations by a Number</md:title>
    <md:uuid>7d3e9474-1ba5-40cc-b9d1-63d09c900459</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Warm Up Activity</title>
      <note id="note-00001">
      <para id="para-00001">Access the <link url="https://k12.openstax.org/contents/raise/resources/b62c9150250bf52d6cc37569213ab516e0090dca">Desmos
        guide PDF</link> for tips on solving problems with the Desmos graphing calculator.</para>
        </note>

      <para id="para-00002">Consider two equations in a system:</para>

      <para id="para-00003">\( \left\{ \begin{array}{c l} 4x+ y=1\\ x+2y=9 \end{array}\right. \)</para>
      <para id="para-00004">Equation AEquation B</para>

      <!--BEGIN
      ADD DESMOS INTERATIVE-->
      
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00005">Use the graphing tool or technology outside the course. Graph the system of equations
            using the Desmos tool below.</para>

          <para id="para-00006">When you have finished graphing, select the <emphasis>solution</emphasis> button to
            compare your work.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00007">Compare your answer:</para>
          
            <media alt="">
              <image mime-type="image/svg+xml" src="../../media/Algebra-1_02_08_02_01.svg"/>
            </media>
          
        </solution>
      </exercise>
    
      <media alt="">
      <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
      </media>
        <!--END
      ADD DESMOS INTERATIVE-->

      <exercise id="b25bdea9-11a6-4084-ae63-c8f9083383e5" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00008">What is the \(x\) value?</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00009">Correct! -1</para>
            <para id="para-00010">Nice try! The correct answer is -1.</para>
          </solution>
        </exercise>

      <!-- END ACTIVITY INPUT 1 TRY -->
        <exercise id="d081b2d4-3b41-4079-b5aa-2cefb5eeea64" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00011">What is the \(y\) value?</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00012">Correct! 5</para>
            <para id="para-00013">Nice try! The correct answer is 5.</para>
          </solution>
        </exercise>

      <!-- END ACTIVITY INPUT 1 TRY -->
      <para id="para-00014">For 4 - 6, use the following equation:</para>
      <para id="para-00015">
        <quote id="quote-00001">Equation A: \( 4x+y=1\) </quote>
     </para>
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q4-->
      <exercise id="exer-00002">
        <problem id="prob-00004">
          <para id="para-00016">Multiply the equation by 2, show the resulting equivalent equation, and label it A1.</para>
        </problem>
        <solution id="sol-00004">

          <para id="para-00017">Compare your answer:</para>
          <para id="para-00018">\(2(4x+y=1)=8x+2y=2\)</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q5-->
      <exercise id="exer-00003">
        <problem id="prob-00005">
          <para id="para-00019">Multiply the equation by -5, show the resulting equivalent equation, and label it
            A2.</para>
        </problem>
        <solution id="sol-00005">

          <para id="para-00020">Compare your answer:</para>
          <para id="para-00021">\(-5(4x+y=1)=-20x-5y=-5\)</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q6-->
      <exercise id="exer-00004">
        <problem id="prob-00006">
          <para id="para-00022">Multiply the equation by \(\frac12,\) show the resulting equivalent equation, and
            label it A3.</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00023">Compare your answer:</para>
          <para id="para-00024">\(\frac12(4x+y=1)=2x+\frac12y=\frac12\)</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
      <para id="para-00025">For 7 - 9, use the following equations:</para>
      <para id="para-00026">
        <quote id="quote-00002">The new equations A1, A2, and A3 and Equation B: \(x+2y=9 \)</quote>
     </para>
      <!--BEGIN
      ADD DESMOS INTERATIVE-->


      <exercise id="exer-00005">
        <problem id="prob-00007">
          <para id="para-00027">Use the graphing tool or technology outside the course. Graph the system of equations
            A1 and B using the Desmos tool below.</para>

          <para id="para-00028">When you have finished graphing, select the <emphasis>solution</emphasis> button to
            compare your work.</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00029">Compare your answer:</para>
          
            <media alt="graph of two lines that intersect at point negative one and five">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_02_08_02_02.jpg"/>
            </media>
          
        </solution>
      </exercise>


        <!--END
      ADD DESMOS INTERATIVE-->
      <!--BEGIN
      ADD DESMOS INTERATIVE-->

      <exercise id="exer-00006">
        <problem id="prob-00008">
          <para id="para-00030">Use the graphing tool or technology outside the course. Graph the system of equations
            A2 and B using the Desmos tool below.</para>
        <media alt="">
        <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
        </media>
          <para id="para-00031">When you have finished graphing, select the <emphasis>solution</emphasis> button to
            compare your work.</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00032">Compare your answer:</para>
          
            <media alt="graph of two lines that intersect at point negative one and five">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_02_08_02_03.jpg"/>
            </media>
          
        </solution>
      </exercise>

      <media alt="">
      <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
      </media>
        <!--END
      ADD DESMOS INTERATIVE-->
      <!--BEGIN
      ADD DESMOS INTERATIVE-->

      <exercise id="exer-00007">
        <problem id="prob-00009">
          <para id="para-00033">Use the graphing tool or technology outside the course. Graph the system of equations
            A3 and B using the Desmos tool below.</para>

          <para id="para-00034">When you have finished graphing, select the <emphasis>solution</emphasis> button to
            compare your work.</para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00035">Compare your answer:</para>
          
            <media alt="graph of two lines that intersect at point negative one and five">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_02_08_02_04.jpg"/>
            </media>
          
        </solution>
      </exercise>

      <media alt="">
      <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/>
      </media>
        <!--END
      ADD DESMOS INTERATIVE-->
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->
      <!--Q10-->
      <exercise id="exer-00008">
        <problem id="prob-00010">
          <para id="para-00036">Make a couple of observations about the graphs of Equations A1, A2, and A3.</para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00037">Compare your answer:</para>
          <para id="para-00038">Your answer may vary, but here is a sample. No new graphs appeared. The graphs of
            the equivalent equations are identical to that of Equation A. The graphs all intersect
            the graph of Equation B at \((-1,5)\).</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!-- END TEXT ENTRY WITH REVEAL -->
    </section>
