  <content>
  <section><title>Warm Up Activity</title>
<para>For questions 1 – 3, match each inequality to the meaning of a symbol within it.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="704a0f81-a45e-42bf-a352-887a929160f9" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q#-->
  <exercise data-content-id="5314b4a8-9916-43e2-8fe9-b836437b52a5" data-problem-type="multiplechoice" data-solution="greater than" data-solution-options="[&quot;less than or equal to&quot;, &quot;greater than&quot;, &quot;greater than or equal to&quot;]">
    <problem>
      <para>\( h &gt; 50 \)</para>
      </problem>
    <solution>
      <para>Correct! greater than</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#2-->
  <exercise data-content-id="b5b31a3c-89b1-4e25-8348-ba7a045c2ced" data-problem-type="multiplechoice" data-solution="less than or equal to" data-solution-options="[&quot;less than or equal to&quot;, &quot;greater than&quot;, &quot;greater than or equal to&quot;]">
    <problem>
      <para>\( h \leq 20 \)</para>
      </problem>
    <solution>
      <para>Correct! less than or equal to</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#3-->
  <exercise data-content-id="44ccedb4-59a0-4479-accf-337737c993a2" data-problem-type="multiplechoice" data-solution="greater than or equal to" data-solution-options="[&quot;less than or equal to&quot;, &quot;greater than&quot;, &quot;greater than or equal to&quot;]">
    <problem>
      <para>\( 30 \geq h \)</para>
      </problem>
    <solution>
      <para>Correct! greater than or equal to</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>
<!--Q#4-->
<exercise>
  <problem>
    <para> Is 25 a solution to any of the inequalities? Which one(s)? </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>Yes; 25 is a solution to \(30 \geq h\) because 30 is greater than or equal to 25.</para>
  </solution></exercise>
<!--Interaction End -->
<!--Q#5-->
<exercise>
  <problem>
    <para> Is 40 a solution to any of the inequalities? Which one(s)? </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>No; 40 is not a solution to any of the inequalities because 40 does not make any of the inequalities true when substituted in for \(h\).</para>
  </solution></exercise>
<!--Interaction End -->
<!--Q#6-->
<exercise>
  <problem>
    <para> Is 30 a solution to any of the inequalities? Which one(s)? </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>Yes; 30 is a solution to \(30 \geq h\).</para>
  </solution></exercise>
<!--Interaction End -->
</section>
