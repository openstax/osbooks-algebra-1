<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Understanding Inequality Symbols</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00496</md:content-id>
    <md:title>Understanding Inequality Symbols</md:title>
    <md:uuid>1d3b0476-ba7b-41cc-8928-bbee3f3fe412</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">
      <title>Warm Up</title>
      <para id="para-00001">For questions 1 – 3, match each inequality to the meaning of a symbol within it.</para>

      <exercise id="_5314b4a8-9916-43e2-8fe9-b836437b52a5" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00002"><m:math>
              <m:mrow>
                <m:mi>h</m:mi>
                <m:mo>></m:mo>
                <m:mn>50</m:mn>
              </m:mrow>
            </m:math></para>
          <list list-type="enumerated" number-style="lower-alpha" id="list-00001">
            <item><para id="para-00004">less than or equal to</para></item>
            <item><para id="para-00005">greater than</para></item>
            <item><para id="para-00006">greater than or equal to</para></item>
          </list>
        </problem>
        <solution id="sol-00001">
          <para id="para-00007">greater than</para>
        </solution>
      </exercise>
      <exercise id="b5b31a3c-89b1-4e25-8348-ba7a045c2ced" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00009"><m:math>
              <m:mrow>
                <m:mi>h</m:mi>
                <m:mo>≤</m:mo>
                <m:mn>20</m:mn>
              </m:mrow>
            </m:math></para>
          <list list-type="enumerated" number-style="lower-alpha" id="list-00002">
            <item><para id="para-00011">less than or equal to</para></item>
            <item><para id="para-00012">greater than</para></item>
            <item><para id="para-00013">greater than or equal to</para></item>
          </list>
        </problem>
        <solution id="sol-00002">
          <para id="para-00014">less than or equal to</para>
        </solution>
      </exercise>
      <exercise id="_44ccedb4-59a0-4479-accf-337737c993a2" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00016"><m:math>
              <m:mrow>
                <m:mn>30</m:mn>
                <m:mo>≥</m:mo>
                <m:mi>h</m:mi>
              </m:mrow>
            </m:math></para>
          <list list-type="enumerated" number-style="lower-alpha" id="list-00003">
            <item><para id="para-00018">less than or equal to</para></item>
            <item><para id="para-00019">greater than</para></item>
            <item><para id="para-00020">greater than or equal to</para></item>
          </list>
        </problem>
        <solution id="sol-00003">
          <para id="para-00021">greater than or equal to</para>
        </solution>
      </exercise>

      <!--Q#4-->
      <exercise id="exer-00001">
        <problem id="prob-00004">
          <para id="para-00023"> Is 25 a solution to any of the inequalities? Which one(s)?</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00024">Compare your answer: </para>

          <para id="para-00025">Yes; 25 is a solution to <m:math display="inline">
              <m:mrow>
                <m:mn>30</m:mn>
                <m:mo>≥</m:mo>
                <m:mi>h</m:mi>
              </m:mrow>
            </m:math> because 30 is greater than or equal to 25.</para>

        </solution>
      </exercise>
      <!--Interaction
      End -->


      <!--Q#5-->
      <exercise id="exer-00002">
        <problem id="prob-00005">
          <para id="para-00026"> Is 40 a solution to any of the inequalities? Which one(s)?</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00027">Compare your answer: </para>

          <para id="para-00028">No; 40 is not a solution to any of the inequalities because 40 does not make any of the inequalities true when substituted in for <m:math display="inline">
              <m:mrow>
                <m:mi>h</m:mi>
              </m:mrow>
            </m:math>.</para>

        </solution>
      </exercise>
      <!--Interaction
      End -->


      <!--Q#6-->
      <exercise id="exer-00003">
        <problem id="prob-00006">
          <para id="para-00029"> Is 30 a solution to any of the inequalities? Which one(s)?</para>
        </problem>
        <solution id="sol-00006">

          <para id="para-00031">Compare your answer: </para>

          <para id="para-00032">Yes; 30 is a solution to <m:math display="inline">
              <m:mrow>
                <m:mn>30</m:mn>
                <m:mo>≥</m:mo>
                <m:mi>h</m:mi>
              </m:mrow>
            </m:math>.</para>

        </solution>
      </exercise>
      <!--Interaction
      End -->
    </section>
  </content>
</document>