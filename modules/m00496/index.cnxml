<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.8.1: Understanding Inequality Symbols</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00496</md:content-id>
    <md:title>2.8.1: Understanding Inequality Symbols</md:title>
    <md:uuid>1d3b0476-ba7b-41cc-8928-bbee3f3fe412</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><para id="para-00001">For questions 1 – 3, match each inequality to the meaning of a symbol within it.</para>
<section class="check-understanding" id="sect-00002"><title>Warm Up Activity</title><exercise id="5314b4a8-9916-43e2-8fe9-b836437b52a5" class="multiple-choice" id="exer-00001"><problem id="prob-00001"><para id="para-00002">\( h > 50 \)</para>
      <para id="para-00003">Multiple Choice:</para><para id="para-00004">less than or equal to</para><para id="para-00005">greater than</para><para id="para-00006">greater than or equal to</para></problem><solution id="sol-00001"><para id="para-00007">Correct! greater than</para><para id="para-00008">The correct answer is greater than. </para></solution></exercise><exercise id="b5b31a3c-89b1-4e25-8348-ba7a045c2ced" class="multiple-choice" id="exer-00002"><problem id="prob-00002"><para id="para-00009">\( h \leq 20 \)</para>
      <para id="para-00010">Multiple Choice:</para><para id="para-00011">less than or equal to</para><para id="para-00012">greater than</para><para id="para-00013">greater than or equal to</para></problem><solution id="sol-00002"><para id="para-00014">Correct! less than or equal to</para><para id="para-00015">The correct answer is less than or equal to .</para></solution></exercise><exercise id="44ccedb4-59a0-4479-accf-337737c993a2" class="multiple-choice" id="exer-00003"><problem id="prob-00003"><para id="para-00016">\( 30 \geq h \)</para>
      <para id="para-00017">Multiple Choice:</para><para id="para-00018">less than or equal to</para><para id="para-00019">greater than</para><para id="para-00020">greater than or equal to</para></problem><solution id="sol-00003"><para id="para-00021">Correct! greater than or equal to</para><para id="para-00022">The correct answer is greater than or equal to.</para></solution></exercise></section>
<!--Q#4-->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00023"> Is 25 a solution to any of the inequalities? Which one(s)? </para>
    </problem><solution id="sol-00004">
    
    <para id="para-00024">Enter your answer here:</para>
  
  <para id="para-00025">Compare your answer:</para>
    
    <para id="para-00026">Yes; 25 is a solution to \(30 \geq h\) because 30 is greater than or equal to 25.</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Q#5-->
<exercise id="exer-00005">
  <problem id="prob-00005">
    <para id="para-00027"> Is 40 a solution to any of the inequalities? Which one(s)? </para>
    </problem><solution id="sol-00005">
    
    <para id="para-00028">Enter your answer here:</para>
  
  <para id="para-00029">Compare your answer:</para>
    
    <para id="para-00030">No; 40 is not a solution to any of the inequalities because 40 does not make any of the inequalities true when substituted in for \(h\).</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Q#6-->
<exercise id="exer-00006">
  <problem id="prob-00006">
    <para id="para-00031"> Is 30 a solution to any of the inequalities? Which one(s)? </para>
    </problem><solution id="sol-00006">
    
    <para id="para-00032">Enter your answer here:</para>
  
  <para id="para-00033">Compare your answer:</para>
    
    <para id="para-00034">Yes; 30 is a solution to \(30 \geq h\).</para>
  
  </solution></exercise>
<!--Interaction End -->
</section>
