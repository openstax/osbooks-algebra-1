<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>7.16.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02034</md:content-id>
    <md:title>7.16.5: Practice</md:title>
    <md:uuid>c100e938-ddc1-4efe-b586-46b0d2f01d79</md:uuid>
