    <item><link url="https://k12.openstax.org/contents/raise/resources/e74f7d80f09022fa6b9c315d74bf353470eccef2">180 day pacing</link></item>
    <item><link url="https://k12.openstax.org/contents/raise/resources/a2c59cc954a03bacc366c09a1f461a6e6f3e690b">165 day pacing</link></item>
</list>
