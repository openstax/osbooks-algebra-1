<exercise data-wait-for-event="RFM1">
  <problem>
    <title>Extending Your Thinking</title>
    <para>Refer to graph and table of the previous function \(T\) to answer the questions:</para>
    <para> Over what interval did the temperature decrease the most rapidly?</para>
    </problem><solution>
    
    <para>Write your answer here:</para>
  <para>Compare your answer:</para>
    <para>between 5 p.m. and 6 p.m. </para>
  </solution></exercise>
<!--End interaction-->

<exercise data-wait-for-event="RFM1">
  <problem>
    <para>Over what interval did the temperature increase the most rapidly?</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>between 3 p.m. and 4 p.m. </para>
  </solution></exercise>
<!--End interaction--></section>
