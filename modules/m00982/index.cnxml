      </entry>
            <entry>
        10
      </entry>
            <entry>
        11
      </entry>
            <entry>
        12
      </entry>
          </row>
          <row>
            <entry>
             <emphasis>
        \(T(h)\)
     </emphasis> 
            </entry>
            <entry>
        18
      </entry>
            <entry>
        19
      </entry>
            <entry>
        20
      </entry>
            <entry>
        20
      </entry>
            <entry>
        25
      </entry>
            <entry>
        23
      </entry>
            <entry>
        17
      </entry>
            <entry>
