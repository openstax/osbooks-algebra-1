<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Comparing Expressions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01794</md:content-id>
    <md:title>Comparing Expressions</md:title>
    <md:uuid>6c3bf253-8f7e-4ed6-a615-be145d63f009</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001"><title>Warm Up</title>
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00001">List these quantities in order, from least to greatest, without evaluating each expression. Be prepared to explain your reasoning.</para>
          <para id="para-00002"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:msup></m:mrow></m:math></para>
          <para id="para-00003"><m:math><m:mrow><m:msup><m:mn>10</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
          <para id="para-00004"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mn>9</m:mn></m:msup></m:mrow></m:math></para>
          <para id="para-00005"><m:math><m:mrow><m:msup><m:mn>9</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
          <para id="para-00006"/>
        </problem>
        <solution id="sol-00001">
          <para id="para-00007">Compare your answer: </para>
          <para id="para-00008">The correct order is <m:math display="inline"><m:mrow><m:msup><m:mn>9</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:msup><m:mn>10</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:msup><m:mn>2</m:mn><m:mn>9</m:mn></m:msup></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:msup><m:mn>2</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:msup></m:mrow></m:math>. This would be 18, 100, 512, 1024.</para>
        </solution>
      </exercise>
    </section>
  </content>
</document>