<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002">Which expression best represents the average rate of change in solar cost between 1977 and 1987?</para>
    
    <para id="para-00003">\(
        p(10)−p(0)\)</para>
      
      <para id="para-00004">\(p(10)\)</para>
      
      <para id="para-00005">\(\frac{p(10)-p(0)}{10−0}\)</para>
      
      <para id="para-00006">\(\frac{
        p(10)}{p(0)}\)</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00007">Compare your answer:</para>
    
    <para id="para-00008">\(\frac{p(10)-p(0)}{10−0}\)</para>
  
  </solution></exercise>
<!--Interaction End --></section>
