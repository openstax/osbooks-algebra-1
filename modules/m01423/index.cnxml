<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.10.1: Calculate an Average Rate of Change from Two Points</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01423</md:content-id>
    <md:title>5.10.1: Calculate an Average Rate of Change from Two Points</md:title>
    <md:uuid>2d56f810-ac0b-4654-ae4d-5ac8c6f3ab45</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Warm Up</title>
      <para id="para-00001">Let <m:math display="inline">
          <m:mrow>
            <m:mi>p</m:mi>
          </m:mrow>
        </m:math> be the function that gives the cost <m:math
          display="inline">
          <m:mrow>
            <m:mi>p</m:mi>
            <m:mo stretchy="false">(</m:mo>
            <m:mi>t</m:mi>
            <m:mo stretchy="false">)</m:mo>
          </m:mrow>
        </m:math>, in dollars, of
        producing 1 watt of solar energy <m:math display="inline">
          <m:mrow>
            <m:mi>t</m:mi>
          </m:mrow>
        </m:math><emphasis> </emphasis>years after
        1977. Here is a table showing the values of <m:math display="inline">
          <m:mrow>
            <m:mi>p</m:mi>
          </m:mrow>
        </m:math><emphasis> </emphasis>from 1977 to
        1987.</para>
      <table class="unnumbered os-raise-skinnytable" id="table-00001">
        <tgroup cols="2">
<tbody>
            <row>
              <entry><emphasis><m:math>
                    <m:mrow>
                      <m:mi>t</m:mi>
                    </m:mrow>
                  </m:math></emphasis></entry>
              <entry><emphasis><m:math>
                    <m:mrow>
                      <m:mi>p</m:mi>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mi>t</m:mi>
                      <m:mo stretchy="false">)</m:mo>
                    </m:mrow>
                  </m:math></emphasis></entry>
            </row>
            <row>
              <entry> 0 </entry>
              <entry> 80 </entry>
            </row>
            <row>
              <entry> 1 </entry>
              <entry> 60 </entry>
            </row>
            <row>
              <entry> 2 </entry>
              <entry> 45 </entry>
            </row>
            <row>
              <entry> 3 </entry>
              <entry> 33.75 </entry>
            </row>
            <row>
              <entry> 4 </entry>
              <entry> 25.31 </entry>
            </row>
            <row>
              <entry> 5 </entry>
              <entry> 18.98 </entry>
            </row>
            <row>
              <entry> 6 </entry>
              <entry> 14.24 </entry>
            </row>
            <row>
              <entry> 7 </entry>
              <entry> 10.68 </entry>
            </row>
            <row>
              <entry> 8 </entry>
              <entry> 8.01 </entry>
            </row>
            <row>
              <entry> 9 </entry>
              <entry> 6.01 </entry>
            </row>
            <row>
              <entry> 10 </entry>
              <entry> 4.51 </entry>
            </row>
          </tbody>
        </tgroup>
      </table>

      <!--Text
      Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002">Which expression best represents the average rate of change in solar
            cost between 1977 and 1987?</para>

          <para id="para-00003">1. <m:math>
              <m:mrow>
                <m:mi>p</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>10</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mi>−</m:mi>
                <m:mi>p</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
          <para id="para-00004">2. <m:math>
              <m:mrow>
                <m:mi>p</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>10</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
          <para id="para-00005">3. <m:math>
              <m:mrow>
                <m:mfrac>
                  <m:mrow>
                    <m:mi>p</m:mi>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mn>10</m:mn>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mo>−</m:mo>
                    <m:mi>p</m:mi>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mn>0</m:mn>
                    <m:mo stretchy="false">)</m:mo>
                  </m:mrow>
                  <m:mrow>
                    <m:mn>10</m:mn>
                    <m:mi>−</m:mi>
                    <m:mn>0</m:mn>
                  </m:mrow>
                </m:mfrac>
              </m:mrow>
            </m:math></para>
          <para id="para-00006">4. <m:math>
              <m:mrow>
                <m:mfrac>
                  <m:mrow>
                    <m:mi>p</m:mi>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mn>10</m:mn>
                    <m:mo stretchy="false">)</m:mo>
                  </m:mrow>
                  <m:mrow>
                    <m:mi>p</m:mi>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mn>0</m:mn>
                    <m:mo stretchy="false">)</m:mo>
                  </m:mrow>
                </m:mfrac>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00001">


          <para id="para-00007">Compare your answer: </para>

          <para id="para-00008"><m:math>
              <m:mrow>
                <m:mfrac>
                  <m:mrow>
                    <m:mi>p</m:mi>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mn>10</m:mn>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mo>−</m:mo>
                    <m:mi>p</m:mi>
                    <m:mo stretchy="false">(</m:mo>
                    <m:mn>0</m:mn>
                    <m:mo stretchy="false">)</m:mo>
                  </m:mrow>
                  <m:mrow>
                    <m:mn>10</m:mn>
                    <m:mi>−</m:mi>
                    <m:mn>0</m:mn>
                  </m:mrow>
                </m:mfrac>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
    </section>
  </content>
