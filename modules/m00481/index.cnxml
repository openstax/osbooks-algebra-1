  <section><title>Activity</title>

<!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

<!--Q#1-->
<example><exercise>
      <problem>
            
           <para>Your teacher will give you a <link url="https://k12.openstax.org/contents/raise/resources/a8d7eddfce37fb14146b4b29f9127fc0269ea85f">set of cards</link>. Each card contains a system of equations.
          
               Sort the systems into three groups based on the number of
               solutions each system has. Be prepared to explain how you know where
                each system belongs. 
                
            </para>
      <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
      </problem><solution>
      <para>Compare your answer:</para>
      <list>
        <item>No solution: Cards 2 and 5</item>
        <item>One solution: Cards 1, 4, 6, and 9</item>
        <item>Infinitely many solutions: Cards 3, 7, and 8</item>
      </list>
</solution></exercise>
</example><!--Interaction End -->

<!-- END CLICK TO REVEAL NO TEXTBOX -->


