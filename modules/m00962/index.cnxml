  <content>
  <section><title>Warm Up Activity</title>
<para>Evaluate Mentally.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="21504528-89e7-49f9-a451-e7f8b613e057" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0"><!--Q#1-->
  <exercise data-content-id="6006a113-4491-4700-8f62-0b956ffd4bfc" data-problem-comparator="integer" data-problem-type="input" data-solution="2">
    <problem>
      <para>\( \frac{102-96}{45-42}\) </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct!\( 2\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#2-->
  <exercise data-content-id="95f98277-0f7a-4357-b97f-cecf4e55464e" data-problem-comparator="float" data-problem-type="input" data-solution="-3">
    <problem>
      <para> \(\frac{-8-4}{6-2}\) </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(-3\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  
  <!--Q#3-->
  <exercise data-content-id="cac39456-6b6b-4e19-955b-6ddfac66044d" data-problem-comparator="text" data-problem-type="input" data-solution="-13/5">
    <problem>
      <para> \(\frac{31-18}{5-10}\) </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(-\frac{13}{5}\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#4-->
  <exercise data-content-id="e4137444-0943-49b6-a07c-005d62bbaca3" data-problem-comparator="text" data-problem-type="input" data-solution="5/6">
    <problem>
      <para> \(\frac{4-9}{12-18}\) </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(\frac{4-9}{12-18}\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
