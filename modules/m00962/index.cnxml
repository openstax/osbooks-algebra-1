<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Evaluating Fractions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00962</md:content-id>
    <md:title>Evaluating Fractions</md:title>
    <md:uuid>63dfad8d-7ea6-462f-a464-04da9e0398e7</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>
      <para id="para-00001">Evaluate Mentally.</para>
      <exercise id="_6006a113-4491-4700-8f62-0b956ffd4bfc" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00002"><m:math>
              <m:mrow>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>102</m:mn>
                    <m:mo>&#8722;</m:mo>
                    <m:mn>96</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:mn>45</m:mn>
                    <m:mo>&#8722;</m:mo>
                    <m:mn>42</m:mn>
                  </m:mrow>
                </m:mfrac>
              </m:mrow>
            </m:math></para></problem>
        <solution id="sol-00001">
          <para id="para-00003"><m:math display="inline">
              <m:mrow>
                <m:mn>2</m:mn>
              </m:mrow>
            </m:math></para>
       
        </solution>
      </exercise>

      <exercise id="_95f98277-0f7a-4357-b97f-cecf4e55464e" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00005"><m:math>
              <m:mrow>
                <m:mfrac>
                  <m:mrow>
                    <m:mo>&#8722;</m:mo>
                    <m:mn>8</m:mn>
                    <m:mo>&#8722;</m:mo>
                    <m:mn>4</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:mn>6</m:mn>
                    <m:mo>&#8722;</m:mo>
                    <m:mn>2</m:mn>
                  </m:mrow>
                </m:mfrac>
              </m:mrow>
            </m:math></para></problem>
        <solution id="sol-00002">
          <para id="para-00006"><m:math display="inline">
              <m:mrow>
                <m:mo>&#8722;</m:mo>
                <m:mn>3</m:mn>
              </m:mrow>
            </m:math></para>
        
        </solution>
      </exercise>

      <exercise id="cac39456-6b6b-4e19-955b-6ddfac66044d" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00008"><m:math>
              <m:mrow>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>31</m:mn>
                    <m:mo>&#8722;</m:mo>
                    <m:mn>18</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:mn>5</m:mn>
                    <m:mo>&#8722;</m:mo>
                    <m:mn>10</m:mn>
                  </m:mrow>
                </m:mfrac>
              </m:mrow>
            </m:math></para></problem>
        <solution id="sol-00003">
          <para id="para-00009"><m:math display="inline">
              <m:mrow>
                <m:mo>&#8722;</m:mo>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>13</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:mn>5</m:mn>
                  </m:mrow>
                </m:mfrac>
              </m:mrow>
            </m:math></para>
          
        </solution>
      </exercise>

      <exercise id="e4137444-0943-49b6-a07c-005d62bbaca3" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00011"><m:math>
              <m:mrow>
                <m:mfrac>
                  <m:mrow>
                    <m:mn>4</m:mn>
                    <m:mo>&#8722;</m:mo>
                    <m:mn>9</m:mn>
                  </m:mrow>
                  <m:mrow>
                    <m:mn>12</m:mn>
                    <m:mo>&#8722;</m:mo>
                    <m:mn>18</m:mn>
                  </m:mrow>
                </m:mfrac>
              </m:mrow>
            </m:math></para></problem>
        <solution id="sol-00004">
          <para id="para-00012"><m:math display="inline">
              <m:mrow>
                <m:mfrac>
                    <m:mn>5</m:mn>
                    <m:mn>6</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math></para>
         
        </solution>
      </exercise>
    </section>
  </content>
</document>