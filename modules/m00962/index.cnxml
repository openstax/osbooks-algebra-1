<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.7.1: Evaluating Fractions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00962</md:content-id>
    <md:title>4.7.1: Evaluating Fractions</md:title>
    <md:uuid>63dfad8d-7ea6-462f-a464-04da9e0398e7</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><para id="para-00001">Evaluate Mentally.</para>
<section id="sect-00002"><title>Warm Up Activity</title><exercise id="_6006a113-4491-4700-8f62-0b956ffd4bfc" class="multiple-choice"><problem id="prob-00001"><para id="para-00002">\( \frac{102-96}{45-42}\)</para>
      </problem><solution id="sol-00001"><para id="para-00003">Correct!\( 2\)</para><para id="para-00004">Nice try! The correct answer is \( 2\)</para></solution></exercise>
      
      <exercise id="_95f98277-0f7a-4357-b97f-cecf4e55464e" class="multiple-choice"><problem id="prob-00002"><para id="para-00005">\(\frac{-8-4}{6-2}\)</para>
      </problem><solution id="sol-00002"><para id="para-00006">Correct! \(-3\)</para><para id="para-00007">Nice try! The correct answer is \(-3\)</para></solution></exercise>
      
      <exercise id="cac39456-6b6b-4e19-955b-6ddfac66044d" class="multiple-choice"><problem id="prob-00003"><para id="para-00008">\(\frac{31-18}{5-10}\)</para>
      </problem><solution id="sol-00003"><para id="para-00009">Correct! \(-\frac{13}{5}\)</para><para id="para-00010">Nice try! The correct answer is \(-\frac{13}{5}\)</para></solution></exercise>
      
      <exercise id="e4137444-0943-49b6-a07c-005d62bbaca3" class="multiple-choice"><problem id="prob-00004"><para id="para-00011">\(\frac{4-9}{12-18}\)</para>
      </problem><solution id="sol-00004"><para id="para-00012">Correct! \(\frac{4-9}{12-18}\)</para><para id="para-00013">Nice try! The correct answer is \(\frac{4-9}{12-18}\)</para></solution></exercise></section></section>
</content></document>