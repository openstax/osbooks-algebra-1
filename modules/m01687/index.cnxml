<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.6.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01687</md:content-id>
    <md:title>6.6.5: Practice</md:title>
    <md:uuid>2085d7a9-26fb-40b8-97ef-dea0dc7a9e7f</md:uuid>
  </metadata>
  <content>
  <section class="practice" id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
<!--Do not edit this div tag.  It must surround the interaction block-->
<section id="sect-00002"><exercise id="d56227b2-abf5-4831-b15d-b10b90ce5382" class="multiple-choice"><problem id="prob-00001"><para id="para-00002">For questions 1 – 5, factor using perfect square trinomials.</para><para><m:math display="inline"><m:mrow><m:mn>9</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>24</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>16</m:mn></m:mrow></m:math></para><para id="para-00004">Multiple Choice:</para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>–</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mi>–</m:mi><m:mspace width="0.278em"/><m:mtext> </m:mtext><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para></problem><solution id="sol-00001"><para id="para-00009">Try again. Revisit 6.6.2.
    </para><para id="para-00010">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="aac53607-e6ea-4a04-a690-25c4faa22395" class="multiple-choice"><problem id="prob-00002"><para><m:math><m:mrow><m:mn>16</m:mn><m:msup><m:mi>z</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>72</m:mn><m:mi>z</m:mi><m:mo>+</m:mo><m:mn>81</m:mn></m:mrow></m:math></para><para id="para-00012">Multiple Choice:</para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>z</m:mi><m:mi>−</m:mi><m:mn>9</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mi>z</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mi>z</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>z</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para></problem><solution id="sol-00002"><para id="para-00017">Try again. Revisit 6.6.2.</para><para id="para-00018">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>z</m:mi><m:mi>−</m:mi><m:mn>9</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="ec8d93e9-326b-4330-8957-642002d6560d" class="multiple-choice"><problem id="prob-00003"><para><m:math><m:mrow><m:mn>27</m:mn><m:msup><m:mi>p</m:mi><m:mn>2</m:mn></m:msup><m:mi>q</m:mi><m:mo>+</m:mo><m:mn>90</m:mn><m:mi>p</m:mi><m:mi>q</m:mi><m:mo>+</m:mo><m:mn>75</m:mn><m:mi>q</m:mi></m:mrow></m:math></para><para id="para-00020">Multiple Choice:</para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>27</m:mn><m:mi>p</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>9</m:mn><m:mi>q</m:mi><m:mo stretchy="false">(</m:mo><m:mi>p</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>3</m:mn><m:mi>q</m:mi><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>p</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>3</m:mn><m:mi>q</m:mi><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>p</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para></problem><solution id="sol-00003"><para id="para-00025">Try again. Revisit 6.6.2.</para><para id="para-00026">The correct answer is <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>q</m:mi><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>p</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_3b77377a-4f5d-47a8-ab6c-606c0229d3dc" class="multiple-choice"><problem id="prob-00004"><para><m:math><m:mrow><m:mn>64</m:mn><m:msup><m:mi>z</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>16</m:mn><m:mi>z</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math></para><para id="para-00028">Multiple Choice:</para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>z</m:mi><m:mi>−</m:mi><m:mn>8</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mi>z</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>z</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mi>z</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para></problem><solution id="sol-00004"><para id="para-00033">Try again. Revisit 6.6.2.</para><para id="para-00034">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mi>z</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_9194da46-330c-4425-b48a-9ed09b715190" class="multiple-choice"><problem id="prob-00005"><para><m:math><m:mrow><m:mn>64</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>96</m:mn><m:mi>x</m:mi><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>36</m:mn><m:mi>y</m:mi></m:mrow></m:math></para><para id="para-00036">Multiple Choice:</para><para><m:math><m:mrow><m:mn>4</m:mn><m:mi>y</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>2</m:mn><m:mi>y</m:mi><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>4</m:mn><m:mi>y</m:mi><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mn>4</m:mn><m:mi>y</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para></problem><solution id="sol-00005"><para id="para-00041">Try again. Revisit 6.6.2.
    </para><para id="para-00042">The correct answer is <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mi>y</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_0def5965-2187-472f-bf9b-f7864608ad0a" class="multiple-choice"><problem id="prob-00006"><para id="para-00043">For questions 6 – 10, factor using the difference of squares.</para>
      <para><m:math><m:mrow><m:mn>25</m:mn><m:msup><m:mi>v</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>1</m:mn></m:mrow></m:math></para><para id="para-00045">Multiple Choice:</para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mi>v</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>v</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mi>v</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mi>v</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>v</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mi>v</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>v</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>v</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00006"><para id="para-00050">Try again. Revisit 6.6.3.</para><para id="para-00051">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mi>v</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mi>v</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.
    </para></solution></exercise>
     <exercise id="_2fccbbb7-6910-4acd-a93e-27721115b4dd" class="multiple-choice"><problem id="prob-00007"><para><m:math><m:mrow><m:mn>4</m:mn><m:mi>−</m:mi><m:mn>49</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00053">Multiple Choice:</para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>−</m:mi><m:mn>7</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>−</m:mi><m:mn>7</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>−</m:mi><m:mn>7</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>−</m:mi><m:mn>7</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mi>−</m:mi><m:mn>2</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00007"><para id="para-00058">Try again. Revisit 6.6.3.</para><para id="para-00059">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>−</m:mi><m:mn>7</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.
    </para></solution></exercise>
     <exercise id="_7e7aa85d-d2e7-49eb-bb3c-fc0010d65395" class="multiple-choice"><problem id="prob-00008"><para><m:math><m:mrow><m:mn>169</m:mn><m:msup><m:mi>c</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>36</m:mn><m:msup><m:mi>d</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00061">Multiple Choice:</para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>13</m:mn><m:mi>c</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mi>d</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>13</m:mn><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>d</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>13</m:mn><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>d</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>13</m:mn><m:mi>d</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mi>c</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>13</m:mn><m:mi>d</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>c</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>13</m:mn><m:mi>c</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mi>d</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>13</m:mn><m:mi>c</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mi>d</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00008"><para id="para-00066">Try again. Revisit 6.6.3.
    </para><para id="para-00067">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>13</m:mn><m:mi>c</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mi>d</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>13</m:mn><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>d</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.
    </para></solution></exercise>
     <exercise id="_25eed34e-376f-4073-a444-f538099d3cd6" class="multiple-choice"><problem id="prob-00009"><para><m:math><m:mrow><m:mn>121</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>144</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00069">Multiple Choice:</para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>11</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>11</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>11</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>11</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>11</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>12</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>11</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>11</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>12</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>11</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>12</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00009"><para id="para-00074">Try again. Revisit 6.6.3.
    </para><para id="para-00075">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>11</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>12</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>11</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.
    </para></solution></exercise>
     <exercise id="_11cc16f4-681c-46da-b0df-1a0e480bcf21" class="multiple-choice"><problem id="prob-00010"><para><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>16</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>64</m:mn><m:mi>−</m:mi><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00077">Multiple Choice:</para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>8</m:mn><m:mi>−</m:mi><m:mi>y</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>−</m:mi><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>+</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>8</m:mn><m:mi>−</m:mi><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>8</m:mn><m:mo>+</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>8</m:mn><m:mi>−</m:mi><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>+</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00010"><para id="para-00082">Try again. Revisit 6.6.3.</para><para id="para-00083">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>8</m:mn><m:mi>−</m:mi><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>8</m:mn><m:mo>+</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.
    </para></solution></exercise></section></section>
