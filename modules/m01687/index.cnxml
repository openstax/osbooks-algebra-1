  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<!--Do not edit this div tag.  It must surround the interaction block-->
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="3faca9d3-8884-42d2-b849-62479d697b90" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--q1-->
  <exercise data-content-id="d56227b2-abf5-4831-b15d-b10b90ce5382" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((3y + 4)^2\)" data-solution-options="[&quot;\\((4y\\;\\ – \\;\\ 3)^2\\)&quot;, &quot;\\((3y\\;\\  – \\;\\ 4)^2\\)&quot;, &quot;\\((3y + 4)^2\\)&quot;, &quot;\\((4y + 3)^2\\)&quot;]">
    <problem>
      <para>For questions 1 – 5, factor using perfect square trinomials.</para>
      <para>\(9y^2 + 24y + 16\)
        </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.6.2.
      </para>
    </div>
    </exercise>
  <!--q2-->
  <exercise data-content-id="aac53607-e6ea-4a04-a690-25c4faa22395" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((4z − 9)^2\)" data-solution-options="[&quot;\\((4z − 9)^2\\)&quot;, &quot;\\((9z − 4)^2\\)&quot;, &quot;\\((9z + 4)^2\\)&quot;, &quot;\\((4z + 9)^2\\)&quot;]">
    <problem>
      <para>\(16z^2 − 72z + 81\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.6.2.</para>
    </div>
    </exercise>
  <!--q3-->
  <exercise data-content-id="ec8d93e9-326b-4330-8957-642002d6560d" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(3q(3p + 5)^2\)" data-solution-options="[&quot;\\((27p + 5)^2\\)&quot;, &quot;\\(9q(p + 5)^2\\)&quot;, &quot;\\(3q(3p + 5)^2\\)&quot;, &quot;\\(3q(3p − 5)^2\\)&quot;]">
    <problem>
      <para>\(27p^2q + 90pq + 75q\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.6.2.</para>
    </div>
    </exercise>
  <!--q4-->
  <exercise data-content-id="3b77377a-4f5d-47a8-ab6c-606c0229d3dc" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((8z − 1)^2\)" data-solution-options="[&quot;\\((z − 8)^2\\)&quot;, &quot;\\((8z + 1)^2\\)&quot;, &quot;\\((z + 8)^2\\)&quot;, &quot;\\((8z − 1)^2\\)&quot;]">
    <problem>
      <para>\(64z^2 − 16z + 1\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.6.2.</para>
    </div>
    </exercise>
  <!--q5-->
  <exercise data-content-id="9194da46-330c-4425-b48a-9ed09b715190" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(4y(4x − 3)^2\)" data-solution-options="[&quot;\\(4y(4x − 3)^2\\)&quot;, &quot;\\(2y(8x − 6)^2\\)&quot;, &quot;\\(4y(3x − 4)^2\\)&quot;, &quot;\\(4y(4x + 3)^2\\) &quot;]">
    <problem>
      <para>\(64x^2y − 96xy + 36y\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.6.2.
      </para>
    </div>
    </exercise>
  <!--q6-->
  <exercise data-content-id="0def5965-2187-472f-bf9b-f7864608ad0a" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((5v − 1)(5v + 1)\)" data-solution-options="[&quot;\\((5v − 1)(v + 5)\\)&quot;, &quot;\\((5v − 1)(5v + 1)\\)&quot;, &quot;\\((v − 5)(5v + 1)\\)&quot;, &quot;\\((v − 5)(v + 5)\\) &quot;]">
    <problem>
      <para>For questions 6 – 10, factor using the difference of squares.</para>
      <para>\(25v^2 − 1\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.6.3.</para>
    </div>
    </exercise>
  <!--q7-->
  <exercise data-content-id="2fccbbb7-6910-4acd-a93e-27721115b4dd" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((2 − 7x)(2 + 7x)\)" data-solution-options="[&quot;\\((2 − 7x)(7 + 2x)\\)&quot;, &quot;\\((2 − 7x)(2 + 7x)\\)&quot;, &quot;\\((2 − 7x)(2 − 7x)\\)&quot;, &quot;\\((7 − 2x)(7 + 2x)\\)&quot;]">
    <problem>
      <para> \(4 − 49x^2\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.6.3.</para>
    </div>
    </exercise>
  <!--q8-->
  <exercise data-content-id="7e7aa85d-d2e7-49eb-bb3c-fc0010d65395" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((13c − 6d)(13c + 6d)\)" data-solution-options="[&quot;\\((13c − 6d)(13c + 6d)\\)&quot;, &quot;\\((13c + 6d)^2\\)&quot;, &quot;\\((13d − 6c)(13d + 6c)\\)&quot;, &quot;\\((13c − 6d)(13c − 6d)\\)&quot;]">
    <problem>
      <para>\(169c^2 − 36d^2\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.6.3.
      </para>
    </div>
    </exercise>
  <!--q9-->
  <exercise data-content-id="25eed34e-376f-4073-a444-f538099d3cd6" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((11x − 12y)(11x + 12y)\)" data-solution-options="[&quot;\\((12x − 11y)(12x + 11y)\\)&quot;, &quot;\\((12x + 11y)(12x + 11y)\\)&quot;, &quot;\\((11x − 12y)(11x + 12y)\\)&quot;, &quot;\\((11x − 12y)(11x − 12y)\\)&quot;]">
    <problem>
      <para>\(121x^2 − 144y^2\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.6.3.
      </para>
    </div>
    </exercise>
  <!--q10-->
  <exercise data-content-id="11cc16f4-681c-46da-b0df-1a0e480bcf21" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((x − 8 − y)(x − 8 + y)\)" data-solution-options="[&quot;\\((x − 8 − y)^2\\)&quot;, &quot; \\((x + 8 − y)(x + 8 + y)\\)&quot;, &quot;\\((x − 8 − y)(x − 8 + y)\\)&quot;, &quot;\\((x − 8 − y)(x + 8 + y)\\)&quot;]">
    <problem>
      <para>\(x^2 − 16x + 64 − y^2\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.6.3.</para>
    </div>
    </exercise>
