<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.6.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01687</md:content-id>
    <md:title>6.6.5: Practice</md:title>
    <md:uuid>2085d7a9-26fb-40b8-97ef-dea0dc7a9e7f</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
<!--Do not edit this div tag.  It must surround the interaction block-->
<section id="sect-00002"><exercise id="d56227b2-abf5-4831-b15d-b10b90ce5382" class="multiple-choice"><problem id="prob-00001"><para id="para-00002">For questions 1 – 5, factor using perfect square trinomials.</para><para id="para-00003">\(9y^2 + 24y + 16\)
      </para>
      <para id="para-00004">Multiple Choice:</para><para id="para-00005">\((4y\;\ – \;\ 3)^2\)</para><para id="para-00006">\((3y\;\  – \;\ 4)^2\)</para><para id="para-00007">\((3y + 4)^2\)</para><para id="para-00008">\((4y + 3)^2\)</para></problem><solution id="sol-00001"><para id="para-00009">Try again. Revisit 6.6.2.
    </para><para id="para-00010">The correct answer is \((3y + 4)^2\).
    </para></solution></exercise>
      
      <exercise id="aac53607-e6ea-4a04-a690-25c4faa22395" class="multiple-choice"><problem id="prob-00002"><para id="para-00011">\(16z^2 − 72z + 81\)</para>
      <para id="para-00012">Multiple Choice:</para><para id="para-00013">\((4z − 9)^2\)</para><para id="para-00014">\((9z − 4)^2\)</para><para id="para-00015">\((9z + 4)^2\)</para><para id="para-00016">\((4z + 9)^2\)</para></problem><solution id="sol-00002"><para id="para-00017">Try again. Revisit 6.6.2.</para><para id="para-00018">The correct answer is \((4z − 9)^2\).</para></solution></exercise>
      
      <exercise id="ec8d93e9-326b-4330-8957-642002d6560d" class="multiple-choice"><problem id="prob-00003"><para id="para-00019">\(27p^2q + 90pq + 75q\)</para>
      <para id="para-00020">Multiple Choice:</para><para id="para-00021">\((27p + 5)^2\)</para><para id="para-00022">\(9q(p + 5)^2\)</para><para id="para-00023">\(3q(3p + 5)^2\)</para><para id="para-00024">\(3q(3p − 5)^2\)</para></problem><solution id="sol-00003"><para id="para-00025">Try again. Revisit 6.6.2.</para><para id="para-00026">The correct answer is \(3q(3p + 5)^2\).</para></solution></exercise>
      
      <exercise id="_3b77377a-4f5d-47a8-ab6c-606c0229d3dc" class="multiple-choice"><problem id="prob-00004"><para id="para-00027">\(64z^2 − 16z + 1\)</para>
      <para id="para-00028">Multiple Choice:</para><para id="para-00029">\((z − 8)^2\)</para><para id="para-00030">\((8z + 1)^2\)</para><para id="para-00031">\((z + 8)^2\)</para><para id="para-00032">\((8z − 1)^2\)</para></problem><solution id="sol-00004"><para id="para-00033">Try again. Revisit 6.6.2.</para><para id="para-00034">The correct answer is \((8z − 1)^2\).</para></solution></exercise>
      
      <exercise id="_9194da46-330c-4425-b48a-9ed09b715190" class="multiple-choice"><problem id="prob-00005"><para id="para-00035">\(64x^2y − 96xy + 36y\)</para>
      <para id="para-00036">Multiple Choice:</para><para id="para-00037">\(4y(4x − 3)^2\)</para><para id="para-00038">\(2y(8x − 6)^2\)</para><para id="para-00039">\(4y(3x − 4)^2\)</para><para id="para-00040">\(4y(4x + 3)^2\)</para></problem><solution id="sol-00005"><para id="para-00041">Try again. Revisit 6.6.2.
    </para><para id="para-00042">The correct answer is \(4y(4x − 3)^2\).</para></solution></exercise>
      
      <exercise id="_0def5965-2187-472f-bf9b-f7864608ad0a" class="multiple-choice"><problem id="prob-00006"><para id="para-00043">For questions 6 – 10, factor using the difference of squares.</para>
      <para id="para-00044">\(25v^2 − 1\)</para>
      <para id="para-00045">Multiple Choice:</para><para id="para-00046">\((5v − 1)(v + 5)\)</para><para id="para-00047">\((5v − 1)(5v + 1)\)</para><para id="para-00048">\((v − 5)(5v + 1)\)</para><para id="para-00049">\((v − 5)(v + 5)\)</para></problem><solution id="sol-00006"><para id="para-00050">Try again. Revisit 6.6.3.</para><para id="para-00051">The correct answer is \((5v − 1)(5v + 1)\).
    </para></solution></exercise>
     <exercise id="_2fccbbb7-6910-4acd-a93e-27721115b4dd" class="multiple-choice"><problem id="prob-00007"><para id="para-00052">\(4 − 49x^2\)</para>
      <para id="para-00053">Multiple Choice:</para><para id="para-00054">\((2 − 7x)(7 + 2x)\)</para><para id="para-00055">\((2 − 7x)(2 + 7x)\)</para><para id="para-00056">\((2 − 7x)(2 − 7x)\)</para><para id="para-00057">\((7 − 2x)(7 + 2x)\)</para></problem><solution id="sol-00007"><para id="para-00058">Try again. Revisit 6.6.3.</para><para id="para-00059">The correct answer is \((2 − 7x)(2 + 7x)\).
    </para></solution></exercise>
     <exercise id="_7e7aa85d-d2e7-49eb-bb3c-fc0010d65395" class="multiple-choice"><problem id="prob-00008"><para id="para-00060">\(169c^2 − 36d^2\)</para>
      <para id="para-00061">Multiple Choice:</para><para id="para-00062">\((13c − 6d)(13c + 6d)\)</para><para id="para-00063">\((13c + 6d)^2\)</para><para id="para-00064">\((13d − 6c)(13d + 6c)\)</para><para id="para-00065">\((13c − 6d)(13c − 6d)\)</para></problem><solution id="sol-00008"><para id="para-00066">Try again. Revisit 6.6.3.
    </para><para id="para-00067">The correct answer is \((13c − 6d)(13c + 6d)\).
    </para></solution></exercise>
     <exercise id="_25eed34e-376f-4073-a444-f538099d3cd6" class="multiple-choice"><problem id="prob-00009"><para id="para-00068">\(121x^2 − 144y^2\)</para>
      <para id="para-00069">Multiple Choice:</para><para id="para-00070">\((12x − 11y)(12x + 11y)\)</para>
      <para id="para-00071">\((12x + 11y)(12x + 11y)\)</para>
      <para id="para-00072">\((11x − 12y)(11x + 12y)\)</para><para id="para-00073">\((11x − 12y)(11x − 12y)\)</para></problem><solution id="sol-00009"><para id="para-00074">Try again. Revisit 6.6.3.
    </para><para id="para-00075">The correct answer is \((11x − 12y)(11x + 12y)\).
    </para></solution></exercise>
     <exercise id="_11cc16f4-681c-46da-b0df-1a0e480bcf21" class="multiple-choice"><problem id="prob-00010"><para id="para-00076">\(x^2 − 16x + 64 − y^2\)</para>
      <para id="para-00077">Multiple Choice:</para><para id="para-00078">\((x − 8 − y)^2\)</para><para id="para-00079">\((x + 8 − y)(x + 8 + y)\)</para><para id="para-00080">\((x − 8 − y)(x − 8 + y)\)</para><para id="para-00081">\((x − 8 − y)(x + 8 + y)\)</para></problem><solution id="sol-00010"><para id="para-00082">Try again. Revisit 6.6.3.</para><para id="para-00083">The correct answer is \((x − 8 − y)(x − 8 + y)\).
    </para></solution></exercise></section></section>
