<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.14.3: Writing an Equation of a Line Parallel to a Given Line</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00309</md:content-id>
    <md:title>1.14.3: Writing an Equation of a Line Parallel to a Given Line</md:title>
    <md:uuid>fdf8e9f2-0be2-439c-a57a-fefd0f08d46c</md:uuid>
  </metadata>
  <content>
    <section>
      <title>Activity</title>
      <!--Q#1-->
      <exercise>
        <problem>
          <para>Find the equation of the line using point-slope form: \(m = 2\), \((3,1)\)</para>
          <para>Rewrite your equation from Question 1 in slope-intercept form.</para>
          <para>Enter your answer here:</para>
        </problem>
        <solution>
          <para>Enter your answer here:</para>
          <para>Compare your answer:</para>
          <!--Q#2-->
          <exercise>
            <problem/>
            <solution/>
          </exercise>
          <!--Interaction End -->
          <para>\(y − 1 = 2(x − 3)\)</para>
          <para>Compare your answer:</para>
          <para>\(y = 2x − 5\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#3-->
      <exercise>
        <problem>
          <para>Find the equation of the line using point-slope form: \(m = 2\), \((−1,4)\)</para>
          <para>Enter your answer here:</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>y − 4 = 2(x + 1)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#4-->
      <exercise>
        <problem>
          <para>Rewrite your equation from Question 3 in slope-intercept form.</para>
          <para>Enter your answer here:</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y = 2x + 6\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#5-->
      <exercise>
        <problem>
          <para>Find the equation of the line using point-slope form: \(m = −4\), \((2,1)\)</para>
          <para>Enter your answer here:</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y − 1 = −4(x − 2)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#6-->
      <exercise>
        <problem>
          <para>Rewrite your equation from Question 5 in slope-intercept form.</para>
          <para>Enter your answer here:</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y = −4x + 9\)</para>
          <note>
            <para>Parallel lines are lines that have the same slope. Because they have the same slope, they will never touch, or intersect.</para>
          </note>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#7-->
      <exercise>
        <problem>
          <para>Find the equation of the line using point-slope form: \(m = −4\), \((3,−2)\)</para>
          <para>Enter your answer here:</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y + 2 = −4(x − 3)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#8-->
      <exercise>
        <problem>
          <para>Rewrite your equation from Question 7 in slope-intercept form.</para>
          <para>Enter your answer here:</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(y = −4x + 10\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#9-->
      <list class="os-raise-noindent" type="enumerated">
        <item> Use the graphing tool or technology outside the course. Graph your equations from questions 2 and 4 on the same graph using the Desmos tool below. </item>
      </list>
      <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/><example>
