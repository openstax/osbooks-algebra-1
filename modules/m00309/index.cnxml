      <!--Q#11-->
      <exercise id="exer-00010">
        <problem id="prob-00010">
          <para id="para-00032">What is the same about the equations given in questions 2 and 4?</para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00033">Compare your answer: </para>
          <para id="para-00034">The slopes are the same. They are both 2.</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#12-->
      <exercise id="exer-00011">
        <problem id="prob-00011">
          <para id="para-00035">What is the same about the equations given in questions 6 and 8?</para>
        </problem>
        <solution id="sol-00011">
          <para id="para-00036">Compare your answer: </para>
          <para id="para-00037">The slopes are the same. They are both -4.</para>
        </solution>
      </exercise>
