<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Writing an Equation of a Line Parallel to a Given Line</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00309</md:content-id>
    <md:title>Writing an Equation of a Line Parallel to a Given Line</md:title>
    <md:uuid>fdf8e9f2-0be2-439c-a57a-fefd0f08d46c</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">
      <title>Activity</title>
      <!--Q#1-->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00001">Find the equation of the line using point-slope form: <m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mn>2</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>3</m:mn>
                <m:mo>,</m:mo>
                <m:mn>1</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Compare your answer: </para>
          <!--Q#2-->
          <!--Interaction
          End -->
          <para id="para-00004"><m:math>
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mo>–</m:mo>
                <m:mn>1</m:mn>
                <m:mo>=</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>–</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>

      <exercise id="exer-00014">
        <problem id="prob-00014">
          <para id="para-00002">Rewrite your equation from Question 1 in slope-intercept form.</para>
        </problem>
        <solution id="sol-00013">
          <para id="para-00005">Compare your answer: </para>
          <para id="para-00006"><m:math>
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mo>=</m:mo>
                <m:mn>2</m:mn>
                <m:mi>x</m:mi>
                <m:mo>–</m:mo>
                <m:mn>5</m:mn>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#3-->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00007">Find the equation of the line using point-slope form: <m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mn>2</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>–</m:mo>
                <m:mn>1</m:mn>
                <m:mo>,</m:mo>
                <m:mn>4</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00008">Compare your answer: </para>
          <para id="para-00009">y − 4 = 2(x + 1)</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#4-->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010">Rewrite your equation from Question 3 in slope-intercept form.</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00011">Compare your answer: </para>
          <para id="para-00012"><m:math>
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mo>=</m:mo>
                <m:mn>2</m:mn>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>6</m:mn>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#5-->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00013">Find the equation of the line using point-slope form: <m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mo>–</m:mo>
                <m:mn>4</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>2</m:mn>
                <m:mo>,</m:mo>
                <m:mn>1</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00014">Compare your answer: </para>
          <para id="para-00015"><m:math>
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mo>–</m:mo>
                <m:mn>1</m:mn>
                <m:mo>=</m:mo>
                <m:mo>–</m:mo>
                <m:mn>4</m:mn>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>–</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#6-->
      <exercise id="exer-00005">
        <problem id="prob-00005">
          <para id="para-00016">Rewrite your equation from Question 5 in slope-intercept form.</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00017">Compare your answer: </para>
          <para id="para-00018"><m:math>
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mo>=</m:mo>
                <m:mo>–</m:mo>
                <m:mn>4</m:mn>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>9</m:mn>
              </m:mrow>
            </m:math></para>
          <note id="note-00001">
            <para id="para-00019">Parallel lines are lines that have the same slope. Because they
            have the same slope, they will never touch, or intersect.</para>
          </note>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#7-->
      <exercise id="exer-00006">
        <problem id="prob-00006">
          <para id="para-00020">Find the equation of the line using point-slope form: <m:math display="inline">
              <m:mrow>
                <m:mi>m</m:mi>
                <m:mo>=</m:mo>
                <m:mo>–</m:mo>
                <m:mn>4</m:mn>
              </m:mrow>
            </m:math>, <m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>3</m:mn>
                <m:mo>,</m:mo>
                <m:mo>–</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00021">Compare your answer: </para>
          <para id="para-00022"><m:math>
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
                <m:mo>=</m:mo>
                <m:mo>–</m:mo>
                <m:mn>4</m:mn>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>–</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#8-->
      <exercise id="exer-00007">
        <problem id="prob-00007">
          <para id="para-00023">Rewrite your equation from Question 7 in slope-intercept form.</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00024">Compare your answer: </para>
          <para id="para-00025"><m:math>
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mo>=</m:mo>
                <m:mo>–</m:mo>
                <m:mn>4</m:mn>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>10</m:mn>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->
      <!--Q#9-->
