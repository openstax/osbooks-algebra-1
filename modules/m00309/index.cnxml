      <exercise id="exer-00009">
        <problem id="prob-00009">
          <para id="para-00029">Graph your equations from questions 6 and 8 on the same graph using
            the Desmos tool. </para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00030">Compare your answer: </para>
          <para id="para-00031">
            <media alt="Graph with two negative-sloping arrows:both cross the y-axis and are parallel to each other.The blue line crosses the y-axis at (0,10).  The red line croses the y-axis at (0,9)">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_01_16_06_02.jpg"/>
            </media>

