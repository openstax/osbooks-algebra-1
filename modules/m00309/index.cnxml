        <exercise>
          <problem>
            <para>When you have finished graphing, then select the <emphasis>solution</emphasis> button to compare your work. </para>
          </problem>
          <solution>
            <para>Compare your answer:</para>
            <para>
              <figure>
                <media alt="Graphs of y = -4x+9 and y = -4x + 10.">
                  <image mime-type="image/jpeg" src="../../media/Algebra-1_01_16_06_02.jpg"/>
                </media>
              </figure>
            </para>
          </solution>
        </exercise>
      </example>
      <!--Interaction End -->
      <!--Q#11-->
      <exercise>
        <problem>
          <para>What is the same about the equations given in questions 2 and 4?</para>
          <para>Enter your answer here:</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>The slopes are the same. They are both 2. </para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#12-->
      <exercise>
        <problem>
          <para>What is the same about the equations given in questions 6 and 8?</para>
          <para>Enter your answer here:</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>The slopes are the same. They are both -4.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
