<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Describe the Pattern</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01114</md:content-id>
    <md:title>Describe the Pattern</md:title>
    <md:uuid>6c6b0649-11eb-4d68-8a45-7f957407dbae</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>
<para id="para-00001">Here is a rule for making a list of numbers: <emphasis>Each number is 1 less than twice the previous number.</emphasis></para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00002">Pick a number to start with. Then follow the rule to build a list of 5 numbers.</para>
  
  </problem><solution id="sol-00001">
  <para id="para-00003">Compare your answer: </para>
    
    <list id="list-00001">
      <item>2, 3, 5, 9, 17</item>
      <item>5, 9, 17, 33, 65</item>
      <item>1, 1, 1, 1, 1</item>
    </list>
  
  </solution></exercise>
<!--Interaction End --></section>
</content>
</document>
