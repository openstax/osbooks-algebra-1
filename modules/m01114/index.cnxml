  <content>
  <section><title>Warm Up Activity</title>
<para>Here is a rule for making a list of numbers: <emphasis>Each number is 1 less than twice the previous number.</emphasis></para>

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Pick a number to start with. Then follow the rule to build a list of 5 numbers.</para>
  </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <list>
      <item> 2, 3, 5, 9, 17 </item>
      <item> 5, 9, 17, 33, 65 </item>
      <item> 1, 1, 1, 1, 1 </item>
    </list>
  </solution></exercise>
<!--Interaction End --></section>
</content>
</document>
