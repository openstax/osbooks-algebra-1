<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
   <title>9.6.5: Practice</title>
   <metadata xmlns:md="http://cnx.rice.edu/mdml">
      <md:content-id>m02433</md:content-id>
      <md:title>9.6.5: Practice</md:title>
      <md:uuid>9f536fc6-d2bb-4739-a9dc-cd0c684e3a7a</md:uuid>
   </metadata>
   <content>
      <section class="practice" id="sect-00001">
         <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
            <exercise id="e1f655a9-5546-46d4-81b3-34e1ab3db3b0" class="multiple-choice">
               <problem id="prob-00001">
                  <para id="para-00002">For each equation in questions 1 – 5, identify the values of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>, and <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math> that you would substitute into the quadratic formula to solve the equation.</para>
                  <para><m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para><para id="para-00004">What is the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>?</para>
                  <para id="para-00005">Enter the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>.</para>
               </problem>
               <solution id="sol-00001">
                  <para id="para-00006">Correct! <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
                  <para id="para-00007">Try again. Revisit activity 9.6.3.</para>
                  <para id="para-00008">The correct answer is <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_22cc9439-d99f-49f6-9c8d-cbb0077c8c5e" class="multiple-choice">
               <problem id="prob-00002">
                  <para id="para-00009">What is the value of <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>?</para>
                  <para id="para-00010">Enter the value of <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>.</para>
               </problem>
               <solution id="sol-00002">
                  <para id="para-00011">Correct! <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
                  <para id="para-00012">Try again. Revisit activity 9.6.3.</para>
                  <para id="para-00013">The correct answer is <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_215ae2af-15d1-4e4d-b781-21865a8636a6" class="multiple-choice">
               <problem id="prob-00003">
                  <para id="para-00014">What is the value of <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math>?</para>
                  <para id="para-00015">Enter the value of <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math>.</para>
               </problem>
               <solution id="sol-00003">
                  <para id="para-00016">Correct! <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
                  <para id="para-00017">Try again. Revisit activity 9.6.3.</para>
                  <para id="para-00018">The correct answer is <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_9ceb36b1-9646-4a28-9444-576bfe8549c5" class="multiple-choice">
               <problem id="prob-00004">
                  <para><m:math><m:mrow><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para><para id="para-00020">What is the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>?</para>
                  <para id="para-00021">Enter the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>.</para>
               </problem>
               <solution id="sol-00004">
                  <para id="para-00022">Correct! <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
                  <para id="para-00023">Try again. Revisit activity 9.6.3.</para>
                  <para id="para-00024">The correct answer is <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_08e782a8-c00c-4c0c-a71b-174e096f3270" class="multiple-choice">
               <problem id="prob-00005">
                  <para id="para-00025">What is the value of <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>?</para>
                  <para id="para-00026">Enter the value of <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>.</para>
               </problem>
               <solution id="sol-00005">
                  <para id="para-00027">Correct! <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
                  <para id="para-00028">Try again. Revisit activity 9.6.3.</para>
                  <para id="para-00029">The correct answer is <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="edfdc15e-7642-4367-a4c7-eb9bef34bcc4" class="multiple-choice">
               <problem id="prob-00006">
                  <para id="para-00030">What is the value of <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math>?</para>
                  <para id="para-00031">Enter the value of <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math> .</para>
               </problem>
               <solution id="sol-00006">
                  <para id="para-00032">Correct! <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
                  <para id="para-00033">Try again. Revisit activity 9.6.3.</para>
                  <para id="para-00034">The correct answer is <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="fa55ea19-921c-43e3-8094-cfd005e3bfb5" class="multiple-choice">
               <problem id="prob-00007">
                  <para><m:math><m:mrow><m:mo>−</m:mo><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>13</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para><para id="para-00036">What is the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>?</para>
                  <para id="para-00037">Enter the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>.</para>
               </problem>
               <solution id="sol-00007">
                  <para id="para-00038">Correct! <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
                  <para id="para-00039">Try again. Revisit activity 9.6.3.</para>
                  <para id="para-00040">The correct answer is <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_57a376bf-67ff-470e-9333-13ca18ac0400" class="multiple-choice">
               <problem id="prob-00008">
                  <para id="para-00041">What is the value of <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>?</para>
                  <para id="para-00042">Enter the value of <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>.</para>
               </problem>
               <solution id="sol-00008">
                  <para id="para-00043">Correct! <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>13</m:mn></m:mrow></m:math></para>
                  <para id="para-00044">Try again. Revisit activity 9.6.3.</para>
                  <para id="para-00045">The correct answer is <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>13</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_07423fbb-b45e-4260-889d-6408161d11b7" class="multiple-choice">
               <problem id="prob-00009">
                  <para id="para-00046">What is the value of <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math>?</para>
                  <para id="para-00047">Enter the value of <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math>.</para>
               </problem>
               <solution id="sol-00009">
                  <para id="para-00048">Correct! <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
                  <para id="para-00049">Try again. Revisit activity 9.6.3.</para>
                  <para id="para-00050">The correct answer is <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="e76ed883-01aa-4c08-86e7-db90137bb2b0" class="multiple-choice">
               <problem id="prob-00010">
                  <para><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>11</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para><para id="para-00052">What is the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>?</para>
                  <para id="para-00053">Enter the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>.</para>
               </problem>
               <solution id="sol-00010">
                  <para id="para-00054">Correct! <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
                  <para id="para-00055">Try again. Revisit activity 9.6.3.</para>
                  <para id="para-00056">The correct answer is <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_600c4806-8237-4672-ba70-4ce867334a0a" class="multiple-choice">
               <problem id="prob-00011">
                  <para id="para-00057">What is the value of <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>?</para>
                  <para id="para-00058">Enter the value of <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>.</para>
               </problem>
               <solution id="sol-00011">
                  <para id="para-00059">Correct! <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
                  <para id="para-00060">Try again. Revisit activity 9.6.3.</para>
                  <para id="para-00061">The correct answer is <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_28f83b83-5229-445f-b8c3-3875d1804f49" class="multiple-choice">
               <problem id="prob-00012">
                  <para id="para-00062">What is the value of <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math>?</para>
                  <para id="para-00063">Enter the value of <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math>.</para>
               </problem>
               <solution id="sol-00012">
                  <para id="para-00064">Correct! <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>11</m:mn></m:mrow></m:math></para>
                  <para id="para-00065">Try again. Revisit activity 9.6.3.</para>
                  <para id="para-00066">The correct answer is <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>11</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_25fe22a4-1dfc-4dba-bb76-3dbe28c1ac1f" class="multiple-choice">
               <problem id="prob-00013">
                  <para><m:math><m:mrow><m:mo>−</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>16</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>64</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para><para id="para-00068">What is the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>?</para>
                  <para id="para-00069">Enter the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>.</para>
               </problem>
               <solution id="sol-00013">
                  <para id="para-00070">Correct! <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
                  <para id="para-00071">Try again. Revisit activity 9.6.3.</para>
                  <para id="para-00072">The correct answer is <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="b7cb9b8e-e30e-4ba1-ad0b-6572fb1dc420" class="multiple-choice">
               <problem id="prob-00014">
                  <para id="para-00073">What is the value of <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>?</para>
                  <para id="para-00074">Enter the value of <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>.</para>
               </problem>
               <solution id="sol-00014">
                  <para id="para-00075">Correct! <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>16</m:mn></m:mrow></m:math></para>
                  <para id="para-00076">Try again. Revisit activity 9.6.3.</para>
                  <para id="para-00077">The correct answer is <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>16</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="_1c6a0962-99d3-4e56-8d1d-a4478ca972d4" class="multiple-choice">
               <problem id="prob-00015">
                  <para id="para-00078">What is the value of <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math>?</para>
                  <para id="para-00079">Enter the value of <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math>.</para>
               </problem>
               <solution id="sol-00015">
                  <para id="para-00080">Correct! <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mn>64</m:mn></m:mrow></m:math></para>
                  <para id="para-00081">Try again. Revisit activity 9.6.3.</para>
                  <para id="para-00082">The correct answer is <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mn>64</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="f77864d2-e184-434a-a512-d0802a423684" class="multiple-choice">
               <problem id="prob-00016">
                  <para id="para-00083">For each equation, use the quadratic formula to solve the equation, then choose the correct <emphasis>two</emphasis> solutions for <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>.</para>
                  <para><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>20</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para></problem>
               <solution id="sol-00016">
                  <para id="para-00085">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
                  <para id="para-00086">Try again. Revisit activities 9.6.3 and 9.6.4.</para>
                  <para id="para-00087">The correct answers are: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="c0bb28e4-e143-47f8-a065-fbd13b34ea2f" class="multiple-choice">
               <problem id="prob-00017">
                  <para><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>10</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>21</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para></problem>
               <solution id="sol-00017">
                  <para id="para-00089">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
                  <para id="para-00090">Try again. Revisit activities 9.6.3 and 9.6.4.</para>
                  <para id="para-00091">The correct answers are: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math>.</para>
               </solution>
            </exercise>
            <exercise id="fbc3e043-7ebc-4cf4-92f8-54248608bc2a" class="multiple-choice">
               <problem id="prob-00018">
                  <para><m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para></problem>
               <solution id="sol-00018">
                  <para id="para-00093">Correct! <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>6</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mrow><m:msqrt><m:mrow><m:mn>13</m:mn></m:mrow></m:msqrt></m:mrow><m:mrow><m:mn>6</m:mn></m:mrow></m:mfrac></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>6</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mfrac><m:mrow><m:msqrt><m:mrow><m:mn>13</m:mn></m:mrow></m:msqrt></m:mrow><m:mrow><m:mn>6</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
                  <para id="para-00094">Try again. Revisit activities 9.6.3 and 9.6.4.</para>
                  <para id="para-00095">The correct answers are: <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>6</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mrow><m:msqrt><m:mrow><m:mn>13</m:mn></m:mrow></m:msqrt></m:mrow><m:mrow><m:mn>6</m:mn></m:mrow></m:mfrac></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>6</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mfrac><m:mrow><m:msqrt><m:mrow><m:mn>13</m:mn></m:mrow></m:msqrt></m:mrow><m:mrow><m:mn>6</m:mn></m:mrow></m:mfrac></m:mrow></m:math>.</para>
