            <exercise id="f77864d2-e184-434a-a512-d0802a423684" class="multiple-choice">
               <problem id="prob-00016">
                  <para id="para-00083">For each equation, use the quadratic formula to solve the equation, then choose the correct <emphasis>two</emphasis> solutions for \(x\).</para>
                  <para id="para-00084">\(x^2+9x+20=0\)</para>
               </problem>
               <solution id="sol-00016">
                  <para id="para-00085">Correct! \(x=-4, x=-5\)</para>
                  <para id="para-00086">Try again. Revisit activities 9.6.3 and 9.6.4.</para>
                  <para id="para-00087">The correct answers are: \(x=-4, x=-5\).</para>
               </solution>
            </exercise>
            <exercise id="c0bb28e4-e143-47f8-a065-fbd13b34ea2f" class="multiple-choice">
               <problem id="prob-00017">
                  <para id="para-00088">\(x^2−10x+21=0\)</para>
               </problem>
               <solution id="sol-00017">
                  <para id="para-00089">Correct! \(x=3, x=7\)</para>
                  <para id="para-00090">Try again. Revisit activities 9.6.3 and 9.6.4.</para>
                  <para id="para-00091">The correct answers are: \(x=3, x=7\).</para>
