  <exercise data-content-id="fbc3e043-7ebc-4cf4-92f8-54248608bc2a" data-problem-type="multiselect" data-solution="[&quot;\\(\\frac{5}{6}+\\frac{\\sqrt{13}}{6}\\)&quot;, &quot;\\(\\frac{5}{6}-\\frac{\\sqrt{13}}{6}\\)&quot;]" data-solution-options="[&quot;\\(\\frac{13}{6}+\\frac{\\sqrt{5}}{6}\\)&quot;, &quot;-1&quot;, &quot;\\(\\frac{5}{6}-\\frac{\\sqrt{13}}{6}\\)&quot;, &quot;\\(\\frac{13}{6}-\\frac{\\sqrt{5}}{6}\\)&quot;, &quot;\\(-\\frac{18}{6}-3\\)&quot;, &quot;\\(\\frac{5}{6}+\\frac{\\sqrt{13}}{6}\\)&quot;, &quot;\\(\\frac{18}{6}-3\\)&quot;]">
    <problem>
      <para>\(3x^2−5x+1=0\)</para>
      </problem>
    <solution>
      <para>Correct! \(x=\frac{5}{6}+\frac{\sqrt{13}}{6}\), \(x=\frac{5}{6}-\frac{\sqrt{13}}{6}\)</para>
    </solution>
