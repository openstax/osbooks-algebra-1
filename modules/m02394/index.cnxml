          <para id="para-00033"><m:math><m:mrow><m:mn>10</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>37</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>36</m:mn></m:mrow></m:math></para><para id="para-00034"/>
