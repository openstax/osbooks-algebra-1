<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Finding the Missing Terms</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02202</md:content-id>
    <md:title>Finding the Missing Terms</md:title>
    <md:uuid>a380ea63-9c19-44fa-84e2-4d9d31403f1f</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
      <para id="para-00001">Here are pairs of equivalent expressions in standard form and factored form. Find the missing symbols and numbers.</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002"><m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mspace width="0.278em"/><m:mi>◻</m:mi><m:mspace width="0.278em"/><m:mn>16</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mi>◻</m:mi><m:mspace width="0.278em"/><m:mn>17</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>17</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00001">

          <para id="para-00004">Compare your answer: </para>
          <para id="para-00005">− and –. The completed expression is <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>16</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>17</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00006"><m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mspace width="0.278em"/><m:mi>◻</m:mi><m:mspace width="0.278em"/><m:mn>16</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mi>◻</m:mi><m:mspace width="0.278em"/><m:mn>17</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>17</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00002">

          <para id="para-00008">Compare your answer: </para>
          <para id="para-00009">+ and –, respectively. The completed expression is <m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>16</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>17</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010"><m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>28</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>◻</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mi>◻</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00003">

          <para id="para-00012">Compare your answer: </para>
          <para id="para-00013">7 and 4, respectively. The completed expression is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00014"><m:math display="inline"><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>12</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>28</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mi>◻</m:mi><m:mspace width="0.278em"/><m:mi>◻</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mi>◻</m:mi><m:mspace width="0.278em"/><m:mi>◻</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00004">

          <para id="para-00016">Compare your answer: </para>
          <para id="para-00017">−14 and +2. The completed expression is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>14</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>
