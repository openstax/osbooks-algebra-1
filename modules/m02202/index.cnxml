<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.7.4: Finding the Missing Terms</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02202</md:content-id>
    <md:title>8.7.4: Finding the Missing Terms</md:title>
    <md:uuid>a380ea63-9c19-44fa-84e2-4d9d31403f1f</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Cool Down Activity</title>
      <para id="para-00001">Here are pairs of equivalent expressions in standard form and factored form. Find the missing symbols and numbers.</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002">\(x^2\; \square\; 16x \;\square \;17\) and \((x + 1)(x − 17)\)</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Enter the missing symbols and/or numbers.</para>
          <para id="para-00004">Compare your answer:</para>
          <para id="para-00005">− and –. The completed expression is \(x^2− 16x − 17\).</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00006">\(x^2\; \square\; 16x\; \square\; 17\) and \((x − 1)(x + 17)\)</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00007">Enter the missing symbols and/or numbers.</para>
          <para id="para-00008">Compare your answer:</para>
          <para id="para-00009">+ and –, respectively. The completed expression is \(x^2+16x −17\).</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010">\(x^2+3x −28\) and \((x + \square)(x − \square)\)</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00011">Enter the missing symbols and/or numbers.</para>
          <para id="para-00012">Compare your answer:</para>
          <para id="para-00013">7 and 4, respectively. The completed expression is \((x + 7)(x − 4)\).</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00014">\(x^2−12x −28\) and \((x \;\square \;\square)(x \;\square \;\square)\)</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00015">Enter the missing symbols and/or numbers.</para>
          <para id="para-00016">Compare your answer:</para>
          <para id="para-00017">−14 and +2. The completed expression is \((x − 14)(x + 2)\).</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>