              <media alt="Graph of the equations y equals x squared minus six x plus 9, y equals three x squared minus eighteen x plus 9, and y equals thirteen x squared minus seventy-eight x squared plus 9">
                <image mime-type="image/jpeg" src="../../media/Algebra-1_08_19_03_04.jpg"/>
