<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.4.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01647</md:content-id>
    <md:title>6.4.6: Practice</md:title>
    <md:uuid>0b858d1d-4b51-4ac1-88e8-b486b1645417</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
<!--Do not edit this div tag.  It must surround the interaction block-->
<section id="sect-00002"><exercise id="_2735c058-1719-40b5-84c1-479d866f5979" class="multiple-choice"><problem id="prob-00001"><para id="para-00002">For questions 1 – 3, find the GCF of each set of expressions.</para><para id="para-00003">\(12m^2n^3, 30m^5n^3\)</para>
      <para id="para-00004">Multiple Choice:</para><para id="para-00005">\(6m^3n^3\)</para><para id="para-00006">\(3m^2n^3\)</para><para id="para-00007">\(2m^5n^3\)</para><para id="para-00008">\(6m^2n^3\)</para></problem><solution id="sol-00001"><para id="para-00009">Try again. Revisit 6.4.2.
    </para><para id="para-00010">The correct answer is \(6m^2n^3\).
    </para></solution></exercise>
      
      <exercise id="_2667a039-21b5-4c38-93c4-be189dd58369" class="multiple-choice"><problem id="prob-00002"><para id="para-00011">\(28x^2y^4,42x^4y^4\)</para>
      </problem><solution id="sol-00002"><para id="para-00012">Try again. Revisit 6.4.2.</para><para id="para-00013">The correct answer is \(14x^2y^4\).
    </para></solution></exercise>
      
      <exercise id="a625bb8e-7fba-4bfd-9cd1-1af33d00bd13" class="multiple-choice"><problem id="prob-00003"><para id="para-00014">\(27p^2q^3,45p^3q^4,9p^4q^3\)</para>
      <para id="para-00015">Multiple Choice:</para><para id="para-00016">\(9pq^3\)</para><para id="para-00017">\(27p^2q^3\)</para><para id="para-00018">\(9p^2q^3\)</para><para id="para-00019">\(9p^3q^3\)</para></problem><solution id="sol-00003"><para id="para-00020">Try again. Revisit 6.4.2.</para><para id="para-00021">The correct answer is \(9p^2q^3\).
    </para></solution></exercise>
      
      <exercise id="_36ad5933-035a-4174-a7d7-eaa6d643bcd4" class="multiple-choice"><problem id="prob-00004"><para id="para-00022">For questions 4 – 6, factor the expression.</para><para id="para-00023">\(15x^3y − 3x^2y^2 + 6xy^3\)</para>
      </problem><solution id="sol-00004"><para id="para-00024">Try again. Revisit 6.4.3.</para><para id="para-00025">The correct answer is \(3xy(5x^2 − xy + 2y^2)\).
    </para></solution></exercise>
      
      <exercise id="_2d84f6e7-1604-4c4e-87af-f51cb7f25a7e" class="multiple-choice"><problem id="prob-00005"><para id="para-00026">\(−7a^3 + 21a^2 − 14a\)</para>
      <para id="para-00027">Multiple Choice:</para><para id="para-00028">\(−7(a^2 − 3a + 2)\)</para><para id="para-00029">\(7a(a^2 − 3a + 2)\)</para><para id="para-00030">\(−7a^2(a − 1)\)</para><para id="para-00031">\(−7a(a^2 − 3a + 2)\)</para></problem><solution id="sol-00005"><para id="para-00032">Try again. Revisit 6.4.3.
    </para><para id="para-00033">The correct answer is \(−7a(a^2 − 3a + 2)\).
    </para></solution></exercise>
      
      <exercise id="b0cff426-ce62-4da9-aac2-9a39f5480436" class="multiple-choice"><problem id="prob-00006"><para id="para-00034">\(8n(n − 4) + 5(n − 4)\)</para>
      <para id="para-00035">Multiple Choice:</para><para id="para-00036">\((n + 4)(8n + 5)\)</para><para id="para-00037">\((n − 4)(8n − 5)\)</para><para id="para-00038">\((n − 4)(8n + 5)\)</para><para id="para-00039">\((8n − 4)(n + 5)\)</para></problem><solution id="sol-00006"><para id="para-00040">Try again. Revisit 6.4.3.</para><para id="para-00041">The correct answer is \((n − 4)(8n + 5)\).
    </para></solution></exercise>
      
      <exercise id="_38060fd7-1b83-4af9-aa1a-c9494dd4e792" class="multiple-choice"><problem id="prob-00007"><para id="para-00042">For questions 7–10, factor by grouping</para><para id="para-00043">\(u^2 − u + 6u − 6\)</para>
      <para id="para-00044">Multiple Choice:</para><para id="para-00045">\((u + 1)(u + 6)\)</para><para id="para-00046">\((u − 1)(u − 6)\)</para><para id="para-00047">\((u + 1)(u − 6)\)</para><para id="para-00048">\((u − 1)(u + 6)\)</para></problem><solution id="sol-00007"><para id="para-00049">Try again. Revisit 6.4.4.
    </para><para id="para-00050">The correct answer is \((u − 1)(u + 6)\).</para></solution></exercise>
      
      <exercise id="_97a3eb84-7ba4-48af-acdf-168758e1f68a" class="multiple-choice"><problem id="prob-00008"><para id="para-00051">\(16q^2 + 20q − 28q − 35\)</para>
      <para id="para-00052">Multiple Choice:</para><para id="para-00053">\((4q + 5)(4q + 7)\)</para><para id="para-00054">\((4q − 5)(4q + 7)\)</para><para id="para-00055">\((4q + 5)(4q − 7)\)</para><para id="para-00056">\((4q − 5)(4q − 7)\)</para></problem><solution id="sol-00008"><para id="para-00057">Try again. Revisit 6.4.4.
    </para><para id="para-00058">The correct answer is \((4q + 5)(4q − 7)\).</para></solution></exercise>
      
      <exercise id="_927fe5c9-46ee-43ee-95b3-a69c8b485400" class="multiple-choice"><problem id="prob-00009"><para id="para-00059">\(r^2 − 3r − r + 3\)</para>
      <para id="para-00060">Multiple Choice:</para><para id="para-00061">\((r − 3)(r − 1)\)</para><para id="para-00062">\((r + 3)(r + 1)\)</para><para id="para-00063">\((r − 3)(r + 1)\)</para><para id="para-00064">\((r + 3)(r − 1)\)</para></problem><solution id="sol-00009"><para id="para-00065">Try again. Revisit 6.4.4.
    </para><para id="para-00066">The correct answer is \((r − 3)(r − 1)\).
    </para></solution></exercise>
      
      <exercise id="_4d3ee55c-32a7-4e15-9946-d5d4247ad0bb" class="multiple-choice"><problem id="prob-00010"><para id="para-00067">\(6y^2 + 7y + 24y + 28\)</para>
      </problem><solution id="sol-00010"><para id="para-00068">Try again. Revisit 6.4.4.</para><para id="para-00069">The correct answer is \((6y + 7)(y + 4)\). You seem to be struggling. Who can you ask for help?</para></solution></exercise></section></section>
</content>
