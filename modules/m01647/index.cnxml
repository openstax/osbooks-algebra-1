  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<!--Do not edit this div tag.  It must surround the interaction block-->
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="2374747c-16a8-4d40-81ea-b6cb41b3bd45" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--q1-->
  <exercise data-content-id="2735c058-1719-40b5-84c1-479d866f5979" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(6m^2n^3\)" data-solution-options="[&quot;\\(6m^3n^3\\)&quot;, &quot;\\(3m^2n^3\\)&quot;, &quot;\\(2m^5n^3\\)&quot;, &quot;\\(6m^2n^3\\)&quot;]">
    <problem>
      <para><span id="docs-internal-guid-b364bda7-7fff-a96c-9b0b-13237cd0877d">For questions 1 – 3, find the GCF of each set of expressions.</span></para>
      <para>\(12m^2n^3, 30m^5n^3\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.4.2.
      </para>
    </div>
    </exercise>
  <!--q2-->
  <exercise data-content-id="2667a039-21b5-4c38-93c4-be189dd58369" data-problem-comparator="math" data-problem-type="input" data-solution="14x^2y^4">
    <problem>
      <para>\(28x^2y^4,42x^4y^4\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.4.2.</para>
    </div>
    </exercise>
  <!--q3-->
  <exercise data-content-id="a625bb8e-7fba-4bfd-9cd1-1af33d00bd13" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(9p^2q^3\)" data-solution-options="[&quot;\\(9pq^3\\)&quot;, &quot;\\(27p^2q^3\\)&quot;, &quot;\\(9p^2q^3\\)&quot;, &quot;\\(9p^3q^3\\)&quot;]">
    <problem>
      <para>\(27p^2q^3,45p^3q^4,9p^4q^3\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.4.2.</para>
    </div>
    </exercise>
  <!--q4-->
  <exercise data-content-id="36ad5933-035a-4174-a7d7-eaa6d643bcd4" data-problem-comparator="math" data-problem-type="input" data-solution="3xy(5x^2 - xy + 2y^2)">
    <problem>
      <para>For questions 4 – 6, factor the expression.</para>
      <para>\(15x^3y − 3x^2y^2 + 6xy^3\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.4.3.</para>
    </div>
    </exercise>
  <!--q5-->
  <exercise data-content-id="2d84f6e7-1604-4c4e-87af-f51cb7f25a7e" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(−7a(a^2 − 3a + 2)\)" data-solution-options="[&quot;\\(−7(a^2 − 3a + 2)\\)&quot;, &quot;\\(7a(a^2 − 3a + 2)\\)&quot;, &quot;\\(−7a^2(a − 1)\\)&quot;, &quot;\\(−7a(a^2 − 3a + 2)\\)&quot;]">
    <problem>
      <para>\(−7a^3 + 21a^2 − 14a\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.4.3.
      </para>
    </div>
    </exercise>
  <!--q6-->
  <exercise data-content-id="b0cff426-ce62-4da9-aac2-9a39f5480436" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((n − 4)(8n + 5)\)" data-solution-options="[&quot;\\((n + 4)(8n + 5)\\)&quot;, &quot;\\((n − 4)(8n − 5)\\)&quot;, &quot;\\((n − 4)(8n + 5)\\)&quot;, &quot;\\((8n − 4)(n + 5)\\)&quot;]">
    <problem>
      <para>\(8n(n − 4) + 5(n − 4)\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.4.3.</para>
    </div>
    </exercise>
   <!--q7-->
  <exercise data-content-id="38060fd7-1b83-4af9-aa1a-c9494dd4e792" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((u − 1)(u + 6)\)" data-solution-options="[&quot;\\((u + 1)(u + 6)\\)&quot;, &quot;\\((u − 1)(u − 6)\\)&quot;, &quot;\\((u + 1)(u − 6)\\)&quot;, &quot;\\((u − 1)(u + 6)\\)&quot;]">
    <problem>
      <para>For questions 7–10, factor by grouping</para>
      <para>\(u^2 − u + 6u − 6\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.4.4.
      </para>
    </div>
    </exercise>
  <!--q8-->
  <exercise data-content-id="97a3eb84-7ba4-48af-acdf-168758e1f68a" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((4q + 5)(4q − 7)\)" data-solution-options="[&quot;\\((4q + 5)(4q + 7)\\)&quot;, &quot;\\((4q − 5)(4q + 7)\\)&quot;, &quot;\\((4q + 5)(4q − 7)\\)&quot;, &quot;\\((4q − 5)(4q − 7)\\)&quot;]">
    <problem>
      <para>\(16q^2 + 20q − 28q − 35\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.4.4.
      </para>
    </div>
    </exercise>
  <!--q9-->
  <exercise data-content-id="927fe5c9-46ee-43ee-95b3-a69c8b485400" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((r − 3)(r − 1)\)" data-solution-options="[&quot;\\((r − 3)(r − 1)\\)&quot;, &quot;\\((r + 3)(r + 1)\\)&quot;, &quot;\\((r − 3)(r + 1)\\)&quot;, &quot;\\((r + 3)(r − 1)\\)&quot;]">
    <problem>
      <para>\(r^2 − 3r − r + 3\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.4.4.
      </para>
    </div>
    </exercise>
  <!--q10-->
  <exercise data-content-id="4d3ee55c-32a7-4e15-9946-d5d4247ad0bb" data-problem-comparator="math" data-problem-type="input" data-solution="(6y + 7)(y + 4)">
    <problem>
      <para>\(6y^2 + 7y + 24y + 28\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit 6.4.4.</para>
    </div>
    </exercise>
