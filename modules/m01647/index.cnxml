<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.4.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01647</md:content-id>
    <md:title>6.4.6: Practice</md:title>
    <md:uuid>0b858d1d-4b51-4ac1-88e8-b486b1645417</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
<!--Do not edit this div tag.  It must surround the interaction block-->
<section id="sect-00002"><exercise id="_2735c058-1719-40b5-84c1-479d866f5979" class="multiple-choice"><problem id="prob-00001"><para id="para-00002">For questions 1 – 3, find the GCF of each set of expressions.</para><para id="para-00003"><m:math><m:mrow><m:mn>12</m:mn><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>n</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo><m:mn>30</m:mn><m:msup><m:mi>m</m:mi><m:mn>5</m:mn></m:msup><m:msup><m:mi>n</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para>
      <para id="para-00004">Multiple Choice:</para><para id="para-00005"><m:math><m:mrow><m:mn>6</m:mn><m:msup><m:mi>m</m:mi><m:mn>3</m:mn></m:msup><m:msup><m:mi>n</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para><para id="para-00006"><m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>n</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para><para id="para-00007"><m:math><m:mrow><m:mn>2</m:mn><m:msup><m:mi>m</m:mi><m:mn>5</m:mn></m:msup><m:msup><m:mi>n</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para><para id="para-00008"><m:math><m:mrow><m:mn>6</m:mn><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>n</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para></problem><solution id="sol-00001"><para id="para-00009">Try again. Revisit 6.4.2.
    </para><para id="para-00010">The correct answer is <m:math display="inline"><m:mrow><m:mn>6</m:mn><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>n</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_2667a039-21b5-4c38-93c4-be189dd58369" class="multiple-choice"><problem id="prob-00002"><para id="para-00011"><m:math><m:mrow><m:mn>28</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>y</m:mi><m:mn>4</m:mn></m:msup><m:mo>,</m:mo><m:mn>42</m:mn><m:msup><m:mi>x</m:mi><m:mn>4</m:mn></m:msup><m:msup><m:mi>y</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:math></para>
      </problem><solution id="sol-00002"><para id="para-00012">Try again. Revisit 6.4.2.</para><para id="para-00013">The correct answer is <m:math display="inline"><m:mrow><m:mn>14</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>y</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="a625bb8e-7fba-4bfd-9cd1-1af33d00bd13" class="multiple-choice"><problem id="prob-00003"><para id="para-00014"><m:math><m:mrow><m:mn>27</m:mn><m:msup><m:mi>p</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>q</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo><m:mn>45</m:mn><m:msup><m:mi>p</m:mi><m:mn>3</m:mn></m:msup><m:msup><m:mi>q</m:mi><m:mn>4</m:mn></m:msup><m:mo>,</m:mo><m:mn>9</m:mn><m:msup><m:mi>p</m:mi><m:mn>4</m:mn></m:msup><m:msup><m:mi>q</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para>
      <para id="para-00015">Multiple Choice:</para><para id="para-00016"><m:math><m:mrow><m:mn>9</m:mn><m:mi>p</m:mi><m:msup><m:mi>q</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para><para id="para-00017"><m:math><m:mrow><m:mn>27</m:mn><m:msup><m:mi>p</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>q</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para><para id="para-00018"><m:math><m:mrow><m:mn>9</m:mn><m:msup><m:mi>p</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>q</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para><para id="para-00019"><m:math><m:mrow><m:mn>9</m:mn><m:msup><m:mi>p</m:mi><m:mn>3</m:mn></m:msup><m:msup><m:mi>q</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para></problem><solution id="sol-00003"><para id="para-00020">Try again. Revisit 6.4.2.</para><para id="para-00021">The correct answer is <m:math display="inline"><m:mrow><m:mn>9</m:mn><m:msup><m:mi>p</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>q</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_36ad5933-035a-4174-a7d7-eaa6d643bcd4" class="multiple-choice"><problem id="prob-00004"><para id="para-00022">For questions 4 – 6, factor the expression.</para><para id="para-00023"><m:math><m:mrow><m:mn>15</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para>
      </problem><solution id="sol-00004"><para id="para-00024">Try again. Revisit 6.4.3.</para><para id="para-00025">The correct answer is <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mi>y</m:mi><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mi>x</m:mi><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_2d84f6e7-1604-4c4e-87af-f51cb7f25a7e" class="multiple-choice"><problem id="prob-00005"><para id="para-00026"><m:math><m:mrow><m:mi>−</m:mi><m:mn>7</m:mn><m:msup><m:mi>a</m:mi><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:mn>21</m:mn><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>14</m:mn><m:mi>a</m:mi></m:mrow></m:math></para>
      <para id="para-00027">Multiple Choice:</para><para id="para-00028"><m:math><m:mrow><m:mi>−</m:mi><m:mn>7</m:mn><m:mo stretchy="false">(</m:mo><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>3</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00029"><m:math><m:mrow><m:mn>7</m:mn><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>3</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00030"><m:math><m:mrow><m:mi>−</m:mi><m:mn>7</m:mn><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00031"><m:math><m:mrow><m:mi>−</m:mi><m:mn>7</m:mn><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>3</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00005"><para id="para-00032">Try again. Revisit 6.4.3.
    </para><para id="para-00033">The correct answer is <m:math display="inline"><m:mrow><m:mi>−</m:mi><m:mn>7</m:mn><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>3</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="b0cff426-ce62-4da9-aac2-9a39f5480436" class="multiple-choice"><problem id="prob-00006"><para id="para-00034"><m:math><m:mrow><m:mn>8</m:mn><m:mi>n</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
      <para id="para-00035">Multiple Choice:</para><para id="para-00036"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00037"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mi>n</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00038"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00039"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mi>n</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00006"><para id="para-00040">Try again. Revisit 6.4.3.</para><para id="para-00041">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mi>−</m:mi><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_38060fd7-1b83-4af9-aa1a-c9494dd4e792" class="multiple-choice"><problem id="prob-00007"><para id="para-00042">For questions 7–10, factor by grouping</para><para id="para-00043"><m:math><m:mrow><m:msup><m:mi>u</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mi>u</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>u</m:mi><m:mi>−</m:mi><m:mn>6</m:mn></m:mrow></m:math></para>
      <para id="para-00044">Multiple Choice:</para><para id="para-00045"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00046"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00047"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00048"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00007"><para id="para-00049">Try again. Revisit 6.4.4.
    </para><para id="para-00050">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>u</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_97a3eb84-7ba4-48af-acdf-168758e1f68a" class="multiple-choice"><problem id="prob-00008"><para id="para-00051"><m:math><m:mrow><m:mn>16</m:mn><m:msup><m:mi>q</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>20</m:mn><m:mi>q</m:mi><m:mi>−</m:mi><m:mn>28</m:mn><m:mi>q</m:mi><m:mi>−</m:mi><m:mn>35</m:mn></m:mrow></m:math></para>
      <para id="para-00052">Multiple Choice:</para><para id="para-00053"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>q</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>q</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00054"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>q</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>q</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00055"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>q</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>q</m:mi><m:mi>−</m:mi><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00056"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>q</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>q</m:mi><m:mi>−</m:mi><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00008"><para id="para-00057">Try again. Revisit 6.4.4.
    </para><para id="para-00058">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>q</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>q</m:mi><m:mi>−</m:mi><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_927fe5c9-46ee-43ee-95b3-a69c8b485400" class="multiple-choice"><problem id="prob-00009"><para id="para-00059"><m:math><m:mrow><m:msup><m:mi>r</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>3</m:mn><m:mi>r</m:mi><m:mi>−</m:mi><m:mi>r</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
      <para id="para-00060">Multiple Choice:</para><para id="para-00061"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>r</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>r</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00062"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>r</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>r</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00063"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>r</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>r</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00064"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>r</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>r</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00009"><para id="para-00065">Try again. Revisit 6.4.4.
    </para><para id="para-00066">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>r</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>r</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.
    </para></solution></exercise>
      
      <exercise id="_4d3ee55c-32a7-4e15-9946-d5d4247ad0bb" class="multiple-choice"><problem id="prob-00010"><para id="para-00067"><m:math><m:mrow><m:mn>6</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>24</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>28</m:mn></m:mrow></m:math></para>
      </problem><solution id="sol-00010"><para id="para-00068">Try again. Revisit 6.4.4.</para><para id="para-00069">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>. You seem to be struggling. Who can you ask for help?</para></solution></exercise></section></section>
