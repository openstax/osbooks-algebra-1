<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.6.4: Finding the Missing Numbers in Pairs of Equivalent Expressions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02184</md:content-id>
    <md:title>8.6.4: Finding the Missing Numbers in Pairs of Equivalent Expressions</md:title>
    <md:uuid>bde116a1-05ea-4f0d-b831-6e7f8b51f078</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Cool Down Activity</title>
      <para id="para-00001">The problems below consist of pairs of equivalent expressions: one in standard form and the other in factored form. Note that the leading coefficients on the quadratic terms are all 1.</para>
      <para id="para-00002">Find the missing numbers.</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00003">\(x^2 \;+\) __\(x\;+\) __ and \((x + 1)(x + 17)\)</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00004">Enter the missing numbers.</para>
          <para id="para-00005">Compare your answer:</para>
          <para id="para-00006">18 and 17, respectively. The completed expression is \(x^2+18x +17\).</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00007">\(x^2+9x +14\) and \((x + 2)(x\; +\) __\()\)</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00008">Enter the missing number.</para>
          <para id="para-00009">Compare your answer:</para>
          <para id="para-00010">7. The completed expression is \((x + 2)(x + 7)\).</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00011">\(x^2−7x +10\) and \((x − 2)(x\; −\) __\()\)</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00012">Enter the missing number.</para>
          <para id="para-00013">Compare your answer:</para>
          <para id="para-00014">5. The completed expression is \((x − 2)(x − 5)\).</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00015">\(x^2−9x +20\) and \((x\; −\) __)\((x\; −\) __\()\)</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00016">Enter the missing numbers.</para>
          <para id="para-00017">Compare your answer:</para>
          <para id="para-00018">4 and 5. The completed expression is \((x − 4)(x − 5)\).</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>