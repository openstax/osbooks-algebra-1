  <title>8.10.4: Finding the Factors of Quadratic Expressions in Standard Form</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02257</md:content-id>
    <md:title>8.10.4: Finding the Factors of Quadratic Expressions in Standard Form</md:title>
    <md:uuid>697cb582-e751-4974-88c9-2c0581825d64</md:uuid>
  </metadata>
  <content>
