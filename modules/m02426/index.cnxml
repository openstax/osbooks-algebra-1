<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.6.2: Choosing the Best Method to Solve an Equation</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02426</md:content-id>
    <md:title>9.6.2: Choosing the Best Method to Solve an Equation</md:title>
    <md:uuid>a3945eeb-e404-4b74-b29a-8a651bee77cc</md:uuid>
  </metadata>
  <content>
  <section><title>Activity</title>
<para>Write down your answer for how to solve each equation. Find the two solutions by rewriting it in factored form or by <term data-schema-version="“1.0”" data-store="glossary-tooltip">completing the square</term>. Be prepared to explain your choice of method.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="a49e9cb3-f014-4e93-9a65-c231f46a0e34" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1-->
  <exercise data-content-id="0f5f4561-b47a-455e-8062-8d0aba4397b0" data-problem-type="multiselect" data-solution="[&quot;2.5&quot;, &quot;-0.5&quot;]" data-solution-options="[&quot;2.5&quot;, &quot;3&quot;, &quot;-1&quot;,&quot;-0.5&quot;]">
    <problem>
      <para><emphasis>Select two</emphasis> solutions for \(x^2−2x−1.25=0\).</para>
      </problem>
    <solution>
      <para>Correct! 2.5, -0.5 </para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>
<example><exercise>
  <problem> 
    <para>Select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>Completing the square method:</para>
  <para>\(\begin{array}{rcl} x^{2}-2 x-1.25 &amp;=&amp;0 \\
    x^{2}-2 x &amp;=&amp;1.25 \\
    x^{2}-2 x+\left(\frac{-2}{2}\right)^{2} &amp;=&amp;1.25+\left(\frac{-2}{2}\right)^{2} \\
    x^{2}-2 x+1 &amp;=&amp;1.25+1 \\
    x^{2}-2 x+1 &amp;=&amp;2.25 \\
    (x-1)^{2} &amp;=&amp;2.25 \\
    \sqrt{(x-1)^{2}} &amp;=&amp;\sqrt{2.25} \\
    x-1 &amp;=&amp;\pm \sqrt{2.25} \\
    x &amp;=&amp;1 \pm \sqrt{2.25} \\
    x &amp;=&amp;1 \pm 1.5 \\
    x &amp;=&amp;1+1.5 \\
    x &amp;=&amp;1-1.5 \\
    x &amp;=&amp;2.5 \\
    x &amp;=&amp;-0.5 \\ x&amp;=&amp;2.5 \text { and } x=-0.5
    \end{array}\)</para>
</solution></exercise>
</example><div class="os-raise-ib-pset" data-button-text="Check" data-content-id="02414f06-1765-4a1a-9c43-3c5e18c22338" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q2-->
  <exercise data-content-id="60245351-60e4-44c6-982f-dba2c5c5710a" data-problem-type="multiselect" data-solution="[&quot;2.2&quot;, &quot;-4&quot;]" data-solution-options="[&quot;2.2&quot;, &quot;-20&quot;, &quot;-4&quot;,&quot;11&quot;]">
    <problem>
      <para><emphasis>Select two</emphasis> solutions for \(5x^2+9x−44=0\).</para>
      </problem>
    <solution>
      <para>Correct! 2.2, -4 </para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>
<example><exercise>
  <problem> 
    <para>Select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>Completing the square method:</para>
  <para>\(\begin{array}{rcl} 5 x^{2}+9 x-44 &amp;=&amp;0 \\
    5 x^{2}+9 x &amp;=&amp;44 \\
    \frac{5 x^{2}+9 x}{5} &amp;=&amp;\frac{44}{5} \\
    x^{2}+\frac{9}{5} x+\left(\frac{1}{2} \cdot \frac{9}{5}\right)^{2} &amp;=&amp;\frac{44}{5}+\left(\frac{1}{2} \cdot \frac{9}{5}\right)^{2} \\
    x^{2}+\frac{9}{5} x+\frac{81}{100} &amp;=&amp;\frac{44}{5}+\frac{81}{100} \\
    x^{2}+\frac{9}{5} x+\frac{81}{100} &amp;=&amp;\frac{961}{100} \\
    \left(x+\frac{9}{10}\right)^{2} &amp;=&amp;\frac{961}{100} \\
    \sqrt{\left(x+\frac{9}{10}\right)^{2}} &amp;=&amp;\sqrt{\frac{961}{100}} \\
    x+\frac{9}{10} &amp;=&amp;\pm \frac{31}{10} \\
    x &amp;=&amp;-\frac{9}{10} \pm \frac{31}{10} \\
    x &amp;=&amp;-\frac{9}{10}+\frac{31}{10} \\
    x &amp;=&amp;-\frac{9}{10}-\frac{31}{10} \\
    x &amp;=&amp;\frac{22}{10}=2.2\\
    x&amp;=&amp;-\frac{40}{10}=-4 \\
    x&amp;=&amp;2.2 \text { and } x=-4
    \end{array}\)</para>
</solution></exercise>
</example><div class="os-raise-ib-pset" data-button-text="Check" data-content-id="b34ecdc2-a9a6-4ec3-b963-6d1c7471ee4a" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q3-->
  <exercise data-content-id="e9061560-631d-4849-8168-d06ba9152699" data-problem-type="multiselect" data-solution="[&quot;0.25&quot;, &quot;-1.5&quot;]" data-solution-options="[&quot;0.75&quot;, &quot;0.25&quot;, &quot;-1.5&quot;,&quot;2.5&quot;]">
    <problem>
      <para><emphasis>Select two </emphasis>solutions for \(x^2+1.25x=0.375\).</para>
      </problem>
    <solution>
      <para>Correct! 0.25, -1.5 </para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>
<example><exercise>
  <problem> 
    <para>Select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>Completing the square method:</para>
  <para>\(\begin{aligned} x^{2}+1.25 x &amp;=0.375 \\ x^{2}+1.25 x+((0.5)(1.25))^{2} &amp;=0.375+((0.5)(1.25)){ }^{2} \\ x^{2}+1.25 x+0.390625 &amp;=0.375+0.390625 \\ (x+0.625)^{2} &amp;=0.765625 \\ \sqrt{(x+0.625)^{2}} &amp;=\sqrt{0.765625} \\ x+0.625 &amp;=\pm 0.875 \\ x &amp;=-0.625 \pm 0.875 \\ x &amp;=-0.625+0.875 \\ x &amp;=-0.625-0.875 \\ x &amp;=0.25 \\ x &amp;=-1.5 \\ x=0.25 &amp; \text { and } x=-1.5 \end{aligned}\) </para>
</solution></exercise>
</example><div class="os-raise-ib-pset" data-button-text="Check" data-content-id="10a3e25d-0f6f-447d-96d9-4ac06d49748a" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">

  ----------------------------------------



  <!--Q#-->
  <exercise data-content-id="f681bad2-7daa-463f-b9d9-36a177312aca" data-problem-type="multiselect" data-solution="[&quot;\\(\\frac{7}{2}+\\sqrt{5}\\)&quot;, &quot;\\(\\frac{7}{2}-\\sqrt{5}\\)&quot;]" data-solution-options="[&quot;\\(-7+\\sqrt{2}\\)&quot;, &quot;\\(7-\\sqrt{2}\\)&quot;, &quot;\\(\\frac{7}{2}+\\sqrt{5}\\)&quot;,&quot;\\(\\frac{7}{2}-\\sqrt{5}\\)&quot;]">
    <problem>
      <para><emphasis>Select two</emphasis> solutions for \(4x^2−28x+29=0\).</para>
      </problem>
    <solution>
      <para>Correct! \(\frac{7}{2}+ \sqrt {5}\), \(\frac{7}{2}- \sqrt {5}\) </para>
    </solution>
    </exercise>
  <!--END QUESTION.-->



  ------------------------------------
  <!--Do not edit below line.-->
  <solution>
