    <md:content-id>m02426</md:content-id>
    <md:title>9.6.2: Choosing the Best Method to Solve an Equation</md:title>
    <md:uuid>310002fb-a2ae-4f1c-ae5e-2c23dd0c91fd</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">      <title>Activity</title>
