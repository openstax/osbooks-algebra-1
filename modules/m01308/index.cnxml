      <para>Try again. Revisit activity 5.4.3.
      </para>
    </div>
    </exercise>
  <!--3d-->
  <exercise data-content-id="d90e4d30-5f4f-4a37-9db9-adbe0138fda2" data-problem-type="dropdown" data-retry-limit="5" data-solution="$2000" data-solution-options="[&quot;$1000&quot;, &quot;$1250&quot;, &quot;$1500&quot;, &quot;$1750&quot;, &quot;$2000&quot;, &quot;$2250&quot;]">
    <problem>
