  <section>
    <section class="check-understanding">
      <exercise data-content-id="a4b3df1e-787b-4380-9bea-e052f15d2675">
        <problem>
          <para>
      <para>Which expression is equal to \(4^0\cdot 4^2\)? </para>
      </para>
          <para>Multiple Choice:</para>
          <para>0</para>
          <para>1</para>
          <para>16</para>
          <para>64</para>
        </problem>
        <solution>
          <para>16</para>
          <para>
      <para>The correct answer is 16. </para>
    </para>
        </solution>
      </exercise>
    </section>
  </section>
