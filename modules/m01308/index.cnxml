  <!--Q4-->
  <exercise data-content-id="92cb5906-4754-4d01-bfe0-8e2dcc47c7a1" data-problem-comparator="integer" data-problem-type="input" data-solution="6">
    <problem>
      <para>An investment bond is initially bought for $250. It doubles in value every decade. How many decades does it take before the bond is worth more than $10,000?
          <emphasis> </emphasis>
        </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.4.4.
      </para>
    </div>
    </exercise>
  <!--Q5-->
  <exercise data-content-id="ecb5e1c2-e194-4527-a10d-fe2ece40c6f4" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(V = 250\cdot 2^d\)" data-solution-options="[&quot;\\(V = 250\\cdot d^2\\)&quot;, &quot;\\(V = 500^d\\)&quot;, &quot;\\(V = 250\\cdot 2\\cdot d\\)&quot;, &quot;\\(V = 250\\cdot 2^d\\)&quot;]">
    <problem>
      <para>An investment bond is initially bought for $250. It doubles in value every decade. Choose an equation that relates \(V\), the value of the bond, to \(d\), the number of decades since the bond was bought.</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.4.4.
      </para>
    </div>
    </exercise>
  <!--Q6-->
  <exercise data-content-id="602114a2-6812-4d50-ac86-abf520e824f7" data-problem-comparator="integer" data-problem-type="input" data-solution="400">
    <problem>
      <para>A sea turtle population \(p\) is modeled by the equation \(p=400\cdot(1.25)^y\) where \(y\) is the number of years since the population was first measured. How many turtles are in the population when it is first measured? </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.4.5.
      </para>
    </div>
    </exercise>
  <!--Q7-->
  <exercise data-content-id="befadee8-0d0a-4180-841a-c64efb4bcd0e" data-problem-comparator="integer" data-problem-type="input" data-solution="3">
    <problem>
      <para>A sea turtle population \(p\) is modeled by the equation \(p=400\cdot(1.25)^y\) where \(y\) is the number of years since the population was first measured. After how many years will the turtle population reach 700? Round to the nearest full year. <emphasis> </emphasis></para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.4.5.
      </para>
    </div>
    </exercise>
  <!--8a-->
  <exercise data-content-id="f1c4dd95-dbd4-48cb-96bc-51a8da17ade4" data-problem-type="dropdown" data-retry-limit="1" data-solution="Bank Account A" data-solution-options="[&quot;Bank Account A&quot;, &quot;Bank Account B&quot;]">
    <problem>
      <para>Use the following information to answer questions 11 and 12.</para>
      <blockquote>
        <item>Bank Account A starts with $5,000 and grows by $1,000 each week. Bank Account B starts with $1 and doubles each week.</item>
      </blockquote>
      <para>Which account has more money after one week? </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.4.3.
      </para>
    </div>
    </exercise>
  <!--8b-->
  <exercise data-content-id="aaba644a-2de8-49da-b103-d5590f6e3b68" data-problem-type="dropdown" data-retry-limit="1" data-solution="Bank Account B" data-solution-options="[&quot;Bank Account A&quot;, &quot;Bank Account B&quot;]">
    <problem>
      <para>Which account has more money after fifteen weeks?
        </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.4.4
      </para>
    </div>
    </exercise>
  <!--8c-->
  <exercise data-content-id="cfb66877-9a06-47a9-a574-ae7b93143c0f" data-problem-type="dropdown" data-retry-limit="1" data-solution="Bank Account A" data-solution-options="[&quot;Bank Account A&quot;, &quot;Bank Account B&quot;]">
    <problem>
      <para>For 13 - 15, use this graph showing the two account balances.</para>
      
      <blockquote>
        <para><figure><media alt="Graph of 2 discrete lines, origin O, with grid. Number of weeks and amount in dollars."><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/8a449ca635a6ee10b3f30217c5fe42a556930ad1"/></media></figure></para>
      </blockquote>
      <para>The graph of the red triangles corresponds to which bank account?
          </para>
        </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.4.3.
      </para>
    </div>
    </exercise>
  <!--8d-->
  <exercise data-content-id="196be8d6-bcb3-4cb6-8881-9a9d61028274" data-problem-type="dropdown" data-retry-limit="1" data-solution="Bank Account B" data-solution-options="[&quot;Bank Account A&quot;, &quot;Bank Account B&quot;]">
