  <!--8e-->
  <exercise data-content-id="baedeabc-d833-4d6f-a783-aec840a78031" data-problem-type="dropdown" data-retry-limit="1" data-solution="Bank Account B" data-solution-options="[&quot;Bank Account A&quot;, &quot;Bank Account B&quot;]">
