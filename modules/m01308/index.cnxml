  <content>
  <section>
    <div class="os-raise-ib-pset" data-button-text="Check" data-content-id="dc3861f8-4b34-4ccc-aa1b-d8301a45a730" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--q1-->
  <exercise data-content-id="a4b3df1e-787b-4380-9bea-e052f15d2675" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="16" data-solution-options="[&quot;0&quot;, &quot;1&quot;, &quot;16&quot;, &quot;64&quot;]">
    <problem>
      <para>Which expression is equal to \(4^0\cdot 4^2\)? </para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.4.2.
      </para>
    </div>
    </exercise>
  <!--q2-->
  <exercise data-content-id="0bfb4b3e-7996-4284-a129-89b0f79266ff" data-problem-type="multiselect" data-solution="[&quot;\\(\\frac{3^{10}}{3^2}\\)&quot;, &quot;\\(\\left(3^4\\right)^2\\)&quot;, &quot;\\(\\left(3\\cdot3\\right)^4\\)&quot;]" data-solution-options="[&quot;\\(8^3\\)&quot;, &quot;\\(\\frac{3^{10}}{3^2}\\)&quot;, &quot;\\(3\\cdot 8\\)&quot;, &quot;\\(\\left(3^4\\right)^2\\)&quot;, &quot;\\(\\left(3\\cdot3\\right)^4\\)&quot;, &quot;\\(\\frac1{3^8}\\)&quot;]">
    <problem>
      <para><emphasis>Select three </emphasis>expressions that are equivalent to \(3^8\).</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.4.1.
      </para>
    </div>
    </exercise>
  <!--3a-->
  <exercise data-content-id="8217780b-cc22-4080-89a5-6eb722331b06" data-problem-type="dropdown" data-retry-limit="3" data-solution="$250" data-solution-options="[&quot;$0&quot;, &quot;$250&quot;, &quot;$500&quot;, &quot;$750&quot;]">
    <problem>
      <para>For 3 - 6 use the following table:</para>
      <blockquote>
        <para>An investment bond is initially bought for $250. It doubles in value every decade. For each of the missing spaces in the table, a–d, select the missing value that helps complete the table.</para>
        
        <table class="os-raise-wideequaltable">
          <thead>
            <row>
              <entry scope="col" class="emphasis">
                <para>decades since bond is bought</para>
              </entry>
              <entry scope="col" class="emphasis">
                <para>dollar value of bond</para>
              </entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <para>0</para>
              </entry>
              <entry>
                <para>3. _____</para>
              </entry>
            </row>
            <row>
              <entry>
                <para>1</para>
              </entry>
              <entry>
                <para>4. _____</para>
              </entry>
            </row>
            <row>
              <entry>
                <para>2</para>
              </entry>
              <entry>
                <para>5. _____</para>
              </entry>
            </row>
            <row>
              <entry>
                <para>3</para>
              </entry>
              <entry>
                <para>6. _____</para>
              </entry>
            </row>
          </tbody>
        </table>
      </blockquote>
      
      <para>The dollar value of the bond, 0 decades</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.4.3.
      </para>
    </div>
    </exercise>
  <!--3b-->
  <exercise data-content-id="ed13f0be-b6d2-4248-b7b7-4f4de2869ec9" data-problem-type="dropdown" data-retry-limit="4" data-solution="$500" data-solution-options="[&quot;$0&quot;, &quot;$250&quot;, &quot;$500&quot;, &quot;$750&quot;, &quot;$1000&quot;]">
    <problem>
      <para>The dollar value of the bond, 1 decade</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 5.4.3.
      </para>
    </div>
    </exercise>
  <!--3c-->
  <exercise data-content-id="28f93dea-534f-417c-9a03-03d889af215c" data-problem-type="dropdown" data-retry-limit="4" data-solution="$1000" data-solution-options="[&quot;$500&quot;, &quot;$750&quot;, &quot;$1000&quot;, &quot;$1250&quot;, &quot;$1500&quot;]">
    <problem>
      <para>The dollar value of the bond, 2 decades</para>
