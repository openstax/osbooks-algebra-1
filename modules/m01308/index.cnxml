<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.4.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01308</md:content-id>
    <md:title>5.4.6: Practice</md:title>
    <md:uuid>399a79e5-86ab-447c-ab5f-1d605f2e7fad</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
        <exercise id="a4b3df1e-787b-4380-9bea-e052f15d2675" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00001">Which expression is equal to <m:math display="inline"><m:mrow><m:msup><m:mn>4</m:mn><m:mn>0</m:mn></m:msup><m:mi>·</m:mi><m:msup><m:mn>4</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math>?</para>
            <para id="para-00002">Multiple Choice:</para>
            <para id="para-00003">0</para>
            <para id="para-00004">1</para>
            <para id="para-00005">16</para>
            <para id="para-00006">64</para>
          </problem>
          <solution id="sol-00001">
            
            <para id="para-00007">Try again. Revisit activity 5.4.2.
    </para>
            <para id="para-00008">The correct answer is 16.</para>
          </solution>
        </exercise>
        <exercise id="_0bfb4b3e-7996-4284-a129-89b0f79266ff" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00009"><emphasis>Select three</emphasis> expressions that are equivalent to <m:math display="inline"><m:mrow><m:msup><m:mn>3</m:mn><m:mn>8</m:mn></m:msup></m:mrow></m:math>.</para>
          </problem>
          <solution id="sol-00002">
            
            <para id="para-00010">Try again. Revisit activity 5.4.1.
    </para>
            <para id="para-00011">The correct answer is <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:msup><m:mn>3</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:msup></m:mrow><m:mrow><m:msup><m:mn>3</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:msup><m:mrow><m:mo stretchy="true" fence="true" form="prefix">(</m:mo><m:msup><m:mn>3</m:mn><m:mn>4</m:mn></m:msup><m:mo stretchy="true" fence="true" form="postfix">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:msup><m:mrow><m:mo stretchy="true" fence="true" form="prefix">(</m:mo><m:mn>3</m:mn><m:mi>·</m:mi><m:mn>3</m:mn><m:mo stretchy="true" fence="true" form="postfix">)</m:mo></m:mrow><m:mn>4</m:mn></m:msup></m:mrow></m:math>.
    </para>
          </solution>
        </exercise>
        <exercise id="_8217780b-cc22-4080-89a5-6eb722331b06" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00012">For 3 - 6 use the following table:</para>
            <para id="para-00013">
              <quote id="quote-00001">An investment bond is initially bought for $250. It doubles in value every decade. For each of the missing spaces in the table, a–d, select the missing value that helps complete the table.</quote>
          </para>
            <para id="para-00014">The dollar value of the bond, 0 decades</para>
          </problem>
          <solution id="sol-00003">
            
            <para id="para-00015">Try again. Revisit activity 5.4.3.
    </para>
            <para id="para-00016">The correct answer is $250.
    </para>
          </solution>
        </exercise>
        <exercise id="ed13f0be-b6d2-4248-b7b7-4f4de2869ec9" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00017">The dollar value of the bond, 1 decade</para>
          </problem>
          <solution id="sol-00004">
            
            <para id="para-00018">Try again. Revisit activity 5.4.3.
    </para>
            <para id="para-00019">The correct answer is $500.
    </para>
          </solution>
        </exercise>
        <exercise id="_28f93dea-534f-417c-9a03-03d889af215c" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00020">The dollar value of the bond, 2 decades</para>
          </problem>
          <solution id="sol-00005">
            
            <para id="para-00021">Try again. Revisit activity 5.4.3.
    </para>
            <para id="para-00022">The correct answer is $1,000.
    </para>
          </solution>
        </exercise>
        <exercise id="d90e4d30-5f4f-4a37-9db9-adbe0138fda2" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00023">The dollar value of the bond, 3 decades</para>
          </problem>
          <solution id="sol-00006">
            
            <para id="para-00024">Try again. Revisit activity 5.4.3.
    </para>
            <para id="para-00025">The correct answer is $2,000.
    </para>
          </solution>
        </exercise>
        <exercise id="_92cb5906-4754-4d01-bfe0-8e2dcc47c7a1" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00026">An investment bond is initially bought for $250. It doubles in value every decade. How many decades does it take before the bond is worth more than $10,000?
          
      </para>
          </problem>
          <solution id="sol-00007">
            
            <para id="para-00027">Try again. Revisit activity 5.4.4.
    </para>
            <para id="para-00028">The correct answer is 6.
    </para>
          </solution>
        </exercise>
        <exercise id="ecb5e1c2-e194-4527-a10d-fe2ece40c6f4" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00029">An investment bond is initially bought for $250. It doubles in value every decade. Choose an equation that relates <m:math display="inline"><m:mrow><m:mi>V</m:mi></m:mrow></m:math>, the value of the bond, to <m:math display="inline"><m:mrow><m:mi>d</m:mi></m:mrow></m:math>, the number of decades since the bond was bought.</para>
            <para id="para-00030">Multiple Choice:</para>
            <para id="para-00031"><m:math><m:mrow><m:mi>V</m:mi><m:mo>=</m:mo><m:mn>250</m:mn><m:mi>·</m:mi><m:msup><m:mi>d</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
            <para id="para-00032"><m:math><m:mrow><m:mi>V</m:mi><m:mo>=</m:mo><m:msup><m:mn>500</m:mn><m:mi>d</m:mi></m:msup></m:mrow></m:math></para>
            <para id="para-00033"><m:math><m:mrow><m:mi>V</m:mi><m:mo>=</m:mo><m:mn>250</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mi>d</m:mi></m:mrow></m:math></para>
            <para id="para-00034"><m:math><m:mrow><m:mi>V</m:mi><m:mo>=</m:mo><m:mn>250</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mi>d</m:mi></m:msup></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00008">
            
            <para id="para-00035">Try again. Revisit activity 5.4.4.
    </para>
            <para id="para-00036">The correct answer is <m:math display="inline"><m:mrow><m:mi>V</m:mi><m:mo>=</m:mo><m:mn>250</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mi>d</m:mi></m:msup></m:mrow></m:math>.
    </para>
          </solution>
        </exercise>
        <exercise id="_602114a2-6812-4d50-ac86-abf520e824f7" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00037">A sea turtle population <m:math display="inline"><m:mrow><m:mi>p</m:mi></m:mrow></m:math> is modeled by the equation <m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>400</m:mn><m:mi>·</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1.25</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mi>y</m:mi></m:msup></m:mrow></m:math> where <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> is the number of years since the population was first measured. How many turtles are in the population when it is first measured?</para>
          </problem>
          <solution id="sol-00009">
            
            <para id="para-00038">Try again. Revisit activity 5.4.5.
    </para>
            <para id="para-00039">The correct answer is 400.
    </para>
          </solution>
        </exercise>
        <exercise id="befadee8-0d0a-4180-841a-c64efb4bcd0e" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00040">A sea turtle population <m:math display="inline"><m:mrow><m:mi>p</m:mi></m:mrow></m:math> is modeled by the equation <m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>400</m:mn><m:mi>·</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1.25</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mi>y</m:mi></m:msup></m:mrow></m:math> where <m:math display="inline"><m:mrow><m:mi>y</m:mi></m:mrow></m:math> is the number of years since the population was first measured. After how many years will the turtle population reach 700? Round to the nearest full year.</para>
          </problem>
          <solution id="sol-00010">
            
            <para id="para-00041">Try again. Revisit activity 5.4.5.
    </para>
            <para id="para-00042">The correct answer is 2.
    </para>
          </solution>
        </exercise>
        <exercise id="f1c4dd95-dbd4-48cb-96bc-51a8da17ade4" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00043">Use the following information to answer questions 11 and 12.</para>
            <para id="para-00044">Which account has more money after one week?</para>
          </problem>
          <solution id="sol-00011">
            
            <para id="para-00045">Try again. Revisit activity 5.4.3.
    </para>
            <para id="para-00046">The correct answer is Bank Account B.
    </para>
          </solution>
        </exercise>
        <exercise id="aaba644a-2de8-49da-b103-d5590f6e3b68" class="multiple-choice">
          <problem id="prob-00012">
            <para id="para-00047">Which account has more money after fifteen weeks?
      </para>
          </problem>
          <solution id="sol-00012">
            
            <para id="para-00048">Try again. Revisit activity 5.4.4
    </para>
            <para id="para-00049">The correct answer is Bank Account A.
    </para>
          </solution>
        </exercise>
        <exercise id="cfb66877-9a06-47a9-a574-ae7b93143c0f" class="multiple-choice">
          <problem id="prob-00013">
            <para id="para-00050">For 13 - 15, use this graph showing the two account balances.</para>
            <para id="para-00051">
              <quote id="quote-00002">
                          <media alt="Graph of 2 discrete lines, origin O, with grid. Number of weeks and amount in dollars.">
                    <image mime-type="image/svg+xml" src="../../media/Algebra-1_05_06_13_01.svg"/>
                  </media>
                
              </quote>
          </para>
            <para id="para-00052">The graph of the red triangles corresponds to which bank account?
        </para>
          </problem>
          <solution id="sol-00013">
            
            <para id="para-00053">Try again. Revisit activity 5.4.3.
    </para>
            <para id="para-00054">The correct answer is Bank Account A.</para>
          </solution>
        </exercise>
        <exercise id="_196be8d6-bcb3-4cb6-8881-9a9d61028274" class="multiple-choice">
          <problem id="prob-00014">
            <para id="para-00055">The graph of the blue circles corresponds to which bank account?
      </para>
          </problem>
          <solution id="sol-00014">
            
            <para id="para-00056">Try again. Revisit activity 5.4.4
    </para>
            <para id="para-00057">The correct answer is Bank Account B.
    </para>
          </solution>
        </exercise>
        <exercise id="baedeabc-d833-4d6f-a783-aec840a78031" class="multiple-choice">
          <problem id="prob-00015">
            <para id="para-00058">Which of the two accounts would you choose for long-term saving?
      </para>
          </problem>
          <solution id="sol-00015">
            
            <para id="para-00059">Try again. Revisit activity 5.4.4
    </para>
            <para id="para-00060">The correct answer is Bank Account B.
    </para>
          </solution>
        </exercise>

    </section>
