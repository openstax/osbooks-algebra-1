  <content>
  <section id="sect-00001"><title>Activity</title>
<!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->
<para id="para-00001">For questions 1 – 5, write each function in vertex form.</para>

<!--Q1-->
<example id="exam-00001"><exercise>
  <problem id="prob-00001">
    
    <para id="para-00002">\( y=x^2-4x+7\)</para>
	  <para id="para-00003">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00001">
<para id="para-00004">Compare your answer:</para>

<para id="para-00005">\(y=(x-2)^2+3\)</para>

</solution></exercise>
</example><!--Interaction End -->

<!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

<!--Q2-->
<example id="exam-00002"><exercise>
  <problem id="prob-00002">
    
    <para id="para-00006">\( y=(x-1)(x+3) \)</para>
	  <para id="para-00007">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00002">
<para id="para-00008">Compare your answer:</para>

<para id="para-00009">\(y=(x+1)^2-4\)</para>

</solution></exercise>
</example><!--Interaction End -->

<!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

<!--Q3-->
<example id="exam-00003"><exercise>
  <problem id="prob-00003">
    
    <para id="para-00010">\( y=(x-2)(x+2)\)</para>
	  <para id="para-00011">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00003">
<para id="para-00012">Compare your answer:</para>

<para id="para-00013">\(y=(x-0)^2-4\)</para>

</solution></exercise>
</example><!--Interaction End -->

<!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

<!--Q4-->
<example id="exam-00004"><exercise>
  <problem id="prob-00004">
    
    <para id="para-00014"> \(y=-x^2-2x-6\)</para>
	  <para id="para-00015">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00004">
<para id="para-00016">Compare your answer:</para>

<para id="para-00017">\(y=-(x+1)^2-5\)</para>

</solution></exercise>
</example><!--Interaction End -->

<!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

<!--Q5-->
<example id="exam-00005"><exercise>
  <problem id="prob-00005">
    
    <para id="para-00018">\( y=2x^2-12x+22 \)</para>
	  <para id="para-00019">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00005">
<para id="para-00020">Compare your answer:</para>

<para id="para-00021">\(y=2(x-3)^2+4\)</para>

</solution></exercise>
</example><!--Interaction End -->

<!-- END CLICK TO REVEAL NO TEXTBOX -->


<para id="para-00022">For questions 6 and 7, write each function in standard form.</para>

<!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->
<!--Q6-->
<example id="exam-00006"><exercise>
  <problem id="prob-00006">
    
    <para id="para-00023">\( y=(x-2)^2+7 \)</para>
	  <para id="para-00024">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00006">
<para id="para-00025">Compare your answer:</para>

<para id="para-00026">\(y=x^2-4x+11\)</para>

</solution></exercise>
</example><!--Interaction End -->

<!-- END CLICK TO REVEAL NO TEXTBOX -->

<!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

<!--Q7-->
<example id="exam-00007"><exercise>
  <problem id="prob-00007">
    
    <para id="para-00027">\( y=(x+3)^2-2\)</para>
	  <para id="para-00028">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  
  </problem><solution id="sol-00007">
<para id="para-00029">Compare your answer:</para>

<para id="para-00030">\(y=x^2+6x+7\)</para>

</solution></exercise>
</example><!--Interaction End -->

<!-- END CLICK TO REVEAL NO TEXTBOX -->

