  <content>
  <section><title>Activity</title>
<!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->
<para>For questions 1 – 5, write each function in vertex form.</para>

<!--Q1-->
<example><exercise>
  <problem>
    
    <para>\( y=x^2-4x+7\) </para>
	  <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
<para>Compare your answer:</para>
<para>\(y=(x-2)^2+3\)</para>
</solution></exercise>
</example><!--Interaction End -->

<!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

<!--Q2-->
<example><exercise>
  <problem>
    
    <para>\( y=(x-1)(x+3) \)</para>
	  <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
<para>Compare your answer:</para>
<para>\(y=(x+1)^2-4\)</para>
</solution></exercise>
</example><!--Interaction End -->

<!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

<!--Q3-->
<example><exercise>
  <problem>
    
    <para>\( y=(x-2)(x+2)\) </para>
	  <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
<para>Compare your answer:</para>
<para>\(y=(x-0)^2-4\)</para>
</solution></exercise>
</example><!--Interaction End -->

<!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

<!--Q4-->
<example><exercise>
  <problem>
    
    <para> \(y=-x^2-2x-6\)</para>
	  <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
<para>Compare your answer:</para>
<para>\(y=-(x+1)^2-5\)</para>
</solution></exercise>
</example><!--Interaction End -->

<!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

<!--Q5-->
<example><exercise>
  <problem>
    
    <para>\( y=2x^2-12x+22 \)</para>
	  <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
<para>Compare your answer:</para>
<para>\(y=2(x-3)^2+4\)</para>
</solution></exercise>
</example><!--Interaction End -->

<!-- END CLICK TO REVEAL NO TEXTBOX -->


<para>For questions 6 and 7, write each function in standard form.</para>

<!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->
<!--Q6-->
<example><exercise>
  <problem>
    
    <para>\( y=(x-2)^2+7 \)</para>
	  <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
<para>Compare your answer:</para>
<para>\(y=x^2-4x+11\)</para>
</solution></exercise>
</example><!--Interaction End -->

<!-- END CLICK TO REVEAL NO TEXTBOX -->

<!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

<!--Q7-->
<example><exercise>
  <problem>
    
    <para>\( y=(x+3)^2-2\) </para>
	  <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
<para>Compare your answer:</para>
<para>\(y=x^2+6x+7\)</para>
</solution></exercise>
</example><!--Interaction End -->

<!-- END CLICK TO REVEAL NO TEXTBOX -->

