<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.8.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02221</md:content-id>
    <md:title>8.8.5: Practice</md:title>
    <md:uuid>7c0720ed-bc8e-4f3b-b1e2-54fd9ecf8540</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <exercise id="d7a25650-5023-4902-8bb2-fe8c31fd3f77" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00002">Which of the following is equivalent to \(10^2−12^2\)?</para>
          <para id="para-00003">Multiple Choice:</para>
          <para id="para-00004">\((10 + 12)(10 + 12)\)</para>
          <para id="para-00005">\((10 − 12)(10 − 12)\)</para>
          <para id="para-00006">\((10 −12)^2\)</para>
          <para id="para-00007">\((10 + 12)(10 − 12)\)</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00008">Try again. Revisit activity 8.8.2.</para>
          <para id="para-00009">The correct answer is \((10 + 12)(10 − 12)\).</para>
        </solution>
      </exercise>
      <exercise id="aac94111-04f1-44af-9af6-8aef68283fc6" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00010">For questions 2 – 10, select the expression in factored form.</para>
          <para id="para-00011">\(c^2 − 25\)</para>
          <para id="para-00012">Multiple Choice:</para>
          <para id="para-00013">\(c(c − 25)\)</para>
          <para id="para-00014">\((c − 5)(c − 5)\)</para>
          <para id="para-00015">\((c − 5)(c + 5)\)</para>
          <para id="para-00016">\((c + 5)(c + 5)\)</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00017">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00018">The correct answer is \((c − 5)(c + 5)\).</para>
        </solution>
      </exercise>
      <exercise id="_9925a0b8-063f-406f-a75e-d47e26f45973" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00019">\(9w^2 − 121\)</para>
          <para id="para-00020">Multiple Choice:</para>
          <para id="para-00021">\((3w − 11)(3w + 11)\)</para>
          <para id="para-00022">\((3w + 11)(3w + 11)\)</para>
          <para id="para-00023">\(w(9w − 121)\)</para>
          <para id="para-00024">\((3w − 11)(3w − 11)\)</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00025">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00026">The correct answer is \((3w − 11)(3w + 11)\).</para>
        </solution>
      </exercise>
      <exercise id="_6a884aa4-cbec-401d-9647-48e7c6767f0b" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00027">\(h^2− 121\)</para>
          <para id="para-00028">Multiple Choice:</para>
          <para id="para-00029">\((h − 11)^2\)</para>
          <para id="para-00030">\((h − 11)(h + 11)\)</para>
          <para id="para-00031">\((h − 11)(h − 11)\)</para>
          <para id="para-00032">\((h + 11)(h + 11)\)</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00033">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00034">The correct answer is \((h − 11)(h + 11)\).</para>
        </solution>
      </exercise>
      <exercise id="_5400c334-9ae8-4faa-a538-6dc044a84639" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00035">\(64 − d^2\)</para>
          <para id="para-00036">Multiple Choice:</para>
          <para id="para-00037">\((8 − d)(8 − d)\)</para>
          <para id="para-00038">\((8 − d)(8 + d)\)</para>
          <para id="para-00039">\((8 + d)(8 + d)\)</para>
          <para id="para-00040">Not possible</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00041">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00042">The correct answer is \((8 − d)(8 + d)\).</para>
        </solution>
      </exercise>
      <exercise id="de43ec38-7772-41d6-9788-61b46765e0f4" class="multiple-choice">
        <problem id="prob-00006">
          <para id="para-00043">\(4b^2 − 25\)</para>
          <para id="para-00044">Multiple Choice:</para>
          <para id="para-00045">\((2b − 5)(2b + 5)\)</para>
          <para id="para-00046">\((2b − 5)(2b − 5)\)</para>
          <para id="para-00047">\(b(4b − 25)\)</para>
          <para id="para-00048">\((2b + 5)(2b + 5)\)</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00049">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00050">The correct answer is \((2b − 5)(2b + 5)\).</para>
        </solution>
      </exercise>
      <exercise id="da77c4e9-72ff-4cc7-ae59-c20b52b1bcb9" class="multiple-choice">
        <problem id="prob-00007">
          <para id="para-00051">\(49 − 81z^2\)</para>
          <para id="para-00052">Multiple Choice:</para>
          <para id="para-00053">\((7 + 9z)(7 + 9z)\)</para>
          <para id="para-00054">\((7 − 9z)(7 − 9z)\)</para>
          <para id="para-00055">\(z(49 − 81z)\)</para>
          <para id="para-00056">\((7 − 9z)(7 + 9z)\)</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00057">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00058">The correct answer is \((7 − 9z)(7 + 9z)\).</para>
        </solution>
      </exercise>
      <exercise id="_8bf666ff-4590-429f-8a7d-3c52568e0e4b" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00059">\(100y^2−4\)</para>
          <para id="para-00060">Multiple Choice:</para>
          <para id="para-00061">\((10y + 2)(10y + 2)\)</para>
          <para id="para-00062">\((10y − 2)(10y + 2)\)</para>
          <para id="para-00063">\((10y − 2)(10y − 2)\)</para>
          <para id="para-00064">Not possible</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00065">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00066">The correct answer is \((10y − 2)(10y + 2)\).</para>
        </solution>
      </exercise>
      <exercise id="e72b9f84-b78b-4b93-9c08-a12b8f3e90ef" class="multiple-choice">
        <problem id="prob-00009">
          <para id="para-00067">\(x^2+9\)</para>
          <para id="para-00068">Multiple Choice:</para>
          <para id="para-00069">\((x − 3)(x − 3)\)</para>
          <para id="para-00070">\((x − 3)(x + 3)\)</para>
          <para id="para-00071">\((x + 3)(x + 3)\)</para>
          <para id="para-00072">Not possible</para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00073">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00074">The correct answer is not possible.</para>
        </solution>
      </exercise>
      <exercise id="_2b766e16-3681-4ed9-bb2b-287040d57da8" class="multiple-choice">
        <problem id="prob-00010">
          <para id="para-00075">\(144 − 16g^2\)</para>
          <para id="para-00076">Multiple Choice:</para>
          <para id="para-00077">\((12 − 4g)(12 + 4g)\)</para>
          <para id="para-00078">\((12 + 4g)(12 + 4g)\)</para>
          <para id="para-00079">\((12 − 4g)(12 − 4g)\)</para>
          <para id="para-00080">Not possible</para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00081">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00082">The correct answer is \((12 − 4g)(12 + 4g)\).</para>
        </solution>
      </exercise>
    </section>
  </content>
