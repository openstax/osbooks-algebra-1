<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.8.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02221</md:content-id>
    <md:title>8.8.5: Practice</md:title>
    <md:uuid>7c0720ed-bc8e-4f3b-b1e2-54fd9ecf8540</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <exercise id="d7a25650-5023-4902-8bb2-fe8c31fd3f77" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00002">Which of the following is equivalent to <m:math display="inline"><m:mrow><m:msup><m:mn>10</m:mn><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:msup><m:mn>12</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math>?</para>
          <para id="para-00003">Multiple Choice:</para>
          <para id="para-00004"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mo>+</m:mo><m:mn>12</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mo>+</m:mo><m:mn>12</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00005"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>−</m:mi><m:mn>12</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>−</m:mi><m:mn>12</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00006"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>−</m:mi><m:mn>12</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
          <para id="para-00007"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mo>+</m:mo><m:mn>12</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>−</m:mi><m:mn>12</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00008">Try again. Revisit activity 8.8.2.</para>
          <para id="para-00009">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mo>+</m:mo><m:mn>12</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>−</m:mi><m:mn>12</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="aac94111-04f1-44af-9af6-8aef68283fc6" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00010">For questions 2 – 10, select the expression in factored form.</para>
          <para id="para-00011"><m:math><m:mrow><m:msup><m:mi>c</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>25</m:mn></m:mrow></m:math></para>
          <para id="para-00012">Multiple Choice:</para>
          <para id="para-00013"><m:math><m:mrow><m:mi>c</m:mi><m:mo stretchy="false">(</m:mo><m:mi>c</m:mi><m:mi>−</m:mi><m:mn>25</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00014"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>c</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>c</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00015"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>c</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00016"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00017">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00018">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>c</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_9925a0b8-063f-406f-a75e-d47e26f45973" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00019"><m:math><m:mrow><m:mn>9</m:mn><m:msup><m:mi>w</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>121</m:mn></m:mrow></m:math></para>
          <para id="para-00020">Multiple Choice:</para>
          <para id="para-00021"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>w</m:mi><m:mi>−</m:mi><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>w</m:mi><m:mo>+</m:mo><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00022"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>w</m:mi><m:mo>+</m:mo><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>w</m:mi><m:mo>+</m:mo><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00023"><m:math><m:mrow><m:mi>w</m:mi><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mi>w</m:mi><m:mi>−</m:mi><m:mn>121</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00024"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>w</m:mi><m:mi>−</m:mi><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>w</m:mi><m:mi>−</m:mi><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00025">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00026">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>w</m:mi><m:mi>−</m:mi><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>w</m:mi><m:mo>+</m:mo><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_6a884aa4-cbec-401d-9647-48e7c6767f0b" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00027"><m:math><m:mrow><m:msup><m:mi>h</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>121</m:mn></m:mrow></m:math></para>
          <para id="para-00028">Multiple Choice:</para>
          <para id="para-00029"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mi>−</m:mi><m:mn>11</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
          <para id="para-00030"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mi>−</m:mi><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mo>+</m:mo><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00031"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mi>−</m:mi><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mi>−</m:mi><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00032"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mo>+</m:mo><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mo>+</m:mo><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00033">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00034">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mi>−</m:mi><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>h</m:mi><m:mo>+</m:mo><m:mn>11</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_5400c334-9ae8-4faa-a538-6dc044a84639" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00035"><m:math><m:mrow><m:mn>64</m:mn><m:mi>−</m:mi><m:msup><m:mi>d</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
          <para id="para-00036">Multiple Choice:</para>
          <para id="para-00037"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mi>−</m:mi><m:mi>d</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mi>−</m:mi><m:mi>d</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00038"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mi>−</m:mi><m:mi>d</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mo>+</m:mo><m:mi>d</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00039"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mo>+</m:mo><m:mi>d</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mo>+</m:mo><m:mi>d</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00040">Not possible</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00041">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00042">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mi>−</m:mi><m:mi>d</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mo>+</m:mo><m:mi>d</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="de43ec38-7772-41d6-9788-61b46765e0f4" class="multiple-choice">
        <problem id="prob-00006">
          <para id="para-00043"><m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>25</m:mn></m:mrow></m:math></para>
          <para id="para-00044">Multiple Choice:</para>
          <para id="para-00045"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>b</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00046"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>b</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>b</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00047"><m:math><m:mrow><m:mi>b</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>b</m:mi><m:mi>−</m:mi><m:mn>25</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00048"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00049">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00050">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>b</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="da77c4e9-72ff-4cc7-ae59-c20b52b1bcb9" class="multiple-choice">
        <problem id="prob-00007">
          <para id="para-00051"><m:math><m:mrow><m:mn>49</m:mn><m:mi>−</m:mi><m:mn>81</m:mn><m:msup><m:mi>z</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
          <para id="para-00052">Multiple Choice:</para>
          <para id="para-00053"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>z</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>z</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00054"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mi>−</m:mi><m:mn>9</m:mn><m:mi>z</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mi>−</m:mi><m:mn>9</m:mn><m:mi>z</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00055"><m:math><m:mrow><m:mi>z</m:mi><m:mo stretchy="false">(</m:mo><m:mn>49</m:mn><m:mi>−</m:mi><m:mn>81</m:mn><m:mi>z</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00056"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mi>−</m:mi><m:mn>9</m:mn><m:mi>z</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>z</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00057">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00058">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mi>−</m:mi><m:mn>9</m:mn><m:mi>z</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>z</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_8bf666ff-4590-429f-8a7d-3c52568e0e4b" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00059"><m:math><m:mrow><m:mn>100</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>4</m:mn></m:mrow></m:math></para>
          <para id="para-00060">Multiple Choice:</para>
          <para id="para-00061"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00062"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00063"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00064">Not possible</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00065">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00066">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>y</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="e72b9f84-b78b-4b93-9c08-a12b8f3e90ef" class="multiple-choice">
        <problem id="prob-00009">
          <para id="para-00067"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
          <para id="para-00068">Multiple Choice:</para>
          <para id="para-00069"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00070"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00071"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00072">Not possible</para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00073">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00074">The correct answer is not possible.</para>
        </solution>
      </exercise>
      <exercise id="_2b766e16-3681-4ed9-bb2b-287040d57da8" class="multiple-choice">
        <problem id="prob-00010">
          <para id="para-00075"><m:math><m:mrow><m:mn>144</m:mn><m:mi>−</m:mi><m:mn>16</m:mn><m:msup><m:mi>g</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
          <para id="para-00076">Multiple Choice:</para>
          <para id="para-00077"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mi>−</m:mi><m:mn>4</m:mn><m:mi>g</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>g</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00078"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>g</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>g</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00079"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mi>−</m:mi><m:mn>4</m:mn><m:mi>g</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mi>−</m:mi><m:mn>4</m:mn><m:mi>g</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          <para id="para-00080">Not possible</para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00081">Try again. Revisit activities 8.8.3 and 8.8.4.</para>
          <para id="para-00082">The correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mi>−</m:mi><m:mn>4</m:mn><m:mi>g</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>g</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
        </solution>
      </exercise>
    </section>
