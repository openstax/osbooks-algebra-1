<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.8.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02221</md:content-id>
    <md:title>8.8.5: Practice</md:title>
    <md:uuid>84c6d829-5f61-498b-9d09-14b30a0422a5</md:uuid>
  </metadata>
  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="575ab502-18ff-490e-8579-b3e91da6f20c" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--1-->
  <exercise data-content-id="d7a25650-5023-4902-8bb2-fe8c31fd3f77" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((10 + 12)(10 − 12)\)" data-solution-options="[&quot;\\((10 + 12)(10 + 12)\\)&quot;, &quot;\\((10 − 12)(10 − 12)\\)&quot;, &quot;\\((10 −12)^2\\)&quot;, &quot;\\((10 + 12)(10 − 12)\\)&quot;]">
    <problem>
      <para>Which of the following is equivalent to \(10^2−12^2\)?</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.8.2.
      </para>
    </div>
    </exercise>
  <!--2-->
  <exercise data-content-id="aac94111-04f1-44af-9af6-8aef68283fc6" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((c − 5)(c + 5)\)" data-solution-options="[&quot;\\(c(c − 25)\\)&quot;, &quot;\\((c − 5)(c − 5)\\)&quot;, &quot;\\((c − 5)(c + 5)\\)&quot;, &quot;\\((c + 5)(c + 5)\\)&quot;]">
    <problem>
      <para>For questions 2–10, select the expression in factored form.</para>
      <para>\(c^2 − 25\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 8.8.3 and 8.8.4.</para>
    </div>
    </exercise>
  <!--3-->
  <exercise data-content-id="9925a0b8-063f-406f-a75e-d47e26f45973" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((3w − 11)(3w + 11)\)" data-solution-options="[&quot;\\((3w − 11)(3w + 11)\\)&quot;, &quot;\\((3w + 11)(3w + 11)\\)&quot;, &quot;\\(w(9w − 121)\\)&quot;, &quot;\\((3w − 11)(3w − 11)\\)&quot;]">
    <problem>
      <para>\(9w^2 − 121\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 8.8.3 and 8.8.4.</para>
    </div>
    </exercise>
  <!--4-->
  <exercise data-content-id="6a884aa4-cbec-401d-9647-48e7c6767f0b" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((h − 11)(h + 11)\)" data-solution-options="[&quot;\\((h − 11)^2\\)&quot;, &quot;\\((h − 11)(h + 11)\\)&quot;, &quot;\\((h − 11)(h − 11)\\)&quot;, &quot;\\((h + 11)(h + 11)\\)&quot;]">
    <problem>
      <para>\(h^2− 121\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 8.8.3 and 8.8.4.</para>
    </div>
    </exercise>
  <!--5-->
  <exercise data-content-id="5400c334-9ae8-4faa-a538-6dc044a84639" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((8 − d)(8 + d)\)" data-solution-options="[&quot;\\((8 − d)(8 − d)\\)&quot;, &quot;\\((8 − d)(8 + d)\\)&quot;, &quot;\\((8 + d)(8 + d)\\)&quot;, &quot;Not possible&quot;]">
    <problem>
      <para>\(64 − d^2\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 8.8.3 and 8.8.4.</para>
    </div>
    </exercise>
  <!--6-->
  <exercise data-content-id="de43ec38-7772-41d6-9788-61b46765e0f4" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((2b − 5)(2b + 5)\)" data-solution-options="[&quot;\\((2b − 5)(2b + 5)\\)&quot;, &quot;\\((2b − 5)(2b − 5)\\)&quot;, &quot;\\(b(4b − 25)\\)&quot;, &quot;\\((2b + 5)(2b + 5)\\)&quot;]">
    <problem>
      <para>\(4b^2 − 25\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 8.8.3 and 8.8.4.
      </para>
    </div>
    </exercise>
  <!--7-->
  <exercise data-content-id="da77c4e9-72ff-4cc7-ae59-c20b52b1bcb9" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((7 − 9z)(7 + 9z)\)" data-solution-options="[&quot;\\((7 + 9z)(7 + 9z)\\)&quot;, &quot;\\((7 − 9z)(7 − 9z)\\)&quot;, &quot;\\(z(49 − 81z)\\)&quot;, &quot;\\((7 − 9z)(7 + 9z)\\)&quot;]">
    <problem>
      <para>\(49 − 81z^2\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 8.8.3 and 8.8.4.</para>
    </div>
    </exercise>
  <!--8-->
  <exercise data-content-id="8bf666ff-4590-429f-8a7d-3c52568e0e4b" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((10y − 2)(10y + 2)\)" data-solution-options="[&quot;\\((10y + 2)(10y + 2)\\)&quot;, &quot;\\((10y − 2)(10y + 2)\\)&quot;, &quot;\\((10y − 2)(10y − 2)\\)&quot;, &quot;Not possible&quot;]">
    <problem>
      <para>\(100y^2−4\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 8.8.3 and 8.8.4.</para>
    </div>
    </exercise>
  <!--9-->
  <exercise data-content-id="e72b9f84-b78b-4b93-9c08-a12b8f3e90ef" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="Not possible " data-solution-options="[&quot;\\((x − 3)(x − 3)\\)&quot;, &quot;\\((x − 3)(x + 3)\\)&quot;, &quot;\\((x + 3)(x + 3)\\)&quot;, &quot;Not possible &quot;]">
    <problem>
      <para>\(x^2+9\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 8.8.3 and 8.8.4.</para>
    </div>
    </exercise>
  <!--10-->
  <exercise data-content-id="2b766e16-3681-4ed9-bb2b-287040d57da8" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((12 − 4g)(12 + 4g)\)" data-solution-options="[&quot;\\((12 − 4g)(12 + 4g)\\)&quot;, &quot;\\((12 + 4g)(12 + 4g)\\)&quot;, &quot;\\((12 − 4g)(12 − 4g)\\)&quot;, &quot;Not possible&quot;]">
    <problem>
      <para>\(144 − 16g^2\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 8.8.3 and 8.8.4.</para>
    </div>
    </exercise>
  <!--Do not edit below this line-->
  <solution> </solution>
  <div class="os-raise-ib-pset-encourage-response"> </div>
</div></section>
