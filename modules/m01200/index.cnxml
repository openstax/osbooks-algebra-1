<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.18.7: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01200</md:content-id>
    <md:title>4.18.7: Practice</md:title>
    <md:uuid>bc050223-a311-4f18-9577-6d3511fc2ac2</md:uuid>
  </metadata>
  <content>
  <section class="practice" id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
<section id="sect-00002"><exercise id="_99402f9a-a336-4a0e-a2d3-09edacc50f47" class="multiple-choice"><problem id="prob-00001"><para id="para-00002">Find the value of each specified term of the arithmetic sequences below. Hint: Enter your answers as an integer only. Do not include commas or periods.</para>
        <para id="para-00003">Find the <m:math display="inline"><m:mrow><m:msup><m:mn>21</m:mn><m:mrow><m:mi>s</m:mi><m:mi>t</m:mi></m:mrow></m:msup></m:mrow></m:math> term of a sequence where the first term is <m:math display="inline"><m:mrow><m:mn>3</m:mn></m:mrow></m:math> and the common difference is <m:math display="inline"><m:mrow><m:mn>8</m:mn></m:mrow></m:math>.
        </para>
        </problem><solution id="sol-00001"><para id="para-00004">Correct! 163</para><para id="para-00005">Try again. Revisit activities 4.18.2 and 4.18.4.</para><para id="para-00006">The correct answer is <m:math display="inline"><m:mrow><m:mn>163</m:mn></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="ca8da07c-a1b2-47c5-8fc9-4f00d8795c60" class="multiple-choice"><problem id="prob-00002"><para id="para-00007">Find the <m:math display="inline"><m:mrow><m:msup><m:mn>30</m:mn><m:mrow><m:mi>t</m:mi><m:mi>h</m:mi></m:mrow></m:msup></m:mrow></m:math> term of a sequence where the first term is <m:math display="inline"><m:mrow><m:mi>–</m:mi><m:mn>14</m:mn></m:mrow></m:math> and the common difference is <m:math display="inline"><m:mrow><m:mn>5</m:mn></m:mrow></m:math>.
        </para>
        </problem><solution id="sol-00002"><para id="para-00008">Correct! <m:math display="inline"><m:mrow><m:mn>131</m:mn></m:mrow></m:math></para><para id="para-00009">Try again. Revisit activities 4.18.2 and 4.18.4.</para><para id="para-00010">The correct answer is <m:math display="inline"><m:mrow><m:mn>131</m:mn></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_59a632cd-0c67-4b5d-abab-0c35a39ba7e3" class="multiple-choice"><problem id="prob-00003"><para id="para-00011">Find the <m:math display="inline"><m:mrow><m:msup><m:mn>16</m:mn><m:mrow><m:mi>t</m:mi><m:mi>h</m:mi></m:mrow></m:msup></m:mrow></m:math> term of a sequence where the first term is <m:math display="inline"><m:mrow><m:mn>11</m:mn></m:mrow></m:math> and the common difference is <m:math display="inline"><m:mrow><m:mi>–</m:mi><m:mn>6</m:mn></m:mrow></m:math>.
        </para>
        </problem><solution id="sol-00003"><para id="para-00012">Correct! –79</para><para id="para-00013">Try again. Revisit activities 4.18.2 and 4.18.4.</para><para id="para-00014">The correct answer is <m:math display="inline"><m:mrow><m:mi>–</m:mi><m:mn>79</m:mn></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_39bd974f-5453-4265-8b24-c1864b65633f" class="multiple-choice"><problem id="prob-00004"><para id="para-00015">Find the value of each specified term of the geometric sequences below. Hint: Enter your answers as integers only. Do not include commas or periods.</para>
        <para id="para-00016">Find the <m:math display="inline"><m:mrow><m:msup><m:mn>11</m:mn><m:mrow><m:mi>t</m:mi><m:mi>h</m:mi></m:mrow></m:msup></m:mrow></m:math> term given the first term is <m:math display="inline"><m:mrow><m:mn>8</m:mn></m:mrow></m:math> and the common ratio is <m:math display="inline"><m:mrow><m:mn>3</m:mn></m:mrow></m:math>.
        </para>
        </problem><solution id="sol-00004"><para id="para-00017">Correct! <m:math display="inline"><m:mrow><m:mn>472392</m:mn></m:mrow></m:math></para><para id="para-00018">Try again. Revisit activities 4.18.2 – 4.18.3.</para><para id="para-00019">The correct answer is <m:math display="inline"><m:mrow><m:mn>472392</m:mn></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_1ebdbd24-382d-4498-a97e-36145e5f04d2" class="multiple-choice"><problem id="prob-00005"><para id="para-00020">Find the <m:math display="inline"><m:mrow><m:msup><m:mn>10</m:mn><m:mrow><m:mi>t</m:mi><m:mi>h</m:mi></m:mrow></m:msup></m:mrow></m:math> term given the first term is <m:math display="inline"><m:mrow><m:mi>–</m:mi><m:mn>6</m:mn></m:mrow></m:math> and the common ratio is <m:math display="inline"><m:mrow><m:mi>–</m:mi><m:mn>2</m:mn></m:mrow></m:math>.
        </para>
        </problem><solution id="sol-00005"><para id="para-00021">Correct! 3072</para><para id="para-00022">Try again. Revisit activities 4.18.2 – 4.18.3.</para><para id="para-00023">The correct answer is <m:math display="inline"><m:mrow><m:mn>3072</m:mn></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="baf6f255-ad47-4bf3-8bcf-4ed32dbc4b92" class="multiple-choice"><problem id="prob-00006"><para id="para-00024">A sequence is defined recursively by <m:math display="inline"><m:mrow><m:msub><m:mi>f</m:mi><m:mn>1</m:mn></m:msub><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:msub><m:mi>f</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:msub><m:mi>f</m:mi><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msub><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math>, for <m:math display="inline"><m:mrow><m:mi>n</m:mi><m:mi>≥</m:mi><m:mn>2</m:mn></m:mrow></m:math>. Which of the following gives the <m:math display="inline"><m:mrow><m:msup><m:mi>n</m:mi><m:mrow><m:mi>t</m:mi><m:mi>h</m:mi></m:mrow></m:msup></m:mrow></m:math> term for <m:math display="inline"><m:mrow><m:mi>n</m:mi><m:mi>≥</m:mi><m:mn>0</m:mn></m:mrow></m:math>?</para>
      <para id="para-00025">Multiple Choice:</para><para id="para-00026"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mrow><m:mi>n</m:mi></m:mrow></m:msub><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00027"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mrow><m:mi>n</m:mi></m:mrow></m:msub><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00028"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mrow><m:mi>n</m:mi></m:mrow></m:msub><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00029"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mrow><m:mi>n</m:mi></m:mrow></m:msub><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00006"><para id="para-00030">Correct! <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mrow><m:mi>n</m:mi></m:mrow></m:msub><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00031">Try again. Revisit activities 4.18.2 – 4.18.5.</para><para id="para-00032">The correct answer is <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mrow><m:mi>n</m:mi></m:mrow></m:msub><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_38258be5-0b3a-4ef7-ab27-c604a6fdace1" class="multiple-choice"><problem id="prob-00007"><para id="para-00033">A sequence is defined recursively by <m:math display="inline"><m:mrow><m:msub><m:mi>f</m:mi><m:mn>1</m:mn></m:msub><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>20</m:mn><m:mo>,</m:mo><m:msub><m:mi>f</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:msub><m:mi>f</m:mi><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:msub><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math> for <m:math display="inline"><m:mrow><m:mi>n</m:mi><m:mi>≥</m:mi><m:mn>2</m:mn></m:mrow></m:math>. Which of the following is the <m:math display="inline"><m:mrow><m:msup><m:mi>n</m:mi><m:mrow><m:mi>t</m:mi><m:mi>h</m:mi></m:mrow></m:msup></m:mrow></m:math> term?</para>
      <para id="para-00034">Multiple Choice:</para><para id="para-00035"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mrow><m:mi>n</m:mi></m:mrow></m:msub><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>20</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para><para id="para-00036"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mrow><m:mi>n</m:mi></m:mrow></m:msub><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>20</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00037"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mrow><m:mi>n</m:mi></m:mrow></m:msub><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>20</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00038"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mrow><m:mi>n</m:mi></m:mrow></m:msub><m:mo>=</m:mo><m:mn>5</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>20</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00007"><para id="para-00039">Correct! <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mrow><m:mi>n</m:mi></m:mrow></m:msub><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>20</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00040">Try again. Revisit activities 4.18.2 – 4.18.4.</para><para id="para-00041">The correct answer is <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mrow><m:mi>n</m:mi></m:mrow></m:msub><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>20</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_6fffcf18-e6ac-4983-9fe7-1963ef7b5157" class="multiple-choice"><problem id="prob-00008"><para id="para-00042">A sequence is defined recursively by <m:math display="inline"><m:mrow><m:msub><m:mi>f</m:mi><m:mn>1</m:mn></m:msub><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:msub><m:mi>f</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>·</m:mi><m:msub><m:mi>f</m:mi><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msub></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>n</m:mi><m:mo>≥</m:mo><m:mn>2</m:mn></m:mrow></m:math>. Which of the following gives the <m:math display="inline"><m:mrow><m:msup><m:mi>n</m:mi><m:mrow><m:mi>t</m:mi><m:mi>h</m:mi></m:mrow></m:msup></m:mrow></m:math> term for <m:math display="inline"><m:mrow><m:mi>n</m:mi><m:mo>≥</m:mo><m:mn>0</m:mn></m:mrow></m:math>?</para>
      <para id="para-00043">Multiple Choice:</para><para id="para-00044"><m:math><m:mrow><m:msub><m:mi>f</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>3</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msup></m:mrow></m:math></para><para id="para-00045"><m:math><m:mrow><m:msub><m:mi>f</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:msup><m:mn>3</m:mn><m:mi>n</m:mi></m:msup></m:mrow></m:math></para><para id="para-00046"><m:math><m:mrow><m:msub><m:mi>f</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>n</m:mi></m:mrow></m:math></para><para id="para-00047"><m:math><m:mrow><m:msub><m:mi>f</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>3</m:mn><m:mo>+</m:mo><m:msup><m:mn>2</m:mn><m:mi>n</m:mi></m:msup></m:mrow></m:math></para></problem><solution id="sol-00008"><para id="para-00048">Correct! <m:math display="inline"><m:mrow><m:msub><m:mi>f</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>3</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msup></m:mrow></m:math></para><para id="para-00049">Try again. Revisit activities 4.18.2 – 4.18.4.</para><para id="para-00050">The correct answer is <m:math display="inline"><m:mrow><m:msub><m:mi>f</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>3</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msup></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="ce6668d2-9242-4870-bca6-77ffc2b01910" class="multiple-choice"><problem id="prob-00009"><para id="para-00051">A sequence of numbers is given by <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mn>2</m:mn></m:msub><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mn>3</m:mn></m:msub><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mn>4</m:mn></m:msub><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mn>5</m:mn></m:msub><m:mo>=</m:mo><m:mn>13</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mn>6</m:mn></m:msub><m:mo>=</m:mo><m:mn>17</m:mn></m:mrow></m:math>. Which expression can be used to find the <m:math display="inline"><m:mrow><m:msup><m:mi>n</m:mi><m:mrow><m:mi>t</m:mi><m:mi>h</m:mi></m:mrow></m:msup></m:mrow></m:math> term of the sequence?</para>
      <para id="para-00052">Multiple Choice:</para><para id="para-00053"><m:math><m:mrow><m:mn>4</m:mn><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></para><para id="para-00054"><m:math><m:mrow><m:mn>4</m:mn><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math></para><para id="para-00055"><m:math><m:mrow><m:mn>7</m:mn><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00056"><m:math><m:mrow><m:mn>3</m:mn><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para></problem><solution id="sol-00009"><para id="para-00057">Correct! <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math></para><para id="para-00058">Try again. Revisit activities 4.18.2 – 4.18.4.</para><para id="para-00059">The correct answer is <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_4ff598c9-dc47-43e1-95a4-4660909eca7c" class="multiple-choice"><problem id="prob-00010"><para id="para-00060">A sequence of numbers is given by <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>27</m:mn></m:mrow></m:mfrac></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math>, 1, …. What is the equation that can be used to find the <m:math display="inline"><m:mrow><m:msup><m:mi>n</m:mi><m:mrow><m:mi>t</m:mi><m:mi>h</m:mi></m:mrow></m:msup></m:mrow></m:math> term of the sequence?</para>
      <para id="para-00061">Multiple Choice:</para><para id="para-00062"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>27</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00063"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>27</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msup></m:mrow></m:math></para><para id="para-00064"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>27</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msup></m:mrow></m:math></para><para id="para-00065"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>27</m:mn></m:mrow></m:mfrac><m:mi>÷</m:mi><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00010"><para id="para-00066">Correct! <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>27</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msup></m:mrow></m:math></para><para id="para-00067">Try again. Revisit activities 4.18.2 – 4.18.4.</para><para id="para-00068">The correct answer is <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>27</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msup></m:mrow></m:math>.</para></solution></exercise>
      
      <exercise id="_534149b6-1201-4140-aeed-e7efc99df673" class="multiple-choice"><problem id="prob-00011"><para id="para-00069">A sequence is given by the set of numbers 5, 1, -3, -7 … What is the equation that can be used to find the <m:math display="inline"><m:mrow><m:msup><m:mi>n</m:mi><m:mrow><m:mi>t</m:mi><m:mi>h</m:mi></m:mrow></m:msup></m:mrow></m:math> term of the sequence?</para>
      <para id="para-00070">Multiple Choice:</para><para id="para-00071"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>5</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00072"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msup></m:mrow></m:math></para><para id="para-00073"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msup></m:mrow></m:math></para><para id="para-00074"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>5</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00011"><para id="para-00075">Correct! <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>5</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00076">Try again. Revisit activities 4.18.2 – 4.18.4.</para><para id="para-00077">The correct answer is <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>5</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para></solution></exercise></section>
<!--Do not edit this div tag.  It must surround the interaction block-->
<section id="sect-00003"><exercise id="a213731c-aa53-490d-a01a-b1b95c11851b" class="multiple-choice"><problem id="prob-00012"><para id="para-00078">A sequence consists of the following terms: 1280, 320, 80, … What is the explicit formula for this sequence?</para>
      <para id="para-00079">Multiple Choice:</para><para id="para-00080"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>1280</m:mn><m:mo>−</m:mo><m:mn>960</m:mn><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00081"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>1280</m:mn><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msup></m:mrow></m:math></para><para id="para-00082"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>1280</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msup></m:mrow></m:math></para><para id="para-00083"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>1280</m:mn><m:mi>÷</m:mi><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00012"><para id="para-00084">Correct! <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>1280</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msup></m:mrow></m:math></para><para id="para-00085">Try again. Revisit activities 4.18.2 – 4.18.4.</para><para id="para-00086">The correct answer is <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>1280</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msup></m:mrow></m:math> .</para></solution></exercise>
      
      <exercise id="_4756240a-7f43-40ce-930b-8c33a8a7c052" class="multiple-choice"><problem id="prob-00013"><para id="para-00087">An arithmetic sequence consists of the terms 1, 6, 11, 16 …. If you were asked to find the <m:math display="inline"><m:mrow><m:msup><m:mn>100</m:mn><m:mrow><m:mi>t</m:mi><m:mi>h</m:mi></m:mrow></m:msup></m:mrow></m:math> term, what is the general formula you would use to find that value efficiently?</para>
      <para id="para-00088">Multiple Choice:</para><para id="para-00089"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>1</m:mn><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00090"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>1</m:mn><m:mo stretchy="false">(</m:mo><m:msub><m:mi>a</m:mi><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msub><m:msup><m:mo stretchy="false">)</m:mo><m:mn>5</m:mn></m:msup></m:mrow></m:math></para><para id="para-00091"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>5</m:mn><m:mo>+</m:mo><m:msub><m:mi>a</m:mi><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msub></m:mrow></m:math></para><para id="para-00092"><m:math><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>1</m:mn><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:msub><m:mi>a</m:mi><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:msub><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00013"><para id="para-00093">Correct! <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>1</m:mn><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00094">Try again. Revisit activities 4.18.2 – 4.18.4.</para><para id="para-00095">The correct answer is <m:math display="inline"><m:mrow><m:msub><m:mi>a</m:mi><m:mi>n</m:mi></m:msub><m:mo>=</m:mo><m:mn>1</m:mn><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para></solution></exercise></section></section>
</content></document>