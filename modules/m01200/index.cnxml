<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.18.7: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01200</md:content-id>
    <md:title>4.18.7: Practice</md:title>
    <md:uuid>bc050223-a311-4f18-9577-6d3511fc2ac2</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
<section id="sect-00002"><exercise id="_99402f9a-a336-4a0e-a2d3-09edacc50f47" class="multiple-choice"><problem id="prob-00001"><para id="para-00002">Find the value of each specified term of the arithmetic sequences below. Hint: Enter your answers as an integer only. Do not include commas or periods.</para>
        <para id="para-00003">Find the \(21^{st}\) term of a sequence where the first term is \(3\) and the common difference is \(8\).
        </para>
        </problem><solution id="sol-00001"><para id="para-00004">Correct! 163</para><para id="para-00005">Try again. Revisit activities 4.18.2 and 4.18.4.</para><para id="para-00006">The correct answer is \(163\).</para></solution></exercise>
      
      <exercise id="ca8da07c-a1b2-47c5-8fc9-4f00d8795c60" class="multiple-choice"><problem id="prob-00002"><para id="para-00007">Find the \(30^{th}\) term of a sequence where the first term is \(–14\) and the common difference is \(5\).
        </para>
        </problem><solution id="sol-00002"><para id="para-00008">Correct! \(131\)</para><para id="para-00009">Try again. Revisit activities 4.18.2 and 4.18.4.</para><para id="para-00010">The correct answer is \(131\).</para></solution></exercise>
      
      <exercise id="_59a632cd-0c67-4b5d-abab-0c35a39ba7e3" class="multiple-choice"><problem id="prob-00003"><para id="para-00011">Find the \(16^{th}\) term of a sequence where the first term is \(11\) and the common difference is \(–6\).
        </para>
        </problem><solution id="sol-00003"><para id="para-00012">Correct! –79</para><para id="para-00013">Try again. Revisit activities 4.18.2 and 4.18.4.</para><para id="para-00014">The correct answer is \(–79\).</para></solution></exercise>
      
      <exercise id="_39bd974f-5453-4265-8b24-c1864b65633f" class="multiple-choice"><problem id="prob-00004"><para id="para-00015">Find the value of each specified term of the geometric sequences below. Hint: Enter your answers as integers only. Do not include commas or periods.</para>
        <para id="para-00016">Find the \(11^{th}\) term given the first term is \(8\) and the common ratio is \(3\).
        </para>
        </problem><solution id="sol-00004"><para id="para-00017">Correct! \(472392\)</para><para id="para-00018">Try again. Revisit activities 4.18.2 – 4.18.3.</para><para id="para-00019">The correct answer is \(472392\).</para></solution></exercise>
      
      <exercise id="_1ebdbd24-382d-4498-a97e-36145e5f04d2" class="multiple-choice"><problem id="prob-00005"><para id="para-00020">Find the \(10^{th}\) term given the first term is \(–6\) and the common ratio is \(–2\).
        </para>
        </problem><solution id="sol-00005"><para id="para-00021">Correct! 3072</para><para id="para-00022">Try again. Revisit activities 4.18.2 – 4.18.3.</para><para id="para-00023">The correct answer is \(3072\).</para></solution></exercise>
      
      <exercise id="baf6f255-ad47-4bf3-8bcf-4ed32dbc4b92" class="multiple-choice"><problem id="prob-00006"><para id="para-00024">A sequence is defined recursively by \(f_1=-6, f_n=f_{n-1}-2\), for \(n≥2\). Which of the following gives the \(n^{th}\) term for \(n≥0\)?</para>
      <para id="para-00025">Multiple Choice:</para><para id="para-00026">\(a_{n}=-2+(n-1)(-6) \)</para><para id="para-00027">\(a_{n}=-6+(n-1)(-2) \)</para><para id="para-00028">\(a_{n}=-6+(n-1)+(-2)\)</para><para id="para-00029">\(a_{n}=-6+(n)(-2)\)</para></problem><solution id="sol-00006"><para id="para-00030">Correct! \(a_{n}=-6+(n-1)(-2) \)</para><para id="para-00031">Try again. Revisit activities 4.18.2 – 4.18.5.</para><para id="para-00032">The correct answer is \(a_{n}=-6+(n-1)(-2) \).</para></solution></exercise>
      
      <exercise id="_38258be5-0b3a-4ef7-ab27-c604a6fdace1" class="multiple-choice"><problem id="prob-00007"><para id="para-00033">A sequence is defined recursively by \(f_1=-20, f_n=f_{(n-1)}+5\) for \(n≥2\). Which of the following is the \(n^{th}\) term?</para>
      <para id="para-00034">Multiple Choice:</para><para id="para-00035">\(a_{n}=-20+(n-1)+5\)</para><para id="para-00036">\(a_{n}=-20+(n-1)(-2)\)</para><para id="para-00037">\(a_{n}=-20+(n-1)(5)\)</para><para id="para-00038">\(a_{n}=5+(n-1)(-20)\)</para></problem><solution id="sol-00007"><para id="para-00039">Correct! \(a_{n}=-20+(n-1)(5)\)</para><para id="para-00040">Try again. Revisit activities 4.18.2 – 4.18.4.</para><para id="para-00041">The correct answer is \(a_{n}=-20+(n-1)(5)\).</para></solution></exercise>
      
      <exercise id="_6fffcf18-e6ac-4983-9fe7-1963ef7b5157" class="multiple-choice"><problem id="prob-00008"><para id="para-00042">A sequence is defined recursively by \(f_1=3\), \(f_n=2 \cdot f_{n-1}\), \(n\geq2\). Which of the following gives the \(n^{th}\) term for \(n\geq0\)?</para>
      <para id="para-00043">Multiple Choice:</para><para id="para-00044">\(f_n=3 \cdot 2^{n-1}\)</para><para id="para-00045">\(f_n=3^n\)</para><para id="para-00046">\(f_n=3+2n\)</para><para id="para-00047">\(f_n=3+2^n\)</para></problem><solution id="sol-00008"><para id="para-00048">Correct! \(f_n=3 \cdot 2^{n-1}\)</para><para id="para-00049">Try again. Revisit activities 4.18.2 – 4.18.4.</para><para id="para-00050">The correct answer is \(f_n=3 \cdot 2^{n-1}\).</para></solution></exercise>
      
      <exercise id="ce6668d2-9242-4870-bca6-77ffc2b01910" class="multiple-choice"><problem id="prob-00009"><para id="para-00051">A sequence of numbers is given by \(a_2=1\), \(a_3=5\), \(a_4=9\), \(a_5=13\), \(a_6=17\). Which expression can be used to find the \(n^{th}\) term of the sequence?</para>
      <para id="para-00052">Multiple Choice:</para><para id="para-00053">\(4n-3\)</para><para id="para-00054">\(4n-7\)</para><para id="para-00055">\(7n-4\)</para><para id="para-00056">\(3n-4\)</para></problem><solution id="sol-00009"><para id="para-00057">Correct! \(4n-7\)</para><para id="para-00058">Try again. Revisit activities 4.18.2 – 4.18.4.</para><para id="para-00059">The correct answer is \(4n-7\).</para></solution></exercise>
      
      <exercise id="_4ff598c9-dc47-43e1-95a4-4660909eca7c" class="multiple-choice"><problem id="prob-00010"><para id="para-00060">A sequence of numbers is given by \(\frac{1}{27}\), \(\frac19\), \(\frac13\), 1, …. What is the equation that can be used to find the \(n^{th}\) term of the sequence?</para>
      <para id="para-00061">Multiple Choice:</para><para id="para-00062">\(a_n = \frac{1}{27}-\frac{1}{3}(n-1)\)</para><para id="para-00063">\(a_n = \frac{1}{27}(\frac{1}{3})^{n-1}\)</para><para id="para-00064">\(a_n = \frac{1}{27}(3)^{n-1}\)</para><para id="para-00065">\(a_n = \frac{1}{27}\div3(n-1)\)</para></problem><solution id="sol-00010"><para id="para-00066">Correct! \(a_n = \frac{1}{27}(3)^{n-1}\)</para><para id="para-00067">Try again. Revisit activities 4.18.2 – 4.18.4.</para><para id="para-00068">The correct answer is \(a_n = \frac{1}{27}(3)^{n-1}\).</para></solution></exercise>
      
      <exercise id="_534149b6-1201-4140-aeed-e7efc99df673" class="multiple-choice"><problem id="prob-00011"><para id="para-00069">A sequence is given by the set of numbers 5, 1, -3, -7 … What is the equation that can be used to find the \(n^{th}\) term of the sequence?</para>
      <para id="para-00070">Multiple Choice:</para><para id="para-00071">\(a_n = 5 + (n-1)(-4)\)</para><para id="para-00072">\(a_n = 5(-4)^{n-1}\)</para><para id="para-00073">\(a_n = 5(4)^{n-1}\)</para><para id="para-00074">\(a_n = 5 - (n-1)(-4)\)</para></problem><solution id="sol-00011"><para id="para-00075">Correct! \(a_n = 5 + (n-1)(-4)\)</para><para id="para-00076">Try again. Revisit activities 4.18.2 – 4.18.4.</para><para id="para-00077">The correct answer is \(a_n = 5 + (n-1)(-4)\).</para></solution></exercise></section>
<!--Do not edit this div tag.  It must surround the interaction block-->
<section id="sect-00003"><exercise id="a213731c-aa53-490d-a01a-b1b95c11851b" class="multiple-choice"><problem id="prob-00012"><para id="para-00078">A sequence consists of the following terms: 1280, 320, 80, … What is the explicit formula for this sequence?</para>
      <para id="para-00079">Multiple Choice:</para><para id="para-00080">\(a_n = 1280 - 960(n-1)\)</para><para id="para-00081">\(a_n = 1280 (4)^{n-1}\)</para><para id="para-00082">\(a_n = 1280 (\frac 14)^{n-1}\)</para><para id="para-00083">\(a_n = 1280 \div 4(n-1)\)</para></problem><solution id="sol-00012"><para id="para-00084">Correct! \(a_n = 1280 (\frac 14)^{n-1}\)</para><para id="para-00085">Try again. Revisit activities 4.18.2 – 4.18.4.</para><para id="para-00086">The correct answer is \(a_n = 1280 (\frac 14)^{n-1}\) .</para></solution></exercise>
      
      <exercise id="_4756240a-7f43-40ce-930b-8c33a8a7c052" class="multiple-choice"><problem id="prob-00013"><para id="para-00087">An arithmetic sequence consists of the terms 1, 6, 11, 16 …. If you were asked to find the \(100^{th}\) term, what is the general formula you would use to find that value efficiently?</para>
      <para id="para-00088">Multiple Choice:</para><para id="para-00089">\(a_n = 1 +5(n-1)\)</para><para id="para-00090">\(a_n = 1 (a_{n-1})^5\)</para><para id="para-00091">\(a_n = 5+ a_{n-1}\)</para><para id="para-00092">\(a_n = 1 + 5(a_{n-1})\)</para></problem><solution id="sol-00013"><para id="para-00093">Correct! \(a_n = 1 +5(n-1)\)</para><para id="para-00094">Try again. Revisit activities 4.18.2 – 4.18.4.</para><para id="para-00095">The correct answer is \(a_n = 1 +5(n-1)\).</para></solution></exercise></section></section>
</content></document>