                <m:mi>h</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>6</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>87</m:mn>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction End -->

      <para id="para-00011">Evaluate each function for <m:math display="inline">
