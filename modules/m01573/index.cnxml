  <content>
  <section><title>Activity</title>
<para>Evaluate each function for \(h(-4)\), \(h(0)\), and \(h(6)\).</para>

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(h(x) = 3x^2 - 7x - 9\)</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>\(h(-4) = 67\)
      \(h(0) = -9\)
      \(h(6) = 57\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(h(x) =-4x^2 - 3x + 2\)</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>\(h(-4) = -50\)
      \(h(0) = 2\)
      \(h(6) = -160\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(h(x) = -2x^2 - 5x +15\)</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>\(h(-4) = 3\)
      \(h(0) = 15\)
      \(h(6) = -87\)</para>
  
  </solution></exercise>
<!--Interaction End -->

<para>Evaluate each function for \(d(-2)\), \(d(0)\), and \(d(3)\).</para>

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\( d(x) = 8x^2 - 2x + 6\)</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>\(d(-2) = 42\)
      \(d(0) = 6\)
      \(d(3) = 72\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(d(x) = -5x^2 - 4x + 10\)</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>\(d(-2) = -2\)
      \(d(0) = 10\)
      \(d(3) = -47\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\( d(x) = -3x^2 + 6x + 7\)</para>
    </problem><solution>
    
    
  
  <para>Compare your answer:</para>
    
    <para>\(d(-2) = -17\)
      \(d(0) = 7\)
      \(d(3) = -2\)</para>
  
  </solution></exercise>
<!--Interaction End -->

<!--Q#7-->
<exercise>
  <problem>
