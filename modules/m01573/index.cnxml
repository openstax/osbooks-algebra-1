  <content>
    <section class="numbered-exercises" id="sect-00001">
      <title>Activity</title>
      <para id="para-00001">Evaluate each function for <m:math display="inline">
          <m:mrow>
            <m:mi>h</m:mi>
            <m:mo stretchy="false">(</m:mo>
            <m:mo>−</m:mo>
            <m:mn>4</m:mn>
            <m:mo stretchy="false">)</m:mo>
          </m:mrow>
        </m:math>, <m:math display="inline">
          <m:mrow>
            <m:mi>h</m:mi>
            <m:mo stretchy="false">(</m:mo>
            <m:mn>0</m:mn>
            <m:mo stretchy="false">)</m:mo>
          </m:mrow>
        </m:math>, and <m:math display="inline">
          <m:mrow>
            <m:mi>h</m:mi>
            <m:mo stretchy="false">(</m:mo>
            <m:mn>6</m:mn>
            <m:mo stretchy="false">)</m:mo>
          </m:mrow>
        </m:math>.</para>

      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002"><m:math>
              <m:mrow>
                <m:mi>h</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mn>3</m:mn>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>−</m:mo>
                <m:mn>7</m:mn>
                <m:mi>x</m:mi>
                <m:mo>−</m:mo>
                <m:mn>9</m:mn>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00001">


          <para id="para-00003">Compare your answer: </para>

          <para id="para-00004"><m:math display="inline">
              <m:mrow>
                <m:mi>h</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>−</m:mo>
                <m:mn>4</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mn>67</m:mn>
              </m:mrow>
            </m:math></para>
          <para id="para-00005"><m:math display="inline">
              <m:mrow>
                <m:mi>h</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>9</m:mn>
              </m:mrow>
            </m:math></para>
          <para id="para-00007"><m:math display="inline">
              <m:mrow>
                <m:mi>h</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>6</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mn>57</m:mn>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction End -->


      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00008"><m:math>
              <m:mrow>
                <m:mi>h</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>4</m:mn>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>−</m:mo>
                <m:mn>3</m:mn>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>2</m:mn>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00002">


          <para id="para-00006">Compare your answer: </para>

          <para id="para-00010"><m:math display="inline">
              <m:mrow>
                <m:mi>h</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>−</m:mo>
                <m:mn>4</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>50</m:mn>
              </m:mrow>
            </m:math></para>
          <para id="para-00012"><m:math display="inline">
              <m:mrow>
                <m:mi>h</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mn>2</m:mn>
              </m:mrow>
            </m:math></para>
          <para id="para-00014"><m:math display="inline">
              <m:mrow>
                <m:mi>h</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>6</m:mn>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mn>160</m:mn>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction End -->


      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00015"><m:math>
              <m:mrow>
