<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.5.1: Roots of Squares</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02406</md:content-id>
    <md:title>9.5.1: Roots of Squares</md:title>
    <md:uuid>fd97581e-8e72-4a81-aaa9-a0e5ab32d06d</md:uuid>
  </metadata>
  <content>
    <section>
      <title>Warm Up Activity</title>
      <para>Here are some squares whose vertices are on a grid.</para>
      <para>
        <figure>
          <media alt="Insert Alt Text">
            <image mime-type="image/svg+xml" src="../../media/Algebra-1_10_07_02_01.svg" />
          </media>
        </figure>
      </para>
      <para>Find the area and the side length of each square.</para>
      <exercise id="_2c72c3d6-9b25-4cb7-ad41-c69f8a623543" class="multiple-choice">
        <problem>
          <para>Enter the area of Graph A.</para>
          <para>What is the area of Graph A?</para>
        </problem>
        <solution>
          <para>Correct! 9 square units.</para>
          <para>The correct answer is 9 square units.</para>
        </solution>
      </exercise>
      <exercise id="_74826fb0-6fd4-4f69-8928-2f3aa12d03e8" class="multiple-choice">
        <problem>
          <para>Enter the side length of Graph A.</para>
          <para>What is the side length of Graph A?</para>
        </problem>
        <solution>
          <para>Correct! 3 units.</para>
          <para>The correct answer is 3 units.</para>
        </solution>
      </exercise>
      <exercise id="_7a74fc27-e171-4f58-b93c-b6926c75ee18" class="multiple-choice">
        <problem>
          <para>Enter the area of Graph B.</para>
          <para>What is the area of Graph B?</para>
        </problem>
        <solution>
          <para>Correct! 2 square units.</para>
          <para>The correct answer is 2 square units.</para>
        </solution>
      </exercise>
      <exercise>
        <problem>
          <para>What is the side length of Graph B?</para>
          <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(\sqrt{2}\) units</para>
        </solution>
      </exercise>
      <exercise id="_3367baec-d3e7-4086-beba-94a2e2ba2356" class="multiple-choice">
        <problem>
          <para>Enter the area of Graph C.</para>
          <para>What is the area of Graph C?</para>
        </problem>
        <solution>
          <para>Correct! 10 square units.</para>
          <para>The correct answer is 10 square units.</para>
        </solution>
      </exercise>
      <exercise>
        <problem>
          <para>What is the side length of Graph C?</para>
          <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para>\(\sqrt{10}\) units</para>
        </solution>
      </exercise>
    </section>
  </content>
