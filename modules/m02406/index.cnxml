<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Roots of Squares</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02406</md:content-id>
    <md:title>Roots of Squares</md:title>
    <md:uuid>fd97581e-8e72-4a81-aaa9-a0e5ab32d06d</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>
      <para id="para-00001">Here are some squares whose vertices are on a grid.</para>
      <para id="para-00002">
          <media alt="Three squares are drawn on grid paper. On the left is a square labeled &quot;A&quot;  that has a side length of 3 units and is oriented upright. In the center is a smaller square labeled &quot;B.&quot; Square B is tilted up one unit showing that its side length lies on the diagonal of a unit square. On the right, another square labeled &quot;C&quot; is also tilted. Here, the side length of C shows that its length lies along a right triangle that is one unit tall and three units long.">
            <image mime-type="image/svg+xml" src="../../media/Algebra-1_10_07_02_01.svg"/>
          </media>
        
     </para>
      <para id="para-00003">Find the area and the side length of each square.</para>
      <exercise id="_2c72c3d6-9b25-4cb7-ad41-c69f8a623543" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00005">What is the area of Graph A?</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00006">9 square units.</para>
        </solution>
      </exercise>
      <exercise id="_74826fb0-6fd4-4f69-8928-2f3aa12d03e8" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00009">What is the side length of Graph A?</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00010">3 units.</para>
        </solution>
      </exercise>
      <exercise id="_7a74fc27-e171-4f58-b93c-b6926c75ee18" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00013">What is the area of Graph B?</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00014">2 square units.</para>
        </solution>
      </exercise>
      <exercise id="exer-00001">
        <problem id="prob-00004">
          <para id="para-00016">What is the side length of Graph B?</para>
          <para id="para-00017"></para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00018">Compare your answer: </para>
          <para id="para-00019"><m:math display="inline"><m:mrow><m:msqrt><m:mrow><m:mn>2</m:mn></m:mrow></m:msqrt></m:mrow></m:math> units</para>
        </solution>
      </exercise>
      <exercise id="_3367baec-d3e7-4086-beba-94a2e2ba2356" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00021">What is the area of Graph C?</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00022">10 square units.</para>
        </solution>
      </exercise>
      <exercise id="exer-00002">
        <problem id="prob-00006">
          <para id="para-00024">What is the side length of Graph C?</para>
          <para id="para-00025"></para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00026">Compare your answer: </para>
          <para id="para-00027"><m:math display="inline"><m:mrow><m:msqrt><m:mrow><m:mn>10</m:mn></m:mrow></m:msqrt></m:mrow></m:math> units</para>
        </solution>
      </exercise>
    </section>
  </content>
</document>
