  <content>
  <section><title>Warm Up Activity</title>
<para>Here are some squares whose vertices are on a grid.</para>
<para><figure><media alt="Insert Alt Text"><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/700b7d8bfe426c8ce18db3445ff0e69c45963d39"/></media></figure></para>
<para>Find the area and the side length of each square.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="2f211b16-bc43-42d6-93f3-63a8e9fbc6b0" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1-->
  <exercise data-content-id="2c72c3d6-9b25-4cb7-ad41-c69f8a623543" data-problem-comparator="integer" data-problem-type="input" data-solution="9">
    <problem>
      <para>What is the area of Graph A?</para>
      <para>Enter the area of Graph A.</para>
    </problem>
    <solution>
      <para>Correct! 9 square units.</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q2-->
  <exercise data-content-id="74826fb0-6fd4-4f69-8928-2f3aa12d03e8" data-problem-comparator="integer" data-problem-type="input" data-solution="3">
    <problem>
      <para>What is the side length of Graph A?</para>
      <para>Enter the side length of Graph A.</para>
    </problem>
    <solution>
      <para>Correct! 3 units.</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q3-->
  <exercise data-content-id="7a74fc27-e171-4f58-b93c-b6926c75ee18" data-problem-comparator="integer" data-problem-type="input" data-solution="2">
    <problem>
      <para>What is the area of Graph B?</para>
      <para>Enter the area of Graph B.</para>
    </problem>
    <solution>
      <para>Correct! 2 square units.</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Do not edit below line.-->
  <solution>
    <!-- INSERT ANY VALID HTML HERE -->
  </solution>
  <div class="os-raise-ib-pset-encourage-response">
    <!-- INSERT ANY VALID HTML HERE -->
  </div>
</div>
<example><exercise>
  <problem>
    
    <para>What is the side length of Graph B?</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\(\sqrt{2}\) units</para>
</solution></exercise>
</example>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="ade3e51d-68c3-4900-8e0a-b6a83714ce8a" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q5-->
  <exercise data-content-id="3367baec-d3e7-4086-beba-94a2e2ba2356" data-problem-comparator="integer" data-problem-type="input" data-solution="10">
    <problem>
      <para>What is the area of Graph C?</para>
      <para>Enter the area of Graph C.</para>
    </problem>
    <solution>
      <para>Correct! 10 square units.</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
