  <content>
  <section><title>Warm Up Activity</title>
<para>Consider the function \(f\) given by \(f(n)=3n−7\). This function takes an input, multiplies it by 3, and then subtracts 7.</para>
<para>Evaluate.</para>

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(f(10)\)</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>23</para>
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(f(10)−1\)</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>22</para>
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(f(10−1)\)</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>20</para>
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(f(5)−f(4)\)</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>3</para>
  </solution></exercise>
<!--Interaction End -->
</section>
</content>
