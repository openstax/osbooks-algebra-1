<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Interpreting Function Notation</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01150</md:content-id>
    <md:title>Interpreting Function Notation</md:title>
    <md:uuid>916a2852-d394-4c29-9a61-6dc8499ee8ac</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Warm Up</title>
<para id="para-00001">Consider the function <m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math> given by <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>3</m:mn><m:mi>n</m:mi><m:mi>−</m:mi><m:mn>7</m:mn></m:mrow></m:math>. This function takes an input, multiplies it by 3, and then subtracts 7.</para>
<para id="para-00002">Evaluate.</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00003"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00001">
    
    
  
  <para id="para-00004">Compare your answer: </para>
    
    <para id="para-00005">23</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00006"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo><m:mi>−</m:mi><m:mn>1</m:mn></m:mrow></m:math></para></problem><solution id="sol-00002">
    
    
  
  <para id="para-00007">Compare your answer:</para>
    
    <para id="para-00008">22</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00009"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00003">
    
    
  
  <para id="para-00010">Compare your answer:</para>
    
    <para id="para-00011">20</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00012"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mi>−</m:mi><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem><solution id="sol-00004">
    
    
  
  <para id="para-00013">Compare your answer:</para>
    
    <para id="para-00014">3</para>
  
  </solution></exercise>
<!--Interaction End -->
</section>
</content></document>