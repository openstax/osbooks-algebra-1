  <content>
  <section id="sect-00001"><title>Warm Up Activity</title>
<para id="para-00001">Consider the function \(f\) given by \(f(n)=3n−7\). This function takes an input, multiplies it by 3, and then subtracts 7.</para>
<para id="para-00002">Evaluate.</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00003">\(f(10)\)</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00004">Compare your answer:</para>
    
    <para id="para-00005">23</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00006">\(f(10)−1\)</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00007">Compare your answer:</para>
    
    <para id="para-00008">22</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00009">\(f(10−1)\)</para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00010">Compare your answer:</para>
    
    <para id="para-00011">20</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00012">\(f(5)−f(4)\)</para>
    </problem><solution id="sol-00004">
    
    
  
  <para id="para-00013">Compare your answer:</para>
    
    <para id="para-00014">3</para>
  
  </solution></exercise>
<!--Interaction End -->
</section>
