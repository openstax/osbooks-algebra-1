      <section id="sect-00002">
        <title>Using Technology to Find the Rational Factors</title>
        <para id="para-00018">Watch the following video to learn more about using technology to find the rational factors of a <term class="glossary-tooltip" id="term-00003">quadratic equation</term>.</para>
        <media alt="Placeholder for Alt Text">
          <iframe width="660" height="371.4" src="https://k12.openstax.org/contents/raise/resources/c4a36219b2c62fa8ffe57f47a507437fcb41b12f"/>
        </media>
      </section>
    </section>
    <note class="self-check" id="note-00001">
      <exercise id="exer-00005">
        <problem id="prob-00005">
