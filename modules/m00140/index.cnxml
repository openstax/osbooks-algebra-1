</example><!--Interaction End -->
<!--Q#-->
<exercise>
  <problem>
    <para>Write 3 linear inequalities in two variables given this table of values: </para>
    <table class="os-raise-skinnytable">
      <thead>
        <row>
          <entry scope="col" class="emphasis">\(x\)</entry>
          <entry scope="col" class="emphasis">\(y\)</entry>
        </row>
      </thead>
      <tbody>
        <row>
          <entry>4</entry>
          <entry>4</entry>
        </row>
        <row>
          <entry>1</entry>
          <entry>5</entry>
        </row>
        <row>
          <entry>-2</entry>
          <entry>3</entry>
        </row>
        <row>
          <entry>0</entry>
          <entry>0</entry>
        </row>
      </tbody>
    </table>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer: </para>
    <para> Answers will vary. </para>
