  <content>
  <section id="sect-00001"><title>Warm Up Activity</title>
<para id="para-00001">In this unit, remember to double click on mathematical expressions/equations to enlarge, if needed.</para>
<para id="para-00002">Identify which of the polynomials is a perfect square trinomial.</para>
<para id="para-00003">Helpful hints for recognizing perfect square trinomials:</para>
<list id="list-00001">
  <item> Are the first and last terms squares?</item>
  <item> Does the middle term fit the pattern of \(2ab\)?</item>
</list>

<!--Text Entry Interaction Start -->
<exercise>
  <problem id="prob-00001">
    <para id="para-00004"> \(25v^2 + 20v + 4\)</para>
    </problem><solution id="sol-00001">
    
    <para id="para-00005">Enter your answer here:</para>
  
  <para id="para-00006">Compare your answer:</para>
    
    <para id="para-00007"> yes</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem id="prob-00002">
    <para id="para-00008"> \(49s^2 + 154s + 121\)</para>
    </problem><solution id="sol-00002">
    
    <para id="para-00009">Enter your answer here:</para>
  
  <para id="para-00010">Compare your answer:</para>
    
    <para id="para-00011"> yes</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem id="prob-00003">
    <para id="para-00012"> \(25r^2 + 65rs + 36s^2\)</para>
    </problem><solution id="sol-00003">
    
    <para id="para-00013">Enter your answer here:</para>
  
  <para id="para-00014">Compare your answer:</para>
    
    <para id="para-00015">no, 65 is not equal to \(2ab (2 \times 5 \times 6)\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem id="prob-00004">
    <para id="para-00016"> \(64z^2 − 16z + 1\)</para>
    </problem><solution id="sol-00004">
    
    <para id="para-00017">You can use the following video if you need some help.</para>
    
    <media alt="Placeholder for Alt Text"><iframe width="660" height="371.4" src="https://k12.openstax.org/contents/raise/resources/18ccd476db1810603414d36e9799c638a3c7377d"/></media><para id="para-00018">Enter your answer here:</para>
  
  <para id="para-00019">Compare your answer:</para>
    
    <para id="para-00020"> yes</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem id="prob-00005">
    <para id="para-00021"> \(49x^2 + 28xy + 9y^2\)</para>
    </problem><solution id="sol-00005">
    
    <para id="para-00022">Enter your answer here:</para>
  
  <para id="para-00023">Compare your answer:</para>
    
    <para id="para-00024">no, 28 is not equal to \(2ab (2 \times 7 \times 3)\)</para>
  
  </solution></exercise>
