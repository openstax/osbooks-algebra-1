  <content>
  <section><title>Warm Up Activity</title>
<para>In this unit, remember to double click on mathematical expressions/equations to enlarge, if needed.</para>
<para>Identify which of the polynomials is a perfect square trinomial.</para>
<para class="os-raise-text-bold">Helpful hints for recognizing perfect square trinomials:</para>
<list>
  <item> Are the first and last terms squares? </item>
  <item> Does the middle term fit the pattern of \(2ab\)? </item>
</list>

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> \(25v^2 + 20v + 4\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para> yes</para>
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> \(49s^2 + 154s + 121\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para> yes</para>
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> \(25r^2 + 65rs + 36s^2\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>no, 65 is not equal to \(2ab (2 \times 5 \times 6)\)</para>
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> \(64z^2 − 16z + 1\) </para>
    </problem><solution>
    
    <para>You can use the following video if you need some help.</para>
    <div class="os-raise-d-flex-nowrap os-raise-justify-content-center">
      <div class="os-raise-video-container"><video controls="true" crossorigin="anonymous">
          <source src="https://k12.openstax.org/contents/raise/resources/18ccd476db1810603414d36e9799c638a3c7377d">
          <track default="true" kind="captions" label="On" src="https://k12.openstax.org/contents/raise/resources/64aefedd406b3e389b225c111dde7f001805f8bf" srclang="en_us">
        </track></source></video></div>
    </div>
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para> yes</para>
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> \(49x^2 + 28xy + 9y^2\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>no, 28 is not equal to \(2ab (2 \times 7 \times 3)\)</para>
  </solution></exercise>
<!--Interaction End --></section>
