<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Identifying Perfect Square Trinomials</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01679</md:content-id>
    <md:title>Identifying Perfect Square Trinomials</md:title>
    <md:uuid>fc02617a-39a5-4872-9e11-c3067e54a879</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">
      <title>Warm Up</title>
      <para id="para-00002">Identify which of the polynomials is a perfect square trinomial.</para>
      <para id="para-00003"><emphasis>Helpful hints for recognizing perfect square trinomials:</emphasis></para>
      <list id="list-00001">
        <item>Are the first and last terms squares?</item>
        <item>Does the middle term fit the pattern of <m:math display="inline">
            <m:mrow>
              <m:mn>2</m:mn>
              <m:mi>a</m:mi>
              <m:mi>b</m:mi>
            </m:mrow>
          </m:math>?</item>
      </list>

      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00004"><m:math display="inline">
              <m:mrow>
                <m:mn>25</m:mn>
                <m:msup>
                  <m:mi>v</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>20</m:mn>
                <m:mi>v</m:mi>
                <m:mo>+</m:mo>
                <m:mn>4</m:mn>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00001">


          <para id="para-00005">Compare your answer: </para>

          <para id="para-00006"> yes</para>

        </solution>
      </exercise>
      <!--Interaction End -->


      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00007"><m:math display="inline">
              <m:mrow>
                <m:mn>49</m:mn>
                <m:msup>
                  <m:mi>s</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>154</m:mn>
                <m:mi>s</m:mi>
                <m:mo>+</m:mo>
                <m:mn>121</m:mn>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00002">


          <para id="para-00008">Compare your answer: </para>

          <para id="para-00009"> yes</para>

        </solution>
      </exercise>
      <!--Interaction End -->


      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010"><m:math display="inline">
              <m:mrow>
                <m:mn>25</m:mn>
                <m:msup>
                  <m:mi>r</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>65</m:mn>
                <m:mi>r</m:mi>
                <m:mi>s</m:mi>
                <m:mo>+</m:mo>
                <m:mn>36</m:mn>
                <m:msup>
                  <m:mi>s</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00003">


          <para id="para-00011">Compare your answer: </para>

          <para id="para-00012">no, 65 is not equal to <m:math display="inline">
              <m:mrow>
                <m:mn>2</m:mn>
                <m:mi>a</m:mi>
                <m:mi>b</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>2</m:mn>
                <m:mo>×</m:mo>
                <m:mn>5</m:mn>
                <m:mo>×</m:mo>
                <m:mn>6</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>

        </solution>
      </exercise>
      <!--Interaction End -->


      <!--Text Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00013"><m:math display="inline">
              <m:mrow>
                <m:mn>64</m:mn>
                <m:msup>
                  <m:mi>z</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>&#8722;</m:mo>
                <m:mn>16</m:mn>
                <m:mi>z</m:mi>
                <m:mo>+</m:mo>
                <m:mn>1</m:mn>
              </m:mrow>
            </m:math></para>
            <para id="para-00014">You can use the following video if you need some help.</para>

          <media alt="A Youtube video entitled ‘Problem Animation: Factoring a Perfect Square Trinomial’ produced by OpenStax.">
            <iframe width="660" height="371.4" src="https://openstax.org/r/perfect-square-trinomial"/>
          </media>
        </problem>
        <solution id="sol-00004">
          <para id="para-00016">Compare your answer: </para>

          <para id="para-00017"> yes</para>

        </solution>
      </exercise>
      <!--Interaction End -->


      <!--Text Entry Interaction Start -->
      <exercise id="exer-00005">
        <problem id="prob-00005">
          <para id="para-00015"><m:math display="inline">
              <m:mrow>
                <m:mn>49</m:mn>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>28</m:mn>
                <m:mi>x</m:mi>
                <m:mi>y</m:mi>
                <m:mo>+</m:mo>
                <m:mn>9</m:mn>
                <m:msup>
                  <m:mi>y</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00005">

          <para id="para-00020">Compare your answer: </para>

          <para id="para-00021">no, 28 is not equal to <m:math display="inline">
              <m:mrow>
                <m:mn>2</m:mn>
                <m:mi>a</m:mi>
                <m:mi>b</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>2</m:mn>
                <m:mo>×</m:mo>
                <m:mn>7</m:mn>
                <m:mo>×</m:mo>
                <m:mn>3</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para>

        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>