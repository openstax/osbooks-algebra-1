<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Graphing Using Transformations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01059</md:content-id>
    <md:title>Graphing Using Transformations</md:title>
    <md:uuid>fd775b0d-eaf8-4961-bf13-fe0f9d817f22</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
      <para id="para-00001">For questions 1 - 4, match each equation of the linear functions with one of the lines in the given graph.</para>
      <para id="para-00003">
          <media alt="Graph of four functions where the orange line has a y-intercept at 3 and slope of 2, the baby blue line has a y-intercept at 3 and slope of one-half, the blue line has a y-intercept at 3 and slope of negative 2, and the green line has a y-intercept at negative 3 and slope of 2.">
            <image mime-type="image/jpeg" src="../../media/Algebra-1_04_14_15_01.jpg"/>
          </media>
        
    </para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00004"><m:math><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00001">
          <para id="para-00005">Compare your answer: </para>
          <para id="para-00006">I</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00007"><m:math><m:mrow><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>–</m:mo><m:mn>3</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00002">
          <para id="para-00008">Compare your answer: </para>
          <para id="para-00009">III</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010"><m:math><m:mrow><m:mi>h</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo>–</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00003">
          <para id="para-00011">Compare your answer: </para>
          <para id="para-00012">IV</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00013"><m:math><m:mrow><m:mi>j</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00004">
          <para id="para-00014">Compare your answer: </para>
          <para id="para-00015">II</para>
        </solution>
      </exercise>
      <!--Interaction End -->

        <exercise id="_5f4f2259-2fef-4583-987d-86e9687e8b43" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00016">How will the graph of
              <m:math display="inline"><m:mrow>
                <m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mi>x</m:mi>
              </m:mrow></m:math> be affected if the transformation
              <m:math display="inline"><m:mrow>
                <m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>-</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo>
              </m:mrow></m:math> is applied?</para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00017">The graph will be shifted 3 units to the right. This happens because the transformation <m:math display="inline"><m:mrow><m:mi>k</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>–</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> moves the graph horizontally to the right by 3 units.</para>
          </solution>
        </exercise>

    </section>
  </content></document>