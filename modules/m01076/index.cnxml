  <title>4.12.3: Range: The Output of a Function</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01076</md:content-id>
    <md:title>4.12.3: Range: The Output of a Function</md:title>
