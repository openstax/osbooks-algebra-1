<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.1.1: Understanding Exponents</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01235</md:content-id>
    <md:title>5.1.1: Understanding Exponents</md:title>
    <md:uuid>83a005c1-4f25-4d64-a5f0-7bbf949e73ba</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Warm Up Activity</title>
      <para id="para-00001">An exponent indicates repeated multiplication of the same quantity.</para>
      <para id="para-00002">
          <media alt="First example: a raised to the power of m equals a times a times a times a and so on until you have multiplied m different factors of a together. Second example: the quantity negative 9 raised to the power of 5 equals negative 9 times negative 9 times negative 9 times negative 9 times negative 9, a total of 5 factors of negative 9.">
            <image mime-type="image/jpeg" src="../../media/Algebra-1_05_03_02_01.jpg"/>
          </media>
        
    </para>
      <para id="para-00003">Expand each exponential expression to show repeated multiplication.</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00004">\(4^3\)= ____________</para>
          
        </problem>
        <solution id="sol-00001">
          <para id="para-00005">Compare your answer:</para>
          <para id="para-00006">\(4 \cdot 4 \cdot 4\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00007">\(x^5\)= ____________</para>
          
        </problem>
        <solution id="sol-00002">
          <para id="para-00008">Compare your answer:</para>
          <para id="para-00009">\(x \cdot x \cdot x \cdot x \cdot x\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010">\((-8)^6\) = ____________</para>
          
        </problem>
        <solution id="sol-00003">
          <para id="para-00011">Compare your answer:</para>
          <para id="para-00012">\((-8) \cdot (-8) \cdot (-8) \cdot (-8) \cdot (-8) \cdot (-8)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00013">\((-z)^3\) = ____________</para>
          
        </problem>
        <solution id="sol-00004">
          <para id="para-00014">Compare your answer:</para>
          <para id="para-00015">\((-z) \cdot (-z) \cdot (-z)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>