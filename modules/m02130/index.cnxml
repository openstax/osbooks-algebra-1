<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Finding the Solutions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02130</md:content-id>
    <md:title>Finding the Solutions</md:title>
    <md:uuid>0e9d6510-eab9-450f-b307-2d7d6976180c</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
      <para id="para-00001">Use what you have learned in the lesson to solve the following quadratic equations.</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002"><m:math><m:mrow><m:mn>5</m:mn><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>80</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00001">

          <para id="para-00004">Compare your answer: </para>
          <para id="para-00005"><m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
          <para id="para-00006"><m:math><m:mrow><m:mn>5</m:mn><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>80</m:mn></m:mrow></m:math></para><para id="para-00007"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>5</m:mn><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>80</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00008"><m:math><m:mrow><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>16</m:mn></m:mrow></m:math></para><para id="para-00009"><m:math><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mi>±</m:mi><m:msqrt><m:mrow><m:mn>16</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para><para id="para-00010"><m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00011"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>m</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>100</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00002">

          <para id="para-00013">Compare your answer: </para>
          <para id="para-00014"><m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>16</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
          <para id="para-00015"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>m</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>100</m:mn></m:mrow></m:math></para><para id="para-00016"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>m</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>±</m:mi><m:msqrt><m:mrow><m:mn>100</m:mn></m:mrow></m:msqrt></m:mrow></m:math></para><para id="para-00017"><m:math><m:mrow><m:mi>m</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>10</m:mn><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mi>m</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>10</m:mn></m:mrow></m:math></para><para id="para-00018"><m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>16</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00019"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>8</m:mn><m:mo>=</m:mo><m:mi>−</m:mi><m:mn>2</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00003">

          <para id="para-00021">Compare your answer: </para>
          <para id="para-00022"><m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
          <para id="para-00023"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>8</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac><m:mrow><m:mo stretchy="true" fence="true" form="prefix">(</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo stretchy="true" fence="true" form="postfix">)</m:mo></m:mrow></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac><m:mrow><m:mo stretchy="true" fence="true" form="prefix">(</m:mo><m:mn>6</m:mn><m:mo stretchy="true" fence="true" form="postfix">)</m:mo></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>9</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>±</m:mi><m:msqrt><m:mn>9</m:mn></m:msqrt></m:mtd></m:mtr></m:mtable></m:mrow></m:math><m:math display="inline"><m:mrow><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00024"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>6</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>8</m:mn><m:mo>=</m:mo><m:mn>16</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00004">

          <para id="para-00026">Compare your answer: </para>
          <para id="para-00027"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>15</m:mn></m:mrow></m:math></para>
          <para id="para-00028"><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac><m:msup><m:mrow><m:mo stretchy="true" fence="true" form="prefix">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="true" fence="true" form="postfix">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>8</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>16</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac><m:msup><m:mrow><m:mo stretchy="true" fence="true" form="prefix">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="true" fence="true" form="postfix">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>24</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:msup><m:mrow><m:mo stretchy="true" fence="true" form="prefix">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="true" fence="true" form="postfix">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>144</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mrow><m:mo stretchy="true" fence="true" form="prefix">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="true" fence="true" form="postfix">)</m:mo></m:mrow></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>±</m:mi><m:msqrt><m:mrow><m:mn>144</m:mn></m:mrow></m:msqrt></m:mtd></m:mtr></m:mtable></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>12</m:mn><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>12</m:mn></m:mrow></m:math> <m:math display="inline"><m:mrow><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>15</m:mn></m:mrow></m:math></para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>