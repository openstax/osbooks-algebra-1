<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.3.4: Finding the Solutions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02130</md:content-id>
    <md:title>8.3.4: Finding the Solutions</md:title>
    <md:uuid>0e9d6510-eab9-450f-b307-2d7d6976180c</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Cool Down Activity</title>
      <para id="para-00001">Use what you have learned in the lesson to solve the following quadratic equations.</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002">\(5m^2= 80\)</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Enter the solution to the equation.</para>
          <para id="para-00004">Compare your answer:</para>
          <para id="para-00005">\(m=4\) and \(m=-4\)</para>
          <para id="para-00006">\(5m^2=80\)</para>
          <para id="para-00007">\(\frac{5m^2}{5}=\frac{80}{5}\)</para>
          <para id="para-00008">\(m^2=16\)</para>
          <para id="para-00009">\(m=\pm \sqrt{16}\)</para>
          <para id="para-00010">\(m=4\) and \(m=-4\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00011">\((m−6)^2=100\)</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00012">Enter the solution to the equation.</para>
          <para id="para-00013">Compare your answer:</para>
          <para id="para-00014">\(m=16\) and \(m=-4\)</para>
          <para id="para-00015">\((m−6)^2=100\)</para>
          <para id="para-00016">\((m−6)=\pm \sqrt{100}\)</para>
          <para id="para-00017">\(m−6=10\;\;\;\;m−6=-10\)</para>
          <para id="para-00018">\(m =16\) and \(m =-4\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00019">\(\frac{2}{3}y^2−8=−2\)</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00020">Enter the solution to the equation.</para>
          <para id="para-00021">Compare your answer:</para>
          <para id="para-00022">\(y=3\) and \(y=-3\)</para>
          <para id="para-00023">\(\begin{array}{rcl}\frac23y^2-8&amp;=&amp;-2\\\frac23y^2&amp;=&amp;6\\\frac32\left(\frac23y^2\right)&amp;=&amp;\frac32\left(6\right)\\y^2&amp;=&amp;9\\y&amp;=&amp;\pm\sqrt9\end{array}\)\(\;\;\;\;\;\;y=3\) and \(y=-3\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00024">\(\frac{1}{6}(x+3)^2−8=16\)</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00025">Enter the solution to the equation.</para>
          <para id="para-00026">Compare your answer:</para>
          <para id="para-00027">\(x=9\) and \(x=-15\)</para>
          <para id="para-00028">\(\begin{array}{rcl}\frac16\left(x+3\right)^2-8&amp;=&amp;16\\\frac16\left(x+3\right)^2&amp;=&amp;24\\\left(x+3\right)^2&amp;=&amp;144\\\left(x+3\right)&amp;=&amp;\pm\sqrt{144}\end{array}\) \(\;\;\;\;\;\;\;x+3=12\;\;\;\;\;\;x+3=-12\) \(\;\;\;\;\;\;\;\;\;\;\;\;\;\;x=9\) and \(x=-15\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
