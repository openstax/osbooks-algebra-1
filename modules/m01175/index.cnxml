<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Geometric Recursive Definitions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01175</md:content-id>
    <md:title>Geometric Recursive Definitions</md:title>
    <md:uuid>e0f368cd-c361-46d5-8b68-97253dd4bcdf</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
      <para id="para-00001">The geometric sequence <m:math display="inline"><m:mrow><m:mi>G</m:mi></m:mrow></m:math> starts 12, 6, . . .</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002">Write a recursive definition for sequence <m:math display="inline"><m:mrow><m:mi>G</m:mi></m:mrow></m:math>.</para>
          
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Compare your answer: </para>
          <para id="para-00004"><m:math display="inline"><m:mrow><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>0.5</m:mn><m:mi>⋅</m:mi><m:mi>g</m:mi><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> for <m:math display="inline"><m:mrow><m:mi>n</m:mi><m:mo>≥</m:mo><m:mn>2</m:mn></m:mrow></m:math> or equivalent.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <media alt="insert alt text"><iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/></media><!--Interaction End -->
      
        <exercise id="exer-00002">
          <problem id="prob-00002">
            <para id="para-00005">Use the graphing tool above or technology outside the course. Sketch a graph representing the first 5 terms of sequence <m:math display="inline"><m:mrow><m:mi>G</m:mi></m:mrow></m:math>.</para>
            
          </problem>
          <solution id="sol-00002">
            <para id="para-00007">Compare your answers:</para>
            <para id="para-00008">
                      <media alt="A scatter plot with five points showing a downward trend as n increases. The y-axis ranges from 0 to 14, and the x-axis ranges from 0 to 6. Points are plotted at (1,12), (2,6), (3,3), (4,1.5), and (5,1).">
                  <image mime-type="image/svg+xml" src="../../media/Algebra-1_04_20_09_01.svg"/>
                </media>
              
          </para>
          </solution>
        </exercise>
      
    </section>
  </content>
