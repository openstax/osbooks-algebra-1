    <section>
      <title>Cool Down Activity</title>
      <para>The geometric sequence \(G\) starts 12, 6, . . .</para>
      <!--Text Entry Interaction Start -->
      <exercise>
        <problem>
          <para>Write a recursive definition for sequence \(G\).</para>
          <para>Enter your answer here:</para>
        </problem>
        <solution>
          <para>Compare your answer:</para>
          <para> \(g(1)=12, g(n)=0.5⋅g(n−1)\) for \(n\geq2\) or equivalent.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <iframe src="../../media/desmos/a47b5bb4ba783be55a7067b919f165f14dcc36ce.html" width="500" height="400"/><!--Interaction End -->
