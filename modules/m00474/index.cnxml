<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.7.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00474</md:content-id>
    <md:title>2.7.5: Practice</md:title>
    <md:uuid>0512002f-0a6d-4a3c-8c92-b29bf33c395b</md:uuid>
  </metadata>
  <content>
  <section><para>Students will complete the following questions to practice the skills they have learned in this lesson.</para>
<para>For questions 1 – 8, solve each system of equations to determine if there is one solution, no solution, or infinitely many solutions.</para>


  <!--Q1-->
 <list class="os-raise-noindent" type="enumerated">
    <item> \(\left\{\begin{array}{rcl}5x\;-\;3y\;&amp;=&amp;\;7\\x\;-\;0.6y\;&amp;=&amp;\;1.4\end{array}\right.\) </item>
 </list>
 <list>
    <item>one solution</item>
    <item>no solution</item>
    <item>infinitely many solutions</item>
 </list>
 <para><emphasis>Answer: </emphasis>infinitely many solutions</para>
  
 <!--END QUESTION.-->



  <!--Q2-->
  <list class="os-raise-noindent" start="2" type="enumerated">
    <item>\(\left\{\begin{array}{rcl}-x\;+\;2y\;&amp;=&amp;\;-1\\5x\;-\;10y\;&amp;=&amp;\;6\end{array}\right.\)</item>
  </list>
  <list>
    <item>one solution</item>
    <item>no solution</item>
    <item>infinitely many solutions</item>
 </list>
 <para><emphasis>Answer: </emphasis>no solution</para>
  
  <!--END QUESTION.-->



  <!--Q3-->
  <list class="os-raise-noindent" start="3" type="enumerated">
    <item> \(\left\{\begin{array}{rcl}7x+6y&amp;=&amp;2\\-28x-24y&amp;=&amp;-8\end{array}\right.\)</item>
  </list>
  <list>
    <item>one solution</item>
    <item>no solution</item>
    <item>infinitely many solutions</item>
 </list>
 <para><emphasis>Answer: </emphasis>infinitely many solutions</para>
  
 <!--END QUESTION.-->

 
  <!--Q4-->
  <list class="os-raise-noindent" start="4" type="enumerated">
    <item> \(\left\{\begin{array}{rcl}-0.2x\;+\;0.4y\;&amp;=&amp;\;0.6\\x-2y&amp;=&amp;-3\end{array}\right.\) </item>
  </list>
  <list>
    <item>one solution</item>
    <item>no solution</item>
    <item>infinitely many solutions</item>
 </list>
 <para><emphasis>Answer: </emphasis>infinitely many solutions</para>
  
  <!--END QUESTION.-->


  <!--Q5-->
  <list class="os-raise-noindent" start="5" type="enumerated">
    <item> \(\left\{\begin{array}{rcl}-0.1x\;+\;0.2y\;&amp;=&amp;\;0.6\\5x-10y&amp;=&amp;1\end{array}\right.\) </item>
  </list>
  <list>
    <item>one solution</item>
    <item>no solution</item>
    <item>infinitely many solutions</item>
 </list>
 <para><emphasis>Answer: </emphasis>no solution</para>
  
  <!--END QUESTION.-->
  
  <!--Q6-->
  <list class="os-raise-noindent" start="6" type="enumerated">
    <item>\(\left\{\begin{array}{rcl}3x+6y&amp;=&amp;11\\\;2x+4y&amp;=&amp;9\end{array}\right.\)</item>
  </list>
  <list>
    <item>one solution</item>
    <item>no solution</item>
    <item>infinitely many solutions</item>
 </list>
 <para><emphasis>Answer: </emphasis>no solution</para>
  
  <!--END QUESTION.-->

  <!--Q7-->
 <list class="os-raise-noindent" start="7" type="enumerated">
    <item> \(\left\{\begin{array}{rcl}-x+2y=4\\\;2x-4y&amp;=&amp;1\end{array}\right.\) </item>
 </list>
 <list>
  <item>one solution</item>
  <item>no solution</item>
  <item>infinitely many solutions</item>
</list>
<para><emphasis>Answer: </emphasis>no solution</para>
 
<!--END QUESTION.-->

  <!--Q8-->
  <list class="os-raise-noindent" start="8" type="enumerated">
    <item> \(\left\{\begin{array}{rcl}3x-2y&amp;=&amp;5\\\;-9x+6y&amp;=&amp;-15\end{array}\right.\) </item>
  </list>
  <list>
    <item>one solution</item>
    <item>no solution</item>
    <item>infinitely many solutions</item>
 </list>
 <para><emphasis>Answer: </emphasis>infinitely many solutions</para>
  
  <!--END QUESTION.-->

  <!--Q9-->
  <list class="os-raise-noindent" start="9" type="enumerated">
    <item>Which system of equations has infinitely many solutions? </item>
  </list>
  <list>
    <item>\(\left\{\begin{array}{rcl}4x+3y&amp;=&amp;12\\\;8x+6y&amp;=&amp;-24\end{array}\right.\) </item>
    <item>\(\left\{\begin{array}{rcl}-4x+3y&amp;=&amp;12\\\;8x-6y&amp;=&amp;24\end{array}\right.\)</item>
    <item>\(\left\{\begin{array}{rcl}4x+3y&amp;=&amp;12\\\;8x+6y&amp;=&amp;12\end{array}\right.\)</item>
    <item>\(\left\{\begin{array}{rcl}-4x+3y&amp;=&amp;-12\\\;-8x+6y&amp;=&amp;-24\end{array}\right.\)</item>
  </list>
  <para><emphasis>Answer: </emphasis></para> 
  <para>\(\left\{\begin{array}{rcl}-4x+3y&amp;=&amp;-12\\\;-8x+6y&amp;=&amp;-24\end{array}\right.\)</para>
  <!--END QUESTION.-->


  <!--Q10-->
  <list class="os-raise-noindent" start="10" type="enumerated">
    <item> Which system of equations has no solution?</item>
  </list>
  <list>
    <item>\(\left\{\begin{array}{rcl}3x+7y&amp;=&amp;15\\\;3x+7y&amp;=&amp;40\end{array}\right.\) </item>
    <item>\(\left\{\begin{array}{rcl}3x-7y&amp;=&amp;15\\\;3x+7y&amp;=&amp;40\end{array}\right.\) </item>
    <item>\(\left\{\begin{array}{rcl}3x+7y&amp;=&amp;15\\\;6x+14y&amp;=&amp;30\end{array}\right.\) </item>
    <item>\(\left\{\begin{array}{rcl}9x+21y&amp;=&amp;270\\\;3x+7y&amp;=&amp;90\end{array}\right.\) </item>
  </list>
  <para><emphasis>Answer: </emphasis></para> 
  <para>\(\left\{\begin{array}{rcl}3x+7y&amp;=&amp;15\\\;3x+7y&amp;=&amp;40\end{array}\right.\) </para>
  <!--END QUESTION.-->
</section>
</content>
