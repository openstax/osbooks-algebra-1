<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="5c5b9689-768d-4dbe-b36d-2b656b6e72d4" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1a-->
  <exercise data-content-id="741e766d-8bc5-47dd-9de6-745f6ed37a69" data-problem-comparator="float" data-problem-type="input" data-solution="18">
    <problem>
      <para> When \(x=-3\) and \(x^2=9\), what is value of \(2x^2\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(2(-3)^2=2 \cdot 9=18\)</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Q1b-->
  <exercise data-content-id="f6d75941-6000-4943-a2bb-c1fa0c310e0b" data-problem-comparator="float" data-problem-type="input" data-solution="8">
    <problem>
      <para> When \(x=-2\) and \(x^2=4\), what is value of \(2x^2\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(2(-2)^2=2 \cdot 4=8\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1c-->
  <exercise data-content-id="7a7b18dd-3cf5-4867-af32-5236de55f86d" data-problem-comparator="float" data-problem-type="input" data-solution="2">
    <problem>
      <para> When \(x=-1\) and \(x^2=1\), what is value of \(2x^2\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(2(-1)2=2 \cdot 1=2\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1d-->
  <exercise data-content-id="ed8cb8ce-10ca-4b3c-8733-b9355270955f" data-problem-comparator="float" data-problem-type="input" data-solution="0">
    <problem>
      <para> When \(x=0\) and \(x^2=0\), what is value of \(2x^2\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(2(0)^2=2 \cdot 0=0\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1e-->
  <exercise data-content-id="16af383e-a948-4a67-90c8-6921a04c6dc4" data-problem-comparator="float" data-problem-type="input" data-solution="2">
    <problem>
      <para> When \(x=1\) and \(x^2=1\), what is value of \(2x^2\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(2(1)^2=2 \cdot 1=2\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1f-->
  <exercise data-content-id="55dbbb41-7edf-4c57-8ee1-18495cce6d54" data-problem-comparator="float" data-problem-type="input" data-solution="8">
    <problem>
      <para> When \(x=2\) and \(x^2=4\), what is value of \(2x^2\)? </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(2(2)^2=2 \cdot 4=8\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1g-->
  <exercise data-content-id="6a173281-6359-4277-9e56-378b2c27cddd" data-problem-comparator="float" data-problem-type="input" data-solution="18">
    <problem>
      <para> When \(x=3\) and \(x^2=9\), what is value of \(2x^2\)? </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(2(3)^2=2 \cdot 9=18\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
