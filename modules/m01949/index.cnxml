        <entry> 1 </entry>
        <entry> 0 </entry>
        <entry> 1 </entry>
        <entry> 4 </entry>
        <entry> 9 </entry>
      </row>
      <row>
        <entry><emphasis> \(x^2+10\) </emphasis></entry><entry> 19 </entry>
