        <exercise id="_1ef18c42-7b66-4440-b804-f22f26238680" class="multiple-choice">
          <problem id="prob-00031">
            <para id="para-00119">a. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>9</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                </m:mrow>
              </m:math>
              ?</para>
          </problem>
          <solution id="sol-00031">
            <para id="para-00120"><m:math display="inline">
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:mi>·</m:mi>
                  <m:mn>9</m:mn>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>18</m:mn>
                </m:mrow>
              </m:math></para>
        
          </solution>
        </exercise>

        <exercise id="_49a47e47-fe91-40f5-8b9c-f7e12aa93cb7" class="multiple-choice">
          <problem id="prob-00032">
            <para id="para-00123">b. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>4</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                </m:mrow>
              </m:math>
              ?</para>
          </problem>
          <solution id="sol-00032">
            <para id="para-00124"><m:math display="inline">
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:mi>·</m:mi>
                  <m:mn>4</m:mn>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>8</m:mn>
                </m:mrow>
              </m:math></para>
          </solution>
        </exercise>

        <exercise id="de9fc74b-58ce-4763-bb13-43ffae05b658" class="multiple-choice">
          <problem id="prob-00033">
            <para id="para-00127">c. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>1</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>1</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                </m:mrow>
              </m:math>
              ?</para>
          </problem>
          <solution id="sol-00033">
            <para id="para-00128"><m:math display="inline">
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>1</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:mi>·</m:mi>
                  <m:mn>1</m:mn>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                </m:mrow>
              </m:math></para>
         
          </solution>
        </exercise>

        <exercise id="_6f548ba3-e63f-4dc7-85a0-e84b52b5bae7" class="multiple-choice">
          <problem id="prob-00034">
            <para id="para-00131">d. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>0</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>0</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                </m:mrow>
              </m:math>
              ?</para>
          </problem>
          <solution id="sol-00034">
            <para id="para-00132"><m:math display="inline">
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mn>0</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:mi>·</m:mi>
                  <m:mn>0</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>0</m:mn>
                </m:mrow>
              </m:math></para>
     
          </solution>
        </exercise>

        <exercise id="_7cdbb75f-e4db-4503-9a20-d0cd22ce4d2f" class="multiple-choice">
          <problem id="prob-00035">
            <para id="para-00135">e. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>1</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>1</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                </m:mrow>
              </m:math>
              ?</para>
          </problem>
          <solution id="sol-00035">
            <para id="para-00136"><m:math display="inline">
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mn>1</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:mi>·</m:mi>
                  <m:mn>1</m:mn>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                </m:mrow>
              </m:math></para>
       </solution>
        </exercise>

        <exercise id="_2bdcc76e-34cf-47ad-a401-e3883a0314a3" class="multiple-choice">
          <problem id="prob-00036">
            <para id="para-00139">f. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>2</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>4</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                </m:mrow>
              </m:math>
              ?</para>
          </problem>
          <solution id="sol-00036">
            <para id="para-00140"><m:math display="inline">
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mn>2</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:mi>·</m:mi>
                  <m:mn>4</m:mn>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>8</m:mn>
                </m:mrow>
              </m:math></para>
     </solution>
        </exercise>

        <exercise id="_246cb693-cf66-408c-b773-b892056f5dcf" class="multiple-choice">
          <problem id="prob-00037">
            <para id="para-00143">g. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>9</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                </m:mrow>
              </m:math>
              ?</para>
          </problem>
          <solution id="sol-00037">
            <para id="para-00144"><m:math display="inline">
                <m:mrow>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mn>3</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:mi>·</m:mi>
                  <m:mn>9</m:mn>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>18</m:mn>
                </m:mrow>
              </m:math></para></solution>
        </exercise>
