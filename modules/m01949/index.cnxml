  <!--Q1a-->
  <exercise data-content-id="1ef18c42-7b66-4440-b804-f22f26238680" data-problem-comparator="float" data-problem-type="input" data-solution="-18">
    <problem>
      <para> When \(x=-3\) and \(x^2=9\), what is value of \(-2x^2\)? </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(-2(-3)^2=-2 \cdot 9=-18\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1b-->
  <exercise data-content-id="49a47e47-fe91-40f5-8b9c-f7e12aa93cb7" data-problem-comparator="float" data-problem-type="input" data-solution="-8">
    <problem>
      <para> When \(x=-2\) and \(x^2=4\), what is value of \(-2x^2\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(-2(-2)^2=-2 \cdot 4=-8\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1c-->
  <exercise data-content-id="de9fc74b-58ce-4763-bb13-43ffae05b658" data-problem-comparator="float" data-problem-type="input" data-solution="-2">
