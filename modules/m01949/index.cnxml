<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Understanding the Behaviors of a Graph in Relation to Its Quadratic Expression</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01949</md:content-id>
    <md:title>Understanding the Behaviors of a Graph in Relation to Its Quadratic Expression</md:title>
    <md:uuid>5aef2e7f-4b15-4504-b7e3-5af4bdca2c0b</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">      <title>Activity</title>
        <para id="para-00005">1. Use the table with different values of <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
            </m:mrow>
          </m:math> to answer questions a–g for the
          values of <m:math display="inline">
            <m:mrow>
              <m:msup>
                <m:mi>x</m:mi>
                <m:mn>2</m:mn>
              </m:msup>
              <m:mo>+</m:mo>
              <m:mn>10</m:mn>
            </m:mrow>
          </m:math>. (You may also use a
          spreadsheet tool, if available.)</para>
      <table class="unnumbered os-raise-horizontaltable" id="table-00001">
        <tgroup cols="8">
<tbody>
            <row>
              <entry><emphasis><m:math>
                    <m:mrow>
                      <m:mi>x</m:mi>
                    </m:mrow>
                  </m:math></emphasis>
              </entry>
              <entry> -3 </entry>
              <entry> -2 </entry>
              <entry> -1 </entry>
              <entry> 0 </entry>
              <entry> 1 </entry>
              <entry> 2 </entry>
              <entry> 3 </entry>
            </row>
            <row>
              <entry><emphasis><m:math>
                    <m:mrow>
                      <m:msup>
                        <m:mi>x</m:mi>
                        <m:mn>2</m:mn>
                      </m:msup>
                    </m:mrow>
                  </m:math></emphasis>
              </entry>
              <entry> 9 </entry>
              <entry> 4 </entry>
              <entry> 1 </entry>
              <entry> 0 </entry>
              <entry> 1 </entry>
              <entry> 4 </entry>
              <entry> 9 </entry>
            </row>
            <row>
              <entry><emphasis><m:math>
                    <m:mrow>
                      <m:msup>
                        <m:mi>x</m:mi>
                        <m:mn>2</m:mn>
                      </m:msup>
                      <m:mo>+</m:mo>
                      <m:mn>10</m:mn>
                    </m:mrow>
                  </m:math></emphasis>
              </entry>
              <entry> a. ____ </entry>
              <entry> b. ____ </entry>
              <entry> c. ____ </entry>
              <entry> d. ____ </entry>
              <entry> e. ____ </entry>
              <entry> f. ____ </entry>
              <entry> g. ____ </entry>
            </row>
          </tbody>
        </tgroup>
      </table>

        <exercise id="_56da4227-4773-4148-ad83-e42e2702a677" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00002">a. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>9</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                </m:mrow>
              </m:math>?</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00003"><m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>9</m:mn>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>19</m:mn>
                </m:mrow>
              </m:math></para>
           
          </solution>
        </exercise>

        <exercise id="da7dc977-a70d-460f-8c68-b85042fe7f9b" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00006">b. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>4</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                </m:mrow>
              </m:math>?</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00007"><m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>4</m:mn>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>14</m:mn>
                </m:mrow>
              </m:math></para>
         
          </solution>
        </exercise>

        <exercise id="_5ecbe22e-6069-44b9-aa7d-9ee9a27d0244" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00010">c. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>1</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>1</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                </m:mrow>
              </m:math>?</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00011"><m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>1</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>1</m:mn>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>11</m:mn>
                </m:mrow>
              </m:math></para>
         
          </solution>
        </exercise>

        <exercise id="e52fa14f-0bad-44e3-a59d-807f4583fc09" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00014">d. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>0</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>0</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                </m:mrow>
              </m:math>?</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00015"><m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mn>0</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>0</m:mn>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>10</m:mn>
                </m:mrow>
              </m:math></para>
          
          </solution>
        </exercise>

        <exercise id="b634d6bc-9e5d-48cc-920b-2d8885844aec" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00018">e. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>1</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>1</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                </m:mrow>
              </m:math>?</para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00019"><m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mn>1</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>1</m:mn>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>11</m:mn>
                </m:mrow>
              </m:math></para>
          
          </solution>
        </exercise>

        <exercise id="ee69e6ea-32ff-4701-9748-be0dd653d934" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00022">f. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>2</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>4</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                </m:mrow>
              </m:math>?</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00023"><m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mn>2</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>4</m:mn>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>14</m:mn>
                </m:mrow>
              </m:math></para>
          
          </solution>
        </exercise>

        <exercise id="b0b9ca01-0aaf-4afc-8fda-f32204c05a8d" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00026">g. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>9</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                </m:mrow>
              </m:math>?</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00027"><m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mn>3</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>9</m:mn>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>19</m:mn>
                </m:mrow>
              </m:math></para>
     
          </solution>
        </exercise>
     
        <para id="para-00009">2. Use the table with different values of <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
            </m:mrow>
          </m:math> to answer questions a–g for the
          values of <m:math display="inline">
            <m:mrow>
              <m:msup>
                <m:mi>x</m:mi>
                <m:mn>2</m:mn>
              </m:msup>
              <m:mo>−</m:mo>
              <m:mn>3</m:mn>
            </m:mrow>
          </m:math>. (You may also use a spreadsheet tool, if available.)</para>
      <table class="unnumbered os-raise-horizontaltable" id="table-00002">
        <tgroup cols="8">
<tbody>
            <row>
              <entry><emphasis><m:math>
                    <m:mrow>
                      <m:mi>x</m:mi>
                    </m:mrow>
                  </m:math></emphasis>
              </entry>
              <entry> -3 </entry>
              <entry> -2 </entry>
              <entry> -1 </entry>
              <entry> 0 </entry>
              <entry> 1 </entry>
              <entry> 2 </entry>
              <entry> 3 </entry>
            </row>
            <row>
              <entry><emphasis><m:math>
                    <m:mrow>
                      <m:msup>
                        <m:mi>x</m:mi>
                        <m:mn>2</m:mn>
                      </m:msup>
                    </m:mrow>
                  </m:math></emphasis>
              </entry>
              <entry> 9 </entry>
              <entry> 4 </entry>
              <entry> 1 </entry>
              <entry> 0 </entry>
              <entry> 1 </entry>
              <entry> 4 </entry>
              <entry> 9 </entry>
            </row>
            <row>
              <entry><emphasis><m:math>
                    <m:mrow>
                      <m:msup>
                        <m:mi>x</m:mi>
                        <m:mn>2</m:mn>
                      </m:msup>
                      <m:mo>−</m:mo>
                      <m:mn>3</m:mn>
                    </m:mrow>
                  </m:math></emphasis>
              </entry>
              <entry> a. ____ </entry>
              <entry> b. ____ </entry>
              <entry> c. ____ </entry>
              <entry> d. ____ </entry>
              <entry> e. ____ </entry>
              <entry> f. ____ </entry>
              <entry> g. ____ </entry>
            </row>
          </tbody>
        </tgroup>
      </table>

        <exercise id="_414a4c79-f8ca-4d84-bdb0-3799b2d22150" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00030">a. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>9</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:math>?</para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00031"><m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>9</m:mn>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>6</m:mn>
                </m:mrow>
              </m:math></para>
          
          </solution>
        </exercise>

        <exercise id="f903c1c9-b5cf-482c-a4ca-22c9fa11ad99" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00034">b. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>4</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:math>?</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00035"><m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>4</m:mn>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>1</m:mn>
                </m:mrow>
              </m:math></para>
        
          </solution>
        </exercise>

        <exercise id="_9da988cd-6c24-4c40-b6ec-1f4ee1a64054" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00038">c. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>1</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>1</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:math>?</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00039"><m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>1</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>1</m:mn>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                </m:mrow>
              </m:math></para>
        
          </solution>
        </exercise>

        <exercise id="e7496405-bc12-4bc9-adcf-b73b9aec4f83" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00042">d. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>0</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>0</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:math>?</para>
          </problem>
          <solution id="sol-00011">
            <para id="para-00043"><m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mn>0</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>0</m:mn>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:math></para>
        
          </solution>
        </exercise>

        <exercise id="a09868fb-17d3-46d0-b856-6287faee4786" class="multiple-choice">
          <problem id="prob-00012">
            <para id="para-00046">e. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>1</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>1</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:math>?</para>
          </problem>
          <solution id="sol-00012">
            <para id="para-00047"><m:math display="inline">
                <m:mrow>

                  <m:mo stretchy="false">(</m:mo>
                  <m:mn>1</m:mn><m:msup>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mn>2</m:mn></m:msup>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>1</m:mn>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:mn>2</m:mn>
                </m:mrow>
              </m:math></para>
       
          </solution>
        </exercise>

        <exercise id="_29189482-f312-4e41-9f3b-fbf3c52bb5ef" class="multiple-choice">
          <problem id="prob-00013">
            <para id="para-00050">f. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>2</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>4</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:math>?</para>
          </problem>
          <solution id="sol-00013">
            <para id="para-00051"><m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mn>2</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>4</m:mn>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>1</m:mn>
                </m:mrow>
              </m:math></para>
  
          </solution>
        </exercise>

        <exercise id="_36a5a0df-8eed-4890-974e-47533bc33e7c" class="multiple-choice">
          <problem id="prob-00014">
            <para id="para-00054">g. When <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                  <m:mo>=</m:mo>
                  <m:mn>3</m:mn>
                </m:mrow>
              </m:math> and <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>=</m:mo>
                  <m:mn>9</m:mn>
                </m:mrow>
              </m:math>, what is the value of <m:math display="inline">
                <m:mrow>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>+</m:mo>
                  <m:mn>10</m:mn>
                </m:mrow>
              </m:math>?</para>
          </problem>
          <solution id="sol-00014">
            <para id="para-00055"><m:math display="inline">
                <m:mrow>
                  <m:mo stretchy="false">(</m:mo>
                  <m:mn>3</m:mn>
                  <m:msup>
                    <m:mo stretchy="false">)</m:mo>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>9</m:mn>
                  <m:mo>−</m:mo>
                  <m:mn>3</m:mn>
                  <m:mo>=</m:mo>
                  <m:mn>6</m:mn>
                </m:mrow>
              </m:math></para>
     
          </solution>
        </exercise>
      <exercise id="exer-00001">
