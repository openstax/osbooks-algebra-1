              <entry> -2 </entry>
              <entry> -1 </entry>
              <entry> 0 </entry>
              <entry> 1 </entry>
              <entry> 2 </entry>
              <entry> 3 </entry>
            </row>
            <row>
              <entry><emphasis><m:math>
                    <m:mrow>
                      <m:msup>
                        <m:mi>x</m:mi>
                        <m:mn>2</m:mn>
                      </m:msup>
                    </m:mrow>
                  </m:math></emphasis>
              </entry>
              <entry> 9 </entry>
              <entry> 4 </entry>
              <entry> 1 </entry>
              <entry> 0 </entry>
              <entry> 1 </entry>
              <entry> 4 </entry>
              <entry> 9 </entry>
            </row>
            <row>
              <entry><emphasis><m:math>
                    <m:mrow>
                      <m:mo>−</m:mo>
                      <m:mn>2</m:mn>
