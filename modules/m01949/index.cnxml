<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="e61cfef3-73d7-4929-9705-bfefb0eec391" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1a-->
  <exercise data-content-id="12964d60-9f81-4912-977d-ded91307039c" data-problem-comparator="float" data-problem-type="input" data-solution="4.5">
    <problem>
      <para> When \(x=-3\) and \(x^2=9\), what is value of \(\frac{1}{2}x^2\)? </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(\frac{1}{2}(-3)^2=\frac{1}{2} \cdot 9=\frac{9}{2}=4\frac{1}{2}=4.5\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1b-->
  <exercise data-content-id="e3e9bc8c-3d92-4254-833a-c959d25c753d" data-problem-comparator="float" data-problem-type="input" data-solution="2">
    <problem>
      <para> When \(x=-2\) and \(x^2=4\), what is value of \(\frac{1}{2}x^2\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(\frac{1}{2}(-2)^2=\frac{1}{2} \cdot 4=\frac{4}{2}=2\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1c-->
  <exercise data-content-id="aebd7c88-b1e9-429d-8c26-0be943403732" data-problem-comparator="float" data-problem-type="input" data-solution="0.5">
    <problem>
      <para> When \(x=-1\) and \(x^2=1\), what is value of \(\frac{1}{2}x^2\)? </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(\frac{1}{2}(-1)^2=\frac{1}{2} \cdot 1=\frac{1}{2}=0.5\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1d-->
  <exercise data-content-id="19f7e9d6-11eb-42e9-8bc4-663b58043a4b" data-problem-comparator="float" data-problem-type="input" data-solution="0">
    <problem>
      <para> When \(x=0\) and \(x^2=0\), what is value of \(\frac{1}{2}x^2\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(\frac{1}{2}(0)^2=\frac{1}{2} \cdot 0=0\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1e-->
  <exercise data-content-id="34793db7-7916-4c17-8e7d-5c350ef56e33" data-problem-comparator="float" data-problem-type="input" data-solution="0.5">
    <problem>
      <para> When \(x=1\) and \(x^2=1\), what is value of \(\frac{1}{2}x^2\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(\frac{1}{2}(1)^2=\frac{1}{2} \cdot 1=\frac{1}{2}=0.5\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1f-->
  <exercise data-content-id="a9602fee-e393-45f9-b26b-51f46f3fdc41" data-problem-comparator="float" data-problem-type="input" data-solution="2">
    <problem>
      <para> When \(x=2\) and \(x^2=4\), what is value of \(\frac{1}{2}x^2\)? </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(\frac{1}{2}(2)2=\frac{1}{2} \cdot 4=\frac{4}{2}=2\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1g-->
  <exercise data-content-id="a99a5c26-6a0d-4e72-82ed-ec405c1f1e47" data-problem-comparator="float" data-problem-type="input" data-solution="4.5">
    <problem>
      <para> When \(x=3\) and \(x^2=9\), what is value of \(\frac{1}{2}x^2\)? </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(\frac{1}{2}(3)^2=\frac{1}{2} \cdot 9=\frac{9}{2}=4\frac{1}{2}=4.5\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
