<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="847e7f11-312b-4f7e-ad9c-83f1fd55b405" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1a-->
  <exercise data-content-id="414a4c79-f8ca-4d84-bdb0-3799b2d22150" data-problem-comparator="float" data-problem-type="input" data-solution="6">
    <problem>
      <para> When \(x=-3\) and \(x^2=9\), what is value of \(x^2-3\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \((-3)^2-3=9-3=6\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1b-->
  <exercise data-content-id="f903c1c9-b5cf-482c-a4ca-22c9fa11ad99" data-problem-comparator="float" data-problem-type="input" data-solution="1">
    <problem>
      <para> When \(x=-2\) and \(x^2=4\), what is value of \(x^2-3\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \((-2)^2-3=4-3=1\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1c-->
  <exercise data-content-id="9da988cd-6c24-4c40-b6ec-1f4ee1a64054" data-problem-comparator="float" data-problem-type="input" data-solution="-2">
    <problem>
      <para> When \(x=-1\) and \(x^2=1\), what is value of \(x^2-3\)? </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \((-1)^2-3=1-3=-2\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1d-->
  <exercise data-content-id="e7496405-bc12-4bc9-adcf-b73b9aec4f83" data-problem-comparator="float" data-problem-type="input" data-solution="-3">
    <problem>
      <para> When \(x=0\) and \(x^2=0\), what is value of \(x^2-3\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \((0)^2-3=0-3=-3\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1e-->
  <exercise data-content-id="a09868fb-17d3-46d0-b856-6287faee4786" data-problem-comparator="float" data-problem-type="input" data-solution="-2">
    <problem>
      <para> When \(x=1\) and \(x^2=1\), what is value of \(x^2-3\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \(-2. (1)2-3=1-3=-2\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1f-->
  <exercise data-content-id="29189482-f312-4e41-9f3b-fbf3c52bb5ef" data-problem-comparator="float" data-problem-type="input" data-solution="1">
    <problem>
      <para> When \(x=2\) and \(x^2=4\), what is value of \(x^2-3\)? </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \((2)^2-3=4-3=1\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1g-->
  <exercise data-content-id="36a5a0df-8eed-4890-974e-47533bc33e7c" data-problem-comparator="float" data-problem-type="input" data-solution="6">
    <problem>
      <para> When \(x=3\) and \(x^2=9\), what is value of \(x^2+10\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \((3)^2-3=9-3=6\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
