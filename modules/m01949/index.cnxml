        <entry> -1 </entry>
        <entry> 0 </entry>
        <entry> 1 </entry>
        <entry> 2 </entry>
        <entry> 3 </entry>
      </row>
      <row>
        <entry><emphasis>\(x^2\)</emphasis> </entry><entry> 9 </entry>
        <entry> 4 </entry>
        <entry> 1 </entry>
        <entry> 0 </entry>
        <entry> 1 </entry>
        <entry> 4 </entry>
        <entry> 9 </entry>
      </row>
      <row>
        <entry><emphasis>\(2x^2\)</emphasis> </entry><entry> 18 </entry>
        <entry> 8 </entry>
