<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="29c25dcc-9614-4366-931b-cff6cecf2623" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q1a-->
  <exercise data-content-id="56da4227-4773-4148-ad83-e42e2702a677" data-problem-comparator="float" data-problem-type="input" data-solution="19">
    <problem>
      <para> When \(x=-3\) and \(x^2=9\), what is value of \(x^2+10\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \((-3)^2+10=9+10=19\)</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Q1b-->
  <exercise data-content-id="da7dc977-a70d-460f-8c68-b85042fe7f9b" data-problem-comparator="float" data-problem-type="input" data-solution="14">
    <problem>
      <para> When \(x=-2\) and \(x^2=4\), what is value of \(x^2+10\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \((-2)^2+10=4+10=14\)</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Q1c-->
  <exercise data-content-id="5ecbe22e-6069-44b9-aa7d-9ee9a27d0244" data-problem-comparator="float" data-problem-type="input" data-solution="11">
    <problem>
      <para> When \(x=-1\) and \(x^2=1\), what is value of \(x^2+10\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \((-1)^2+10=1+10=11\)</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Q1d-->
  <exercise data-content-id="e52fa14f-0bad-44e3-a59d-807f4583fc09" data-problem-comparator="float" data-problem-type="input" data-solution="10">
    <problem>
      <para> When \(x=0\) and \(x^2=0\), what is value of \(x^2+10\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \((0)^2+10=0+10=10\)</para>
    </solution>
        </exercise>
  <!--END QUESTION.-->
  <!--Q1e-->
  <exercise data-content-id="b634d6bc-9e5d-48cc-920b-2d8885844aec" data-problem-comparator="float" data-problem-type="input" data-solution="11">
    <problem>
      <para> When \(x=1\) and \(x^2=1\), what is value of \(x^2+10\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \((1)^2+10=1+10=11\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1f-->
  <exercise data-content-id="ee69e6ea-32ff-4701-9748-be0dd653d934" data-problem-comparator="float" data-problem-type="input" data-solution="14">
    <problem>
      <para> When \(x=2\) and \(x^2=4\), what is value of \(x^2+10\)? </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \((2)^2+10=4+10=14\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q1g-->
  <exercise data-content-id="b0b9ca01-0aaf-4afc-8fda-f32204c05a8d" data-problem-comparator="float" data-problem-type="input" data-solution="19">
    <problem>
      <para> When \(x=3\) and \(x^2=9\), what is value of \(x^2+10\)?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! \((3)^2+10=9+10=19\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
