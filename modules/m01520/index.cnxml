  <problem>
    <para>Summarize the process you used in questions 1 - 6 to analyze this data.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>Answers will vary.</para>
  </solution></exercise>
<!--Interaction End -->


