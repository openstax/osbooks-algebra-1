  <!--6c-->
  <exercise data-content-id="8afd5728-f7a1-47bf-a766-99de49fec590" data-problem-comparator="integer" data-problem-type="input" data-solution="-18">
    <problem>
      <para>What is the value of the missing number, including the sign, in place of letter c?</para>
