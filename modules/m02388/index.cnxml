<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.4.2: Rewrite Squared Expressions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02388</md:content-id>
    <md:title>9.4.2: Rewrite Squared Expressions</md:title>
    <md:uuid>dfce6d45-0123-4c84-83e2-f60cf738d1e2</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Activity</title>
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00001">Write each expression in standard form:</para>
          <para id="para-00002"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00003">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00004">Compare your answer:</para>
          <para id="para-00005"><m:math><m:mrow><m:mn>16</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00006"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00007">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00008">Compare your answer:</para>
          <para id="para-00009"><m:math><m:mrow><m:mn>25</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>20</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00011">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00012">Compare your answer:</para>
          <para id="para-00013"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>49</m:mn></m:mrow></m:math></para></solution>
      </exercise>
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00014"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>n</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00015">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00016">Compare your answer:</para>
          <para id="para-00017"><m:math display="inline"><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>n</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
        </solution>
      </exercise>
      <exercise id="exer-00005">
        <problem id="prob-00005">
          <para id="para-00018"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>k</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>m</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00019">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00020">Compare your answer:</para>
          <para id="para-00021"><m:math><m:mrow><m:msup><m:mi>k</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>k</m:mi><m:mi>m</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para></solution>
      </exercise>
      <exercise id="exer-00006">
        <problem id="prob-00006">
          <para id="para-00022">Decide if each expression is a perfect square. If so, write an equivalent expression of the form <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>k</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>m</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>. If not, suggest one change to turn it into a perfect square.</para>
          <para id="para-00023"><m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math></para><para id="para-00024">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00025">Compare your answer:</para>
          <para id="para-00026">Yes, a perfect square. <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
        </solution>
      </exercise>
      <exercise id="exer-00007">
        <problem id="prob-00007">
          <para id="para-00027"><m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>25</m:mn></m:mrow></m:math></para><para id="para-00028">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00029">Compare your answer:</para>
          <para id="para-00030">No, not a perfect square. Suggested changes include:</para>
          <list id="list-00001">
            <item>Changing the coefficient of the linear term to 20 gives <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>20</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>25</m:mn></m:mrow></m:math>, which is equivalent to <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</item>
            <item>Changing the coefficient of the linear term to -20 gives <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>20</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>25</m:mn></m:mrow></m:math>, which is equivalent to <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</item>
            <item>Changing the constant term to 4 gives <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math>, which is equivalent to <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</item>
          </list>
        </solution>
      </exercise>
      <section id="sect-00002">
        <title>Video: Rewrite Squared Expressions</title>
        <para id="para-00031">Watch the following video to learn more about rewriting squared expressions.</para>
        <media alt="Placeholder for Alt Text">
          <iframe width="660" height="371.4" src="https://k12.openstax.org/contents/raise/resources/72e5797ce35541d183e0ff3955751a0ef621703e"/>
        </media>
      </section>
    </section>
    <note class="self-check" id="note-00001">
      <para id="para-00032">Find the equivalent factored expression for <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math>.</para>
    </note>
    <section id="sect-00003">
      <title>Factoring Perfect Square Trinomials</title>
      <para id="para-00033">To factor <term class="glossary-tooltip" id="term-00001">perfect square trinomial</term>s, follow the formulas:</para>
      <para id="para-00034"><m:math><m:mrow><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>a</m:mi><m:mi>b</m:mi><m:mo>+</m:mo><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo>+</m:mo><m:mi>b</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00035"><m:math><m:mrow><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>a</m:mi><m:mi>b</m:mi><m:mo>+</m:mo><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo>−</m:mo><m:mi>b</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para><para id="para-00036">Let's look at an example of how to factor perfect square trinomials.</para>
      <para id="para-00037"><emphasis>Example</emphasis></para>
      <para id="para-00038">Factor <m:math display="inline"><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math>.</para>
      <para id="para-00039"><emphasis>Step 1</emphasis> - Does the trinomial fit the perfect square trinomial pattern, <m:math display="inline"><m:mrow><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>a</m:mi><m:mi>b</m:mi><m:mo>+</m:mo><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>? If so, write the first term as <m:math display="inline"><m:mrow><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> and last constant as <m:math display="inline"><m:mrow><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para>
      <list id="list-00002">
        <item>Is the first term a perfect square? Write it as a square, <m:math display="inline"><m:mrow><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>. Is <m:math display="inline"><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> a perfect square? Yes — write it as <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>. <m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>12</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mspace width="0.278em"/></m:mtd></m:mtr></m:mtable></m:mrow></m:math></item>
      </list>
      <list id="list-00003">
        <item>Is the last term a perfect square? Write it as a square, <m:math display="inline"><m:mrow><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>. Is 4 a perfect square? Yes — write it as <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>. <m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>12</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mtd></m:mtr></m:mtable></m:mrow></m:math></item>
      </list>
      <list id="list-00004">
        <item>Check the middle term. Is it <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>a</m:mi><m:mi>b</m:mi></m:mrow></m:math>? Is <m:math display="inline"><m:mrow><m:mn>12</m:mn><m:mi>x</m:mi></m:mrow></m:math> twice the product of <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math> and 2? Does it match? Yes, so we have a perfect trinomial.</item>
      </list>
      <para id="para-00040"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="center"><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mn>12</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mn>4</m:mn><m:mspace width="0.278em"/></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mrow><m:mo style="color:green">↘</m:mo></m:mrow><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mrow><m:mo style="color:green">↙</m:mo></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mn>12</m:mn><m:mi>x</m:mi><m:mspace width="0.278em"/></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00041"><emphasis>Step 2</emphasis> - Factor the binomial into: <m:math display="inline"><m:mrow><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>a</m:mi><m:mi>b</m:mi><m:mo>+</m:mo><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo>+</m:mo><m:mi>b</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>. </para><para><m:math display="inline"><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math> </para><para><m:math display="inline"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>·</m:mi><m:mi>a</m:mi><m:mi>·</m:mi><m:mi>b</m:mi><m:mo>+</m:mo><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mo stretchy="false">(</m:mo><m:mrow><m:mn style="color:red">3</m:mn></m:mrow><m:mrow><m:mi style="color:red">x</m:mi></m:mrow><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mspace width="0.278em"/><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>·</m:mi><m:mrow><m:mn style="color:red">3</m:mn></m:mrow><m:mrow><m:mi style="color:red">x</m:mi></m:mrow><m:mi>·</m:mi><m:mrow><m:mn style="color:purple">2</m:mn></m:mrow><m:mo>+</m:mo><m:msup><m:mrow><m:mn style="color:purple">2</m:mn></m:mrow><m:mn>2</m:mn></m:msup><m:mspace width="0.278em"/></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo>+</m:mo><m:mi>b</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mspace width="0.278em"/></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mspace width="0.278em"/><m:mo stretchy="false">(</m:mo><m:mrow><m:mn style="color:red">3</m:mn></m:mrow><m:mrow><m:mi style="color:red">x</m:mi></m:mrow><m:mo>+</m:mo><m:mrow><m:mn style="color:green">2</m:mn></m:mrow><m:msup><m:mo stretchy="false">)</m:mo><m:mrow><m:mn style="color:green">2</m:mn></m:mrow></m:msup></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para>
      <para id="para-00042"><emphasis>Step 3</emphasis> - Check. </para><para><m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math> </para><para><m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>3</m:mn><m:mi>x</m:mi><m:mi>·</m:mi><m:mn>2</m:mn><m:mo>+</m:mo><m:msup><m:mn>2</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math> </para><para><m:math display="inline"><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>✔</m:mi></m:mrow></m:math></para>
      <note class="try" id="note-00002">
        <title>Try It: Factoring Perfect Square Trinomials</title>
          <exercise id="exer-00008">
          <problem id="prob-00008">
            <para id="para-00043">Factor <m:math display="inline"><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>30</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>25</m:mn></m:mrow></m:math>.</para>
            <para id="para-00044">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00045">Here is how to factor a perfect square trinomial:</para>
            <para id="para-00046"><emphasis>Step 1</emphasis> - Write the first term as <m:math display="inline"><m:mrow><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> and the last constant as <m:math display="inline"><m:mrow><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>. </para><para><m:math display="inline"><m:mrow><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:msup><m:mn>5</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
            <para id="para-00047">Make sure the middle term is <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>a</m:mi><m:mi>b</m:mi></m:mrow></m:math>. <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>a</m:mi><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>30</m:mn><m:mi>x</m:mi></m:mrow></m:math></para>
            <para id="para-00048"><emphasis>Step 2</emphasis> - Factor the binomial into: <m:math display="inline"><m:mrow><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>a</m:mi><m:mi>b</m:mi><m:mo>+</m:mo><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo>−</m:mo><m:mi>b</m:mi><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>. </para><para><m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
            <para id="para-00049"><emphasis>Step 3</emphasis> - Check.</para>
            <para id="para-00050"><m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para id="para-00051"><m:math display="inline"><m:mrow><m:mo>=</m:mo><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>15</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>15</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>25</m:mn></m:mrow></m:math></para><para id="para-00052"><m:math display="inline"><m:mrow><m:mo>=</m:mo><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>30</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>25</m:mn></m:mrow></m:math></para></solution>
        </exercise>
      </note>
    </section>
  </content>
</document>