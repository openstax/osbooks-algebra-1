  <content>
  <section>
    <section class="check-understanding">
      <exercise data-content-id="315fcda6-6840-450e-b38b-54a5191793d4">
        <problem>
          <para>
      <para>A new bicycle sells for $300. It is on sale for \(\frac14\) off the regular price. <emphasis>Select three</emphasis>
          expressions that represent the sale price of the bicycle in dollars.</para>
      </para>
        </problem>
        <solution>
          <para>["\\(300 \\cdot \\frac34\\)", "\\(300 \\cdot (1-\\frac{1}{4})\\)", "\\(300-\\frac{1}{4} \\cdot 300\\)" ]</para>
          <para>
      <para dir="ltr" id="docs-internal-guid-93d08b40-7fff-e883-6f03-7c9557797c1a">The correct answers are \(300 \cdot
        \frac34\), \(300 \cdot (1-\frac{1}{4})\), and \(300-\frac{1}{4} \cdot 300\). </para>
    </para>
        </solution>
      </exercise>
    </section>
  </section>
</content>
