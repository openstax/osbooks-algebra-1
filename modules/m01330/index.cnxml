<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.5.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01330</md:content-id>
    <md:title>5.5.6: Practice</md:title>
    <md:uuid>230f0108-deed-4b84-899e-0d5eaffb0ab0</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <section id="sect-00002">
        <exercise id="_315fcda6-6840-450e-b38b-54a5191793d4" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00001">A new bicycle sells for $300. It is on sale for <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> off the regular price.<emphasis>Select three</emphasis>
          expressions that represent the sale price of the bicycle in dollars.</para>
          </problem>
          <solution id="sol-00001">
            
            <para id="para-00002">Try again. Revisit activity 5.5.2.</para>
            <para id="para-00003">The correct answers are <m:math display="inline"><m:mrow><m:mn>300</m:mn><m:mi>·</m:mi><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mn>300</m:mn><m:mi>·</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo stretchy="false">)</m:mo></m:mrow></m:math>, and <m:math display="inline"><m:mrow><m:mn>300</m:mn><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mi>·</m:mi><m:mn>300</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="a2643161-4674-476c-9af6-f3c3460683d3" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00004">Answer the following questions that would complete the table to show the value of the computer at the listed times.</para>
            <para id="para-00005">A computer costs $800. It loses <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> of its value every year after it is purchased.</para>
            <table class="os-raise-wideequaltable" id="table-00001">
              <tgroup cols="2"><tbody><row>
                  <entry>
                   <emphasis>Time (Years)</emphasis>
                  </entry>
                  <entry>
                   <emphasis>Value of Computer (Dollars)</emphasis>
                  </entry>
                </row>
              <row>
                  <entry>
              0
            </entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry>
              1
            </entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry>
              2
            </entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry>
              3
            </entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry>
              <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math>
            </entry>
                  <entry> </entry>
                </row>
              </tbody></tgroup></table>
            <para id="para-00006">
          The value of the computer, in dollars, when it is purchased.</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00007">Correct! 800</para>
            <para id="para-00008">Try again. Revisit activities 5.5.1 - 5.5.2.</para>
            <para id="para-00009">The correct answer is 800.</para>
          </solution>
        </exercise>
        <exercise id="_13f87be0-8a80-417a-9f62-110463a8b249" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00010">The value of the computer, in dollars, after 1 year.</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00011">Correct! 600.</para>
            <para id="para-00012">Try again. Revisit activities 5.5.1 - 5.5.2.</para>
            <para id="para-00013">The correct answer is 600.
    </para>
          </solution>
        </exercise>
        <exercise id="c445b5b4-32a6-42c8-9bad-d67e1e2d023a" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00014">The value of the computer, in dollars, after 2 years.</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00015">Correct! 450.</para>
            <para id="para-00016">Try again. Revisit activities 5.5.1 - 5.5.2.</para>
            <para id="para-00017">The correct answer is 450.
    </para>
          </solution>
        </exercise>
        <exercise id="_58ae276d-f55b-4e60-81ba-accf3ce2b944" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00018">A computer costs $800. It loses <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> of its value every year after it is purchased. Which of the
          following expressions would represent the value of the computer, in dollars, after <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> years?   
         </para>
            <para id="para-00019">Multiple Choice:</para>
            <para id="para-00020"><m:math><m:mrow><m:mn>800</m:mn><m:mi>·</m:mi><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mi>·</m:mi><m:mi>t</m:mi></m:mrow></m:math></para>
            <para id="para-00021"><m:math><m:mrow><m:mn>800</m:mn><m:mi>·</m:mi><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mi>·</m:mi><m:mi>t</m:mi></m:mrow></m:math></para>
            <para id="para-00022"><m:math><m:mrow><m:mn>800</m:mn><m:mi>·</m:mi><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mi>t</m:mi></m:msup></m:mrow></m:math></para>
            <para id="para-00023"><m:math><m:mrow><m:mn>800</m:mn><m:mi>·</m:mi><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mi>t</m:mi></m:msup></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00024">Correct! <m:math display="inline"><m:mrow><m:mn>800</m:mn><m:mi>·</m:mi><m:msup><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mi>t</m:mi></m:msup></m:mrow></m:math></para>
            <para id="para-00025">Try again. Revisit activities 5.5.1 -5.5.2.</para>
            <para id="para-00026">The correct answer is <m:math display="inline"><m:mrow><m:mn>800</m:mn><m:mi>·</m:mi><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mi>t</m:mi></m:msup></m:mrow></m:math>.
    </para>
          </solution>
        </exercise>
        <exercise id="_1094ca3f-7329-4662-8499-099b5c4151a2" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00027">Use your equation from question 3 to find <m:math display="inline"><m:mrow><m:mi>v</m:mi></m:mrow></m:math> when <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> is 5. What does this value of <m:math display="inline"><m:mrow><m:mi>v</m:mi></m:mrow></m:math> mean?</para>
            <para id="para-00028">Multiple Choice:</para>
            <para id="para-00029">189.84; After 5 years, the computer’s value is $189.84.</para>
            <para id="para-00030">142.38; After 5 years, the computer’s value is $142.38.</para>
            <para id="para-00031">3,000; After 5 years, the computer’s value is $3,000.</para>
            <para id="para-00032">253.13; After 5 years, the computer’s value is $253.13.</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00033">Correct! 189.84, After 5 years the computer’s value is $189.84.
    </para>
            <para id="para-00034">Try again. Revisit activity 5.5.5.</para>
            <para id="para-00035">The correct answer is a. 189.84, After 5 years the computer’s value is $189.84.</para>
          </solution>
        </exercise>
        <exercise id="d80f8315-e291-4120-a412-6bfeaa6dca0e" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00036">A piece of paper is folded into thirds multiple times. The area, <m:math display="inline"><m:mrow><m:mi>A</m:mi></m:mrow></m:math>, of the piece of paper in square
          inches, after <m:math display="inline"><m:mrow><m:mi>n</m:mi></m:mrow></m:math> folds, is <m:math display="inline"><m:mrow><m:mi>A</m:mi><m:mo>=</m:mo><m:mn>90</m:mn><m:mi>·</m:mi><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mi>n</m:mi></m:msup></m:mrow></m:math>.        </para>

          <para id="para-00037">
              What is the value of <m:math display="inline"><m:mrow><m:mi>A</m:mi></m:mrow></m:math> when <m:math display="inline"><m:mrow><m:mi>n</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math>?</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00038">Correct! 90. That is the area of the paper in square inches before it is folded.
    </para>
            <para id="para-00039">Try again. Revisit activity 5.5.5.</para>
            <para id="para-00040">The correct answer is 90. That is the area of the paper in square inches before it is folded.</para>
          </solution>
        </exercise>
        <exercise id="_81b511ca-5f03-4c52-8065-2b024384738b" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00041">
            How many folds are needed before the area is less than 1 square inch?</para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00042">Correct! 5.</para>
            <para id="para-00043">Try again. Revisit activity 5.5.2.</para>
            <para id="para-00044">The correct answer is 5.
    </para>
          </solution>
        </exercise>
        <exercise id="_32c9b4e3-f7b5-4014-9bed-935b8993e174" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00045">The area of another piece of paper in square inches, after <m:math display="inline"><m:mrow><m:mi>n</m:mi></m:mrow></m:math> folds, is given by <m:math display="inline"><m:mrow><m:mi>A</m:mi><m:mo>=</m:mo><m:mn>100</m:mn><m:mi>·</m:mi><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mi>n</m:mi></m:msup></m:mrow></m:math>. What does the number 100 mean in this situation?</para>
            <para id="para-00046">Multiple Choice:</para>
            <para id="para-00047">The area after the paper is folded</para>
            <para id="para-00048">The area before the paper is folded</para>
            <para id="para-00049">The number of folds to have an area of 0</para>
            <para id="para-00050">The growth factor of the situation</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00051">Correct! The area before the paper is folded. The a value in y=abx is always the initial value</para>
            <para id="para-00052">Try again. Revisit activity 5.5.5.</para>
            <para id="para-00053">The correct answer is: The area before the paper is folded.</para>
          </solution>
        </exercise>
        <exercise id="_23d280d7-65f6-4046-9238-bb6ca7d2d349" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00054">The area of another piece of paper in square inches, after <m:math display="inline"><m:mrow><m:mi>n</m:mi></m:mrow></m:math> folds, is given by <m:math display="inline"><m:mrow><m:mi>A</m:mi><m:mo>=</m:mo><m:mn>100</m:mn><m:mi>·</m:mi><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mi>n</m:mi></m:msup></m:mrow></m:math>. What does the number <m:math display="inline"><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math> mean in this situation?
      </para>
            <para id="para-00055">Multiple Choice:</para>
            <para id="para-00056">The area of the paper before it is folded</para>
            <para id="para-00057">The area of the paper after 1 fold</para>
            <para id="para-00058">The growth factor of the situation</para>
            <para id="para-00059">The initial value of the situation</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00060">Correct! The growth factor of the situation.</para>
            <para id="para-00061">Try again. Revisit activity 5.5.5.</para>
            <para id="para-00062">The correct answer is: The growth factor of the situation.</para>
          </solution>
        </exercise>
        <exercise id="d2d1c923-8e73-4821-9a49-dff891107b2a" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00063">Lin has 13 mystery novels. Each month, she gets 2 more.<emphasis>Select three</emphasis> expressions that represent the total number of mystery novels Lin has after 3 months.</para>
          </problem>
          <solution id="sol-00011">
            <para id="para-00064">Correct! 13 + 2 + 2+ 2, 13 + 6, 19.</para>
            <para id="para-00065">Try again. Revisit activity 5.5.1.</para>
            <para id="para-00066">The correct answers are 13 + 2 + 2+ 2, 13 + 6, 19.
    </para>
          </solution>
        </exercise>
        <exercise id="_288b6740-1876-48df-8dca-a56367467de6" class="multiple-choice">
          <problem id="prob-00012">
            <para id="para-00067">The graph shows the amount of a chemical in a water sample. It is decreasing exponentially.
</para>

          <para id="para-00068">(<media alt="Graph of a function on grid, origin O. Horizontal axis, time, hours, from 0 to 8 by 1's. Vertical axis, chemical, milligrams, from 0 to 1,200 by 200's. Plotted coordinates as follows: 0 comma 1,000, 1 comma 800. The next three points labeled A, B and C, with 4 more points plotted."><image mime-type="image/svg+xml" src="../../media/Algebra-1_05_07_13_01.svg"/></media>)
      </para>
            <para id="para-00069">
            What are the coordinates of point <m:math display="inline"><m:mrow><m:mi>A</m:mi></m:mrow></m:math>?
        </para>
            <para id="para-00070">Multiple Choice:</para>
            <para id="para-00071"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>1000</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00072"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>640</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00073"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac><m:mo>,</m:mo><m:mn>1000</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00074"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>640</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00012">
            <para id="para-00075">Correct! (2, 640).</para>
            <para id="para-00076">Try again. Revisit activity 5.5.3.
    </para>
            <para id="para-00077">The correct answer is (2, 640).
    </para>
          </solution>
        </exercise>
        <exercise id="_3f0a3962-d731-4dc9-baa0-de9dd06f1046" class="multiple-choice">
          <problem id="prob-00013">
            <para id="para-00078">What are the coordinates of point <m:math display="inline"><m:mrow><m:mi>B</m:mi></m:mrow></m:math>?</para>
            <para id="para-00079">Multiple Choice:</para>
            <para id="para-00080"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>640</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00081"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>512</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00082"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>410</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00083"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac><m:mo>,</m:mo><m:mn>512</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00013">
            <para id="para-00084">Correct! (3, 512).</para>
            <para id="para-00085">Try again. Revisit activity 5.5.3.</para>
            <para id="para-00086">The correct answer is (3, 512).</para>
          </solution>
        </exercise>
        <exercise id="da68b5f8-880b-4df0-b8f6-95983e982cfb" class="multiple-choice">
          <problem id="prob-00014">
            <para id="para-00087">Which of the following equations would represent the chemical, <m:math display="inline"><m:mrow><m:mi>C</m:mi></m:mrow></m:math>, after time, <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math>, from the graph?
        </para>
            <para id="para-00088">Multiple Choice:</para>
            <para id="para-00089"><m:math><m:mrow><m:mi>C</m:mi><m:mo>=</m:mo><m:mn>1000</m:mn><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac><m:mi>x</m:mi></m:mrow></m:math></para>
            <para id="para-00090"><m:math><m:mrow><m:mi>C</m:mi><m:mo>=</m:mo><m:mn>1000</m:mn><m:mi>·</m:mi><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac><m:mi>·</m:mi><m:mi>x</m:mi></m:mrow></m:math></para>
            <para id="para-00091"><m:math><m:mrow><m:mi>C</m:mi><m:mo>=</m:mo><m:mn>1000</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mi>x</m:mi></m:msup></m:mrow></m:math></para>
            <para id="para-00092"><m:math><m:mrow><m:mi>C</m:mi><m:mo>=</m:mo><m:mn>1000</m:mn><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mi>x</m:mi></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00014">
            <para id="para-00093">Correct! <m:math display="inline"><m:mrow><m:mi>C</m:mi><m:mo>=</m:mo><m:mn>1000</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mi>x</m:mi></m:msup></m:mrow></m:math>.</para>
            <para id="para-00094">Try again. Revisit activity 5.5.3.</para>
            <para id="para-00095">The correct answer is <m:math display="inline"><m:mrow><m:mi>C</m:mi><m:mo>=</m:mo><m:mn>1000</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mi>x</m:mi></m:msup></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_9dd82cf6-bff3-43c6-8b0a-5b572baf32ba" class="multiple-choice">
          <problem id="prob-00015">
            <para id="para-00096">The graph shows the amount of a chemical in a water sample at different times after it was first measured.
         <emphasis>Select two</emphasis> statements that are true.      </para>

          <para id="para-00097">(<media alt="Graph of a function on grid, origin O. Horizontal axis, time, hours, from 0 to 6 by 0 point 5's. Vertical axis, chemical, milligrams, from 0 to 2,400 by 400's. Plotted coordinates as follows: 0 comma 2,000, 1 comma 1,000, 2 comma 500, 3 comma 250, 4 comma 125."><image mime-type="image/svg+xml" src="../../media/Algebra-1_05_07_13_02.svg"/></media>)</para>

          </problem>
          <solution id="sol-00015">
            
            <para id="para-00098">Try again. Revisit activity 5.5.3.</para>
            <para id="para-00099">The correct answers are a and d.
    </para>
          </solution>
        </exercise>
        <exercise id="_553cc311-8ae5-4f89-8b67-f436cc999aa8" class="multiple-choice">
          <problem id="prob-00016">
            <para id="para-00100">The height of a plant in mm is 7. It doubles each week.<emphasis>Select two</emphasis> expressions that
          represent the height of the plant, in mm, after 4 weeks.
      </para>
          </problem>
          <solution id="sol-00016">
            <para id="para-00101">Correct! <m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mn>4</m:mn></m:msup></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn></m:mrow></m:math>.</para>
            <para id="para-00102">Try again. Revisit activity 5.5.1.</para>
            <para id="para-00103">The correct answers are <m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mn>4</m:mn></m:msup></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>7</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn></m:mrow></m:math>.
    </para>
          </solution>
        </exercise>
      </section>
    </section>
  </content>
</document>
