<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.8.4: Determining if an Expression Can Be Rewritten in Factored Form</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02220</md:content-id>
    <md:title>8.8.4: Determining if an Expression Can Be Rewritten in Factored Form</md:title>
    <md:uuid>d70da1a8-cd5c-4ffc-a1fd-c3dd97415d73</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Cool Down Activity</title>
      <para id="para-00001">Write each expression in factored form. If it is not possible, write "not possible."</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002">\(a^2− 36\)</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Enter the factored form of the expression, if possible.</para>
          <para id="para-00004">Compare your answer:</para>
          <para id="para-00005">\((a + 6)(a − 6)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00006">\(49 − 25b^2\)</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00007">Enter the factored form of the expression, if possible.</para>
          <para id="para-00008">Compare your answer:</para>
          <para id="para-00009"> \((7 + 5b)(7 − 5b)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010">\(c^2+ 9\)</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00011">Enter the factored form of the expression, if possible.</para>
          <para id="para-00012">Compare your answer:</para>
          <para id="para-00013"> Not possible because this is the sum of two squares.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00014">\(\frac {100}{81}-16d^2\)</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00015">Enter the factored form of the expression, if possible.</para>
          <para id="para-00016">Compare your answer:</para>
          <para id="para-00017"> \((\frac {10}{9} + 4d)(\frac {10}{9} − 4d)\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>