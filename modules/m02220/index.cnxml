<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.8.4: Determining if an Expression Can Be Rewritten in Factored Form</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02220</md:content-id>
    <md:title>8.8.4: Determining if an Expression Can Be Rewritten in Factored Form</md:title>
    <md:uuid>d70da1a8-cd5c-4ffc-a1fd-c3dd97415d73</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001"><title>Cool Down</title>
      <para id="para-00001">Write each expression in factored form. If it is not possible, write "not possible."</para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002"><m:math><m:mrow><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>36</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00001">
          <para id="para-00003">Enter the factored form of the expression, if possible.</para>
          <para id="para-00004">Compare your answer:</para>
          <para id="para-00005"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mi>−</m:mi><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00006"><m:math><m:mrow><m:mn>49</m:mn><m:mi>−</m:mi><m:mn>25</m:mn><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para></problem>
        <solution id="sol-00002">
          <para id="para-00007">Enter the factored form of the expression, if possible.</para>
          <para id="para-00008">Compare your answer:</para>
          <para id="para-00009"><m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mi>−</m:mi><m:mn>5</m:mn><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010"><m:math><m:mrow><m:msup><m:mi>c</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00003">
          <para id="para-00011">Enter the factored form of the expression, if possible.</para>
          <para id="para-00012">Compare your answer:</para>
          <para id="para-00013"> Not possible because this is the sum of two squares.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00014"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>100</m:mn></m:mrow><m:mrow><m:mn>81</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mn>16</m:mn><m:msup><m:mi>d</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para></problem>
        <solution id="sol-00004">
          <para id="para-00015">Enter the factored form of the expression, if possible.</para>
          <para id="para-00016">Compare your answer:</para>
          <para id="para-00017"><m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mrow><m:mn>9</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>d</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mrow><m:mn>9</m:mn></m:mrow></m:mfrac><m:mi>−</m:mi><m:mn>4</m:mn><m:mi>d</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>