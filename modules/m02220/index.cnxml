<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.8.4: Determining if an Expression Can Be Rewritten in Factored Form</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02220</md:content-id>
    <md:title>8.8.4: Determining if an Expression Can Be Rewritten in Factored Form</md:title>
    <md:uuid>363fa417-6179-46e9-bef3-d6d06b2c0362</md:uuid>
  </metadata>
  <content>
  <section><title>Cool Down Activity</title>
<para>Write each expression in factored form. If it is not possible, write "not possible."</para>
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(a^2− 36\)</para>
    </problem><solution>
    
    <para>Enter the factored form of the expression, if possible.</para>
  <para>Compare your answer:</para>
    <para>\((a + 6)(a − 6)\)</para>
  </solution></exercise>
<!--Interaction End -->

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(49 − 25b^2\)</para>
    </problem><solution>
    
    <para>Enter the factored form of the expression, if possible.</para>
  <para>Compare your answer:</para>
    <para> \((7 + 5b)(7 − 5b)\)</para>
  </solution></exercise>
<!--Interaction End -->

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(c^2+ 9\)</para>
    </problem><solution>
    
    <para>Enter the factored form of the expression, if possible.</para>
  <para>Compare your answer:</para>
    <para> Not possible because this is the sum of two squares.</para>
  </solution></exercise>
<!--Interaction End -->

<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(\frac {100}{81}-16d^2\)</para>
    </problem><solution>
    
    <para>Enter the factored form of the expression, if possible.</para>
  <para>Compare your answer:</para>
    <para> \((\frac {10}{9} + 4d)(\frac {10}{9} − 4d)\)</para>
  </solution></exercise>
<!--Interaction End --></section>
</content>
</document>
