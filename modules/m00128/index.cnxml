<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.5.1: Analyzing Graphs of Linear Equations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00128</md:content-id>
    <md:title>1.5.1: Analyzing Graphs of Linear Equations</md:title>
    <md:uuid>5e207617-e606-44c5-ac46-eeb939e7bf91</md:uuid>
  </metadata>
  <content>
    <section>
      <title>Warm Up Activity</title>
      <exercise>
        <problem>
          <para>Which one doesn’t belong?</para>

          <table class="unnumbered">
            <tgroup cols="4"><tbody><row>
                  <entry>A.<newline/>
                    <media alt="A line graphed on a set of axes, origin O. Hours versus dollars. The line starts at O and extends up and to the right at a somewhat steep angle.">
                      <image mime-type="image/svg+xml" src="../../media/Algebra-1_01_07_02_01.svg"/>
                    </media></entry>
                  <entry>B.<newline/>
                    <media alt="Graph of a line. Vertical axis, hours. Horizontal axis, dollars.">
                      <image mime-type="image/svg+xml" src="../../media/Algebra-1_01_07_02_02.svg"/>
                    </media></entry>
                  <entry> C.<newline/>
                    <media alt="Graph of 12 plotted points. Vertical axis, dollars. Horizontal axis, hours.">
                      <image mime-type="image/svg+xml" src="../../media/Algebra-1_01_07_02_03.svg"/>
                    </media></entry>
                  <entry>D.<newline/>
                    <media alt="Graph of a line. Vertical axis, dollars. Horizontal axis, hours.">
                      <image mime-type="image/svg+xml" src="../../media/Algebra-1_01_07_02_04.svg"/>
                    </media></entry>
                </row>
              </tbody></tgroup></table>    
        </problem>
        <solution>
          <!-- INSERT ANY VALID HTML HERE -->
          <para>Compare your answer: Your answer may vary, but here are some sample responses:</para>
          <list>
            <item>A is the only graph that intersects the vertical axis at 0 (or that starts at the
              origin).</item>
            <item>B is the only graph where the horizontal axis represents dollars and the vertical
              axis represents hours.</item>
            <item>C is the only graph that is discrete, showing plotted points (that lie along a
              line) instead of a continuous line.</item>
            <item>D is the only graph with a negative slope (or that slants downward from left to
              right).</item>
          </list>
        </solution>
      </exercise>
    </section>
  </content>
</document>