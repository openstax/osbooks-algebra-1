<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.4.1: Finding Factors</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01636</md:content-id>
    <md:title>6.4.1: Finding Factors</md:title>
    <md:uuid>66cf9672-c15a-4bf6-bcdf-8521ebd81878</md:uuid>
  </metadata>
  <content>
  <section class="practice" id="sect-00001"><title>Warm Up Activity</title>
<para id="para-00001">In this unit, remember to double click on mathematical expressions/equations to enlarge, if needed.</para>
<para id="para-00002">Finding the factors of a number, monomial, or polynomial is an important step used in the activities of this lesson.</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00003">Factor <m:math display="inline"><m:mrow><m:mn>56</m:mn></m:mrow></m:math> into prime numbers to find all of its factors.</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00004">Compare your answer:</para>
    
    <para id="para-00005"><m:math><m:mrow><m:mn>7</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn></m:mrow></m:math></para></solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00006">Find all of the factors of <m:math display="inline"><m:mrow><m:mn>42</m:mn><m:msup><m:mi>m</m:mi><m:mn>3</m:mn></m:msup><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para>
      
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00007">Compare your answer:</para>
    
    <para id="para-00008"><m:math><m:mrow><m:mn>7</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>3</m:mn><m:mi>·</m:mi><m:mi>m</m:mi><m:mi>·</m:mi><m:mi>m</m:mi><m:mi>·</m:mi><m:mi>m</m:mi><m:mi>·</m:mi><m:mi>y</m:mi><m:mi>·</m:mi><m:mi>y</m:mi></m:mrow></m:math></para></solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00009">Find all of the common factors between <m:math display="inline"><m:mrow><m:mn>6</m:mn><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>p</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>9</m:mn><m:mi>n</m:mi><m:msup><m:mi>s</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00010">Compare your answer:</para>
    
    <para id="para-00011"><m:math display="inline"><m:mrow><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>n</m:mi></m:mrow></m:math></para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00012">Find the least common multiple (LCM) of <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mn>8</m:mn><m:msup><m:mi>x</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:math>.</para>
    </problem><solution id="sol-00004">
    
    
  
  <para id="para-00013">Compare your answer:</para>
    
    <para id="para-00014"><m:math><m:mrow><m:mn>24</m:mn><m:msup><m:mi>x</m:mi><m:mn>4</m:mn></m:msup></m:mrow></m:math></para></solution></exercise>
<!--Interaction End --></section>
</content>
</document>