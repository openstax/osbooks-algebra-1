<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>6.4.1: Finding Factors</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01636</md:content-id>
    <md:title>6.4.1: Finding Factors</md:title>
    <md:uuid>66cf9672-c15a-4bf6-bcdf-8521ebd81878</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Warm Up Activity</title>
<para id="para-00001">In this unit, remember to double click on mathematical expressions/equations to enlarge, if needed.</para>
<para id="para-00002">Finding the factors of a number, monomial, or polynomial is an important step used in the activities of this lesson.</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00003">Factor \(56\) into prime numbers to find all of its factors.</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00004">Compare your answer:</para>
    
    <para id="para-00005">\(7 \cdot 2\cdot 2\cdot 2\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00006">Find all of the factors of \(42m^3y^2\).</para>
      
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00007">Compare your answer:</para>
    
    <para id="para-00008">\(7\cdot 2\cdot 3\cdot m\cdot m\cdot m\cdot y\cdot y\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00009">Find all of the common factors between \(6n^2p^2\) and \(9ns^2\).</para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00010">Compare your answer:</para>
    
    <para id="para-00011">\(3\) and \(n\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00012">Find the least common multiple (LCM) of \(3x^2\) and \(8x^4\).</para>
    </problem><solution id="sol-00004">
    
    
  
  <para id="para-00013">Compare your answer:</para>
    
    <para id="para-00014">\(24x^4\)</para>
  
  </solution></exercise>
<!--Interaction End --></section>
</content>
