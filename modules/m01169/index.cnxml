    <para>Value when \(n=5\)</para>
      </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>–41</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Value when \(n=6\)</para>
      </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>–122</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>Write the full sequence out to 6 terms.</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>–1, –2, –5, –14, –41, –122</para>
  </solution></exercise>
<!--Interaction End -->
