        </exercise>
        <exercise id="af41a1fe-53a0-42fa-a351-2dac2cdbb508" class="multiple-choice">
          <problem>
            <para>18, 20, 22, 24</para>
          </problem>
          <solution>
            <para>Correct! Arithmetic</para>
            <para>Nice try! The correct answer is Arithmetic.</para>
          </solution>
        </exercise>
        <exercise id="_1b175600-5dea-49f8-ac17-d905c8b82fb1" class="multiple-choice">
