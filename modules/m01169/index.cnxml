        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00006">
        <problem id="prob-00006">
          <para id="para-00022">Write the full sequence out to 6 terms.</para>
          
        </problem>
        <solution id="sol-00006">
          <para id="para-00023">Compare your answer:</para>
          <para id="para-00024">–1, –2, –5, –14, –41, –122</para>
        </solution>
      </exercise>
      <!--Interaction End -->
        <exercise id="_8482cb5d-ffd9-4df8-a1ea-03a368002bbc" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00025">Determine if the following sequences are arithmetic or geometric.  </para>
          <para id="para-00026">3, 6, 12, 24</para>
      
          </problem>
          <solution id="sol-00007">
            <para id="para-00027">Correct! Geometric</para>
            <para id="para-00028">Nice try! The correct answer is Geometric.</para>
          </solution>
        </exercise>
        <exercise id="e4499a8e-3c8c-4333-ac8d-a11528814f06" class="multiple-choice">
