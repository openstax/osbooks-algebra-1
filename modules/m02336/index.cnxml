    <md:content-id>m02336</md:content-id>
    <md:title>9.1.3: Solving Multi Step Quadratic Equations Using Perfect Squares</md:title>
    <md:uuid>67500622-7187-4f9f-8cd6-95b219491984</md:uuid>
  </metadata>
