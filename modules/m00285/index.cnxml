<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.13.1: Writing Linear Equations</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00285</md:content-id>
    <md:title>1.13.1: Writing Linear Equations</md:title>
    <md:uuid>df943fee-af3d-4db1-a3ac-12aca7fd2020</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <title>Warm Up Activity</title>
      <para id="para-00001">For numbers 1 – 3, write the equation of:</para>
      <!--Q#1-->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00002">A line with a slope of 5 and a \(y\)-intercept of \(\frac12\).</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Compare your answer:</para>
          <para id="para-00004">\(y = 5x + \frac12\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#2-->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00005">A line with a slope of 2 that goes through \((-1, 3)\).</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00006">Compare your answer:</para>
          <para id="para-00007">\(y = \frac{1}{2} x + \frac72\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!--Q#3-->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00008">A line that passes through \((2, 4)\) and \((1, -2)\).</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00009">Compare your answer:</para>
          <para id="para-00010">\(y=6x - 8\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>