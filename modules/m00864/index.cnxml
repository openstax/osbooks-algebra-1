              <m:mrow>
                <m:mi>g</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>t</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mi>d</m:mi>
              </m:mrow>
            </m:math></para>
        </problem>
        <solution id="sol-00015">
          <para id="para-00054">Compare your answer:</para>
          <para id="para-00055">On the second day, <m:math display="inline">
              <m:mrow>
                <m:mi>t</m:mi>
              </m:mrow>
            </m:math> seconds after the owner
            left, the dog was <m:math display="inline">
              <m:mrow>
                <m:mi>d</m:mi>
              </m:mrow>
            </m:math> feet away from the post. </para>
