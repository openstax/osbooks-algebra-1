<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.7.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02451</md:content-id>
    <md:title>9.7.5: Practice</md:title>
    <md:uuid>e190b8eb-026a-47bc-8460-7fd9ecaf2d9c</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
        <exercise id="_2cba9f5d-8a29-47f5-8c43-8db679437249" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00002">Answer the following questions about the values of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>, and <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math> if this equation is written in standard form, <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>b</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>c</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math>.</para>
            <para id="para-00003">Mai and Jada are solving the equation <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>15</m:mn></m:mrow></m:math> using the quadratic formula.</para>
            <para id="para-00004">Enter the value of <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>?</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00005">Correct! The value of <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
            <para id="para-00006">Try again. Revisit activity 9.7.2.</para>
            <para id="para-00007">The correct answer is 2. The value of <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_7131c2b4-6b14-431e-8a5a-96bd8fb1a549" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00008">Enter the value of <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>?</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00009">Correct! The value of <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math>.</para>
            <para id="para-00010">Try again. Revisit activity 9.7.2.</para>
            <para id="para-00011">The correct answer is -7. The value of <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_5133ff2f-3f56-4d89-8ce5-3060ad5f4c9f" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00012">Enter the value of <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math>?</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00013">Correct! The value of <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>15</m:mn></m:mrow></m:math>.</para>
            <para id="para-00014">Try again. Revisit activity 9.7.2.</para>
            <para id="para-00015">The correct answer is -15. The value of <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>15</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="b0d4e99e-7e04-410a-b900-79577a756d37" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00016">Who has the correct solution?</para>
            <para id="para-00017">Mai and Jada are solving the equation <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>15</m:mn></m:mrow></m:math> using the quadratic formula but found different solutions.</para>
            <table class="os-raise-midsizetable" id="table-00001">
              <tgroup cols="2">
                <tbody>
                  <row>
                    <entry><emphasis>Mai's Method</emphasis></entry>
                    <entry><emphasis>Jada's Method</emphasis></entry>
                  </row>
                  <row>
                    <entry>
                      <para id="para-00018"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>7</m:mn><m:mi>±</m:mi><m:msqrt><m:mrow><m:msup><m:mn>7</m:mn><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>15</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:msqrt></m:mrow><m:mrow><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00019"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>7</m:mn><m:mi>±</m:mi><m:msqrt><m:mrow><m:mn>49</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>120</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:msqrt></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00026"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>7</m:mn><m:mi>±</m:mi><m:msqrt><m:mrow><m:mn>169</m:mn></m:mrow></m:msqrt></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00027"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>7</m:mn><m:mi>±</m:mi><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00028"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>7</m:mn><m:mo>+</m:mo><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>6</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00029"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mn>20</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math></para></entry>
                    <entry>
                      <para id="para-00069"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo><m:mi>±</m:mi><m:msqrt><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>7</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>15</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:msqrt></m:mrow><m:mrow><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00070"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>7</m:mn><m:mi>±</m:mi><m:msqrt><m:mrow><m:mn>49</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>120</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:msqrt></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para><para id="para-00071"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>7</m:mn><m:mi>±</m:mi><m:msqrt><m:mrow><m:mn>71</m:mn></m:mrow></m:msqrt></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para></entry>
                  </row>
                </tbody>
              </tgroup>
            </table>
          </problem>
          <solution id="sol-00004">
            <para id="para-00020">Correct! Mai used 7 for <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math> instead of -7. For <m:math display="inline"><m:mrow><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> in the formula, Jada computed <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:msup><m:mn>7</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math> instead of <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>7</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>, so she wrote -49 instead of 49.</para>
            <para id="para-00021">Try again. Revisit activities 9.7.2 – 9.7.4.</para>
            <para id="para-00022">T The correct answer is: Neither one. Mai used 7 for <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math> instead of -7. For <m:math display="inline"><m:mrow><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> in the formula, Jada computed <m:math display="inline"><m:mrow><m:mo>−</m:mo><m:msup><m:mn>7</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math> instead of <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>7</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup></m:mrow></m:math>, so she wrote -49 instead of 49.</para>
          </solution>
        </exercise>
        <exercise id="a0b057d3-da9c-4de2-bf5e-2f14ace7e03a" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00023">The equation <m:math display="inline"><m:mrow><m:mi>h</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>16</m:mn><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>80</m:mn><m:mi>t</m:mi><m:mo>+</m:mo><m:mn>64</m:mn></m:mrow></m:math> represents the height, in feet, of a potato <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> seconds after it was launched from a mechanical device.</para>
            <para id="para-00024">Choose the equation that would allow us to find the time the potato hits the ground.</para>
            <para id="para-00025">Multiple Choice:</para>
            <para id="para-00072"><m:math><m:mrow><m:mn>0</m:mn><m:mo>=</m:mo><m:mn>16</m:mn><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>80</m:mn><m:mi>t</m:mi><m:mo>+</m:mo><m:mn>64</m:mn></m:mrow></m:math></para><para id="para-00073"><m:math><m:mrow><m:mn>0</m:mn><m:mo>=</m:mo><m:mo>−</m:mo><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>t</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00074"><m:math><m:mrow><m:mn>0</m:mn><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>16</m:mn><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>80</m:mn><m:mi>t</m:mi><m:mo>+</m:mo><m:mn>64</m:mn></m:mrow></m:math></para><para id="para-00075"><m:math><m:mrow><m:mn>0</m:mn><m:mo>=</m:mo><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>t</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00005">
            <para id="para-00030">Correct! <m:math display="inline"><m:mrow><m:mn>0</m:mn><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>16</m:mn><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>80</m:mn><m:mi>t</m:mi><m:mo>+</m:mo><m:mn>64</m:mn></m:mrow></m:math></para>
            <para id="para-00031">Try again. Revisit activities 9.7.2 – 9.7.4.</para>
            <para id="para-00032">The correct answer is: <m:math display="inline"><m:mrow><m:mn>0</m:mn><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>16</m:mn><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>80</m:mn><m:mi>t</m:mi><m:mo>+</m:mo><m:mn>64</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="b6cc8061-e938-4bc1-9496-7e5fa4a806e0" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00033">Enter the solution for the approximate time the potato hits the ground.</para>
            <para id="para-00034">Solve the equation without graphing and write it down. Enter your solution for the approximate time the potato hits the ground rounded to one decimal place.</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00035">Correct! <m:math display="inline"><m:mrow><m:mi>t</m:mi><m:mo>≈</m:mo><m:mn>5.7</m:mn></m:mrow></m:math>. Using the quadratic formula, with <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>16</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>80</m:mn></m:mrow></m:math>, and <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mn>64</m:mn></m:mrow></m:math>, the potato hits the ground about 5.7 seconds after being launched. (The negative solution has no meaning in this situation.)</para>
            <para id="para-00036">Try again. Revisit activity 1.6.3.</para>
            <para id="para-00037">The correct answer is <m:math display="inline"><m:mrow><m:mi>t</m:mi><m:mo>≈</m:mo><m:mn>5.7</m:mn></m:mrow></m:math>. Using the quadratic formula, with <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>16</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>80</m:mn></m:mrow></m:math>, and <m:math display="inline"><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mn>64</m:mn></m:mrow></m:math>, the potato hits the ground about 5.7 seconds after being launched. (The negative solution has no meaning in this situation.)</para>
          </solution>
        </exercise>
        <exercise id="_6795296a-41c1-4a4b-b5ad-6da388418e4a" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00038">Priya found <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math> as solutions to <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>6</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>9</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math>.</para>
            <para id="para-00039">If you check Priya's answer by substitution, is the answer correct?</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00040">Correct! Yes. Substituting both 3 and -1 for <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> in the original quadratic expression and then evaluating the expression gives a value of 0.</para>
            <para id="para-00041">Try again. Revisit activities 9.7.2 – 9.7.4.</para>
            <para id="para-00042">The correct answer is Yes. Substituting each 3 and -1 for <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> in the original quadratic expression and then evaluating the expression gives a value of 0.</para>
          </solution>
        </exercise>
        <exercise id="_728d68b0-1c79-47ae-b653-ef30276a702c" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00043">If you check Priya's answer by graphing, is the answer correct?</para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00044">Correct! Yes. Graphing the equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>6</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>9</m:mn></m:mrow></m:math> shows <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts at <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
            <para id="para-00045">Try again. Revisit activities 9.7.2 – 9.7.4.</para>
            <para id="para-00046">The correct answer is Yes. Graphing the equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>6</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>9</m:mn></m:mrow></m:math> shows <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math>-intercepts at <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="eb766327-6e58-4440-b98c-78a41dd60fb2" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00047">If you check Priya's answer by using the quadratic formula, is the answer correct?</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00048">Correct! Yes. Substituting 3 for <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>, -6 for <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>, and -9 for <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math> in the quadratic formula gives <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math>.</para>
            <para id="para-00049">Try again. Revisit activities 9.7.2 – 9.7.4.</para>
            <para id="para-00050">The correct answer is Yes. Substituting 3 for <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>, -6 for <m:math display="inline"><m:mrow><m:mi>b</m:mi></m:mrow></m:math>, and -9 for <m:math display="inline"><m:mrow><m:mi>c</m:mi></m:mrow></m:math> in the quadratic formula gives <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="c4247392-6a1d-4e1e-8267-39f00abbceb2" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00051">A frog jumps in the air. The height, in inches, of the frog is modeled by the function <m:math display="inline"><m:mrow><m:mi>h</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>60</m:mn><m:mi>t</m:mi><m:mi>−</m:mi><m:mn>75</m:mn><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>, where <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> is the time after it jumped, measured in seconds.</para>
            <para id="para-00052"><emphasis>Select two</emphasis> solutions to the equation <m:math display="inline"><m:mrow><m:mn>60</m:mn><m:mi>t</m:mi><m:mi>−</m:mi><m:mn>75</m:mn><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math>.</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00053">Correct! <m:math display="inline"><m:mrow><m:mi>t</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>t</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
            <para id="para-00054">Try again. Revisit activity 9.7.3.</para>
            <para id="para-00055">The correct answers are: <m:math display="inline"><m:mrow><m:mi>t</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>t</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="ee172b4a-d177-4f3f-bb23-dd918205ad05" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00056">What do the solutions tell us about the jumping frog?<emphasis>Select two</emphasis> that apply.</para>
          </problem>
          <solution id="sol-00011">
            <para id="para-00057">Correct! The frog landed <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac></m:mrow></m:math> seconds after it jumped and was on the ground again. The height of the frog was 0 inches before it jumped.</para>
            <para id="para-00058">Try again. Revisit activity 9.7.3.</para>
            <para id="para-00059">The correct answers are: The frog landed <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>4</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac></m:mrow></m:math> seconds after it jumped and was on the ground again. The height of the frog was 0 inches before it jumped..</para>
          </solution>
        </exercise>
        <exercise id="_953362ca-c564-46a1-8d9a-20374b714c92" class="multiple-choice">
          <problem id="prob-00012">
            <para id="para-00060">A tennis ball is hit straight up in the air, and its height, in feet above the ground, is modeled by the equation <m:math display="inline"><m:mrow><m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>t</m:mi><m:mi>−</m:mi><m:mn>16</m:mn><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>, where <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> is measured in seconds since the ball was thrown.</para>
            <para id="para-00061"><emphasis>Select two</emphasis> solutions to the equation <m:math display="inline"><m:mrow><m:mn>0</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>t</m:mi><m:mi>−</m:mi><m:mn>16</m:mn><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>.</para>
          </problem>
          <solution id="sol-00012">
            <para id="para-00062">Correct! <m:math display="inline"><m:mrow><m:mi>t</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>t</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
            <para id="para-00063">Try again. Revisit activity 9.7.3.</para>
            <para id="para-00064">The correct answers are: <m:math display="inline"><m:mrow><m:mi>t</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mi>t</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_698e0e88-9992-422c-96c7-29aa023ebca8" class="multiple-choice">
          <problem id="prob-00013">
            <para id="para-00065">What do the solutions tell us about the tennis ball?<emphasis>Select two</emphasis> that apply.</para>
          </problem>
          <solution id="sol-00013">
            <para id="para-00066">Correct! The negative solution doesn't have meaning because a negative value for time doesn't make sense. The ball hits the ground 1 second after it is hit.</para>
            <para id="para-00067">Try again. Revisit activity 9.7.3.</para>
            <para id="para-00068">The correct answers are: The negative solution doesn't have meaning because a negative value for time doesn't make sense. The ball hits the ground 1 second after it is hit.</para>
          </solution>
        </exercise>
    </section>
  </content>
