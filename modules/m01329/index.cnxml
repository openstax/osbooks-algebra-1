<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Writing Equations to Represent Exponential Decay</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01329</md:content-id>
    <md:title>Writing Equations to Represent Exponential Decay</md:title>
    <md:uuid>6097bbe2-beb1-4be9-ab69-1d295ad94be3</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001" class="numbered-exercises"><title>Cool Down</title>
      <para id="para-00001">Acetaminophen is a common pain reliever and fever reducer. Here is a graph showing the amount of acetaminophen, in milligrams, in an adult’s body at different times after they take a normal dose.</para>
      <para id="para-00002">
          <media alt="A graph showing acetaminophen levels (mg) decreasing over 8 hours; starting at 1000 mg at 0 hours, dropping to 750 mg at 1 hour, 562.5 mg at 2 hours, and continuing downward.">
            <image mime-type="image/svg+xml" src="../../media/Algebra-1_05_07_12_01.svg"/>
          </media>
        
    </para>
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00003" class="custom-question-container">Answer the following questions.</para>
        <para id="para-00004">a. What is the vertical intercept?</para>
                    <para id="para-00007">b. What does it mean in this situation?</para>

        </problem>
        <solution id="sol-00001">
          <para id="para-00005">Compare your answer: </para>
          <para id="para-00006">a. 1,000</para>
                    <para id="para-00009">b. There are 1,000 mg of acetaminophen in the person’s body after taking the medicine (this is the dose size).</para>

        </solution>
      </exercise>

      <!--Interaction End -->
      <!--Text Entry Interaction Start -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00010" class="custom-question-container">What fraction of the medicine remained after one hour?</para></problem>
        <solution id="sol-00003">
          <para id="para-00011">Compare your answer: </para>
          <para id="para-00012"><m:math display="inline"><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> of the medicine remained after 1 hour since <m:math display="inline"><m:mrow><m:mfrac><m:mrow><m:mn>750</m:mn></m:mrow><m:mrow><m:mn>1000</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      
        <exercise id="exer-00004">
          <problem id="prob-00004">
            <para id="para-00013" class="custom-question-container">Write an equation that represents the amount of medicine, <m:math display="inline"><m:mrow><m:mi>a</m:mi></m:mrow></m:math>, after <m:math display="inline"><m:mrow><m:mi>t</m:mi></m:mrow></m:math> hours.</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00015">Compare your answer: </para>
            <para id="para-00016"><m:math><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mi>t</m:mi></m:msup></m:mrow></m:math></para></solution>
        </exercise>
      
      <!--Interaction End -->
    </section>
  </content>
</document>