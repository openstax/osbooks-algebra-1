<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.11.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02280</md:content-id>
    <md:title>8.11.5: Practice</md:title>
    <md:uuid>eecf22e1-984c-43db-8ec3-5505af6355bd</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <exercise id="_2cf37e70-fdd6-46dc-a766-bfd6dd4b69ef" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00002">For questions 1 – 4, identify a quadratic function in standard form, \(f(x)\), with the given zeros.</para>
          <para id="para-00003">1 and 9</para>
          <para id="para-00004">Multiple Choice:</para>
          <para id="para-00005">\(f(x) = x^2 + 10x + 9\)</para>
          <para id="para-00006">\(f(x) = x^2 − 8x + 9\)</para>
          <para id="para-00007">\(f(x) = x^2 + 8x + 9\)</para>
          <para id="para-00008">\(f(x) = x^2 − 10x + 9\)</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00009">Try again. Revisit activity 8.11.2.</para>
          <para id="para-00010">The correct answer is \(f(x) = x^2 − 10x + 9\).</para>
        </solution>
      </exercise>
      <exercise id="_07db76f5-fe1a-47b7-a8f4-d6338a20b858" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00011">\(\sqrt5\) and \(-\sqrt{5}\)</para>
          <para id="para-00012">Multiple Choice:</para>
          <para id="para-00013">\(f(x) = x^2 − 5x − 5\)</para>
          <para id="para-00014">\(f(x) = x^2 + 5x − 5\)</para>
          <para id="para-00015">\(f(x) = x^2 − 5\)</para>
          <para id="para-00016">\(f(x) = x^2 + 5\)</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00017">Try again. Revisit activity 8.11.2.</para>
          <para id="para-00018">The correct answer is \(f(x) = x^2 − 5\).</para>
        </solution>
      </exercise>
      <exercise id="ff482616-7944-4fc5-9ae2-3b54d7a076b0" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00019">–7</para>
          <para id="para-00020">Multiple Choice:</para>
          <para id="para-00021">\(f(x) = x^2 + 14x + 49\)</para>
          <para id="para-00022">\(f(x) = x^2 − 14x − 49\)</para>
          <para id="para-00023">\(f(x) = x^2 − 49\)</para>
          <para id="para-00024">\(f(x) = x^2 − 14x + 49\)</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00025">Try again. Revisit activity 8.11.2.</para>
          <para id="para-00026">The correct answer is \(f(x) = x^2 + 14x + 49\).</para>
        </solution>
      </exercise>
      <exercise id="c0d873b5-60e8-4b43-9c28-d67fa7c53f36" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00027">–3</para>
          <para id="para-00028">Multiple Choice:</para>
          <para id="para-00029">\(f(x) = x^2 − 6x + 9\)</para>
          <para id="para-00030">\(f(x) = x^2 + 9\)</para>
          <para id="para-00031">\(f(x) = x^2 + 6x + 9\)</para>
          <para id="para-00032">\(f(x) = x^2 − 9\)</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00033">Try again. Revisit activity 8.11.2.</para>
          <para id="para-00034">The correct answer is \(f(x) = x^2 + 6x + 9\).</para>
        </solution>
      </exercise>
      <exercise id="_4c636bc6-210b-4a8a-af32-6a02cfa78d9e" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00035">Examine the graph below to identify the zeros of the function. Then, write a quadratic function in standard form with the given zeros.</para>
              <media alt="A PARABOLA THAT OPENS UP WITH \(x\)-intercepts OF NEGATIVE 5 AND 1.">
              <image mime-type="image/jpeg" src="../../media/Algebra-1_09_13_10_01.jpg"/>
            </media>
          
          <para id="para-00036">Multiple Choice:</para>
          <para id="para-00037">\(f(x) = x^2 + 4x − 5\)</para>
          <para id="para-00038">\(f(x) = x^2 − 6x − 5\)</para>
          <para id="para-00039">\(f(x) = x^2 − 4x − 5\)</para>
          <para id="para-00040">\(f(x) = x^2 + 6x − 5\)</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00041">Try again. Revisit activity 8.11.2.</para>
          <para id="para-00042">The correct answer is \(f(x) = x^2 + 4x − 5\).</para>
        </solution>
      </exercise>
      <exercise id="_52010894-9061-4963-87c8-7e33c014fee6" class="multiple-choice">
        <problem id="prob-00006">
          <para id="para-00043">Examine the graph below to identify the zeros of the function. Then, write a quadratic function in standard form with the given zeros.</para>
          <para id="para-00044">Multiple Choice:</para>
          <para id="para-00045">\(f(x) = x^2 − 2x − 8\)</para>
          <para id="para-00046">\(f(x) = x^2 − 6x + 8\)</para>
          <para id="para-00047">\(f(x) = x^2 + 2x − 8\)</para>
          <para id="para-00048">\(f(x) = x^2 + 6x + 8\)</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00049">Try again. Revisit activity 8.11.2.</para>
          <para id="para-00050">The correct answer is \(f(x) = x^2 − 6x + 8\).</para>
        </solution>
      </exercise>
      <exercise id="_382279dc-b26c-458b-bbc8-215732e20d35" class="multiple-choice">
        <problem id="prob-00007">
          <para id="para-00051">Write the specific quadratic function, \(p(x)\), in standard form, that has the zeros –8 and 3 and passes through the point \((2, -20)\).</para>
          <para id="para-00052">Multiple Choice:</para>
          <para id="para-00053">\(p(x) = 2x^2 + 10x − 48\)</para>
          <para id="para-00054">\(p(x) = 3x^2 + 15x − 72\)</para>
          <para id="para-00055">\(p(x) = −x^2 − 5x − 24\)</para>
          <para id="para-00056">\(p(x) = −x^2 − 5x − 6\)</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00057">Try again. Revisit activities 8.11.3 and 8.11.4.</para>
          <para id="para-00058">The correct answer is \(p(x) = 2x^2 + 10x − 48\).</para>
        </solution>
      </exercise>
      <exercise id="d8bf81db-a6a2-4606-87d8-62d38118a5b4" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00059">Write the specific quadratic function, \(g(x)\), in standard form, that has the zero 2 and passes through the point \((3, -3)\).</para>
          <para id="para-00060">Multiple Choice:</para>
          <para id="para-00061">\(g(x) = x^2 − 4x + 4\)</para>
          <para id="para-00062">\(g(x) = 2x^2 − 8x + 3\)</para>
          <para id="para-00063">\(g(x) = −2x^2 + 8x − 8\)</para>
          <para id="para-00064">\(g(x) = −3x^2 + 12x − 12\)</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00065">Try again. Revisit activities 8.11.3 and 8.11.4.</para>
          <para id="para-00066">The correct answer is \(g(x) = −3x^2 + 12x − 12\).</para>
        </solution>
      </exercise>
      <exercise id="_432a5130-fca8-457c-ba48-e4760bd43c87" class="multiple-choice">
        <problem id="prob-00009">
          <para id="para-00067">Write the specific quadratic function, \(h(x)\), in standard form, that has the zeros 3 and 5 and passes through the point \((2, 12)\).</para>
          <para id="para-00068">Multiple Choice:</para>
          <para id="para-00069">\(h(x) = x^2 − 8x + 15\)</para>
          <para id="para-00070">\(h(x) = 4x^2 − 32x + 60\)</para>
          <para id="para-00071">\(h(x) = −x^2 + 8x − 15\)</para>
          <para id="para-00072">\(h(x) = 3x^2 − 24x + 48\)</para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00073">Try again. Revisit activities 8.11.3 and 8.11.4.</para>
          <para id="para-00074">The correct answer is \(h(x) = 4x^2 − 32x + 60\).</para>
        </solution>
      </exercise>
      <exercise id="edc67eae-edda-4a6b-80d1-0160b01d0141" class="multiple-choice">
        <problem id="prob-00010">
          <para id="para-00075">Write the specific quadratic function, \(w(x)\), in standard form, that has the zeros 6 and –7 and passes through the point \((5, 12)\).</para>
          <para id="para-00076">Multiple Choice:</para>
          <para id="para-00077">\(w(x) = x^2 + x − 42\)</para>
          <para id="para-00078">\(w(x) = 2x^2 + 2x − 48\)</para>
          <para id="para-00079">\(w(x) = −2x^2 − 2x + 84\)</para>
          <para id="para-00080">\( w(x) = −x^2 − x + 42\)</para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00081">Try again. Revisit activities 8.11.3 and 8.11.4.</para>
          <para id="para-00082">The correct answer is \( w(x) = −x^2 − x + 42\).</para>
        </solution>
      </exercise>
    </section>
  </content>
