<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>5.3.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01286</md:content-id>
    <md:title>5.3.6: Practice</md:title>
    <md:uuid>5315b4d2-39d4-4c50-8080-6c864de3f3b3</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">

        <exercise id="_47aa30b9-ab56-418a-b39c-4ec8704c046e" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00001">Which expression equals <m:math display="inline"><m:mrow><m:msup><m:mn>2</m:mn><m:mn>7</m:mn></m:msup></m:mrow></m:math>?</para>
            <para id="para-00002">Multiple Choice:</para>
            <para id="para-00003"><m:math><m:mrow><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
            <para id="para-00004"><m:math><m:mrow><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn></m:mrow></m:math></para>
            <para id="para-00005"><m:math><m:mrow><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>7</m:mn></m:mrow></m:math></para>
            <para id="para-00006"><m:math><m:mrow><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00001">
            
            <para id="para-00007">Try again. Revisit activity 5.3.4.
    </para>
            <para id="para-00008">The correct answer is <m:math display="inline"><m:mrow><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn></m:mrow></m:math>.
    </para>
          </solution>
        </exercise>
        <exercise id="d4ae43a2-6c9d-4eb8-9bea-7160d3e0bea9" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00009">The graph shows the yearly balance, in dollars, of investment account A. The table shows the yearly balance, in dollars, of investment account B.</para>

          <para id="para-00010">(<media alt="Graph of a function on grid."><image mime-type="image/svg+xml" src="../../media/Algebra-1_05_05_13_01.svg"/></media>)
          <table class="os-raise-skinnytable" id="table-00001"><tgroup cols="2"><tbody><row><entry><emphasis>Number of years</emphasis></entry><entry><emphasis>Amount in dollars</emphasis></entry></row><row><entry>
                  0
                </entry><entry>
                  $2,000
                </entry></row><row><entry>
                  1
                </entry><entry>
                  $2,150
                </entry></row><row><entry>
                  2
                </entry><entry>
                  $2,300
                </entry></row><row><entry>
                  3
                </entry><entry>
                  $2,450
                </entry></row><row><entry>
                  4
                </entry><entry>
                  $2,600
                </entry></row></tbody></tgroup></table>
          
      </para>
            <para id="para-00011">Investment A is a/n:</para>
          </problem>
          <solution id="sol-00002">
            
            <para id="para-00012">Try again. Revisit activity 5.3.3.
    </para>
            <para id="para-00013">The correct answer is investment A is an exponential function.</para>
          </solution>
        </exercise>
        <exercise id="_2e8018d8-02b2-44d7-93ec-2d588f989d63" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00014">Investment B is a/n:</para>
          </problem>
          <solution id="sol-00003">
            
            <para id="para-00015">Try again. Revisit activity 5.3.3.</para>
            <para id="para-00016">The correct answer is investment B is a linear function.

    </para>
          </solution>
        </exercise>
        <exercise id="fbad6471-c6ee-45b1-bc1d-256b4c9d53e3" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00017">Which of the following statements are true? Select two that apply.</para>
            <para id="para-00018">The graph shows the yearly balance, in dollars, of investment account A. The table shows the yearly balance, in dollars, of investment account B.</para>

          <para id="para-00019">(<media alt="Graph of a function on grid."><image mime-type="image/svg+xml" src="../../media/Algebra-1_05_05_13_02.svg"/></media>)
          <table class="os-raise-skinnytable" id="table-00002"><tgroup cols="2"><tbody><row><entry><emphasis>Number of years</emphasis></entry><entry><emphasis>Amount in dollars</emphasis></entry></row><row><entry>
                  0
                </entry><entry>
                  $2,000
                </entry></row><row><entry>
                  1
                </entry><entry>
                  $2,150
                </entry></row><row><entry>
                  2
                </entry><entry>
                  $2,300
                </entry></row><row><entry>
                  3
                </entry><entry>
                  $2,450
                </entry></row><row><entry>
                  4
                </entry><entry>
                  $2,600
                </entry></row></tbody></tgroup></table>
          
      </para>
          </problem>
          <solution id="sol-00004">
            
            <para id="para-00020">Try again. Revisit activity 5.3.2.
    </para>
            <para id="para-00021">The correct answers are “Investment A has a common ratio” and “Investment B is growing by the same number of dollars each year.”
    </para>
          </solution>
        </exercise>
        <exercise id="_5194cfd4-7a35-4cf5-8e07-a1591abd5323" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00022">Investment account 1 starts with a balance of $200 and doubles every year. Investment account 2 starts with $1,000 and increases by $100 each year.  How long does it take for each account to double?</para>
            <para id="para-00023">How many years will it take investment account 1 to double?</para>
          </problem>
          <solution id="sol-00005">
            
            <para id="para-00024">Try again. Revisit activity 5.3.1.</para>
            <para id="para-00025">The correct answer is investment account 1 will double after 1 year.
    </para>
          </solution>
        </exercise>
        <exercise id="_612a528e-7954-4e6c-9072-ab22608e43cc" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00026">How many years will it take investment account 2 to double?</para>
          </problem>
          <solution id="sol-00006">
            
            <para id="para-00027">Try again. Revisit activity 5.3.1.</para>
            <para id="para-00028">The correct answer is investment account 2 will double after 10 years.
    </para>
          </solution>
        </exercise>
        <exercise id="_6b5c04b5-8090-4f89-a000-25b2f7d21a5a" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00029">A population of ants is 10,000 at the start of April. Since then, it triples each month. How many ants will there be 1 month later?</para>
            <para id="para-00030">Multiple Choice:</para>
            <para id="para-00031">10,003</para>
            <para id="para-00032">10,300</para>
            <para id="para-00033">30,000</para>
            <para id="para-00034">90,000</para>
          </problem>
          <solution id="sol-00007">
            
            <para id="para-00035">Try again. Revisit activity 5.3.3.
    </para>
            <para id="para-00036">The correct answer is 30,000.
    </para>
          </solution>
        </exercise>
        <exercise id="b2a066e0-6c5c-444e-bed3-c0ebd63e6c9a" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00037">A population of ants is 10,000 at the start of April. Since then, it triples each month. Which values complete the table?
          
          <table class="os-raise-skinnytable" id="table-00003"><tgroup cols="2"><tbody><row><entry><emphasis>months since April</emphasis></entry><entry><emphasis>number of ants</emphasis></entry></row><row><entry>
                  0
                </entry><entry>
                  10,000
                </entry></row><row><entry>
                  1
                </entry><entry>
                  30,000
                </entry></row><row><entry>
                  2
                </entry><entry>
                   
                </entry></row><row><entry>
                  3
                </entry><entry>
                   
                </entry></row><row><entry>
                  4
                </entry><entry>
                   
                </entry></row></tbody></tgroup></table>
          
      </para>
            <para id="para-00038">Multiple Choice:</para>
            <para id="para-00039">50,000, 70,000, 90,000</para>
            <para id="para-00040">90,000, 270,000, 510,000</para>
            <para id="para-00041">40,000, 70,000, 110,000</para>
            <para id="para-00042">33,000, 33,300, 33,330</para>
          </problem>
          <solution id="sol-00008">
            
            <para id="para-00043">Try again. Revisit activity 5.3.4.
    </para>
            <para id="para-00044">The correct answer is 90,000, 270,000, 510,000.</para>
          </solution>
        </exercise>
        <exercise id="_7fc355fd-7699-488f-8921-1f1e256f30ac" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00045">A population of ants triples each month. If there are <m:math display="inline"><m:mrow><m:mi>n</m:mi></m:mrow></m:math> ants in one month, which expression represents how many ants there will be one month later?</para>
            <para id="para-00046">Multiple Choice:</para>
            <para id="para-00047"><m:math><m:mrow><m:msup><m:mn>3</m:mn><m:mi>n</m:mi></m:msup></m:mrow></m:math></para>
            <para id="para-00048"><m:math><m:mrow><m:msup><m:mi>n</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para>
            <para id="para-00049"><m:math><m:mrow><m:mn>3</m:mn><m:mi>n</m:mi></m:mrow></m:math></para>
            <para id="para-00050"><m:math><m:mrow><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00009">
            
            <para id="para-00051">Try again. Revisit activity 5.3.4.
    </para>
            <para id="para-00052">The correct answer is <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>n</m:mi></m:mrow></m:math>.
    </para>
          </solution>
        </exercise>
        <exercise id="_87c78b8b-26b8-41e3-8460-5a784a34a678" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00053">A swimming pool contains 500 gallons of water. A hose is turned on, and it fills the pool at a rate of 24 gallons per minute. Which expression represents the amount of water in the pool, in gallons, after 8 minutes?</para>
            <para id="para-00054">Multiple Choice:</para>
            <para id="para-00055"><m:math><m:mrow><m:mn>500</m:mn><m:mi>·</m:mi><m:mn>24</m:mn><m:mi>·</m:mi><m:mn>8</m:mn></m:mrow></m:math></para>
            <para id="para-00056"><m:math><m:mrow><m:mn>500</m:mn><m:mo>+</m:mo><m:mn>24</m:mn><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
            <para id="para-00057"><m:math><m:mrow><m:mn>500</m:mn><m:mo>+</m:mo><m:mn>24</m:mn><m:mi>·</m:mi><m:mn>8</m:mn></m:mrow></m:math></para>
            <para id="para-00058"><m:math><m:mrow><m:mn>500</m:mn><m:mi>·</m:mi><m:mn>248</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00010">
            
            <para id="para-00059">Try again. Revisit activity 5.3.4.</para>
            <para id="para-00060">The correct answer is <m:math display="inline"><m:mrow><m:mn>500</m:mn><m:mo>+</m:mo><m:mn>24</m:mn><m:mi>·</m:mi><m:mn>8</m:mn></m:mrow></m:math>.
    </para>
          </solution>
        </exercise>
        <exercise id="e92fbc0f-e497-4ac1-a2d8-845e0aa31bd2" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00061">The population of a city is 100,000. It doubles each decade for 5 decades.<emphasis>Select the two</emphasis> expressions that represent the population of the city after 5 decades.</para>
          </problem>
          <solution id="sol-00011">
            
            <para id="para-00062">Try again. Revisit activity 5.3.4.
    </para>
            <para id="para-00063">The correct answer is <m:math display="inline"><m:mrow><m:mn>100</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn><m:mi>·</m:mi><m:mn>2</m:mn></m:mrow></m:math>, <m:math display="inline"><m:mrow><m:mn>100</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mi>·</m:mi><m:msup><m:mn>2</m:mn><m:mn>5</m:mn></m:msup></m:mrow></m:math>.
    </para>
          </solution>
        </exercise>
        <exercise id="bc09b419-b906-4baa-a7fe-96fe89ca2aa1" class="multiple-choice">
          <problem id="prob-00012">
            <para id="para-00064">Bank account C starts with $10 and doubles each week. Bank account D starts with $1,000 and grows by $500 each week.      </para>
          <para id="para-00065">When will account C contain more money than account D?</para>

            <para id="para-00066">Multiple Choice:</para>
            <para id="para-00067">Account C will contain more money than account D after 2 weeks.</para>
            <para id="para-00068">Account C will never contain more money than account D.</para>
            <para id="para-00069">Account C will contain more money than account D after 7 weeks.</para>
            <para id="para-00070">Account C will contain more money than account D after 10 weeks.</para>
          </problem>
          <solution id="sol-00012">
            
            <para id="para-00071">Try again. Revisit activity 5.3.3.
    </para>
            <para id="para-00072">The correct answer is account C will contain more money than account D after 10 weeks.
    </para>
          </solution>
        </exercise>

    </section>
  </content>
</document>
