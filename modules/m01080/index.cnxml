<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.12.5: Using Functions to Answer Real-World Questions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01080</md:content-id>
    <md:title>4.12.5: Using Functions to Answer Real-World Questions</md:title>
    <md:uuid>f07edad3-44f5-4b73-97e1-ab7c7edf128c</md:uuid>
  </metadata>
  <content>
  <section class="numbered-exercises" id="sect-00001"><title>Cool Down</title>
<para id="para-00001">Diego’s club earns money for charity when members of the club perform community service after school. For each student who does community service, the club earns $5. There are 12 students in the club.</para>
<para id="para-00002">The total dollar amount earned, <m:math display="inline"><m:mrow><m:mi>E</m:mi></m:mrow></m:math>, is a function of the number of members who perform community service, <m:math display="inline"><m:mrow><m:mi>n</m:mi></m:mrow></m:math>.</para>


<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00003">Is 5 a possible input value? Why or why not?</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00004">Compare your answer:</para>
    
    <para id="para-00005"><m:math display="inline"><m:mrow><m:mi>n</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math> is possible. It means that 5 students perform community service.</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00006">Is 24 a possible output value? Why or why not?</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00007">Compare your answer:</para>
    
    <para id="para-00008">No, 24 is not possible as an output value. An output value has to be a multiple of 5.</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00009">Describe the domain of this function.</para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00010">Compare your answer:</para>
    
    <para id="para-00011">All integers from 0 to 12</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00012">Describe the range of this function.</para>
    </problem><solution id="sol-00004">
    
    
  
  <para id="para-00013">Compare your answer:</para>
    
    <para id="para-00014">Multiples of 5 from 0 to 60</para>
  
  </solution></exercise>
<!--Interaction End -->
</section>
</content></document>
