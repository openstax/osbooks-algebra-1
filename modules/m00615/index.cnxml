<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>2.13.6: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00615</md:content-id>
    <md:title>2.13.6: Practice</md:title>
    <md:uuid>5cb512b7-de8f-4077-8e33-6d393b860e86</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
 
        <exercise id="d9e6701c-63d6-41fa-bc53-e04b99537fae" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00002"><quote id="quote-00001">This year, students in the 9th grade are collecting dimes and quarters for
              a school fundraiser. They are trying to collect more money than the students who were
              in the 9th grade last year. The students in 9th grade last year collected $143.88.</quote></para>
            <para id="para-00003">Using <m:math display="inline"><m:mrow><m:mi>d</m:mi></m:mrow></m:math> to represent the number of dimes collected and <m:math display="inline"><m:mrow><m:mi>q</m:mi></m:mrow></m:math> to represent the
              number of quarters, which statement best represents this situation?</para>
            <para id="para-00004">Multiple Choice:</para>
            <para id="para-00005"><m:math><m:mrow><m:mn>0.25</m:mn><m:mi>d</m:mi><m:mo>+</m:mo><m:mn>0.1</m:mn><m:mi>q</m:mi><m:mi>≥</m:mi><m:mn>143.88</m:mn></m:mrow></m:math></para><para id="para-00006"><m:math><m:mrow><m:mn>0.25</m:mn><m:mi>q</m:mi><m:mo>+</m:mo><m:mn>0.1</m:mn><m:mi>d</m:mi><m:mo>&lt;</m:mo><m:mn>143.88</m:mn></m:mrow></m:math></para><para id="para-00007"><m:math><m:mrow><m:mn>0.25</m:mn><m:mi>d</m:mi><m:mo>+</m:mo><m:mn>0.1</m:mn><m:mi>q</m:mi><m:mo>></m:mo><m:mn>143.88</m:mn></m:mrow></m:math></para><para id="para-00008"><m:math><m:mrow><m:mn>0.25</m:mn><m:mi>q</m:mi><m:mo>+</m:mo><m:mn>0.1</m:mn><m:mi>d</m:mi><m:mo>></m:mo><m:mn>143.88</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00001">
            <para id="para-00009">Correct! The value of the quarters, <m:math display="inline"><m:mrow><m:mn>0.25</m:mn><m:mi>q</m:mi></m:mrow></m:math>, plus the value of the dimes,
              <m:math display="inline"><m:mrow><m:mn>0.1</m:mn><m:mi>d</m:mi></m:mrow></m:math>, is more than $143.88.</para>
            <para id="para-00010">Try again. Revisit activities 2.13.2 and 2.13.3.</para>
            <para id="para-00011">The correct answer is <m:math display="inline"><m:mrow><m:mn>0.25</m:mn><m:mi>q</m:mi><m:mo>+</m:mo><m:mn>0.1</m:mn><m:mi>d</m:mi><m:mo>></m:mo><m:mn>143.88</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_09b59ea2-8e47-4950-b93c-3d3c27fe25be" class="multiple-choice">
          <problem id="prob-00002">
   
            <para id="para-00012">Which inequality is represented by the graph?</para>
            <para id="para-00013">Multiple Choice:</para>
            <para id="para-00014"><m:math><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>></m:mo><m:mn>12</m:mn></m:mrow></m:math></para><para id="para-00015"><m:math><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>&lt;</m:mo><m:mn>12</m:mn></m:mrow></m:math></para><para id="para-00016"><m:math><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>></m:mo><m:mn>12</m:mn></m:mrow></m:math></para><para id="para-00017"><m:math><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>&lt;</m:mo><m:mn>12</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00002">
            <para id="para-00018">Correct! The graph shows a dashed boundary line for the related equation <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math> and the shading is above the line.</para>
            <para id="para-00019">Try again. Revisit activities 2.13.2 and 2.13.3.</para>
            <para id="para-00020">The correct answer is <m:math display="inline"><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>&lt;</m:mo><m:mn>12</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_56fa3e61-916e-436f-bd1e-361b975b8baa" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00021">For 3 - 4, use the passage below to answer the questions:</para>
            <para id="para-00022"><quote id="quote-00002"> A farmer is creating a budget for planting soybeans and wheat. Planting
              soybeans costs $200 per acre and planting wheat costs $500 per acre. He wants to spend
              no more than $100,000 planting soybeans and wheat.</quote></para>
            <para id="para-00023">Let <m:math display="inline"><m:mrow><m:mi>s</m:mi></m:mrow></m:math> represent the number of acres of soybeans and <m:math display="inline"><m:mrow><m:mi>w</m:mi></m:mrow></m:math> represent the number
              of acres of wheat. Write an inequality to describe the situation.</para>
            <para id="para-00024">Multiple Choice:</para>
            <para id="para-00025"><m:math><m:mrow><m:mn>500</m:mn><m:mi>s</m:mi><m:mo>+</m:mo><m:mn>200</m:mn><m:mi>w</m:mi><m:mo>&lt;</m:mo><m:mn>100</m:mn><m:mo>,</m:mo><m:mn>000</m:mn></m:mrow></m:math></para><para id="para-00026"><m:math><m:mrow><m:mn>500</m:mn><m:mi>s</m:mi><m:mo>+</m:mo><m:mn>200</m:mn><m:mi>w</m:mi><m:mi>≤</m:mi><m:mn>100</m:mn><m:mo>,</m:mo><m:mn>000</m:mn></m:mrow></m:math></para><para id="para-00027"><m:math><m:mrow><m:mn>200</m:mn><m:mi>s</m:mi><m:mo>+</m:mo><m:mn>500</m:mn><m:mi>w</m:mi><m:mi>≤</m:mi><m:mn>100</m:mn><m:mo>,</m:mo><m:mn>000</m:mn></m:mrow></m:math></para><para id="para-00028"><m:math><m:mrow><m:mn>200</m:mn><m:mi>s</m:mi><m:mo>+</m:mo><m:mn>500</m:mn><m:mi>w</m:mi><m:mo>></m:mo><m:mn>100</m:mn><m:mo>,</m:mo><m:mn>000</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00003">
            <para id="para-00029">Correct! The soybeans cost 200s dollars and the wheat costs <m:math display="inline"><m:mrow><m:mn>500</m:mn><m:mi>w</m:mi></m:mrow></m:math>. The sum must
              be less than or equal to $100,000.</para>
            <para id="para-00030">Try again. Revisit activities 2.13.2 and 2.13.3.</para>
            <para id="para-00031">The correct answer is <m:math display="inline"><m:mrow><m:mn>200</m:mn><m:mi>s</m:mi><m:mo>+</m:mo><m:mn>500</m:mn><m:mi>w</m:mi><m:mi>≤</m:mi><m:mn>100</m:mn><m:mo>,</m:mo><m:mn>000</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="af1ef011-ce52-496e-a059-5924974c7d45" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00032">Name one solution to the inequality and explain what it represents in that
              situation.</para>
            <para id="para-00033">Multiple Choice:</para>
            <para id="para-00034">(200, 130)</para>
            <para id="para-00035">(250, 100)</para>
            <para id="para-00036">(170, 140)</para>
            <para id="para-00037">(300, 90)</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00038">Correct! <m:math display="inline"><m:mrow><m:mn>200</m:mn><m:mo stretchy="false">(</m:mo><m:mn>250</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>500</m:mn><m:mo stretchy="false">(</m:mo><m:mn>100</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>100</m:mn><m:mo>,</m:mo><m:mn>000</m:mn></m:mrow></m:math>, which is the maximum of the farmer’s
              budget.</para>
            <para id="para-00039">Try again. Revisit activities 2.13.2 and 2.13.3.</para>
            <para id="para-00040">One possible correct answer is <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>250</m:mn><m:mo>,</m:mo><m:mn>100</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_48553143-b120-4bb4-bfc3-e5c7c5aa7f53" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00041">For 5 - 7, use the passage below to answer the questions:</para>
            <para id="para-00042"><quote id="quote-00003"> Amira is ordering dried chili peppers and corn husks for her cooking
              class. Chili peppers cost $16.95 per pound and corn husks cost $6.49 per pound.</quote><quote id="quote-00004">
              Amira spends less than $50 on <m:math display="inline"><m:mrow><m:mi>d</m:mi></m:mrow></m:math> pounds of dried chili peppers and <m:math display="inline"><m:mrow><m:mi>h</m:mi></m:mrow></m:math> pounds of
              corn husks.</quote><quote id="quote-00005">Here is a graph that represents this situation. </quote></para>
            <para id="para-00043">Write an inequality that represents this situation.</para>
            <para id="para-00044">Multiple Choice:</para>
            <para id="para-00045"><m:math><m:mrow><m:mn>16.95</m:mn><m:mi>d</m:mi><m:mo>+</m:mo><m:mn>6.49</m:mn><m:mi>h</m:mi><m:mi>≥</m:mi><m:mn>50</m:mn></m:mrow></m:math></para><para id="para-00046"><m:math><m:mrow><m:mn>16.95</m:mn><m:mi>d</m:mi><m:mi>–</m:mi><m:mn>6.49</m:mn><m:mi>h</m:mi><m:mo>&lt;</m:mo><m:mn>50</m:mn></m:mrow></m:math></para><para id="para-00047"><m:math><m:mrow><m:mn>16.95</m:mn><m:mi>d</m:mi><m:mo>+</m:mo><m:mn>6.49</m:mn><m:mi>h</m:mi><m:mo>&lt;</m:mo><m:mn>50</m:mn></m:mrow></m:math></para><para id="para-00048"><m:math><m:mrow><m:mn>16.95</m:mn><m:mi>d</m:mi><m:mo>+</m:mo><m:mn>6.49</m:mn><m:mi>h</m:mi><m:mo>></m:mo><m:mn>50</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00005">
            <para id="para-00049">Correct! The cost of dried chili peppers, <m:math display="inline"><m:mrow><m:mn>16.95</m:mn><m:mi>d</m:mi></m:mrow></m:math>, plus the cost of corn husks,
              6.49h, must be less than $50.</para>
            <para id="para-00050">Try again. Revisit activities 2.13.2 and 2.13.3.</para>
            <para id="para-00051">The correct answer is <m:math display="inline"><m:mrow><m:mn>16.95</m:mn><m:mi>d</m:mi><m:mo>+</m:mo><m:mn>6.49</m:mn><m:mi>h</m:mi><m:mo>&lt;</m:mo><m:mn>50</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>

        <exercise id="_87928af0-7213-40e9-8c7f-ec5beaaeb638" class="multiple-choice">
          <problem id="prob-00006">
            <para id="para-00052">Can Amira purchase 2 pounds of dried chili peppers and 4 pounds of corn husks and
              spend less than $50? Be prepared to show your reasoning.</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00053">Correct! No. She would be spending <m:math display="inline"><m:mrow><m:mn>16.95</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>6.49</m:mn><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>, or $59.86.</para>
            <para id="para-00054">Try again. Revisit activities 2.13.2 and 2.13.3.</para>
            <para id="para-00055">The correct answer is No. She would be spending <m:math display="inline"><m:mrow><m:mn>16.95</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>6.49</m:mn><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>, or $59.86.</para>
          </solution>
        </exercise>

        <exercise id="_8fa1b4ce-573c-418c-8d99-7cf6deb543a9" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00056">Can Amira purchase 1.5 pounds of dried chili peppers and 3 pounds of corn husks
              and spend less than $50? Be prepared to show your reasoning.</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00057">Correct! Yes. She would be spending <m:math display="inline"><m:mrow><m:mn>16.95</m:mn><m:mo stretchy="false">(</m:mo><m:mn>1.5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>6.49</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>, or $44.90.</para>
            <para id="para-00058">Try again. Revisit activities 2.13.2 and 2.13.3.</para>
            <para id="para-00059">The correct answer is Yes. She would be spending <m:math display="inline"><m:mrow><m:mn>16.95</m:mn><m:mo stretchy="false">(</m:mo><m:mn>1.5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>6.49</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>, or
              $44.90.</para>
          </solution>
        </exercise>
 
        <exercise id="a9937132-55c8-4ecf-ac34-62aa3212d11e" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00060">For 8 - 10, use the passage below to answer the questions:</para>
            <para id="para-00061"><quote id="quote-00006">A beach store rents surfboards for $15 per hour and beach umbrellas for $10
              per hour. The store wants to make at least $200 per day on renting beach equipment.
              Let <m:math display="inline"><m:mrow><m:mi>s</m:mi></m:mrow></m:math> be the number of hours that a surfboard is rented and <m:math display="inline"><m:mrow><m:mi>u</m:mi></m:mrow></m:math> be the number of
              hours an umbrella is rented.</quote></para>
            <para id="para-00062">Which inequality represents this situation?</para>
            <para id="para-00063">Multiple Choice:</para>
            <para id="para-00064"><m:math><m:mrow><m:mn>15</m:mn><m:mi>s</m:mi><m:mi>–</m:mi><m:mn>10</m:mn><m:mi>u</m:mi><m:mi>≥</m:mi><m:mn>200</m:mn></m:mrow></m:math></para><para id="para-00065"><m:math><m:mrow><m:mn>15</m:mn><m:mi>s</m:mi><m:mo>+</m:mo><m:mn>10</m:mn><m:mi>u</m:mi><m:mi>≤</m:mi><m:mn>200</m:mn></m:mrow></m:math></para><para id="para-00066"><m:math><m:mrow><m:mn>15</m:mn><m:mi>s</m:mi><m:mo>+</m:mo><m:mn>10</m:mn><m:mi>u</m:mi><m:mi>≥</m:mi><m:mn>200</m:mn></m:mrow></m:math></para><para id="para-00067"><m:math><m:mrow><m:mn>15</m:mn><m:mi>s</m:mi><m:mo>+</m:mo><m:mn>10</m:mn><m:mi>u</m:mi><m:mo>&lt;</m:mo><m:mn>200</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00008">
            <para id="para-00068">Correct! The store makes <m:math display="inline"><m:mrow><m:mn>15</m:mn><m:mi>s</m:mi></m:mrow></m:math> dollars per hour renting surfboards and <m:math display="inline"><m:mrow><m:mn>10</m:mn><m:mi>u</m:mi></m:mrow></m:math>
              dollars renting umbrellas. The sum must be greater than or equal to $200.</para>
            <para id="para-00069">Try again. Revisit activities 2.13.2 and 2.13.3.</para>
            <para id="para-00070">The correct answer is <m:math display="inline"><m:mrow><m:mn>15</m:mn><m:mi>s</m:mi><m:mo>+</m:mo><m:mn>10</m:mn><m:mi>u</m:mi><m:mi>≥</m:mi><m:mn>200</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
 
        <exercise id="be434d8c-84fb-4e60-aeb5-f281d2c0b5fc" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00071">Can the beach store rent surfboards for 7 total hours and rent umbrellas for 9
              total hours and reach their goal of making $200? Be prepared to show your reasoning.</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00072">Correct! No.They would be making <m:math display="inline"><m:mrow><m:mn>15</m:mn><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>10</m:mn><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>, or $195.</para>
            <para id="para-00073">Try again. Revisit activities 2.13.2 and 2.13.3.</para>
            <para id="para-00074">The correct answer is No. They would be making <m:math display="inline"><m:mrow><m:mn>15</m:mn><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>10</m:mn><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>, or $195.</para>
          </solution>
        </exercise>
        <exercise id="_22ae87a4-6ce0-4a0f-92df-0a05c8da3e41" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00075">Can the beach store rent surfboards for 10 total hours and rent umbrellas for 4
              total hours and reach their goal of making $200? Be prepared to show your reasoning.</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00076">Correct! No.They would be making <m:math display="inline"><m:mrow><m:mn>15</m:mn><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>10</m:mn><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>, or <m:math display="inline"><m:mrow><m:mi>$</m:mi><m:mn>190</m:mn></m:mrow></m:math>.</para>
            <para id="para-00077">Try again. Revisit activities 2.13.2 and 2.13.3.</para>
            <para id="para-00078">The correct answer is No. They would be making <m:math display="inline"><m:mrow><m:mn>15</m:mn><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>10</m:mn><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math>, or $190.</para>
          </solution>
        </exercise>
 
        <exercise id="_112ec7bb-6ccc-4e5d-a667-9e7644f57e8d" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00079">Mariah has data in a table. Use desmos to plot the data and find a possible
              inequality in two variables that could be represented by this data. Which graph
              represents this inequality?</para>
            <table class="unnumbered os-raise-skinnytable unnumbered" id="table-00001">
              <tgroup cols="2">
                <thead>
                  <row>
                    <entry><emphasis><m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math></emphasis></entry>
                    <entry><emphasis><m:math><m:mrow><m:mi>y</m:mi></m:mrow></m:math></emphasis></entry>
                  </row>
                  </thead>
                  <tbody>
                  <row>
                    <entry>−4</entry>
                    <entry>7</entry>
                  </row>
                  <row>
                    <entry>−2</entry>
                    <entry>3</entry>
                  </row>
                  <row>
                    <entry>0</entry>
                    <entry>-1</entry>
                  </row>
                  <row>
                    <entry>2</entry>
                    <entry>-5</entry>
                  </row>
                </tbody>
              </tgroup>
            </table>

            <para id="para-00080">Multiple Choice:</para>
            <para id="para-00081"><m:math><m:mrow><m:mi>y</m:mi><m:mo>&lt;</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00082"><m:math><m:mrow><m:mi>y</m:mi><m:mo>≤</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00083"><m:math><m:mrow><m:mi>y</m:mi><m:mo>></m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para><para id="para-00084"><m:math><m:mrow><m:mi>y</m:mi><m:mo>≤</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para></problem>
          <solution id="sol-00011">
            <para id="para-00085">Correct! <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>></m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
            <para id="para-00086">Try again.</para>
            <para id="para-00087">The correct answer is <m:math display="inline"><m:mrow><m:mi>y</m:mi><m:mo>></m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
          </solution>
        </exercise>
    </section>
