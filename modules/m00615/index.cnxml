<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="9149bf77-e524-4b35-b3d0-910c46bb77ba" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--Q#11-->
  <exercise data-content-id="112ec7bb-6ccc-4e5d-a667-9e7644f57e8d" data-problem-type="multiplechoice" data-solution="\(Y &gt; -2x-4\)" data-solution-options="[&quot;\\(y &lt; -2x-4\\)&quot;, &quot;\\(y \\leq -2x-4\\)&quot;, &quot;\\(y &gt; -2x-4\\)&quot;, &quot;\\(y \\leq -2x-4\\)&quot;]">
    <problem>
      <para>Mariah has data in a table. Use desmos to plot the data and find a possible inequality in two variables that could be represented by this data. Which graph represents this inequality?</para>
      <table class="os-raise-skinnytable">
<thead>
         <row>
           <entry><emphasis>\(x\)</emphasis></entry><entry><emphasis>\(y\)</emphasis></entry></row>
  </thead>
       <tbody>
         <row>
           <entry>−4</entry>
           <entry>7</entry>
         </row>
         <row>
           <entry>−2</entry>
           <entry>3</entry>
         </row>
         <row>
           <entry>0</entry>
           <entry>-1</entry>
         </row>
         <row>
           <entry>2</entry>
           <entry>-5</entry>
         </row>
       </tbody>
     </table>
        
    </problem>
    <solution>
      <para>Correct! \(y &gt; -2x-4\)</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. </para>
    </div>
    </exercise>
