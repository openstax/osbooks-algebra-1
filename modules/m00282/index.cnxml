<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>1.13.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00282</md:content-id>
    <md:title>1.13.5: Practice</md:title>
    <md:uuid>1f6dceaa-354a-4351-b075-43582f7d7a66</md:uuid>
  </metadata>
  <content>
  <section><para><emphasis>Students will complete the following questions to practice the skills they have learned in this lesson.</emphasis></para>
<list class="os-raise-noindent" type="enumerated">
  <item> What is the slope of the line that goes through the points in the given table of values?</item>
</list>

<table class="os-raise-horizontaltable">
  <thead/>
    <tbody>
      <row>
        <entry scope="row" class="emphasis">\(x\)</entry>
        <entry>1</entry>
        <entry>2</entry>
        <entry>3</entry>
        <entry>4</entry>
      </row>
    
      <row>
          <entry scope="row" class="emphasis">\(y\)</entry>
        <entry>6</entry>
        <entry>11</entry>
        <entry>16</entry>
        <entry>21</entry>
      </row>
    </tbody>
  </table>
  
  <para><emphasis>Answer:</emphasis> 5</para>
  <list class="os-raise-noindent" start="2" type="enumerated">
    <item>In the equation, \(y = 4x + 2\), what is the value of the \(y\)-intercept?</item>
  </list>
<para><emphasis>Answer:</emphasis> 2</para>
<list class="os-raise-noindent" start="3" type="enumerated">
    <item>Identify the slope in the given graph.</item>
  </list>
  <para><figure><media alt="Insert Alt Text"><image mime-type="image/png" src="https://k12.openstax.org/contents/raise/resources/46cec782dce063f1e452bb13a0ec3ba26a8cffdd"/></media></figure></para>
  <para><emphasis>Answer:</emphasis> 3</para>
  <list class="os-raise-noindent" start="4" type="enumerated">
    <item>Which of the following is an equation for the table of values?</item>
  </list>
<table class="os-raise-horizontaltable">
    <thead>
    </thead>
    <tbody>
      <row>
        <entry scope="row" class="emphasis">\(x\)</entry>
        <entry>0</entry>
        <entry>1</entry>
        <entry>2</entry>
        <entry>3</entry>
      </row>
      <row>
        <entry scope="row" class="emphasis">\(y\)</entry>
        <entry>2</entry>
        <entry>7</entry>
        <entry>12</entry>
        <entry>17</entry>
      </row>
    </tbody>
  </table>
  
  <list>
    <item> \(y=2x+5 \)</item>
    <item>\(
      y=5x+2\) </item>
    <item>\(
      y=7x-2 \)</item>
    <item>\(
      y=5x-2 \)</item>
  </list>
<para><emphasis>Answer:</emphasis> \(y=5x+2\)</para>
  <list class="os-raise-noindent" start="5" type="enumerated">
    <item>For the equation \(y= -2x +3\), what is the value when \(x = 2\)?</item>
  </list>
<para><emphasis>Answer:</emphasis> -1</para>
  <list class="os-raise-noindent" start="6" type="enumerated">
    <item>Jonah started the month with $40 and earned $15 each week walking dogs for neighbors. How much does he have after \(w\)  weeks?</item>
  </list>
  <list>
    <item> \(y=40w \)</item>
    <item>\(
      y=40w+15 \)</item>
    <item>\(
      y=15w +40 \)</item>
    <item> \(y=40(15w) \)</item>
  </list>
<para><emphasis>Answer:</emphasis> \(y=15w +40\)</para>
  <list class="os-raise-noindent" start="7" type="enumerated">
    <item>Write the slope of the given table.</item>
  </list>
  <table class="os-raise-horizontaltable">
    <thead>
    </thead>
    <tbody>
      <row>
        <entry scope="row" class="emphasis">\(x\)</entry>
        <entry>0</entry>
        <entry>2</entry>
        <entry>4</entry>
      </row>
      <row>
        <entry scope="row" class="emphasis">\(y\)</entry>
        <entry>5</entry>
        <entry>11</entry>
        <entry>17</entry>
      </row>
    </tbody>
  </table>
  
  <para><emphasis>Answer:</emphasis> 3</para>
  <list class="os-raise-noindent" start="8" type="enumerated">
    <item>For the equation \(g=\frac{w+3}{2}\), what is the value of \(g\) when \(w=7\)?</item>
  </list>
  <para><emphasis>Answer:</emphasis> 5</para>
  <list class="os-raise-noindent" start="9" type="enumerated">
    <item>Identify the \(y\)-intercept of the given table.</item>
  </list>
  <table class="os-raise-horizontaltable">
    <thead>
    </thead>
    <tbody>
      <row>
        <entry scope="row" class="emphasis">\(x\)</entry>
        <entry>1</entry>
        <entry>2</entry>
        <entry>3</entry>
      </row>
      <row>
        <entry scope="row" class="emphasis">\(y\)</entry>
        <entry>3</entry>
        <entry>5</entry>
        <entry>7</entry>
      </row>
    </tbody>
  </table>
  
<para><emphasis>Answer:</emphasis> 1</para>
  <list class="os-raise-noindent" start="10" type="enumerated">
    <item>Identify the slope of the line between \((3, 6)\) and \((-2, 7)\).</item>
  </list>
<para><emphasis>Answer:</emphasis> \(-\frac15\)</para>
  </section>
</content>
</document>
