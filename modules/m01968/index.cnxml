              <m:mrow>
                <m:mi>y</m:mi>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>50</m:mn>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>?</para>
          <para id="para-00033">Write down your answer, then select the <emphasis>solution</emphasis>
            button to compare your work.</para>

        </problem>
        <solution id="sol-00006">
          <para id="para-00034">Compare your answer:</para>

          <para id="para-00035"><m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>,<m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>50</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></solution>
      </exercise>
      <section id="sect-00004">
        <exercise id="_4d51c3c1-2de5-4dcf-af08-be98d21c5303" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00036">What is the <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                </m:mrow>
              </m:math>-coordinate of the
              vertex for the equation <m:math display="inline">
                <m:mrow>
                  <m:mi>y</m:mi>
                  <m:mo>=</m:mo>
                  <m:mo>−</m:mo>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>+</m:mo>
                  <m:mn>50</m:mn>
                  <m:mi>x</m:mi>
                </m:mrow>
              </m:math>?</para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00037">Correct! 25</para>
            <para id="para-00038">The correct answer is 25.</para>
          </solution>
        </exercise>
      </section>
      <list class="os-raise-noindent" list-type="enumerated" id="list-00004">
        <item>Find the <m:math display="inline">
