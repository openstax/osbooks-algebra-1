      <list class="os-raise-noindent" list-type="enumerated" id="list-00001">
        <item>Find the <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
            </m:mrow>
          </m:math>-intercepts and the <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
            </m:mrow>
          </m:math>-coordinate of the vertex for
          the equation <m:math display="inline">
            <m:mrow>
              <m:mi>y</m:mi>
              <m:mo>=</m:mo>
              <m:msup>
                <m:mi>x</m:mi>
                <m:mn>2</m:mn>
              </m:msup>
              <m:mo>+</m:mo>
              <m:mn>6</m:mn>
              <m:mi>x</m:mi>
            </m:mrow>
          </m:math>.</item>
      </list>
      <exercise id="exer-00002">
        <problem id="prob-00002">

          <para id="para-00018">What are the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts for the
            equation <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mo>=</m:mo>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>6</m:mn>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>?</para>
          <para id="para-00019">Write down your answer, then select the <emphasis>solution</emphasis>
            button to compare your work.</para>

        </problem>
        <solution id="sol-00002">
          <para id="para-00020">Compare your answer:</para>

          <para id="para-00021"><m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>,<m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>−</m:mo>
                <m:mn>6</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></solution>
      </exercise>

        <exercise id="_413dea93-428c-49a9-85b7-98afca31ae02" class="multiple-choice">
          <problem id="prob-00003">
            <para id="para-00022">What is the <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                </m:mrow>
              </m:math>-coordinate of the
              vertex for the equation <m:math display="inline">
                <m:mrow>
                  <m:mi>y</m:mi>
                  <m:mo>=</m:mo>
                  <m:msup>
                    <m:mi>x</m:mi>
                    <m:mn>2</m:mn>
                  </m:msup>
                  <m:mo>+</m:mo>
                  <m:mn>6</m:mn>
                  <m:mi>x</m:mi>
                </m:mrow>
              </m:math>?</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00023">Correct! -3</para>
            <para id="para-00024">The correct answer is -3.</para>
          </solution>
        </exercise>
 
      <list class="os-raise-noindent" list-type="enumerated" id="list-00002">
        <item>Find the <m:math display="inline">
            <m:mrow>
              <m:mi>x</m:mi>
