            </m:mrow>
          </m:math>.</item>
      </list>
      <exercise id="exer-00005">
        <problem id="prob-00008">

          <para id="para-00039">Find the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>-intercepts for the
            equation <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:msup>
                  <m:mi>x</m:mi>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>−</m:mo>
                <m:mn>36</m:mn>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math>.</para>
          <para id="para-00040">Write down your answer, then select the <emphasis>solution</emphasis>
            button to compare your work.</para>

        </problem>
