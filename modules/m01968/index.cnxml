              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mn>0</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math>,<m:math display="inline">
              <m:mrow>
                <m:mo stretchy="false">(</m:mo>
                <m:mo>−</m:mo>
                <m:mn>36</m:mn>
                <m:mo>,</m:mo>
                <m:mn>0</m:mn>
                <m:mo stretchy="false">)</m:mo>
              </m:mrow>
            </m:math></para></solution>
      </exercise>
      <section id="sect-00005">
        <exercise id="_1ed3a45d-fc40-408f-8981-6afb3ff574a4" class="multiple-choice">
          <problem id="prob-00009">
            <para id="para-00043">What is the <m:math display="inline">
                <m:mrow>
                  <m:mi>x</m:mi>
                </m:mrow>
              </m:math>-coordinate of the
              vertex for the equation <m:math display="inline">
                <m:mrow>
                  <m:mi>y</m:mi>
