    <problem>
      <para> What is the \(x\)-coordinate of the vertex for the equation \(y=x^2+6x\)? </para>
        <para>Enter your answer here: </para>
    </problem>
    <solution>
      <para>Correct! -3</para>
    </solution>
    </exercise>
