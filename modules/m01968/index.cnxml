                <para id="para-00015"><m:math>
                    <m:mrow>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mo>−</m:mo>
                      <m:msup>
                        <m:mi>x</m:mi>
                        <m:mn>2</m:mn>
                      </m:msup>
                      <m:mo>−</m:mo>
                      <m:mn>36</m:mn>
                      <m:mi>x</m:mi>
