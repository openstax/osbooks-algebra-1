                      <m:mo>=</m:mo>
                      <m:msup>
                        <m:mi>x</m:mi>
                        <m:mn>2</m:mn>
                      </m:msup>
                      <m:mo>−</m:mo>
                      <m:mn>10</m:mn>
                      <m:mi>x</m:mi>
                    </m:mrow>
                  </m:math></para></entry>
              <entry>
                <para id="para-00010">3a. _____</para>
              </entry>
              <entry>
                <para id="para-00011">3b. _____</para>
              </entry>
            </row>
