  <content>
  <note class="self-check"><para>Which of the following equations represents the values in the table?</para>
<table class="os-raise-horizontaltable">
  <tgroup cols="5"><tbody><row>
      <entry><emphasis>\(x\)</emphasis></entry><entry>
        0
      </entry>
      <entry>
        1
      </entry>
      <entry>
       2
      </entry>
      <entry>
        3
      </entry>
    </row>
    <row>
        <entry><emphasis>\(y\)</emphasis></entry><entry>
       1
      </entry>
      <entry>
        3
      </entry>
      <entry>
        9
      </entry>
      <entry>
        27
      </entry>
    </row>
  </tbody></tgroup></table>
</note>
</content>
