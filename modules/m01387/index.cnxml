  <content>
  <section><para>Which of the following equations represents the values in the table?</para>
<table class="os-raise-horizontaltable">
  <thead/>
  <tbody>
    <row>
      <entry scope="row" class="emphasis">\(x\)</entry>
      <entry>
        0
      </entry>
      <entry>
        1
      </entry>
      <entry>
       2
      </entry>
      <entry>
        3
      </entry>
    </row>
    <row>
        <entry scope="row" class="emphasis">\(y\)</entry>
      <entry>
       1
      </entry>
      <entry>
        3
      </entry>
      <entry>
        9
      </entry>
      <entry>
        27
      </entry>
    </row>
  </tbody>
</table>
</section>
</content>
</document>
