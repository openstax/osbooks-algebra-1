<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.3.1: Solving Equations with Fractions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02368</md:content-id>
    <md:title>9.3.1: Solving Equations with Fractions</md:title>
    <md:uuid>090d6492-9f97-4328-9a37-23f46ac59018</md:uuid>
  </metadata>
  <content>
  <section><example><exercise>
  <problem>
    
    <para>\(x+x=\frac14\)</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Solution:</para>
  <para>\(x=\frac18\)</para>
</solution></exercise>
</example><!--Interaction End -->


<!-- Q#2 -->
<example><exercise>
  <problem>
    
    <para>\((\frac{3}{2})^2=x\)</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Solution:</para>
  <para>\(x=\frac94\)</para>
</solution></exercise>
</example><!--Interaction End -->


<!-- Q#3 -->
<example><exercise>
  <problem>
    
    <para>\(\frac{3}{5}+x=\frac95\)</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Solution:</para>
  <para>\(x=\frac65\)</para>
</solution></exercise>
</example><!--Interaction End -->


<!-- Q#4 -->
<example><exercise>
  <problem>
    
    <para>\(\frac{1}{12}+x=\frac14\)</para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Solution:</para>
  <para>\(x=\frac16\)</para>
</solution></exercise>
</example><!--Interaction End -->

</section>
</content>
</document>
