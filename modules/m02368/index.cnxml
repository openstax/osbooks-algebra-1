<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.3.1: Solving Equations with Fractions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02368</md:content-id>
    <md:title>9.3.1: Solving Equations with Fractions</md:title>
    <md:uuid>afaad511-61df-4d36-950f-fce59043a715</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00001"><m:math><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para><para id="para-00002">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Solution:</para>
          <para id="para-00004"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!-- Q#2 -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00005"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>2</m:mn></m:mrow></m:mfrac><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mi>x</m:mi></m:mrow></m:math></para><para id="para-00006">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00007">Solution:</para>
          <para id="para-00008"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>9</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!-- Q#3 -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00009"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>5</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>9</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para><para id="para-00010">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00011">Solution:</para>
          <para id="para-00012"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>6</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
      <!-- Q#4 -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00013"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para><para id="para-00014">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00015">Solution:</para>
          <para id="para-00016"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math></para></solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>