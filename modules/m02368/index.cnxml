<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>9.3.1: Solving Equations with Fractions</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02368</md:content-id>
    <md:title>9.3.1: Solving Equations with Fractions</md:title>
    <md:uuid>afaad511-61df-4d36-950f-fce59043a715</md:uuid>
  </metadata>
  <content>
    <section id="sect-00001">
      <exercise id="exer-00001">
        <problem id="prob-00001">
          <para id="para-00001">\(x+x=\frac14\)</para>
          <para id="para-00002">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00003">Solution:</para>
          <para id="para-00004">\(x=\frac18\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!-- Q#2 -->
      <exercise id="exer-00002">
        <problem id="prob-00002">
          <para id="para-00005">\((\frac{3}{2})^2=x\)</para>
          <para id="para-00006">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00007">Solution:</para>
          <para id="para-00008">\(x=\frac94\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!-- Q#3 -->
      <exercise id="exer-00003">
        <problem id="prob-00003">
          <para id="para-00009">\(\frac{3}{5}+x=\frac95\)</para>
          <para id="para-00010">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00011">Solution:</para>
          <para id="para-00012">\(x=\frac65\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
      <!-- Q#4 -->
      <exercise id="exer-00004">
        <problem id="prob-00004">
          <para id="para-00013">\(\frac{1}{12}+x=\frac14\)</para>
          <para id="para-00014">Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00015">Solution:</para>
          <para id="para-00016">\(x=\frac16\)</para>
        </solution>
      </exercise>
      <!--Interaction End -->
    </section>
  </content>
</document>