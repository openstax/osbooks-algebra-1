  <content>
  <section><para>The table for function \(f\) is below. What is the vertex of the graph of \(f\)?</para>
<table class="os-raise-horizontaltable">
  <thead>
  </thead>
  <tbody>
    <row>
      <entry scope="row" class="emphasis"> \(x\) </entry>
      <entry> -3 </entry>
      <entry> -2 </entry>
      <entry> -1 </entry>
      <entry> 0 </entry>
      <entry> 1 </entry>
      <entry> 2 </entry>
    </row>
    <row>
      <entry scope="row" class="emphasis"> \(f(x)\) </entry>
      <entry> 0 </entry>
      <entry> -1 </entry>
      <entry> -3 </entry>
      <entry> -1 </entry>
      <entry> 0 </entry>
      <entry> 2 </entry>
    </row>
  </tbody>
</table>


</section>
</content>
</document>
