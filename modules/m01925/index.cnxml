  <content>
  <section><para>The table for function \(f\) is below. What is the vertex of the graph of \(f\)?</para>
<table class="os-raise-horizontaltable">
  <thead>
  </thead>
  <tbody>
    <row>
      <entry><emphasis> \(x\) </emphasis></entry><entry> -3 </entry>
      <entry> -2 </entry>
      <entry> -1 </entry>
      <entry> 0 </entry>
      <entry> 1 </entry>
      <entry> 2 </entry>
    </row>
    <row>
      <entry><emphasis> \(f(x)\) </emphasis></entry><entry> 0 </entry>
      <entry> -1 </entry>
      <entry> -3 </entry>
      <entry> -1 </entry>
      <entry> 0 </entry>
      <entry> 2 </entry>
    </row>
  </tbody>
</table>


</section>
</content>
