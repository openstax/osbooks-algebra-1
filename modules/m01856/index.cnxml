  <exercise data-content-id="92dbe1fe-ff71-442a-857a-d103d55e2fe0" data-problem-type="multiplechoice" data-retry-limit="2" data-solution="\(p(400-8p)\)" data-solution-options="[ &quot;\\(p(8p-400)\\)&quot;, &quot;\\(400-8p\\)&quot;, &quot;\\(p(400-8p)\\)&quot;, &quot;\\(392p\\)&quot;]">
    <problem>
      <para> When the price is \(p\) per ticket, what is the revenue in dollars?</para>
        </problem>
