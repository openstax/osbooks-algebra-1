  <content>
    <section id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <section class="check-understanding" id="sect-00002">
        <exercise id="d6ecaf8b-a27d-47f2-950b-bf6cbc2c53a0" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00002">Use the following scenario to answer questions 1 – 5.</para>
            <para id="para-00003">
              <quote id="quote-00001">Based on past musical productions, a theater predicts selling <m:math display="inline"><m:mrow><m:mn>400</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mi>p</m:mi></m:mrow></m:math> tickets when each ticket is sold at <m:math display="inline"><m:mrow><m:mi>p</m:mi></m:mrow></m:math> dollars.</quote>
          </para>
            <para id="para-00004">Answer questions a–g to complete the middle column in the table to find out how many tickets the theater expects to sell and what revenues it expects to receive at the given ticket prices.</para>
            <table class="os-raise-wideequaltable" id="table-00001">
              <tgroup cols="3"><tbody><row>
                  <entry>
                   <emphasis>Ticket price (dollars)</emphasis>
                  </entry>
                  <entry>
                   <emphasis>Number of tickets sold</emphasis>
                  </entry>
                  <entry>
                   <emphasis>Revenue (dollars)</emphasis>
                  </entry>
                </row>
              <row>
                  <entry>
                    <para id="para-00005"><m:math><m:mrow><m:mn>5</m:mn></m:mrow></m:math></para>
                  </entry>
                  <entry>
                    <para id="para-00006"><m:math><m:mrow><m:mn>360</m:mn></m:mrow></m:math></para>
                  </entry>
                  <entry>
                    <para id="para-00007"><m:math><m:mrow><m:mn>1800</m:mn></m:mrow></m:math></para>
                  </entry>
                </row>
                <row>
                  <entry>
                    <para id="para-00008"><m:math><m:mrow><m:mn>10</m:mn></m:mrow></m:math></para>
                  </entry>
                  <entry>
                    <para id="para-00009">a. _____</para>
                  </entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry>
                    <para id="para-00010"><m:math><m:mrow><m:mn>15</m:mn></m:mrow></m:math></para>
                  </entry>
                  <entry>
                    <para id="para-00011">b. _____</para>
                  </entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry>
                    <para id="para-00012"><m:math><m:mrow><m:mn>20</m:mn></m:mrow></m:math></para>
                  </entry>
                  <entry>
                    <para id="para-00013">c. _____</para>
                  </entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry>
                    <para id="para-00014"><m:math><m:mrow><m:mn>30</m:mn></m:mrow></m:math></para>
                  </entry>
                  <entry>
                    <para id="para-00015">d. _____</para>
                  </entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry>
                    <para id="para-00016"><m:math><m:mrow><m:mn>45</m:mn></m:mrow></m:math></para>
                  </entry>
                  <entry>
                    <para id="para-00017">e. _____</para>
                  </entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry>
                    <para id="para-00018"><m:math><m:mrow><m:mn>50</m:mn></m:mrow></m:math></para>
                  </entry>
                  <entry>
                    <para id="para-00019">f. _____</para>
                  </entry>
                  <entry> </entry>
                </row>
                <row>
                  <entry>
                    <para id="para-00020"><m:math><m:mrow><m:mi>p</m:mi></m:mrow></m:math></para>
                  </entry>
                  <entry>
                    <para id="para-00021">g. _____</para>
                  </entry>
                  <entry> </entry>
                </row>
              </tbody></tgroup></table>
            <para id="para-00022">When the price is <m:math display="inline"><m:mrow><m:mi>$</m:mi><m:mn>10</m:mn></m:mrow></m:math> per ticket, what is the number of tickets sold?</para>
            
          </problem>
          <solution id="sol-00001">
            <para id="para-00023">Correct! There are 320 tickets sold when the price is $10 per ticket.</para>
            <para id="para-00024">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00025">The correct answer is 320. There are 320 tickets sold when the price is $10 per ticket.</para>
          </solution>
        </exercise>
        <exercise id="_217116ac-3762-41b7-adab-fb18faba6211" class="multiple-choice">
          <problem id="prob-00002">
            
            <para id="para-00026">When the price is <m:math display="inline"><m:mrow><m:mi>$</m:mi><m:mn>15</m:mn></m:mrow></m:math> per ticket, what is the number of tickets sold?</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00027">Correct! There are 280 tickets sold when the price is $15 per ticket.</para>
            <para id="para-00028">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00029">The correct answer is 280. There are 280 tickets sold when the price is $15 per ticket.</para>
          </solution>
        </exercise>
        <exercise id="cdaaa354-2c5d-4571-9d04-2c03bdf78ebc" class="multiple-choice">
          <problem id="prob-00003">
            
            <para id="para-00030">When the price is <m:math display="inline"><m:mrow><m:mi>$</m:mi><m:mn>20</m:mn></m:mrow></m:math> per ticket, what is the number of tickets sold?</para>
          </problem>
          <solution id="sol-00003">
            <para id="para-00031">Correct! There are 240 tickets sold when the price is $20 per ticket.</para>
            <para id="para-00032">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00033">The correct answer is 240. There are 240 tickets sold when the price is $20 per ticket.</para>
          </solution>
        </exercise>
        <exercise id="d76c2e8e-2f43-4d4d-a38a-c00ec61a27ea" class="multiple-choice">
          <problem id="prob-00004">
            
            <para id="para-00034">When the price is <m:math display="inline"><m:mrow><m:mi>$</m:mi><m:mn>30</m:mn></m:mrow></m:math> per ticket, what is the number of tickets sold?</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00035">Correct! There are 160 tickets sold when the price is $30 per ticket.</para>
            <para id="para-00036">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00037">The correct answer is 160. There are 160 tickets sold when the price is $30 per ticket.</para>
          </solution>
        </exercise>
        <exercise id="_05774484-d917-4ee9-ab27-2cc535e5c222" class="multiple-choice">
          <problem id="prob-00005">
            
            <para id="para-00038">When the price is <m:math display="inline"><m:mrow><m:mi>$</m:mi><m:mn>45</m:mn></m:mrow></m:math> per ticket, what is the number of tickets sold?</para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00039">Correct! There are 40 tickets sold when the price is $45 per ticket.</para>
            <para id="para-00040">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00041">The correct answer is 40. There are 40 tickets sold when the price is $45 per ticket.</para>
          </solution>
        </exercise>
        <exercise id="_0d296047-b708-4c1c-8209-485a90347764" class="multiple-choice">
          <problem id="prob-00006">
            
            <para id="para-00042">When the price is <m:math display="inline"><m:mrow><m:mi>$</m:mi><m:mn>50</m:mn></m:mrow></m:math> per ticket, what is the number of tickets sold?</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00043">Correct! There are 0 tickets sold when the price is $50 per ticket.</para>
            <para id="para-00044">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00045">The correct answer is 0. There are 0 tickets sold when the price is $50 per ticket.</para>
          </solution>
        </exercise>
        <exercise id="_78e21919-1cfc-40c4-a162-1501451e63af" class="multiple-choice">
          <problem id="prob-00007">
            <para id="para-00046">When the price is <m:math display="inline"><m:mrow><m:mi>p</m:mi></m:mrow></m:math> per ticket, what is the number of tickets sold?</para>
            <para id="para-00047">Multiple Choice:</para>
            <para id="para-00048"><m:math><m:mrow><m:mn>392</m:mn><m:mi>p</m:mi></m:mrow></m:math></para>
            <para id="para-00049"><m:math><m:mrow><m:mn>400</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mi>p</m:mi></m:mrow></m:math></para>
            <para id="para-00050"><m:math><m:mrow><m:mi>p</m:mi><m:mo stretchy="false">(</m:mo><m:mn>400</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mi>p</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00051"><m:math><m:mrow><m:mi>p</m:mi><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mi>p</m:mi><m:mo>−</m:mo><m:mn>400</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00007">
            <para id="para-00052">Correct! <m:math display="inline"><m:mrow><m:mn>400</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mi>p</m:mi></m:mrow></m:math></para>
            <para id="para-00053">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00054">The correct answer is: <m:math display="inline"><m:mrow><m:mn>400</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mi>p</m:mi></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_211a0bc1-f3d7-46be-ba7b-7459987ab296" class="multiple-choice">
          <problem id="prob-00008">
            
            <para id="para-00055">Answer questions a-g to complete the right column in the table to find out what revenues the theater expects to receive at the given ticket prices.</para>
            <table class="os-raise-wideequaltable" id="table-00002">
              <tgroup cols="3"><tbody><row>
                  <entry>
                   <emphasis>Ticket price (dollars)</emphasis>
                  </entry>
                  <entry>
                   <emphasis>Number of tickets sold</emphasis>
                  </entry>
                  <entry>
                   <emphasis>Revenue (dollars)</emphasis>
                  </entry>
                </row>
              <row>
                  <entry>
                    <para id="para-00056"><m:math><m:mrow><m:mn>5</m:mn></m:mrow></m:math></para>
                  </entry>
                  <entry>
                    <para id="para-00057"><m:math><m:mrow><m:mn>360</m:mn></m:mrow></m:math></para>
                  </entry>
                  <entry>
                    <para id="para-00058"><m:math><m:mrow><m:mn>1800</m:mn></m:mrow></m:math></para>
                  </entry>
                </row>
                <row>
                  <entry>
                    <para id="para-00059"><m:math><m:mrow><m:mn>10</m:mn></m:mrow></m:math></para>
                  </entry>
                  <entry> </entry>
                  <entry>
                    <para id="para-00060">a. _____</para>
                  </entry>
                </row>
                <row>
                  <entry>
                    <para id="para-00061"><m:math><m:mrow><m:mn>15</m:mn></m:mrow></m:math></para>
                  </entry>
                  <entry> </entry>
                  <entry>
                    <para id="para-00062">b. _____</para>
                  </entry>
                </row>
                <row>
                  <entry>
                    <para id="para-00063"><m:math><m:mrow><m:mn>20</m:mn></m:mrow></m:math></para>
                  </entry>
                  <entry> </entry>
                  <entry>
                    <para id="para-00064">c. _____</para>
                  </entry>
                </row>
                <row>
                  <entry>
                    <para id="para-00065"><m:math><m:mrow><m:mn>30</m:mn></m:mrow></m:math></para>
                  </entry>
                  <entry> </entry>
                  <entry>
                    <para id="para-00066">d. _____</para>
                  </entry>
                </row>
                <row>
                  <entry>
                    <para id="para-00067"><m:math><m:mrow><m:mn>45</m:mn></m:mrow></m:math></para>
                  </entry>
                  <entry> </entry>
                  <entry>
                    <para id="para-00068">e. _____</para>
                  </entry>
                </row>
                <row>
                  <entry>
                    <para id="para-00069"><m:math><m:mrow><m:mn>50</m:mn></m:mrow></m:math></para>
                  </entry>
                  <entry> </entry>
                  <entry>
                    <para id="para-00070">f. _____</para>
                  </entry>
                </row>
                <row>
                  <entry>
                    <para id="para-00071"><m:math><m:mrow><m:mi>p</m:mi></m:mrow></m:math></para>
                  </entry>
                  <entry> </entry>
                  <entry>
                    <para id="para-00072">g. _____</para>
                  </entry>
                </row>
              </tbody></tgroup></table>
            <para id="para-00073">When the price is <m:math display="inline"><m:mrow><m:mi>$</m:mi><m:mn>10</m:mn></m:mrow></m:math> per ticket, what is the revenue in dollars?</para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00074">Correct! The revenue is $3,200 when the price is $10 per ticket.</para>
            <para id="para-00075">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00076">The correct answer is 3,200. The revenue is $3,200 when the price is $10 per ticket.</para>
          </solution>
        </exercise>
        <exercise id="d9e377f9-6f95-44c7-96c0-f454c98ba6f1" class="multiple-choice">
          <problem id="prob-00009">
            
            <para id="para-00077">When the price is <m:math display="inline"><m:mrow><m:mi>$</m:mi><m:mn>15</m:mn></m:mrow></m:math> per ticket, what is the revenue in dollars?</para>
          </problem>
          <solution id="sol-00009">
            <para id="para-00078">Correct! The revenue is $4,200 when the price is $15 per ticket.</para>
            <para id="para-00079">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00080">The correct answer is 4,200. The revenue is $4,200 when the price is $15 per ticket.</para>
          </solution>
        </exercise>
        <exercise id="_598a1efc-a029-4f43-b294-826ffd40dd2c" class="multiple-choice">
          <problem id="prob-00010">
            
            <para id="para-00081">When the price is <m:math display="inline"><m:mrow><m:mi>$</m:mi><m:mn>20</m:mn></m:mrow></m:math> per ticket, what is the revenue in dollars?</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00082">Correct! The revenue is $4,800 when the price is $20 per ticket.</para>
            <para id="para-00083">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00084">The correct answer is 4,800. The revenue is $4,800 when the price is $20 per ticket.</para>
          </solution>
        </exercise>
        <exercise id="_90359346-9588-43d8-8b5a-190f9f9e8a78" class="multiple-choice">
          <problem id="prob-00011">
            
            <para id="para-00085">When the price is <m:math display="inline"><m:mrow><m:mi>$</m:mi><m:mn>30</m:mn></m:mrow></m:math> per ticket, what is the revenue in dollars?</para>
          </problem>
          <solution id="sol-00011">
            <para id="para-00086">Correct! The revenue is $4,800 when the price is $30 per ticket.</para>
            <para id="para-00087">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00088">The correct answer is 4,800. The revenue is $4,800 when the price is $30 per ticket.</para>
          </solution>
        </exercise>
        <exercise id="_7cebc598-4f73-443a-8450-6d3665b575dd" class="multiple-choice">
          <problem id="prob-00012">
            
            <para id="para-00089">When the price is <m:math display="inline"><m:mrow><m:mi>$</m:mi><m:mn>45</m:mn></m:mrow></m:math> per ticket, what is the revenue in dollars?</para>
          </problem>
          <solution id="sol-00012">
            <para id="para-00090">Correct! The revenue is $1,800 when the price is $45 per ticket.</para>
            <para id="para-00091">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00092">The correct answer is 1,800. The revenue is $1,800 when the price is $45 per ticket.</para>
          </solution>
        </exercise>
        <exercise id="_962bc63e-e73d-47cd-9ec4-919394e898b7" class="multiple-choice">
          <problem id="prob-00013">
            
            <para id="para-00093">When the price is <m:math display="inline"><m:mrow><m:mi>$</m:mi><m:mn>50</m:mn></m:mrow></m:math> per ticket, what is the revenue in dollars?</para>
          </problem>
          <solution id="sol-00013">
            <para id="para-00094">Correct! The revenue is zero when the price is $50 per ticket.</para>
            <para id="para-00095">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00096">The correct answer is 0. The revenue is zero when the price is $50 per ticket.</para>
          </solution>
        </exercise>
        <exercise id="_92dbe1fe-ff71-442a-857a-d103d55e2fe0" class="multiple-choice">
          <problem id="prob-00014">
            <para id="para-00097">When the price is <m:math display="inline"><m:mrow><m:mi>p</m:mi></m:mrow></m:math> per ticket, what is the revenue in dollars?</para>
            <para id="para-00098">Multiple Choice:</para>
            <para id="para-00099"><m:math><m:mrow><m:mi>p</m:mi><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mi>p</m:mi><m:mo>−</m:mo><m:mn>400</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00100"><m:math><m:mrow><m:mn>400</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mi>p</m:mi></m:mrow></m:math></para>
            <para id="para-00101"><m:math><m:mrow><m:mi>p</m:mi><m:mo stretchy="false">(</m:mo><m:mn>400</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mi>p</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00102"><m:math><m:mrow><m:mn>392</m:mn><m:mi>p</m:mi></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00014">
            <para id="para-00103">Correct! <m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mo stretchy="false">(</m:mo><m:mn>400</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mi>p</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00104">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00105">The correct answer is: <m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mo stretchy="false">(</m:mo><m:mn>400</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mi>p</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_07c98345-4d1e-48fb-a140-5262be95feb6" class="multiple-choice">
          <problem id="prob-00015">
            
            <para id="para-00106">For which ticket price, listed in the table, will the theater earn no revenue?</para>
          </problem>
          <solution id="sol-00015">
            <para id="para-00107">Correct! The revenue is zero when the ticket price is $50.</para>
            <para id="para-00108">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00109">The correct answer is 50. The revenue is zero when the ticket price is $50.</para>
          </solution>
        </exercise>
        <exercise id="_0fb440fa-4233-44d8-a119-a040725ecaa2" class="multiple-choice">
          <problem id="prob-00016">
            
            <para id="para-00110">Calculate the lowest price of a ticket that the theater should sell the tickets for if it must earn at least <m:math display="inline"><m:mrow><m:mi>$</m:mi><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>200</m:mn></m:mrow></m:math> in revenue to break even (to not lose money) on the musical production. (The calculated value may not be listed in the table.)</para>
          </problem>
          <solution id="sol-00016">
            <para id="para-00111">Correct! The lowest price the theater should charge to at least make $3,200 and break even is $10 per ticket.</para>
            <para id="para-00112">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00113">The correct answer is 10. The lowest price the theater should charge to at least make $3,200 and break even is $10 per ticket.</para>
          </solution>
        </exercise>
        <exercise id="fa2f0344-3f29-441e-b9f9-d90c4cda33a2" class="multiple-choice">
          <problem id="prob-00017">
            
            <para id="para-00114">Calculate the highest price of a ticket that the theater should sell the tickets for if it must earn at least <m:math display="inline"><m:mrow><m:mi>$</m:mi><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>200</m:mn></m:mrow></m:math> in revenue to break even (to not lose money) on the musical production. (The calculated value may not be listed in the table.)</para>
          </problem>
          <solution id="sol-00017">
            <para id="para-00115">Correct! The highest price the theater should charge to make at least $3,200 and break even is $40 per ticket. Although not shown in the table, we can calculate that when <m:math display="inline"><m:mrow><m:mi>p</m:mi></m:mrow></m:math> is $40, the expected revenue is <m:math display="inline"><m:mrow><m:mn>40</m:mn><m:mo stretchy="false">(</m:mo><m:mn>400</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mo stretchy="false">(</m:mo><m:mn>40</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">)</m:mo></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mn>40</m:mn><m:mi>·</m:mi><m:mn>80</m:mn></m:mrow></m:math>, which is $3,200.</para>
            <para id="para-00116">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00117">The correct answer is 40. The highest price the theater should charge to at least make $3,200 and break even is $40 per ticket. Although not shown in the table, we can calculate that when <m:math display="inline"><m:mrow><m:mi>p</m:mi></m:mrow></m:math> is $40, the expected revenue is <m:math display="inline"><m:mrow><m:mn>40</m:mn><m:mo stretchy="false">(</m:mo><m:mn>400</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mo stretchy="false">(</m:mo><m:mn>40</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> or <m:math display="inline"><m:mrow><m:mn>40</m:mn><m:mi>·</m:mi><m:mn>80</m:mn></m:mrow></m:math>, which is $3,200.</para>
          </solution>
        </exercise>
        <exercise id="_7617ff65-c7d1-4155-a872-5ae056ca9c63" class="multiple-choice">
          <problem id="prob-00018">
            <para id="para-00118">A company sells running shoes. If the price of a pair of shoes in dollars is <m:math display="inline"><m:mrow><m:mi>p</m:mi></m:mrow></m:math>, the company estimates that it will sell <m:math display="inline"><m:mrow><m:mn>50</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mo>−</m:mo><m:mn>400</m:mn><m:mi>p</m:mi></m:mrow></m:math> pairs of shoes.
          
          Which expression represents the revenue in dollars from selling running shoes if a pair of shoes is priced at <m:math display="inline"><m:mrow><m:mi>p</m:mi></m:mrow></m:math> dollars?
      </para>
            <para id="para-00119">Multiple Choice:</para>
            <para id="para-00120"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>50</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mo>−</m:mo><m:mn>400</m:mn><m:mi>p</m:mi><m:mo stretchy="false">)</m:mo><m:mi>·</m:mi><m:mi>p</m:mi></m:mrow></m:math></para>
            <para id="para-00121"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>50</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mi>p</m:mi><m:mo>−</m:mo><m:mn>400</m:mn><m:mo stretchy="false">)</m:mo><m:mi>·</m:mi><m:mi>p</m:mi></m:mrow></m:math></para>
            <para id="para-00122"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>50</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mi>p</m:mi><m:mo>−</m:mo><m:mn>400</m:mn><m:mi>p</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
            <para id="para-00123"><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>49</m:mn><m:mo>,</m:mo><m:mn>600</m:mn><m:mi>p</m:mi><m:mo stretchy="false">)</m:mo><m:mi>·</m:mi><m:mi>p</m:mi></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00018">
            <para id="para-00124">Correct! <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>50</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mo>−</m:mo><m:mn>400</m:mn><m:mi>p</m:mi><m:mo stretchy="false">)</m:mo><m:mi>·</m:mi><m:mi>p</m:mi></m:mrow></m:math></para>
            <para id="para-00125">Try again. Revisit activity 7.7.2.</para>
            <para id="para-00126">The correct answer is: <m:math display="inline"><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>50</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mo>−</m:mo><m:mn>400</m:mn><m:mi>p</m:mi><m:mo stretchy="false">)</m:mo><m:mi>·</m:mi><m:mi>p</m:mi></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="_3cf96af7-0f03-45ae-8e35-07252044c9c1" class="multiple-choice">
          <problem id="prob-00019">
            <para id="para-00127">Use the following scenario to answer questions 7 – 10.</para>
            <para id="para-00128">
              <quote id="quote-00002">The function <m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math> represents the revenue in dollars the school can expect to receive if it sells <m:math display="inline"><m:mrow><m:mn>220</m:mn><m:mo>−</m:mo><m:mn>12</m:mn><m:mi>x</m:mi></m:mrow></m:math> coffee mugs for <m:math display="inline"><m:mrow><m:mi>x</m:mi></m:mrow></m:math> dollars each.</quote>
          </para>
            <para id="para-00129">Here is the graph of <m:math display="inline"><m:mrow><m:mi>f</m:mi></m:mrow></m:math>.</para>
            <para id="para-00130">
                      <media alt="Parabola on grid. Horizontal axis, price in dollars, from 0 to 20. Vertical axis, revenue in dollars, from 0 to 1000. Parabola opens down. Vertex near 9 comma 1000. \(\(x\)-intercepts near 0 and 18 point 2.">
                  <image mime-type="image/svg+xml" src="../../media/Algebra-1_08_09_10_01.svg"/>
                </media>
              
          </para>
            <para id="para-00131">Select <emphasis>three</emphasis> statements that describe this situation.</para>
          </problem>
          <solution id="sol-00019">
            <para id="para-00132">Correct! The school expects to sell 160 mugs if the price is $5 each. The school will earn about $1,000 if it sells the mugs for $10 each. The revenue will be more than $700 if the price is between $4 and $14.</para>
            <para id="para-00133">Try again. Revisit activity 7.7.4.</para>
            <para id="para-00134">The correct answers are: The school expects to sell 160 mugs if the price is $5 each. The school will earn about $1,000 if it sells the mugs for $10 each. The revenue will be more than $700 if the price is between $4 and $14.</para>
          </solution>
        </exercise>
        <exercise id="_5d533ed9-4520-4ef5-a252-6d5b25ea619c" class="multiple-choice">
          <problem id="prob-00020">
            
            <para id="para-00135">To the nearest hundred dollars, what is the maximum revenue for the mugs?</para>
          </problem>
          <solution id="sol-00020">
            <para id="para-00136">Correct! 1000</para>
            <para id="para-00137">Try again. Revisit activity 7.7.3.</para>
            <para id="para-00138">The correct answer is 1,000.</para>
          </solution>
        </exercise>
        <exercise id="f919514b-7f1b-4f68-9eb8-bc27744cab64" class="multiple-choice">
          <problem id="prob-00021">
            <para id="para-00139">Which is the approximate domain?</para>
            <para id="para-00140">Multiple Choice:</para>
            <para id="para-00141"><m:math><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
            <para id="para-00142"><m:math><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>18</m:mn></m:mrow></m:math></para>
            <para id="para-00143"><m:math><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>1000</m:mn></m:mrow></m:math></para>
            <para id="para-00144"><m:math><m:mrow><m:mi>x</m:mi><m:mo>≥</m:mo><m:mn>0</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00021">
            <para id="para-00145">Correct! <m:math display="inline"><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>18</m:mn></m:mrow></m:math></para>
            <para id="para-00146">Try again. Revisit activity 7.7.3.</para>
            <para id="para-00147">The correct answer is <m:math display="inline"><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>x</m:mi><m:mo>≤</m:mo><m:mn>18</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
        <exercise id="cf6b8ca6-cc68-40a3-93df-6aeef751887d" class="multiple-choice">
          <problem id="prob-00022">
            <para id="para-00148">Which is the approximate range?</para>
            <para id="para-00149">Multiple Choice:</para>
            <para id="para-00150"><m:math><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi><m:mo>&lt;</m:mo><m:mo>∞</m:mo></m:mrow></m:math></para>
            <para id="para-00151"><m:math><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>1000</m:mn></m:mrow></m:math></para>
            <para id="para-00152"><m:math><m:mrow><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>1000</m:mn></m:mrow></m:math></para>
            <para id="para-00153"><m:math><m:mrow><m:mo>−</m:mo><m:mo>∞</m:mo><m:mo>&lt;</m:mo><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>1000</m:mn></m:mrow></m:math></para>
          </problem>
          <solution id="sol-00022">
            <para id="para-00154">Correct! <m:math display="inline"><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>1000</m:mn></m:mrow></m:math></para>
            <para id="para-00155">Try again. Revisit activity 7.7.3.</para>
            <para id="para-00156">The correct answer is <m:math display="inline"><m:mrow><m:mn>0</m:mn><m:mo>≤</m:mo><m:mi>y</m:mi><m:mo>≤</m:mo><m:mn>1000</m:mn></m:mrow></m:math>.</para>
          </solution>
        </exercise>
      </section>
    </section>
  </content></document>
