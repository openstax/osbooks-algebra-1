    </div>
    </exercise>
  <!--q10-->
  <exercise data-content-id="cf6b8ca6-cc68-40a3-93df-6aeef751887d" data-problem-type="multiplechoice" data-retry-limit="2" data-solution="\(y \\leq 1000\)" data-solution-options="[ &quot;\\(0 \\leq y \\leq \\infty\\)&quot;,&quot;\\(0 &lt; y \\leq 1000\\)&quot;, &quot;\\(y \\leq 1000\\)&quot;, &quot;\\(y \\leq 1000\\)&quot;]">
    <problem>
      <para>Which is the approximate range? </para>
