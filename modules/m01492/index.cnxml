        </entry>
      </row>
      <row>
        <entry>
          3
        </entry>
        <entry>
          3.6
        </entry>
      </row>
      <row>
        <entry>
          4
        </entry>
        <entry>
          4.7
        </entry>
      </row>
      <row>
        <entry>
          5
        </entry>
        <entry>
          5.8
        </entry>
      </row>
    </tbody>
  </table>
  <table class="os-raise-skinnytable">
    <caption>Table C</caption>
    <thead>
      <row>
        <entry><emphasis>
          \(x\)
        </emphasis></entry><entry><emphasis>
          \(f(x)\)
        </emphasis></entry></row>
    </thead>
    <tbody>
      <row>
        <entry>
          1
        </entry>
        <entry>
          30
        </entry>
      </row>
      <row>
        <entry>
          2
        </entry>
        <entry>
          60
        </entry>
      </row>
      <row>
        <entry>
