        </entry>
        <entry>
          \(\frac{1}{32}\)
        </entry>
      </row>
    </tbody>
  </table>
  <table class="os-raise-skinnytable">
    <caption>Table B</caption>
    <thead>
      <row>
        <entry><emphasis>
          \(x\)
        </emphasis></entry><entry><emphasis>
          \(f(x)\)
        </emphasis></entry></row>
    </thead>
    <tbody>
      <row>
        <entry>
          1
        </entry>
        <entry>
          1.4
        </entry>
      </row>
