<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>4.4.1: Using Function Notation in Tables of Values</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00899</md:content-id>
    <md:title>4.4.1: Using Function Notation in Tables of Values</md:title>
    <md:uuid>72af7e5a-d729-4354-8c65-cb4687db89dc</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Warm Up Activity</title>
<para id="para-00001">Use the tables to answer each question.</para>
<table class="os-raise-midsizetable" id="table-00001">
  <tgroup cols="2"><tbody><row>
      <entry><emphasis>
       \(x\)
      </emphasis></entry><entry><emphasis>
       \(f(x)=10-2x\)
      </emphasis></entry></row>
  <row>
      <entry>
       1
      </entry>
      <entry>
     8
		  
      </entry>
    </row>
    <row>
      <entry>
       1.5
      </entry>
      <entry>
        7
      </entry>
    </row>
    <row>
      <entry>
       5
      </entry>
      <entry>
       0
      </entry>
    </row>
    <row>
      <entry>
       –2
      </entry>
      <entry>
      14
      </entry>
    </row>
  </tbody></tgroup></table>

<table class="os-raise-midsizetable" id="table-00002">
  <tgroup cols="2"><tbody><row>
      <entry><emphasis>
     \(x\)
      </emphasis></entry><entry><emphasis>
     \(g(x)=x^3\)
      </emphasis></entry></row><row>
      <entry>
        <para id="para-00002">–2</para>
      </entry>
      <entry>
        <para id="para-00003">–8</para>
      </entry>
    </row>
    <row>
      <entry>
        <para id="para-00004">0</para>
      </entry>
      <entry>
        <para id="para-00005">0</para>
      </entry>
    </row>
    <row>
      <entry>
        <para id="para-00006">1</para>
      </entry>
      <entry>
        <para id="para-00007">1</para>
      </entry>
    </row>
    <row>
      <entry>
        <para id="para-00008">3</para>
      </entry>
      <entry>
        <para id="para-00009">27</para>
      </entry>
    </row>
  </tbody></tgroup></table>


<!--Text Entry Interaction Start -->
<exercise>
  <problem id="prob-00001">
    <para id="para-00010">What do you notice? </para>
    </problem><solution id="sol-00001">
    
    <para id="para-00011">Enter your answer here:</para>
  
  <para id="para-00012">Compare your answers:</para>
    
    <list id="list-00001">
      <item>
        The tables don't say “input” and “output.”</item>
      <item>
        While there is a column labeled \(x\), there is not a column labeled \(y\).</item>
      <item>
        One function is called \(f\). The other is called \(g\).</item>
      <item>
        There’s an expression (rather than a number) on the right side of the equation \(f(x)=10−2x\) and \(g(x)=x^3\).
      </item>
      <item>
        If we substitute the values in the left column for the \(x\) in the expression, we get the values in the right column.
      </item>
    </list>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise>
  <problem id="prob-00002">
    <para id="para-00013">What do you wonder?</para>
    </problem><solution id="sol-00002">
    
    <para id="para-00014">Enter your answer here:</para>
  
  <para id="para-00015">Compare your answers:</para>
    
    <list id="list-00002">
      <item>
        Why is \(x\) on the right side of the equal sign?
      </item>
      <item>
        Are there rules about how to name functions?
      </item>
      <item>
        What does each equation, \(f(x)=10-2x\) and \(g(x)=x^3\), mean?
      </item>
    </list>
  
  </solution></exercise>
<!--Interaction End -->
</section>
