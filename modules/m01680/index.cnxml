  <title>6.6.2: Factoring Perfect Square Trinomials</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m01680</md:content-id>
    <md:title>6.6.2: Factoring Perfect Square Trinomials</md:title>
    <md:uuid>8a60b5f9-3b05-4ec6-8250-c558b34dd326</md:uuid>
  </metadata>
  <content>
  <section id="sect-00001"><title>Activity</title>
<para id="para-00001">Remember the patterns for perfect square trinomials:</para>
<para id="para-00002">\(a^2 + 2ab + b^2 = (a + b)^2\)</para>
<para id="para-00003">\(a^2 − 2ab + b^2 = (a − b)^2\)</para>
<para id="para-00004">Factor each perfect square trinomial. If necessary, factor out the GCF first. Use the "^" symbol to enter an exponent.</para>

<!--Text Entry Interaction Start -->
<exercise id="exer-00001">
  <problem id="prob-00001">
    <para id="para-00005">\(64y^2 − 80y + 25\)</para>
    </problem><solution id="sol-00001">
    
    
  
  <para id="para-00006">Compare your answer:</para>
    
    <para id="para-00007">\((8y − 5)^2\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00002">
  <problem id="prob-00002">
    <para id="para-00008">\(16y^2 + 24y + 9\)</para>
    </problem><solution id="sol-00002">
    
    
  
  <para id="para-00009">Compare your answer:</para>
    
    <para id="para-00010">\((4y + 3)^2\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00003">
  <problem id="prob-00003">
    <para id="para-00011">\(25n^2 − 120n + 144\)</para>
    </problem><solution id="sol-00003">
    
    
  
  <para id="para-00012">Compare your answer:</para>
    
    <para id="para-00013">\((5n − 12)^2\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00004">
  <problem id="prob-00004">
    <para id="para-00014">\(100y^2 − 20y + 1\)</para>
    </problem><solution id="sol-00004">
    
    
  
  <para id="para-00015">Compare your answer:</para>
    
    <para id="para-00016">\((10y − 1)^2\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00005">
  <problem id="prob-00005">
    <para id="para-00017">\(10jk^2 + 80jk + 160j\)</para>
    </problem><solution id="sol-00005">
    
    
  
  <para id="para-00018">Compare your answer:</para>
    
    <para id="para-00019">\(10j(k + 4)^2\)</para>
  
  </solution></exercise>
<!--Interaction End -->


<!--Text Entry Interaction Start -->
<exercise id="exer-00006">
  <problem id="prob-00006">
    <para id="para-00020">\(75u^4 − 30u^3v + 3u^2v^2\)</para>
    </problem><solution id="sol-00006">
    
    
  
  <para id="para-00021">Compare your answer:</para>
    
    <para id="para-00022">\(3u^2(5u − v)^2\)</para>
  
  </solution></exercise></section>
<!--Interaction End -->
