  <problem>
    <para>Factor this perfect square trinomial.</para>
    <para>\(90p^4r^2 + 300p^3qr^2 + 250p^2q^2r^2\)</para>
  </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(10p^2r^2(3p + 5q)^2\)</para>
  </solution></exercise>
