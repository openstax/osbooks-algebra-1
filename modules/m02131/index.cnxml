  <!--q8-->
  <exercise data-content-id="45a90896-1755-48af-b75f-11307359e21c" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(b=9\) and \(b=-7\)" data-solution-options="[&quot;\\(b=9\\) and \\(b=-9\\)&quot;, &quot;\\(b=8\\) and \\(b=-8\\)&quot;, &quot;\\(b=9\\) and \\(b=-7\\)&quot;, &quot;\\(b=-9\\) and \\(b=7\\)&quot;]">
