  <!--q7-->
  <exercise data-content-id="6feca9eb-d756-4000-8edd-4f088dd1c31a" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(a=17\) and \(a=-3\)" data-solution-options="[&quot;\\(a=17\\) and \\(a=-3\\)&quot;, &quot;\\(a=-17\\) and \\(a=3\\)&quot;, &quot;\\(a=-10\\) and \\(a=10\\)&quot;, &quot;\\(a=3\\) and \\(a=-3\\)&quot;]">
