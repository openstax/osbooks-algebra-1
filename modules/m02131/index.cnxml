  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="ddfc55eb-e47c-429f-8110-93a773d36c11" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--q1-->
  <exercise data-content-id="c71e7ef2-74df-4658-9a44-e9c3c913a8a2" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="2 solutions; \(x=4\) and \(x=-4\)" data-solution-options="[&quot;0 solutions&quot;, &quot;1 solution; \\(x=4\\)&quot;, &quot;2 solutions; \\(x=4\\) and \\(x=-4\\)&quot;, &quot;2 solutions; \\(x=12\\) and \\(x=-12\\)&quot;]">
    <problem>
      <para>For questions 1 - 2, determine the number of solutions. Then solve the equation.</para>
      <para>\(3x^2=48\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.3.1. </para>
    </div>
    </exercise>
  <!--q2-->
  <exercise data-content-id="8133ca1e-ea57-40c5-ac3c-74388fe6fc6c" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="1 solution; \(x=-2\)" data-solution-options="[&quot;0 solutions&quot;, &quot;1 solution; \\(x=-2\\)&quot;, &quot;1 solution; \\(x=2\\)&quot;, &quot;2 solutions; \\(x=2\\) and \\(x=-2\\)&quot;]">
    <problem>
      <para>\((x+2)(x+2)=0\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 8.3.1.</para>
    </div>
    </exercise>
  <!--q3-->
  <exercise data-content-id="41b5f66f-90c1-413f-9e3a-6007000edeea" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(m=3\) and \(m=-3\)" data-solution-options="[&quot;\\(m=3\\) and \\(m=-3\\)&quot;, &quot;\\( m=3\\)&quot;, &quot;\\( m=9\\) and \\(m=-9\\)&quot;, &quot;\\(m=2\\) and \\(m=-2\\)&quot;]">
    <problem>
      <para>For questions 3 – 10, solve the quadratic equation.</para>
      <para>\(4m^2=36\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 8.3.2 and 8.3.4. </para>
    </div>
    </exercise>
  <!--Q4-->
  <exercise data-content-id="9d2defef-d0de-4715-b977-fb1f2cce5468" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(d=5\) and \(d=-5\)" data-solution-options="[&quot;\\(d=5\\) and \\(d=-5\\)&quot;, &quot;\\(d=5\\)&quot;, &quot;\\(d=-5\\)&quot;, &quot;\\(d=25\\)&quot;]">
    <problem>
      <para>\(d^2-25=0\)</para>
      </problem>
    <solution>
      <para>Correct!</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 8.3.2 and 8.3.4.</para>
    </div>
    </exercise>
  <!--Q5-->
  <exercise data-content-id="3b3a88e1-ee15-4f86-bd00-3f793f0c65d1" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(z=9\) and \(z=-9\)" data-solution-options="[&quot;\\(z=6\\) and \\(z=-6\\)&quot;, &quot;\\(z=7\\) and \\(z=-9\\)&quot;, &quot;\\(z=9\\) and \\(z=-9\\)&quot;, &quot;\\(z=7\\) and \\(z=-7\\)&quot;]">
    <problem>
      <para>\(\frac{2}{3}z^2=54\)</para>
      </problem>
