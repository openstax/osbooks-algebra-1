    </exercise>
  <!--q6-->
  <exercise data-content-id="77e0882d-16e7-4b13-b56f-6677ede5e696" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(p=8\) and \(p=-8\)" data-solution-options="[&quot;\\(p=18\\) and \\(p=-18\\)&quot;, &quot;\\(p=12\\) and \\(p=-12\\)&quot;, &quot;\\(p =16\\) and \\(p=-16\\)&quot;, &quot;\\(p=8\\) and \\(p=-8\\)&quot;]">
