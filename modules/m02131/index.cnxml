  <exercise data-content-id="1e9bfb23-6bef-4dc8-89f1-e2f77672912b" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x=13\) and \(x=3\)" data-solution-options="[&quot;\\(x=13\\) and \\(x=3\\)&quot;, &quot;\\(x=-3\\) and \\(x=-13\\)&quot;, &quot;\\(x=5\\) and \\(x=-5\\)&quot;, &quot;\\(x=5\\) and \\(x=-11\\)&quot;]">
