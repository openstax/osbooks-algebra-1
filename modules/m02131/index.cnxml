<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.3.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02131</md:content-id>
    <md:title>8.3.5: Practice</md:title>
    <md:uuid>e12d3f31-0e54-4cca-95e6-e2f50a9a6e5c</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <exercise id="c71e7ef2-74df-4658-9a44-e9c3c913a8a2" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00002">For questions 1 - 2, determine the number of solutions. Then solve the equation.</para>
          <para id="para-00003">\(3x^2=48\)</para>
          <para id="para-00004">Multiple Choice:</para>
          <para id="para-00005">0 solutions</para>
          <para id="para-00006">1 solution; \(x=4\)</para>
          <para id="para-00007">2 solutions; \(x=4\) and \(x=-4\)</para>
          <para id="para-00008">2 solutions; \(x=12\) and \(x=-12\)</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00009">Try again. Revisit activity 8.3.1.</para>
          <para id="para-00010">The correct answer is two solutions; \(x=4\) and \(x=-4\).</para>
        </solution>
      </exercise>
      <exercise id="_8133ca1e-ea57-40c5-ac3c-74388fe6fc6c" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00011">\((x+2)(x+2)=0\)</para>
          <para id="para-00012">Multiple Choice:</para>
          <para id="para-00013">0 solutions</para>
          <para id="para-00014">1 solution; \(x=-2\)</para>
          <para id="para-00015">1 solution; \(x=2\)</para>
          <para id="para-00016">2 solutions; \(x=2\) and \(x=-2\)</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00017">Try again. Revisit activity 8.3.1.</para>
          <para id="para-00018">The correct answer is one solution; \(x=-2\).</para>
        </solution>
      </exercise>
      <exercise id="_41b5f66f-90c1-413f-9e3a-6007000edeea" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00019">For questions 3 – 10, solve the quadratic equation.</para>
          <para id="para-00020">\(4m^2=36\)</para>
          <para id="para-00021">Multiple Choice:</para>
          <para id="para-00022">\(m=3\) and \(m=-3\)</para>
          <para id="para-00023">\( m=3\)</para>
          <para id="para-00024">\( m=9\) and \(m=-9\)</para>
          <para id="para-00025">\(m=2\) and \(m=-2\)</para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00026">Try again. Revisit activities 8.3.2 and 8.3.4.</para>
          <para id="para-00027">The correct answer is \(m=3\) and \(m=-3\).</para>
        </solution>
      </exercise>
      <exercise id="_9d2defef-d0de-4715-b977-fb1f2cce5468" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00028">\(d^2-25=0\)</para>
          <para id="para-00029">Multiple Choice:</para>
          <para id="para-00030">\(d=5\) and \(d=-5\)</para>
          <para id="para-00031">\(d=5\)</para>
          <para id="para-00032">\(d=-5\)</para>
          <para id="para-00033">\(d=25\)</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00034">Try again. Revisit activities 8.3.2 and 8.3.4.</para>
          <para id="para-00035">The correct answer is \(d = 5\) and \(d = -5\).</para>
        </solution>
      </exercise>
      <exercise id="_3b3a88e1-ee15-4f86-bd00-3f793f0c65d1" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00036">\(\frac{2}{3}z^2=54\)</para>
          <para id="para-00037">Multiple Choice:</para>
          <para id="para-00038">\(z=6\) and \(z=-6\)</para>
          <para id="para-00039">\(z=7\) and \(z=-9\)</para>
          <para id="para-00040">\(z=9\) and \(z=-9\)</para>
          <para id="para-00041">\(z=7\) and \(z=-7\)</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00042">Try again. Revisit activities 8.3.2 and 8.3.4.</para>
          <para id="para-00043">The correct answer is \(z=9\) and \(z=-9\).</para>
        </solution>
      </exercise>
      <exercise id="_77e0882d-16e7-4b13-b56f-6677ede5e696" class="multiple-choice">
        <problem id="prob-00006">
          <para id="para-00044">\(4p^2+10=266\)</para>
          <para id="para-00045">Multiple Choice:</para>
          <para id="para-00046">\(p=18\) and \(p=-18\)</para>
          <para id="para-00047">\(p=12\) and \(p=-12\)</para>
          <para id="para-00048">\(p =16\) and \(p=-16\)</para>
          <para id="para-00049">\(p=8\) and \(p=-8\)</para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00050">Try again. Revisit activities 8.3.2 and 8.3.4.</para>
          <para id="para-00051">The correct answer is \(p=8\) and \(p=-8\).</para>
        </solution>
      </exercise>
      <exercise id="_6feca9eb-d756-4000-8edd-4f088dd1c31a" class="multiple-choice">
        <problem id="prob-00007">
          <para id="para-00052">\((a−7)^2+5=105\)</para>
          <para id="para-00053">Multiple Choice:</para>
          <para id="para-00054">\(a=17\) and \(a=-3\)</para>
          <para id="para-00055">\(a=-17\) and \(a=3\)</para>
          <para id="para-00056">\(a=-10\) and \(a=10\)</para>
          <para id="para-00057">\(a=3\) and \(a=-3\)</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00058">Try again. Revisit activities 8.3.3 and 8.3.4.</para>
          <para id="para-00059">The correct answer is \(a=17\) and \(a=-3\).</para>
        </solution>
      </exercise>
      <exercise id="_45a90896-1755-48af-b75f-11307359e21c" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00060">\((b−1)^2−9=55\)</para>
          <para id="para-00061">Multiple Choice:</para>
          <para id="para-00062">\(b=9\) and \(b=-9\)</para>
          <para id="para-00063">\(b=8\) and \(b=-8\)</para>
          <para id="para-00064">\(b=9\) and \(b=-7\)</para>
          <para id="para-00065">\(b=-9\) and \(b=7\)</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00066">Try again. Revisit activities 8.3.3 and 8.3.4.</para>
          <para id="para-00067">The correct answer is \(b =9\) and \(b=-7\).</para>
        </solution>
      </exercise>
      <exercise id="c22605f5-d305-48f1-85f7-248c039ca492" class="multiple-choice">
        <problem id="prob-00009">
          <para id="para-00068">\(\frac17(x+3)^2−5=2\)</para>
          <para id="para-00069">Multiple Choice:</para>
          <para id="para-00070">\(x=-4\) and \(x=10\)</para>
          <para id="para-00071">\(x=4\) and \(x=-10\)</para>
          <para id="para-00072">\(x=-4\) and \(x=4\)</para>
          <para id="para-00073">\(x=-2\) and \(x=12\)</para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00074">Try again. Revisit activities 8.3.3 and 8.3.4.</para>
          <para id="para-00075">The correct answer is \(x=4\) and \(x=-10\).</para>
        </solution>
      </exercise>
      <exercise id="_1e9bfb23-6bef-4dc8-89f1-e2f77672912b" class="multiple-choice">
        <problem id="prob-00010">
          <para id="para-00076">\(5(x−8)^2−7=118\)</para>
          <para id="para-00077">Multiple Choice:</para>
          <para id="para-00078">\(x=13\) and \(x=3\)</para>
          <para id="para-00079">\(x=-3\) and \(x=-13\)</para>
          <para id="para-00080">\(x=5\) and \(x=-5\)</para>
          <para id="para-00081">\(x=5\) and \(x=-11\)</para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00082">Try again. Revisit activities 8.3.3 and 8.3.4.</para>
          <para id="para-00083">The correct answer is \(x=13\) and \(x=3\).</para>
        </solution>
      </exercise>
    </section>
  </content>
