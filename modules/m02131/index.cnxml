  <!--q9-->
  <exercise data-content-id="c22605f5-d305-48f1-85f7-248c039ca492" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\(x=4\) and \(x=-10\)" data-solution-options="[&quot;\\(x=-4\\) and \\(x=10\\)&quot;, &quot;\\(x=4\\) and \\(x=-10\\)&quot;, &quot;\\(x=-4\\) and \\(x=4\\)&quot;, &quot;\\(x=-2\\) and \\(x=12\\)&quot;]">
