<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>8.3.5: Practice</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m02131</md:content-id>
    <md:title>8.3.5: Practice</md:title>
    <md:uuid>e12d3f31-0e54-4cca-95e6-e2f50a9a6e5c</md:uuid>
  </metadata>
  <content>
    <section class="practice" id="sect-00001">
      <para id="para-00001">Complete the following questions to practice the skills you have learned in this lesson.</para>
      <exercise id="c71e7ef2-74df-4658-9a44-e9c3c913a8a2" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00002">For questions 1 - 2, determine the number of solutions. Then solve the equation.</para>
          <para><m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>48</m:mn></m:mrow></m:math></para><para id="para-00004">Multiple Choice:</para>
          <para id="para-00005">0 solutions</para>
          <para id="para-00006">1 solution; <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
          <para id="para-00007">2 solutions; <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
          <para id="para-00008">2 solutions; <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>12</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>12</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00009">Try again. Revisit activity 8.3.1.</para>
          <para id="para-00010">The correct answer is two solutions; <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_8133ca1e-ea57-40c5-ac3c-74388fe6fc6c" class="multiple-choice">
        <problem id="prob-00002">
          <para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para><para id="para-00012">Multiple Choice:</para>
          <para id="para-00013">0 solutions</para>
          <para id="para-00014">1 solution; <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
          <para id="para-00015">1 solution; <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
          <para id="para-00016">2 solutions; <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00017">Try again. Revisit activity 8.3.1.</para>
          <para id="para-00018">The correct answer is one solution; <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_41b5f66f-90c1-413f-9e3a-6007000edeea" class="multiple-choice">
        <problem id="prob-00003">
          <para id="para-00019">For questions 3 – 10, solve the quadratic equation.</para>
          <para><m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>m</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>36</m:mn></m:mrow></m:math></para><para id="para-00021">Multiple Choice:</para>
          <para id="para-00022"><m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
          <para><m:math><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math></para><para id="para-00024"><m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
          <para id="para-00025"><m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00003">
          <para id="para-00026">Try again. Revisit activities 8.3.2 and 8.3.4.</para>
          <para id="para-00027">The correct answer is <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_9d2defef-d0de-4715-b977-fb1f2cce5468" class="multiple-choice">
        <problem id="prob-00004">
          <para><m:math><m:mrow><m:msup><m:mi>d</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>25</m:mn><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para><para id="para-00029">Multiple Choice:</para>
          <para id="para-00030"><m:math display="inline"><m:mrow><m:mi>d</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>d</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
          <para><m:math><m:mrow><m:mi>d</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mi>d</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math></para><para><m:math><m:mrow><m:mi>d</m:mi><m:mo>=</m:mo><m:mn>25</m:mn></m:mrow></m:math></para></problem>
        <solution id="sol-00004">
          <para id="para-00034">Try again. Revisit activities 8.3.2 and 8.3.4.</para>
          <para id="para-00035">The correct answer is <m:math display="inline"><m:mrow><m:mi>d</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>d</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_3b3a88e1-ee15-4f86-bd00-3f793f0c65d1" class="multiple-choice">
        <problem id="prob-00005">
          <para><m:math><m:mrow><m:mfrac><m:mrow><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac><m:msup><m:mi>z</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:mn>54</m:mn></m:mrow></m:math></para><para id="para-00037">Multiple Choice:</para>
          <para id="para-00038"><m:math display="inline"><m:mrow><m:mi>z</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>z</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
          <para id="para-00039"><m:math display="inline"><m:mrow><m:mi>z</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>z</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
          <para id="para-00040"><m:math display="inline"><m:mrow><m:mi>z</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>z</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
          <para id="para-00041"><m:math display="inline"><m:mrow><m:mi>z</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>z</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00042">Try again. Revisit activities 8.3.2 and 8.3.4.</para>
          <para id="para-00043">The correct answer is <m:math display="inline"><m:mrow><m:mi>z</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>z</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_77e0882d-16e7-4b13-b56f-6677ede5e696" class="multiple-choice">
        <problem id="prob-00006">
          <para><m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>p</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>10</m:mn><m:mo>=</m:mo><m:mn>266</m:mn></m:mrow></m:math></para><para id="para-00045">Multiple Choice:</para>
          <para id="para-00046"><m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>18</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>18</m:mn></m:mrow></m:math></para>
          <para id="para-00047"><m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>12</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>12</m:mn></m:mrow></m:math></para>
          <para id="para-00048"><m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>16</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>16</m:mn></m:mrow></m:math></para>
          <para id="para-00049"><m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00006">
          <para id="para-00050">Try again. Revisit activities 8.3.2 and 8.3.4.</para>
          <para id="para-00051">The correct answer is <m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_6feca9eb-d756-4000-8edd-4f088dd1c31a" class="multiple-choice">
        <problem id="prob-00007">
          <para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mi>−</m:mi><m:mn>7</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn><m:mo>=</m:mo><m:mn>105</m:mn></m:mrow></m:math></para><para id="para-00053">Multiple Choice:</para>
          <para id="para-00054"><m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>17</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
          <para id="para-00055"><m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>17</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
          <para id="para-00056"><m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>10</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math></para>
          <para id="para-00057"><m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00058">Try again. Revisit activities 8.3.3 and 8.3.4.</para>
          <para id="para-00059">The correct answer is <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>17</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_45a90896-1755-48af-b75f-11307359e21c" class="multiple-choice">
        <problem id="prob-00008">
          <para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>b</m:mi><m:mi>−</m:mi><m:mn>1</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>9</m:mn><m:mo>=</m:mo><m:mn>55</m:mn></m:mrow></m:math></para><para id="para-00061">Multiple Choice:</para>
          <para id="para-00062"><m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
          <para id="para-00063"><m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
          <para id="para-00064"><m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
          <para id="para-00065"><m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00066">Try again. Revisit activities 8.3.3 and 8.3.4.</para>
          <para id="para-00067">The correct answer is <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="c22605f5-d305-48f1-85f7-248c039ca492" class="multiple-choice">
        <problem id="prob-00009">
          <para><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>7</m:mn></m:mfrac><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>5</m:mn><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para><para id="para-00069">Multiple Choice:</para>
          <para id="para-00070"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math></para>
          <para id="para-00071"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>10</m:mn></m:mrow></m:math></para>
          <para id="para-00072"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
          <para id="para-00073"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>12</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00009">
          <para id="para-00074">Try again. Revisit activities 8.3.3 and 8.3.4.</para>
          <para id="para-00075">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>10</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
      <exercise id="_1e9bfb23-6bef-4dc8-89f1-e2f77672912b" class="multiple-choice">
        <problem id="prob-00010">
          <para><m:math><m:mrow><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>8</m:mn><m:msup><m:mo stretchy="false">)</m:mo><m:mn>2</m:mn></m:msup><m:mi>−</m:mi><m:mn>7</m:mn><m:mo>=</m:mo><m:mn>118</m:mn></m:mrow></m:math></para><para id="para-00077">Multiple Choice:</para>
          <para id="para-00078"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>13</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
          <para id="para-00079"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>13</m:mn></m:mrow></m:math></para>
          <para id="para-00080"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
          <para id="para-00081"><m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>11</m:mn></m:mrow></m:math></para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00082">Try again. Revisit activities 8.3.3 and 8.3.4.</para>
          <para id="para-00083">The correct answer is <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>13</m:mn></m:mrow></m:math> and <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math>.</para>
        </solution>
      </exercise>
    </section>
  </content>
