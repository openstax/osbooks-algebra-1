            </m:math></para></item>
          <item><para id="para-00050"><m:math>
              <m:mrow>
                <m:mi>r</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>4</m:mn>
                <m:msup>
                  <m:mo stretchy="false">)</m:mo>
