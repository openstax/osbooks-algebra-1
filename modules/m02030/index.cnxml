                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mi>−</m:mi>
                <m:mn>4</m:mn>
                <m:msup>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
                <m:mn>1</m:mn>
              </m:mrow>
            </m:math></para></item>
          <item><para id="para-00040"><m:math>
              <m:mrow>
                <m:mi>r</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>4</m:mn>
                <m:msup>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mi>−</m:mi>
                <m:mn>1</m:mn>
              </m:mrow>
            </m:math></para></item>
            </list>
        </problem>
        <solution id="sol-00004">
          <para id="para-00041"><m:math display="inline">
              <m:mrow>
                <m:mi>p</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo>+</m:mo>
                <m:mn>1</m:mn>
                <m:msup>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mi>−</m:mi>
                <m:mn>4</m:mn>
              </m:mrow>
            </m:math></para>
         
        </solution>
      </exercise>
