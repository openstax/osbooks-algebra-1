                <m:mi>x</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mo>−</m:mo>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
