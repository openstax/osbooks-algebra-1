            </m:math></para></item>
            </list>
        </problem>
        <solution id="sol-00005">
          <para id="para-00051"><m:math display="inline">
              <m:mrow>
                <m:mi>q</m:mi>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mo stretchy="false">)</m:mo>
                <m:mo>=</m:mo>
                <m:mn>2</m:mn>
                <m:mo stretchy="false">(</m:mo>
                <m:mi>x</m:mi>
                <m:mi>−</m:mi>
                <m:mn>4</m:mn>
                <m:msup>
                  <m:mo stretchy="false">)</m:mo>
                  <m:mn>2</m:mn>
                </m:msup>
                <m:mo>+</m:mo>
