              <entry>1. \(x\;–\;4\;\leq\;–6\;\)</entry>
              <entry>
                <para>A. Multiplication Property of Inequality</para>
              </entry>
            </row>
            <row>
              <entry>2. \(x\;+\;6\;\geq\;8\;\)</entry>
              <entry>
                <para>B. Addition Property of Inequality</para>
              </entry>
            </row>
            <row>
              <entry>3. \(4x\;\leq\;8\)</entry>
              <entry>
                <para>C. Division Property of Inequality</para>
              </entry>
            </row>
            <row>
              <entry>4. \(–\frac12x\;\leq\;1\;\)</entry>
              <entry>
                <para>C. Subtraction Property of Inequality</para>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
      <!-- BEGIN ACTIVITY DROP DOWN 1 TRY -->

        <exercise id="d0c3c61c-019a-41b3-8933-0a1c39a0c500" class="multiple-choice">
