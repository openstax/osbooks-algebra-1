                  <para id="para-00086">The correct answer is (0,10).</para>
                  <para id="para-00087">Check the solution in both equations.</para>
                  <para><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>10</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>10</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>0</m:mn><m:mo>+</m:mo><m:mn>10</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>10</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>10</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>10</m:mn><m:mi>✓</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>2</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>−</m:mi><m:mn>20</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>0</m:mn><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>10</m:mn><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>−</m:mi><m:mn>20</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>0</m:mn><m:mi>−</m:mi><m:mn>20</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>−</m:mi><m:mn>20</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>20</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>20</m:mn><m:mi>✓</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00090">(0,10) Makes both equations in the system true, therefore it is a solution.</para>
               </solution>
            </exercise>
            <exercise id="_59b0d4f7-31f5-453a-b7e2-1c74c33f9fda" class="multiple-choice">
               <problem id="prob-00008">
                  <para><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mi>y</m:mi><m:mo>=</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para><para id="para-00092">Multiple Choice:</para>
                  <para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mi>−</m:mi><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
               <solution id="sol-00008">
                  <para id="para-00097">Correct! (4,−2)</para>
                  <para id="para-00098">Try again. Revisit activities 2.3.3 and 2.3.4.</para>
                  <para id="para-00099">The correct answer is (4,−2).</para>
                  <para id="para-00100">Check the solution in both equations.</para>
                  <para><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mi>−</m:mi><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>−</m:mi><m:mn>2</m:mn><m:mi>✓</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>−</m:mi><m:mn>32</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>−</m:mi><m:mn>32</m:mn><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>−</m:mi><m:mn>6</m:mn><m:mo>+</m:mo><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>2</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>✓</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00103">(4,−2) Makes both equations in the system true, therefore it is a solution.</para>
               </solution>
            </exercise>
            <exercise id="_401e6494-8f33-4e4d-b593-16e163d0cb2b" class="multiple-choice">
               <problem id="prob-00009">
                  <para><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>16</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mo>−</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>8</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>4</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para><para id="para-00105">Multiple Choice:</para>
                  <para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>4</m:mn><m:mo>,</m:mo><m:mi>−</m:mi><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
               <solution id="sol-00009">
                  <para id="para-00110">Correct! (4,0)</para>
                  <para id="para-00111">Try again. Revisit activities 2.3.3 and 2.3.4.</para>
                  <para id="para-00112">The correct answer is (4,0).</para>
                  <para id="para-00113">Check the solution in both equations.</para>
                  <para><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>16</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mi>−</m:mi><m:mn>16</m:mn><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>0</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>8</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>8</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>8</m:mn><m:mi>✓</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mi>−</m:mi><m:mi>x</m:mi><m:mi>−</m:mi><m:mn>8</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>−</m:mi><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mi>−</m:mi><m:mn>4</m:mn><m:mi>−</m:mi><m:mn>8</m:mn><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>−</m:mi><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>−</m:mi><m:mn>0</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>−</m:mi><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>4</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>✓</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00116">(4,0) Makes both equations in the system true, therefore it is a solution.</para>
               </solution>
            </exercise>
            <exercise id="_16baa37a-12b3-4828-97a4-45ccf7b841bd" class="multiple-choice">
               <problem id="prob-00010">
                  <para><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para><para id="para-00118">Multiple Choice:</para>
                  <para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
               <solution id="sol-00010">
                  <para id="para-00123">Correct! (3,4)</para>
                  <para id="para-00124">Try again. Revisit activities 2.3.3 and 2.3.4.</para>
                  <para id="para-00125">The correct answer is (3, 4).</para>
                  <para id="para-00126">Check the solution in both equations.</para>
                  <para><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>−</m:mi><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>4</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>−</m:mi><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>4</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>−</m:mi><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>6</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>4</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>4</m:mn><m:mi>✓</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mi>−</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>6</m:mn><m:mi>−</m:mi><m:mn>4</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>2</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>2</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>2</m:mn><m:mi>✓</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00129">(3,4) Makes both equations in the system true, therefore it is a solution.</para>
               </solution>
            </exercise>
            <exercise id="_658cf1ee-cc3d-4df0-ba52-cd6e1eac9d07" class="multiple-choice">
               <problem id="prob-00011">
                  <para id="para-00130">Tyler and Han are trying to solve this system by substitution:</para>
                  <para><m:math><m:mrow><m:mrow><m:mo stretchy="true" fence="true" form="prefix">{</m:mo><m:mtable><m:mtr><m:mtd columnalign="left"><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mtd></m:mtr></m:mtable><m:mo stretchy="true" fence="true" form="postfix"/></m:mrow></m:mrow></m:math></para><para id="para-00132">Tyler's first step is to isolate x in the first equation to get <m:math display="inline"><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>.</m:mo></m:mrow></m:math></para>
                  <para id="para-00133">Han's first step is to isolate 3y in the first equation to get <m:math display="inline"><m:mrow><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>−</m:mo><m:mi>x</m:mi><m:mo>.</m:mo></m:mrow></m:math></para>
                  <para id="para-00134">Solve using both methods to show that both first steps can be used to solve
                     the system and will yield the same solution.</para>
                  <para id="para-00135">What is the solution to the system?</para>
                  <para id="para-00136">Multiple Choice:</para>
                  <para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para><para><m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
               <solution id="sol-00011">
                  <para id="para-00141">Correct! (1,-2)</para>
                  <para id="para-00142">Try again. Revisit activity 2.3.3.</para>
                  <para id="para-00143">The correct answer is (1,-2).</para>
                  <para id="para-00144">Check the solution in both equations.</para>
                  <para><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>−</m:mi><m:mn>5</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>1</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>−</m:mi><m:mn>5</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>1</m:mn><m:mo>−</m:mo><m:mn>6</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mi>−</m:mi><m:mn>5</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mo>−</m:mo><m:mn>5</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>✓</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>y</m:mi></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>3</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>9</m:mn><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>3</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>9</m:mn><m:mo>−</m:mo><m:mn>6</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>3</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>3</m:mn></m:mtd><m:mtd columnalign="center"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>3</m:mn><m:mi>✓</m:mi></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para id="para-00147">(1,-2) Makes both equations in the system true, therefore it is a solution.</para>
               </solution>
            </exercise>
      </section>
   </content>
