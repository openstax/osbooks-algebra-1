  <content>
  <section><para>Complete the following questions to practice the skills you have learned in this lesson.</para>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="a1712ea2-902b-4730-8ae2-0a65ccebb6e1" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="2" data-schema-version="1.0">
  <!--q1-->
  <exercise data-content-id="8f7cc46d-a1c4-4f5a-a354-15049b2a8deb" data-problem-comparator="integer" data-problem-type="input" data-solution="49">
    <problem>
      <para>Here are a few pairs of positive numbers whose sum is 50.
        </para>
      <table class="os-raise-wideequaltable">
        <thead>
          <row>
            <entry scope="col" class="emphasis">Row</entry>
            <entry scope="col" class="emphasis">First number</entry>
            <entry scope="col" class="emphasis">Second number</entry>
            <entry scope="col" class="emphasis">Product</entry>
          </row>
        </thead>
        <tbody>
          <row>
            <entry>a</entry>
            <entry>1</entry>
            <entry>49</entry>
            <entry> </entry>
          </row>
          <row>
            <entry>b</entry>
            <entry>2</entry>
            <entry>48</entry>
            <entry> </entry>
          </row>
          <row>
            <entry>c</entry>
            <entry>10</entry>
            <entry>40</entry>
            <entry> </entry>
          </row>
        </tbody>
      </table>
      <para> Find the product in Row a.
          </para>
        <para> Enter your answer here: </para>
    </problem>
    <solution>
      <para>Correct! 1 times 49 is 49.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 7.1.2 - 7.1.3.</para>
    </div>
    </exercise>
  <!--1b-->
  <exercise data-content-id="0728daae-21c0-401c-b410-cb252946effe" data-problem-comparator="integer" data-problem-type="input" data-solution="96">
    <problem>
      <para> Find the product in Row b.
          </para>
        <para> Enter your answer here: </para>
    </problem>
    <solution>
      <para>Correct! 2 times 48 is 96.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 7.1.2 – 7.1.3. 
      </para>
    </div>
    </exercise>
  <!--1c-->
  <exercise data-content-id="afe95dd3-a516-43ec-b210-ee6bd60ec0ed" data-problem-comparator="integer" data-problem-type="input" data-solution="400">
    <problem>
      <para> Find the product in Row c.
          </para>
        <para> Enter your answer here: </para>
    </problem>
    <solution>
      <para>Correct! 10 times 40 is 400.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 7.1.2 – 7.1.3. </para>
    </div>
    </exercise>
  <!--2a-->
  <exercise data-content-id="9413357b-ef26-4b49-81e1-b738b2a4b131" data-problem-comparator="integer" data-problem-type="input" data-solution="5">
    <problem>
      <para>Use the following table to answer questions 2 – 5.</para>
      <para>Here are some lengths and widths of a rectangle whose perimeter is 20 meters.</para>
      <table class="os-raise-wideequaltable">
        <thead>
          <row>
            <entry scope="col" class="emphasis">Row</entry>
            <entry scope="col" class="emphasis">Length (meters)</entry>
            <entry scope="col" class="emphasis">Width (meters)</entry>
            <entry scope="col" class="emphasis">Area (square meters)</entry>
          </row>
        </thead>
        <tbody>
          <row>
            <entry>a</entry>
            <entry>1</entry>
            <entry>9</entry>
            <entry> </entry>
          </row>
          <row>
            <entry>b</entry>
            <entry>3</entry>
            <entry>7</entry>
            <entry> </entry>
          </row>
          <row>
            <entry>c</entry>
            <entry>5</entry>
            <entry> </entry>
            <entry> </entry>
          </row>
          <row>
            <entry>d</entry>
            <entry>7</entry>
            <entry> </entry>
            <entry> </entry>
          </row>
          <row>
            <entry>e</entry>
            <entry>9</entry>
            <entry> </entry>
            <entry> </entry>
          </row>
        </tbody>
      </table>
      <para>Complete the <emphasis>Width</emphasis> column of the table.</para>
      <para> Width in Row c

          </para>
        <para> Enter your answer here: </para>
    </problem>
    <solution>
      <para>Correct! If the length is 5, the width must be 5.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 7.1.3.</para>
    </div>
    </exercise>
  <!--2b-->
  <exercise data-content-id="3bdbe4a2-8ac9-4461-8e39-cab8b8c02048" data-problem-comparator="integer" data-problem-type="input" data-solution="3">
    <problem>
      <para> Width in Row d
          </para>
        <para> Enter your answer here: </para>
    </problem>
    <solution>
      <para>Correct! If the length is 7, the width must be 3.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 7.1.3.</para>
    </div>
    </exercise>
  <!--t2c-->
  <exercise data-content-id="8c6e57ab-e5ec-4735-bb3c-e9296390b2f0" data-problem-comparator="integer" data-problem-type="input" data-solution="1">
    <problem>
      <para> Width in Row e
          </para>
        <para> Enter your answer here: </para>
    </problem>
    <solution>
      <para>Correct! If the length is 9, the width is 1.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 7.1.3.</para>
    </div>
    </exercise>
  <!--3a-->
  <exercise data-content-id="d3705748-965d-4519-81a4-22a359660d91" data-problem-comparator="integer" data-problem-type="input" data-solution="9">
    <problem>
      <para>Complete the <emphasis>Area</emphasis> column of the table. What do you notice about the areas?<para> Enter your answer here: </para>
        </para>
      <para> Area in Row a
          </para>
        <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! 1 times 9 is 9.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 7.1.3.</para>
    </div>
    </exercise>
  <!--3b-->
  <exercise data-content-id="b3be8fc8-90dd-4020-afff-fecc37ee83c3" data-problem-comparator="integer" data-problem-type="input" data-solution="21">
    <problem>
      <para> Area in Row b
          </para>
        <para> Enter your answer here: </para>
    </problem>
    <solution>
      <para>Correct! 3 times 7 is 21.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 7.1.3.</para>
    </div>
    </exercise>
  <!--3c-->
  <exercise data-content-id="28905c62-873f-4998-8834-2875d93e14bb" data-problem-comparator="integer" data-problem-type="input" data-solution="25">
    <problem>
      <para> Area in Row c
          </para>
        <para> Enter your answer here: </para>
    </problem>
    <solution>
      <para>Correct! 5 times 5 is 25.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 7.1.3.</para>
    </div>
    </exercise>
  <!--3d-->
  <exercise data-content-id="c2123080-4bef-4b47-83bf-ad4a201a5385" data-problem-comparator="integer" data-problem-type="input" data-solution="21">
    <problem>
      <para> Area in Row d
          </para>
        <para> Enter your answer here: </para>
    </problem>
    <solution>
      <para>Correct! 7 times 3 is 21.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 7.1.3.</para>
    </div>
    </exercise>
  <!--3e-->
  <exercise data-content-id="49e0db2c-26d0-4a5d-ae10-5644da180b14" data-problem-comparator="integer" data-problem-type="input" data-solution="9">
    <problem>
      <para> Area in Row e
          </para>
        <para> Enter your answer here: </para>
    </problem>
    <solution>
      <para>Correct! 1 times 9 is 9.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 7.1.3.</para>
    </div>
    </exercise>
  <!--4-->
  <exercise data-content-id="d02a5393-96ee-4823-b3bd-575d5e8a35ef" data-problem-type="dropdown" data-retry-limit="1" data-solution="less than" data-solution-options="[&quot;greater than&quot;, &quot;less than&quot;]">
    <problem>
      <para>Without calculating, predict whether the area of the rectangle will be greater than or less than 25 square
          meters if the length is 5.25 meters.</para>
      </problem>
    <solution>
      <para>Correct! When the length is 5.25, the width will be 4.75, so it can be estimated that the product of those
        numbers will be less than 25.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 7.1.3.</para>
    </div>
    </exercise>
  <!--5-->
  <exercise data-content-id="2c91b4ba-3408-4fa1-ba80-b510c31a9a90" data-problem-type="dropdown" data-retry-limit="3" data-solution="not linear and not exponential" data-solution-options="[&quot;linear&quot;, &quot;exponential&quot;, &quot;linear and exponential&quot;, &quot;not linear and not exponential&quot;]">
    <problem>
      <para>Plot the points for length and area from your table. Do the values change in a linear way? Do they change in
          an exponential way?

        </para>
      </problem>
    <solution>
      <para>Correct! As the length increases, the area increases then decreases.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activities 7.1.3 – 7.1.4 to test your understanding? Then come
        back and try this question again.</para>
    </div>
    </exercise>
  <!--6b-->
  <exercise data-content-id="0b7d1133-8e47-4d76-a04a-36a5d5a241c9" data-problem-comparator="integer" data-problem-type="input" data-solution="0">
    <problem>
      <para>Use the following to answer questions 6 – 8.</para>
      <para>Copies of a book are arranged in a stack. Each copy of a book is 2.1 cm thick.</para>
      <table class="os-raise-wideequaltable">
        <thead>
          <row>
            <entry scope="col" class="emphasis">Row</entry>
            <entry scope="col" class="emphasis">Copies of book</entry>
            <entry scope="col" class="emphasis">Stack height in cm</entry>
          </row>
        </thead>
        <tbody>
          <row>
            <entry>a</entry>
            <entry>0</entry>
            <entry> </entry>
          </row>
          <row>
            <entry>b</entry>
            <entry>1</entry>
            <entry> </entry>
          </row>
          <row>
            <entry>c</entry>
            <entry>2</entry>
            <entry> </entry>
          </row>
          <row>
            <entry>d</entry>
            <entry>3</entry>
            <entry> </entry>
          </row>
          <row>
            <entry>e</entry>
            <entry>4</entry>
            <entry> </entry>
          </row>
        </tbody>
      </table>
      <para>Complete the table.</para>
      <para> Stack height in Row a
          </para>
        <para> Enter your answer here: </para>
    </problem>
    <solution>
      <para>Correct! When there are 0 books, there is no stack height.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 7.1.4. </para>
    </div>
    </exercise>
  <!--6b-->
  <exercise data-content-id="38e1ff43-c26b-43fc-9560-947c7ee6ea56" data-problem-comparator="float" data-problem-type="input" data-solution="2.1">
    <problem>
      <para> Stack height in Row b

          </para>
        <para> Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! One book has a height of 2.1 cm.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 7.1.4. </para>
    </div>
    </exercise>
  <!--6c-->
  <exercise data-content-id="419a0986-7b9f-40e3-828e-2fbe9ee4043e" data-problem-comparator="float" data-problem-type="input" data-solution="4.2">
    <problem>
      <para> Stack height in Row c
          </para>
        <para> Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! Two books have a stack height of 2.1 cm times 2.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 7.1.4. </para>
    </div>
    </exercise>
  <!--6d-->
  <exercise data-content-id="4defe410-53c8-467c-b4cf-a2518bf97b3f" data-problem-comparator="float" data-problem-type="input" data-solution="6.3">
    <problem>
      <para> Stack height in Row d

          </para>
        <para> Enter your answer here:</para>
    </problem>
    <solution>
      <para> Correct! Three books have a stack height of 2.1 cm times 3.
      </para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 7.1.4. 
      </para>
    </div>
    </exercise>
  <!--6e-->
  <exercise data-content-id="465ca85a-f0bd-4661-8ae6-478e3280142b" data-problem-comparator="float" data-problem-type="input" data-solution="8.4">
    <problem>
      <para> Stack height in Row e
          </para>
        <para dir="ltr" id="docs-internal-guid-6914cf65-7fff-1a89-fad7-cce3243c16ca"> Enter your answer here:</para>
    </problem>
    <solution>
      <para> Correct! Four books have a stack height of 2.1 cm times 4.
      </para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 7.1.4. </para>
    </div>
    </exercise>
  <!--7-->
  <exercise data-content-id="90ba40e9-2d43-41d8-b4e6-cc9fc03e6d17" data-problem-comparator="float" data-problem-type="input" data-solution="2.1">
    <problem>
      <para>What is the difference in the height of the stack of books when a new copy of the book is added?
        </para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! 2.1</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 7.1.4. </para>
    </div>
    </exercise>
  <!--8-->
  <exercise data-content-id="e2ebe3a0-0691-4779-920c-ad91d7934afc" data-problem-type="multiplechoice" data-retry-limit="3" data-solution="\((2.1)b\)" data-solution-options="[&quot;\\((2.1)b\\)&quot;, &quot;\\(2.1 +b\\)&quot;, &quot;\\(2.1(b-1)\\)&quot;, &quot;\\(2.1^b\\)&quot;]">
    <problem>
      <para>How high is a stack of \(b\) books, in centimeters?
        </para>
      </problem>
    <solution>
      <para>Correct! Each book is 2.1 cm, so multiply that by the number of books in the stack.</para>
    </solution>
    <div class="os-raise-ib-pset-encourage-response">
      <para>Try again. Revisit activity 7.1.4. </para>
    </div>
    </exercise>
