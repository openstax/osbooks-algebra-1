  <content>
    <section id="sect-00001">
      <title>Activity</title>
      <para id="para-00001">Here are the four systems of equations you saw in the previous exercise. Solve
      each system. Then, check your solutions by substituting them into the original equations to
      see if the equations are true.</para>

<para id="para-00002">Use this system of equations to answer 1 - 3.</para>
<para id="para-00003"><quote id="quote-00001">\(
      \begin{cases} x+2y=8 \\ x=-5 \end{cases} \)</quote></para>
        
      <exercise id="_33e05120-8501-4662-a3b6-de1b951fed45" class="multiple-choice">
          <problem id="prob-00001">
            <para id="para-00004">What is the \(x\) value?</para>
          </problem>
          <solution id="sol-00001">
            <para id="para-00005">Correct! -5</para>
            <para id="para-00006">Nice try! The correct answer is -5.</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->

        <exercise id="_87fd46c3-c34f-4e52-9d7b-11f15c891706" class="multiple-choice">
          <problem id="prob-00002">
            <para id="para-00007">What is the \(y\) value?</para>
          </problem>
          <solution id="sol-00002">
            <para id="para-00008">Correct! 6.5</para>
            <para id="para-00009">Nice try! The correct answer is 6.5.</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

      <!--Q3-->

        <exercise id="exer-00001">
          <problem id="prob-00003">
            <para id="para-00010">Explain your solution.</para>
            <para id="para-00011">Write down your answer, then select the <emphasis>solution</emphasis> button to
      compare your work.</para>

          </problem>
          <solution id="sol-00003">
            <para id="para-00012">Compare your answer: Your answer may vary, but here is a sample.</para>

            <!--BEGIN
            ALIGN TO EQUALS -->

            <para id="para-00013">\(\begin{array}{rcl} -5+2y&amp;=&amp;8 \\ 2y&amp;=&amp;13 \\ y&amp;=&amp;6.5 \\
      \end{array}\)</para>

            <!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            ALIGN TO EQUALS -->

            <para id="para-00014">\(\begin{array}{rcl} x+2y&amp;=&amp;8 \\ x+2(6.5)&amp;=&amp;8 \\ x+13&amp;=&amp;8
      \\ x&amp;=&amp;-5 \\ \end{array}\)</para>

            <!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            SIDE BY SIDE EQUATIONSS-->

            <para id="para-00015">\(\begin{array}{rr} -5+2(6.5) &amp;  \\ -5+13\overset?=8 &amp;   \\ 8=8\checkmark
      &amp; -5=-5\checkmark \end{array}\)</para>
          </solution>
        </exercise>
<!--Interaction
      End -->

      <!-- END CLICK TO REVEAL NO TEXTBOX -->

<para id="para-00016">Use
      this system of equations to answer 4 - 6.</para>
<para id="para-00017"><quote id="quote-00002">\( \begin{cases} y=-7x+13 \\ y=-1
      \end{cases} \)</quote></para>
      
        <exercise id="_0ae1e72a-e2e2-40a0-981c-fe272df87e4e" class="multiple-choice">
          <problem id="prob-00004">
            <para id="para-00018">What is the \(x\) value?</para>
          </problem>
          <solution id="sol-00004">
            <para id="para-00019">Correct! 2</para>
            <para id="para-00020">Nice try! The correct answer is 2.</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->

        <exercise id="_4c6b5402-b88f-4e34-ae9d-a9984f3ce7ef" class="multiple-choice">
          <problem id="prob-00005">
            <para id="para-00021">What is the \(y\) value?</para>
          </problem>
          <solution id="sol-00005">
            <para id="para-00022">Correct! -1</para>
            <para id="para-00023">Nice try! The correct answer is -1.</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

      <!--Q6-->

        <exercise id="exer-00002">
          <problem id="prob-00006">
            <para id="para-00024">Explain your solution.</para>
            <para id="para-00025">Write down your answer, then select the <emphasis>solution</emphasis> button to
      compare your work.</para>
          </problem>
          <solution id="sol-00006">
            <para id="para-00026">Compare your answer: Your answer may vary, but here is a sample.</para>

            <!--BEGIN
            ALIGN TO EQUALS -->

            <para id="para-00027">\(\begin{array}{rcl} -1&amp;=&amp;-7x+13 \\ -14&amp;=&amp;-7x \\ 2&amp;=&amp;x \\
      \end{array}\)</para>

            <!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            ALIGN TO EQUALS -->

            <para id="para-00028">\(\begin{array}{rcl} y&amp;=&amp;-7(2)+13 \\ y&amp;=&amp;-14+13 \\ y&amp;=&amp;-1
      \\ \end{array}\)</para>

            <!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            SIDE BY SIDE EQUATIONSS-->

            <para id="para-00029">\(\begin{array}{rr} -1=-7(2)+13 &amp;  \\ -1\overset?=-14+13 &amp;   \\
      -1=-1\checkmark &amp; -1=-1\checkmark \end{array}\)</para>

            <!--END
            SIDE BY SIDE EQUATIONS -->

          </solution>
        </exercise>
<!--Interaction
      End -->

      <!-- END CLICK TO REVEAL NO TEXTBOX -->

<para id="para-00030">Use
      this system of equations to answer questions 7 – 9.</para>
<para id="para-00031"><quote id="quote-00003">\( \begin{cases} 3x=8
      \\ 3x+y=15 \end{cases} \)</quote></para><!-- BEGIN TEXT ENTRY WITH REVEAL -->

      <!--Q7-->
<exercise id="exer-00003">
        <problem id="prob-00007">
          <para id="para-00032">What is the \(x\) value?</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00033">Compare your answer:</para>
          <para id="para-00034">\(\frac83\)</para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!-- END TEXT ENTRY WITH REVEAL -->

        <exercise id="e2300059-170e-434b-8579-fb53c25d4009" class="multiple-choice">
          <problem id="prob-00008">
            <para id="para-00035">What is the \(y\) value?</para>
          </problem>
          <solution id="sol-00008">
            <para id="para-00036">Correct! 7</para>
            <para id="para-00037">Nice try! The correct answer is 7.</para>
          </solution>
          </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

      <!--Q9-->
        <exercise id="exer-00004">
          <problem id="prob-00009">
            <para id="para-00038">Explain your solution.</para>
            <para id="para-00039">Write down your answer, then select the <emphasis>solution</emphasis> button to
      compare your work.</para>

          </problem>
          <solution id="sol-00009">
            <para id="para-00040">Compare your answer: Your answer may vary, but here is a sample.</para>

            <!--BEGIN
            ALIGN TO EQUALS -->

            <para id="para-00041">\(\begin{array}{rcl} 3x&amp;=&amp;8 \\ x&amp;=&amp;\frac83 \\ \end{array}\)</para>

            <!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            ALIGN TO EQUALS -->

            <para id="para-00042">\(\begin{array}{rcl} 3(\frac83)+y&amp;=&amp;15 \\ 8+y&amp;=&amp;15 \\
      y&amp;=&amp;=7 \\ \end{array}\)</para>

            <!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            SIDE BY SIDE EQUATIONSS-->

            <para id="para-00043">\(\begin{array}{rr} 3(\frac83)+7=15 &amp;  \\ -8+7\overset?=15 &amp;
      3(\frac83)\overset?=8 \\ 15=15\checkmark &amp; 8=8\checkmark \end{array}\)</para>

            <!--END
            SIDE BY SIDE EQUATIONS -->
          </solution>
        </exercise>
      <!--Interaction
      End -->

      <!-- END CLICK TO REVEAL NO TEXTBOX -->
<para id="para-00044">Use
      this system of equations to answer questions 10 – 12.</para>
<para id="para-00045"><quote id="quote-00004">\( \begin{cases} y =
      2x - 7\\4 + y = 12 \end{cases} \)</quote></para>
        <exercise id="c85bb0b1-e9e3-4eac-b420-b6a41f408b51" class="multiple-choice">
          <problem id="prob-00010">
            <para id="para-00046">What is the \(x\) value?</para>
          </problem>
          <solution id="sol-00010">
            <para id="para-00047">Correct! 7.5</para>
            <para id="para-00048">Nice try! The correct answer is 7.5.</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->
        <exercise id="_94b30b3d-b4f5-412f-8b91-38dcf27a31a6" class="multiple-choice">
          <problem id="prob-00011">
            <para id="para-00049">What is the \(y\) value?</para>
          </problem>
          <solution id="sol-00011">
            <para id="para-00050">Correct! 8</para>
            <para id="para-00051">Nice try! The correct answer is 8.</para>
          </solution>
        </exercise>
<!--
      END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

      <!--Q12-->
        <exercise id="exer-00005">
          <problem id="prob-00012">
            <para id="para-00052">Explain your solution.</para>
            <para id="para-00053">Write down your answer, then select the <emphasis>solution</emphasis> button to
      compare your work.</para>

          </problem>
          <solution id="sol-00012">
            <para id="para-00054">Compare your answer: Your answer may vary, but here is a sample.</para>

            <!--BEGIN
            ALIGN TO EQUALS -->

            <para id="para-00055">\(\begin{array}{rcl} 4+y&amp;=&amp;12 \\ y&amp;=&amp;8 \\ \end{array}\)</para>

            <!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            ALIGN TO EQUALS -->

            <para id="para-00056">\(\begin{array}{rcl} 8&amp;=&amp;2x-7 \\ 15&amp;=&amp;2x \\ 7.5&amp;=&amp;x \\
      \end{array}\)</para>

            <!--END
            ALIGN TO EQUALS -->


            <!--BEGIN
            SIDE BY SIDE EQUATIONSS-->

            <para id="para-00057">\(\begin{array}{rr} 8=2(7.5)-7 &amp;   \\ 8=2(7.5)-7 &amp; 4+y=12\\
      8\overset?=15-7 &amp; 4+8\overset?=12\\ 8=8\checkmark &amp; 12=12\checkmark \end{array}\)</para>

            <!--END
            SIDE BY SIDE EQUATIONS -->

          </solution>
        </exercise>
<!--Interaction
      End -->

      <!-- END CLICK TO REVEAL NO TEXTBOX -->
      </section>

      <section id="sect-00002">
      <title>Video: Checking Solutions in Systems</title>
      <para id="para-00058">Watch the following
      video to learn more about systems. If you have any questions, play the video again or ask your
      teacher for clarification.</para>
  
     <media alt="Placeholder for Alt Text">
        <iframe width="660" height="371.4" src="https://k12.openstax.org/contents/raise/resources/e35f48c3ec056f1c0b629aae7aa82fb14f96b2b0"/>
      </media>
    </section>

    <section id="sect-00003">
      <note class="self-check" id="note-00001">
        <para id="para-00059">Solve the following system of equations. Check to see if your
        solution makes each equation true.</para>
  <para id="para-00060">
        \(\left\{\begin{array}{l}3x\;+\;y\;=\;6\\x\;+\;2y\;=\;7\end{array}\right.\)</para>
      </note>
    </section>

    <section id="sect-00004">
      <title>Additional Resources</title>

      <section id="sect-00005">
        <title>Solving Systems of Linear Equations</title>
        <para id="para-00061">Let’s solve this system of linear equations using the substitution method.</para>
        <para id="para-00062">\(\left\{\begin{array}{l}2x\;+\;y\;=\;7\\x\;-\;2y\;=\;6\end{array}\right.\)</para>
        <para id="para-00063">We will first solve one of the equations for either \(x\) or \(y\). We can choose either
          equation and solve for either variable—but we’ll try to make a choice that will keep the
          work easy.</para>
        <para id="para-00064">Then we substitute that expression into the other equation. The result is an equation
          with just one variable—and we know how to solve those!</para>
        <para id="para-00065">After we find the value of one variable, we will substitute that value into one of the
          original equations and solve for the other variable. Finally, we check our solution and make
          sure it makes both equations true.</para>
  
        <note id="note-00002">
          <title>How to Solve a System of Equations by Substitution</title>
    <para id="para-00066"><emphasis>Step 1 -</emphasis>
          Solve one of the equations for either variable.</para>
    <para id="para-00067"><emphasis>Step 2 -</emphasis>
          Substitute the expression from Step 1 into the other equation.</para>
    <para id="para-00068"><emphasis>Step 3
          -</emphasis> Solve the resulting equation.</para>
    <para id="para-00069"><emphasis>Step 4 -</emphasis>
          Substitute the solution from Step 3 into one of the original equations to find the other
          variable.</para>
    <para id="para-00070"><emphasis>Step 5 -</emphasis> Write the solution as an ordered pair.</para>
    <para id="para-00071"><emphasis>Step
          6 -</emphasis> Check that the ordered pair is a solution to both original equations.</para>
        </note>
  
        <para id="para-00072">Solve the system by substitution:
          \(\left\{\begin{array}{l}2x\;+\;y\;=\;7\\x\;-\;2y\;=\;6\end{array}\right.\)</para>
        <section id="sect-00006">
          <title>Solution</title>
        <para id="para-00073"><emphasis>Step 1 -</emphasis> Solve one of the equations for either variable.</para>
        <para id="para-00074">We’ll solve the first equation for y.</para>
        <para id="para-00075">\(\begin{array}{c}\left\{\begin{array}{l}2x+y=7\\x-2y=6\end{array}\right.\end{array}\)</para>
        <para id="para-00076">\( \begin{array}{rcl}2x+y&amp;=&amp;7\\y&amp;=&amp;7-2x\\&amp;&amp;\end{array}\)</para>
        <para id="para-00077"><emphasis>Step 2 -</emphasis> Substitute the expression from Step 1 into the other
          equation.</para>
        <para id="para-00078">\( \begin{array}{rcl}x-2y&amp;=&amp;6\\x-2(7-2x)&amp;=&amp;6\\&amp;&amp;\end{array}\)</para>
        <para id="para-00079"><emphasis>Step 3 -</emphasis> Solve the resulting equation.</para>
        <para id="para-00080">Now we have an equation with just 1 variable. We know how to solve this!</para>
        <para id="para-00081">
          \(
          \begin{array}{rcl}x-2(7-2x)&amp;=&amp;6\\x-14+4x&amp;=&amp;6\\5x&amp;=&amp;20\\x&amp;=&amp;4\\&amp;&amp;\end{array}\)</para>
        <para id="para-00082"><emphasis>Step 4 -</emphasis> Substitute the solution from Step 3 into one of the
          original equations to find the other variable.</para>
        <para id="para-00083">We’ll us the first equation and replace \(x\) with 4.</para>
        <para id="para-00084">
          \(
          \begin{array}{rcl}2x+y&amp;=&amp;7\\2(4)+y&amp;=&amp;7\\8+y&amp;=&amp;7\\y&amp;=&amp;-1\\&amp;&amp;\end{array}\)</para>
        <para id="para-00085"><emphasis>Step 5 -</emphasis> Write the solution as an ordered pair.</para>
        <para id="para-00086">The ordered pair is \((x,y)\).</para>
        <para id="para-00087">\((4,-1)\)</para>
  
        <para id="para-00088"><emphasis>Step 6 -</emphasis> Check that the ordered pair is a solution to both original
          equations.</para>
        <para id="para-00089">Substitute \(x=4\), \(y=-1\) into both equations and make sure they are both true.</para>
        <!--BEGIN
        SIDE BY SIDE EQUATIONSS-->
        <para id="para-00090">\(\begin{array}{rvr} 2x+y=7 &amp;   &amp;x-2y=6 \\ 2(4)+(-1)\overset?=7 &amp;   &amp;
          4-2(-1)\overset?=6 \\ 7=7\checkmark &amp;   &amp; 6=6\checkmark \end{array}\)</para>
        <!--END
        SIDE BY SIDE EQUATIONS -->
        <para id="para-00091">Both equations are true.</para>
        <para id="para-00092">\((4,-1)\) is the solution to the system.</para>
        </section>
        <note class="try look-at-me" id="note-00003">
        <title>Try It: Solving Systems of Linear Equations</title>
        <!--BEGIN
        MULTIPLE CHOICE -->

          <exercise id="bbdef143-5768-4382-9d92-567213e895f4" class="multiple-choice">
            <problem id="prob-00013">
              <para id="para-00093">Solve the system by substitution, then choose the correct ordered pair.
                \(\left\{\begin{array}{l}-2x\;+\;y\;=\;-11\\x\;+\;3y\;=\;9\end{array}\right.\)</para>
              <para id="para-00094">Multiple Choice:</para>
              <para id="para-00095">\((9,-11)\)</para>
              <para id="para-00096">\((1,6)\)</para>
              <para id="para-00097">\((6,1)\)</para>
              <para id="para-00098">\((-11,9)\)</para>
            </problem>
            <solution id="sol-00013">
              <para id="para-00099">Correct! \((6,1)\)</para>
              <para id="para-00100">Nice try! The correct answer is \((6,1)\).</para>
              <para id="para-00101">This is the solution.</para>
              <para id="para-00102"><emphasis>Step 1 -</emphasis> Solve the first equation for \( y \) to isolate a
                variable.Solve the first equation for \( y \) to isolate a variable.</para>
              <para id="para-00103">\(\begin{array}{rcl}-2x + y &amp;= &amp;-11 \\ -2x\; {\style{color:red} +
                }\;{\style{color:red} 2}{\style{color:red} x } + y &amp;=&amp;-11\;{\style{color:red}
                + }{\style{color:red} 2}\;{\style{color:red}x } \\ y&amp;=&amp;-11 + 2x \\
                \end{array}\)</para>
              <para id="para-00104"><emphasis>Step 2 -</emphasis> Replace the \(y\) in the second equation with the
                expression \( -11 + 2x \).Replace the \(y\) in the second equation with the expression
                \( -11 + 2x \).</para>
              <para id="para-00105">\(\begin{array}{rcl}x + 3y&amp;= &amp;9 \\ x +
                3\;{\style{color:red}(}{\style{color:red}–}{\style{color:red}1}{\style{color:red}1}\;{\style{color:red}
                +}\;{\style{color:red} 2}{\style{color:red}x}{\style{color:red})} &amp;=&amp;9 \\ x -
                33 + 6x&amp;=&amp;9 \\ \end{array}\)</para>
              <para id="para-00106"><emphasis>Step 3 -</emphasis> Solve the equation with just one variable.Solve the
                equation with just one variable.</para>
              <para id="para-00107">Now we have an equation with just 1 variable. We know how to solve this!</para>
              <para id="para-00108">\(\begin{array}{rcl}7x &amp;= &amp;42 \\ x&amp;=&amp;6 \\ \end{array}\)</para>
              <para id="para-00109"><emphasis>Step 4 -</emphasis> Use the first equation and replace \( x \) with
                6.Use the first equation and replace \( x \) with 6.</para>
              <para id="para-00110">\(\begin{array}{rcl}-2x + y &amp;= &amp;-11 \\
                -2{\style{color:red}(}{\style{color:red}6}{\style{color:red})} + y &amp;=&amp;-11 \\
                -12 + y&amp;= &amp;-11 \\ y&amp;=&amp;1 \\ \end{array}\)</para>
              <para id="para-00111"><emphasis>Step 5 -</emphasis> The ordered pair is \((x, y)\).The ordered pair is
                \((x, y)\).</para>
              <para id="para-00112">\((6, 1)\)</para>
              <para id="para-00113"><emphasis>Step 6 -</emphasis> Substitute \( x=6 \), \( y=1 \) to check the
                solution in both equations.Substitute \( x=6 \), \( y=1 \) to check the solution in
                both equations.</para>
              <para id="para-00114">\(\begin{array}{rr} -2x + y = -11&amp;   &amp;\\
                -2{\style{color:red}(}{\style{color:red}6}{\style{color:red})} +
                {\style{color:red}(}{\style{color:red}1}{\style{color:red})}\overset?=-11 &amp;  
                &amp; x + 3y = 9\\ -12 + 1\overset?=-11 &amp;   &amp;
                {\style{color:red}(}{\style{color:red}6}{\style{color:red})} +
                3{\style{color:red}(}{\style{color:red}1}{\style{color:red})}\overset?=9\\ -11 =
                -11{\style{color:red}\checkmark } &amp;   &amp; 9 = 9{\style{color:red}\checkmark }\\
                \end{array}\)</para>
            </solution>
          </exercise>
          </note>
 
      </section>
    </section>
  </content>
