                </m:mtable>
              </m:mrow>
            </m:math></para><!--END
            ALIGN TO EQUALS -->


          <!--BEGIN
            SIDE BY SIDE EQUATIONSS-->

          <para id="para-00057"><m:math>
              <m:mrow>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>8</m:mn>
                      <m:mo>=</m:mo>
                      <m:mn>2</m:mn>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mn>7.5</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>7</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="right"/>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>8</m:mn>
                      <m:mo>=</m:mo>
                      <m:mn>2</m:mn>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mn>7.5</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>7</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="right">
                      <m:mn>4</m:mn>
                      <m:mo>+</m:mo>
                      <m:mi>y</m:mi>
                      <m:mo>=</m:mo>
                      <m:mn>12</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>8</m:mn>
                      <m:mover>
                        <m:mo>=</m:mo>
                        <m:mo>?</m:mo>
                      </m:mover>
                      <m:mn>15</m:mn>
                      <m:mo>−</m:mo>
                      <m:mn>7</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="right">
                      <m:mn>4</m:mn>
                      <m:mo>+</m:mo>
                      <m:mn>8</m:mn>
                      <m:mover>
                        <m:mo>=</m:mo>
                        <m:mo>?</m:mo>
                      </m:mover>
                      <m:mn>12</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>8</m:mn>
                      <m:mo>=</m:mo>
                      <m:mn>8</m:mn>
                      <m:mi>✓</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="right">
                      <m:mn>12</m:mn>
                      <m:mo>=</m:mo>
                      <m:mn>12</m:mn>
