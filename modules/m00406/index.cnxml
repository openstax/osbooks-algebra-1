  <!--Q2-->
  <exercise data-content-id="87fd46c3-c34f-4e52-9d7b-11f15c891706" data-problem-comparator="integer" data-problem-type="input" data-solution="6.5">
    <problem>
      <para>What is the \(y\) value?</para>
      <para>Enter your answer here:</para>
    </problem>
    <solution>
      <para>Correct! 6.5</para>
