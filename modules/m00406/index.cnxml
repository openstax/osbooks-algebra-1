<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <title>Checking Solutions in Systems</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00406</md:content-id>
    <md:title>Checking Solutions in Systems</md:title>
    <md:uuid>6240f108-26c6-4ebd-b2bf-8185e8b986c6</md:uuid>
  </metadata>
  <content>
    <section class="numbered-exercises" id="sect-00001">
      <title>Activity</title>
      <para id="para-00001">Here are the four systems of equations you saw in the previous exercise. Solve each system. Then, check your solutions by substituting them into the original equations to see if the equations are true.</para>

      <para id="para-00002">Use this system of equations to answer 1 - 3.</para>
      <quote id="quote-00001"><m:math>
          <m:mrow>
            <m:mrow>
              <m:mo stretchy="true" fence="true" form="prefix">{</m:mo>
              <m:mtable>
                <m:mtr>
                  <m:mtd columnalign="left">
                    <m:mi>x</m:mi>
                    <m:mo>+</m:mo>
                    <m:mn>2</m:mn>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>8</m:mn>
                  </m:mtd>
                </m:mtr>
                <m:mtr>
                  <m:mtd columnalign="left">
                    <m:mi>x</m:mi>
                    <m:mo>=</m:mo>
                    <m:mo>−</m:mo>
                    <m:mn>5</m:mn>
                  </m:mtd>
                </m:mtr>
              </m:mtable>
            </m:mrow>
          </m:mrow>
        </m:math></quote>


      <exercise id="_33e05120-8501-4662-a3b6-de1b951fed45" class="multiple-choice">
        <problem id="prob-00001">
          <para id="para-00004">What is the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math> value?</para>
        </problem>
        <solution id="sol-00001">
          <para id="para-00005">-5</para>
        </solution>
      </exercise>
      <!--
      END ACTIVITY INPUT 1 TRY -->

      <exercise id="_87fd46c3-c34f-4e52-9d7b-11f15c891706" class="multiple-choice">
        <problem id="prob-00002">
          <para id="para-00007">What is the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math> value?</para>
        </problem>
        <solution id="sol-00002">
          <para id="para-00008">6.5</para>
        </solution>
      </exercise>
      <!--
      END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

      <!--Q3-->

      <exercise id="exer-00001">
        <problem id="prob-00003">
          <para id="para-00010">Explain your solution.</para>
          <para id="para-00011"/>

        </problem>
        <solution id="sol-00003">
          <para id="para-00012">Compare your answer: Your answer may vary, but here is a sample.</para>

          <!--BEGIN
            ALIGN TO EQUALS -->

          <para id="para-00013"><m:math>
              <m:mrow>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mn>5</m:mn>
                      <m:mo>+</m:mo>
                      <m:mn>2</m:mn>
                      <m:mi>y</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>8</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>2</m:mn>
                      <m:mi>y</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>13</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mi>y</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>6.5</m:mn>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
              </m:mrow>
            </m:math></para><!--END
            ALIGN TO EQUALS -->


          <!--BEGIN
            ALIGN TO EQUALS -->

          <para id="para-00014"><m:math>
              <m:mrow>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>2</m:mn>
                      <m:mi>y</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>8</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>2</m:mn>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mn>6.5</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>8</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>13</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>8</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mi>x</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mo>−</m:mo>
                      <m:mn>5</m:mn>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
              </m:mrow>
            </m:math></para><!--END
            ALIGN TO EQUALS -->


          <!--BEGIN
            SIDE BY SIDE EQUATIONSS-->

          <para id="para-00015"><m:math>
              <m:mrow>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mn>5</m:mn>
                      <m:mo>+</m:mo>
                      <m:mn>2</m:mn>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mn>6.5</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="right"/>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mn>5</m:mn>
                      <m:mo>+</m:mo>
                      <m:mn>13</m:mn>
                      <m:mover>
                        <m:mo>=</m:mo>
                        <m:mo>?</m:mo>
                      </m:mover>
                      <m:mn>8</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="right"/>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>8</m:mn>
                      <m:mo>=</m:mo>
                      <m:mn>8</m:mn>
                      <m:mi>✓</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mn>5</m:mn>
                      <m:mo>=</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>5</m:mn>
                      <m:mi>✓</m:mi>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!-- END CLICK TO REVEAL NO TEXTBOX -->

      <para id="para-00016">Use this system of equations to answer 4 - 6.</para>
      <quote id="quote-00002"><m:math>
          <m:mrow>
            <m:mrow>
              <m:mo stretchy="true" fence="true" form="prefix">{</m:mo>
              <m:mtable>
                <m:mtr>
                  <m:mtd columnalign="left">
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mo>−</m:mo>
                    <m:mn>7</m:mn>
                    <m:mi>x</m:mi>
                    <m:mo>+</m:mo>
                    <m:mn>13</m:mn>
                  </m:mtd>
                </m:mtr>
                <m:mtr>
                  <m:mtd columnalign="left">
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mo>−</m:mo>
                    <m:mn>1</m:mn>
                  </m:mtd>
                </m:mtr>
              </m:mtable>
            </m:mrow>
          </m:mrow>
        </m:math></quote>


      <exercise id="_0ae1e72a-e2e2-40a0-981c-fe272df87e4e" class="multiple-choice">
        <problem id="prob-00004">
          <para id="para-00018">What is the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math> value?</para>
        </problem>
        <solution id="sol-00004">
          <para id="para-00019">2</para>
        </solution>
      </exercise>
      <!--
      END ACTIVITY INPUT 1 TRY -->

      <exercise id="_4c6b5402-b88f-4e34-ae9d-a9984f3ce7ef" class="multiple-choice">
        <problem id="prob-00005">
          <para id="para-00021">What is the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math> value?</para>
        </problem>
        <solution id="sol-00005">
          <para id="para-00022">-1</para>
        </solution>
      </exercise>
      <!--
      END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

      <!--Q6-->

      <exercise id="exer-00002">
        <problem id="prob-00006">
          <para id="para-00024">Explain your solution.</para>
          <para id="para-00025"/>
        </problem>
        <solution id="sol-00006">
          <para id="para-00026">Compare your answer: Your answer may vary, but here is a sample.</para>

          <!--BEGIN
            ALIGN TO EQUALS -->

          <para id="para-00027"><m:math>
              <m:mrow>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mo>−</m:mo>
                      <m:mn>7</m:mn>
                      <m:mi>x</m:mi>
                      <m:mo>+</m:mo>
                      <m:mn>13</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mn>14</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mo>−</m:mo>
                      <m:mn>7</m:mn>
                      <m:mi>x</m:mi>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>2</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mi>x</m:mi>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
              </m:mrow>
            </m:math></para><!--END
            ALIGN TO EQUALS -->


          <!--BEGIN
            ALIGN TO EQUALS -->

          <para id="para-00028"><m:math>
              <m:mrow>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mi>y</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mo>−</m:mo>
                      <m:mn>7</m:mn>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mn>2</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                      <m:mo>+</m:mo>
                      <m:mn>13</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mi>y</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mo>−</m:mo>
                      <m:mn>14</m:mn>
                      <m:mo>+</m:mo>
                      <m:mn>13</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mi>y</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
              </m:mrow>
            </m:math></para><!--END
            ALIGN TO EQUALS -->


          <!--BEGIN
            SIDE BY SIDE EQUATIONSS-->

          <para id="para-00029"><m:math>
              <m:mrow>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                      <m:mo>=</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>7</m:mn>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mn>2</m:mn>
                      <m:mo stretchy="false">)</m:mo>
                      <m:mo>+</m:mo>
                      <m:mn>13</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="right"/>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                      <m:mover>
                        <m:mo>=</m:mo>
                        <m:mo>?</m:mo>
                      </m:mover>
                      <m:mo>−</m:mo>
                      <m:mn>14</m:mn>
                      <m:mo>+</m:mo>
                      <m:mn>13</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="right"/>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                      <m:mo>=</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                      <m:mi>✓</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                      <m:mo>=</m:mo>
                      <m:mo>−</m:mo>
                      <m:mn>1</m:mn>
                      <m:mi>✓</m:mi>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
              </m:mrow>
            </m:math></para><!--END
            SIDE BY SIDE EQUATIONS -->

        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!-- END CLICK TO REVEAL NO TEXTBOX -->

      <para id="para-00030">Use this system of equations to answer questions 7 – 9.</para>
      <quote id="quote-00003"><m:math>
          <m:mrow>
            <m:mrow>
              <m:mo stretchy="true" fence="true" form="prefix">{</m:mo>
              <m:mtable>
                <m:mtr>
                  <m:mtd columnalign="left">
                    <m:mn>3</m:mn>
                    <m:mi>x</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>8</m:mn>
                  </m:mtd>
                </m:mtr>
                <m:mtr>
                  <m:mtd columnalign="left">
                    <m:mn>3</m:mn>
                    <m:mi>x</m:mi>
                    <m:mo>+</m:mo>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>15</m:mn>
                  </m:mtd>
                </m:mtr>
              </m:mtable>
            </m:mrow>
          </m:mrow>
        </m:math></quote>
      <!-- BEGIN TEXT ENTRY WITH REVEAL -->

      <!--Q7-->
      <exercise id="exer-00003">
        <problem id="prob-00007">
          <para id="para-00032">What is the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math> value?</para>
        </problem>
        <solution id="sol-00007">
          <para id="para-00033">Compare your answer: </para>
          <para id="para-00034"><m:math>
              <m:mrow>
                <m:mfrac>
                  <m:mn>8</m:mn>
                  <m:mn>3</m:mn>
                </m:mfrac>
              </m:mrow>
            </m:math></para>
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!-- END TEXT ENTRY WITH REVEAL -->

      <exercise id="e2300059-170e-434b-8579-fb53c25d4009" class="multiple-choice">
        <problem id="prob-00008">
          <para id="para-00035">What is the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math> value?</para>
        </problem>
        <solution id="sol-00008">
          <para id="para-00036">7</para>
        </solution>
      </exercise>
      <!--
      END ACTIVITY INPUT 1 TRY -->
      <!-- BEGIN CLICK TO REVEAL NO TEXTBOX -->

      <!--Q9-->
      <exercise id="exer-00004">
        <problem id="prob-00009">
          <para id="para-00038">Explain your solution.</para>
          <para id="para-00039"/>

        </problem>
        <solution id="sol-00009">
          <para id="para-00040">Compare your answer: Your answer may vary, but here is a sample.</para>

          <!--BEGIN
            ALIGN TO EQUALS -->

          <para id="para-00041"><m:math>
              <m:mrow>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>3</m:mn>
                      <m:mi>x</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>8</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mi>x</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mfrac>
                        <m:mn>8</m:mn>
                        <m:mn>3</m:mn>
                      </m:mfrac>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
              </m:mrow>
            </m:math></para><!--END
            ALIGN TO EQUALS -->


          <!--BEGIN
            ALIGN TO EQUALS -->

          <para id="para-00042"><m:math>
              <m:mrow>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>3</m:mn>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mfrac>
                        <m:mn>8</m:mn>
                        <m:mn>3</m:mn>
                      </m:mfrac>
                      <m:mo stretchy="false">)</m:mo>
                      <m:mo>+</m:mo>
                      <m:mi>y</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>15</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>8</m:mn>
                      <m:mo>+</m:mo>
                      <m:mi>y</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mn>15</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mi>y</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="center">
                      <m:mo>=</m:mo>
                    </m:mtd>
                    <m:mtd columnalign="left">
                      <m:mo>=</m:mo>
                      <m:mn>7</m:mn>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
              </m:mrow>
            </m:math></para><!--END
            ALIGN TO EQUALS -->


          <!--BEGIN
            SIDE BY SIDE EQUATIONSS-->

          <para id="para-00043"><m:math>
              <m:mrow>
                <m:mtable>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>3</m:mn>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mfrac>
                        <m:mn>8</m:mn>
                        <m:mn>3</m:mn>
                      </m:mfrac>
                      <m:mo stretchy="false">)</m:mo>
                      <m:mo>+</m:mo>
                      <m:mn>7</m:mn>
                      <m:mo>=</m:mo>
                      <m:mn>15</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="right"/>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mo>−</m:mo>
                      <m:mn>8</m:mn>
                      <m:mo>+</m:mo>
                      <m:mn>7</m:mn>
                      <m:mover>
                        <m:mo>=</m:mo>
                        <m:mo>?</m:mo>
                      </m:mover>
                      <m:mn>15</m:mn>
                    </m:mtd>
                    <m:mtd columnalign="right">
                      <m:mn>3</m:mn>
                      <m:mo stretchy="false">(</m:mo>
                      <m:mfrac>
                        <m:mn>8</m:mn>
                        <m:mn>3</m:mn>
                      </m:mfrac>
                      <m:mo stretchy="false">)</m:mo>
                      <m:mover>
                        <m:mo>=</m:mo>
                        <m:mo>?</m:mo>
                      </m:mover>
                      <m:mn>8</m:mn>
                    </m:mtd>
                  </m:mtr>
                  <m:mtr>
                    <m:mtd columnalign="right">
                      <m:mn>15</m:mn>
                      <m:mo>=</m:mo>
                      <m:mn>15</m:mn>
                      <m:mi>✓</m:mi>
                    </m:mtd>
                    <m:mtd columnalign="right">
                      <m:mn>8</m:mn>
                      <m:mo>=</m:mo>
                      <m:mn>8</m:mn>
                      <m:mi>✓</m:mi>
                    </m:mtd>
                  </m:mtr>
                </m:mtable>
              </m:mrow>
            </m:math></para><!--END
            SIDE BY SIDE EQUATIONS -->
        </solution>
      </exercise>
      <!--Interaction
      End -->

      <!-- END CLICK TO REVEAL NO TEXTBOX -->
      <para id="para-00044">Use this system of equations to answer questions 10 – 12.</para>
      <quote id="quote-00004"><m:math>
          <m:mrow>
            <m:mrow>
              <m:mo stretchy="true" fence="true" form="prefix">{</m:mo>
              <m:mtable>
                <m:mtr>
                  <m:mtd columnalign="left">
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>2</m:mn>
                    <m:mi>x</m:mi>
                    <m:mo>−</m:mo>
                    <m:mn>7</m:mn>
                  </m:mtd>
                </m:mtr>
                <m:mtr>
                  <m:mtd columnalign="left">
                    <m:mn>4</m:mn>
                    <m:mo>+</m:mo>
                    <m:mi>y</m:mi>
                    <m:mo>=</m:mo>
                    <m:mn>12</m:mn>
                  </m:mtd>
                </m:mtr>
              </m:mtable>
            </m:mrow>
          </m:mrow>
        </m:math></quote>

      <exercise id="c85bb0b1-e9e3-4eac-b420-b6a41f408b51" class="multiple-choice">
        <problem id="prob-00010">
          <para id="para-00046">What is the <m:math display="inline">
              <m:mrow>
                <m:mi>x</m:mi>
              </m:mrow>
            </m:math> value?</para>
        </problem>
        <solution id="sol-00010">
          <para id="para-00047">7.5</para>
        </solution>
      </exercise>
      <!--
      END ACTIVITY INPUT 1 TRY -->
      <exercise id="_94b30b3d-b4f5-412f-8b91-38dcf27a31a6" class="multiple-choice">
        <problem id="prob-00011">
          <para id="para-00049">What is the <m:math display="inline">
              <m:mrow>
                <m:mi>y</m:mi>
              </m:mrow>
            </m:math> value?</para>
        </problem>
        <solution id="sol-00011">
          <para id="para-00050">8</para>
        </solution>
      </exercise>
      <!--
      END ACTIVITY INPUT 1 TRY -->
