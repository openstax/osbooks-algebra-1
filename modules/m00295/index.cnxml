    <row>
      <entry><list>
          <item>slope </item>
          <item>point-slope form (of a linear equation)</item>
          <item>vertical lines</item>
          <item>horizontal lines</item>
        </list></entry>
      <entry><list>
          <item>parallel lines</item>
          <item>perpendicular lines</item>
          <item>reciprocal</item>
          <item>opposite reciprocal</item>
        </list></entry>
    </row>
  </tbody>
</table>

