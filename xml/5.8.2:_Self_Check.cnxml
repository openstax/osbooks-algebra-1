<content>
  <section><para>Which of the following equations represents the values in the table?</para>
<table>
  <tgroup cols="5"><thead/>
  <tbody>
    <row>
      <entry>\(x\)</entry>
      <entry>
        0
      </entry>
      <entry>
        1
      </entry>
      <entry>
       2
      </entry>
      <entry>
        3
      </entry>
    </row>
    <row>
        <entry>\(y\)</entry>
      <entry>
       1
      </entry>
      <entry>
        3
      </entry>
      <entry>
        9
      </entry>
      <entry>
        27
      </entry>
    </row>
  </tbody>
</tgroup></table>
</section>
</content>
