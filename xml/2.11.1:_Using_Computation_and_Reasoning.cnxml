<content>
  <section><title>Warm Up Activity</title>
<para>Here is an expression:</para>
<para>\(2x+3y\)</para>
<para>Decide if the values in each ordered pair, \((x,y)\), make the value of the expression less than, greater than, or equal to 12.</para>
<!--Q1-->
<exercise>
  <problem>
    <para> \((0, 5)\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>greater than 12</para>
  </solution></exercise>
<!--Interaction End -->
<!--Q2-->
<exercise>
  <problem>
    <para> \((6, 0)\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>equal to 12</para>
  </solution></exercise>
<!--Interaction End -->
<!--Q3-->
<exercise>
  <problem>
    <para>\((-1, -1)\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>less than 12</para>
  </solution></exercise>
<!--Interaction End -->
<!--Q4-->
<exercise>
  <problem>
    <para> \((-5, 10)\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>greater than 12</para>
  </solution></exercise>
<!--Interaction End --></section>
</content>
