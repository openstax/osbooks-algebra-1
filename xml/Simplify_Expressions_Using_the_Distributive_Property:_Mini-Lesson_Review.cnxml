<content>
  <section><title>Simplify Expressions Using the Distributive Property</title>
<para>The Distributive Property can be used to remove parentheses as you simplify expressions.</para>
<note>
  <para> <emphasis> DISTRIBUTIVE PROPERTY </emphasis> </para>
  <hr/>
  <para>
    <math display="block" xmlns="http://www.w3.org/1998/Math/MathML">
      <semantics>
        <mrow>
          <mrow>
            <mtable>
              <mtr>
                <mtd columnalign="left">
                  <mtext>If</mtext>
                  <mspace width="0.2em"/>
                  <mi>a</mi>
                  <mo>,</mo>
                  <mi>b</mi>
                  <mo>,</mo>
                  <mi>c</mi>
                  <mspace width="0.2em"/>
                  <mtext>are real numbers, then</mtext>
                </mtd>
                <mtd/>
                <mtd/>
                <mtd columnalign="left">
                  <mi>a</mi>
                  <mo stretchy="false">(</mo>
                  <mi>b</mi>
                  <mo>+</mo>
                  <mi>c</mi>
                  <mo stretchy="false">)</mo>
                  <mo>=</mo>
                  <mi>a</mi>
                  <mi>b</mi>
                  <mo>+</mo>
                  <mi>a</mi>
                  <mi>c</mi>
                </mtd>
              </mtr>
              <mtr/>
              <mtr/>
              <mtr>
                <mtd columnalign="right">
                  <mtext>Also,</mtext>
                </mtd>
                <mtd/>
                <mtd/>
                <mtd columnalign="left">
                  <mo stretchy="false">(</mo>
                  <mi>b</mi>
                  <mo>+</mo>
                  <mi>c</mi>
                  <mo stretchy="false">)</mo>
                  <mi>a</mi>
                  <mo>=</mo>
                  <mi>b</mi>
                  <mi>a</mi>
                  <mo>+</mo>
                  <mi>c</mi>
                  <mi>a</mi>
                </mtd>
              </mtr>
              <mtr>
                <mtd/>
                <mtd/>
                <mtd/>
                <mtd columnalign="left">
                  <mi>a</mi>
                  <mo stretchy="false">(</mo>
                  <mi>b</mi>
                  <mo>−</mo>
                  <mi>c</mi>
                  <mo stretchy="false">)</mo>
                  <mo>=</mo>
                  <mi>a</mi>
                  <mi>b</mi>
                  <mo>−</mo>
                  <mi>a</mi>
                  <mi>c</mi>
                </mtd>
              </mtr>
              <mtr>
                <mtd/>
                <mtd/>
                <mtd/>
                <mtd columnalign="left">
                  <mo stretchy="false">(</mo>
                  <mi>b</mi>
                  <mo>−</mo>
                  <mi>c</mi>
                  <mo stretchy="false">)</mo>
                  <mi>a</mi>
                  <mo>=</mo>
                  <mi>b</mi>
                  <mi>a</mi>
                  <mo>−</mo>
                  <mi>c</mi>
                  <mi>a</mi>
                </mtd>
              </mtr>
            </mtable>
          </mrow>
        </mrow>
        <annotation-xml encoding="MathML-Content">
          <mrow>
            <mtable>
              <mtr>
                <mtd columnalign="left">
                  <mtext>If</mtext>
                  <mspace width="0.2em"/>
                  <mi>a</mi>
                  <mo>,</mo>
                  <mi>b</mi>
                  <mo>,</mo>
                  <mi>c</mi>
                  <mspace width="0.2em"/>
                  <mtext>are real numbers, then</mtext>
                </mtd>
                <mtd/>
                <mtd/>
                <mtd columnalign="left">
                  <mi>a</mi>
                  <mo stretchy="false">(</mo>
                  <mi>b</mi>
                  <mo>+</mo>
                  <mi>c</mi>
                  <mo stretchy="false">)</mo>
                  <mo>=</mo>
                  <mi>a</mi>
                  <mi>b</mi>
                  <mo>+</mo>
                  <mi>a</mi>
                  <mi>c</mi>
                </mtd>
              </mtr>
              <mtr/>
              <mtr/>
              <mtr>
                <mtd columnalign="right">
                  <mtext>Also,</mtext>
                </mtd>
                <mtd/>
                <mtd/>
                <mtd columnalign="left">
                  <mo stretchy="false">(</mo>
                  <mi>b</mi>
                  <mo>+</mo>
                  <mi>c</mi>
                  <mo stretchy="false">)</mo>
                  <mi>a</mi>
                  <mo>=</mo>
                  <mi>b</mi>
                  <mi>a</mi>
                  <mo>+</mo>
                  <mi>c</mi>
                  <mi>a</mi>
                </mtd>
              </mtr>
              <mtr>
                <mtd/>
                <mtd/>
                <mtd/>
                <mtd columnalign="left">
                  <mi>a</mi>
                  <mo stretchy="false">(</mo>
                  <mi>b</mi>
                  <mo>−</mo>
                  <mi>c</mi>
                  <mo stretchy="false">)</mo>
                  <mo>=</mo>
                  <mi>a</mi>
                  <mi>b</mi>
                  <mo>−</mo>
                  <mi>a</mi>
                  <mi>c</mi>
                </mtd>
              </mtr>
              <mtr>
                <mtd/>
                <mtd/>
                <mtd/>
                <mtd columnalign="left">
                  <mo stretchy="false">(</mo>
                  <mi>b</mi>
                  <mo>−</mo>
                  <mi>c</mi>
                  <mo stretchy="false">)</mo>
                  <mi>a</mi>
                  <mo>=</mo>
                  <mi>b</mi>
                  <mi>a</mi>
                  <mo>−</mo>
                  <mi>c</mi>
                  <mi>a</mi>
                </mtd>
              </mtr>
            </mtable>
          </mrow>
        </annotation-xml>
      </semantics>
    </math>
  </para>
</note>
<para>Simplify:</para>
<list class="os-raise-noindent" type="enumerated">
  <item>\(3(x+4)\)<media><image alt="" role="presentation" src="https://k12.openstax.org/contents/raise/resources/1baa8e4eada73ed91541fd584befe88f8f331baf"/></media></item>
</list>
<list class="os-raise-noindent" start="2" type="enumerated">
  <item>\(-11(4-3a)\)<media><image alt="" role="presentation" src="https://k12.openstax.org/contents/raise/resources/300ffabeac240ceeca330110ced133a3c5a87ffd"/></media></item>
</list>
<title> Try It: Simplify Expressions Using the Distributive Property </title>
<example><exercise>
  <problem>
    
    <para>Simplify: \(-2(4y+1)\).</para>
  <para>Write down your answer. Then select the <emphasis>solution</emphasis> button to compare your work. </para>
  </problem><solution>
  <para>Here is how to simplify expressions using the Distributive Property.</para>
  <para>Use arrows to show the Distributive Property.</para>
  <media><image alt="" role="presentation" src="https://k12.openstax.org/contents/raise/resources/5a1f98b219936a55d46552d0be26009bdaccb8eb"/></media><para>Use the Distributive Property.</para>
  <para>Multiply.</para>
  <para>Simplify.</para>
</solution></exercise>
</example><title>Check Your Understanding </title>
<div class="os-raise-ib-pset" data-button-text="Check" data-content-id="780ae659-8d1b-4e1f-a837-2d5579dc36e7" data-fire-learning-opportunity-event="eventnameY" data-fire-success-event="eventnameX" data-retry-limit="0" data-schema-version="1.0">
  <!--Q#-->
  <exercise data-content-id="fe2725a9-e34e-4c6a-ba93-4368602af0de" data-problem-type="multiplechoice" data-solution="\(20-8a\)" data-solution-options="[&quot;\\(20-2a\\)&quot;, &quot;\\(20+2a\\)&quot;, &quot;\\(20-8a\\)&quot;, &quot;\\(20+8a\\)&quot;]">
    <problem>
      <para>Which expression is equivalent to \(4(5-2a)\)?</para>
    </problem>
    <solution>
      <para>Correct! Check yourself: Multiply the factor outside the parentheses by each term inside the parentheses. </para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
