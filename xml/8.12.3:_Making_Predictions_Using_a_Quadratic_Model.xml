  </div>
<problem>
    <list class="os-raise-noindent" start="4" type="enumerated">
      <item>How high will the balloon be after 10 minutes?</item>
    </list>
  </problem><solution>
    <para>Enter the height of the balloon after 10 minutes.</para>
  </solution></exercise>
</exercise><!--Interaction End -->
<br/>
<!--Text Entry Interaction Start -->
<exercise><exercise>
  <div class="os-raise-ib-input-ack">
    <para>Compare your answer:</para>
    <para>At approximately 0.49 minute</para>
  </div>
<problem>
    <list class="os-raise-noindent" start="5" type="enumerated">
      <item>At what time will the balloon first be at a height of 95 feet? (Graph the line \(y = 95\).)</item>
    </list>
  </problem><solution>
    <para>Enter the time the balloon will first be at a height of 95 feet.</para>
  </solution></exercise>
</exercise><!--Interaction End -->
