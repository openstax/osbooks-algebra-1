<content>
  <section><title>Warm Up Activity</title> 
<para>Rewrite each quotient as a sum or a difference.</para>
<!-- q1 -->
<exercise>
  <problem>
    <para> \( \dfrac {4x-10}{2} \)</para>
 </problem><solution>
    
      <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\( 2x - 5 \)</para>
  </solution></exercise>
<!-- q2 -->
<exercise>
  <problem>
    <para> \( \dfrac {1 - 50x}{-2} \)</para>
  </problem><solution>
    
      <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\( -\frac{1}{2}+25x \)</para>
  </solution></exercise>
<!-- q3 -->

<exercise>
  <problem>
    <para> \( \dfrac {5(x+10)}{25} \)</para>
  </problem><solution>
    
      <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\( \frac{1}{5}x+2 \)</para>
  </solution></exercise>
<!-- q4 -->

<exercise>
  <problem>
    <para> \( \dfrac {- \frac15 x + 5}{2} \)</para>
  </problem><solution>
    
      <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\( -\frac{1}{10}x+\frac{5}{2} \)</para>
  </solution></exercise>
</section>
</content>
