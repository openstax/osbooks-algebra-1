    <problem>
      <list class="os-raise-noindent" type="enumerated">
        <item>\((x−3)(x+1)=5\)</item>
      </list>
      <list class="os-raise-noindent" type="enumerated">
        <item>What is the correct value of \((\frac{b}{2})^2\) that will complete the square?</item>
      </list>
      <para>Enter the value:</para>
    </problem>
    <solution>
      <para>Correct! \((\frac{b}{2})^2 = 1\)</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
