<content>
  <section><title>Warm Up Activity</title>
<para>For numbers 1–3, write the equation of:</para>
<!--Q#1-->
<exercise>
  <problem>
    <para> A line with a slope of 5 and a \(y\)-intercept of \(\frac12\). </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(y = 5x + \frac12\)</para>
  </solution></exercise>
<!--Interaction End -->
<!--Q#2-->
<exercise>
  <problem>
    <para> A line with a slope of 2 that goes through \((-1, 3)\). </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(y = \frac{1}{2} x + \frac72\)</para>
  </solution></exercise>
<!--Interaction End -->
<!--Q#3-->
<exercise>
  <problem>
    <para> A line that passes through \((2, 4)\) and \((1, -2)\). </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(y=6x - 8\)</para>
  </solution></exercise>
<!--Interaction End --></section>
</content>
