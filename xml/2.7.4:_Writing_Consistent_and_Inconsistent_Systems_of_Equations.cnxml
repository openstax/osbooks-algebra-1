<content>
  <section><title>Cool Down Activity</title>
<para>Here is an equation: \( 5x-2y=10 \).</para>
<para>Create a second equation that would make a system of equations with:</para>
<!--Q#1-->
<exercise>
  <problem>
    <para>One solution</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para> Compare Your Answer:  </para>
    <para>Your answer may vary, but here are some samples. </para>
    <para>\(3x - y = 7\)</para>
  </solution></exercise>
<!--Interaction End -->
<!--Q#2-->
<exercise>
  <problem>
    <para>No solutions</para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>Your answer may vary, but here are some samples. </para>
    <para>\(5x - 2y = 20\)</para>
  </solution></exercise>
<!--Interaction End -->
<!--Q#3-->
<exercise>
  <problem>
    <para>Infinitely many solutions</para>
    </problem><solution>
    
