  <!--Q#3-->
  <exercise data-content-id="38bd9000-31c9-46a3-a32d-e70a4aeecce8" data-problem-type="dropdown" data-solution="Yes" data-solution-options="[&quot;Yes&quot;, &quot;No&quot;]">
    <problem>
      <para> Can he buy 3 protein bars and 5 bottles of juice?</para>
      </problem>
    <solution>
      <para>Correct! Yes.</para>
    </solution>
    </exercise>
  <!--END QUESTION.-->
  <!--Q#4-->
  <exercise data-content-id="dcb12508-9214-47aa-ba09-215c3a68f5d9" data-problem-type="dropdown" data-solution="No" data-solution-options="[&quot;Yes&quot;, &quot;No&quot;]">
    <problem>
      <para> Can he buy 5 protein bars and 3 bottles of juice?</para>
      </problem>
    <solution>
      <para>Correct! No.</para>
    </solution>
    </exercise>
