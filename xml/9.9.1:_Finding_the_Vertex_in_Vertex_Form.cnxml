<content>
  <section><title>Warm Up Activity</title>
<!--Q#1-->
<example><exercise>
  <problem>
    
    <para> Write the quadratic function \(f(x)=x^2+6x+13\) in vertex form. </para>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <para>\(f(x)=(x+3)^2+4\)</para>
  <para>\((\frac{b}{2})^2=(\frac{6}{2})^2=\frac{36}{4}=9\)</para>
</solution></exercise>
</example><!--Interaction End -->
<!--Q#2-->
<exercise>
  <problem>
    <para> Using the vertex form of the quadratic found in question 1, what is the vertex? </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\((-3, 4)\)</para>
  </solution></exercise>
<!--Interaction End -->
