<exercise><exercise data-wait-for-event="RFM1">
  <div class="os-raise-ib-input-ack">
    <para>Compare your answer:</para>
    <para>\((5^x+3)^2\)</para>
  </div>
<problem>
    <list class="os-raise-noindent" start="3" type="enumerated">
      <item>\(5^{2x}+6\cdot 5^x+9\)</item>
    </list>
  </problem><solution>
    <para>Enter the factored form of this expression.</para>
  </solution></exercise>
