    <para>Compare your answer:</para>
    <para>\((\sqrt{x}+7)^2\)</para>
  </div>
<problem>
    <list class="os-raise-noindent" start="2" type="enumerated">
      <item>\(x+14\sqrt{x}+49\)</item>
    </list>
  </problem><solution>
    <para>Enter the factored form of this expression.</para>
  </solution></exercise>
