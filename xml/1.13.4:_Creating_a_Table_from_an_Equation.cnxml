<content>
  <section><title>Cool Down Activity</title>

<!--Q#-->
<example><exercise>
  <problem>
    
    <para>Using the equation \(m=\frac{x-4}{6}\), complete the table of values.</para>
    <table>
      <tgroup cols="6"><thead>
      </thead>
      <tbody>
        <row>
          <entry>\(x\)</entry>
          <entry>0</entry>
          <entry>1</entry>
          <entry>2</entry>
          <entry>3</entry>
          <entry>4</entry>
        </row>
        <row>
          <entry>\(m\)</entry>
          <entry/>
          <entry/>
          <entry/>
          <entry/>
          <entry/>
        </row>
      </tbody>
    </tgroup></table>
    <para>Write down your answer, then select the <emphasis>solution</emphasis> button to compare your work.</para>
  </problem><solution>
  <para>Compare your answer:</para>
  <table>
    <tgroup cols="6"><thead>
    </thead>
    <tbody>
      <row>
        <entry>\(x\)</entry>
        <entry>0</entry>
        <entry>1</entry>
        <entry>2</entry>
        <entry>3</entry>
        <entry>4</entry>
      </row>
      <row>
        <entry>\(m\)</entry>
        <entry>-1</entry>
        <entry>\(-\frac34\)</entry>
        <entry>\(-\frac12\)</entry>
        <entry>\(-\frac14\)</entry>
        <entry>0</entry>
      </row>
    </tbody>
  </tgroup></table>
</solution></exercise>
</example><!--Interaction End --> 

</section>
</content>
