<exercise><exercise>
  <div class="os-raise-ib-input-ack">
    <para>Compare your answer:</para>
    <para>\(y=3\) and \(y=-3\)</para>
    <para>\(\begin{array}{rcl}\frac23y^2-8&amp;=&amp;-2\\\frac23y^2&amp;=&amp;6\\\frac32\left(\frac23y^2\right)&amp;=&amp;\frac32\left(6\right)\\y^2&amp;=&amp;9\\y&amp;=&amp;\pm\sqrt9\end{array}\)<br/>\(\;\;\;\;\;\;y=3\) and \(y=-3\)</para>
  </div>
<problem>
    <list class="os-raise-noindent" start="3" type="enumerated">
      <item>\(\frac{2}{3}y^2−8=−2\)</item>
    </list>
  </problem><solution>
    <para>Enter the solution to the equation.</para>
  </solution></exercise>
</exercise><!--Interaction End -->
