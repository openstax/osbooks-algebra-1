<content>
  <section><title>Cool Down Activity</title>
<para>Use what you have learned in the lesson to solve the following quadratic equations.</para>
<br/>
<!--Text Entry Interaction Start -->
<exercise><exercise>
  <div class="os-raise-ib-input-ack">
    <para>Compare your answer:</para>
    <para>\(m=4\) and \(m=-4\)</para>
    <para>\(5m^2=80\)</para>
    <para> \(\frac{5m^2}{5}=\frac{80}{5}\)</para>
    <para> \(m^2=16\)</para>
    <para> \(m=\pm \sqrt{16}\)</para>
    <para> \(m=4\) and \(m=-4\)</para>
  </div>
<problem>
    <list class="os-raise-noindent" type="enumerated">
      <item>\(5m^2= 80\)</item>
    </list>
  </problem><solution>
    <para>Enter the solution to the equation.</para>
  </solution></exercise>
</exercise><!--Interaction End -->
<br/>
<!--Text Entry Interaction Start -->
<exercise><exercise>
