<exercise><exercise>
  <div class="os-raise-ib-input-ack">
    <para>Compare your answer:</para>
    <para>\(x=9\) and \(x=-15\)</para>
    <para>\(\begin{array}{rcl}\frac16\left(x+3\right)^2-8&amp;=&amp;16\\\frac16\left(x+3\right)^2&amp;=&amp;24\\\left(x+3\right)^2&amp;=&amp;144\\\left(x+3\right)&amp;=&amp;\pm\sqrt{144}\end{array}\)<br/>
      \(\;\;\;\;\;\;\;x+3=12\;\;\;\;\;\;x+3=-12\)<br/>
      \(\;\;\;\;\;\;\;\;\;\;\;\;\;\;x=9\) and \(x=-15\)</para>
  </div>
<problem>
    <list class="os-raise-noindent" start="4" type="enumerated">
      <item>\(\frac{1}{6}(x+3)^2−8=16\)</item>
    </list>
  </problem><solution>
