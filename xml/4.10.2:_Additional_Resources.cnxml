   <exercise data-problem-type="dropdown" data-solution="Texas" data-solution-options="[&quot;California&quot;, &quot;Texas&quot;]">
         <problem>
          <para>Which state had a greater population in 1920?</para>
          </problem>
          <solution>
                <para>Correct! Texas.</para>
          </solution>
          <div class="os-raise-ib-pset-encourage-response">
               <para>Try Again.</para>
          </div>
          </exercise>
