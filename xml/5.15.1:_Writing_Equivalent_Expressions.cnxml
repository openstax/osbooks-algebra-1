<content>
  <section><title> Warm Up Activity</title>
<para>For each given expression, write an equivalent expression with as few terms as possible. Double click on mathematical expressions/equations to enlarge. If needed, use the “^” symbol to enter an exponent.</para>
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(
        7p−3+2(p+1)\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(9p−1\) </para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> \(\lbrack 4(n+1)+10 \rbrack−4(n+1)\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(
      10\) </para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para> \(9^5 \cdot 9^2 \cdot 9^x\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(9^{7+x}
      \)</para>
  </solution></exercise>
<!--Interaction End -->
<!--Text Entry Interaction Start -->
<exercise>
  <problem>
    <para>\(\frac{
        2^{4n}}{2^n}\) </para>
    </problem><solution>
    
    <para>Enter your answer here:</para>
  <para>Compare your answer:</para>
    <para>\(2^{3n}\) </para>
  </solution></exercise>
<!--Interaction End -->
</section>
</content>
