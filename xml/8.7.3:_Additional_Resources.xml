        </entry>
        <entry scope="col" class="emphasis">
          <para><emphasis>Factor 2</emphasis></para>
        </entry>
        <entry scope="col" class="emphasis">
          \(b\) (positive)
        </entry>
		</row></thead><tbody>
      <row>
        <entry>
          <para>–1</para>
        </entry>
        <entry>
          <para>60</para>
        </entry>
        <entry>
          <para>59</para>
        </entry>
      </row>
      <row>
        <entry>
          <para>–2</para>
        </entry>
        <entry>
          <para>30</para>
        </entry>
        <entry>
          <para>28</para>
        </entry>
      </row>
      <row>
        <entry>
          <para>–3</para>
        </entry>
        <entry>
          <para>20</para>
        </entry>
        <entry>
          <para>17</para>
        </entry>
      </row>
      <row>
        <entry>
          <para>–4</para>
        </entry>
        <entry>
          <para>15</para>
        </entry>
        <entry>
          <para>11</para>
        </entry>
      </row>
      <row>
        <entry>
          <para>–5</para>
        </entry>
        <entry>
          <para>12</para>
        </entry>
        <entry>
          <para>7</para>
        </entry>
      </row>
      <row>
        <entry>
          <para>–6</para>
        </entry>
        <entry>
          <para>10</para>
        </entry>
        <entry>
          <para>4</para>
        </entry>
      </row>
    </tbody>
  </table>
  <br/>
</solution></exercise>
