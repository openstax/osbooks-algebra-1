<content>
  <section><para>An expression in standard form is shown. The diagram below is equivalent to which expression in factored form?</para>
<para>\(x^2−13x + 42\)</para>
<table>
  <tgroup cols="3"><thead>
   
    <row>
      <entry/>
      <entry>
        <para>\(x\)</para>
      </entry>
      <entry>
        <para>-6</para>
      </entry>
    </row> 
    </thead>
  <tbody>
    <row>
      <entry>
        <para>\(x\)</para>
      </entry>
      <entry>
        <para>\(x^2\)</para>
      </entry>
      <entry>
        <para>\(-6x\)</para>
      </entry>
    </row>
    <row>
      <entry>
        <para>-7</para>
      </entry>
      <entry>
        <para>\(-7x\)</para>
      </entry>
      <entry>
        <para>42</para>
      </entry>
    </row>
  </tbody>
</tgroup></table>
</section>
</content>
