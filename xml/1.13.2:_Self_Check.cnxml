<content>
  <section><para>Which of the following equations could be represented by this table of values?
</para>

<table>
  <tgroup cols="5"><thead/>
  <tbody>
    <row>
      <entry>\(x\)</entry>
      <entry>0</entry>
      <entry>1</entry>
      <entry>2</entry>
      <entry>3</entry>
    </row>
    <row>
      <entry>\(y\)</entry>
      <entry>20</entry>
      <entry>23</entry>
      <entry>26</entry>
      <entry>29</entry>
    </row>
  </tbody>
</tgroup></table></section>
</content>
