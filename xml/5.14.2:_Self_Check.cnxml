<content>
  <section><para>Using a calculator, Joanna made the following table and then made the following conjecture: \(3x\) is always greater than \((1.02)^x\). Is Joanna correct? Explain.</para>
<table>
  <tgroup cols="3"><thead>
    <row>
      <entry>
        \(x\)
      </entry>
      <entry>
        \((1.02)^x\)
      </entry>
      <entry>
        \(3x\)
      </entry>
    </row>
  </thead>
  <tbody>
    <row>
      <entry>
        1
      </entry>
      <entry>
        1.02
      </entry>
      <entry>
        3
      </entry>
    </row>
    <row>
      <entry>
        2
      </entry>
      <entry>
        1.0404
      </entry>
      <entry>
        6
      </entry>
    </row>
    <row>
      <entry>
        3
      </entry>
      <entry>
        1.0612
      </entry>
      <entry>
        9
      </entry>
    </row>
    <row>
      <entry>
        4
      </entry>
      <entry>
        1.0824
      </entry>
      <entry>
        12
      </entry>
    </row>
    <row>
      <entry>
        5
      </entry>
      <entry>
        1.1041
      </entry>
      <entry>
        15
      </entry>
    </row>
  </tbody>
</tgroup></table>
</section>
</content>
