    <tgroup cols="4"><thead>
      <row>
        <entry>Problem</entry>
        <entry>Labeled Area Model with Partial Products</entry>
        <entry>List partial products and write as a sum</entry>
        <entry>Total area of rectangle</entry>
      </row>
    </thead>
    <tbody>
      <row>
        <entry>
          <para>10✕15</para>
        </entry>
        <entry>
