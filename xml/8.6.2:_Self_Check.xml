<content>
  <section><para>An expression in standard form is shown. The diagram below is equivalent to which expression in factored form?</para>
<para>\(x^2−13x + 42\)</para>
<table class="os-raise-doubleheadertable">
  <thead>
   
    <row>
      <entry scope="col" class="emphasis"/>
      <entry scope="col" class="emphasis">
        <para>\(x\)</para>
      </entry>
      <entry scope="col" class="emphasis">
        <para>-6</para>
      </entry>
    </row> 
    </thead>
  <tbody>
    <row>
      <entry scope="row" class="emphasis">
        <para>\(x\)</para>
      </entry>
      <entry>
        <para>\(x^2\)</para>
      </entry>
      <entry>
        <para>\(-6x\)</para>
      </entry>
    </row>
    <row>
      <entry scope="row" class="emphasis">
        <para>-7</para>
      </entry>
      <entry>
        <para>\(-7x\)</para>
      </entry>
      <entry>
        <para>42</para>
      </entry>
    </row>
  </tbody>
</table>
<br/></section>
</content>
